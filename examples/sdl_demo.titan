
-- Compile with:
--    titanc examples.sdl_demo -lSDL2
-- Run with:
--    ./examples/sdl_demo

foreign import "SDL2/SDL.h"

local sdl_quit = import "examples.sdl_quit"

function main(args: {string}): integer

    if ffi.SDL_Init(ffi.SDL_INIT_VIDEO) ~= 0 then
        sdl_quit.quit(false, "SDL_init error")
    end

    local SDL_WINDOW_SHOWN = 0x04

    local title = "Hello World!"
    if #args > 0 then
        title = title .. " " .. args[1]
    end
    local win = ffi.SDL_CreateWindow(title, 100, 100, 640, 480, SDL_WINDOW_SHOWN)
    if not win then
        sdl_quit.quit(true, "SDL_CreateWindow error")
    end

    local SDL_RENDERER_ACCELERATED = 0x02
    local SDL_RENDERER_PRESENTVSYNC = 0x04

    local ren = ffi.SDL_CreateRenderer(win, -1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
    if not ren then
        ffi.SDL_DestroyWindow(win)
        sdl_quit.quit(true, "SDL_CreateRenderer error")
    end

    local bmp = ffi.SDL_LoadBMP_RW(ffi.SDL_RWFromFile("examples/hello.bmp", "rb"), 1)
    -- local bmp = SDL.SDL_LoadBMP("hello.bmp")
    if not bmp then
        ffi.SDL_DestroyRenderer(ren)
        ffi.SDL_DestroyWindow(win)
        sdl_quit.quit(true, "SDL_LoadBMP error")
    end

    local tex = ffi.SDL_CreateTextureFromSurface(ren, bmp)
    ffi.SDL_FreeSurface(bmp)
    if not tex then
        ffi.SDL_DestroyRenderer(ren)
        ffi.SDL_DestroyWindow(win)
        sdl_quit.quit(true, "SDL_CreateTextureFromSurface error")
    end

    for i = 1, 3 do
        ffi.SDL_RenderClear(ren)
        ffi.SDL_RenderCopy(ren, tex, nil, nil)
        ffi.SDL_RenderPresent(ren)
        ffi.SDL_Delay(1000)
    end

    ffi.SDL_DestroyTexture(tex)
    ffi.SDL_DestroyRenderer(ren)
    ffi.SDL_DestroyWindow(win)
    ffi.SDL_Quit()

    return 42
end
