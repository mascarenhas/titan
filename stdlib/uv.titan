-- Persistent TCP handles cross into net through this exact nominal wrapper.
-- Native callbacks recover this record directly; the pointer never travels
-- through value and repeated middle-layer calls allocate no pointer box.
record uv_tcp_t
  local handle: *libuv.uv_tcp_t
  local storage: value
  local main_thread: value
  local module: value
  local dispatcher: (uv_tcp_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local root: value
  local metadata: TcpControl
  local buffer: value
end

-- Persistent descriptors cross into fs as one nominal wrapper.  Its scalar
-- libuv handle never travels through value; every queue/resource link remains
-- local to uv and is omitted from the binary interface.
record uv_file
  local handle: libuv.uv_file
  local runtime: Runtime
  local generation: integer
  local state: integer
  local subject: string
  local queue_head: value
  local queue_tail: value
  local current: value
  local close_waiter_head: value
  local close_waiter_tail: value
  local next_file: value
  local previous_file: value
  local close_enqueued: boolean
  local close_failures: integer
  local close_retry_exhausted: boolean
end

record Task
  local root: coroutine.Coro
  local runtime: Runtime
  local generation: integer
  local state: integer
  local epoch: integer
  local result: value
  local error_value: value
  local error_traceback: string
  local cancel_requested: boolean
  local cancel_reason: value
  local cancel_value: value
  local operation: value
  local current_request: value
  local joiner_head: value
  local join_next: value
  local join_previous: value
  local joining_target: value
  local next_task: value
  local previous_task: value
  local permanently_observed: boolean
  local observer_count: integer
  local cleanup_shield_depth: integer
  local cancel_deferred: boolean
  local cancel_fallback: boolean
  local main: boolean
end

local record TickerState
  local runtime: Runtime
  local generation: integer
  local open: boolean
  local interval: integer
  local owner: value
  local waiter: value
  local waiter_epoch: integer
end

-- A single tag identity belongs to this module instance and is shared by all
-- tasks and by every sequential Runtime session in the Lua state.
local UV_TAG: value = {}
local generation = 0
local active_runtime: Runtime? = nil
-- TITAN_UV_PHASE5_TEST_STATE

local function reinstall_trace(trace: string)
  ffi.lua_pushtvalue(L, trace)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  lua.lua_pushboolean(L, 1)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
end

local function stash_trace_for_append(trace: string)
  ffi.lua_pushtvalue(L, trace)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
end

local function pop_trace_for_append(): value
  local top = lua.lua_gettop(L)
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  local trace: value = ffi.lua_totvalue(L, -1)
  lua.lua_pushnil(L)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  lua.lua_settop(L, top)
  return trace
end

local function raise_joined(err: value, target_trace: string)
  stash_trace_for_append(target_trace)
  do
    raise err
  catch
    local inner = pop_trace_for_append()
    if inner ~= nil then
      reinstall_trace((inner as string) .. "\n" .. traceback)
    end
    raise error
  end
end

local function raise_saved(err: value, trace: string)
  if #trace > 0 then
    reinstall_trace(trace)
  end
  raise err
end

local function main_thread_value(): value
  local top = lua.lua_gettop(L)
  lua.lua_rawgeti(L, lua.LUA_REGISTRYINDEX,
                  lua.LUA_RIDX_MAINTHREAD as lua.lua_Integer)
  local thread = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return thread
end

local function dispatcher_module_value(dispatcher: value): value
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, dispatcher)
  lua.lua_getupvalue(L, -1, 1)
  local module = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return module
end

local function on_main_thread(): boolean
  local top = lua.lua_gettop(L)
  local is_main = lua.lua_pushthread(L)
  lua.lua_settop(L, top)
  return (is_main as integer) ~= 0
end

local function allocate_bytes(length: integer): Bytes
  if length < 0 then
    raise "buffer length must not be negative"
  end
  if (shim.titan_uvshim_allocation_length_is_valid(
          length) as integer) == 0 then
    raise "buffer length exceeds the platform allocation limit"
  end
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, length, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local bytes = Bytes.new(memory as *ffi.titan_ffi_char, storage, length)
  lua.lua_settop(L, top)
  return bytes
end

local function copy_text(source: string, operation: string): Text
  local length = #source
  if length >= 9223372036854775807 then
    raise make_error(-1, operation, source)
  end
  local bytes = allocate_bytes(length + 1)
  local status = shim.titan_uvshim_text_copy(bytes.data, length + 1,
                                             source, length)
  if (status as integer) < 0 then
    raise make_error(status as integer, operation, source)
  end
  return Text.new(bytes, source)
end

local function copy_bytes(source: string, operation: string): Bytes
  local length = #source
  local bytes = allocate_bytes(length)
  if length > 0 then
    local status = shim.titan_uvshim_bytes_copy(bytes.data, length,
                                               source, length)
    if (status as integer) < 0 then
      raise make_error(status as integer, operation, nil)
    end
  end
  return bytes
end

local function copy_addresses(pointer: ffi.titan_ffi_void_ptr,
                              subject: string): AddressList
  local count = shim.titan_uvshim_addrinfo_count(pointer) as integer
  if count < 0 then
    raise make_error(count, "net.resolve.copy", subject)
  end
  local cell_size = shim.titan_uvshim_address.sizeof as integer
  if cell_size <= 0 or
      (count > 0 and count > 9223372036854775807 // cell_size) then
    raise make_error(-1, "net.resolve.copy", subject)
  end
  local bytes = allocate_bytes(count * cell_size)
  local status = shim.titan_uvshim_addrinfo_copy(pointer, bytes.data, count)
  if (status as integer) < 0 then
    raise make_error(status as integer, "net.resolve.copy", subject)
  end
  return AddressList.new((bytes.data as ffi.titan_ffi_void_ptr) as
                         *shim.titan_uvshim_address,
                         bytes.storage, count)
end

local function make_buffer(bytes: Bytes, offset: integer,
                           length: integer, operation: string): Buffer
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_buf_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local status = shim.titan_uvshim_buf_init_slice(
      memory, bytes.data, bytes.length, offset, length)
  if (status as integer) < 0 then
    lua.lua_settop(L, top)
    raise make_error(status as integer, operation, nil)
  end
  local buffer = Buffer.new(memory as *libuv.uv_buf_t, storage, bytes,
                            offset, length)
  lua.lua_settop(L, top)
  return buffer
end

local function allocate_read_buffer(length: integer): Buffer
  return make_buffer(allocate_bytes(length), 0, length, "fs.buffer.init")
end

local function bytes_string(bytes: Bytes, length: integer): string
  if length < 0 or length > bytes.length then
    raise "native result exceeds its rooted buffer"
  end
  local top = lua.lua_gettop(L)
  lua.lua_pushlstring(L, bytes.data, length as libuv.size_t)
  local raw: value = ffi.lua_totvalue(L, -1)
  local result = raw as string
  lua.lua_settop(L, top)
  return result
end

local function allocate_dirent(): Dirent
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_dirent_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local entry = Dirent.new(memory as *libuv.uv_dirent_t, storage)
  lua.lua_settop(L, top)
  return entry
end

local function extract_fs_list(owner: uv_fs_t): {string}
  local names: {string} = {}
  local entry = allocate_dirent()
  while true do
    local status = shim.titan_uvshim_fs_scandir_next(owner.handle,
        entry.handle as ffi.titan_ffi_void_ptr)
    if (status as integer) == 1 then break end
    if (status as integer) < 0 then
      raise make_error(status as integer, "fs.list.next",
                       fs_operation_subject(owner.metadata.operation))
    end
    names[#names + 1] = shim.titan_uvshim_dirent_name(
        entry.handle as ffi.titan_ffi_void_ptr) as string
  end
  return names
end

local function make_error(status: integer, operation: string,
                          subject: string?): Error
  local code = status as ffi.titan_ffi_int
  return Error.new(status, libuv.uv_err_name(code) as string,
                   libuv.uv_strerror(code) as string, operation, subject)
end

local function internal_error(operation: string): Error
  return Error.new(-1, "EINTERNAL", "libuv Runtime invariant failed",
                   operation, nil)
end

local function task_state_name(state: integer): string
  if state == TASK_NEW then return "new" end
  if state == TASK_READY then return "ready" end
  if state == TASK_RUNNING then return "running" end
  if state == TASK_WAITING then return "waiting" end
  if state == TASK_SUCCEEDED then return "succeeded" end
  if state == TASK_FAILED then return "failed" end
  return "cancelled"
end

local function request_kind_name(kind: integer): string
  if kind == REQUEST_SLEEP then return "sleep" end
  if kind == REQUEST_JOIN then return "join" end
  if kind == REQUEST_TICK then return "ticker.tick" end
  if kind == REQUEST_CLEANUP_SLEEP then return "cleanup.sleep" end
  if kind == REQUEST_FS then return "filesystem" end
  if kind == REQUEST_NET then return "network" end
  return "unknown"
end

local function waiting_task_diagnostic(runtime: Runtime): string
  local diagnostic = ""
  local raw = runtime.task_head
  while raw ~= nil do
    local task = raw as Task
    if #diagnostic > 0 then diagnostic = diagnostic .. ", " end
    diagnostic = diagnostic .. "Task(state=" .. task_state_name(task.state)
    if task.current_request ~= nil then
      local request = task.current_request as Request
      diagnostic = diagnostic .. ", request=" ..
                   request_kind_name(request.kind)
    else
      diagnostic = diagnostic .. ", request=none"
    end
    diagnostic = diagnostic .. ")"
    raw = task.next_task
  end
  if #diagnostic == 0 then return "no live Tasks" end
  return diagnostic
end

local function check_alignment()
  if libuv.uv_loop_t.alignof > ffi.TValue.alignof or
      libuv.uv_timer_t.alignof > ffi.TValue.alignof or
      libuv.uv_fs_t.alignof > ffi.TValue.alignof or
      libuv.uv_getaddrinfo_t.alignof > ffi.TValue.alignof or
      libuv.uv_connect_t.alignof > ffi.TValue.alignof or
      libuv.uv_write_t.alignof > ffi.TValue.alignof or
      libuv.uv_shutdown_t.alignof > ffi.TValue.alignof or
      libuv.uv_tcp_t.alignof > ffi.TValue.alignof or
      libuv.uv_buf_t.alignof > ffi.TValue.alignof or
      libuv.uv_dirent_t.alignof > ffi.TValue.alignof or
      shim.titan_uvshim_address.alignof > ffi.TValue.alignof then
    raise "libuv requires over-aligned storage on this target"
  end
end

local function allocate_loop(next_generation: integer): Loop
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_loop_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local loop = Loop.new(memory as *libuv.uv_loop_t, storage, next_generation)
  lua.lua_settop(L, top)
  return loop
end

local function new_runtime(): Runtime
  check_alignment()
  generation = generation + 1
  local loop = allocate_loop(generation)
  local status = libuv.uv_loop_init(loop.handle)
  if (status as integer) < 0 then
    loop.handle = nil
    loop.storage = nil
    raise make_error(status as integer, "loop.init", nil)
  end
  local runtime = Runtime.new(loop, generation, main_thread_value(),
      dispatcher_module_value(timer_dispatch), nil, nil, nil, nil, nil, nil,
      nil, nil, false, false, false, nil, "", 0)
  active_runtime = runtime
  return runtime
end

local function current_runtime(): Runtime
  if not active_runtime then
    raise "no active libuv Runtime"
  end
  return active_runtime as Runtime
end

local function ensure_runtime(): Runtime
  if active_runtime then
    local runtime = active_runtime as Runtime
    if runtime.closing then
      raise "the libuv Runtime is shutting down"
    end
    return runtime
  end
  return new_runtime()
end

local function link_owner(runtime: Runtime, owner: uv_timer_t)
  local previous = runtime.timer_owner_head
  owner.metadata.next_owner = previous
  owner.metadata.previous_owner = nil
  if previous ~= nil then
    local old = previous as uv_timer_t
    old.metadata.previous_owner = owner
  end
  runtime.timer_owner_head = owner
end

local function unlink_owner(owner: uv_timer_t)
  local runtime = owner.metadata.runtime
  local previous = owner.metadata.previous_owner
  local next = owner.metadata.next_owner
  if previous ~= nil then
    local before = previous as uv_timer_t
    before.metadata.next_owner = next
  else
    runtime.timer_owner_head = next
  end
  if next ~= nil then
    local after = next as uv_timer_t
    after.metadata.previous_owner = previous
  end
  owner.metadata.previous_owner = nil
  owner.metadata.next_owner = nil
end

local function link_fs_owner(runtime: Runtime, owner: uv_fs_t)
  local previous = runtime.fs_pending_head
  owner.metadata.next_owner = previous
  owner.metadata.previous_owner = nil
  if previous ~= nil then
    local old = previous as uv_fs_t
    old.metadata.previous_owner = owner
  end
  runtime.fs_pending_head = owner
end

local function unlink_fs_owner(owner: uv_fs_t)
  local runtime = owner.metadata.runtime
  local previous = owner.metadata.previous_owner
  local next = owner.metadata.next_owner
  if previous ~= nil then
    local before = previous as uv_fs_t
    before.metadata.next_owner = next
  else
    runtime.fs_pending_head = next
  end
  if next ~= nil then
    local after = next as uv_fs_t
    after.metadata.previous_owner = previous
  end
  owner.metadata.previous_owner = nil
  owner.metadata.next_owner = nil
end

local function link_task(runtime: Runtime, task: Task)
  local previous = runtime.task_head
  task.next_task = previous
  task.previous_task = nil
  if previous ~= nil then
    local old = previous as Task
    old.previous_task = task
  end
  runtime.task_head = task
end

local function unlink_task(task: Task)
  local runtime = task.runtime
  local previous = task.previous_task
  local next = task.next_task
  if previous ~= nil then
    local before = previous as Task
    before.next_task = next
  else
    runtime.task_head = next
  end
  if next ~= nil then
    local after = next as Task
    after.previous_task = previous
  end
  task.previous_task = nil
  task.next_task = nil
end

local function link_file(runtime: Runtime, file: uv_file)
  local previous = runtime.file_head
  file.next_file = previous
  file.previous_file = nil
  if previous ~= nil then
    local old = previous as uv_file
    old.previous_file = file
  end
  runtime.file_head = file
end

local function unlink_file(file: uv_file)
  local runtime = file.runtime
  local previous = file.previous_file
  local next = file.next_file
  if previous ~= nil then
    local before = previous as uv_file
    before.next_file = next
  else
    runtime.file_head = next
  end
  if next ~= nil then
    local after = next as uv_file
    after.previous_file = previous
  end
  file.previous_file = nil
  file.next_file = nil
end

local function link_net_control(runtime: Runtime,
                                control: NetRequestControl)
  local previous = runtime.net_pending_head
  control.next_control = previous
  control.previous_control = nil
  if previous ~= nil then
    local old = previous as NetRequestControl
    old.previous_control = control
  end
  runtime.net_pending_head = control
end

local function unlink_net_control(control: NetRequestControl)
  local runtime = control.runtime
  local previous = control.previous_control
  local next = control.next_control
  if previous ~= nil then
    local before = previous as NetRequestControl
    before.next_control = next
  else
    runtime.net_pending_head = next
  end
  if next ~= nil then
    local after = next as NetRequestControl
    after.previous_control = previous
  end
  control.previous_control = nil
  control.next_control = nil
end

local function link_tcp_control(runtime: Runtime, control: TcpControl)
  local previous = runtime.tcp_head
  control.next_control = previous
  control.previous_control = nil
  if previous ~= nil then
    local old = previous as TcpControl
    old.previous_control = control
  end
  runtime.tcp_head = control
end

local function unlink_tcp_control(control: TcpControl)
  local runtime = control.runtime
  local previous = control.previous_control
  local next = control.next_control
  if previous ~= nil then
    local before = previous as TcpControl
    before.next_control = next
  else
    runtime.tcp_head = next
  end
  if next ~= nil then
    local after = next as TcpControl
    after.previous_control = previous
  end
  control.previous_control = nil
  control.next_control = nil
end

local function validate_tcp(tcp: uv_tcp_t, operation: string,
                            require_server: boolean,
                            allow_closing: boolean)
  local runtime = current_runtime()
  local control = tcp.metadata
  if control.runtime ~= runtime or
      control.generation ~= runtime.generation then
    raise "TCP resource belongs to a stale libuv Runtime"
  end
  if require_server ~= control.server then
    if require_server then
      raise operation .. " requires a Server"
    else
      raise operation .. " requires a Connection"
    end
  end
  if control.lifecycle == TCP_CLOSED then
    raise "cannot " .. operation .. " a closed TCP resource"
  end
  if control.lifecycle == TCP_CLOSING and not allow_closing then
    raise "cannot " .. operation .. " a closing TCP resource"
  end
  if control.close_requested and not allow_closing then
    raise "cannot " .. operation .. " a closing TCP resource"
  end
end

local function enqueue_output(tcp: uv_tcp_t, operation: NetOperation)
  local control = tcp.metadata
  local previous = control.output_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous ~= nil then
    local tail = previous as NetOperation
    tail.next_operation = operation
  else
    control.output_head = operation
  end
  control.output_tail = operation
  operation.linked = true
  operation.close_waiter = false
end

local function remove_output(tcp: uv_tcp_t, operation: NetOperation)
  if not operation.linked or operation.close_waiter then return end
  local control = tcp.metadata
  local previous = operation.previous_operation
  local next = operation.next_operation
  if previous ~= nil then
    local before = previous as NetOperation
    before.next_operation = next
  else
    control.output_head = next
  end
  if next ~= nil then
    local after = next as NetOperation
    after.previous_operation = previous
  else
    control.output_tail = previous
  end
  if control.output_current == operation then
    control.output_current = nil
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.owner = nil
  operation.prepared_buffer = nil
  operation.linked = false
end

local function enqueue_tcp_close_waiter(tcp: uv_tcp_t,
                                        operation: NetOperation)
  local control = tcp.metadata
  local previous = control.close_waiter_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous ~= nil then
    local tail = previous as NetOperation
    tail.next_operation = operation
  else
    control.close_waiter_head = operation
  end
  control.close_waiter_tail = operation
  operation.linked = true
  operation.close_waiter = true
end

local function remove_tcp_close_waiter(tcp: uv_tcp_t,
                                       operation: NetOperation)
  if not operation.linked or not operation.close_waiter then return end
  local control = tcp.metadata
  local previous = operation.previous_operation
  local next = operation.next_operation
  if previous ~= nil then
    local before = previous as NetOperation
    before.next_operation = next
  else
    control.close_waiter_head = next
  end
  if next ~= nil then
    local after = next as NetOperation
    after.previous_operation = previous
  else
    control.close_waiter_tail = previous
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.linked = false
  operation.close_waiter = false
end

local function enqueue_accepted(server: uv_tcp_t, client: uv_tcp_t): boolean
  local control = server.metadata
  if control.accept_count >= control.accept_capacity then return false end
  control.accept_tail = control.accept_tail % control.accept_capacity + 1
  control.accept_queue[control.accept_tail] = client
  control.accept_count = control.accept_count + 1
  return true
end

local function dequeue_accepted(server: uv_tcp_t): uv_tcp_t
  local control = server.metadata
  if control.accept_count == 0 then
    raise "cannot dequeue from an empty Server accept queue"
  end
  local raw = control.accept_queue[control.accept_head]
  control.accept_queue[control.accept_head] = nil
  control.accept_head = control.accept_head % control.accept_capacity + 1
  control.accept_count = control.accept_count - 1
  return raw as uv_tcp_t
end

local function create_file(runtime: Runtime, handle: libuv.uv_file,
                           subject: string): uv_file
  local file = uv_file.new(handle, runtime, runtime.generation, FS.file_open,
      subject, nil, nil, nil, nil, nil, nil, nil, false, 0, false)
  link_file(runtime, file)
  return file
end

local function validate_file(file: uv_file, operation: string,
                             allow_closing: boolean)
  local runtime = current_runtime()
  if file.runtime ~= runtime or file.generation ~= runtime.generation then
    raise "File belongs to a stale libuv Runtime"
  end
  if file.state == FS.file_closed then
    raise "cannot " .. operation .. " a closed File"
  end
  if file.state == FS.file_closing and not allow_closing then
    raise "cannot " .. operation .. " a closing File"
  end
end

local function enqueue_file_operation(file: uv_file, operation: FsOperation)
  local previous = file.queue_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous ~= nil then
    local tail = previous as FsOperation
    tail.next_operation = operation
  else
    file.queue_head = operation
  end
  file.queue_tail = operation
  operation.linked = true
  operation.close_waiter = false
  if operation.kind == FS.close or operation.kind == FS.internal_close then
    file.close_enqueued = true
  end
end

local function remove_file_operation(file: uv_file,
                                     operation: FsOperation)
  if not operation.linked or operation.close_waiter then return end
  local previous = operation.previous_operation
  local next = operation.next_operation
  if previous ~= nil then
    local before = previous as FsOperation
    before.next_operation = next
  else
    file.queue_head = next
  end
  if next ~= nil then
    local after = next as FsOperation
    after.previous_operation = previous
  else
    file.queue_tail = previous
  end
  if file.current == operation then file.current = nil end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.owner = nil
  operation.linked = false
end

local function enqueue_close_waiter(file: uv_file, operation: FsOperation)
  local previous = file.close_waiter_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous ~= nil then
    local tail = previous as FsOperation
    tail.next_operation = operation
  else
    file.close_waiter_head = operation
  end
  file.close_waiter_tail = operation
  operation.linked = true
  operation.close_waiter = true
end

local function remove_close_waiter(file: uv_file, operation: FsOperation)
  if not operation.linked or not operation.close_waiter then return end
  local previous = operation.previous_operation
  local next = operation.next_operation
  if previous ~= nil then
    local before = previous as FsOperation
    before.next_operation = next
  else
    file.close_waiter_head = next
  end
  if next ~= nil then
    local after = next as FsOperation
    after.previous_operation = previous
  else
    file.close_waiter_tail = previous
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.linked = false
  operation.close_waiter = false
end

local function close_owner(owner: uv_timer_t)
  if owner.metadata.lifecycle == OWNER_ACTIVE then
    if owner.metadata.kind == OWNER_TICKER then
      local state = owner.metadata.peer as TickerState
      state.open = false
    end
    libuv.uv_timer_stop(owner.handle)
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(owner.handle)
  end
end

local function close_all_owners(runtime: Runtime)
  local raw = runtime.timer_owner_head
  while raw ~= nil do
    local owner = raw as uv_timer_t
    raw = owner.metadata.next_owner
    close_owner(owner)
  end
end

local function maybe_finish_session(runtime: Runtime)
  if runtime.task_head == nil and runtime.pending_observations == 0 then
    runtime.closing = true
    close_all_owners(runtime)
    begin_file_shutdown(runtime)
    begin_tcp_shutdown(runtime)
  end
end

local function allocate_owner(runtime: Runtime, kind: integer, task: value,
                              peer: value, epoch: integer):
                              (uv_timer_t, ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_timer_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local metadata = TimerControl.new(runtime, runtime.generation,
      OWNER_ALLOCATED, kind, task, peer, epoch, nil, nil)
  local owner: uv_timer_t = {
    handle = memory as *libuv.uv_timer_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = timer_dispatch,
    root = task,
    metadata = metadata,
    buffer = peer,
  }
  -- Root the wrapper on the Lua stack before link_owner's entry GC check,
  -- and compute callback navigation while that root is still present.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  link_owner(runtime, owner)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_fs_owner(runtime: Runtime,
                                 operation: FsOperation): uv_fs_t
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_fs_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local metadata = FsControl.new(runtime, runtime.generation,
      FS_OWNER_ALLOCATED, false, false, 0, false, operation, nil, nil,
      -1 as libuv.uv_file, false)
  local owner: uv_fs_t = {
    handle = memory as *libuv.uv_fs_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = fs_dispatch,
    root = operation.task,
    metadata = metadata,
    buffer = operation.path,
  }
  -- No allocating Titan helper may run after this owner is linked and before
  -- libuv accepts (or synchronously rejects) its request.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  link_fs_owner(runtime, owner)
  shim.titan_uvshim_fs_set_data(owner.handle, pointer)
  lua.lua_settop(L, top)
  return owner
end

local function new_net_control(runtime: Runtime, kind: integer,
                               operation: NetOperation): NetRequestControl
  local control: NetRequestControl = {
    runtime = runtime,
    generation = runtime.generation,
    lifecycle = NET_OWNER_ALLOCATED,
    kind = kind,
    owner = nil,
    operation = operation,
    next_control = nil,
    previous_control = nil,
    callback_recorded = false,
    callback_result = 0,
    callback_aborted = false,
    result_pointer = nil,
    result_freed = false,
  }
  return control
end

local function allocate_dns_owner(runtime: Runtime,
                                  operation: NetOperation):
                                  (uv_getaddrinfo_t,
                                   ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_getaddrinfo_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_DNS, operation)
  local owner: uv_getaddrinfo_t = {
    handle = memory as *libuv.uv_getaddrinfo_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = dns_dispatch,
    root = operation.task,
    metadata = control,
    buffer = operation.host,
  }
  -- Root and derive the raw callback navigation pointer before publishing the
  -- request control.  No allocating Titan helper runs between publication and
  -- the one libuv submit call.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_net_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_connect_owner(runtime: Runtime,
                                      operation: NetOperation):
                                      (uv_connect_t,
                                       ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_connect_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_CONNECT, operation)
  local owner: uv_connect_t = {
    handle = memory as *libuv.uv_connect_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = connect_dispatch,
    root = operation.task,
    metadata = control,
    buffer = operation.addresses,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_net_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_write_owner(runtime: Runtime,
                                    operation: NetOperation):
                                    (uv_write_t,
                                     ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_write_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_WRITE, operation)
  local owner: uv_write_t = {
    handle = memory as *libuv.uv_write_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = write_dispatch,
    root = operation.task,
    metadata = control,
    buffer = operation.prepared_buffer,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_net_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_shutdown_owner(runtime: Runtime,
                                       operation: NetOperation):
                                       (uv_shutdown_t,
                                        ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_shutdown_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_SHUTDOWN, operation)
  local owner: uv_shutdown_t = {
    handle = memory as *libuv.uv_shutdown_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = shutdown_dispatch,
    root = operation.task,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_net_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_tcp_owner(runtime: Runtime):
                                  (uv_tcp_t, ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_tcp_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control: TcpControl = {
    runtime = runtime,
    generation = runtime.generation,
    lifecycle = TCP_ALLOCATED,
    server = false,
    published = false,
    owner = nil,
    next_control = nil,
    previous_control = nil,
    connect_pending = false,
    close_callback_seen = false,
    close_requested = false,
    shutdown_requested = false,
    write_shutdown = false,
    read_active = false,
    read_terminal = TCP_READ_OPEN,
    read_error = nil,
    read_waiter = nil,
    read_epoch = 0,
    read_bytes = nil,
    output_head = nil,
    output_tail = nil,
    output_current = nil,
    close_waiter_head = nil,
    close_waiter_tail = nil,
    accept_waiter = nil,
    accept_epoch = 0,
    accept_queue = {},
    accept_head = 1,
    accept_tail = 0,
    accept_count = 0,
    accept_capacity = 0,
    accept_error = nil,
    -- TITAN_UV_PHASE5_TCP_TEST_INIT
    setup_operation = nil,
  }
  local owner: uv_tcp_t = {
    handle = memory as *libuv.uv_tcp_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = tcp_dispatch,
    root = control,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_tcp_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function discard_tcp_storage(tcp: uv_tcp_t)
  local control = tcp.metadata
  if control.owner == nil then return end
  -- Unlink while every owner/root field is still intact.  After unlinking,
  -- only non-raising field clears remain in this frame.
  unlink_tcp_control(control)
  tcp.handle = nil
  tcp.storage = nil
  tcp.root = nil
  tcp.buffer = nil
  control.lifecycle = TCP_CLOSED
  control.owner = nil
end

local function initialize_tcp(runtime: Runtime): (uv_tcp_t, integer)
  local tcp, pointer = allocate_tcp_owner(runtime)
  local status = shim.titan_uvshim_tcp_init(runtime.loop.handle, tcp.handle,
                                            pointer)
  if (status as integer) < 0 then
    -- The handle was never accepted by libuv.  Inline terminal unlink so an
    -- emergency longjmp cannot strand an owner for which no callback is owed.
    local control = tcp.metadata
    local previous = control.previous_control
    local next = control.next_control
    if previous ~= nil then
      local before = previous as TcpControl
      before.next_control = next
    else
      runtime.tcp_head = next
    end
    if next ~= nil then
      local after = next as TcpControl
      after.previous_control = previous
    end
    control.previous_control = nil
    control.next_control = nil
    tcp.handle = nil
    tcp.storage = nil
    tcp.root = nil
    tcp.buffer = nil
    control.lifecycle = TCP_CLOSED
    control.owner = nil
    return tcp, status as integer
  end
  tcp.metadata.lifecycle = TCP_INITIALIZED
  return tcp, 0
end

local function start_tcp_close(tcp: uv_tcp_t)
  local control = tcp.metadata
  control.close_requested = true
  if control.lifecycle == TCP_CLOSED or
      control.lifecycle == TCP_CLOSING then return end
  if control.lifecycle == TCP_ALLOCATED then
    discard_tcp_storage(tcp)
    return
  end
  if control.read_active then
    shim.titan_uvshim_tcp_read_stop(tcp.handle)
    control.read_active = false
    control.read_waiter = nil
    control.read_epoch = 0
    control.read_bytes = nil
    tcp.buffer = nil
  end
  control.lifecycle = TCP_CLOSING
  shim.titan_uvshim_tcp_close(tcp.handle)
end

local function free_dns_result(control: NetRequestControl)
  if control.result_pointer ~= nil and not control.result_freed then
    shim.titan_uvshim_addrinfo_free(control.result_pointer)
    -- TITAN_UV_PHASE5_DNS_RELEASE
    control.result_freed = true
    control.result_pointer = nil
  end
end

local function retire_net_control(control: NetRequestControl)
  if control.lifecycle == NET_OWNER_RETIRED then return end
  free_dns_result(control)
  local raw_owner = control.owner
  local operation = control.operation
  if raw_owner == nil then
    unlink_net_control(control)
  elseif control.kind == NET_OWNER_DNS then
    local owner = raw_owner as uv_getaddrinfo_t
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
    owner.root = nil
    owner.buffer = nil
  elseif control.kind == NET_OWNER_CONNECT then
    local owner = raw_owner as uv_connect_t
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
    owner.root = nil
    owner.buffer = nil
  elseif control.kind == NET_OWNER_WRITE then
    local owner = raw_owner as uv_write_t
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
    owner.root = nil
    owner.buffer = nil
  else
    local owner = raw_owner as uv_shutdown_t
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
    owner.root = nil
    owner.buffer = nil
  end
  if operation.owner == raw_owner then operation.owner = nil end
  control.owner = nil
  control.lifecycle = NET_OWNER_RETIRED
end

local function clean_fs_owner(owner: uv_fs_t)
  if not owner.metadata.cleaned then
    -- TITAN_UV_FS_TEST_CLEANUP
    libuv.uv_fs_req_cleanup(owner.handle)
    owner.metadata.cleaned = true
  end
  owner.metadata.lifecycle = FS_OWNER_CLEANED
end

local function fs_operation_name(kind: integer): string
  if kind == FS.stat then return "fs.stat" end
  if kind == FS.open then return "fs.open" end
  if kind == FS.read then return "fs.read" end
  if kind == FS.write then return "fs.write" end
  if kind == FS.flush then return "fs.flush" end
  if kind == FS.close or kind == FS.internal_close then return "fs.close" end
  if kind == FS.mkdir then return "fs.mkdir" end
  if kind == FS.unlink then return "fs.unlink" end
  if kind == FS.rmdir then return "fs.rmdir" end
  if kind == FS.rename then return "fs.rename" end
  if kind == FS.list then return "fs.list" end
  return "fs.unknown"
end

local function fs_operation_subject(operation: FsOperation): string?
  if operation.file ~= nil then
    return (operation.file as uv_file).subject
  elseif operation.path ~= nil then
    return (operation.path as Text).source
  end
  return nil
end

local function fs_open_flags(mode: string): integer
  local read_only = libuv.UV_FS_O_RDONLY as integer
  local write_only = libuv.UV_FS_O_WRONLY as integer
  local read_write = libuv.UV_FS_O_RDWR as integer
  local create = libuv.UV_FS_O_CREAT as integer
  local truncate = libuv.UV_FS_O_TRUNC as integer
  local append = libuv.UV_FS_O_APPEND as integer
  if mode == "r" or mode == "rb" then return read_only end
  if mode == "w" or mode == "wb" then
    return write_only | create | truncate
  end
  if mode == "a" or mode == "ab" then
    return write_only | create | append
  end
  if mode == "r+" or mode == "r+b" or mode == "rb+" then
    return read_write
  end
  if mode == "w+" or mode == "w+b" or mode == "wb+" then
    return read_write | create | truncate
  end
  if mode == "a+" or mode == "a+b" or mode == "ab+" then
    return read_write | create | append
  end
  raise "invalid file mode '" .. mode .. "'"
end

local function fs_operation_runtime(operation: FsOperation): Runtime
  if operation.file ~= nil then
    return (operation.file as uv_file).runtime
  end
  return (operation.task as Task).runtime
end

local function submit_fs_operation(operation: FsOperation):
                                   (uv_fs_t, integer)
  local runtime = fs_operation_runtime(operation)
  local open_flags = 0
  if operation.kind == FS.open then
    open_flags = fs_open_flags(operation.data)
  end
  -- Finish every allocating preparation before publishing a request owner as
  -- submitted. If preparation raises, libuv has seen no request and therefore
  -- owes no callback; the operation remains rooted by its Task/File for the
  -- outer fatal path without stranding a fake submitted owner.
  operation.prepared_buffer = nil
  if operation.kind == FS.read then
    operation.prepared_buffer = allocate_read_buffer(operation.maximum)
  elseif operation.kind == FS.write then
    if operation.write_bytes == nil then
      operation.write_bytes = copy_bytes(operation.data, "fs.buffer.copy")
    end
    local bytes = operation.write_bytes as Bytes
    local write_length = bytes.length - operation.write_offset
    -- TITAN_UV_FS_TEST_WRITE_LIMIT
    operation.prepared_buffer =
        make_buffer(bytes, operation.write_offset, write_length,
                    "fs.buffer.init")
  end
  -- Validate private operation state and cache every borrowed native argument
  -- before publishing the owner. The fast path of a record cast does not
  -- allocate, but its invariant-failure path raises; after publication that
  -- could otherwise strand a request that libuv has never seen.
  local kind = operation.kind
  local loop_handle: *libuv.uv_loop_t = runtime.loop.handle
  local path_data: *ffi.titan_ffi_char = nil
  local second_path_data: *ffi.titan_ffi_char = nil
  local file_handle: libuv.uv_file = -1 as libuv.uv_file
  local buffer_handle: *libuv.uv_buf_t = nil
  if kind == FS.stat or kind == FS.open or kind == FS.mkdir or
     kind == FS.unlink or kind == FS.rmdir or kind == FS.list then
    local path = operation.path as Text
    path_data = path.bytes.data
  elseif kind == FS.rename then
    local path = operation.path as Text
    local second = operation.second_path as Text
    path_data = path.bytes.data
    second_path_data = second.bytes.data
  elseif kind == FS.read or kind == FS.write then
    local file = operation.file as uv_file
    local buffer = operation.prepared_buffer as Buffer
    file_handle = file.handle
    buffer_handle = buffer.handle
  elseif kind == FS.flush or kind == FS.close or
         kind == FS.internal_close then
    local file = operation.file as uv_file
    file_handle = file.handle
  else
    raise "cannot submit unsupported filesystem operation"
  end
  -- TITAN_UV_FS_TEST_AFTER_PREPARE
  local owner = allocate_fs_owner(runtime, operation)
  if operation.prepared_buffer ~= nil then
    owner.buffer = operation.prepared_buffer
    operation.prepared_buffer = nil
  end
  owner.metadata.lifecycle = FS_OWNER_SUBMITTED
  operation.owner = owner
  local status: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
  -- TITAN_UV_FS_TEST_BEFORE_SUBMIT
  if kind == FS.stat then
    status = libuv.uv_fs_stat(loop_handle, owner.handle, path_data,
                             shim.titan_uvshim_fs_cb)
  elseif kind == FS.open then
    status = libuv.uv_fs_open(loop_handle, owner.handle, path_data,
        open_flags as ffi.titan_ffi_int,
        438 as ffi.titan_ffi_int, shim.titan_uvshim_fs_cb)
  elseif kind == FS.read then
    status = libuv.uv_fs_read(loop_handle, owner.handle, file_handle,
        buffer_handle, 1, -1, shim.titan_uvshim_fs_cb)
  elseif kind == FS.write then
    status = libuv.uv_fs_write(loop_handle, owner.handle, file_handle,
        buffer_handle, 1, -1, shim.titan_uvshim_fs_cb)
  elseif kind == FS.flush then
    status = libuv.uv_fs_fsync(loop_handle, owner.handle, file_handle,
                              shim.titan_uvshim_fs_cb)
  elseif kind == FS.close or kind == FS.internal_close then
    status = libuv.uv_fs_close(loop_handle, owner.handle, file_handle,
                              shim.titan_uvshim_fs_cb)
  elseif kind == FS.mkdir then
    status = libuv.uv_fs_mkdir(loop_handle, owner.handle, path_data,
        511 as ffi.titan_ffi_int,
        shim.titan_uvshim_fs_cb)
  elseif kind == FS.unlink then
    status = libuv.uv_fs_unlink(loop_handle, owner.handle, path_data,
                               shim.titan_uvshim_fs_cb)
  elseif kind == FS.rmdir then
    status = libuv.uv_fs_rmdir(loop_handle, owner.handle, path_data,
                              shim.titan_uvshim_fs_cb)
  elseif kind == FS.rename then
    status = libuv.uv_fs_rename(loop_handle, owner.handle, path_data,
        second_path_data, shim.titan_uvshim_fs_cb)
  else
    status = libuv.uv_fs_scandir(loop_handle, owner.handle, path_data, 0,
                                shim.titan_uvshim_fs_cb)
  end
  if (status as integer) < 0 then
    clean_fs_owner(owner)
  end
  -- TITAN_UV_FS_TEST_AFTER_SUBMIT
  return owner, status as integer
end

local function start_owner(runtime: Runtime, kind: integer, task: value,
                           peer: value, epoch: integer,
                           timeout: integer, repeat_time: integer):
                           (uv_timer_t, integer)
  local owner, pointer = allocate_owner(runtime, kind, task, peer, epoch)
  local status = libuv.uv_timer_init(runtime.loop.handle, owner.handle)
  if (status as integer) < 0 then
    -- Keep synchronous rejection cleanup in this already-reserved frame.
    -- Calling unlink_owner here would enter another Titan function after the
    -- owner was published, opening an emergency GC/stack-growth longjmp gap.
    local previous = owner.metadata.previous_owner
    local next = owner.metadata.next_owner
    if previous ~= nil then
      local before = previous as uv_timer_t
      before.metadata.next_owner = next
    else
      runtime.timer_owner_head = next
    end
    if next ~= nil then
      local after = next as uv_timer_t
      after.metadata.previous_owner = previous
    end
    owner.metadata.previous_owner = nil
    owner.metadata.next_owner = nil
    owner.handle = nil
    owner.storage = nil
    owner.metadata.lifecycle = OWNER_CLOSED
    return owner, status as integer
  end
  owner.metadata.lifecycle = OWNER_ACTIVE
  shim.titan_uvshim_timer_set_data(owner.handle, pointer)
  status = libuv.uv_timer_start(owner.handle, shim.titan_uvshim_timer_cb,
                               timeout, repeat_time)
  if (status as integer) < 0 then
    -- As above, do not cross a fresh Titan function prologue after libuv owns
    -- an initialized handle. The Ticker caller rolls back its public `open`
    -- state immediately after this native owner transition returns.
    libuv.uv_timer_stop(owner.handle)
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(owner.handle)
  end
  return owner, status as integer
end

local function terminal(state: integer): boolean
  return state == TASK_SUCCEEDED or state == TASK_FAILED or
         state == TASK_CANCELLED
end

local function promote_fatal(runtime: Runtime, err: value, trace: string)
  if not runtime.fatal then
    runtime.fatal = true
    -- Prevent the remainder of this callback from admitting ordinary work.
    -- Cleanup requests remain legal while the outer driver drains the session.
    runtime.closing = true
    runtime.fatal_error = err
    runtime.fatal_traceback = trace
    libuv.uv_stop(runtime.loop.handle)
  end
end

local function remove_joiner(task: Task)
  local raw_target = task.joining_target
  if raw_target == nil then
    return
  end
  local target = raw_target as Task
  local previous = task.join_previous
  local next = task.join_next
  if previous ~= nil then
    local before = previous as Task
    before.join_next = next
  else
    target.joiner_head = next
  end
  if next ~= nil then
    local after = next as Task
    after.join_previous = previous
  end
  task.join_previous = nil
  task.join_next = nil
  task.joining_target = nil
  target.observer_count = target.observer_count - 1
  if target.observer_count < 0 then
    raise "Task observer count became negative"
  end
end

local function add_joiner(target: Task, task: Task)
  local previous = target.joiner_head
  task.joining_target = target
  task.join_previous = nil
  task.join_next = previous
  if previous ~= nil then
    local old = previous as Task
    old.join_previous = task
  end
  target.joiner_head = task
  target.observer_count = target.observer_count + 1
end

local function schedule_observation(task: Task)
  local runtime = task.runtime
  runtime.pending_observations = runtime.pending_observations + 1
  local owner, status = start_owner(runtime, OWNER_OBSERVE, task, nil,
                                    task.epoch, 0, 0)
  if status < 0 then
    if owner.metadata.lifecycle == OWNER_CLOSED then
      runtime.pending_observations = runtime.pending_observations - 1
    end
    promote_fatal(runtime, make_error(status, "task.observe", nil), "")
  else
    owner.root = task
  end
end

local function wake_joiners(task: Task)
  local raw = task.joiner_head
  while raw ~= nil do
    local joiner = raw as Task
    raw = joiner.join_next
    local owner, status = start_owner(task.runtime, OWNER_JOIN_WAKE,
                                      joiner, task, joiner.epoch, 0, 0)
    if status < 0 then
      promote_fatal(task.runtime,
                    make_error(status, "task.join.wake", nil), "")
    else
      joiner.operation = owner
    end
  end
end

local function finish_task(task: Task, state: integer, result: value,
                           err: value, trace: string)
  if terminal(task.state) then
    return
  end
  local runtime = task.runtime
  task.operation = nil
  task.current_request = nil
  task.result = result
  task.error_value = err
  task.error_traceback = trace
  task.state = state
  task.cancel_deferred = false
  task.cancel_fallback = false
  task.cleanup_shield_depth = 0
  unlink_task(task)
  if state == TASK_FAILED and task.main then
    promote_fatal(runtime, err, trace)
  elseif state == TASK_CANCELLED and task.main then
    promote_fatal(runtime, err, trace)
  end
  wake_joiners(task)
  if state == TASK_FAILED then
    if not task.main and not task.permanently_observed and
        task.observer_count == 0 and
        not runtime.fatal then
      schedule_observation(task)
    end
  end
  maybe_finish_session(runtime)
end

local function ticker_state(owner: uv_timer_t): TickerState
  if owner.metadata.kind ~= OWNER_TICKER then
    raise "timer wrapper is not a Ticker"
  end
  return owner.metadata.peer as TickerState
end

local function detach_fs_wait(task: Task, request: Request, owner: value)
  local operation = request.subject as FsOperation
  if operation.task ~= task or operation.request ~= request then
    raise "malformed filesystem cancellation state"
  end
  if request.cleanup then
    return
  end
  if operation.kind == FS.close_wait and operation.file ~= nil then
    if operation.linked and operation.close_waiter then
      remove_close_waiter(operation.file as uv_file, operation)
    end
    return
  end
  if operation.owner ~= nil then
    local fs_owner = operation.owner as uv_fs_t
    if fs_owner.metadata.lifecycle == FS_OWNER_SUBMITTED then
      -- Success still completes through the normal callback.  A too-late
      -- failure is likewise harmless because logical cancellation already won.
      shim.titan_uvshim_fs_cancel(fs_owner.handle)
    end
  elseif operation.file ~= nil then
    local file = operation.file as uv_file
    if operation.linked and not operation.close_waiter then
      remove_file_operation(file, operation)
      advance_file(file)
    end
  end
end

local function detach_net_wait(task: Task, request: Request, owner: value)
  local operation = request.subject as NetOperation
  if operation.task ~= task or operation.request ~= request then
    raise "malformed network cancellation state"
  end
  if request.cleanup then return end
  if operation.kind == NET_CONNECT or operation.kind == NET_LISTEN then
    if operation.tcp ~= nil then
      start_tcp_close(operation.tcp as uv_tcp_t)
    elseif operation.owner ~= nil then
      local dns = operation.owner as uv_getaddrinfo_t
      if dns.metadata.lifecycle == NET_OWNER_SUBMITTED then
        shim.titan_uvshim_getaddrinfo_cancel(dns.handle)
      end
    end
    return
  end
  local tcp = operation.tcp as uv_tcp_t
  local control = tcp.metadata
  if operation.kind == NET_READ then
    if control.read_waiter == task and
        control.read_epoch == request.generation then
      stop_tcp_read(tcp, false)
    end
  elseif operation.kind == NET_ACCEPT then
    if control.accept_waiter == task and
        control.accept_epoch == request.generation then
      control.accept_waiter = nil
      control.accept_epoch = 0
    end
  elseif operation.kind == NET_WRITE then
    if operation.owner == nil and operation.linked then
      remove_output(tcp, operation)
      advance_tcp_output(tcp, nil)
    end
  elseif operation.kind == NET_SHUTDOWN then
    if operation.owner == nil and operation.linked then
      -- Once shutdown_requested is published, the physical half-close is
      -- monotonic.  Cancellation detaches only the logical waiter; the FIFO
      -- retains this taskless operation until uv_shutdown completes.
      operation.task = nil
      operation.request = nil
    end
  end
end

local function detach_wait(task: Task)
  local raw_request = task.current_request
  local raw_owner = task.operation
  if raw_request ~= nil then
    local request = raw_request as Request
    if request.kind == REQUEST_JOIN then
      local raw_target = task.joining_target
      remove_joiner(task)
      if raw_owner ~= nil then
        close_owner(raw_owner as uv_timer_t)
      end
      if raw_target ~= nil then
        local target = raw_target as Task
        if target.state == TASK_FAILED and
            not target.permanently_observed and
            target.observer_count == 0 and
            not target.runtime.fatal then
          schedule_observation(target)
        end
      end
    elseif request.kind == REQUEST_TICK then
      local owner = request.subject as uv_timer_t
      local state = ticker_state(owner)
      if state.waiter == task and state.waiter_epoch == request.generation then
        state.waiter = nil
        state.waiter_epoch = 0
      end
    elseif request.kind == REQUEST_FS then
      detach_fs_wait(task, request, raw_owner)
    elseif request.kind == REQUEST_NET then
      detach_net_wait(task, request, raw_owner)
    elseif (request.kind == REQUEST_SLEEP or
            request.kind == REQUEST_CLEANUP_SLEEP) and raw_owner ~= nil then
      close_owner(raw_owner as uv_timer_t)
    end
  elseif raw_owner ~= nil then
    close_owner(raw_owner as uv_timer_t)
  end
  task.operation = nil
  task.current_request = nil
end

local function request_cancel(task: Task, reason: value)
  if terminal(task.state) or task.cancel_requested then
    return
  end
  local runtime = task.runtime
  if runtime.generation ~= task.generation then
    raise "Task belongs to a stale libuv Runtime"
  end
  task.cancel_requested = true
  task.cancel_reason = reason
  task.cancel_value = Cancelled.new(reason)
  task.epoch = task.epoch + 1
  if task.cleanup_shield_depth > 0 then
    task.cancel_deferred = true
    return
  end
  if task.state ~= TASK_RUNNING then
    detach_wait(task)
  end
  local owner, status = start_owner(runtime, OWNER_CANCEL, task, nil,
                                    task.epoch, 0, 0)
  if status < 0 then
    task.cancel_fallback = true
    promote_fatal(runtime, make_error(status, "task.cancel", nil), "")
  else
    task.cancel_deferred = false
    task.operation = owner
  end
end

local function running_task(): Task
  if not coroutine.is_yieldable(UV_TAG) then
    raise "async operation used outside a UV Task"
  end
  local runtime = current_runtime()
  if runtime.running_task == nil then
    raise "UV Task continuation is not active"
  end
  local task = runtime.running_task as Task
  if task.generation ~= runtime.generation then
    raise "Task belongs to a stale libuv Runtime"
  end
  return task
end

local function ordinary_task(): Task
  local task = running_task()
  if task.cancel_requested then
    raise task.cancel_value
  end
  if task.runtime.closing then
    raise "the libuv Runtime is shutting down"
  end
  return task
end

local function new_request(kind: integer, subject: value,
                           milliseconds: integer): Request
  local task = ordinary_task()
  task.epoch = task.epoch + 1
  return Request.new(kind, task.epoch, task, subject, milliseconds, false)
end

local function new_cleanup_request(milliseconds: integer): Request
  local task = running_task()
  if task.cleanup_shield_depth <= 0 then
    raise "cleanup await used outside a cleanup shield"
  end
  task.epoch = task.epoch + 1
  return Request.new(REQUEST_CLEANUP_SLEEP, task.epoch, task, nil,
                     milliseconds, true)
end

local function make_fs_operation(kind: integer, task: value,
                                 request: value, path: value,
                                 second_path: value, file: value,
                                 data: string, maximum: integer): FsOperation
  return FsOperation.new(kind, task, request, path, second_path, file,
      data, maximum, 0, nil, nil, nil, nil, nil, false, false, false)
end

local function make_net_operation(kind: integer, task: value,
                                  request: value, host: value,
                                  port: integer, backlog: integer,
                                  tcp: value, data: string,
                                  maximum: integer): NetOperation
  local operation: NetOperation = {
    kind = kind,
    task = task,
    request = request,
    host = host,
    port = port,
    backlog = backlog,
    tcp = tcp,
    data = data,
    maximum = maximum,
    addresses = nil,
    address_index = 0,
    prepared_buffer = nil,
    owner = nil,
    next_operation = nil,
    previous_operation = nil,
    linked = false,
    close_waiter = false,
    last_error = nil,
  }
  return operation
end

local function new_fs_request(kind: integer, path: string,
                              second_path: string?, data: string): Request
  local request = new_request(REQUEST_FS, nil, 0)
  local copied_second: value = nil
  if second_path then
    copied_second = copy_text(second_path as string, "fs.path")
  end
  local operation = make_fs_operation(kind, request.task, request,
      copy_text(path, "fs.path"), copied_second, nil, data, 0)
  request.subject = operation
  return request
end

local function new_file_request(kind: integer, file: uv_file, data: string,
                                maximum: integer,
                                cleanup: boolean): Request
  local maybe_request: Request? = nil
  if cleanup then
    local task = running_task()
    if task.cleanup_shield_depth <= 0 then
      raise "filesystem cleanup used outside a cleanup shield"
    end
    task.epoch = task.epoch + 1
    maybe_request = Request.new(REQUEST_FS, task.epoch, task, nil, 0, true)
  else
    maybe_request = new_request(REQUEST_FS, nil, 0)
  end
  local request = maybe_request as Request
  local operation = make_fs_operation(kind, request.task, request,
      nil, nil, file, data, maximum)
  request.subject = operation
  return request
end

local function new_net_request(kind: integer, host: string?, port: integer,
                               backlog: integer, tcp: value, data: string,
                               maximum: integer, cleanup: boolean): Request
  local maybe_request: Request? = nil
  if cleanup then
    local task = running_task()
    if task.cleanup_shield_depth <= 0 then
      raise "network cleanup used outside a cleanup shield"
    end
    task.epoch = task.epoch + 1
    maybe_request = Request.new(REQUEST_NET, task.epoch, task, nil, 0, true)
  else
    maybe_request = new_request(REQUEST_NET, nil, 0)
  end
  local request = maybe_request as Request
  local copied_host: value = nil
  if host then
    copied_host = copy_text(host as string, "net.host")
  end
  local operation = make_net_operation(kind, request.task, request,
      copied_host, port, backlog, tcp, data, maximum)
  request.subject = operation
  return request
end

local function arm_request(task: Task, request: Request): value
  local runtime = task.runtime
  if request.task ~= task or request.generation ~= task.epoch or
      task.generation ~= runtime.generation then
    raise "stale private UV Request"
  end
  task.current_request = request
  if request.kind == REQUEST_SLEEP then
    local owner, status = start_owner(runtime, OWNER_SLEEP, task, request,
                                      request.generation,
                                      request.milliseconds, 0)
    if status < 0 then
      task.current_request = nil
      return make_error(status, "timer.start", nil)
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_CLEANUP_SLEEP then
    if task.cleanup_shield_depth <= 0 then
      raise "cleanup Request escaped its cleanup shield"
    end
    local owner, status = start_owner(runtime, OWNER_CLEANUP_SLEEP,
                                      task, request, request.generation,
                                      request.milliseconds, 0)
    if status < 0 then
      task.current_request = nil
      return make_error(status, "cleanup.timer.start", nil)
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_JOIN then
    local target = request.subject as Task
    if target.runtime ~= runtime or target.generation ~= runtime.generation then
      raise "cannot join a Task from another libuv Runtime"
    end
    if target == task then
      raise "a Task cannot join itself"
    end
    if terminal(target.state) then
      raise "terminal Task unexpectedly yielded a Join Request"
    end
    add_joiner(target, task)
    task.operation = nil
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_TICK then
    local owner = request.subject as uv_timer_t
    local state = ticker_state(owner)
    if state.runtime ~= runtime or state.generation ~= runtime.generation then
      raise "Ticker belongs to a stale libuv Runtime"
    end
    if not state.open then
      raise "closed Ticker unexpectedly yielded a wait Request"
    end
    if state.waiter ~= nil then
      raise "Ticker already has a waiting Task"
    end
    state.waiter = task
    state.waiter_epoch = request.generation
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_FS then
    local operation = request.subject as FsOperation
    if operation.task ~= task or operation.request ~= request then
      raise "malformed filesystem Request"
    end
    if operation.file ~= nil then
      local file = operation.file as uv_file
      if operation.kind == FS.close_wait then
        enqueue_close_waiter(file, operation)
        task.operation = operation
        task.state = TASK_WAITING
        return nil
      end
      enqueue_file_operation(file, operation)
      task.operation = operation
      task.state = TASK_WAITING
      return submit_file_head(file, task)
    end

    local owner, status = submit_fs_operation(operation)
    if status < 0 then
      task.current_request = nil
      local failure = make_error(status, fs_operation_name(operation.kind),
                                 fs_operation_subject(operation))
      retire_fs_owner_now(owner)
      return failure
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_NET then
    return arm_net_request(task, request)
  end
  raise "malformed private UV Request"
end

local function drive_task(task: Task, initial_mode: integer,
                          initial_payload: value,
                          initial_trace: string)
  local runtime = task.runtime
  local mode = initial_mode
  local payload = initial_payload
  local source_trace = initial_trace
  local immediate_iterations = 0
  while true do
    runtime.running_task = task
    task.state = TASK_RUNNING
    task.operation = nil
    task.current_request = nil
    local yielded: value = nil
    do
      if mode == DRIVE_ERROR then
        if #source_trace > 0 then
          -- Task:join's suspended catch combines this target trace with the
          -- join-site trace before the error reaches user code.  If it then
          -- escapes the child, coroutine.Coro appends the callback propagation
          -- trace once more using the same staged-trace protocol.
          stash_trace_for_append(source_trace)
        end
        yielded = task.root:error(payload, UV_TAG)
      else
        yielded = task.root:resume(payload, UV_TAG)
      end
    catch
      runtime.running_task = nil
      if task.cancel_requested and error == task.cancel_value then
        finish_task(task, TASK_CANCELLED, nil, error, traceback)
      else
        finish_task(task, TASK_FAILED, nil, error, traceback)
      end
      return
    end
    runtime.running_task = nil

    local status = task.root:status()
    if status == "dead" then
      if task.cancel_requested then
        finish_task(task, TASK_CANCELLED, nil, task.cancel_value, source_trace)
      else
        finish_task(task, TASK_SUCCEEDED, yielded, nil, "")
      end
      return
    elseif status ~= "suspended" then
      raise "invalid UV Task coroutine state"
    end

    local request = yielded as Request
    if request.task ~= task or request.generation ~= task.epoch then
      raise "malformed or stale private UV Request"
    end
    local cleanup_request = request.cleanup and
                            task.cleanup_shield_depth > 0
    if task.cancel_requested and not cleanup_request then
      mode = DRIVE_ERROR
      payload = task.cancel_value
      source_trace = ""
    else
      local immediate_error = arm_request(task, request)
      if immediate_error == nil then
        return
      end
      immediate_iterations = immediate_iterations + 1
      if immediate_iterations >= IMMEDIATE_BUDGET then
        local deferred, deferred_status = start_owner(runtime,
            OWNER_DEFER_ERROR, task, immediate_error, task.epoch,
            0, 0)
        if deferred_status < 0 then
          local infrastructure_error = make_error(deferred_status,
                                                  "task.defer", nil)
          promote_fatal(runtime, infrastructure_error, "")
          finish_task(task, TASK_FAILED, nil, infrastructure_error, "")
        else
          task.operation = deferred
          task.state = TASK_WAITING
        end
        return
      end
      mode = DRIVE_ERROR
      payload = immediate_error
      source_trace = ""
    end
  end
end

local function schedule_task_drive(task: Task, epoch: integer, mode: integer,
                                   payload: value, trace: string,
                                   cleanup_request: value): boolean
  local control = DriveControl.new(mode, payload, trace, cleanup_request)
  local owner, status = start_owner(task.runtime, OWNER_TASK_DRIVE,
                                    task, control, epoch, 0, 0)
  if status < 0 then
    promote_fatal(task.runtime,
                  make_error(status, "task.drive.schedule", nil), "")
    return false
  else
    task.operation = owner
    return true
  end
end

local function retire_fs_owner_now(owner: uv_fs_t)
  owner.handle = nil
  owner.storage = nil
  owner.root = nil
  owner.buffer = nil
  if owner.metadata.operation.owner == owner then
    owner.metadata.operation.owner = nil
  end
  unlink_fs_owner(owner)
end

local function submit_file_head(file: uv_file, inline_task: value): value
  while file.current == nil and file.queue_head ~= nil do
    local operation = file.queue_head as FsOperation
    file.current = operation
    -- TITAN_UV_FS_TEST_PAUSE_BEFORE_ALLOCATION
    local owner, status = submit_fs_operation(operation)
    if status >= 0 then
      if operation.task ~= nil then
        local task = operation.task as Task
        if task.state == TASK_WAITING and
            task.current_request == operation.request then
          task.operation = owner
        end
      end
      return nil
    end

    local failure = make_error(status, fs_operation_name(operation.kind),
                               fs_operation_subject(operation))
    retire_fs_owner_now(owner)
    remove_file_operation(file, operation)
    if operation.kind == FS.close or
        operation.kind == FS.internal_close then
      file.close_enqueued = false
    end
    if operation.task ~= nil then
      local task = operation.task as Task
      local request = operation.request as Request
      if inline_task == task and task.current_request == request and
          task.epoch == request.generation then
        task.current_request = nil
        return failure
      elseif task.state == TASK_WAITING and
             task.current_request == request and
             (task.epoch == request.generation or request.cleanup) then
        local epoch = request.generation
        if request.cleanup then epoch = task.epoch end
        local cleanup_request: value = nil
        if request.cleanup then cleanup_request = request end
        local scheduled = schedule_task_drive(task, epoch, DRIVE_ERROR,
            failure, "", cleanup_request)
        if request.cleanup and not scheduled then
          operation.kind = FS.close_wait
          enqueue_close_waiter(file, operation)
        end
      end
    else
      promote_fatal(file.runtime, failure, "")
      return nil
    end
  end
  return nil
end

local function advance_file(file: uv_file)
  submit_file_head(file, nil)
end

local function fs_operation_deliverable(operation: FsOperation): boolean
  if operation.task == nil or operation.request == nil then return false end
  local task = operation.task as Task
  local request = operation.request as Request
  if request.cleanup then
    return task.state == TASK_WAITING and
           task.current_request == request and task.cleanup_shield_depth > 0
  end
  return task.state == TASK_WAITING and task.current_request == request and
         not task.cancel_requested and
         task.epoch == request.generation
end

local function net_operation_deliverable(operation: NetOperation): boolean
  if operation.task == nil or operation.request == nil then return false end
  local task = operation.task as Task
  local request = operation.request as Request
  if request.cleanup then
    return task.state == TASK_WAITING and
           task.current_request == request and task.cleanup_shield_depth > 0
  end
  return task.state == TASK_WAITING and task.current_request == request and
         not task.cancel_requested and task.epoch == request.generation
end

local function net_operation_subject(operation: NetOperation): string?
  if operation.host ~= nil then
    return (operation.host as Text).source
  elseif operation.tcp ~= nil then
    local tcp = operation.tcp as uv_tcp_t
    if tcp.metadata.server then return "server" end
    return "connection"
  end
  return nil
end

local function start_dns(operation: NetOperation):
                         (uv_getaddrinfo_t, integer)
  local task = operation.task as Task
  local runtime = task.runtime
  local host = operation.host as Text
  local loop_handle = runtime.loop.handle
  local node = host.bytes.data
  local port = operation.port as ffi.titan_ffi_int
  local owner, pointer = allocate_dns_owner(runtime, operation)
  operation.owner = owner
  -- TITAN_UV_PHASE5_DNS_SUBMIT
  local status = shim.titan_uvshim_getaddrinfo_start(
      loop_handle, owner.handle, pointer, node, port)
  if (status as integer) >= 0 then
    owner.metadata.lifecycle = NET_OWNER_SUBMITTED
  else
    owner.metadata.callback_result = status as integer
    retire_net_control(owner.metadata)
  end
  return owner, status as integer
end

local function finish_net_setup(operation: NetOperation, tcp: uv_tcp_t?,
                                failure: value)
  operation.addresses = nil
  operation.owner = nil
  operation.tcp = nil
  if not net_operation_deliverable(operation) then
    if tcp then start_tcp_close(tcp as uv_tcp_t) end
    return
  end
  local task = operation.task as Task
  if failure ~= nil then
    drive_task(task, DRIVE_ERROR, failure, "")
  else
    local resource = tcp as uv_tcp_t
    -- TITAN_UV_PHASE5_PUBLISH
    resource.metadata.published = true
    resource.metadata.setup_operation = nil
    drive_task(task, DRIVE_RESUME, resource, "")
  end
end

local function continue_net_setup(operation: NetOperation)
  if not net_operation_deliverable(operation) then
    operation.addresses = nil
    return
  end
  local addresses = operation.addresses as AddressList
  while operation.address_index < addresses.count do
    operation.address_index = operation.address_index + 1
    local task = operation.task as Task
    local runtime = task.runtime
    local tcp, init_status = initialize_tcp(runtime)
    if init_status < 0 then
      operation.last_error = make_error(init_status, "net.tcp.init",
                                        net_operation_subject(operation))
    else
      operation.tcp = tcp
      tcp.metadata.setup_operation = operation
      if operation.kind == NET_CONNECT then
        -- Cache every borrowed native argument before the request owner is
        -- linked.  From allocation through submit, only field stores and the
        -- non-raising C shim call are allowed.
        local tcp_handle = tcp.handle
        local address_data = addresses.data as ffi.titan_ffi_void_ptr
        local address_count = addresses.count
        local address_index = operation.address_index - 1
        local owner, pointer = allocate_connect_owner(runtime, operation)
        operation.owner = owner
        tcp.metadata.connect_pending = true
        -- TITAN_UV_PHASE5_CONNECT_SUBMIT
        local status = shim.titan_uvshim_tcp_connect_start(
            owner.handle, tcp_handle, pointer, address_data,
            address_count, address_index)
        if (status as integer) >= 0 then
          owner.metadata.lifecycle = NET_OWNER_SUBMITTED
          return
        end
        tcp.metadata.connect_pending = false
        owner.metadata.callback_result = status as integer
        retire_net_control(owner.metadata)
        operation.last_error = make_error(status as integer, "net.connect",
                                          net_operation_subject(operation))
        start_tcp_close(tcp)
        return
      else
        local status = shim.titan_uvshim_tcp_bind(
            tcp.handle, addresses.data as ffi.titan_ffi_void_ptr,
            addresses.count, operation.address_index - 1)
        if (status as integer) >= 0 then
          status = shim.titan_uvshim_tcp_listen(tcp.handle,
                                                operation.backlog)
        end
        if (status as integer) >= 0 then
          tcp.metadata.lifecycle = TCP_SERVER
          tcp.metadata.server = true
          tcp.metadata.accept_capacity = operation.backlog
          finish_net_setup(operation, tcp, nil)
          return
        end
        operation.last_error = make_error(status as integer, "net.listen",
                                          net_operation_subject(operation))
        start_tcp_close(tcp)
        return
      end
    end
  end
  local failure = operation.last_error
  if failure == nil then
    failure = make_error(shim.titan_uvshim_error_eaddrnotavail() as integer,
                         "net.resolve", net_operation_subject(operation))
  end
  finish_net_setup(operation, nil, failure)
end

local function advance_tcp_output(tcp: uv_tcp_t, inline_task: value): value
  local control = tcp.metadata
  if control.lifecycle == TCP_CLOSING or
      control.lifecycle == TCP_CLOSED then
    while control.output_head ~= nil do
      local abandoned = control.output_head as NetOperation
      remove_output(tcp, abandoned)
    end
    return nil
  end
  while control.output_current == nil and control.output_head ~= nil do
    local operation = control.output_head as NetOperation
    local status: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
    if operation.kind == NET_WRITE then
      -- Prepare and root the copied bytes/buffer before publishing current or
      -- linking a libuv request owner.  A preparation failure therefore leaves
      -- an ordinary queued operation that shutdown can still repair.
      if operation.prepared_buffer == nil then
        local bytes = copy_bytes(operation.data, "net.buffer.copy")
        operation.prepared_buffer = make_buffer(bytes, 0, bytes.length,
                                                "net.buffer.init")
      end
      local buffer = operation.prepared_buffer as Buffer
      local buffer_handle = buffer.handle
      local tcp_handle = tcp.handle
      local owner, pointer = allocate_write_owner(control.runtime, operation)
      operation.owner = owner
      control.output_current = operation
      -- TITAN_UV_PHASE5_WRITE_SUBMIT
      status = shim.titan_uvshim_tcp_write_start(
          owner.handle, tcp_handle, pointer, buffer_handle)
      if (status as integer) >= 0 then
        owner.metadata.lifecycle = NET_OWNER_SUBMITTED
        operation.prepared_buffer = nil
        return nil
      end
      owner.metadata.callback_result = status as integer
      retire_net_control(owner.metadata)
    else
      local tcp_handle = tcp.handle
      local owner, pointer = allocate_shutdown_owner(control.runtime,
                                                     operation)
      operation.owner = owner
      control.output_current = operation
      -- TITAN_UV_PHASE5_SHUTDOWN_SUBMIT
      status = shim.titan_uvshim_tcp_shutdown_start(
          owner.handle, tcp_handle, pointer)
      if (status as integer) >= 0 then
        owner.metadata.lifecycle = NET_OWNER_SUBMITTED
        return nil
      end
      owner.metadata.callback_result = status as integer
      retire_net_control(owner.metadata)
    end

    -- Synchronous rejection owes no callback.  Retire the native owner and
    -- unlink/clear the FIFO publication before allocating its Error value.
    remove_output(tcp, operation)
    local failure = make_error(status as integer,
        operation.kind == NET_WRITE and "net.write" or "net.shutdown",
        net_operation_subject(operation))
    if operation.task ~= nil and operation.request ~= nil then
      local task = operation.task as Task
      local request = operation.request as Request
      if inline_task == task and task.current_request == request and
          task.epoch == request.generation then
        task.current_request = nil
        return failure
      elseif net_operation_deliverable(operation) then
        schedule_task_drive(task, request.generation, DRIVE_ERROR,
                            failure, "", nil)
      end
    else
      promote_fatal(control.runtime, failure, "")
      return nil
    end
  end
  if control.output_current == nil and control.output_head == nil and
      control.close_requested and not control.connect_pending then
    start_tcp_close(tcp)
  end
  return nil
end

local function stop_tcp_read(tcp: uv_tcp_t, deliver_eof: boolean)
  local control = tcp.metadata
  if control.read_active then
    shim.titan_uvshim_tcp_read_stop(tcp.handle)
    control.read_active = false
  end
  local raw_waiter = control.read_waiter
  local epoch = control.read_epoch
  control.read_waiter = nil
  control.read_epoch = 0
  control.read_bytes = nil
  tcp.buffer = nil
  if deliver_eof and control.read_terminal == TCP_READ_OPEN then
    control.read_terminal = TCP_READ_EOF
  end
  if deliver_eof and raw_waiter ~= nil then
    local task = raw_waiter as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      schedule_task_drive(task, epoch, DRIVE_RESUME, nil, "", nil)
    end
  end
end

local function close_accepted_queue(server: uv_tcp_t)
  while server.metadata.accept_count > 0 do
    local client = dequeue_accepted(server)
    start_tcp_close(client)
  end
end

local function stop_server_accept(server: uv_tcp_t)
  local control = server.metadata
  local raw_waiter = control.accept_waiter
  local epoch = control.accept_epoch
  control.accept_waiter = nil
  control.accept_epoch = 0
  close_accepted_queue(server)
  if raw_waiter ~= nil then
    local task = raw_waiter as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      local failure = make_error(shim.titan_uvshim_error_ecanceled() as integer,
                                 "net.accept", "server closed")
      schedule_task_drive(task, epoch, DRIVE_ERROR, failure, "", nil)
    end
  end
end

local function request_tcp_close(tcp: uv_tcp_t)
  local control = tcp.metadata
  if control.close_requested then return end
  control.close_requested = true
  if control.server then
    stop_server_accept(tcp)
  else
    stop_tcp_read(tcp, true)
  end
  if control.output_current == nil and control.output_head == nil and
      not control.connect_pending then
    start_tcp_close(tcp)
  end
end

local function wake_tcp_close_waiters(tcp: uv_tcp_t)
  local control = tcp.metadata
  while control.close_waiter_head ~= nil do
    local operation = control.close_waiter_head as NetOperation
    if not net_operation_deliverable(operation) then
      remove_tcp_close_waiter(tcp, operation)
    else
      local task = operation.task as Task
      local request = operation.request as Request
      local epoch = task.epoch
      if not request.cleanup then epoch = request.generation end
      if not schedule_task_drive(task, epoch, DRIVE_RESUME,
                                 nil, "", request) then
        return
      end
      remove_tcp_close_waiter(tcp, operation)
    end
  end
end

local function arm_net_request(task: Task, request: Request): value
  local operation = request.subject as NetOperation
  if operation.task ~= task or operation.request ~= request then
    raise "malformed network Request"
  end
  if operation.kind == NET_CONNECT or operation.kind == NET_LISTEN then
    local owner, status = start_dns(operation)
    if status < 0 then
      task.current_request = nil
      return make_error(status, "net.resolve",
                        net_operation_subject(operation))
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  end

  local tcp = operation.tcp as uv_tcp_t
  local control = tcp.metadata
  if operation.kind == NET_READ then
    if control.read_waiter ~= nil then
      raise "Connection already has a waiting reader"
    end
    local bytes = allocate_bytes(operation.maximum)
    control.read_waiter = task
    control.read_epoch = request.generation
    control.read_bytes = bytes
    tcp.buffer = bytes.storage
    -- TITAN_UV_PHASE5_READ_START
    local status = shim.titan_uvshim_tcp_read_start(tcp.handle)
    if (status as integer) < 0 then
      control.read_waiter = nil
      control.read_epoch = 0
      control.read_bytes = nil
      tcp.buffer = nil
      task.current_request = nil
      return make_error(status as integer, "net.read",
                        net_operation_subject(operation))
    end
    control.read_active = true
    task.operation = tcp
    task.state = TASK_WAITING
    return nil
  elseif operation.kind == NET_WRITE or
         operation.kind == NET_SHUTDOWN then
    enqueue_output(tcp, operation)
    task.operation = operation
    task.state = TASK_WAITING
    return advance_tcp_output(tcp, task)
  elseif operation.kind == NET_ACCEPT then
    if control.accept_waiter ~= nil then
      raise "Server already has a waiting accept Task"
    end
    control.accept_waiter = task
    control.accept_epoch = request.generation
    task.operation = tcp
    task.state = TASK_WAITING
    return nil
  elseif operation.kind == NET_CLOSE or
         operation.kind == NET_CLOSE_WAIT then
    enqueue_tcp_close_waiter(tcp, operation)
    task.operation = operation
    task.state = TASK_WAITING
    request_tcp_close(tcp)
    return nil
  end
  raise "malformed network operation"
end

local function record_close_failure(file: uv_file,
                                    operation: FsOperation): boolean
  if not operation.close_failure_recorded then
    operation.close_failure_recorded = true
    file.close_failures = file.close_failures + 1
    if file.close_failures >= FS_CLOSE_RETRY_LIMIT then
      file.close_retry_exhausted = true
    end
  end
  return not file.close_retry_exhausted
end

local function queue_internal_close(file: uv_file)
  if file.state == FS.file_closed or file.close_enqueued or
      file.close_retry_exhausted then return end
  file.state = FS.file_closing
  local operation = make_fs_operation(FS.internal_close, nil, nil,
      nil, nil, file, "", 0)
  enqueue_file_operation(file, operation)
  advance_file(file)
end

local function wake_close_waiters(file: uv_file, failure: value)
  while file.close_waiter_head ~= nil do
    local operation = file.close_waiter_head as FsOperation
    if not fs_operation_deliverable(operation) then
      remove_close_waiter(file, operation)
    else
      local task = operation.task as Task
      local request = operation.request as Request
      local epoch = request.generation
      if request.cleanup then epoch = task.epoch end
      local scheduled = false
      if failure == nil then
        scheduled = schedule_task_drive(task, epoch, DRIVE_RESUME,
                                        nil, "", request)
      else
        scheduled = schedule_task_drive(task, epoch, DRIVE_ERROR,
                                        failure, "", request)
      end
      if not scheduled then
        -- The Runtime is fatal now. Keep this exact cleanup waiter linked so
        -- an outer safe point can retry without losing its only completion.
        return
      end
      remove_close_waiter(file, operation)
    end
  end
end

local function fs_stat_kind(kind: integer): string
  if kind == 1 then return "file" end
  if kind == 2 then return "directory" end
  if kind == 3 then return "symlink" end
  return "other"
end

local function extract_fs_stat(owner: uv_fs_t): FsStatResult
  local size: libuv.int64_t = 0 as libuv.int64_t
  local mode: libuv.int64_t = 0 as libuv.int64_t
  local modified_seconds: libuv.int64_t = 0 as libuv.int64_t
  local modified_nanoseconds: libuv.int64_t = 0 as libuv.int64_t
  local kind: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
  local statbuf = libuv.uv_fs_get_statbuf(owner.handle)
  local status = shim.titan_uvshim_stat_extract(
      statbuf as ffi.titan_ffi_void_ptr, size, mode,
      modified_seconds, modified_nanoseconds, kind)
  if (status as integer) < 0 then
    raise make_error(status as integer, "fs.stat.extract",
                     (owner.metadata.operation.path as Text).source)
  end
  return FsStatResult.new(size as integer, fs_stat_kind(kind as integer),
      mode as integer, modified_seconds as integer,
      modified_nanoseconds as integer)
end

local function fs_dispatch_body(owner: uv_fs_t, event_kind: integer,
                                result: integer, size: libuv.size_t)
  local runtime = owner.metadata.runtime
  if owner.metadata.generation ~= runtime.generation then
    raise "filesystem callback owner belongs to a stale libuv Runtime"
  end
  if event_kind ~= EVENT_FS then
    raise "filesystem owner received an invalid callback event"
  end
  owner.metadata.lifecycle = FS_OWNER_CALLBACK
  local operation = owner.metadata.operation
  local payload: value = nil
  local failure: value = nil
  if result < 0 then
    failure = make_error(result, fs_operation_name(operation.kind),
                         fs_operation_subject(operation))
  elseif operation.kind == FS.stat then
    payload = extract_fs_stat(owner)
  elseif operation.kind == FS.open then
    -- The thin dispatcher recorded the returned descriptor before entering
    -- this allocating body, so even body-entry GC failure can be repaired.
    payload = nil
  elseif operation.kind == FS.read then
    local buffer = owner.buffer as Buffer
    if result == 0 then
      payload = nil
    else
      payload = bytes_string(buffer.bytes, result)
    end
  elseif operation.kind == FS.write then
    if result == 0 then
      failure = make_error(shim.titan_uvshim_error_eio() as integer,
                           "fs.write",
                           fs_operation_subject(operation))
    else
      if result > #operation.data - operation.write_offset then
        raise "filesystem write result exceeds its rooted buffer"
      end
      operation.write_offset = operation.write_offset + result
    end
  elseif operation.kind == FS.list then
    payload = extract_fs_list(owner)
  else
    payload = nil
  end
  clean_fs_owner(owner)

  if operation.kind == FS.open and failure == nil then
    local file = create_file(runtime, owner.metadata.acquired_file,
                             fs_operation_subject(operation) as string)
    owner.metadata.has_acquired_file = false
    owner.metadata.acquired_file = -1 as libuv.uv_file
    if fs_operation_deliverable(operation) then
      payload = file
    else
      queue_internal_close(file)
    end
  elseif operation.kind == FS.write and failure == nil and
         operation.write_offset < #operation.data and
         fs_operation_deliverable(operation) then
    -- A partial write remains one logical File FIFO operation.  Root and
    -- submit its next request before retiring the completed request owner.
    local next_owner, status = submit_fs_operation(operation)
    if status >= 0 then
      local task = operation.task as Task
      task.operation = next_owner
      retire_fs_owner_now(owner)
      return
    end
    failure = make_error(status, "fs.write",
                         fs_operation_subject(operation))
    retire_fs_owner_now(next_owner)
  end

  if operation.kind == FS.close or
     operation.kind == FS.internal_close then
    local file = operation.file as uv_file
    file.close_enqueued = false
    remove_file_operation(file, operation)
    if failure == nil then
      file.handle = -1 as libuv.uv_file
      file.state = FS.file_closed
    else
      if record_close_failure(file, operation) then
        queue_internal_close(file)
      end
    end
    wake_close_waiters(file, failure)
    if fs_operation_deliverable(operation) then
      local task = operation.task as Task
      if failure == nil then
        drive_task(task, DRIVE_RESUME, nil, "")
      else
        drive_task(task, DRIVE_ERROR, failure, "")
      end
    elseif failure ~= nil and
        (operation.task == nil or file.close_retry_exhausted) then
      promote_fatal(runtime, failure, "")
    end
    if file.state == FS.file_closed and file.close_waiter_head == nil then
      -- Unlink only after every potentially throwing wake/Task drive. The
      -- dispatcher catch can then repair any earlier failure from this root.
      unlink_file(file)
    end
    retire_fs_owner_now(owner)
    return
  end

  if fs_operation_deliverable(operation) then
    local task = operation.task as Task
    if failure ~= nil then
      drive_task(task, DRIVE_ERROR, failure, "")
    else
      drive_task(task, DRIVE_RESUME, payload, "")
    end
  end

  if operation.file ~= nil then
    local file = operation.file as uv_file
    remove_file_operation(file, operation)
    advance_file(file)
  end
  retire_fs_owner_now(owner)
end

-- Trusted direct filesystem dispatcher.  The native entry stays deliberately
-- thin; every allocating/extracting/bookkeeping helper call runs after this
-- function's setjmp target and under its trailing catch.
local function fs_dispatch(owner: uv_fs_t, event_kind: integer,
                           result: integer, size: libuv.size_t,
                           pointer: ffi.titan_ffi_void_ptr)
  owner.metadata.callback_result = result
  owner.metadata.callback_recorded = true
  if pointer ~= nil then
    raise "filesystem callback carried an unexpected pointer payload"
  end
  if event_kind == EVENT_FS and result >= 0 and
      owner.metadata.operation.kind == FS.open then
    owner.metadata.acquired_file = result as libuv.uv_file
    owner.metadata.has_acquired_file = true
  end
  fs_dispatch_body(owner, event_kind, result, size)
catch
  if not owner.metadata.callback_recorded then
    owner.metadata.callback_result = result
    owner.metadata.callback_recorded = true
    if event_kind == EVENT_FS and result >= 0 and
        owner.metadata.operation.kind == FS.open then
      owner.metadata.acquired_file = result as libuv.uv_file
      owner.metadata.has_acquired_file = true
    end
  end
  owner.metadata.callback_aborted = true
  if not owner.metadata.cleaned then
    -- TITAN_UV_FS_TEST_CATCH_CLEANUP
    libuv.uv_fs_req_cleanup(owner.handle)
    owner.metadata.cleaned = true
  end
  owner.metadata.lifecycle = FS_OWNER_CLEANED
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function finish_closed_tcp(tcp: uv_tcp_t)
  local control = tcp.metadata
  if control.lifecycle ~= TCP_CLOSED or control.connect_pending or
      control.output_current ~= nil then return end
  local raw_setup = control.setup_operation
  if raw_setup ~= nil then
    local operation = raw_setup as NetOperation
    control.setup_operation = nil
    operation.tcp = nil
    continue_net_setup(operation)
    -- This is the callback tail: no allocating or user-code call follows the
    -- final unlink/field clears in discard_tcp_storage.
    discard_tcp_storage(tcp)
    return
  end
  wake_tcp_close_waiters(tcp)
  if control.close_waiter_head == nil then
    discard_tcp_storage(tcp)
  end
end

local function dns_dispatch_body(owner: uv_getaddrinfo_t,
                                 event_kind: integer, result: integer,
                                 size: libuv.size_t,
                                 pointer: ffi.titan_ffi_void_ptr)
  local control = owner.metadata
  local runtime = control.runtime
  if control.generation ~= runtime.generation then
    raise "DNS callback owner belongs to a stale libuv Runtime"
  end
  if event_kind ~= EVENT_GETADDRINFO then
    raise "DNS owner received an invalid callback event"
  end
  control.lifecycle = NET_OWNER_CALLBACK
  local operation = control.operation
  local failure: value = nil
  if result < 0 then
    free_dns_result(control)
    failure = make_error(result, "net.resolve",
                         net_operation_subject(operation))
  elseif pointer == nil then
    failure = internal_error("net.resolve.result")
  else
    local addresses = copy_addresses(pointer,
        net_operation_subject(operation) as string)
    -- Root the copied address array in the operation before entering another
    -- helper or releasing the borrowed addrinfo chain.
    operation.addresses = addresses
    free_dns_result(control)
    if addresses.count == 0 then
      failure = make_error(shim.titan_uvshim_error_eaddrnotavail() as integer,
                           "net.resolve", net_operation_subject(operation))
    end
  end

  -- Keep the native request owner runtime-rooted through setup continuation
  -- and any user Task drive.  A catch can then still dereference it safely.
  if failure ~= nil then
    finish_net_setup(operation, nil, failure)
  elseif net_operation_deliverable(operation) then
    operation.address_index = 0
    continue_net_setup(operation)
  else
    operation.addresses = nil
  end
  retire_net_control(control)
end

-- The borrowed addrinfo pointer is captured before the allocating body.  The
-- trailing catch can therefore release it exactly once without allowing a
-- longjmp to cross libuv.
local function dns_dispatch(owner: uv_getaddrinfo_t, event_kind: integer,
                            result: integer, size: libuv.size_t,
                            pointer: ffi.titan_ffi_void_ptr)
  -- TITAN_UV_PHASE5_DNS_CALLBACK
  owner.metadata.callback_result = result
  owner.metadata.callback_recorded = true
  owner.metadata.result_pointer = pointer
  dns_dispatch_body(owner, event_kind, result, size, pointer)
catch
  if owner.metadata.result_pointer ~= nil and
      not owner.metadata.result_freed then
    shim.titan_uvshim_addrinfo_free(owner.metadata.result_pointer)
    owner.metadata.result_freed = true
    owner.metadata.result_pointer = nil
  end
  owner.metadata.callback_aborted = true
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function connect_dispatch_body(owner: uv_connect_t,
                                     event_kind: integer,
                                     result: integer,
                                     size: libuv.size_t)
  local control = owner.metadata
  local runtime = control.runtime
  if control.generation ~= runtime.generation then
    raise "connect callback owner belongs to a stale libuv Runtime"
  end
  if event_kind ~= EVENT_CONNECT then
    raise "connect owner received an invalid callback event"
  end
  control.lifecycle = NET_OWNER_CALLBACK
  local operation = control.operation
  local tcp = operation.tcp as uv_tcp_t
  if result >= 0 and net_operation_deliverable(operation) then
    tcp.metadata.lifecycle = TCP_CONNECTION
    tcp.metadata.server = false
    tcp.metadata.published = true
    -- TITAN_UV_PHASE5_CONNECT_PUBLISH
    tcp.metadata.setup_operation = nil
    operation.addresses = nil
    operation.tcp = nil
    drive_task(operation.task as Task, DRIVE_RESUME, tcp, "")
    retire_net_control(control)
    return
  end

  if result < 0 then
    operation.last_error = make_error(result, "net.connect",
                                      net_operation_subject(operation))
  end
  start_tcp_close(tcp)
  if tcp.metadata.close_callback_seen then finish_closed_tcp(tcp) end
  retire_net_control(control)
end

local function connect_dispatch(owner: uv_connect_t, event_kind: integer,
                                result: integer, size: libuv.size_t,
                                pointer: ffi.titan_ffi_void_ptr)
  owner.metadata.callback_result = result
  owner.metadata.callback_recorded = true
  if owner.metadata.operation.tcp ~= nil then
    local tcp = owner.metadata.operation.tcp as uv_tcp_t
    tcp.metadata.connect_pending = false
  end
  if pointer ~= nil then
    raise "connect callback carried an unexpected pointer payload"
  end
  -- TITAN_UV_PHASE5_CONNECT_CALLBACK
  connect_dispatch_body(owner, event_kind, result, size)
catch
  owner.metadata.callback_aborted = true
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function complete_output_callback(control: NetRequestControl,
                                        event_kind: integer,
                                        expected_event: integer,
                                        result: integer,
                                        operation_name: string)
  local runtime = control.runtime
  if control.generation ~= runtime.generation then
    raise "stream request owner belongs to a stale libuv Runtime"
  end
  if event_kind ~= expected_event then
    raise "stream request owner received an invalid callback event"
  end
  control.lifecycle = NET_OWNER_CALLBACK
  local operation = control.operation
  local tcp = operation.tcp as uv_tcp_t
  local failure: value = nil
  if result < 0 then
    failure = make_error(result, operation_name,
                         net_operation_subject(operation))
  elseif operation.kind == NET_SHUTDOWN then
    tcp.metadata.write_shutdown = true
  end

  -- The completed owner remains linked and roots operation while the FIFO is
  -- advanced and user continuation runs.  Terminal unlink is the callback
  -- tail, preserving a valid owner for the outer catch on every earlier path.
  remove_output(tcp, operation)
  advance_tcp_output(tcp, nil)
  if tcp.metadata.close_callback_seen then finish_closed_tcp(tcp) end
  if net_operation_deliverable(operation) then
    if failure ~= nil then
      drive_task(operation.task as Task, DRIVE_ERROR, failure, "")
    else
      drive_task(operation.task as Task, DRIVE_RESUME, nil, "")
    end
  elseif failure ~= nil and operation.task == nil then
    promote_fatal(runtime, failure, "")
  end
  retire_net_control(control)
end

local function write_dispatch(owner: uv_write_t, event_kind: integer,
                              result: integer, size: libuv.size_t,
                              pointer: ffi.titan_ffi_void_ptr)
  owner.metadata.callback_result = result
  owner.metadata.callback_recorded = true
  if pointer ~= nil then
    raise "write callback carried an unexpected pointer payload"
  end
  -- TITAN_UV_PHASE5_WRITE_CALLBACK
  complete_output_callback(owner.metadata, event_kind, EVENT_WRITE,
                           result, "net.write")
catch
  owner.metadata.callback_aborted = true
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function shutdown_dispatch(owner: uv_shutdown_t,
                                 event_kind: integer, result: integer,
                                 size: libuv.size_t,
                                 pointer: ffi.titan_ffi_void_ptr)
  owner.metadata.callback_result = result
  owner.metadata.callback_recorded = true
  if pointer ~= nil then
    raise "shutdown callback carried an unexpected pointer payload"
  end
  complete_output_callback(owner.metadata, event_kind, EVENT_SHUTDOWN,
                           result, "net.shutdown")
catch
  owner.metadata.callback_aborted = true
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function tcp_read_dispatch(tcp: uv_tcp_t, result: integer)
  local control = tcp.metadata
  if result == 0 then return end
  local raw_waiter = control.read_waiter
  local epoch = control.read_epoch
  local raw_bytes = control.read_bytes
  control.read_waiter = nil
  control.read_epoch = 0
  local payload: value = nil
  local failure: value = nil
  if result < 0 then
    if result ~= (shim.titan_uvshim_error_eof() as integer) then
      failure = make_error(result, "net.read", "connection")
      control.read_error = failure
    end
  else
    if raw_bytes == nil then
      raise "stream read callback has no rooted buffer"
    end
    local bytes = raw_bytes as Bytes
    if result > bytes.length then
      raise "stream read result exceeds its rooted buffer"
    end
    -- Keep both the control and native owner buffer roots through conversion.
    payload = bytes_string(bytes, result)
  end
  control.read_bytes = nil
  tcp.buffer = nil
  if raw_waiter ~= nil then
    local task = raw_waiter as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      if failure ~= nil then
        drive_task(task, DRIVE_ERROR, failure, "")
      else
        drive_task(task, DRIVE_RESUME, payload, "")
      end
    end
  end
end

local function server_callback_failure(server: uv_tcp_t, failure: value)
  local control = server.metadata
  control.accept_error = failure
  local raw_waiter = control.accept_waiter
  local epoch = control.accept_epoch
  control.accept_waiter = nil
  control.accept_epoch = 0
  close_accepted_queue(server)
  control.close_requested = true
  start_tcp_close(server)
  if raw_waiter ~= nil then
    local task = raw_waiter as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      drive_task(task, DRIVE_ERROR, failure, "")
    end
  end
end

local function tcp_connection_dispatch(server: uv_tcp_t, result: integer)
  if result < 0 then
    server_callback_failure(server,
        make_error(result, "net.accept", "server"))
    return
  end
  local client, init_status = initialize_tcp(server.metadata.runtime)
  if init_status < 0 then
    server_callback_failure(server,
        make_error(init_status, "net.accept.init", "server"))
    return
  end
  local status = shim.titan_uvshim_tcp_accept(server.handle, client.handle)
  if (status as integer) < 0 then
    start_tcp_close(client)
    server_callback_failure(server,
        make_error(status as integer, "net.accept", "server"))
    return
  end
  client.metadata.lifecycle = TCP_CONNECTION
  client.metadata.server = false
  local control = server.metadata
  local raw_waiter = control.accept_waiter
  local epoch = control.accept_epoch
  if raw_waiter ~= nil then
    local task = raw_waiter as Task
    control.accept_waiter = nil
    control.accept_epoch = 0
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      client.metadata.published = true
      drive_task(task, DRIVE_RESUME, client, "")
      return
    end
  end
  if not enqueue_accepted(server, client) then
    -- TITAN_UV_PHASE5_ACCEPT_OVERFLOW
    start_tcp_close(client)
  end
end

local function tcp_dispatch_body(owner: uv_tcp_t, event_kind: integer,
                                 result: integer, size: libuv.size_t)
  local control = owner.metadata
  if control.generation ~= control.runtime.generation then
    raise "TCP callback owner belongs to a stale libuv Runtime"
  end
  if event_kind == EVENT_HANDLE_CLOSE then
    finish_closed_tcp(owner)
  elseif event_kind == EVENT_STREAM_READ then
    tcp_read_dispatch(owner, result)
  elseif event_kind == EVENT_CONNECTION then
    if control.server and (control.lifecycle == TCP_CLOSING or
                           control.lifecycle == TCP_CLOSED) then
      return
    end
    if not control.server or control.lifecycle ~= TCP_SERVER then
      raise "non-server TCP owner received a connection callback"
    end
    tcp_connection_dispatch(owner, result)
  else
    raise "TCP owner received an invalid callback event"
  end
end

local function tcp_dispatch(owner: uv_tcp_t, event_kind: integer,
                            result: integer, size: libuv.size_t,
                            pointer: ffi.titan_ffi_void_ptr)
  if event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.close_callback_seen = true
    owner.metadata.lifecycle = TCP_CLOSED
    -- TITAN_UV_PHASE5_TCP_CLOSE_CALLBACK
  elseif event_kind == EVENT_STREAM_READ and result ~= 0 then
    if owner.metadata.read_active then
      shim.titan_uvshim_tcp_read_stop(owner.handle)
      owner.metadata.read_active = false
    end
    if result < 0 then
      if result == (shim.titan_uvshim_error_eof() as integer) then
        owner.metadata.read_terminal = TCP_READ_EOF
      else
        owner.metadata.read_terminal = TCP_READ_ERROR
      end
    end
  end
  if pointer ~= nil then
    raise "TCP callback carried an unexpected pointer payload"
  end
  tcp_dispatch_body(owner, event_kind, result, size)
catch
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

-- Trusted direct native dispatcher.  drive_task owns the inner Task catch;
-- this function's trailing catch is the non-raising Runtime invariant fence.
local function timer_dispatch(owner: uv_timer_t, event_kind: integer,
                              result: integer, size: libuv.size_t,
                              pointer: ffi.titan_ffi_void_ptr)
  local runtime = owner.metadata.runtime
  if pointer ~= nil then
    raise "timer callback carried an unexpected pointer payload"
  end
  if owner.metadata.generation ~= runtime.generation then
    raise "callback owner belongs to a stale libuv Runtime"
  end

  if event_kind == EVENT_HANDLE_CLOSE then
    local kind = owner.metadata.kind
    owner.metadata.lifecycle = OWNER_CLOSED
    if kind == OWNER_OBSERVE then
      runtime.pending_observations = runtime.pending_observations - 1
    end
    -- Keep this callback's owner strongly reachable while a helper can run or
    -- raise.  Only non-raising field clears remain after session bookkeeping;
    -- unlinking is the final owner operation before returning to the shim.
    maybe_finish_session(runtime)
    owner.handle = nil
    owner.storage = nil
    owner.root = nil
    owner.buffer = nil
    unlink_owner(owner)
    return
  end
  if event_kind ~= EVENT_TIMER then
    raise "timer owner received an invalid callback event"
  end

  local kind = owner.metadata.kind
  if kind ~= OWNER_TICKER then
    close_owner(owner)
  end

  if kind == OWNER_START then
    local task = owner.metadata.task as Task
    if task.state == TASK_READY and not task.cancel_requested then
      drive_task(task, DRIVE_RESUME, nil, "")
    end
  elseif kind == OWNER_SLEEP then
    local task = owner.metadata.task as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_RESUME, nil, "")
    end
  elseif kind == OWNER_CLEANUP_SLEEP then
    local task = owner.metadata.task as Task
    if task.state == TASK_WAITING and task.cleanup_shield_depth > 0 then
      drive_task(task, DRIVE_RESUME, nil, "")
    end
  elseif kind == OWNER_CANCEL then
    local task = owner.metadata.task as Task
    if not terminal(task.state) and task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_ERROR, task.cancel_value, "")
    end
  elseif kind == OWNER_JOIN_WAKE then
    local task = owner.metadata.task as Task
    local target = owner.metadata.peer as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      -- A waiting join is only permanently observed when this delivery wins.
      -- Until now cancellation may revoke the observer and promote an
      -- otherwise-unobserved target failure on its own next turn.
      target.permanently_observed = true
      remove_joiner(task)
      if target.state == TASK_SUCCEEDED then
        drive_task(task, DRIVE_RESUME, target.result, "")
      elseif target.state == TASK_FAILED or target.state == TASK_CANCELLED then
        drive_task(task, DRIVE_ERROR, target.error_value,
                   target.error_traceback)
      else
        raise "Join wakeup target is not terminal"
      end
    end
  elseif kind == OWNER_OBSERVE then
    local task = owner.metadata.task as Task
    if task.state == TASK_FAILED and not task.permanently_observed and
        task.observer_count == 0 then
      promote_fatal(runtime, task.error_value, task.error_traceback)
    end
  elseif kind == OWNER_DEFER_ERROR then
    local task = owner.metadata.task as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_ERROR, owner.metadata.peer, "")
    end
  -- TITAN_UV_PHASE5_TIMER_DISPATCH
  elseif kind == OWNER_TASK_DRIVE then
    local task = owner.metadata.task as Task
    local control = owner.metadata.peer as DriveControl
    local deliver = false
    if control.cleanup_request ~= nil then
      local request = control.cleanup_request as Request
      deliver = request.cleanup and task.state == TASK_WAITING and
                task.current_request == request and
                task.cleanup_shield_depth > 0
    else
      deliver = task.state == TASK_WAITING and
                task.epoch == owner.metadata.epoch
    end
    if deliver then
      drive_task(task, control.mode, control.payload, control.trace)
    end
  elseif kind == OWNER_TICKER then
    local state = owner.metadata.peer as TickerState
    if state.open and state.waiter ~= nil then
      local task = state.waiter as Task
      local epoch = state.waiter_epoch
      state.waiter = nil
      state.waiter_epoch = 0
      if task.state == TASK_WAITING and not task.cancel_requested and
          task.epoch == epoch then
        drive_task(task, DRIVE_RESUME, true, "")
      end
    end
  elseif kind == OWNER_TICKER_CLOSE_WAKE then
    local task = owner.metadata.task as Task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_RESUME, false, "")
    end
  else
    raise "timer owner has an invalid operation kind"
  end
catch
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function adapt(func: () -> value): (value) -> value
  return function (_ignored: value): value
    return func()
  end
end

local function run_internal(func: () -> value, is_main: boolean): Task
  local runtime = ensure_runtime()
  local root = coroutine.create(adapt(func), UV_TAG)
  local task = Task.new(root, runtime, runtime.generation, TASK_NEW, 0,
      nil, nil, "", false, nil, nil, nil, nil, nil, nil, nil, nil,
      nil, nil, false, 0, 0, false, false, is_main)
  link_task(runtime, task)
  if is_main then
    runtime.main_task = task
  end

  local owner, status = start_owner(runtime, OWNER_START, task, nil, 0, 0, 0)
  task.operation = owner
  if status < 0 then
    finish_task(task, TASK_FAILED, nil,
                make_error(status, "task.start", nil), "")
  else
    task.state = TASK_READY
  end
  return task
end

function run(func: () -> value): Task
  return run_internal(func, false)
end

function Task:status(): string
  if self.state == TASK_NEW then return "new" end
  if self.state == TASK_READY then return "ready" end
  if self.state == TASK_RUNNING then return "running" end
  if self.state == TASK_WAITING then return "waiting" end
  if self.state == TASK_SUCCEEDED then return "succeeded" end
  if self.state == TASK_FAILED then return "failed" end
  return "cancelled"
end

function Task:cancel(reason: value)
  request_cancel(self, reason)
end

function Task:join(): value
  if self.state == TASK_SUCCEEDED then
    self.permanently_observed = true
    return self.result
  elseif self.state == TASK_FAILED or self.state == TASK_CANCELLED then
    self.permanently_observed = true
    raise_joined(self.error_value, self.error_traceback)
  end

  local task = running_task()
  if task == self then
    raise "a Task cannot join itself"
  end
  if task.runtime ~= self.runtime or task.generation ~= self.generation then
    raise "cannot join a Task from another libuv Runtime"
  end
  local request = new_request(REQUEST_JOIN, self, 0)
  do
    return coroutine.yield(request, UV_TAG)
  catch
    local target_trace = pop_trace_for_append()
    if target_trace ~= nil then
      reinstall_trace((target_trace as string) .. "\n" .. traceback)
    end
    raise error
  end
end

function _sleep(milliseconds: integer)
  if milliseconds < 0 then
    raise "sleep duration must not be negative"
  end
  local request = new_request(REQUEST_SLEEP, nil, milliseconds)
  coroutine.yield(request, UV_TAG)
end

function _yield()
  _sleep(0)
end

local function cleanup_begin()
  local task = running_task()
  task.cleanup_shield_depth = task.cleanup_shield_depth + 1
end

local function cleanup_sleep(milliseconds: integer)
  if milliseconds < 0 then
    raise "cleanup sleep duration must not be negative"
  end
  local request = new_cleanup_request(milliseconds)
  coroutine.yield(request, UV_TAG)
end

local function cleanup_end()
  local task = running_task()
  if task.cleanup_shield_depth <= 0 then
    raise "cleanup shield is not active"
  end
  task.cleanup_shield_depth = task.cleanup_shield_depth - 1
  if task.cleanup_shield_depth == 0 and task.cancel_requested then
    -- Keep cancellation sticky without interrupting a sequence of library
    -- cleanup operations.  The next ordinary await injects it, or drive_task
    -- classifies a returning Task as cancelled.
    task.cancel_deferred = false
  end
end

local function cleanup_abort()
  local task = running_task()
  if task.cleanup_shield_depth <= 0 then
    raise "cleanup shield is not active"
  end
  task.cleanup_shield_depth = task.cleanup_shield_depth - 1
end

function _fs_open(path: string, mode: string): uv_file
  fs_open_flags(mode)
  local request = new_fs_request(FS.open, path, nil, mode)
  return coroutine.yield(request, UV_TAG) as uv_file
end

function _fs_read(file: uv_file, max_bytes: integer): string?
  if max_bytes <= 0 then raise "read size must be positive" end
  if (shim.titan_uvshim_buf_length_is_valid(max_bytes) as integer) == 0 then
    raise "read size exceeds the portable libuv buffer limit"
  end
  validate_file(file, "read from", false)
  local request = new_file_request(FS.read, file, "", max_bytes, false)
  return coroutine.yield(request, UV_TAG) as string?
end

function _fs_write(file: uv_file, data: string): integer
  ordinary_task()
  validate_file(file, "write to", false)
  if #data == 0 then return 0 end
  local request = new_file_request(FS.write, file, data, 0, false)
  coroutine.yield(request, UV_TAG)
  return #data
end

function _fs_flush(file: uv_file)
  validate_file(file, "flush", false)
  local request = new_file_request(FS.flush, file, "", 0, false)
  coroutine.yield(request, UV_TAG)
end

function _fs_is_closed(file: uv_file): boolean
  return file.state == FS.file_closed
end

function _fs_close(file: uv_file)
  if file.state == FS.file_closed then return end
  validate_file(file, "close", true)
  local kind = FS.close_wait
  if file.state == FS.file_open then
    file.state = FS.file_closing
  end
  if not file.close_enqueued then
    kind = FS.close
  end
  cleanup_begin()
  local completed = false
  do
    local request = new_file_request(kind, file, "", 0, true)
    coroutine.yield(request, UV_TAG)
    completed = true
  finally
    if completed then cleanup_end() else cleanup_abort() end
  end
end

function _fs_stat(path: string): (integer, string, integer, integer, integer)
  local request = new_fs_request(FS.stat, path, nil, "")
  local result = coroutine.yield(request, UV_TAG) as FsStatResult
  return result.size, result.kind, result.mode,
         result.modified_seconds, result.modified_nanoseconds
end

function _fs_mkdir(path: string)
  coroutine.yield(new_fs_request(FS.mkdir, path, nil, ""), UV_TAG)
end

function _fs_unlink(path: string)
  coroutine.yield(new_fs_request(FS.unlink, path, nil, ""), UV_TAG)
end

function _fs_rmdir(path: string)
  coroutine.yield(new_fs_request(FS.rmdir, path, nil, ""), UV_TAG)
end

function _fs_rename(from: string, to: string)
  coroutine.yield(new_fs_request(FS.rename, from, to, ""), UV_TAG)
end

function _fs_list(path: string): {string}
  return coroutine.yield(new_fs_request(FS.list, path, nil, ""),
                         UV_TAG) as {string}
end

function _net_connect(host: string, port: integer): uv_tcp_t
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
  local request = new_net_request(NET_CONNECT, host, port, 0,
                                  nil, "", 0, false)
  return coroutine.yield(request, UV_TAG) as uv_tcp_t
end

function _net_listen(host: string, port: integer,
                     backlog: integer): uv_tcp_t
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
  if backlog <= 0 then raise "TCP listen backlog must be positive" end
  if (shim.titan_uvshim_tcp_listen_backlog_is_valid(backlog) as integer) == 0 then
    raise "TCP listen backlog is not representable by libuv"
  end
  local request = new_net_request(NET_LISTEN, host, port, backlog,
                                  nil, "", 0, false)
  return coroutine.yield(request, UV_TAG) as uv_tcp_t
end

function _net_read(tcp: uv_tcp_t, max_bytes: integer): string?
  ordinary_task()
  if max_bytes <= 0 then raise "TCP read size must be positive" end
  if (shim.titan_uvshim_buf_length_is_valid(max_bytes) as integer) == 0 then
    raise "TCP read size exceeds the portable libuv buffer limit"
  end
  validate_tcp(tcp, "read from", false, false)
  local control = tcp.metadata
  if control.read_terminal == TCP_READ_EOF then return nil end
  if control.read_terminal == TCP_READ_ERROR then raise control.read_error end
  if control.read_waiter ~= nil then
    raise "Connection already has a waiting reader"
  end
  local request = new_net_request(NET_READ, nil, 0, 0,
                                  tcp, "", max_bytes, false)
  return coroutine.yield(request, UV_TAG) as string?
end

function _net_write(tcp: uv_tcp_t, data: string)
  ordinary_task()
  validate_tcp(tcp, "write to", false, false)
  if tcp.metadata.shutdown_requested then
    raise "cannot write after Connection shutdown"
  end
  if #data == 0 then return end
  local request = new_net_request(NET_WRITE, nil, 0, 0,
                                  tcp, data, 0, false)
  coroutine.yield(request, UV_TAG)
end

function _net_shutdown(tcp: uv_tcp_t)
  ordinary_task()
  validate_tcp(tcp, "shut down", false, false)
  if tcp.metadata.shutdown_requested then return end
  cleanup_begin()
  local completed = false
  do
    -- Construct the complete shielded Request before publishing the monotonic
    -- shutdown flag. Once visible, cancellation cannot detach the physical
    -- FIFO work and is delivered only after uv_shutdown completes.
    local request = new_net_request(NET_SHUTDOWN, nil, 0, 0,
                                    tcp, "", 0, true)
    tcp.metadata.shutdown_requested = true
    coroutine.yield(request, UV_TAG)
    completed = true
  finally
    if completed then cleanup_end() else cleanup_abort() end
  end
end

function _net_accept(server: uv_tcp_t): uv_tcp_t
  ordinary_task()
  validate_tcp(server, "accept on", true, false)
  local control = server.metadata
  if control.accept_error ~= nil then raise control.accept_error end
  if control.accept_count > 0 then
    local client = dequeue_accepted(server)
    client.metadata.published = true
    return client
  end
  if control.accept_waiter ~= nil then
    raise "Server already has a waiting accept Task"
  end
  local request = new_net_request(NET_ACCEPT, nil, 0, 0,
                                  server, "", 0, false)
  return coroutine.yield(request, UV_TAG) as uv_tcp_t
end

function _net_close(tcp: uv_tcp_t)
  if tcp.metadata.lifecycle == TCP_CLOSED then return end
  validate_tcp(tcp, "close", tcp.metadata.server, true)
  cleanup_begin()
  local completed = false
  do
    local kind = NET_CLOSE
    if tcp.metadata.close_requested then kind = NET_CLOSE_WAIT end
    local request = new_net_request(kind, nil, 0, 0,
                                    tcp, "", 0, true)
    coroutine.yield(request, UV_TAG)
    completed = true
  finally
    if completed then cleanup_end() else cleanup_abort() end
  end
end

function _net_is_closed(tcp: uv_tcp_t): boolean
  return tcp.metadata.lifecycle == TCP_CLOSED
end

function _net_find(haystack: string, needle: string): integer
  local result = shim.titan_uvshim_bytes_find(
      haystack, #haystack, needle, #needle) as integer
  if result < -1 then
    raise make_error(result, "net.bytes.find", nil)
  end
  return result
end

function _net_slice(data: string, offset: integer,
                    length: integer): string
  if offset < 0 or length < 0 or offset > #data or
      length > #data - offset then
    raise "network byte slice is out of range"
  end
  local bytes = allocate_bytes(length)
  local status = shim.titan_uvshim_bytes_slice_copy(
      bytes.data, length, data, #data, offset, length)
  if (status as integer) < 0 then
    raise make_error(status as integer, "net.bytes.slice", nil)
  end
  return bytes_string(bytes, length)
end

function _net_eof_error(operation: string, message: string,
                        subject: string): Error
  local code = shim.titan_uvshim_error_eof() as integer
  return Error.new(code,
      libuv.uv_err_name(code as ffi.titan_ffi_int) as string,
      message, operation, subject)
end

-- Test-source variants insert fault controls here. Production keeps the
-- corresponding branches private and unreachable from the module interface.
-- TITAN_UV_TEST_HOOKS

function _ticker(milliseconds: integer): uv_timer_t
  if milliseconds <= 0 then
    raise "Ticker interval must be positive"
  end
  local task = running_task()
  if task.cancel_requested then
    raise task.cancel_value
  end
  if task.runtime.closing then
    raise "the libuv Runtime is shutting down"
  end
  local runtime = task.runtime
  local state = TickerState.new(runtime, runtime.generation, true,
                                milliseconds, nil, nil, 0)
  local owner, status = start_owner(runtime, OWNER_TICKER, nil, state, 0,
                                    milliseconds, milliseconds)
  state.owner = owner
  owner.root = state
  if status < 0 then
    state.open = false
    raise make_error(status, "ticker.start", nil)
  end
  return owner
end

function _ticker_tick(owner: uv_timer_t): boolean
  local state = ticker_state(owner)
  if not state.open then
    return false
  end
  -- The loop is serial: checking before the yield makes a second waiter a
  -- normal Task error instead of letting it reach arm_request as an internal
  -- dispatcher invariant failure.
  if state.waiter ~= nil then
    raise "Ticker already has a waiting Task"
  end
  local request = new_request(REQUEST_TICK, owner, 0)
  return coroutine.yield(request, UV_TAG) as boolean
end

function _ticker_close(owner: uv_timer_t)
  local state = ticker_state(owner)
  if not state.open then
    return
  end
  if state.generation ~= state.runtime.generation then
    raise "Ticker belongs to a stale libuv Runtime"
  end
  state.open = false
  close_owner(owner)
  if state.waiter ~= nil then
    local task = state.waiter as Task
    local epoch = state.waiter_epoch
    state.waiter = nil
    state.waiter_epoch = 0
    local wake, status = start_owner(state.runtime,
        OWNER_TICKER_CLOSE_WAKE, task, owner, epoch, 0, 0)
    if status < 0 then
      promote_fatal(state.runtime,
                    make_error(status, "ticker.close.wake", nil), "")
    else
      task.operation = wake
    end
  end
end

local function repair_aborted_fs_callback(owner: uv_fs_t)
  if not owner.metadata.callback_aborted then return end
  local operation = owner.metadata.operation
  if operation.owner ~= nil and operation.owner ~= owner then
    -- A partial write may already have rooted its next submitted request.
    -- That newer callback, not this retired owner, still owns logical repair.
    return
  end
  if operation.owner == owner then operation.owner = nil end
  if operation.file == nil then return end

  local file = operation.file as uv_file
  if operation.kind == FS.close or
      operation.kind == FS.internal_close then
    if operation.linked and not operation.close_waiter then
      remove_file_operation(file, operation)
      file.close_enqueued = false
    end

    -- A public close whose native callback reached the invariant catch still
    -- owns a shielded continuation. Convert it into an ordinary close waiter;
    -- an outer safe point will either deliver the successful physical close or
    -- retry a failed close before waking it.
    if operation.kind == FS.close and operation.task ~= nil and
        operation.request ~= nil and not operation.linked then
      local task = operation.task as Task
      local request = operation.request as Request
      if task.state == TASK_WAITING and task.current_request == request and
          request.cleanup and task.cleanup_shield_depth > 0 then
        operation.kind = FS.close_wait
        enqueue_close_waiter(file, operation)
      end
    end

    if owner.metadata.callback_result >= 0 then
      file.handle = -1 as libuv.uv_file
      file.state = FS.file_closed
    else
      file.state = FS.file_closing
      record_close_failure(file, operation)
    end
  elseif operation.linked and not operation.close_waiter then
    -- The native operation is terminal even though result delivery or
    -- bookkeeping failed. Remove it so fatal cancellation and File shutdown
    -- can make progress; no obsolete result is delivered.
    remove_file_operation(file, operation)
  end
end

local function retire_fs_owners(runtime: Runtime)
  local raw = runtime.fs_pending_head
  while raw ~= nil do
    local owner = raw as uv_fs_t
    raw = owner.metadata.next_owner
    if owner.metadata.lifecycle == FS_OWNER_CLEANED then
      repair_aborted_fs_callback(owner)
      if not owner.metadata.has_acquired_file then
        retire_fs_owner_now(owner)
      end
    end
  end
end

local function repair_acquired_files(runtime: Runtime)
  local raw = runtime.fs_pending_head
  while raw ~= nil do
    local owner = raw as uv_fs_t
    raw = owner.metadata.next_owner
    if owner.metadata.lifecycle == FS_OWNER_CLEANED and
        owner.metadata.has_acquired_file then
      local operation = owner.metadata.operation
      local subject = "<late-open>"
      local actual_subject = fs_operation_subject(operation)
      if actual_subject then subject = actual_subject as string end
      local file = create_file(runtime, owner.metadata.acquired_file,
                               subject)
      owner.metadata.acquired_file = -1 as libuv.uv_file
      owner.metadata.has_acquired_file = false
      queue_internal_close(file)
    end
  end
  retire_fs_owners(runtime)
end

local function begin_file_shutdown(runtime: Runtime)
  local raw = runtime.file_head
  while raw ~= nil do
    local file = raw as uv_file
    raw = file.next_file
    queue_internal_close(file)
  end
end

local function advance_file_shutdown(runtime: Runtime)
  local raw = runtime.file_head
  while raw ~= nil do
    local file = raw as uv_file
    raw = file.next_file
    if file.state == FS.file_closed then
      wake_close_waiters(file, nil)
      if file.close_waiter_head == nil then unlink_file(file) end
    elseif file.current == nil and not file.close_enqueued and
        file.queue_head == nil then
      queue_internal_close(file)
    elseif file.current == nil then
      advance_file(file)
    end
  end
end

local function retire_aborted_net_requests(runtime: Runtime)
  local raw = runtime.net_pending_head
  while raw ~= nil do
    local control = raw as NetRequestControl
    raw = control.next_control
    if control.lifecycle == NET_OWNER_CALLBACK or
        control.lifecycle == NET_OWNER_ALLOCATED then
      local operation = control.operation
      if control.kind == NET_OWNER_CONNECT and operation.tcp ~= nil then
        local tcp = operation.tcp as uv_tcp_t
        tcp.metadata.connect_pending = false
        start_tcp_close(tcp)
      elseif (control.kind == NET_OWNER_WRITE or
              control.kind == NET_OWNER_SHUTDOWN) and
             operation.tcp ~= nil then
        local tcp = operation.tcp as uv_tcp_t
        if control.kind == NET_OWNER_SHUTDOWN and
            control.callback_recorded and control.callback_result >= 0 then
          tcp.metadata.write_shutdown = true
        end
        if operation.linked then remove_output(tcp, operation) end
      end
      retire_net_control(control)
    end
  end
end

local function begin_tcp_shutdown(runtime: Runtime)
  local raw = runtime.tcp_head
  while raw ~= nil do
    local control = raw as TcpControl
    raw = control.next_control
    local owner = control.owner
    if owner ~= nil then
      local tcp = owner as uv_tcp_t
      control.close_requested = true
      if control.server then
        control.accept_waiter = nil
        control.accept_epoch = 0
        close_accepted_queue(tcp)
      else
        stop_tcp_read(tcp, false)
      end
      start_tcp_close(tcp)
      if control.output_current == nil then
        while control.output_head ~= nil do
          remove_output(tcp, control.output_head as NetOperation)
        end
      end
    end
  end
end

local function advance_tcp_shutdown(runtime: Runtime)
  retire_aborted_net_requests(runtime)
  local raw = runtime.tcp_head
  while raw ~= nil do
    local control = raw as TcpControl
    raw = control.next_control
    if control.owner ~= nil then
      local tcp = control.owner as uv_tcp_t
      if control.lifecycle == TCP_CLOSED then
        finish_closed_tcp(tcp)
      elseif control.lifecycle ~= TCP_CLOSING then
        start_tcp_close(tcp)
      end
    end
  end
end

local function only_exhausted_files_remain(runtime: Runtime): boolean
  if runtime.timer_owner_head ~= nil or runtime.fs_pending_head ~= nil or
      runtime.net_pending_head ~= nil or runtime.tcp_head ~= nil or
      runtime.file_head == nil then
    return false
  end
  local raw = runtime.file_head
  while raw ~= nil do
    local file = raw as uv_file
    if not file.close_retry_exhausted then return false end
    raw = file.next_file
  end
  return true
end

local function drive_cancel_fallbacks(runtime: Runtime)
  local raw = runtime.task_head
  while raw ~= nil do
    local task = raw as Task
    raw = task.next_task
    if task.cancel_fallback and not terminal(task.state) then
      task.cancel_fallback = false
      drive_task(task, DRIVE_ERROR, task.cancel_value, "")
    end
  end
end

local function begin_fatal_shutdown(runtime: Runtime)
  runtime.closing = true
  local raw_task = runtime.task_head
  while raw_task ~= nil do
    local task = raw_task as Task
    raw_task = task.next_task
    request_cancel(task, runtime.fatal_error)
  end

  local raw_owner = runtime.timer_owner_head
  while raw_owner ~= nil do
    local owner = raw_owner as uv_timer_t
    raw_owner = owner.metadata.next_owner
    if owner.metadata.kind == OWNER_TICKER or
        owner.metadata.kind == OWNER_OBSERVE then
      close_owner(owner)
    end
  end
end

local function retire_closed_owners(runtime: Runtime)
  local raw = runtime.timer_owner_head
  while raw ~= nil do
    local owner = raw as uv_timer_t
    raw = owner.metadata.next_owner
    if owner.metadata.lifecycle == OWNER_CLOSED then
      owner.handle = nil
      owner.storage = nil
      owner.root = nil
      owner.buffer = nil
      unlink_owner(owner)
    end
  end
end

local function shutdown_no_progress_error(runtime: Runtime): Error
  local timers = 0
  local raw_timer = runtime.timer_owner_head
  while raw_timer ~= nil do
    timers = timers + 1
    raw_timer = (raw_timer as uv_timer_t).metadata.next_owner
  end
  local filesystem = 0
  local raw_fs = runtime.fs_pending_head
  while raw_fs ~= nil do
    filesystem = filesystem + 1
    raw_fs = (raw_fs as uv_fs_t).metadata.next_owner
  end
  local files = 0
  local raw_file = runtime.file_head
  while raw_file ~= nil do
    files = files + 1
    raw_file = (raw_file as uv_file).next_file
  end
  local requests = 0
  local first_request_state = -1
  local raw_request = runtime.net_pending_head
  while raw_request ~= nil do
    local control = raw_request as NetRequestControl
    if first_request_state < 0 then first_request_state = control.lifecycle end
    requests = requests + 1
    raw_request = control.next_control
  end
  local tcp = 0
  local first_tcp_state = -1
  local raw_tcp = runtime.tcp_head
  while raw_tcp ~= nil do
    local control = raw_tcp as TcpControl
    if first_tcp_state < 0 then first_tcp_state = control.lifecycle end
    tcp = tcp + 1
    raw_tcp = control.next_control
  end
  return Error.new(-1, "EINTERNAL", "libuv Runtime made no shutdown progress",
      "shutdown.no-progress", "timers=" .. timers .. ", fs=" .. filesystem ..
      ", files=" .. files .. ", net_requests=" .. requests ..
      "(first_state=" .. first_request_state .. "), tcp=" .. tcp ..
      "(first_state=" .. first_tcp_state .. ")")
end

local function close_runtime(runtime: Runtime)
  retire_closed_owners(runtime)
  retire_fs_owners(runtime)
  repair_acquired_files(runtime)
  retire_aborted_net_requests(runtime)
  begin_file_shutdown(runtime)
  advance_file_shutdown(runtime)
  begin_tcp_shutdown(runtime)
  advance_tcp_shutdown(runtime)
  close_all_owners(runtime)
  retire_closed_owners(runtime)
  local terminal_files = only_exhausted_files_remain(runtime)
  local idle_passes = 0
  -- Drain owners registered in the Runtime. An unknown active handle must not
  -- make UV_RUN_DEFAULT hang here; once known owners are gone, loop_close
  -- reports UV_EBUSY and the public uv_walk diagnostic below identifies it.
  while not terminal_files and
        (runtime.timer_owner_head ~= nil or runtime.fs_pending_head ~= nil or
         runtime.file_head ~= nil or runtime.net_pending_head ~= nil or
         runtime.tcp_head ~= nil) do
    local callbacks = libuv.uv_run(runtime.loop.handle,
                                  libuv.UV_RUN_DEFAULT) as integer
    retire_closed_owners(runtime)
    retire_fs_owners(runtime)
    repair_acquired_files(runtime)
    advance_file_shutdown(runtime)
    advance_tcp_shutdown(runtime)
    -- A callback may have called uv_stop or created a cleanup owner before it
    -- returned.  Re-close/re-run only from this outer driver safe point.
    close_all_owners(runtime)
    retire_closed_owners(runtime)
    retire_fs_owners(runtime)
    advance_tcp_shutdown(runtime)
    terminal_files = only_exhausted_files_remain(runtime)
    if not terminal_files and
       (runtime.timer_owner_head ~= nil or runtime.fs_pending_head ~= nil or
        runtime.file_head ~= nil or runtime.net_pending_head ~= nil or
        runtime.tcp_head ~= nil) then
      if callbacks == 0 then
        idle_passes = idle_passes + 1
      else
        idle_passes = 0
      end
      if idle_passes >= 2 then
        if not runtime.fatal then
          runtime.fatal = true
          runtime.closing = true
          runtime.fatal_error = shutdown_no_progress_error(runtime)
          runtime.fatal_traceback = ""
        end
        -- Preserve every still-rooted native allocation and return the first
        -- fatal error instead of spinning an idle uv_run forever.
        return
      end
    end
  end
  local status = libuv.uv_loop_close(runtime.loop.handle)
  if (status as integer) ~= 0 then
    if not runtime.fatal then
      runtime.fatal = true
      local subject: string? = nil
      if (shim.titan_uvshim_status_is_ebusy(
              status as ffi.titan_ffi_int) as integer) ~= 0 then
        local count = shim.titan_uvshim_loop_handle_count(
            runtime.loop.handle) as integer
        local first = shim.titan_uvshim_loop_first_handle_type(
            runtime.loop.handle) as string
        subject = "remaining handles=" .. count .. ", first=" .. first
      end
      runtime.fatal_error = make_error(status as integer, "loop.close",
                                       subject)
      runtime.fatal_traceback = ""
    end
    -- Keep active_runtime and its storage root intact: reclaiming a busy loop
    -- would be a native use-after-free even on an error-reporting path.
    return
  end
  runtime.loop.handle = nil
  runtime.loop.storage = nil
  if runtime.file_head == nil and runtime.net_pending_head == nil and
      runtime.tcp_head == nil then
    active_runtime = nil
  end
end

function loop()
  if not on_main_thread() or coroutine.is_yieldable(UV_TAG) then
    raise "uv.loop must be driven from the Lua main thread"
  end
  if not active_runtime then
    return
  end
  if (lua.lua_checkstack(L, lua.LUA_MINSTACK) as integer) == 0 then
    raise "cannot reserve stack for libuv native callbacks"
  end
  local runtime = active_runtime as Runtime
  if runtime.loop.handle == nil then
    raise_saved(runtime.fatal_error, runtime.fatal_traceback)
  end
  if runtime.in_loop then
    raise "uv.loop is already active"
  end
  runtime.in_loop = true
  libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)
  runtime.in_loop = false
  retire_closed_owners(runtime)
  retire_fs_owners(runtime)
  repair_acquired_files(runtime)
  retire_aborted_net_requests(runtime)

  if not runtime.fatal and runtime.task_head ~= nil then
    runtime.fatal = true
    runtime.closing = true
    runtime.fatal_error = "libuv loop became idle while Tasks were waiting: " ..
                          waiting_task_diagnostic(runtime)
    runtime.fatal_traceback = ""
  end
  if runtime.fatal then
    begin_fatal_shutdown(runtime)
    advance_file_shutdown(runtime)
    begin_tcp_shutdown(runtime)
    advance_tcp_shutdown(runtime)
    drive_cancel_fallbacks(runtime)
    while runtime.task_head ~= nil do
      if (libuv.uv_loop_alive(runtime.loop.handle) as integer) == 0 then
        -- No callback can make progress.  The only legal callback-less
        -- cancellation delivery is this outer-driver fallback.
        local raw = runtime.task_head
        while raw ~= nil do
          local task = raw as Task
          raw = task.next_task
          if task.cancel_requested and task.cleanup_shield_depth == 0 then
            task.cancel_fallback = true
          end
        end
        drive_cancel_fallbacks(runtime)
        if runtime.task_head ~= nil and
            (libuv.uv_loop_alive(runtime.loop.handle) as integer) == 0 then
          -- A shielded Task without any live cleanup owner is an internal
          -- deadlock, not a reason to return with a suspended root retained.
          -- The first Runtime fatal remains authoritative; terminalize these
          -- impossible leftovers at the outer safe point so owner draining and
          -- uv_loop_close remain total.
          local invariant_error = internal_error("shutdown.deadlock")
          local stranded = runtime.task_head
          while stranded ~= nil do
            local task = stranded as Task
            stranded = task.next_task
            finish_task(task, TASK_FAILED, nil, invariant_error, "")
          end
        end
      else
        libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)
        retire_closed_owners(runtime)
        retire_fs_owners(runtime)
        repair_acquired_files(runtime)
        retire_aborted_net_requests(runtime)
        advance_file_shutdown(runtime)
        advance_tcp_shutdown(runtime)
        drive_cancel_fallbacks(runtime)
      end
    end
  else
    advance_file_shutdown(runtime)
    advance_tcp_shutdown(runtime)
  end
  close_runtime(runtime)
  if runtime.fatal then
    raise_saved(runtime.fatal_error, runtime.fatal_traceback)
  end
end

local function bootstrap(main_callable: ({string}) -> integer,
                         args: {string}): integer
  local task = run_internal(function (): value
    return main_callable(args)
  end, true)
  loop()
  if task.state ~= TASK_SUCCEEDED then
    raise_saved(task.error_value, task.error_traceback)
  end
  return task.result as integer
end

function version(): string
  return libuv.uv_version_string() as string
end

local function install_bootstrap()
  local top = lua.lua_gettop(L)
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_BOOTSTRAP_KEY)
  local installed: value = ffi.lua_totvalue(L, -1)
  if installed ~= nil and installed ~= bootstrap then
    lua.lua_settop(L, top)
    raise "a different Titan main bootstrap is already installed"
  end
  ffi.lua_pushtvalue(L, bootstrap)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_BOOTSTRAP_KEY)
  lua.lua_settop(L, top)
end

do
  install_bootstrap()
end
