local uv = import "uv"
local str = import "string"

-- Stream payloads are binary strings, so delimiter handling uses the string
-- library's length-aware literal search and slicing operations.

record Connection
  local handle: uv.uv_tcp_t
  local excess: string
end

record Server
  local handle: uv.uv_tcp_t
end

local function check_host(host: string)
  if #host == 0 then raise "network host must not be empty" end
end

local function check_connect_port(port: integer)
  if port <= 0 or port > 65535 then
    raise "connect port must be between 1 and 65535"
  end
end

local function check_listen_port(port: integer)
  if port < 0 or port > 65535 then
    raise "listen port must be between 0 and 65535"
  end
end

local function read(connection: Connection): string?
  if uv._net_is_closed(connection.handle) then
    connection.excess = ""
    return nil
  end
  if #connection.excess > 0 then
    local result = connection.excess
    connection.excess = ""
    return result
  end
  return uv._net_read(connection.handle)
end

function connect(host: string, port: integer): Connection
  check_host(host)
  check_connect_port(port)
  return Connection.new(uv._net_connect(host, port), "")
end

function listen(host: string, port: integer,
                backlog: integer?): Server
  check_host(host)
  check_listen_port(port)
  local actual_backlog = 128
  if backlog then actual_backlog = backlog as integer end
  if actual_backlog <= 0 then raise "listen backlog must be positive" end
  return Server.new(uv._net_listen(host, port, actual_backlog))
end

function Connection:read(): string?
  return read(self)
end

function Connection:read_until(delimiter: string,
                               chop: boolean?): string?
  if uv._net_is_closed(self.handle) then
    self.excess = ""
    return nil
  end
  if #delimiter == 0 then raise "read delimiter must not be empty" end

  local builder = str.writer(false)
  local tail = ""
  while true do
    local chunk? = read(self)
    if not chunk then
      if #tail > 0 then builder:write(tail) end
      local result = builder:drain()
      if #result == 0 then return nil end
      return result
    end
    local bytes = chunk as string
    local boundary = bytes
    if #tail > 0 then boundary = tail .. bytes end
    local match: integer? = str.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(str.sub(boundary, 1, result_end))
      end
      self.excess = str.sub(boundary, match_end + 1)
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(str.sub(boundary, 1, committed))
      end
    end
    tail = str.sub(boundary, committed + 1)
  end
  return nil
end

function Connection:write(data: string)
  uv._net_write(self.handle, data)
end

function Connection:shutdown()
  uv._net_shutdown(self.handle)
end

function Connection:close()
  self.excess = ""
  uv._net_close(self.handle)
end

function Server:accept(): Connection
  return Connection.new(uv._net_accept(self.handle), "")
end

function Server:close()
  uv._net_close(self.handle)
end
