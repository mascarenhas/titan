--- Task-aware TCP connections, address resolution, and listeners.
-- @module titan.net
-- @usage standard-library-net.md

local uv = import "uv"
local async = import "async"
local string = import "string"

-- Stream payloads are binary strings, so delimiter handling uses the string
-- library's length-aware literal search and slicing operations.
-- One lazy scratch buffer is reused across paired native reads. A connection
-- left idle retains at most this many scratch bytes; public chunks are copies.
local const READ_BUFFER_IDLE_CAPACITY = 64 * 1024
local const CONNECTION_UNCONNECTED = 0
local const CONNECTION_CONNECTING = 1
local const CONNECTION_CONNECTED = 2
local const CONNECTION_FAILED = 3

--- An owned TCP byte stream with one waiting reader and ordered native writes.
-- @usage standard-library-net.md#connecting-and-listening
record Connection
  local handle: uv.tcp_t
  local handle_view: uv.handle_t
  local stream: uv.stream_t
  local loop: uv.loop_t
  local excess: string
  local input: async.BufferedSubscription<|string, value|>?
  local start_read: (function (): integer)?
  local started: boolean
  local read_buffer: uv.buf_t?
  local phase: integer
end

--- An owned TCP listener with one waiting acceptor.
-- @usage standard-library-net.md#connecting-and-listening
record Server
  local handle: uv.tcp_t
  local handle_view: uv.handle_t
  local stream: uv.stream_t
  local loop: uv.loop_t
  local clients: async.BufferedSubscription<|Connection, value|>?
  local failure: value
  local start_listen: (function (integer): integer)?
end

local record CloseOperation
  handle: uv.handle_t
  completion: async.Completion<|CloseOperation, nil, nil|>?
  number: integer
end

local record ResolveOperation
  loop: uv.loop_t
  request: uv.getaddrinfo_t
  host: string
  port: integer
  hints: uv.addrinfo_hints_t
  completion: async.Completion<|ResolveOperation, {uv.sockaddr_t}, integer|>?
  number: integer
  request_view: uv.req_t
end

local record ConnectOperation
  request: uv.connect_t
  tcp: uv.tcp_t
  address: uv.sockaddr_t
  completion: async.Completion<|ConnectOperation, nil, integer|>?
  number: integer
end

local record WriteOperation
  request: uv.write_t
  stream: uv.stream_t
  data: string
  completion: async.Completion<|WriteOperation, nil, integer|>?
  number: integer
end

local record ShutdownOperation
  request: uv.shutdown_t
  stream: uv.stream_t
  completion: async.Completion<|ShutdownOperation, nil, integer|>?
  number: integer
end

local function is_closed(handle: uv.handle_t): boolean
  return not handle:is_initialized() or uv.is_closing(handle)
end

local function operation_error(code: integer, operation: string): async.OperationError
  return async.OperationError(code, uv.err_name(code), uv.strerror(code), operation)
end

local function check_status(code: integer, operation: string)
  if code < 0 then raise operation_error(code, operation) end
end

local function validate(handle: uv.handle_t, loop: uv.loop_t, operation: string)
  async.running()
  if loop ~= async.current_loop() then
    raise "TCP resource belongs to a different async Runtime"
  end
  if is_closed(handle) then
    raise "cannot " .. operation .. " a closed TCP resource"
  end
end

local function closed(handle: uv.handle_t)
  local context = uv.handle_get_data(handle) as CloseOperation
  local completion = context.completion as async.Completion<|CloseOperation, nil, nil|>
  local number = context.number
  uv.handle_set_data(handle, nil)
  context.completion = nil
  do completion:resolve(number, nil)
  catch completion:fatal(number, error, traceback); raise end
end

local function start_close(completion: async.Completion<|CloseOperation, nil, nil|>,
                           number: integer): uv.req_t?
  local context = completion:context(number)
  context.completion = completion
  context.number = number
  uv.handle_set_data(context.handle, context)
  uv.close(context.handle, closed)
  return nil
end

local function close_handle(handle: uv.handle_t)
  if is_closed(handle) then return end
  async.await_cleanup_with<|CloseOperation, nil, nil|>(
    CloseOperation(handle, nil, 0), start_close)
end

-- Unpublished sockets have no reader. Native close retains their owner; failed
-- connection candidates and queued accepts need not await each close callback.
local function abandon(connection: Connection)
  local handle = connection.handle_view
  if not is_closed(handle) then uv.close(handle) end
end

local function new_connection(loop: uv.loop_t): Connection
  local tcp = uv.tcp_t.new()
  local stream = tcp:as_stream_t()
  local handle = tcp:as_handle_t()
  local connection: Connection = {
    handle = tcp, handle_view = handle, stream = stream, loop = loop,
    excess = "", input = nil, start_read = nil, started = false,
    read_buffer = nil, phase = CONNECTION_UNCONNECTED,
  }
  connection.input = async.BufferedSubscription<|string, value|>(function (publish, fail, finish)
    local stop = function ()
      if connection.started then uv.read_stop(stream) end
      -- Public UV independently retains any outstanding allocation/read pair.
      connection.read_buffer = nil
    end
    local close = function (drain: function (): async.SubscriptionBatch<|string|>)
      drain()
      close_handle(handle)
    end
    local actions = async.SubscriptionActions<|string|>(stop, close)
    local allocate = function (_: uv.handle_t, suggested: integer): uv.buf_t
      local capacity = suggested
      if capacity < 1 or capacity > READ_BUFFER_IDLE_CAPACITY then
        capacity = READ_BUFFER_IDLE_CAPACITY
      end
      local buffer? = connection.read_buffer
      if buffer == nil or buffer:length() < capacity then
        buffer = uv.buf_t.allocate(capacity)
        connection.read_buffer = buffer
      end
      return buffer
    end
    local receive = function (_: uv.stream_t, count: integer, buffer: uv.buf_t?)
      if count == 0 then return end
      if count > 0 then
        publish(buffer:to_string(count))
      else
        uv.read_stop(stream)
        connection.read_buffer = nil
        if count == uv.EOF then finish()
        else fail(operation_error(count, "net.read")) end
      end
    end
    connection.start_read = function (): integer
      return uv.read_start(stream, allocate, receive)
    end
    return actions
  end)
  check_status(uv.tcp_init(loop, tcp), "net.tcp.init")
  return connection
end

local function resolved(request: uv.getaddrinfo_t, status: integer,
                        native: uv.addrinfo_result_t?)
  local context = request:get_data() as ResolveOperation
  local completion = context.completion as async.Completion<|ResolveOperation, {uv.sockaddr_t}, integer|>
  local number = context.number
  request:set_data(nil)
  context.completion = nil
  do
    local addresses: {uv.sockaddr_t} = {}
    do
      defer uv.freeaddrinfo(native)
      if status >= 0 then
        local entries = native:entries()
        for index = 1, #entries do
          local entry = entries[index]
          if entry.ai_addr ~= nil and
             (entry.ai_family == uv.AF_INET or entry.ai_family == uv.AF_INET6) then
            addresses[#addresses + 1] = entry.ai_addr
          end
        end
      end
    end
    if status < 0 then completion:reject(number, status)
    elseif #addresses == 0 then completion:reject(number, uv.EADDRNOTAVAIL)
    else completion:resolve(number, addresses) end
  catch completion:fatal(number, error, traceback); raise end
end

local function start_resolve(
    completion: async.Completion<|ResolveOperation, {uv.sockaddr_t}, integer|>,
    number: integer): uv.req_t?
  local context = completion:context(number)
  context.completion = completion
  context.number = number
  context.request:set_data(context)
  local status = uv.getaddrinfo(context.loop, context.request, resolved,
    context.host, "" .. context.port, context.hints)
  if status < 0 then
    context.request:set_data(nil)
    context.completion = nil
    completion:reject(number, status)
  end
  if status < 0 then return nil end
  return context.request_view
end

local function resolve_addresses(host: string, port: integer): {uv.sockaddr_t}
  if string.find(host, "\0") ~= nil then raise operation_error(uv.EINVAL, "net.resolve") end
  local loop = async.current_loop()
  local request = uv.getaddrinfo_t.new()
  local hints = uv.addrinfo_hints_t(uv.AI_NUMERICSERV, uv.AF_UNSPEC, uv.SOCK_STREAM, uv.IPPROTO_TCP)
  -- The request retains an allocated result even if the binding's result copy
  -- fails before our callback. Retire it from the Task's lexical cleanup too.
  defer do
    local _, retained = request:addrinfo()
    uv.freeaddrinfo(retained)
  end
  local request_view = request:as_req_t()
  local result = async.await_cancellable_with<|ResolveOperation, {uv.sockaddr_t}, integer|>(
    ResolveOperation(loop, request, host, port, hints, nil, 0, request_view), start_resolve)
  case result
  when success(addresses) then return addresses
  when error(code) then raise operation_error(code, "net.resolve")
  when cancelled(reason) then raise reason
  end
end

local function connected(request: uv.connect_t, status: integer)
  local context = request:get_data() as ConnectOperation
  local completion = context.completion as async.Completion<|ConnectOperation, nil, integer|>
  local number = context.number
  request:set_data(nil)
  context.completion = nil
  do
    if status < 0 then completion:reject(number, status)
    else completion:resolve(number, nil) end
  catch completion:fatal(number, error, traceback); raise end
end

local function start_connect(completion: async.Completion<|ConnectOperation, nil, integer|>,
                             number: integer): uv.req_t?
  local context = completion:context(number)
  context.completion = completion
  context.number = number
  context.request:set_data(context)
  local status = uv.tcp_connect(context.request, context.tcp, context.address, connected)
  if status < 0 then
    context.request:set_data(nil)
    context.completion = nil
    completion:reject(number, status)
  end
  return nil
end

local function written(request: uv.write_t, status: integer)
  local context = request:get_data() as WriteOperation
  local completion = context.completion as async.Completion<|WriteOperation, nil, integer|>
  local number = context.number
  request:set_data(nil)
  context.completion = nil
  do
    if status < 0 then completion:reject(number, status)
    else completion:resolve(number, nil) end
  catch completion:fatal(number, error, traceback); raise end
end

local function start_write(completion: async.Completion<|WriteOperation, nil, integer|>,
                           number: integer): uv.req_t?
  local context = completion:context(number)
  context.completion = completion
  context.number = number
  context.request:set_data(context)
  local status = uv.write_string(context.request, context.stream, context.data, written)
  if status < 0 then
    context.request:set_data(nil)
    context.completion = nil
    completion:reject(number, status)
  end
  return nil
end

local function shut_down(request: uv.shutdown_t, status: integer)
  local context = request:get_data() as ShutdownOperation
  local completion = context.completion as async.Completion<|ShutdownOperation, nil, integer|>
  local number = context.number
  request:set_data(nil)
  context.completion = nil
  do
    if status < 0 then completion:reject(number, status)
    else completion:resolve(number, nil) end
  catch completion:fatal(number, error, traceback); raise end
end

local function start_shutdown(completion: async.Completion<|ShutdownOperation, nil, integer|>,
                              number: integer): uv.req_t?
  local context = completion:context(number)
  context.completion = completion
  context.number = number
  context.request:set_data(context)
  local status = uv.shutdown(context.request, context.stream, shut_down)
  if status < 0 then
    context.request:set_data(nil)
    context.completion = nil
    completion:reject(number, status)
  end
  return nil
end

local function fail_server(server: Server, failure: value)
  server.failure = failure
  local pending = server.clients:drain_pending()
  for index = 1, pending.count do abandon(pending:get(index)) end
  local handle = server.handle_view
  if not is_closed(handle) then uv.close(handle) end
  server.clients:stop()
end

local function new_server(loop: uv.loop_t): Server
  local tcp = uv.tcp_t.new()
  local handle = tcp:as_handle_t()
  local stream = tcp:as_stream_t()
  local server = Server(tcp, handle, stream, loop, nil, nil, nil)
  server.clients = async.BufferedSubscription<|Connection, value|>(function (publish, _fail, _finish)
    local actions = async.SubscriptionActions<|Connection|>(function () end,
      function (drain: function (): async.SubscriptionBatch<|Connection|>)
        local pending = drain()
        for index = 1, pending.count do abandon(pending:get(index)) end
        close_handle(handle)
      end)
    local callback = function (_: uv.stream_t, status: integer)
      local client: Connection? = nil
      defer if client ~= nil then abandon(client) end
      if status < 0 then fail_server(server, operation_error(status, "net.accept")); return end
      client = new_connection(loop)
      local accepted = uv.accept(stream, client.handle_view)
      if accepted < 0 then fail_server(server, operation_error(accepted, "net.accept")); return end
      client.phase = CONNECTION_CONNECTED
      if publish(client) then client = nil end
    catch
      fail_server(server, error)
      raise
    end
    server.start_listen = function (backlog: integer): integer
      return uv.listen(stream, backlog, callback)
    end
    return actions
  end)
  check_status(uv.tcp_init(loop, tcp), "net.tcp.init")
  return server
end

local function check_host(host: string)
  if #host == 0 then raise "network host must not be empty" end
end

local function check_connect_port(port: integer)
  if port <= 0 or port > 65535 then
    raise "connect port must be between 1 and 65535"
  end
end

local function check_listen_port(port: integer)
  if port < 0 or port > 65535 then
    raise "listen port must be between 0 and 65535"
  end
end

local function read(connection: Connection): string?
  if is_closed(connection.handle_view) then
    connection.excess = ""
    connection.read_buffer = nil
    return nil
  end
  if connection.phase ~= CONNECTION_CONNECTED then
    raise "cannot read from an unconnected TCP Connection"
  end
  if #connection.excess > 0 then
    local result = connection.excess
    connection.excess = ""
    return result
  end
  validate(connection.handle_view, connection.loop, "read from")
  -- Admit cancellation before reader contention or the first persistent read.
  async.checkpoint()
  if connection.input:has_waiter() then raise "Connection already has a waiting reader" end
  if not connection.started then
    check_status(connection.start_read(), "net.read.start")
    connection.started = true
  end
  case connection.input:next()
  when item(bytes) then return bytes
  when error(failure) then raise failure
  when ended() then return nil
  when closed() then return nil
  end
end

--- Resolve a host and port asynchronously into typed addresses in resolver order.
-- @param host Connection hostname, numeric IP, or local bind address.
-- @param port Numeric TCP port.
-- @return Copied endpoint addresses in resolver order.
-- @usage standard-library-net.md#connecting-and-listening
function resolve(host: string, port: integer): {uv.sockaddr_t}
  check_host(host)
  check_connect_port(port)
  async.running()
  return resolve_addresses(host, port)
end

--- Create an unconnected TCP owner for dialing an already resolved address.
-- @return New unconnected owner bound to the current Runtime.
-- @usage standard-library-net.md#connecting-and-listening
function Connection.new(): Connection
  async.running()
  async.checkpoint()
  return new_connection(async.current_loop())
end

--- Connect this fresh TCP owner to one resolved address.
-- @param address Complete resolved endpoint address.
-- @usage standard-library-net.md#connecting-and-listening
function Connection:connect_address(address: uv.sockaddr_t)
  validate(self.handle_view, self.loop, "connect")
  async.checkpoint()
  if self.phase ~= CONNECTION_UNCONNECTED then
    raise "TCP Connection has already attempted connect"
  end
  if not address:is_complete() or
     (address:family() ~= uv.AF_INET and address:family() ~= uv.AF_INET6) then
    raise "TCP connect requires a complete IPv4 or IPv6 address"
  end
  check_connect_port(address:port())
  local request = uv.connect_t.new()
  self.phase = CONNECTION_CONNECTING
  do
    case async.await_with<|ConnectOperation, nil, integer|>(
      ConnectOperation(request, self.handle, address, nil, 0), start_connect)
    when success() then
    when error(code) then raise operation_error(code, "net.connect")
    end
    if is_closed(self.handle_view) then
      raise operation_error(uv.ECANCELED, "net.connect")
    end
    self.phase = CONNECTION_CONNECTED
  catch
    self.phase = CONNECTION_FAILED
    raise
  end
end

--- Resolve and connect to the first reachable address in resolver order.
-- @param host Connection hostname, numeric IP, or local bind address.
-- @param port Numeric TCP port.
-- @return New connected TCP stream; the caller owns closing it.
-- @usage standard-library-net.md#connecting-and-listening
function connect(host: string, port: integer): Connection
  local addresses = resolve(host, port)
  local loop = async.current_loop()
  local last_failure: value = nil
  for index = 1, #addresses do
    local connection = new_connection(loop)
    local transferred = false
    do
      defer if not transferred then abandon(connection) end
      local address = addresses[index]
      connection:connect_address(address)
      transferred = true
      return connection
    catch
      if not (error is async.OperationError) then raise end
      last_failure = error
    end
  end
  if last_failure ~= nil then raise last_failure end
  raise operation_error(uv.EADDRNOTAVAIL, "net.connect")
end

--- Listen for TCP clients on a local host and port.
-- @param host Connection hostname, numeric IP, or local bind address.
-- @param port Numeric TCP port.
-- @param backlog Positive listen backlog; nil defaults to 128.
-- @return New TCP listener; the caller owns closing it.
-- @usage standard-library-net.md#connecting-and-listening
function listen(host: string, port: integer,
                backlog: integer?): Server
  check_host(host)
  check_listen_port(port)
  local actual_backlog = 128
  if backlog then actual_backlog = backlog as integer end
  if actual_backlog <= 0 then raise "listen backlog must be positive" end
  if actual_backlog > 2147483647 then
    raise "TCP listen backlog is not representable by libuv"
  end
  async.running()
  local loop = async.current_loop()
  local addresses = resolve_addresses(host, port)
  local last_status = uv.EADDRNOTAVAIL
  for index = 1, #addresses do
    local server = new_server(loop)
    local transferred = false
    defer if not transferred then
      local handle = server.handle_view
      if not is_closed(handle) then uv.close(handle) end
    end
    local status = uv.tcp_bind(server.handle, addresses[index], 0)
    if status >= 0 then status = server.start_listen(actual_backlog) end
    if status >= 0 then transferred = true; return server end
    last_status = status
  end
  raise operation_error(last_status, "net.listen")
end

--- Read the next buffered byte chunk, or nil at EOF.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-net.md#reading
function Connection:read(): string?
  return read(self)
end

--- Read through a nonempty delimiter across chunks, retaining the unused suffix.
-- @param delimiter Nonempty byte delimiter to include or remove.
-- @param chop Remove the delimiter when true; nil or false retains it.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-net.md#reading
function Connection:read_until(delimiter: string,
                               chop: boolean?): string?
  if is_closed(self.handle_view) then
    self.excess = ""
    self.read_buffer = nil
    return nil
  end
  if self.phase ~= CONNECTION_CONNECTED then
    raise "cannot read from an unconnected TCP Connection"
  end
  if #delimiter == 0 then raise "read delimiter must not be empty" end

  local builder = string.writer()
  local tail = ""
  while true do
    local chunk? = read(self)
    if not chunk then
      if #tail > 0 then builder:write(tail) end
      local result = builder:drain()
      if #result == 0 then return nil end
      return result
    end
    local bytes = chunk as string
    local boundary = bytes
    if #tail > 0 then boundary = tail .. bytes end
    local match: integer? = string.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(string.sub(boundary, 1, result_end))
      end
      self.excess = string.sub(boundary, match_end + 1)
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(string.sub(boundary, 1, committed))
      end
    end
    tail = string.sub(boundary, committed + 1)
  end
  return nil
end

--- Write immutable binary bytes and wait for native completion.
-- @param data Immutable binary bytes to write or decode.
-- @usage standard-library-net.md#writing-shutdown-and-close
function Connection:write(data: string)
  validate(self.handle_view, self.loop, "write to")
  if self.phase ~= CONNECTION_CONNECTED then
    raise "cannot write to an unconnected TCP Connection"
  end
  local stream = self.stream
  if not uv.is_writable(stream) then raise "cannot write after Connection shutdown" end
  if #data == 0 then return end
  local request = uv.write_t.new()
  uv.buf_check_length(data, #data)
  case async.await_with<|WriteOperation, nil, integer|>(
    WriteOperation(request, stream, data, nil, 0), start_write)
  when success() then
  when error(code) then raise operation_error(code, "net.write")
  end
end

--- Finish earlier writes and half-close output while retaining input.
-- @usage standard-library-net.md#writing-shutdown-and-close
function Connection:shutdown()
  validate(self.handle_view, self.loop, "shut down")
  if self.phase ~= CONNECTION_CONNECTED then
    raise "cannot shut down an unconnected TCP Connection"
  end
  local stream = self.stream
  if not uv.is_writable(stream) then return end
  local request = uv.shutdown_t.new()
  case async.await_with<|ShutdownOperation, nil, integer|>(
    ShutdownOperation(request, stream, nil, 0), start_shutdown)
  when success() then
  when error(code) then raise operation_error(code, "net.shutdown")
  end
end

--- Close both directions, discard buffered input, and release this connection.
-- @usage standard-library-net.md#writing-shutdown-and-close
function Connection:close()
  self.excess = ""
  self.read_buffer = nil
  if is_closed(self.handle_view) then return end
  validate(self.handle_view, self.loop, "close")
  self.input:close()
end

--- Wait for and return the next accepted TCP connection.
-- @return Accepted connection whose close ownership transfers to the caller.
-- @usage standard-library-net.md#accepting
function Server:accept(): Connection
  if self.failure ~= nil then raise self.failure end
  validate(self.handle_view, self.loop, "accept on")
  async.checkpoint()
  if self.clients:has_waiter() then raise "Server already has a waiting accept Task" end
  local result = self.clients:next()
  if self.failure ~= nil then raise self.failure end
  case result
  when item(connection) then return connection
  when error(failure) then raise failure
  when ended() then raise operation_error(uv.ECANCELED, "net.accept")
  when closed() then raise operation_error(uv.ECANCELED, "net.accept")
  end
end

--- Close the listener and unaccepted clients, releasing a blocked acceptor.
-- @usage standard-library-net.md#writing-shutdown-and-close
function Server:close()
  if is_closed(self.handle_view) then return end
  validate(self.handle_view, self.loop, "close")
  self.clients:close()
end
