--- Native test assertions, subtests, cleanup, and runner context.
-- @module titan.test
-- @usage standard-library-test.md

foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"
foreign import "stdio.h"
foreign import "string.h"

local type Cleanup = function (): ()
local type TestFunction = function (Context): ()
local type TestLogger = function (string, string): ()
local type TraceScanner =
  function (string, string?): (string?, string?, integer?)
local type PatternMatcher = function (string, string): (boolean)

local record RegisteredTest
  name: string
  callback: TestFunction
end

--- A named test callback registered by a generated or custom runner.
-- @usage standard-library-test.md
record Case
  local full_name: string
  local owner_module: string
  local body: TestFunction
end

--- Construct a named test case with its source-owner attribution.
-- @param full_name Fully qualified test name.
-- @param owner_module Logical module used to attribute failure frames.
-- @param body Test callback receiving its runner-owned Context.
-- @return Registered test case.
-- @usage standard-library-test.md
function Case.new(full_name: string, owner_module: string,
                  body: TestFunction): Case
  return { full_name = full_name, owner_module = owner_module, body = body }
end

--- The structured reason raised by skip while a test runner is active.
-- @usage standard-library-test.md#assertions-and-skips
record Skip
  const reason: string?
end

local record LocationProbe
end

local runner_active = false
local runner_is_verbose = false
local runner_logger: TestLogger? = nil
local trace_scanner: TraceScanner? = nil
local pattern_matcher: PatternMatcher? = nil
local location_probe = LocationProbe()

--- Report whether this call is running under a Titan test runner.
-- @return True while a Titan test runner is active.
-- @usage standard-library-test.md#runner-state
function testing(): boolean
  return runner_active
end

--- Report whether an active Titan test runner requested verbose output.
-- @return True when the active runner requested verbose output.
-- @usage standard-library-test.md#runner-state
function verbose(): boolean
  return runner_active and runner_is_verbose
end

--- Return the caller's filename, function name, and source line.
-- @return Caller filename.
-- @return Caller function name.
-- @return Caller source line.
-- @usage standard-library-test.md#location-and-failure-traces
function location(): (string, string, integer)
  local filename = "<none>"
  local function_name = "<none>"
  local line = 0
  do
    raise location_probe
  catch
    filename, function_name, line = runner_trace_location(traceback, nil)
  end
  return filename, function_name, line
end

--- Skip the current test with an optional reason.
-- @param reason Optional human-readable skip reason.
-- @usage standard-library-test.md#assertions-and-skips
function skip(reason: string?)
  if runner_active then raise Skip(reason) end
  if reason then raise "test skipped: " .. (reason as string) end
  raise "test skipped"
end

--- Raise the supplied message when the assertion is false.
-- @param check Assertion condition.
-- @param message Optional assertion message or log contents.
-- @usage standard-library-test.md#assertions-and-skips
function assert(check: boolean, message: string?)
  if not check then
    raise message or "assertion failed"
  end
end

--- The current test's name, deferred subtests, logging, and LIFO cleanup scope.
-- @usage standard-library-test.md#contexts-subtests-and-cleanup
record Context
  local full_name: string
  local subtests: {RegisteredTest}
  local cleanups: {Cleanup}
  local subtests_open: boolean
  local cleanups_open: boolean
end

--- Register a callback to run after this test and its descendants finish.
-- @param f Cleanup callback run in reverse registration order.
-- @usage standard-library-test.md#contexts-subtests-and-cleanup
function Context:cleanup(f: Cleanup)
  if not self.cleanups_open then
    raise "cannot register cleanup after test cleanup begins"
  end
  self.cleanups[#self.cleanups + 1] = f
end

--- Return this test's fully qualified name.
-- @return Fully qualified test name.
-- @usage standard-library-test.md#contexts-subtests-and-cleanup
function Context:name(): string
  return self.full_name
end

--- Log a message through the active runner without changing test status.
-- @param message Optional assertion message or log contents.
-- @usage standard-library-test.md#contexts-subtests-and-cleanup
function Context:log(message: string)
  if not runner_active or not runner_logger then
    raise "cannot log outside a Titan test runner"
  end
  (runner_logger as TestLogger)(self.full_name, message)
end

--- Register a named subtest to run after the current test body returns.
-- @param name Name used by this operation.
-- @param subtest Subtest body receiving its own Context.
-- @usage standard-library-test.md#contexts-subtests-and-cleanup
function Context:run(name: string, subtest: TestFunction)
  if not self.subtests_open then
    raise "cannot register subtest after test body finishes"
  end
  self.subtests[#self.subtests + 1] =
    RegisteredTest(self.full_name .. "." .. name, subtest)
end

local function runner_begin(is_verbose: boolean, logger: TestLogger)
  if runner_active then raise "Titan test runner is already active" end
  runner_logger = logger
  runner_active = true
  runner_is_verbose = is_verbose
end

local function runner_end()
  runner_is_verbose = false
  runner_active = false
  runner_logger = nil
end

local function runner_new_context(name: string): Context
  return Context {
    full_name = name,
    subtests = {},
    cleanups = {},
    subtests_open = true,
    cleanups_open = true
  }
end

local function runner_take_subtests(context: Context): {RegisteredTest}
  context.subtests_open = false
  local subtests = context.subtests
  context.subtests = {}
  return subtests
end

local function runner_take_cleanup(context: Context): Cleanup?
  context.subtests_open = false
  context.cleanups_open = false
  local index = #context.cleanups
  if index == 0 then return nil end
  local cleanup? = context.cleanups[index]
  context.cleanups[index] = nil
  return cleanup
end

local function runner_skip_reason(failure: value): (boolean, string?)
  if failure is Skip then
    local marker: Skip = failure
    return true, marker.reason
  end
  return false, nil
end

local function ensure_lua_helpers()
  if trace_scanner and pattern_matcher then return end
  local scanner, matcher = load_lua_helpers()
  trace_scanner = scanner
  pattern_matcher = matcher
end

local function runner_trace_location(trace: string, preferred: string?):
    (string, string, integer)
  ensure_lua_helpers()
  local scanner = trace_scanner as TraceScanner
  local filename?, function_name?, line? = scanner(trace, preferred)
  if filename and function_name and line then
    return filename, function_name, line
  end
  return "<none>", "<none>", 0
end

local function runner_error_text(failure: value): string
  local result = "<error while rendering test failure>"
  do
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    -- Candidate plus the two temporary slots used by luaL_getmetafield/callmeta.
    if ffi.lua_checkstack(L, 3) ~= 0 then
      ffi.lua_pushtvalue(L, failure)
      ffi.luaL_tolstring(L, -1, nil)
      local rendered: value = ffi.lua_totvalue(L, -1)
      if rendered is string then result = rendered as string end
    end
  catch
    -- Preserve the conservative fallback if __tostring itself raises.
  end
  return result
end

local function runner_matches(name: string, pattern: string): boolean
  ensure_lua_helpers()
  local matches = pattern_matcher as PatternMatcher
  return matches(name, pattern)
end

local function raw_lua_function(
    table_index: foreign int, name: string): boolean
  ffi.lua_pushstring(L, name)
  local kind = ffi.lua_rawget(L, table_index)
  ffi.lua_settop(L, ffi.lua_gettop(L) - 1)
  return kind == ffi.LUA_TFUNCTION
end

local function lua_helpers_available(): boolean
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 3) == 0 then
    raise "cannot reserve Lua stack for titan.test helper inspection"
  end

  ffi.lua_rawgeti(L, ffi.LUA_REGISTRYINDEX,
                  ffi.LUA_RIDX_GLOBALS as foreign lua_Integer)
  if ffi.lua_type(L, -1) ~= ffi.LUA_TTABLE then return false end
  local globals_index = ffi.lua_gettop(L)

  ffi.lua_pushstring(L, "string")
  if ffi.lua_rawget(L, globals_index) ~= ffi.LUA_TTABLE then return false end
  local string_index = ffi.lua_gettop(L)
  if not raw_lua_function(string_index, "gmatch") or
      not raw_lua_function(string_index, "match") or
      not raw_lua_function(string_index, "sub") or
      not raw_lua_function(string_index, "find") then
    return false
  end

  ffi.lua_settop(L, globals_index)
  return raw_lua_function(globals_index, "tonumber")
end

local function load_lua_helpers(): (TraceScanner, PatternMatcher)
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  -- luaL_loadstring pushes one value: the chunk or its error message.
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for titan.test helpers"
  end

  local source = [[
local string_gmatch = string.gmatch
local string_match = string.match
local string_sub = string.sub
local string_find = string.find
local tonumber = tonumber
return
  function(trace, preferred)
    local fallback_file, fallback_name, fallback_line
    for frame in string_gmatch(trace, "[^\n]+") do
      local file, line, name =
        string_match(frame, "^(.-%.titan):(%d+): in (.+)$")
      if file then
        local from_test_source =
          file == "titan/test.titan" or
          string_match(file, "/titan/test%.titan$") ~= nil
        local from_test_name =
          string_match(name, "^titan%.test%.[^%.:]+$") ~= nil or
          string_match(name, "^titan%.test%.[^%.:]+:[^%.:]+$") ~= nil or
          string_match(name,
                       "^titan%.test%.runner%.[^%.:]+$") ~= nil
        if not from_test_source and not from_test_name then
          fallback_file = fallback_file or file
          fallback_name = fallback_name or name
          fallback_line = fallback_line or tonumber(line)
          if preferred == nil or
             string_sub(name, 1, #preferred + 1) == preferred .. "." then
            return file, name, tonumber(line)
          end
        end
      end
    end
    return fallback_file, fallback_name, fallback_line
  end,
  function(subject, pattern)
    return string_find(subject, pattern) ~= nil
  end
]]
  local status = ffi.luaL_loadstring(L, source)
  local loaded: value = ffi.lua_totvalue(L, -1)
  if status ~= ffi.LUA_OK then raise loaded end
  local factory: function (): (TraceScanner, PatternMatcher) = loaded
  local scanner, matcher = factory()
  return scanner, matcher
end

local record OwnerTiming
  name: string
  elapsed: integer
end

local record State
  local filters: {string}
  local verbose: boolean
  local run: integer
  local passed: integer
  local skipped: integer
  local failed: integer
  local failed_names: {string}
  local owners: {OwnerTiming}
  local owner_by_name: {string: OwnerTiming}
end

local function copy_interval(subject: string, first: integer,
                             count: integer): string
  if count == 0 then return "" end
  local storage = foreign char.new_array(count)
  local output = storage as foreign *char
  local source = subject as foreign const *char
  ffi.memcpy(output, source + first - 1, count as foreign size_t)
  return storage as string
end

local function has_prefix(subject: string, prefix: string): boolean
  if #subject < #prefix then return false end
  local left = subject as foreign const *unsigned char
  local right = prefix as foreign const *unsigned char
  for index = 0, #prefix - 1 do
    if left[index] ~= right[index] then return false end
  end
  return true
end

local function write(output: string)
  local bytes = output as foreign const *unsigned char
  for index = 0, #output - 1 do
    ffi.putchar(bytes[index] as foreign int)
  end
end

local function writeln(output: string)
  write(output)
  ffi.putchar(10)
  if ffi.fflush(nil) ~= 0 then raise "cannot flush test output" end
end

local function report_log(full_name: string, message: string)
  writeln("[----------] " .. full_name .. ": " .. message)
end

local function test_word(count: integer): string
  if count == 1 then return "test" end
  return "tests"
end

local function count_text(count: integer): string
  return runner_error_text(count)
end

local function monotonic_now(): integer
  local now: integer = ffi.titan_test_monotonic_ns()
  if now < 0 then raise "cannot read monotonic test clock" end
  return now
end

local function duration_text(nanoseconds: integer): string
  local hundredths = (nanoseconds + 5000) // 10000
  local fraction = hundredths % 100
  local decimal = count_text(fraction)
  if fraction < 10 then decimal = "0" .. decimal end
  return count_text(hundredths // 100) .. "." .. decimal
end

local function State:add_owner_time(name: string, elapsed: integer)
  local owner? = self.owner_by_name[name]
  if owner then
    owner.elapsed = owner.elapsed + elapsed
  else
    local timing = OwnerTiming(name, elapsed)
    self.owners[#self.owners + 1] = timing
    self.owner_by_name[name] = timing
  end
end

local function selected(state: State, full_name: string): boolean
  if #state.filters == 0 then return true end
  for index = 1, #state.filters do
    if runner_matches(full_name, state.filters[index]) then return true end
  end
  return false
end

local function print_trace(trace: string)
  writeln("stack traceback:")
  local bytes = trace as foreign const *unsigned char
  local position = 1
  while position <= #trace do
    local ending = position
    while ending <= #trace and bytes[ending - 1] ~= 10 do
      ending = ending + 1
    end
    write("\t")
    writeln(copy_interval(trace, position, ending - position))
    position = ending + 1
  end
end

local function report_skipped(state: State, full_name: string,
                              reason: string, elapsed: integer)
  state.skipped = state.skipped + 1
  if #reason > 0 then
    writeln("[  SKIPPED ] " .. full_name .. " (" .. reason .. ") (" ..
            duration_text(elapsed) .. " ms)")
  else
    writeln("[  SKIPPED ] " .. full_name .. " (" ..
            duration_text(elapsed) .. " ms)")
  end
end

local function report_failure(state: State, full_name: string,
                              owner_module: string, message: string,
                              trace: string, elapsed: integer)
  local file, function_name, line =
    runner_trace_location(trace, owner_module)
  writeln(file .. ":" .. count_text(line) .. ": in " .. function_name ..
          ": " .. message)
  if state.verbose then print_trace(trace) end
  writeln("[  FAILED  ] " .. full_name .. " (" ..
          duration_text(elapsed) .. " ms)")
  state.failed = state.failed + 1
  state.failed_names[#state.failed_names + 1] = full_name
end

local function skip_registered(state: State,
                               subtests: {RegisteredTest},
                               reason: string)
  for index = 1, #subtests do
    local child = subtests[index]
    if selected(state, child.name) then
      state.run = state.run + 1
      report_skipped(state, child.name, reason, 0)
    end
  end
end

local function execute(state: State, full_name: string,
                       owner_module: string, body: TestFunction): integer?
  if not selected(state, full_name) then return nil end
  state.run = state.run + 1
  writeln("[ RUN      ] " .. full_name)

  local context = runner_new_context(full_name)
  local status = 0
  local message = ""
  local failure_trace = ""
  local started = monotonic_now()
  do
    body(context)
  catch
    local was_skip = false
    local reason: string? = nil
    was_skip, reason = runner_skip_reason(error)
    failure_trace = traceback
    if was_skip then
      status = 1
      if reason then message = reason as string end
    else
      status = 2
      message = runner_error_text(error)
    end
  end
  local subtests = runner_take_subtests(context)

  if status == 0 then
    for index = 1, #subtests do
      local child = subtests[index]
      execute(state, child.name, owner_module, child.callback)
    end
  elseif status == 1 then
    local child_reason = "parent skipped"
    if #message > 0 then child_reason = child_reason .. ": " .. message end
    skip_registered(state, subtests, child_reason)
  else
    skip_registered(state, subtests, "parent failed")
  end

  while true do
    local maybe_cleanup: Cleanup? = runner_take_cleanup(context)
    if not maybe_cleanup then break end
    do
      (maybe_cleanup as Cleanup)()
    catch
      if status ~= 2 then
        local cleanup_skip = false
        local cleanup_reason: string? = nil
        cleanup_skip, cleanup_reason = runner_skip_reason(error)
        status = 2
        failure_trace = traceback
        if cleanup_skip then
          message = "test.skip cannot be called from cleanup"
          if cleanup_reason then
            message = message .. ": " .. (cleanup_reason as string)
          end
        else
          message = runner_error_text(error)
        end
      end
    end
  end

  local elapsed = monotonic_now() - started
  if status == 0 then
    state.passed = state.passed + 1
    writeln("[       OK ] " .. full_name .. " (" ..
            duration_text(elapsed) .. " ms)")
  elseif status == 1 then
    report_skipped(state, full_name, message, elapsed)
  else
    report_failure(state, full_name, owner_module, message, failure_trace,
                   elapsed)
  end
  return elapsed
end

local function usage()
  writeln("Usage: <test-executable> [-h|--help] [-v|--verbose] " ..
          "[-f PATTERN|--filter=PATTERN]...")
end

local function option_error(message: string): (boolean, integer)
  writeln("error: " .. message)
  usage()
  return false, 2
end

local function parse_options(args: {string}, state: State):
    (boolean, integer)
  local index = 1
  while index <= #args do
    local argument = args[index]
    if argument == "-h" or argument == "--help" or argument == "-help" then
      usage()
      return false, 0
    elseif argument == "-v" or argument == "--verbose" then
      state.verbose = true
    elseif argument == "-f" then
      index = index + 1
      if index > #args then return option_error("-f requires a pattern") end
      state.filters[#state.filters + 1] = args[index]
    elseif has_prefix(argument, "--filter=") then
      state.filters[#state.filters + 1] = copy_interval(
        argument, #"--filter=" + 1, #argument - #"--filter=")
    else
      return option_error("unknown option '" .. argument .. "'")
    end
    index = index + 1
  end

  for filter_index = 1, #state.filters do
    do
      runner_matches("", state.filters[filter_index])
    catch
      return option_error("invalid Lua pattern '" ..
        state.filters[filter_index] .. "': " ..
        runner_error_text(error))
    end
  end
  return true, 0
end

--- Run registered cases with the standard command-line test options.
-- @param args User arguments, without the executable name.
-- @param cases Cases in execution order.
-- @return Zero on success, one on test failure, or two for invalid options.
-- @usage standard-library-test.md
function run(args: {string}, cases: {Case}): integer
  local state = State.new {
    filters = {}, verbose = false, run = 0, passed = 0, skipped = 0,
    failed = 0, failed_names = {}, owners = {}, owner_by_name = {}
  }
  local proceed, status = parse_options(args, state)
  if not proceed then return status end

  runner_begin(state.verbose, report_log)
  defer runner_end()
  local started = monotonic_now()
  writeln("[==========] Running Titan tests.")
  for index = 1, #cases do
    local test_case = cases[index]
    local elapsed? = execute(state, test_case.full_name, test_case.owner_module,
                             test_case.body)
    if elapsed then state:add_owner_time(test_case.owner_module, elapsed) end
  end
  local elapsed = monotonic_now() - started

  for index = 1, #state.owners do
    local owner = state.owners[index]
    writeln("[----------] " .. owner.name .. " (" ..
            duration_text(owner.elapsed) .. " ms total)")
  end

  writeln("[==========] " .. count_text(state.run) .. " " ..
          test_word(state.run) .. " ran. (" .. duration_text(elapsed) ..
          " ms total)")
  writeln("[  PASSED  ] " .. count_text(state.passed) .. " " ..
          test_word(state.passed) .. ".")
  if state.skipped > 0 then
    writeln("[  SKIPPED ] " .. count_text(state.skipped) .. " " ..
            test_word(state.skipped) .. ".")
  end
  if state.failed > 0 then
    writeln("[  FAILED  ] " .. count_text(state.failed) .. " " ..
            test_word(state.failed) .. ".")
    for index = 1, #state.failed_names do
      writeln("[  FAILED  ] " .. state.failed_names[index])
    end
    return 1
  end
  return 0
end

-- Snapshot standard-library helpers before any test-owner initializer can
-- mutate their Lua globals. Bare validation states may not have opened the
-- standard libraries yet, so keep ensure_lua_helpers as the later fallback.
-- Once every prerequisite is an actual raw function, a loading fault is real
-- and must fail initialization rather than being silently deferred.
do
  if lua_helpers_available() then
    local scanner, matcher = load_lua_helpers()
    trace_scanner = scanner
    pattern_matcher = matcher
  end
end
