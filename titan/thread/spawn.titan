--- Spawning standalone OS threads and Thread lifecycle handles.
-- @module titan.thread

--- Host-state handle to a spawned OS thread running an isolated Lua/Titan state.
-- @usage standard-library-thread.md
record Thread<|R|>
  local native: foreign *titan_thread_control
  local monitor_task: async.Task<|R, value|>?
  local cached_status: ThreadStatus<|R|>?
end

local foreign function thread_control_new_native(
    mutex: *void): *titan_thread_control
  if mutex == nil then
    return nil
  end
  local ctrl = ffi.calloc(1 as foreign size_t, foreign titan_thread_control.sizeof)
    as foreign *titan_thread_control
  if ctrl == nil then
    uv.native_mutex_destroy(mutex)
    return nil
  end
  ctrl.mutex = mutex
  ctrl.refcount = 1 as foreign size_t
  ctrl.status_kind = ffi.TITAN_THREAD_STATE_RUNNING
  return ctrl
end

local foreign function thread_control_destroy_unreferenced(
    ctrl: *titan_thread_control)
  -- Every linked join node holds a refcount pin; abort on an accounting bug.
  if ffi.titan_thread_join_queue(ctrl).head ~= nil then ffi.abort() end
  local entry_msg = ctrl.entry_msg
  local cancel_msg = ctrl.cancel_reason_msg
  local result_msg = ctrl.result_msg
  local proxy_target = ctrl.proxy_wake_target
  ctrl.proxy_wake_target = nil
  ctrl.entry_msg = nil
  ctrl.cancel_reason_msg = nil
  ctrl.result_msg = nil
  thread_message_discard(entry_msg)
  thread_message_discard(cancel_msg)
  thread_message_discard(result_msg)
  if proxy_target ~= nil then uv.native_external_wake_release(proxy_target) end
  local token = ctrl.os_thread
  ctrl.os_thread = nil
  if token ~= nil then
    -- A monitor pins ctrl through join. Only an unobserved, uniquely owned
    -- joinable token reaches final destruction; no prior join/detach did.
    -- POSIX permits self-detach; Windows closes the still-owned real handle.
    -- This abandoned-owner detach is best effort, never proxy join evidence.
    uv.native_thread_detach(token)
  end
  if ctrl.status_kind == ffi.TITAN_THREAD_STATE_FAILED then
    if ctrl.observed == 0 then
      if ctrl.stderr_report ~= nil then
        if ctrl.stderr_report_len > (0 as foreign size_t) then
          write_stderr_bytes(ctrl.stderr_report, ctrl.stderr_report_len)
        end
      end
    end
  end
  if ctrl.error_traceback ~= nil then
    ffi.free(ctrl.error_traceback)
    ctrl.error_traceback = nil
  end
  if ctrl.stderr_report ~= nil then
    ffi.free(ctrl.stderr_report)
    ctrl.stderr_report = nil
  end
  if ctrl.mutex ~= nil then
    uv.native_mutex_destroy(ctrl.mutex)
    ctrl.mutex = nil
  end
  ffi.free(ctrl)
end

local foreign function thread_control_release_native(ctrl: *titan_thread_control)
  if ctrl == nil then return end
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.refcount = ctrl.refcount - (1 as foreign size_t)
  local destroy = 0 as foreign int
  if ctrl.refcount == (0 as foreign size_t) then
    destroy = 1
  end
  uv.native_mutex_unlock(ctrl.mutex)
  if destroy ~= 0 then
    thread_control_destroy_unreferenced(ctrl)
  end
end

local foreign function thread_control_complete_native(ctrl: *titan_thread_control)
  if ctrl == nil then return end
  uv.native_mutex_lock(ctrl.mutex)
  local entry_msg = ctrl.entry_msg
  local cancel_msg = ctrl.cancel_reason_msg
  ctrl.entry_msg = nil
  ctrl.cancel_reason_msg = nil
  uv.native_mutex_unlock(ctrl.mutex)
  thread_message_discard(entry_msg)
  thread_message_discard(cancel_msg)
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.finished = 1
  local proxy_target = ctrl.proxy_wake_target
  ctrl.proxy_wake_target = nil
  waiter_wake_all(ffi.titan_thread_join_queue(ctrl))
  uv.native_mutex_unlock(ctrl.mutex)
  if proxy_target ~= nil then
    uv.native_external_wake_notify(proxy_target)
    uv.native_external_wake_release(proxy_target)
  end
end

local foreign function thread_control_copy_cstr(
    src: const *char, len: size_t): *char
  if len == ffi.SIZE_MAX then return nil end
  local buf = ffi.malloc(len + (1 as foreign size_t)) as foreign *char
  if buf == nil then return nil end
  if len > (0 as foreign size_t) then
    if src ~= nil then
      ffi.memcpy(buf, src, len)
    end
  end
  local term = buf + len
  term[0] = 0 as foreign char
  return buf
end

local foreign function thread_control_is_observed_native(
    ctrl: *titan_thread_control): int
  uv.native_mutex_lock(ctrl.mutex)
  local obs = ctrl.observed
  uv.native_mutex_unlock(ctrl.mutex)
  return obs
end

local foreign function thread_control_record_succeeded_native(
    ctrl: *titan_thread_control, msg: *titan_thread_message)
  uv.native_mutex_lock(ctrl.mutex)
  if ctrl.status_kind == ffi.TITAN_THREAD_STATE_RUNNING then
    ctrl.status_kind = ffi.TITAN_THREAD_STATE_SUCCEEDED
    if ctrl.abandoned == 0 then
      ctrl.result_msg = msg
      msg = nil
    end
  end
  uv.native_mutex_unlock(ctrl.mutex)
  if msg ~= nil then
    thread_message_discard(msg)
  end
end

local foreign function thread_control_record_cancelled_native(
    ctrl: *titan_thread_control, reason_msg: *titan_thread_message,
    reason_kind: int)
  uv.native_mutex_lock(ctrl.mutex)
  if ctrl.status_kind == ffi.TITAN_THREAD_STATE_RUNNING then
    ctrl.status_kind = ffi.TITAN_THREAD_STATE_CANCELLED
    ctrl.result_reason_kind = reason_kind
    if ctrl.abandoned == 0 then
      ctrl.result_msg = reason_msg
      reason_msg = nil
    end
  end
  uv.native_mutex_unlock(ctrl.mutex)
  if reason_msg ~= nil then
    thread_message_discard(reason_msg)
  end
end

local foreign function thread_control_record_failed_native(
    ctrl: *titan_thread_control,
    err_msg: *titan_thread_message,
    trace: const *char,
    trace_len: size_t,
    report: const *char,
    report_len: size_t): *titan_thread_message
  local trace_copy = thread_control_copy_cstr(trace, trace_len)
  local report_copy: foreign *char = nil
  if report_len > (0 as foreign size_t) then
    report_copy = thread_control_copy_cstr(report, report_len)
  end
  uv.native_mutex_lock(ctrl.mutex)
  if ctrl.status_kind == ffi.TITAN_THREAD_STATE_RUNNING then
    ctrl.status_kind = ffi.TITAN_THREAD_STATE_FAILED
    if ctrl.abandoned == 0 then
      ctrl.result_msg = err_msg
      err_msg = nil
      ctrl.error_traceback = trace_copy
      ctrl.error_traceback_len = trace_len
      trace_copy = nil
    end
    if ctrl.observed == 0 then
      ctrl.stderr_report = report_copy
      ctrl.stderr_report_len = report_len
      report_copy = nil
    end
  end
  uv.native_mutex_unlock(ctrl.mutex)
  if trace_copy ~= nil then ffi.free(trace_copy) end
  if report_copy ~= nil then ffi.free(report_copy) end
  return err_msg
end

local foreign function thread_control_bind_child_cancel_native(
    ctrl: *titan_thread_control,
    handle: *void): int
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.child_cancel_handle = handle
  local already_cancelled = ctrl.cancel_requested
  uv.native_mutex_unlock(ctrl.mutex)
  return already_cancelled
end

local foreign function thread_control_clear_child_cancel_native(
    ctrl: *titan_thread_control)
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.child_cancel_handle = nil
  uv.native_mutex_unlock(ctrl.mutex)
end

local foreign function thread_control_take_entry_native(
    ctrl: *titan_thread_control): *titan_thread_message
  uv.native_mutex_lock(ctrl.mutex)
  local msg = ctrl.entry_msg
  ctrl.entry_msg = nil
  uv.native_mutex_unlock(ctrl.mutex)
  return msg
end

local foreign function thread_control_take_cancel_reason_native(
    ctrl: *titan_thread_control, reason_kind: *int): *titan_thread_message
  uv.native_mutex_lock(ctrl.mutex)
  local msg = ctrl.cancel_reason_msg
  if reason_kind ~= nil then reason_kind[0] = ctrl.cancel_reason_kind end
  ctrl.cancel_reason_msg = nil
  uv.native_mutex_unlock(ctrl.mutex)
  return msg
end

local foreign function thread_control_request_cancel_native(
    ctrl: *titan_thread_control,
    reason_msg: *titan_thread_message, reason_kind: int): int
  uv.native_mutex_lock(ctrl.mutex)
  if ctrl.finished ~= 0 then
    uv.native_mutex_unlock(ctrl.mutex)
    return 0
  end
  if ctrl.cancel_requested ~= 0 then
    uv.native_mutex_unlock(ctrl.mutex)
    return 0
  end
  if ctrl.status_kind ~= ffi.TITAN_THREAD_STATE_RUNNING then
    uv.native_mutex_unlock(ctrl.mutex)
    return 0
  end
  ctrl.cancel_requested = 1
  ctrl.cancel_reason_msg = reason_msg
  ctrl.cancel_reason_kind = reason_kind
  if ctrl.child_cancel_handle ~= nil then
    uv.async_send_native(ctrl.child_cancel_handle)
  end
  uv.native_mutex_unlock(ctrl.mutex)
  return 1
end

-- Implementation notes: doc/implementation/thread-library.md#registration-pins-and-state-close-withdrawal
local foreign function thread_control_register_join_wait(context: *void, target: *void): int
  local wait = context as foreign *titan_thread_join_wait
  local ctrl = wait.control
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.observed = 1
  if ctrl.finished ~= 0 then
    uv.native_mutex_unlock(ctrl.mutex)
    return 0
  end
  waiter_enqueue(ffi.titan_thread_join_queue(ctrl), ffi.titan_thread_join_waiter(wait),
    target, ffi.titan_thread_control_pins(ctrl))
  uv.native_mutex_unlock(ctrl.mutex)
  return 1
end

-- Completion wakes every join waiter, so withdrawal passes no baton. The pin
-- keeps ctrl valid here even after the joining state's handle was released;
-- a lua_close withdrawal can therefore be ctrl's last release.
local foreign function thread_control_unregister_join_wait(context: *void)
  local wait = context as foreign *titan_thread_join_wait
  local ctrl = wait.control
  local waiter = ffi.titan_thread_join_waiter(wait)
  uv.native_mutex_lock(ctrl.mutex)
  local pinned = waiter_holds_pin(waiter)
  waiter_unlink(ffi.titan_thread_join_queue(ctrl), waiter)
  waiter.signaled = 0
  if pinned ~= 0 then ctrl.refcount = ctrl.refcount - (1 as foreign size_t) end
  local destroy = 0 as foreign int
  if ctrl.refcount == (0 as foreign size_t) then destroy = 1 end
  uv.native_mutex_unlock(ctrl.mutex)
  if destroy ~= 0 then thread_control_destroy_unreferenced(ctrl) end
end

-- The joining Task's recheck after a wait acknowledges its wake under this
-- lock. That Task holds its Thread, so the unpin can never free ctrl here.
local foreign function thread_control_poll_join_native(wait: *titan_thread_join_wait): int
  local ctrl = wait.control
  uv.native_mutex_lock(ctrl.mutex)
  waiter_acknowledge(ffi.titan_thread_join_waiter(wait), ffi.titan_thread_control_pins(ctrl))
  local done = ctrl.finished
  if done ~= 0 then ctrl.observed = 1 end
  uv.native_mutex_unlock(ctrl.mutex)
  return done
end

-- The traced monitor owner pins ctrl through native retirement; the worker
-- reference pins this non-GC target slot even after host-state close.
local foreign function thread_control_register_retirement_native(
    context: *void, target: *void): int
  if context == nil then return -1 as foreign int end
  if target == nil then return -1 as foreign int end
  local ctrl = context as foreign *titan_thread_control
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.observed = 1
  if ctrl.finished ~= 0 then
    uv.native_mutex_unlock(ctrl.mutex)
    return 0 as foreign int
  end
  if ctrl.proxy_wake_target ~= nil then
    uv.native_mutex_unlock(ctrl.mutex)
    return -1 as foreign int
  end
  uv.native_external_wake_retain(target)
  ctrl.proxy_wake_target = target
  uv.native_mutex_unlock(ctrl.mutex)
  return 1 as foreign int
end

local foreign function thread_control_unregister_retirement_native(context: *void)
  if context == nil then return end
  local ctrl = context as foreign *titan_thread_control
  uv.native_mutex_lock(ctrl.mutex)
  local target = ctrl.proxy_wake_target
  ctrl.proxy_wake_target = nil
  uv.native_mutex_unlock(ctrl.mutex)
  uv.native_external_wake_release(target)
end

-- Implementation notes: doc/implementation/thread-library.md#join-proxy-retirement-and-the-native-terminal-barrier
-- Join/detach observers are serialized on the owning host Runtime. Only the
-- unfinished predicate may return pending: finished readiness is monotonic,
-- and every later attempt returns actual join success or a preserved error.
local foreign function thread_control_join_native(
    ctrl: *titan_thread_control, cancel_missing: int): int
  if ctrl == nil then return -1 as foreign int end
  uv.native_mutex_lock(ctrl.mutex)
  if ctrl.finished == 0 then
    if cancel_missing ~= 0 then
      if ctrl.status_kind == ffi.TITAN_THREAD_STATE_RUNNING then
        if ctrl.cancel_requested == 0 then
          ctrl.cancel_requested = 1
          if ctrl.child_cancel_handle ~= nil then
            uv.async_send_native(ctrl.child_cancel_handle)
          end
        end
      end
    end
    uv.native_mutex_unlock(ctrl.mutex)
    return 1 as foreign int
  end
  if ctrl.os_joined ~= 0 then
    uv.native_mutex_unlock(ctrl.mutex)
    return 0 as foreign int
  end
  local token = ctrl.os_thread
  if token == nil then
    uv.native_mutex_unlock(ctrl.mutex)
    return -1 as foreign int
  end
  uv.native_mutex_unlock(ctrl.mutex)
  -- The worker's final release needs ctrl.mutex; never hold it across join.
  local status = uv.native_thread_join(token)
  uv.native_mutex_lock(ctrl.mutex)
  if status == 0 then
    ctrl.os_thread = nil
    ctrl.os_joined = 1
  end
  uv.native_mutex_unlock(ctrl.mutex)
  return status
end

-- Called only at bound cleanup after ordinary forwarding, while a terminal
-- candidate cannot finish cleanup, or after the monotonic finished receipt.
-- A reasonless request never replaces an already-admitted child cancellation.
local foreign function thread_control_retire_native(context: *void): int
  return thread_control_join_native(context as foreign *titan_thread_control, 1)
end

local function safe_value_to_thread_message(item: value): foreign *titan_thread_message
  local msg: foreign *titan_thread_message = nil
  do
    msg = value_to_thread_message(item)
  catch
    msg = value_to_thread_message(render_error_text(item))
  end
  return msg
end

-- Implementation notes: doc/implementation/thread-library.md#cancellation-reasons
-- The generic CancellationReason schema erases complex(B) to value, which
-- protobuf cannot encode. Transfer its actual payload in the owned packet;
-- native metadata carries the reason variant through admission and outcome.
local function cancellation_to_thread_message(
  reason: async.CancellationReason<|value|>
): (foreign *titan_thread_message, foreign int)
  local kind: foreign int = ffi.TITAN_THREAD_CANCELLATION_SIMPLE as foreign int
  local payload: value = nil
  case reason
  when simple(text) then payload = text
  when complex(item) then
    kind = ffi.TITAN_THREAD_CANCELLATION_COMPLEX as foreign int
    payload = item
  end
  local msg: foreign *titan_thread_message = nil
  do
    msg = value_to_thread_message(payload)
  catch
    kind = ffi.TITAN_THREAD_CANCELLATION_DEFAULT as foreign int
    msg = value_to_thread_message(render_error_text(reason))
  end
  return msg, kind
end

local function thread_message_cancellation(
  kind: foreign int, payload: value
): async.CancellationReason<|value|>
  if kind == ffi.TITAN_THREAD_CANCELLATION_SIMPLE then
    return async.CancellationReason.simple(payload)
  elseif kind == ffi.TITAN_THREAD_CANCELLATION_COMPLEX then
    return async.CancellationReason.complex(payload)
  end
  return async.CancellationReason.simple("cancelled")
end

-- Implementation notes: doc/implementation/thread-library.md#isolated-os-thread-lifecycle-and-cancellation
local function child_thread_bootstrap(raw_ctrl: value)
  local ctrl = raw_ctrl as foreign *titan_thread_control
  local entry_msg = thread_control_take_entry_native(ctrl)
  defer do
    if entry_msg ~= nil then
      thread_message_discard(entry_msg)
      entry_msg = nil
    end
    local leftover_cancel = thread_control_take_cancel_reason_native(ctrl, nil)
    if leftover_cancel ~= nil then
      thread_message_discard(leftover_cancel)
    end
  end

  local was_cancelled = false
  local cancel_handle = uv.async_t.new()
  local cancel_view = cancel_handle:as_handle_t()
  local cancel_initialized = false

  local root_task = async.run<|value, value|>(function (): value
    local close_cancel_handle = function ()
      thread_control_clear_child_cancel_native(ctrl)
      if cancel_initialized and not uv.is_closing(cancel_view) then
        uv.close(cancel_view)
      end
    end
    defer close_cancel_handle()
    do
      async.checkpoint()
      local raw: foreign *void = entry_msg
      defer thread_message_discard(raw)
      entry_msg = nil
      local entry_val = transfer.decode_message(raw)
      local result: value = (entry_val as function (): (value))()
      async.checkpoint()
      local res_msg = value_to_thread_message(result)
      thread_control_record_succeeded_native(ctrl, res_msg)
    catch
      local caught_err = error
      local caught_trace = traceback
      if entry_msg ~= nil then thread_message_discard(entry_msg); entry_msg = nil end

      local is_cancelled = false
      local final_reason: async.CancellationReason<|value|>? = nil
      do
        -- The root Task's first sticky reason is authoritative. A later host
        -- delivery may have arrived while an earlier self-cancel was unwinding.
        async.checkpoint()
      catch
        if error is async.CancellationReason<|value|> then
          is_cancelled = true
          final_reason = error as async.CancellationReason<|value|>
        end
      end
      if is_cancelled then
        local reason_val = final_reason or async.CancellationReason.simple("cancelled")
        local reason_msg, reason_kind = cancellation_to_thread_message(reason_val)
        thread_control_record_cancelled_native(ctrl, reason_msg, reason_kind)
      else
        local report = ""
        if thread_control_is_observed_native(ctrl) == 0 then
          report = format_thread_stderr(caught_err, caught_trace)
        end
        local err_msg: foreign *void = safe_value_to_thread_message(caught_err)
        defer thread_message_discard(err_msg)
        err_msg = thread_control_record_failed_native(
          ctrl, err_msg as foreign *titan_thread_message,
          caught_trace as foreign const *char, #caught_trace as foreign size_t,
          report as foreign const *char, #report as foreign size_t)
      end
      do
        async.request_exit(0)
      catch
      end
    end
    return nil
  end)

  local deliver_cancel = function ()
    if was_cancelled then return end
    was_cancelled = true
    local reason: async.CancellationReason<|value|> =
      async.CancellationReason.simple("cancelled")
    local reason_kind: foreign int = ffi.TITAN_THREAD_CANCELLATION_DEFAULT as foreign int
    local reason_msg: foreign *void = thread_control_take_cancel_reason_native(ctrl, reason_kind)
    defer thread_message_discard(reason_msg)
    if reason_msg ~= nil then
      local decoded = transfer.decode_message(reason_msg)
      reason = thread_message_cancellation(reason_kind, decoded)
    catch
    end
    root_task:cancel(reason)
  end

  local loop = async.current_loop()
  local rc = uv.async_init(loop, cancel_handle, function (_: uv.async_t)
    deliver_cancel()
  end)
  if rc >= 0 then
    cancel_initialized = true
    uv.unref(cancel_view)
    local already = thread_control_bind_child_cancel_native(
      ctrl, cancel_handle:borrow())
    if already ~= 0 then
      deliver_cancel()
    end
  end

  do
    async.loop()
  catch
    local loop_err = error
    local loop_trace = traceback
    local report = ""
    if thread_control_is_observed_native(ctrl) == 0 then
      report = format_thread_stderr(loop_err, loop_trace)
    end
    local err_msg: foreign *void = safe_value_to_thread_message(loop_err)
    defer thread_message_discard(err_msg)
    err_msg = thread_control_record_failed_native(
      ctrl, err_msg as foreign *titan_thread_message,
      loop_trace as foreign const *char, #loop_trace as foreign size_t,
      report as foreign const *char, #report as foreign size_t)
  end
  uv.native_mutex_lock(ctrl.mutex)
  local needs_outcome = ctrl.status_kind == ffi.TITAN_THREAD_STATE_RUNNING
  uv.native_mutex_unlock(ctrl.mutex)
  if needs_outcome then
    -- Ordinary run can skip its body on pre-start cancellation, and a checked
    -- root entry can fail before its outcome-recording catch is installed.
    case root_task:status()
    when cancelled(reason) then
      local reason_msg, reason_kind = cancellation_to_thread_message(reason)
      local raw: foreign *void = reason_msg
      defer thread_message_discard(raw)
      thread_control_record_cancelled_native(
        ctrl, raw as foreign *titan_thread_message, reason_kind)
      raw = nil
    when failed(failure) then
      local report = ""
      if thread_control_is_observed_native(ctrl) == 0 then
        report = format_thread_stderr(failure.error, failure.traceback)
      end
      local err_msg: foreign *void = safe_value_to_thread_message(failure.error)
      defer thread_message_discard(err_msg)
      err_msg = thread_control_record_failed_native(
        ctrl, err_msg as foreign *titan_thread_message,
        failure.traceback as foreign const *char, #failure.traceback as foreign size_t,
        report as foreign const *char, #report as foreign size_t)
    else
    end
  end
end

local function register_thread_bootstrap()
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then
    raise "cannot reserve stack for thread bootstrap registration"
  end
  ffi.lua_pushtvalue(L, child_thread_bootstrap)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "_TITAN_THREAD_BOOTSTRAP")
end

local foreign function thread_worker_protected(state: *lua_State): int
  local ctrl = ffi.lua_touserdata(state, 1)
  transfer.transfer_load_module(state, "titan.thread", 12 as foreign unsigned long long)
  ffi.lua_settop(state, 0)
  ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, "_TITAN_THREAD_BOOTSTRAP")
  ffi.lua_pushlightuserdata(state, ctrl)
  ffi.lua_callk(state, 1, 0, 0 as foreign lua_KContext, nil)
  return 0
end

local foreign function record_bootstrap_failure_native(
    ctrl: *titan_thread_control, msg_bytes: const *char, len: size_t)
  local err_msg: foreign *titan_thread_message = nil
  if len <= ffi.SIZE_MAX - foreign titan_thread_message.sizeof then
    err_msg = ffi.calloc(1 as foreign size_t, foreign titan_thread_message.sizeof + len)
      as foreign *titan_thread_message
    if err_msg ~= nil then
      err_msg.kind = ffi.TITAN_ASYNC_MESSAGE_STRING
      err_msg.length = len
      local bytes = (err_msg + 1) as foreign *char
      err_msg.bytes = bytes
      if len > (0 as foreign size_t) then
        if msg_bytes ~= nil then
          ffi.memcpy(bytes, msg_bytes, len)
        end
      end
    end
  end
  local leftover = thread_control_record_failed_native(
    ctrl, err_msg, "", 0 as foreign size_t, msg_bytes, len)
  if leftover ~= nil then
    thread_message_discard(leftover)
  end
end

local foreign function thread_worker_main(arg: *void)
  local ctrl = arg as foreign *titan_thread_control
  local state = ctrl.child_state
  if state ~= nil then
    if ffi.lua_checkstack(state, 3) ~= 0 then
      ffi.lua_pushcclosure(state, thread_worker_protected, 0)
      ffi.lua_pushlightuserdata(state, ctrl as foreign *void)
      local status = ffi.lua_pcallk(
        state, 1, 0, 0, 0 as foreign lua_KContext, nil)
      if status ~= ffi.LUA_OK then
        local len = 0 as foreign size_t
        local msg_bytes = ffi.lua_tolstring(state, -1, len)
        if msg_bytes == nil then
          msg_bytes = "child thread bootstrap failed"
          len = 29 as foreign size_t
        end
        record_bootstrap_failure_native(ctrl, msg_bytes, len)
      end
    end
    thread_control_clear_child_cancel_native(ctrl)
    ffi.lua_close(state)
    ctrl.child_state = nil
  end
  if ctrl.status_kind == ffi.TITAN_THREAD_STATE_RUNNING then
    record_bootstrap_failure_native(
      ctrl, "child thread exited without recording a status", 46 as foreign size_t)
  end
  thread_control_complete_native(ctrl)
  thread_control_release_native(ctrl)
end

local foreign function thread_control_abandon_and_release(ctrl: *titan_thread_control)
  if ctrl == nil then return end
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.abandoned = 1
  local entry_msg: foreign *titan_thread_message = nil
  local cancel_msg: foreign *titan_thread_message = nil
  if ctrl.finished ~= 0 then
    entry_msg = ctrl.entry_msg
    ctrl.entry_msg = nil
    cancel_msg = ctrl.cancel_reason_msg
    ctrl.cancel_reason_msg = nil
  end
  local result_msg = ctrl.result_msg
  ctrl.result_msg = nil
  uv.native_mutex_unlock(ctrl.mutex)
  if entry_msg ~= nil then
    thread_message_discard(entry_msg)
  end
  if cancel_msg ~= nil then
    thread_message_discard(cancel_msg)
  end
  if result_msg ~= nil then
    thread_message_discard(result_msg)
  end
  thread_control_release_native(ctrl)
end

local function thread_finalize(self: Thread<|value|>)
  local ctrl = self.native
  self.native = nil
  if ctrl ~= nil then
    thread_control_abandon_and_release(ctrl)
  end
end

-- Cleanup run while an abandoned coroutine unwinds at Lua-state close can reach
-- a Thread whose finalizer already released its control block.
local function Thread:control(): foreign *titan_thread_control
  local ctrl = self.native
  if ctrl == nil then raise "thread handle was finalized" end
  return ctrl
end

local function Thread:reconstruct_terminal_status(): ThreadStatus<|R|>
  local cached? = self.cached_status
  if cached ~= nil then
    return cached
  end
  local ctrl = self:control()
  uv.native_mutex_lock(ctrl.mutex)
  ctrl.observed = 1
  local kind = ctrl.status_kind
  local reason_kind = ctrl.result_reason_kind
  local raw: foreign *void = ctrl.result_msg
  ctrl.result_msg = nil
  local trace_ptr = ctrl.error_traceback
  local trace_len = ctrl.error_traceback_len
  ctrl.error_traceback = nil
  ctrl.error_traceback_len = 0 as foreign size_t
  uv.native_mutex_unlock(ctrl.mutex)
  defer thread_message_discard(raw)
  defer ffi.free(trace_ptr)

  local trace_str = ""
  if trace_ptr ~= nil then
    if trace_len > (0 as foreign size_t) then
      trace_str = trace_ptr as string(trace_len)
    end
  end

  local resolved: ThreadStatus<|R|> = ThreadStatus<|R|>.running()
  if kind == ffi.TITAN_THREAD_STATE_SUCCEEDED then
    local val: value = nil
    local decode_ok = true
    if raw ~= nil then
      val = transfer.decode_message(raw)
    catch
      decode_ok = false
      resolved = ThreadStatus<|R|>.failed(Error(error, traceback))
    end
    if decode_ok then
      resolved = ThreadStatus<|R|>.succeeded(val as R)
    end
  elseif kind == ffi.TITAN_THREAD_STATE_CANCELLED then
    local reason: async.CancellationReason<|value|> =
      async.CancellationReason.simple("cancelled")
    if raw ~= nil then
      local decoded = transfer.decode_message(raw)
      reason = thread_message_cancellation(reason_kind, decoded)
    catch
    end
    resolved = ThreadStatus<|R|>.cancelled(reason)
  else
    local err_val: value = "thread failed"
    if raw ~= nil then
      err_val = transfer.decode_message(raw)
    catch
    end
    resolved = ThreadStatus<|R|>.failed(Error(err_val, trace_str))
  end
  self.cached_status = resolved
  return resolved
end

--- Return a snapshot of the thread's current lifecycle status without blocking.
-- @return Current ThreadStatus (running, succeeded, failed, or cancelled).
-- @usage standard-library-thread.md
function Thread:status(): ThreadStatus<|R|>
  local cached? = self.cached_status
  if cached ~= nil then
    return cached
  end
  local ctrl = self:control()
  uv.native_mutex_lock(ctrl.mutex)
  local done = ctrl.finished ~= 0
  uv.native_mutex_unlock(ctrl.mutex)
  if not done then
    return ThreadStatus<|R|>.running()
  end
  return self:reconstruct_terminal_status()
end

local function Thread:wait_until_finished()
  local ctrl = self:control()
  uv.native_mutex_lock(ctrl.mutex)
  local done = ctrl.finished ~= 0
  if done then ctrl.observed = 1 end
  uv.native_mutex_unlock(ctrl.mutex)
  if done then return end
  -- The cell lives in this stackful frame like a channel wait; only the
  -- pointer is used. Each poll after a wait acknowledges its wake.
  local wait_storage = foreign titan_thread_join_wait.new()
  local wait: foreign *titan_thread_join_wait = wait_storage
  wait.control = ctrl
  while true do
    async.wait_external_native(self, wait,
      thread_control_register_join_wait, thread_control_unregister_join_wait)
    if thread_control_poll_join_native(wait) ~= 0 then return end
  end
end

--- Suspend the current Task until the thread finishes and return its terminal ThreadStatus.
-- @return Terminal ThreadStatus without raising the thread's failure or cancellation outcome.
-- @usage standard-library-thread.md
function Thread:join(): ThreadStatus<|R|>
  async.running()
  async.checkpoint()
  self:wait_until_finished()
  local status = thread_control_join_native(self.native, 0)
  if status ~= 0 then
    raise async.OperationError(status, uv.err_name(status), uv.strerror(status), "thread.join")
  end
  -- A cached logical outcome does not waive actual OS-thread retirement.
  return self:reconstruct_terminal_status()
end

--- Request cooperative cancellation of the thread's event loop and Tasks.
-- @param reason Optional CancellationReason; first cancellation reason wins.
-- @usage standard-library-thread.md
function Thread:cancel(reason: async.CancellationReason<|value|>?)
  local actual = reason or async.CancellationReason.simple("cancelled")
  local ctrl = self:control()
  uv.native_mutex_lock(ctrl.mutex)
  local ignore = ctrl.finished ~= 0 or ctrl.cancel_requested ~= 0
  uv.native_mutex_unlock(ctrl.mutex)
  if ignore then return end
  local msg, reason_kind = cancellation_to_thread_message(actual)
  defer if msg ~= nil then thread_message_discard(msg) end
  local accepted = thread_control_request_cancel_native(ctrl, msg, reason_kind)
  if accepted ~= 0 then
    msg = nil
  end
end

-- Implementation notes: doc/implementation/thread-library.md#join-proxy-retirement-and-the-native-terminal-barrier
--- Return an async.Task proxy for composing this thread with async combinators.
-- @return Host-state Task that resolves, fails, or cancels with this thread.
-- @usage standard-library-thread.md
function Thread:task(): async.Task<|R, value|>
  local existing? = self.monitor_task
  if existing ~= nil then
    return existing
  end
  local ctrl = self.native
  local final_wait = async.prepare_native_retirement(
    self, ctrl as foreign *void,
    thread_control_register_retirement_native,
    thread_control_unregister_retirement_native,
    thread_control_retire_native)
  local published = false
  defer if not published then final_wait:close() end
  local finished = false
  local task = async.run_with_cleanup<|R, value|>(function (): R
    -- Only the prearmed native barrier attempts this proxy's OS join. A join
    -- error must reach the driver, not become a body error retried by cleanup.
    self:wait_until_finished()
    finished = true
    case self:reconstruct_terminal_status()
    when succeeded(val) then
      return val
    when failed(err) then
      err:raise()
      -- Required for return-path analysis; err:raise() above always raises.
      raise err.error
    when cancelled(reason) then
      local current = async.running()
      current:cancel(reason)
      async.checkpoint()
      -- Required for return-path analysis; checkpoint() above always raises.
      raise reason
    when running() then
      raise "unreachable running status after native thread completion"
    end
  end, function (reason: async.CancellationReason<|value|>?)
    -- While the Lua state closes this cleanup runs outside any Task, so it
    -- cannot await the barrier; runtime_finalize leaves the armed gate
    -- nonterminal instead.
    -- Implementation notes: doc/implementation/libuv-runtime.md#lua-state-close-of-an-unretired-runtime
    defer if ffi.titan_state_closing(L) == 0 then
      defer final_wait:close()
      final_wait:wait_cleanup()
    end
    if not finished then self:cancel(reason) end
  end, final_wait)
  published = true
  self.monitor_task = task
  return task
end

local function spawn_raw<|R|>(
    entry: function (): (R),
    initially_observed: boolean,
    admission: {Thread<|R|>: boolean}?): Thread<|R|>
  local handle = Thread<|R|> {
    native = nil,
    monitor_task = nil,
    cached_status = nil
  }
  gc.finalizable(handle, thread_finalize)
  local mutex = uv.mutex_t.create_native()
  local ctrl = thread_control_new_native(mutex)
  if ctrl == nil then
    raise "thread: out of memory allocating control block"
  end
  defer if ctrl ~= nil then
    if admission ~= nil then admission[handle] = nil end
    handle.native = nil
    if ctrl.child_state ~= nil then
      local state = ctrl.child_state
      ctrl.child_state = nil
      ffi.lua_close(state)
    end
    ctrl.refcount = 1 as foreign size_t
    thread_control_release_native(ctrl)
  end
  if initially_observed then
    ctrl.observed = 1
  end
  ctrl.entry_msg = value_to_thread_message(entry)
  local state = lua.new()
  ctrl.child_state = state:detach()
  -- Group ownership must be admitted before a worker can start. If the Map
  -- grows here and fails, the existing ctrl guard closes its prepared state,
  -- discards its entry packet and removes any partially committed membership.
  handle.native = ctrl
  if admission ~= nil then admission[handle] = false end
  ctrl.refcount = 2 as foreign size_t
  local rc, token = uv.create_native_thread(thread_worker_main, ctrl as foreign *void)
  if rc < 0 then
    raise async.OperationError(rc, uv.err_name(rc), uv.strerror(rc), "thread.spawn")
  end
  ctrl.os_thread = token
  ctrl = nil
  return handle
end

--- Spawn a dedicated OS thread with an isolated Lua/Titan state and async Runtime.
-- @param entry Zero-argument closure to execute as the child thread's root Task.
-- @return Thread handle for observing, joining, or cancelling the spawned thread.
-- @usage standard-library-thread.md
function spawn<|R|>(entry: function (): (R)): Thread<|R|>
  return spawn_raw<|R|>(entry, false, nil)
end

--- Spawn a dedicated OS thread passing 1 transferred argument to its entry closure.
-- @param entry One-argument closure to execute in the child thread.
-- @param first First argument transferred by value or custom hook.
-- @return Thread handle for observing, joining, or cancelling the spawned thread.
-- @usage standard-library-thread.md
function spawn_one<|A, R|>(entry: function (A): (R), first: A): Thread<|R|>
  return spawn<|R|>(function (): R
    return entry(first)
  end)
end

--- Spawn a dedicated OS thread passing 2 transferred arguments to its entry closure.
-- @param entry Two-argument closure to execute in the child thread.
-- @param first First argument transferred to the child thread.
-- @param second Second argument transferred to the child thread.
-- @return Thread handle for observing, joining, or cancelling the spawned thread.
-- @usage standard-library-thread.md
function spawn_two<|A, B, R|>(
    entry: function (A, B): (R), first: A, second: B): Thread<|R|>
  return spawn<|R|>(function (): R
    return entry(first, second)
  end)
end

--- Spawn a dedicated OS thread passing 3 transferred arguments to its entry closure.
-- @param entry Three-argument closure to execute in the child thread.
-- @param first First argument transferred to the child thread.
-- @param second Second argument transferred to the child thread.
-- @param third Third argument transferred to the child thread.
-- @return Thread handle for observing, joining, or cancelling the spawned thread.
-- @usage standard-library-thread.md
function spawn_three<|A, B, C, R|>(
    entry: function (A, B, C): (R), first: A, second: B, third: C): Thread<|R|>
  return spawn<|R|>(function (): R
    return entry(first, second, third)
  end)
end

--- Spawn a dedicated OS thread passing 4 transferred arguments to its entry closure.
-- @param entry Four-argument closure to execute in the child thread.
-- @param first First argument transferred to the child thread.
-- @param second Second argument transferred to the child thread.
-- @param third Third argument transferred to the child thread.
-- @param fourth Fourth argument transferred to the child thread.
-- @return Thread handle for observing, joining, or cancelling the spawned thread.
-- @usage standard-library-thread.md
function spawn_four<|A, B, C, D, R|>(
    entry: function (A, B, C, D): (R),
    first: A, second: B, third: C, fourth: D): Thread<|R|>
  return spawn<|R|>(function (): R
    return entry(first, second, third, fourth)
  end)
end

--- Spawn a dedicated OS thread passing 5 transferred arguments to its entry closure.
-- @param entry Five-argument closure to execute in the child thread.
-- @param first First argument transferred to the child thread.
-- @param second Second argument transferred to the child thread.
-- @param third Third argument transferred to the child thread.
-- @param fourth Fourth argument transferred to the child thread.
-- @param fifth Fifth argument transferred to the child thread.
-- @return Thread handle for observing, joining, or cancelling the spawned thread.
-- @usage standard-library-thread.md
function spawn_five<|A, B, C, D, E, R|>(
    entry: function (A, B, C, D, E): (R),
    first: A, second: B, third: C, fourth: D, fifth: E): Thread<|R|>
  return spawn<|R|>(function (): R
    return entry(first, second, third, fourth, fifth)
  end)
end
