--- OS threads with isolated Lua/Titan states, bounded MPMC channels, and thread groups.
-- @module titan.thread
-- @usage standard-library-thread.md

foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"
foreign import "unistd.h"
foreign import "errno.h"
foreign import "stdint.h"
foreign import "stdlib.h"
foreign import "string.h"
foreign import "native.h"
local async = import "async"
local gc = import "gc"
local iteration = import "iteration"
local lua = import "lua"
local transfer = import "transfer"
local uv = import "uv"

--- Caught error value and stack traceback captured from a failed thread.
-- @field error Reconstructed error value (or its rendered string when the original value is not transferable).
-- @field traceback Formatted stack traceback from the child thread.
-- @usage standard-library-thread.md
record Error
  const error: value
  const traceback: string
end

--- Rethrow the thread's original error value with its preserved traceback.
-- @usage standard-library-thread.md
function Error:raise()
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then raise "cannot reserve error handoff" end
  ffi.lua_pushtvalue(L, self.traceback)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  ffi.lua_pushboolean(L, 1)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
  raise self.error
end

--- Lifecycle state of a spawned thread.
-- @usage standard-library-thread.md
union ThreadStatus<|R|>
  running()
  succeeded(R)
  failed(Error)
  cancelled(async.CancellationReason<|value|>)
end

--- Return the lowercase name of this thread status variant.
-- @return Variant tag name ("running", "succeeded", "failed", or "cancelled").
-- @usage standard-library-thread.md
function ThreadStatus:as_string(): string
  case self
  when running() then return "running"
  when succeeded(_) then return "succeeded"
  when failed(_) then return "failed"
  when cancelled(_) then return "cancelled"
  end
end

--- Report whether the thread has reached a terminal state.
-- @return True for succeeded, failed, or cancelled; false while running.
-- @usage standard-library-thread.md
function ThreadStatus:has_finished(): boolean
  case self
  when running() then return false
  else return true
  end
end

--- Report whether the thread completed normally and project its return value.
-- @return True and the return value when succeeded; false and nil otherwise.
-- @usage standard-library-thread.md
function ThreadStatus:has_succeeded(): (boolean, R?)
  case self
  when succeeded(result) then return true, result
  else return false, nil
  end
end

--- Report whether the thread failed with an uncaught error and project its Error.
-- @return True and the Error when failed; false and nil otherwise.
-- @usage standard-library-thread.md
function ThreadStatus:has_failed(): (boolean, Error?)
  case self
  when failed(err) then return true, err
  else return false, nil
  end
end

--- Report whether the thread terminated due to cancellation and project its reason.
-- @return True and the CancellationReason when cancelled; false and nil otherwise.
-- @usage standard-library-thread.md
function ThreadStatus:has_cancelled(): (boolean, async.CancellationReason<|value|>?)
  case self
  when cancelled(reason) then return true, reason
  else return false, nil
  end
end

-- Implementation notes: doc/implementation/thread-library.md#waiter-suspension-shared-external-wake-and-o1-cancellation-unlink
local foreign function waiter_wake_one(q: *titan_thread_waiter_queue)
  local waiter = q.head
  if waiter == nil then return end
  q.head = waiter.next
  if q.head ~= nil then
    q.head.prev = nil
  else
    q.tail = nil
  end
  waiter.next = nil
  waiter.prev = nil
  waiter.active = 0
  waiter.signaled = 1
  local target = waiter.wake_target
  waiter.wake_target = nil
  if target ~= nil then
    uv.native_external_wake_notify(target)
    uv.native_external_wake_release(target)
  end
end

local foreign function waiter_wake_all(q: *titan_thread_waiter_queue)
  while q.head ~= nil do
    waiter_wake_one(q)
  end
end

-- Implementation notes: doc/implementation/thread-library.md#registration-pins-and-state-close-withdrawal
local foreign function waiter_enqueue(
    q: *titan_thread_waiter_queue,
    waiter: *titan_thread_waiter,
    wake_target: *void,
    pins: *size_t)
  pins[0] = pins[0] + (1 as foreign size_t)
  uv.native_external_wake_retain(wake_target)
  waiter.wake_target = wake_target
  waiter.next = nil
  waiter.prev = q.tail
  if q.tail ~= nil then
    q.tail.next = waiter
  else
    q.head = waiter
  end
  q.tail = waiter
  waiter.active = 1
  waiter.signaled = 0
end

-- The woken Task's own locked retry acknowledges its wake: no extra lock.
local foreign function waiter_acknowledge(waiter: *titan_thread_waiter, pins: *size_t)
  if waiter.signaled == 0 then return end
  waiter.signaled = 0
  pins[0] = pins[0] - (1 as foreign size_t)
end

-- Unregister drops the pin of a still linked or unacknowledged woken waiter.
local foreign function waiter_holds_pin(waiter: *titan_thread_waiter): int
  if waiter.active ~= 0 then return 1 end
  if waiter.signaled ~= 0 then return 1 end
  return 0
end

local foreign function waiter_unlink(
    q: *titan_thread_waiter_queue,
    waiter: *titan_thread_waiter)
  if waiter.active == 0 then return end
  if waiter.prev ~= nil then
    waiter.prev.next = waiter.next
  else
    q.head = waiter.next
  end
  if waiter.next ~= nil then
    waiter.next.prev = waiter.prev
  else
    q.tail = waiter.prev
  end
  waiter.next = nil
  waiter.prev = nil
  waiter.active = 0
  local target = waiter.wake_target
  waiter.wake_target = nil
  if target ~= nil then uv.native_external_wake_release(target) end
end

local foreign function thread_message_discard(message: *void)
  transfer.discard_message(message)
end

local foreign function clear_ring_messages(ch: *titan_thread_channel)
  if ch.ring == nil then return end
  while ch.count > (0 as foreign size_t) do
    local slot = ch.ring + ch.head
    local msg = slot[0]
    slot[0] = nil
    ch.head = (ch.head + (1 as foreign size_t)) % ch.capacity
    ch.count = ch.count - (1 as foreign size_t)
    thread_message_discard(msg)
  end
  ch.head = 0 as foreign size_t
  ch.tail = 0 as foreign size_t
end

local foreign function channel_destroy_unreferenced(ch: *titan_thread_channel)
  -- Every linked node holds a pin, so an unreferenced channel has empty
  -- queues; abort deterministically on a pin-accounting bug.
  if ffi.titan_thread_overflow_queue(ch).head ~= nil then ffi.abort() end
  if ffi.titan_thread_underflow_queue(ch).head ~= nil then ffi.abort() end
  clear_ring_messages(ch)
  if ch.ring ~= nil then
    ffi.free(ch.ring)
    ch.ring = nil
  end
  if ch.mutex ~= nil then
    uv.native_mutex_destroy(ch.mutex)
    ch.mutex = nil
  end
  ffi.free(ch)
end

-- Callers hold ch.mutex. A pinned channel outlives its last endpoint until the
-- final registration is withdrawn or acknowledged.
local foreign function channel_unreferenced(ch: *titan_thread_channel): int
  if ch.active_senders ~= (0 as foreign size_t) then return 0 end
  if ch.active_receivers ~= (0 as foreign size_t) then return 0 end
  if ch.waiter_pins ~= (0 as foreign size_t) then return 0 end
  return 1
end

local foreign function channel_drain_and_discard(ch: *titan_thread_channel)
  if ch == nil then return end
  while true do
    uv.native_mutex_lock(ch.mutex)
    local msg: foreign *titan_thread_message = nil
    if ch.ring ~= nil then
      if ch.count > (0 as foreign size_t) then
        local slot = ch.ring + ch.head
        msg = slot[0]
        slot[0] = nil
        ch.head = (ch.head + (1 as foreign size_t)) % ch.capacity
        ch.count = ch.count - (1 as foreign size_t)
      else
        ch.head = 0 as foreign size_t
        ch.tail = 0 as foreign size_t
        uv.native_mutex_unlock(ch.mutex)
        return
      end
    else
      ch.head = 0 as foreign size_t
      ch.tail = 0 as foreign size_t
      uv.native_mutex_unlock(ch.mutex)
      return
    end
    uv.native_mutex_unlock(ch.mutex)
    if msg ~= nil then
      thread_message_discard(msg)
    end
  end
end

foreign function channel_retain_sender_native(raw: *void): void
  local ch = raw as foreign *titan_thread_channel
  if ch == nil then return end
  uv.native_mutex_lock(ch.mutex)
  ch.active_senders = ch.active_senders + (1 as foreign size_t)
  uv.native_mutex_unlock(ch.mutex)
end

foreign function channel_retain_receiver_native(raw: *void): void
  local ch = raw as foreign *titan_thread_channel
  if ch == nil then return end
  uv.native_mutex_lock(ch.mutex)
  ch.active_receivers = ch.active_receivers + (1 as foreign size_t)
  uv.native_mutex_unlock(ch.mutex)
end

foreign function channel_release_sender_native(raw: *void): void
  local ch = raw as foreign *titan_thread_channel
  if ch == nil then return end
  uv.native_mutex_lock(ch.mutex)
  if ch.active_senders > (0 as foreign size_t) then
    ch.active_senders = ch.active_senders - (1 as foreign size_t)
    if ch.active_senders == (0 as foreign size_t) then
      if ch.closed == 0 then
        ch.closed = 1
        waiter_wake_all(ffi.titan_thread_overflow_queue(ch))
        waiter_wake_all(ffi.titan_thread_underflow_queue(ch))
      end
    end
  end
  local destroy = channel_unreferenced(ch)
  uv.native_mutex_unlock(ch.mutex)
  if destroy ~= 0 then
    channel_destroy_unreferenced(ch)
  end
end

-- Implementation notes: doc/implementation/thread-library.md#endpoint-transfer-c-abi-release-chain-and-last-receiver-pin
foreign function channel_release_receiver_native(raw: *void): void
  local ch = raw as foreign *titan_thread_channel
  if ch == nil then return end
  uv.native_mutex_lock(ch.mutex)
  if ch.active_receivers == (0 as foreign size_t) then
    uv.native_mutex_unlock(ch.mutex)
    return
  end
  if ch.active_receivers > (1 as foreign size_t) then
    ch.active_receivers = ch.active_receivers - (1 as foreign size_t)
    uv.native_mutex_unlock(ch.mutex)
    return
  end
  -- Keep the last Receiver reference alive while unlocked disposal can recurse.
  ch.closed = 2
  waiter_wake_all(ffi.titan_thread_overflow_queue(ch))
  waiter_wake_all(ffi.titan_thread_underflow_queue(ch))
  uv.native_mutex_unlock(ch.mutex)
  channel_drain_and_discard(ch)
  uv.native_mutex_lock(ch.mutex)
  ch.active_receivers = ch.active_receivers - (1 as foreign size_t)
  local destroy = channel_unreferenced(ch)
  uv.native_mutex_unlock(ch.mutex)
  if destroy ~= 0 then
    channel_destroy_unreferenced(ch)
  end
end

local foreign function channel_close_sender_native(ch: *titan_thread_channel)
  if ch == nil then return end
  uv.native_mutex_lock(ch.mutex)
  if ch.closed == 0 then
    ch.closed = 1
    waiter_wake_all(ffi.titan_thread_overflow_queue(ch))
    waiter_wake_all(ffi.titan_thread_underflow_queue(ch))
  end
  uv.native_mutex_unlock(ch.mutex)
end

local foreign function channel_close_receiver_native(ch: *titan_thread_channel)
  if ch == nil then return end
  uv.native_mutex_lock(ch.mutex)
  ch.closed = 2
  waiter_wake_all(ffi.titan_thread_overflow_queue(ch))
  waiter_wake_all(ffi.titan_thread_underflow_queue(ch))
  uv.native_mutex_unlock(ch.mutex)
  channel_drain_and_discard(ch)
end

local foreign function channel_is_closed_native(ch: *titan_thread_channel): int
  if ch == nil then return 1 end
  uv.native_mutex_lock(ch.mutex)
  local closed = 0
  if ch.closed ~= 0 then
    closed = 1
  end
  uv.native_mutex_unlock(ch.mutex)
  return closed
end

local function value_to_thread_message(item: value): foreign *titan_thread_message
  return transfer.encode_message(item) as foreign *titan_thread_message
end

local function copy_native_bytes(bytes: foreign const *char, length: foreign size_t): string
  if length == 0 then return "" end
  local top = ffi.lua_gettop(L)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for thread message bytes"
  end
  ffi.lua_pushlstring(L, bytes, length)
  local result: value = ffi.lua_totvalue(L, -1)
  ffi.lua_settop(L, top)
  return result as string
end

local foreign function write_stderr_bytes(bytes: const *char, length: size_t)
  if bytes == nil then return end
  if length == (0 as foreign size_t) then return end
  local offset = 0 as foreign size_t
  while offset < length do
    local chunk = length - offset
    if chunk > (65536 as foreign size_t) then
      chunk = 65536 as foreign size_t
    end
    local written = ffi.write(
      2 as foreign int,
      bytes + offset,
      chunk as foreign titan_thread_write_count)
    if written < 0 then
      if ffi.errno == ffi.EINTR then
        -- Retry interrupted write.
      else
        return
      end
    elseif written == 0 then
      return
    else
      offset = offset + (written as foreign size_t)
    end
  end
end

local function render_error_text(err: value): string
  local text = "<error while rendering thread failure>"
  do
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    if err is async.OperationError then
      local failure = err as async.OperationError
      text = failure.operation .. ": " .. failure.name ..
             " (" .. failure.code .. "): " .. failure.message
    else
      -- Candidate plus the two temporary slots used by luaL_getmetafield/callmeta.
      if ffi.lua_checkstack(L, 3) == 0 then
        raise "cannot reserve Lua stack for thread error rendering"
      end
      ffi.lua_pushtvalue(L, err)
      local rendered = ffi.luaL_tolstring(L, -1, nil)
      if rendered then
        text = rendered as string
      else
        text = "<unprintable error>"
      end
    end
  catch
  end
  return text
end

local function format_thread_stderr(err: value, trace: string): string
  local text = "uncaught error in thread: " .. render_error_text(err) .. "\n"
  if #trace > 0 then
    text = text .. "stack traceback:\n" .. trace .. "\n"
  end
  return text
end

do
  register_thread_bootstrap()
  register_channel_resources()
end
