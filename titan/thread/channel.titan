--- Bounded cross-thread MPMC channels.
-- @module titan.thread

--- Sending endpoint of a bounded cross-thread channel.
-- @usage standard-library-thread.md
record Sender<|T|>
  local native: foreign *titan_thread_channel
end

--- Receiving endpoint of a bounded cross-thread channel.
-- @usage standard-library-thread.md
record Receiver<|T|>
  local native: foreign *titan_thread_channel
end

--- Result of receiving from a channel that may close cleanly after draining.
-- @usage standard-library-thread.md
union ReceiveResult<|T|>
  message(T)
  closed()
end

local foreign function channel_new_native(
    capacity: size_t,
    mutex: *void): *titan_thread_channel
  if mutex == nil then return nil end
  if capacity == (0 as size_t) then
    uv.native_mutex_destroy(mutex)
    return nil
  end
  if capacity > ffi.SIZE_MAX / foreign titan_thread_message_ptr.sizeof then
    uv.native_mutex_destroy(mutex)
    return nil
  end
  local ch = ffi.calloc(1 as size_t, foreign titan_thread_channel.sizeof)
    as *titan_thread_channel
  if ch == nil then
    uv.native_mutex_destroy(mutex)
    return nil
  end
  local ring = ffi.calloc(capacity, foreign titan_thread_message_ptr.sizeof)
    as *titan_thread_message_ptr
  if ring == nil then
    ffi.free(ch)
    uv.native_mutex_destroy(mutex)
    return nil
  end
  ch.mutex = mutex
  ch.active_senders = 1 as size_t
  ch.active_receivers = 1 as size_t
  ch.capacity = capacity
  ch.head = 0 as size_t
  ch.tail = 0 as size_t
  ch.count = 0 as size_t
  ch.ring = ring
  ch.closed = 0
  return ch
end

-- Callers hold ch.mutex. Only a registrar passes a waiter, linked when full.
local foreign function channel_enqueue_locked(
    ch: *titan_thread_channel,
    msg: *titan_thread_message,
    waiter: *titan_thread_waiter,
    wake_target: *void): int
  if ch.closed ~= 0 then return 2 end
  if ch.count < ch.capacity then
    local slot = ch.ring + ch.tail
    slot[0] = msg
    ch.tail = (ch.tail + (1 as size_t)) % ch.capacity
    ch.count = ch.count + (1 as size_t)
    waiter_wake_one(ffi.titan_thread_underflow_queue(ch))
    return 0
  end
  if waiter ~= nil then
    waiter_enqueue(ffi.titan_thread_overflow_queue(ch), waiter, wake_target,
      ffi.titan_thread_channel_pins(ch))
  end
  return 1
end

local foreign function channel_try_enqueue_native(
    ch: *titan_thread_channel,
    msg: *titan_thread_message,
    waiter: *titan_thread_waiter,
    wake_target: *void): int
  if ch == nil then return 2 end
  uv.native_mutex_lock(ch.mutex)
  local status = channel_enqueue_locked(ch, msg, waiter, wake_target)
  uv.native_mutex_unlock(ch.mutex)
  return status
end

-- Implementation notes: doc/implementation/thread-library.md#registration-pins-and-state-close-withdrawal
-- A send's retry after its wait acknowledges the wake under this same lock.
-- The retrying Task holds its Sender, so the unpin can never free ch here.
local foreign function channel_retry_enqueue_native(
    ch: *titan_thread_channel,
    msg: *titan_thread_message,
    waiter: *titan_thread_waiter): int
  if ch == nil then return 2 end
  uv.native_mutex_lock(ch.mutex)
  waiter_acknowledge(waiter, ffi.titan_thread_channel_pins(ch))
  local status = channel_enqueue_locked(ch, msg, nil, nil)
  uv.native_mutex_unlock(ch.mutex)
  return status
end

-- Runs on cancellation, unwind, or lua_close withdrawal, when the endpoint may
-- already be released: the registration pin keeps ch valid until here.
local foreign function channel_unregister_overflow_waiter(
    ch: *titan_thread_channel, waiter: *titan_thread_waiter)
  if ch == nil then return end
  if waiter == nil then return end
  uv.native_mutex_lock(ch.mutex)
  local pinned = waiter_holds_pin(waiter)
  if waiter.active ~= 0 then
    waiter_unlink(ffi.titan_thread_overflow_queue(ch), waiter)
  elseif waiter.signaled ~= 0 then
    if ch.count < ch.capacity then
      waiter_wake_one(ffi.titan_thread_overflow_queue(ch))
    elseif ch.closed ~= 0 then
      waiter_wake_one(ffi.titan_thread_overflow_queue(ch))
    end
  end
  waiter.signaled = 0
  if pinned ~= 0 then ch.waiter_pins = ch.waiter_pins - (1 as size_t) end
  local destroy = channel_unreferenced(ch)
  uv.native_mutex_unlock(ch.mutex)
  if destroy ~= 0 then channel_destroy_unreferenced(ch) end
end

-- Callers hold ch.mutex. Only a registrar passes a waiter, linked when empty.
local foreign function channel_dequeue_locked(
    ch: *titan_thread_channel,
    waiter: *titan_thread_waiter,
    wake_target: *void,
    result: *(*titan_thread_message)): int
  if ch.closed == 2 then return 2 end
  if ch.count > (0 as size_t) then
    local slot = ch.ring + ch.head
    result[0] = slot[0]
    slot[0] = nil
    ch.head = (ch.head + (1 as size_t)) % ch.capacity
    ch.count = ch.count - (1 as size_t)
    waiter_wake_one(ffi.titan_thread_overflow_queue(ch))
    return 0
  end
  if ch.closed ~= 0 then return 2 end
  if waiter ~= nil then
    waiter_enqueue(ffi.titan_thread_underflow_queue(ch), waiter, wake_target,
      ffi.titan_thread_channel_pins(ch))
  end
  return 1
end

local foreign function channel_try_dequeue_native(
    ch: *titan_thread_channel,
    waiter: *titan_thread_waiter,
    wake_target: *void,
    result: *(*titan_thread_message)): int
  result[0] = nil
  if ch == nil then return 2 end
  uv.native_mutex_lock(ch.mutex)
  local status = channel_dequeue_locked(ch, waiter, wake_target, result)
  uv.native_mutex_unlock(ch.mutex)
  return status
end

-- A receive's retry after its wait acknowledges the wake under this same lock.
-- The retrying Task holds its Receiver, so the unpin can never free ch here.
local foreign function channel_retry_dequeue_native(
    ch: *titan_thread_channel,
    waiter: *titan_thread_waiter,
    result: *(*titan_thread_message)): int
  result[0] = nil
  if ch == nil then return 2 end
  uv.native_mutex_lock(ch.mutex)
  waiter_acknowledge(waiter, ffi.titan_thread_channel_pins(ch))
  local status = channel_dequeue_locked(ch, nil, nil, result)
  uv.native_mutex_unlock(ch.mutex)
  return status
end

local foreign function channel_unregister_underflow_waiter(
    ch: *titan_thread_channel, waiter: *titan_thread_waiter)
  if ch == nil then return end
  if waiter == nil then return end
  uv.native_mutex_lock(ch.mutex)
  local pinned = waiter_holds_pin(waiter)
  if waiter.active ~= 0 then
    waiter_unlink(ffi.titan_thread_underflow_queue(ch), waiter)
  elseif waiter.signaled ~= 0 then
    if ch.count > (0 as size_t) then
      waiter_wake_one(ffi.titan_thread_underflow_queue(ch))
    elseif ch.closed ~= 0 then
      waiter_wake_one(ffi.titan_thread_underflow_queue(ch))
    end
  end
  waiter.signaled = 0
  if pinned ~= 0 then ch.waiter_pins = ch.waiter_pins - (1 as size_t) end
  local destroy = channel_unreferenced(ch)
  uv.native_mutex_unlock(ch.mutex)
  if destroy ~= 0 then channel_destroy_unreferenced(ch) end
end

-- Implementation notes: doc/implementation/thread-library.md#shared-external-wake-suspension
local foreign function channel_register_send_wait(context: *void, target: *void): int
  local wait = context as *titan_thread_channel_wait
  wait.status = channel_try_enqueue_native(
    wait.channel, wait.message, ffi.titan_thread_channel_waiter(wait), target)
  if wait.status == 0 then wait.message = nil end
  if wait.status == 1 then return 1 end
  return 0
end

-- Implementation notes: doc/implementation/thread-library.md#registration-pins-and-state-close-withdrawal
-- A withdrawn send never enqueues its packet, so withdrawal disposes it here,
-- outside ch.mutex because discarding can release endpoints of this channel.
-- The send's defer runs after this withdrawal on cancellation and while an
-- abandoned Task unwinds (including at lua_close); it finds the cleared pointer.
local foreign function channel_unregister_send_wait(context: *void)
  local wait = context as *titan_thread_channel_wait
  channel_unregister_overflow_waiter(wait.channel, ffi.titan_thread_channel_waiter(wait))
  local message = wait.message
  wait.message = nil
  thread_message_discard(message)
end

local foreign function channel_register_receive_wait(context: *void, target: *void): int
  local wait = context as *titan_thread_channel_wait
  local message: *titan_thread_message = nil
  wait.status = channel_try_dequeue_native(
    wait.channel, ffi.titan_thread_channel_waiter(wait), target, message)
  wait.message = message
  if wait.status == 1 then return 1 end
  return 0
end

local foreign function channel_unregister_receive_wait(context: *void)
  local wait = context as *titan_thread_channel_wait
  channel_unregister_underflow_waiter(wait.channel, ffi.titan_thread_channel_waiter(wait))
end

-- gc.finalizable erases its callback to `function (value): ()`. Declaring the
-- finalizers with exactly that type and selecting `<|value|>` installs these
-- closures themselves as the shared metatable's `__gc`; a concrete endpoint
-- parameter would need a fresh callable-adjustment wrapper per construction.
local function sender_finalize(candidate: value)
  const self: Sender<|value|> = candidate
  const ch = self.native
  self.native = nil
  if ch ~= nil then
    channel_release_sender_native(ch)
  end
end

local function receiver_finalize(candidate: value)
  const self: Receiver<|value|> = candidate
  const ch = self.native
  self.native = nil
  if ch ~= nil then
    channel_release_receiver_native(ch)
  end
end

local function new_sender<|T|>(): Sender<|T|>
  const tx = Sender<|T|> { native = nil }
  gc.finalizable<|value|>(tx, sender_finalize)
  return tx
end

local function new_receiver<|T|>(): Receiver<|T|>
  const rx = Receiver<|T|> { native = nil }
  gc.finalizable<|value|>(rx, receiver_finalize)
  return rx
end

-- Exact fixed callables for transfer's registered nominal capability. Private
-- native fields stay under the generated typed accessors in this module.
local function sender_resource(candidate: value): foreign *void
  const tx: Sender<|value|> = candidate
  return tx.native as foreign *void
end

local function receiver_resource(candidate: value): foreign *void
  const rx: Receiver<|value|> = candidate
  return rx.native as foreign *void
end

local function sender_from_resource(context: value, data: foreign const *void,
    length: integer): value
  const tx = new_sender<|value|>()
  tx.native = transfer.claim_registered_resource(
      context, data, length, channel_release_sender_native) as foreign *titan_thread_channel
  return tx
end

local function receiver_from_resource(context: value, data: foreign const *void,
    length: integer): value
  const rx = new_receiver<|value|>()
  rx.native = transfer.claim_registered_resource(
      context, data, length, channel_release_receiver_native) as foreign *titan_thread_channel
  return rx
end

local function register_channel_resources()
  transfer.register_resource(new_sender<|value|>(), sender_resource,
      channel_retain_sender_native, channel_release_sender_native, sender_from_resource)
  transfer.register_resource(new_receiver<|value|>(), receiver_resource,
      channel_retain_receiver_native, channel_release_receiver_native, receiver_from_resource)
end

--- Create a bounded cross-thread channel pair.
-- @param capacity Maximum buffered messages before send suspends; defaults to 1.
-- @return Paired Sender and Receiver endpoints sharing the channel.
-- @usage standard-library-thread.md
function channel<|T|>(capacity: integer?): (Sender<|T|>, Receiver<|T|>)
  const cap = capacity or 1
  if cap < 1 then
    raise "channel capacity must be positive"
  end
  const tx = new_sender<|T|>()
  const rx = new_receiver<|T|>()
  const mutex = uv.mutex_t.create_native()
  const ch = channel_new_native(cap as foreign size_t, mutex)
  if ch == nil then
    raise "thread: out of memory allocating channel"
  end
  tx.native = ch
  rx.native = ch
  return tx, rx
end

--- Send a message through the channel, suspending the current Task only when the buffer is full.
-- @param message Value to transfer into the channel buffer.
-- @usage standard-library-thread.md
function Sender:send(message: T)
  -- The native cell owns the packet even when registration commits inline and
  -- cancellation wins delivery. No mutable local is captured on either path.
  -- Every access goes through the pointer: a by-value automatic aggregate read
  -- by the defer would get a setjmp spill whose recovery reload restores stale
  -- bytes over the C registrar's packet commit.
  local wait_storage = foreign titan_thread_channel_wait.new()
  const wait: foreign *titan_thread_channel_wait = wait_storage
  wait.channel = self.native
  wait.message = value_to_thread_message(message as value)
  defer if wait.message ~= nil then thread_message_discard(wait.message) end
  -- The first attempt is the plain fast check; each retry follows a wake and
  -- acknowledges it under the channel lock.
  local fast = channel_try_enqueue_native(wait.channel, wait.message, nil, nil)
  while true do
    if fast == 0 then
      wait.message = nil
      return
    elseif fast == 2 then
      raise "channel is closed"
    end
    async.wait_external_native(self, wait,
      channel_register_send_wait, channel_unregister_send_wait)
    if wait.message == nil then
      return
    elseif wait.status == 2 then
      raise "channel is closed"
    end
    fast = channel_retry_enqueue_native(
      wait.channel, wait.message, ffi.titan_thread_channel_waiter(wait))
  end
end

--- Attempt to send a message without blocking.
-- @param message Value to transfer if buffer space is immediately available.
-- @return True if enqueued; false if the channel buffer is currently full.
-- @usage standard-library-thread.md
function Sender:try_send(message: T): boolean
  local msg: foreign *titan_thread_message = value_to_thread_message(message as value)
  defer if msg ~= nil then thread_message_discard(msg) end
  const rc = channel_try_enqueue_native(self.native, msg, nil, nil)
  if rc == 0 then
    msg = nil
    return true
  elseif rc == 2 then
    raise "channel is closed"
  else
    return false
  end
end

--- Close the channel for sending while preserving already-buffered messages for receivers.
-- @usage standard-library-thread.md
function Sender:close()
  channel_close_sender_native(self.native)
end

--- Report whether the channel has been closed.
-- @return True once closed by a sender or receiver or when all peers have been dropped.
-- @usage standard-library-thread.md
function Sender:is_closed(): boolean
  return channel_is_closed_native(self.native) ~= 0
end

--- Create a new local Sender handle sharing the same underlying channel.
-- @return Cloned Sender endpoint.
-- @usage standard-library-thread.md
function Sender:clone(): Sender<|T|>
  const tx = new_sender<|T|>()
  channel_retain_sender_native(self.native)
  tx.native = self.native
  return tx
end

--- Attach a retained sender reference to the current transfer packet.
-- @return Serialized transfer payload bytes.
-- @usage standard-library-thread.md
function Sender:to_transfer_payload(): string
  return transfer.attach_resource(
    self.native as foreign *void,
    channel_retain_sender_native,
    channel_release_sender_native)
end

--- Reconstruct a Sender endpoint adopting the sender reference retained by to_transfer_payload.
-- @param payload Serialized transfer payload bytes.
-- @return Reconstructed Sender endpoint.
-- @usage standard-library-thread.md
function Sender.from_transfer_payload(payload: string): Sender<|T|>
  const tx = new_sender<|T|>()
  tx.native = transfer.claim_resource(payload, channel_release_sender_native)
    as foreign *titan_thread_channel
  return tx
end

local function Receiver:dequeue_or_wait(): (boolean, foreign *void)
  local wait_storage = foreign titan_thread_channel_wait.new()
  const wait: foreign *titan_thread_channel_wait = wait_storage
  wait.channel = self.native
  -- The first attempt is the plain fast check; each retry follows a wake and
  -- acknowledges it under the channel lock.
  local fast_msg: foreign *titan_thread_message = nil
  local fast = channel_try_dequeue_native(wait.channel, nil, nil, fast_msg)
  while true do
    if fast == 0 then
      return true, fast_msg
    elseif fast == 2 then
      return false, nil
    end
    do
      -- Only the waiting step enters this protected boundary. Access through
      -- the pointer keeps the registrar's committed packet visible on unwind.
      defer if wait.message ~= nil then thread_message_discard(wait.message) end
      async.wait_external_native(self, wait,
        channel_register_receive_wait, channel_unregister_receive_wait)
      if wait.status == 0 then
        const msg = wait.message
        wait.message = nil
        return true, msg
      elseif wait.status == 2 then
        return false, nil
      end
    end
    fast = channel_retry_dequeue_native(
      wait.channel, ffi.titan_thread_channel_waiter(wait), fast_msg)
  end
end

--- Receive the next message from the channel, suspending when empty and raising if closed and drained.
-- @return Next message from the channel.
-- @usage standard-library-thread.md
function Receiver:receive(): T
  local ok, raw = self:dequeue_or_wait()
  defer thread_message_discard(raw)
  if not ok then
    raise "channel is closed"
  end
  return transfer.decode_message(raw) as T
end

--- Receive the next message or a closed status without raising on clean stream completion.
-- @return ReceiveResult.message(value) or ReceiveResult.closed().
-- @usage standard-library-thread.md
function Receiver:receive_result(): ReceiveResult<|T|>
  local ok, raw = self:dequeue_or_wait()
  defer thread_message_discard(raw)
  if not ok then
    return ReceiveResult<|T|>.closed()
  end
  return ReceiveResult<|T|>.message(transfer.decode_message(raw) as T)
end

--- Attempt to receive a buffered message without blocking.
-- @return True and the message when available; false and nil when currently empty.
-- @usage standard-library-thread.md
function Receiver:try_receive(): (boolean, T?)
  local msg: foreign *titan_thread_message = nil
  const status = channel_try_dequeue_native(self.native, nil, nil, msg)
  local raw: foreign *void = msg
  defer thread_message_discard(raw)
  if status == 0 then
    return true, transfer.decode_message(raw) as T
  end
  return false, nil
end

--- Return a generic-for iterator triple that yields a true continuation and each message until closed and drained.
-- @return Iterator function, this Receiver state, and nil control variable.
-- @usage standard-library-thread.md
function Receiver:incoming(): (function (Receiver<|T|>, boolean?): (boolean?, T?), Receiver<|T|>, nil)
  return function (rx: Receiver<|T|>, _: boolean?): (boolean?, T?)
    local ok, raw = rx:dequeue_or_wait()
    defer thread_message_discard(raw)
    if not ok then
      return nil, nil
    end
    return true, transfer.decode_message(raw) as T
  end, self, nil
end

--- Close the channel from the consumer side and discard any unread buffered messages.
-- @usage standard-library-thread.md
function Receiver:close()
  channel_close_receiver_native(self.native)
end

--- Report whether the channel has been closed.
-- @return True once closed by a sender or receiver or when all peers have been dropped.
-- @usage standard-library-thread.md
function Receiver:is_closed(): boolean
  return channel_is_closed_native(self.native) ~= 0
end

--- Create a new local Receiver handle sharing the same underlying channel.
-- @return Cloned Receiver endpoint.
-- @usage standard-library-thread.md
function Receiver:clone(): Receiver<|T|>
  const rx = new_receiver<|T|>()
  channel_retain_receiver_native(self.native)
  rx.native = self.native
  return rx
end

--- Attach a retained receiver reference to the current transfer packet.
-- @return Serialized transfer payload bytes.
-- @usage standard-library-thread.md
function Receiver:to_transfer_payload(): string
  return transfer.attach_resource(
    self.native as foreign *void,
    channel_retain_receiver_native,
    channel_release_receiver_native)
end

--- Reconstruct a Receiver endpoint adopting the receiver reference retained by to_transfer_payload.
-- @param payload Serialized transfer payload bytes.
-- @return Reconstructed Receiver endpoint.
-- @usage standard-library-thread.md
function Receiver.from_transfer_payload(payload: string): Receiver<|T|>
  const rx = new_receiver<|T|>()
  rx.native = transfer.claim_resource(payload, channel_release_receiver_native)
    as foreign *titan_thread_channel
  return rx
end
