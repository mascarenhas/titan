--- Stream Interfaces, printing, owned line iteration, and shell-command streams.
-- @module titan.io
-- @usage standard-library-io.md

local os = import "os.titan"
local string = import "string"

--- Readable binary stream with chunk and delimiter reads.
-- @usage standard-library-io.md
interface Reader
  --- Read one binary chunk; an empty string is data and nil ends input.
  -- @return Next chunk, or nil at EOF.
  -- @usage standard-library-io.md
  function read(): string?
  --- Read through a nonempty binary delimiter across chunk boundaries.
  -- @param delimiter Delimiter bytes.
  -- @param chop True removes the delimiter from the result.
  -- @return Delimited bytes or final suffix, or nil at EOF.
  -- @usage standard-library-io.md
  function read_until(delimiter: string, chop: boolean?): string?
end

--- Binary stream accepting complete byte strings.
-- @usage standard-library-io.md
interface Writer
  --- Write all supplied bytes to the stream.
  -- @param data Complete binary string to write.
  -- @usage standard-library-io.md
  function write(data: string)
end

-- Every later close call is safe. A successful or otherwise terminal close
-- becomes a no-op; after a pre-commit failure, a concrete resource may retry.
--- Resource whose terminal close can safely be repeated.
-- @usage standard-library-io.md
interface Closer
  --- Retire the resource; later terminal closes are safe.
  -- @usage standard-library-io.md
  function close()
end

--- Bidirectional binary stream without close ownership.
-- @usage standard-library-io.md
interface ReaderWriter
  --- Read one binary chunk; an empty string is data and nil ends input.
  -- @return Next chunk, or nil at EOF.
  -- @usage standard-library-io.md
  function read(): string?
  --- Read through a nonempty binary delimiter across chunk boundaries.
  -- @param delimiter Delimiter bytes.
  -- @param chop True removes the delimiter from the result.
  -- @return Delimited bytes or final suffix, or nil at EOF.
  -- @usage standard-library-io.md
  function read_until(delimiter: string, chop: boolean?): string?
  --- Write all supplied bytes to the stream.
  -- @param data Complete binary string to write.
  -- @usage standard-library-io.md
  function write(data: string)
end

-- After close reaches its terminal state, both read operations return nil.
--- Readable stream with explicit close ownership; terminal reads return nil.
-- @usage standard-library-io.md
interface ReaderCloser
  --- Read one binary chunk; an empty string is data and nil ends input.
  -- @return Next chunk, or nil at EOF.
  -- @usage standard-library-io.md
  function read(): string?
  --- Read through a nonempty binary delimiter across chunk boundaries.
  -- @param delimiter Delimiter bytes.
  -- @param chop True removes the delimiter from the result.
  -- @return Delimited bytes or final suffix, or nil at EOF.
  -- @usage standard-library-io.md
  function read_until(delimiter: string, chop: boolean?): string?
  --- Retire the resource; later terminal closes are safe.
  -- @usage standard-library-io.md
  function close()
end

--- Writable stream with explicit close ownership.
-- @usage standard-library-io.md
interface WriterCloser
  --- Write all supplied bytes to the stream.
  -- @param data Complete binary string to write.
  -- @usage standard-library-io.md
  function write(data: string)
  --- Retire the resource; later terminal closes are safe.
  -- @usage standard-library-io.md
  function close()
end

-- After close reaches its terminal state, both read operations return nil.
--- Bidirectional binary stream with explicit close ownership; terminal reads return nil.
-- @usage standard-library-io.md
interface ReaderWriterCloser
  --- Read one binary chunk; an empty string is data and nil ends input.
  -- @return Next chunk, or nil at EOF.
  -- @usage standard-library-io.md
  function read(): string?
  --- Read through a nonempty binary delimiter across chunk boundaries.
  -- @param delimiter Delimiter bytes.
  -- @param chop True removes the delimiter from the result.
  -- @return Delimited bytes or final suffix, or nil at EOF.
  -- @usage standard-library-io.md
  function read_until(delimiter: string, chop: boolean?): string?
  --- Write all supplied bytes to the stream.
  -- @param data Complete binary string to write.
  -- @usage standard-library-io.md
  function write(data: string)
  --- Retire the resource; later terminal closes are safe.
  -- @usage standard-library-io.md
  function close()
end

--- Owned shell-process stream exposing stdin and merged stdout/stderr.
-- @usage standard-library-io.md
record InputOutputStream
  local process: os.Process
  local input: os.OutputStream
  local output: os.InputStream
  local status: os.ExitStatus?
  local closed: boolean
end

--- Write tab-separated Lua-rendered values and a newline to os.stdout in one write.
-- @param ... Values rendered with string.tostring; the write may suspend.
-- @usage standard-library-io.md
function print(...: value)
  local builder = string.writer()
  local index = 1
  while index <= #... do
    local rendered = string.tostring(...[index])
    local separator = ""
    if index > 1 then separator = "\t" end
    builder:write(separator .. rendered)
    index = index + 1
  end
  builder:write("\n")
  os.stdout:write(builder:drain())
end

local function close_reader(reader: ReaderCloser)
  reader:close()
end

local function next_line(reader: ReaderCloser): string?
  local line: string? = reader:read_until("\n", true)
  if not line then reader:close() end
  return line
end

--- Iterate newline-delimited lines and transfer Reader close ownership to the loop.
-- @param reader Reader closed after exhaustion, break, return, or error.
-- @return Generic-for iterator tuple returning lines with newline delimiters removed.
-- @usage standard-library-io.md
function lines(reader: ReaderCloser):
    (function (ReaderCloser): (string?), ReaderCloser, nil,
     function (ReaderCloser): ())
  return next_line, reader, nil, close_reader
end

--- Read a chunk of merged shell stdout and stderr.
-- @return Bytes, or nil at EOF or after terminal close.
-- @usage standard-library-io.md
function InputOutputStream:read(): string?
  if self.closed then return nil end
  return self.output:read()
end

--- Read merged shell output through a binary delimiter.
-- @param delimiter Nonempty delimiter, matched across chunks.
-- @param chop True removes the delimiter.
-- @return Bytes or final suffix, or nil at EOF or after terminal close.
-- @usage standard-library-io.md
function InputOutputStream:read_until(delimiter: string,
                                      chop: boolean?): string?
  if self.closed then return nil end
  return self.output:read_until(delimiter, chop)
end

--- Write all bytes to the shell process stdin.
-- @param data Binary bytes to send.
-- @usage standard-library-io.md
function InputOutputStream:write(data: string)
  self.input:write(data)
end

--- Wait for and cache the shell process terminal status.
-- @return Process exit code and signal information.
-- @usage standard-library-io.md
function InputOutputStream:wait(): os.ExitStatus
  if self.status then return self.status as os.ExitStatus end
  local status = self.process:wait()
  self.status = status
  return status
end

--- Close streams and terminate and wait for the shell process if still running.
-- @usage standard-library-io.md
function InputOutputStream:close()
  if self.closed then return end
  self.input:close()
  local process_cleanup_complete = false
  defer do
    self.output:close()
    if process_cleanup_complete then self.closed = true end
  end
  if not self.status and self.process:is_running() then
    self.process:kill("term")
    self:wait()
  end
  process_cleanup_complete = true
end

--- Run a command with platform shell syntax and capture stdin plus merged output.
-- @param command Shell command; /bin/sh on Unix, system cmd.exe on Windows.
-- @return Owned stream; drain output before waiting when pipe capacity can matter.
-- @usage standard-library-io.md
function popen(command: string): InputOutputStream
  local process = os.spawn_shell(command)
  local input? = process.stdin
  local output? = process.stdout
  if not input or not output then
    raise "internal popen spawn did not capture its streams"
  end
  return InputOutputStream {
    process = process,
    input = input as os.OutputStream,
    output = output as os.InputStream,
    status = nil,
    closed = false,
  }
end
