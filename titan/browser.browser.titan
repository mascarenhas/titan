local gc = import "gc"

foreign import "stdio.h"
foreign import "stdlib.h"
foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"
foreign import "titan/browser.h"

foreign type InvokeEntry =
    function(
        *lua_State, *Udata, *CClosure,
        uint64_t, uint32_t, uint32_t, uint32_t, uint32_t,
        const *titan_browser_value): void

foreign type ReleaseEntry =
    function(
        *lua_State, *Udata, *CClosure,
        uint64_t, uint32_t, uint32_t, uint32_t, uint32_t): void

--- A state-owned reference to an arbitrary JavaScript value, including nil-like, falsy, and function values.
-- @usage standard-library-browser.md#javascript-values
record BrowserHandle
  local state: foreign uint32_t
  local slot: foreign uint32_t
  local generation: foreign uint32_t
end

--- One host request or listener; cancellation is not physical retirement.
-- @usage standard-library-browser.md#requests-and-listeners
record BrowserRequest
  local state: foreign uint32_t
  local slot: foreign uint32_t
  local generation: foreign uint32_t
end

--- A normally returned JavaScript exception, raised only after the import returns.
-- @field message Copied diagnostic text.
-- @field thrown Retained exact thrown JavaScript value.
-- @usage standard-library-browser.md#errors
record BrowserError
  const message: string
  const thrown: BrowserHandle
end

--- The marshalled in-process JavaScript boundary value carrier.
-- @usage standard-library-browser.md#public-surface-and-marshalling
union BrowserValue
  is_nil()
  is_boolean(boolean)
  is_integer(integer)
  is_float(float)
  is_string(string)
  is_bytes(string)
  is_handle(BrowserHandle)
  is_callable(function (...: BrowserValue): BrowserValue)
end

local type Callable = function (...: BrowserValue): BrowserValue

local record Pin
  slot: integer
  generation: integer
  callback: Callable
  wrapper_live: boolean
  holds: integer
end

local record ProvisionalPin
  pin: Pin?
  wrapper: boolean
end

local pins_by_slot: {Pin} = {}
local pins_by_fn: {value: Pin} = {}
-- Pre-sized at module init and pre-grown in allocate_pin so pin retirement
-- and invoke_work rollback never reallocate the Array or table.
local free_slots: {integer} = { 0, 0, 0, 0, 0, 0, 0, 0 }
local slot_generations: {integer} = {}
local next_slot: integer = 1
local invoke_provisional_item = ProvisionalPin { pin = nil, wrapper = true }
-- Reserve the reusable rollback slot before any invoke can fail.
local invoke_provisioned: {ProvisionalPin} = { ProvisionalPin { pin = nil, wrapper = true } }
local fallback_completion: owned *titan_browser_completion =
    foreign titan_browser_completion.new()
local fallback_message = "not enough memory"
local state_record: owned *titan_browser_state_record =
    foreign titan_browser_state_record.new()
local invoke_handler: (function (foreign uint64_t, foreign uint32_t, foreign uint32_t,
    foreign uint32_t, foreign uint32_t, foreign const *titan_browser_value): ())?
local release_handler: (function (foreign uint64_t, foreign uint32_t, foreign uint32_t,
    foreign uint32_t, foreign uint32_t): ())?
-- Driver state: only the launcher's owner state drives (is_owner), one drive
-- at a time, and deliver() never nests or relinquishes.
local owner_state = false
local drive_active = false
local delivering = false

local foreign function mark_closing(state: *titan_browser_state_record)
  if state ~= nil then
    if state.closing == 0 then
      state.closing = 1
      state.configured = 0
      if state.token ~= 0 then
        ffi.titan_browser_host_state_closing(state.token)
      end
    end
  end
end

local function state_finalize(candidate: value)
  local state: owned *titan_browser_state_record = candidate
  if state.token == 0 then
    return
  end
  local token = state.token
  mark_closing(state)
  state.token = 0
  ffi.titan_browser_host_state_closed(token)
end

local function state_closing(): boolean
  local current: foreign *titan_browser_state_record = state_record
  if current.token == 0 then
    return true
  end
  if current.closing == 0 and ffi.titan_state_closing(L) ~= 0 then
    mark_closing(current)
  end
  return current.closing ~= 0
end

local function current_state(): foreign uint32_t
  local current: foreign *titan_browser_state_record = state_record
  if current.token == 0 then
    raise "browser state is closed"
  end
  if current.closing == 0 and ffi.titan_state_closing(L) ~= 0 then
    mark_closing(current)
  end
  return current.token
end

local function response_dispose(response: foreign *titan_browser_response)
  if response.value.kind == ffi.TITAN_BROWSER_STRING or
     response.value.kind == ffi.TITAN_BROWSER_BYTES then
    ffi.free(ffi.lmacro_unconst(response.value.bytes))
  end
  if (response.value.kind == ffi.TITAN_BROWSER_HANDLE or
      response.value.kind == ffi.TITAN_BROWSER_REQUEST) and
     response.value.slot ~= 0 then
    ffi.titan_browser_host_release(
        response.state, response.value.slot, response.value.generation)
  end
  if response.thrown_slot ~= 0 then
    ffi.titan_browser_host_release(
        response.state, response.thrown_slot, response.thrown_generation)
  end
  ffi.free(ffi.lmacro_unconst(response.message))
end

-- A queued item delivered inside a drive settles through host_settle: its
-- containing entry still owns the one ordinary completion.
local function flush_completion(completion: foreign *titan_browser_completion,
                                queued: boolean)
  local out = ffi.fflush(ffi.stdout)
  local err = ffi.fflush(ffi.stderr)
  if completion.status == ffi.TITAN_BROWSER_OK and (out ~= 0 or err ~= 0) then
    local message = out ~= 0 and
        "cannot flush browser stdout" or "cannot flush browser stderr"
    completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
    completion.application_status = 1
    completion.message = message as foreign const *unsigned char
    completion.message_length = #message
  end
  if queued then
    ffi.titan_browser_host_settle(completion)
  else
    ffi.titan_browser_complete(completion)
  end
end

function BrowserHandle:close()
  local slot = self.slot
  if slot ~= 0 then
    if state_record.token == 0 and state_record.closing ~= 0 then
      self.slot = 0
      return
    end
    -- Detect an independent state's close phase before its first import too.
    current_state()
    self.slot = 0
    ffi.titan_browser_host_release(self.state, slot, self.generation)
  end
end

local function handle_finalize(candidate: value)
  local self: BrowserHandle = candidate
  self:close()
end

local function new_handle(slot: integer, generation: integer): BrowserHandle
  if slot == 0 or generation == 0 then raise "browser handle identity is absent" end
  local state = current_state()
  local owner = BrowserHandle { state = state, slot = 0, generation = 0 }
  gc.finalizable<|value|>(owner, handle_finalize)
  if ffi.titan_browser_host_identity_live(state, slot, generation,
      ffi.TITAN_BROWSER_HANDLE as foreign uint32_t) == 0 then
    raise "browser handle is released or belongs to a closed state"
  end
  owner.slot = slot
  owner.generation = generation
  ffi.titan_browser_host_adopt(state, owner.slot, owner.generation)
  return owner
end

function BrowserRequest:close()
  local slot = self.slot
  if slot ~= 0 then
    if state_record.token == 0 and state_record.closing ~= 0 then
      self.slot = 0
      return
    end
    current_state()
    self.slot = 0
    ffi.titan_browser_host_release(self.state, slot, self.generation)
  end
end

function BrowserError:close()
  self.thrown:close()
end

-- Audited stack transaction: copies counted C bytes into a Titan string.
local function copied_bytes(bytes: foreign const *unsigned char, length: foreign uint32_t): string
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then raise "cannot reserve browser byte result" end
  local ptr: foreign const *char = ""
  if length ~= 0 then ptr = bytes as foreign const *char end
  ffi.lua_pushlstring(L, ptr, length as foreign size_t)
  local result: value = ffi.lua_totvalue(L, -1)
  return result
end

local function check_utf8(text: string)
  local input = text as foreign const *unsigned char
  local remaining = 0
  local lower = 128
  local upper = 191
  for index = 0, #text - 1 do
    local byte: integer = input[index]
    if remaining > 0 then
      if byte < lower or byte > upper then raise "browser string is not valid UTF-8" end
      remaining = remaining - 1
      lower = 128
      upper = 191
    elseif byte < 128 then
      -- ASCII (including NUL) is valid UTF-8.
    elseif byte >= 194 and byte <= 223 then
      remaining = 1
    elseif byte >= 224 and byte <= 239 then
      remaining = 2
      if byte == 224 then lower = 160 end
      if byte == 237 then upper = 159 end
    elseif byte >= 240 and byte <= 244 then
      remaining = 3
      if byte == 240 then lower = 144 end
      if byte == 244 then upper = 143 end
    else
      raise "browser string is not valid UTF-8"
    end
  end
  if remaining ~= 0 then raise "browser string is not valid UTF-8" end
end

local function allocate_pin(callback: Callable): Pin
  local slot = 0
  local generation = 0
  local free_index = #free_slots
  while free_index > 0 do
    local candidate = free_slots[free_index]
    local previous = slot_generations[candidate]
    if previous < 0xffffffff then
      slot = candidate
      generation = previous + 1
      break
    end
    free_slots[free_index] = nil
    free_index = free_index - 1
  end
  if slot == 0 then
    if next_slot > 0xffffffff then raise "browser callable slot identity exhausted" end
    slot = next_slot
    generation = 1
  end
  local pin = Pin {
    slot = slot,
    generation = generation,
    callback = callback,
    wrapper_live = false,
    holds = 0,
  }
  pins_by_fn[callback] = pin
  do
    pins_by_slot[slot] = pin
    slot_generations[slot] = generation
    if free_index == 0 then
      -- Pre-grow free_slots capacity for this new slot inside the protected
      -- allocation step so later retirement never reallocates.
      free_slots[slot] = 0
      free_slots[slot] = nil
    end
  catch
    pins_by_fn[callback] = nil
    pins_by_slot[slot] = nil
    raise
  end
  if free_index > 0 then
    free_slots[free_index] = nil
  else
    next_slot = slot + 1
  end
  return pin
end

local function Pin:retire_if_unused()
  if not self.wrapper_live and self.holds <= 0 then
    if pins_by_slot[self.slot] == self then
      pins_by_slot[self.slot] = nil
      pins_by_fn[self.callback] = nil
      free_slots[#free_slots + 1] = self.slot
    end
  end
end

local function pin_wrapper(callback: Callable, state: foreign uint32_t,
                           provisioned: {ProvisionalPin},
                           reusable_entry: ProvisionalPin?): Pin
  if state_closing() then raise "browser state is closing" end
  local entry = reusable_entry or ProvisionalPin { pin = nil, wrapper = true }
  entry.pin = nil
  entry.wrapper = true
  local index = #provisioned + 1
  provisioned[index] = entry
  local existing? = pins_by_fn[callback]
  local pin: Pin = existing or allocate_pin(callback)
  local created = ffi.titan_browser_host_callable(state, pin.slot, pin.generation) ~= 0
  if not pin.wrapper_live or created then
    entry.pin = pin
    pin.wrapper_live = true
  else
    provisioned[index] = nil
  end
  return pin
end

local function pin_request_hold(callback: Callable,
                                provisioned: {ProvisionalPin}): Pin
  local entry = ProvisionalPin { pin = nil, wrapper = false }
  local index = #provisioned + 1
  provisioned[index] = entry
  local existing? = pins_by_fn[callback]
  local pin: Pin = existing or allocate_pin(callback)
  entry.pin = pin
  pin.holds = pin.holds + 1
  return pin
end

local function rollback_provisioned(state: foreign uint32_t,
                                    provisioned: {ProvisionalPin})
  for index = #provisioned, 1, -1 do
    local item = provisioned[index]
    provisioned[index] = nil
    local pin? = item.pin
    if pin ~= nil then
      item.pin = nil
      if item.wrapper then
        if ffi.titan_browser_host_callable_closed(state, pin.slot, pin.generation) ~= 0 then
          pin.wrapper_live = false
        end
      else
        pin.holds = pin.holds - 1
      end
      pin:retire_if_unused()
    end
  end
end

local function check_response(response: foreign *titan_browser_response)
  if response.status ~= ffi.TITAN_BROWSER_OK then
    local message = copied_bytes(response.message, response.message_length)
    if response.thrown_slot == 0 or response.thrown_generation == 0 then
      if message == "" then
        if response.status == ffi.TITAN_BROWSER_MEMORY then
          raise "not enough memory for browser error"
        end
        raise "JavaScript binding failed without a thrown-value owner"
      end
      raise message
    end
    local thrown = new_handle(response.thrown_slot, response.thrown_generation)
    response.thrown_slot = 0
    response.thrown_generation = 0
    raise BrowserError(message, thrown)
  end
end

local function adopt_handle(response: foreign *titan_browser_response): BrowserHandle
  local owner = new_handle(response.value.slot, response.value.generation)
  response.value.slot = 0
  return owner
end

local function BrowserHandle:checked_state(): foreign uint32_t
  if self.slot == 0 then raise "browser handle is closed" end
  local state = current_state()
  if self.state ~= state then raise "browser handle belongs to another state" end
  return state
end

local function encode_value(item: BrowserValue, state: foreign uint32_t,
                            slot: foreign *titan_browser_value,
                            provisioned: {ProvisionalPin},
                            reusable_entry: ProvisionalPin?)
  case item
  when is_nil() then
    slot.kind = ffi.TITAN_BROWSER_NIL as foreign uint32_t
  when is_boolean(flag) then
    slot.kind = ffi.TITAN_BROWSER_BOOLEAN as foreign uint32_t
    if flag then slot.scalar.integer = 1 else slot.scalar.integer = 0 end
  when is_integer(number) then
    slot.kind = ffi.TITAN_BROWSER_INTEGER as foreign uint32_t
    slot.scalar.integer = number
  when is_float(number) then
    slot.kind = ffi.TITAN_BROWSER_FLOAT as foreign uint32_t
    slot.scalar.number = number
  when is_string(text) then
    check_utf8(text)
    slot.kind = ffi.TITAN_BROWSER_STRING as foreign uint32_t
    slot.bytes = text as foreign const *unsigned char
    slot.length = #text
  when is_bytes(bytes) then
    slot.kind = ffi.TITAN_BROWSER_BYTES as foreign uint32_t
    slot.bytes = bytes as foreign const *unsigned char
    slot.length = #bytes
  when is_handle(handle) then
    if handle.slot == 0 or handle.state ~= state then
      raise "browser handle is closed or belongs to another state"
    end
    slot.kind = ffi.TITAN_BROWSER_HANDLE as foreign uint32_t
    slot.state = state
    slot.slot = handle.slot
    slot.generation = handle.generation
  when is_callable(callback) then
    local pin = pin_wrapper(callback, state, provisioned, reusable_entry)
    slot.kind = ffi.TITAN_BROWSER_CALLABLE as foreign uint32_t
    slot.state = state
    slot.slot = pin.slot
    slot.generation = pin.generation
  end
end

local function decode_value(raw: foreign const *titan_browser_value,
                            state: foreign uint32_t,
                            from_response: boolean): BrowserValue
  local kind = raw.kind
  if kind == ffi.TITAN_BROWSER_NIL then
    return BrowserValue.is_nil()
  elseif kind == ffi.TITAN_BROWSER_BOOLEAN then
    if raw.scalar.integer ~= 0 and raw.scalar.integer ~= 1 then
      raise "browser boolean must be true or false"
    end
    return BrowserValue.is_boolean(raw.scalar.integer ~= 0)
  elseif kind == ffi.TITAN_BROWSER_INTEGER then
    return BrowserValue.is_integer(raw.scalar.integer)
  elseif kind == ffi.TITAN_BROWSER_FLOAT then
    return BrowserValue.is_float(raw.scalar.number)
  elseif kind == ffi.TITAN_BROWSER_STRING or kind == ffi.TITAN_BROWSER_BYTES then
    if from_response then
      local capacity: integer = raw.scalar.integer
      if capacity < 0 or raw.length > capacity then
        raise "invalid browser byte result length or capacity"
      end
    else
      if raw.length ~= 0 and raw.bytes == nil then
        raise "browser byte argument has no storage"
      end
    end
    local bytes = copied_bytes(raw.bytes, raw.length)
    if kind == ffi.TITAN_BROWSER_STRING then
      return BrowserValue.is_string(bytes)
    end
    return BrowserValue.is_bytes(bytes)
  elseif kind == ffi.TITAN_BROWSER_HANDLE then
    if raw.state ~= state or raw.slot == 0 or raw.generation == 0 then
      raise "browser handle belongs to another or retired state"
    end
    return BrowserValue.is_handle(new_handle(raw.slot, raw.generation))
  elseif kind == ffi.TITAN_BROWSER_CALLABLE then
    if raw.state ~= state or raw.slot == 0 or raw.generation == 0 then
      raise "browser callable belongs to another or retired state"
    end
    local pin? = pins_by_slot[raw.slot]
    if pin == nil or pin.generation ~= raw.generation then
      raise "browser callable is released"
    end
    return BrowserValue.is_callable(pin.callback)
  end
  raise "unsupported browser value kind"
end

-- Audited stack transaction: formats a non-string error object with __tostring
-- or `(error object is a <type> value)`.
local function format_error_value(err: value): string
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 4) == 0 then raise "cannot reserve browser error stack" end
  ffi.lua_pushtvalue(L, err)
  local idx = top + 1
  if ffi.luaL_callmeta(L, idx, "__tostring") == 0 or
     ffi.lua_type(L, -1) ~= ffi.LUA_TSTRING then
    local typename = ffi.lua_typename(L, ffi.lua_type(L, idx))
    ffi.lua_pushfstring(L, "(error object is a %s value)", typename)
  end
  ffi.titan_unwind_clear_trace(L)
  local result: value = ffi.lua_totvalue(L, -1)
  return result
end

local function error_message(err: value): string
  if err is string then
    return err
  end
  do
    if err is integer then
      return "" .. (err as integer)
    elseif err is float then
      return "" .. (err as float)
    end
    return format_error_value(err)
  catch
    return "error while reporting browser failure"
  end
end

local function complete_titan_failure(operation_id: foreign uint64_t,
                                      operation: foreign uint32_t,
                                      err: value,
                                      trace: string,
                                      queued: boolean)
  local message = error_message(err)
  local completion = foreign titan_browser_completion.new()
  completion.operation_id = operation_id
  completion.operation = operation
  completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
  completion.application_status = 1
  completion.message = message as foreign const *unsigned char
  completion.message_length = #message
  completion.trace = trace as foreign const *unsigned char
  completion.trace_length = #trace
  flush_completion(completion, queued)
end

local function invoke_work(
    operation_id: foreign uint64_t,
    state: foreign uint32_t,
    slot: foreign uint32_t,
    generation: foreign uint32_t,
    argc: foreign uint32_t,
    args: foreign const *titan_browser_value,
    queued: boolean)
  do
    local pin? = pins_by_slot[slot]
    if pin == nil or pin.generation ~= generation then
      raise "browser callable is released"
    end
    local count: integer = argc
    local decoded: {BrowserValue} = {}
    for index = 0, count - 1 do
      decoded[index + 1] = decode_value(args + index, state, false)
    end
    for index = 0, count - 1 do
      local item = args + index
      if (item.kind == ffi.TITAN_BROWSER_HANDLE or
          item.kind == ffi.TITAN_BROWSER_CALLABLE) and
         ffi.titan_browser_host_identity_live(
             item.state, item.slot, item.generation, item.kind) == 0 then
        raise "browser identity is released or belongs to a closed state"
      end
    end
    local result = pin.callback(...decoded)
    local encoded = foreign titan_browser_value.new()
    encode_value(result, state, encoded, invoke_provisioned, invoke_provisional_item)
    -- Observe any close/GC triggered before completion (e.g. identity_gc).
    current_state()
    if (encoded.kind == ffi.TITAN_BROWSER_HANDLE or
        encoded.kind == ffi.TITAN_BROWSER_CALLABLE) and
       ffi.titan_browser_host_identity_live(
           encoded.state, encoded.slot, encoded.generation, encoded.kind) == 0 then
      raise "browser identity is released or belongs to a closed state"
    end
    local completion = foreign titan_browser_completion.new()
    completion.operation_id = operation_id
    completion.operation = ffi.TITAN_BROWSER_INVOKE as foreign uint32_t
    completion.result_count = 1
    completion.results = encoded
    flush_completion(completion, queued)
    if completion.status ~= ffi.TITAN_BROWSER_OK then
      -- Stay helper-free and non-raising after completion: a raise would emit twice.
      local prov_pin? = invoke_provisional_item.pin
      if prov_pin ~= nil then
        invoke_provisional_item.pin = nil
        invoke_provisioned[1] = nil
        if ffi.titan_browser_host_callable_closed(
               state, prov_pin.slot, prov_pin.generation) ~= 0 then
          prov_pin.wrapper_live = false
        end
        if not prov_pin.wrapper_live and prov_pin.holds <= 0 then
          if pins_by_slot[prov_pin.slot] == prov_pin then
            pins_by_slot[prov_pin.slot] = nil
            pins_by_fn[prov_pin.callback] = nil
            free_slots[#free_slots + 1] = prov_pin.slot
          end
        end
      end
    else
      invoke_provisional_item.pin = nil
      invoke_provisioned[1] = nil
    end
  catch
    local trace = traceback
    -- Stay helper-free and non-raising so rollback finishes before error reporting.
    local prov_pin? = invoke_provisional_item.pin
    if prov_pin ~= nil then
      invoke_provisional_item.pin = nil
      invoke_provisioned[1] = nil
      if ffi.titan_browser_host_callable_closed(
             state, prov_pin.slot, prov_pin.generation) ~= 0 then
        prov_pin.wrapper_live = false
      end
      if not prov_pin.wrapper_live and prov_pin.holds <= 0 then
        if pins_by_slot[prov_pin.slot] == prov_pin then
          pins_by_slot[prov_pin.slot] = nil
          pins_by_fn[prov_pin.callback] = nil
          free_slots[#free_slots + 1] = prov_pin.slot
        end
      end
    end
    complete_titan_failure(
        operation_id, ffi.TITAN_BROWSER_INVOKE as foreign uint32_t,
        error, trace, queued)
  end
end

local function invoke_entry(
    operation_id: foreign uint64_t,
    state: foreign uint32_t,
    slot: foreign uint32_t,
    generation: foreign uint32_t,
    argc: foreign uint32_t,
    args: foreign const *titan_browser_value)
  invoke_work(operation_id, state, slot, generation, argc, args, false)
catch
  -- No allocating Titan helper entry may run outside this catch boundary.
  local trace = traceback
  local message = fallback_message
  local completion: foreign *titan_browser_completion = fallback_completion
  completion.operation_id = operation_id
  completion.operation = ffi.TITAN_BROWSER_INVOKE as foreign uint32_t
  completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
  completion.application_status = 1
  completion.result_count = 0
  completion.results = nil
  completion.message = message as foreign const *unsigned char
  completion.message_length = #message
  completion.trace = trace as foreign const *unsigned char
  completion.trace_length = #trace
  ffi.fflush(ffi.stdout)
  ffi.fflush(ffi.stderr)
  ffi.titan_browser_complete(completion)
end

-- deliver()'s physical release of one wrapper (wrapper ~= 0) or request hold:
-- release_work's pin block, retiring the pin when no holder remains. Only the
-- helper's entry can raise, before any change; free_slots is pre-grown by
-- allocate_pin. release_work keeps its own copy inline (helper-free).
local function apply_release(slot: foreign uint32_t, generation: foreign uint32_t,
                              wrapper: foreign uint32_t)
  local pin? = pins_by_slot[slot]
  if pin ~= nil and pin.generation == generation then
    if wrapper ~= 0 then
      pin.wrapper_live = false
    elseif pin.holds > 0 then
      pin.holds = pin.holds - 1
    end
    if not pin.wrapper_live and pin.holds <= 0 then
      if pins_by_slot[pin.slot] == pin then
        pins_by_slot[pin.slot] = nil
        pins_by_fn[pin.callback] = nil
        free_slots[#free_slots + 1] = pin.slot
      end
    end
  end
end

local function release_work(
    operation_id: foreign uint64_t,
    state: foreign uint32_t,
    slot: foreign uint32_t,
    generation: foreign uint32_t,
    wrapper: foreign uint32_t)
  do
    -- Stay helper-free and non-raising so pin retirement cannot escape half-done.
    -- The module owns this stable storage; the native transaction only borrows it.
    local current: foreign *titan_browser_state_record = state_record
    local closing = current.token == 0
    if not closing then
      if current.closing == 0 and ffi.titan_state_closing(L) ~= 0 then
        mark_closing(current)
      end
      closing = current.closing ~= 0
    end
    if not closing then
      local pin? = pins_by_slot[slot]
      if pin ~= nil and pin.generation == generation then
        if wrapper ~= 0 then
          pin.wrapper_live = false
        elseif pin.holds > 0 then
          pin.holds = pin.holds - 1
        end
        if not pin.wrapper_live and pin.holds <= 0 then
          if pins_by_slot[pin.slot] == pin then
            pins_by_slot[pin.slot] = nil
            pins_by_fn[pin.callback] = nil
            free_slots[#free_slots + 1] = pin.slot
          end
        end
      end
    end
    local completion = foreign titan_browser_completion.new()
    completion.operation_id = operation_id
    completion.operation = ffi.TITAN_BROWSER_RELEASE as foreign uint32_t
    flush_completion(completion, false)
  catch
    local trace = traceback
    complete_titan_failure(
        operation_id, ffi.TITAN_BROWSER_RELEASE as foreign uint32_t,
        error, trace, false)
  end
end

local function release_entry(
    operation_id: foreign uint64_t,
    state: foreign uint32_t,
    slot: foreign uint32_t,
    generation: foreign uint32_t,
    wrapper: foreign uint32_t)
  release_work(operation_id, state, slot, generation, wrapper)
catch
  -- No allocating Titan helper entry may run outside this catch boundary.
  local trace = traceback
  local message = fallback_message
  local completion: foreign *titan_browser_completion = fallback_completion
  completion.operation_id = operation_id
  completion.operation = ffi.TITAN_BROWSER_RELEASE as foreign uint32_t
  completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
  completion.application_status = 1
  completion.result_count = 0
  completion.results = nil
  completion.message = message as foreign const *unsigned char
  completion.message_length = #message
  completion.trace = trace as foreign const *unsigned char
  completion.trace_length = #trace
  ffi.fflush(ffi.stdout)
  ffi.fflush(ffi.stderr)
  ffi.titan_browser_complete(completion)
end

foreign function invoke(
    raw_id: unsigned long long,
    raw_token: unsigned int,
    raw_slot: unsigned int,
    raw_generation: unsigned int,
    raw_argc: unsigned int,
    raw_args: const *void): int
  local id = raw_id as foreign uint64_t
  local token = raw_token as foreign uint32_t
  local slot = raw_slot as foreign uint32_t
  local generation = raw_generation as foreign uint32_t
  local argc = raw_argc as foreign uint32_t
  local args = raw_args as foreign const *titan_browser_value
  local op = ffi.TITAN_BROWSER_INVOKE as foreign uint32_t
  if id == 0 then
    return -1
  end
  if ffi.titan_browser_entry_allowed(id, op) == 0 then
    return -1
  end
  local state = ffi.titan_browser_host_state_record(token)
  if state == nil then
    return ffi.titan_browser_invalid_entry(id, op,
        "browser state is closed, closing or uninitialized")
  end
  local state_L = state.L
  if state.closing == 0 then
    if ffi.titan_state_closing(state_L) ~= 0 then
      mark_closing(state)
    end
  end
  if state.closing ~= 0 then
    return ffi.titan_browser_invalid_entry(id, op,
        "browser state is closed, closing or uninitialized")
  end
  if state.configured == 0 then
    return ffi.titan_browser_invalid_entry(id, op,
        "browser state is closed, closing or uninitialized")
  end
  if ffi.lua_checkstack(state_L, ffi.LUA_MINSTACK) == 0 then
    local message = "not enough memory"
    local completion = state.fallback
    completion.operation_id = id
    completion.operation = op
    completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
    completion.application_status = 1
    completion.result_count = 0
    completion.results = nil
    completion.message = message as foreign const *unsigned char
    completion.message_length = 17
    completion.trace = nil
    completion.trace_length = 0
    ffi.fflush(ffi.stdout)
    ffi.fflush(ffi.stderr)
    ffi.titan_browser_complete(completion)
    return 0
  end
  local handler = ffi.lmacro_clCvalue(state.invoke_handler)
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign InvokeEntry
  local top = ffi.lua_gettop(state_L)
  local old_errfunc = ffi.lmacro_get_errfunc(state_L)
  ffi.lua_pushcclosure(state_L, ffi.errorhandler, 0)
  ffi.lmacro_set_errfunc(state_L, ffi.lmacro_savestack_top(state_L))
  entry(state_L, module, handler, id, token, slot, generation, argc, args)
  ffi.lmacro_set_errfunc(state_L, old_errfunc)
  ffi.lua_settop(state_L, top)
  return 0
end

foreign function release_callable(
    raw_id: unsigned long long,
    raw_token: unsigned int,
    raw_slot: unsigned int,
    raw_generation: unsigned int,
    raw_wrapper: unsigned int): int
  local id = raw_id as foreign uint64_t
  local token = raw_token as foreign uint32_t
  local slot = raw_slot as foreign uint32_t
  local generation = raw_generation as foreign uint32_t
  local wrapper = raw_wrapper as foreign uint32_t
  local op = ffi.TITAN_BROWSER_RELEASE as foreign uint32_t
  if id == 0 then
    return -1
  end
  if ffi.titan_browser_entry_allowed(id, op) == 0 then
    return -1
  end
  local state = ffi.titan_browser_host_state_record(token)
  if state == nil then
    return ffi.titan_browser_invalid_entry(id, op, "browser state is closed")
  end
  if state.configured == 0 then
    return ffi.titan_browser_invalid_entry(id, op, "browser state is closed")
  end
  local state_L = state.L
  if ffi.lua_checkstack(state_L, ffi.LUA_MINSTACK) == 0 then
    local message = "not enough memory"
    local completion = state.fallback
    completion.operation_id = id
    completion.operation = op
    completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
    completion.application_status = 1
    completion.result_count = 0
    completion.results = nil
    completion.message = message as foreign const *unsigned char
    completion.message_length = 17
    completion.trace = nil
    completion.trace_length = 0
    ffi.fflush(ffi.stdout)
    ffi.fflush(ffi.stderr)
    ffi.titan_browser_complete(completion)
    return 0
  end
  local handler = ffi.lmacro_clCvalue(state.release_handler)
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign ReleaseEntry
  local top = ffi.lua_gettop(state_L)
  local old_errfunc = ffi.lmacro_get_errfunc(state_L)
  ffi.lua_pushcclosure(state_L, ffi.errorhandler, 0)
  ffi.lmacro_set_errfunc(state_L, ffi.lmacro_savestack_top(state_L))
  entry(state_L, module, handler, id, token, slot, generation, wrapper)
  ffi.lmacro_set_errfunc(state_L, old_errfunc)
  ffi.lua_settop(state_L, top)
  return 0
end

--- Look up an explicitly supplied create({bindings}) name, never a global or eval expression.
function binding(name: string): BrowserHandle
  local state = current_state()
  local response = foreign titan_browser_response.new()
  defer response_dispose(response)
  ffi.titan_browser_host_binding(
      state, name as foreign const *unsigned char, #name, response)
  check_response(response)
  return adopt_handle(response)
end

--- Call a JavaScript binding and marshal its single result by runtime type.
function BrowserHandle:call(...: BrowserValue): BrowserValue
  local state = self:checked_state()
  local count = #...
  local small = foreign titan_browser_value.new_array(8)
  local slots: foreign *titan_browser_value = small
  local extra: (owned titan_browser_value[])?
  if count > 8 then
    local buffer: owned titan_browser_value[] =
        foreign titan_browser_value.new_array(count)
    extra = buffer
    slots = buffer
  end
  local provisioned: {ProvisionalPin} = {}
  do
    for index = 1, count do
      encode_value(...[index], state, slots + (index - 1), provisioned, nil)
    end
  catch
    rollback_provisioned(state, provisioned)
    raise
  end
  local response = foreign titan_browser_response.new()
  defer response_dispose(response)
  ffi.titan_browser_host_call(
      state, self.slot, self.generation, count, slots, response)
  if response.status ~= ffi.TITAN_BROWSER_OK then
    rollback_provisioned(state, provisioned)
    check_response(response)
  end
  local result = decode_value(response.value, state, true)
  if response.value.kind == ffi.TITAN_BROWSER_HANDLE then
    response.value.slot = 0
  end
  return result
end

function BrowserRequest:cancel()
  if self.slot == 0 then return end
  local response = foreign titan_browser_response.new()
  defer response_dispose(response)
  current_state()
  ffi.titan_browser_host_cancel(self.state, self.slot, self.generation, response)
  check_response(response)
end

local function BrowserHandle:request(
    mode: foreign uint32_t,
    completion: Callable,
    failure: Callable,
    ...: BrowserValue): BrowserRequest
  local state = self:checked_state()
  if state_closing() then raise "browser state is closing" end
  local count = #...
  local small = foreign titan_browser_value.new_array(8)
  local slots: foreign *titan_browser_value = small
  local extra: (owned titan_browser_value[])?
  if count > 8 then
    local buffer: owned titan_browser_value[] =
        foreign titan_browser_value.new_array(count)
    extra = buffer
    slots = buffer
  end
  local provisioned: {ProvisionalPin} = {}
  local completion_pin: Pin?
  local failure_pin: Pin?
  do
    completion_pin = pin_request_hold(completion, provisioned)
    failure_pin = pin_request_hold(failure, provisioned)
    for index = 1, count do
      encode_value(...[index], state, slots + (index - 1), provisioned, nil)
    end
  catch
    rollback_provisioned(state, provisioned)
    raise
  end
  local response = foreign titan_browser_response.new()
  defer response_dispose(response)
  ffi.titan_browser_host_start(
      state, self.slot, self.generation, count, slots,
      completion_pin.slot,
      completion_pin.generation,
      failure_pin.slot,
      failure_pin.generation,
      mode, response)
  if response.status ~= ffi.TITAN_BROWSER_OK then
    rollback_provisioned(state, provisioned)
    check_response(response)
  end
  local owner = BrowserRequest {
    state = state,
    slot = response.value.slot,
    generation = response.value.generation,
  }
  response.value.slot = 0
  return owner
end

--- Start explicit detachable or guaranteed-terminal host work, notifying one live outcome.
function BrowserHandle:start(
    completion: function (...: BrowserValue): BrowserValue,
    failure: function (...: BrowserValue): BrowserValue,
    ...: BrowserValue): BrowserRequest
  return self:request(
      ffi.TITAN_BROWSER_START as foreign uint32_t,
      completion, failure, ...)
end

--- Subscribe to a synchronous host listener; events are queued rather than invoked inline.
function BrowserHandle:listen(
    completion: function (...: BrowserValue): BrowserValue,
    failure: function (...: BrowserValue): BrowserValue,
    ...: BrowserValue): BrowserRequest
  return self:request(
      ffi.TITAN_BROWSER_LISTEN as foreign uint32_t,
      completion, failure, ...)
end

--- Relinquish status: the drive resumed after a turn or a wake.
-- @usage standard-library-browser.md#driver-interface-low-level
const RELINQUISH_RESUMED = 0
--- Relinquish status: a wait found no wake source and returned without suspending.
-- @usage standard-library-browser.md#driver-interface-low-level
const RELINQUISH_IDLE = 1
--- Relinquish status: the instance is disposing, so the drive should cancel its work.
-- @usage standard-library-browser.md#driver-interface-low-level
const RELINQUISH_DISPOSING = 2

local function require_drive(message: string)
  if not drive_active or delivering or L ~= ffi.lmacro_mainthread(L) then raise message end
end

--- True in the Lua state that the generated launcher created as the instance owner.
-- @usage standard-library-browser.md#driver-interface-low-level
function is_owner(): boolean
  return owner_state
end

--- Begin the instance drive; only the owner state's main thread drives, once at a time.
-- @usage standard-library-browser.md#driver-interface-low-level
function drive_begin()
  if not owner_state or L ~= ffi.lmacro_mainthread(L) then
    raise "browser drive requires the instance owner's main thread"
  end
  if drive_active then raise "browser drive is already active" end
  ffi.titan_browser_host_drive_begin(current_state())
  drive_active = true
end

--- End the drive; a present exit_code latches the instance as exited with that status.
-- @usage standard-library-browser.md#driver-interface-low-level
function drive_end(exit_code: integer?)
  require_drive("browser drive_end requires the driving owner's main thread outside delivery")
  drive_active = false
  local status = 0
  if exit_code ~= nil then
    -- The low 32 bits read as a signed status, as the launcher reports main's result.
    status = exit_code & 0xffffffff
    if status > 0x7fffffff then status = status - 0x100000000 end
  end
  local token = state_record.token
  if token ~= 0 then
    ffi.titan_browser_host_drive_end(token, status, exit_code ~= nil and 1 or 0)
  end
end

--- Give the event loop back for one macrotask (wait false) or until a wake source fires (wait true); returns a RELINQUISH_ status.
-- @usage standard-library-browser.md#driver-interface-low-level
function relinquish(wait: boolean): integer
  require_drive("browser relinquish requires the driving owner's main thread outside delivery")
  -- A relinquish point hands buffered output to the sinks, C stdio included.
  ffi.fflush(ffi.stdout)
  ffi.fflush(ffi.stderr)
  local mode = ffi.TITAN_BROWSER_TURN as foreign uint32_t
  if wait then mode = ffi.TITAN_BROWSER_WAIT as foreign uint32_t end
  return ffi.titan_browser_relinquish(state_record.token, mode)
end

--- Run the host items queued for this state when the call begins, then its deferred releases.
-- @usage standard-library-browser.md#driver-interface-low-level
function deliver()
  require_drive("browser delivery requires the driving owner's main thread outside delivery")
  local token = state_record.token
  delivering = true
  defer delivering = false
  local item = foreign titan_browser_delivery.new()
  local count: integer = ffi.titan_browser_host_batch(token)
  for _ = 1, count do
    if ffi.titan_browser_host_item(token, item) == 0 then break end
    do
      invoke_work(item.id, token, item.slot, item.generation, item.argc, item.args, true)
    catch
      -- No allocating Titan helper entry may run outside this catch boundary.
      local trace = traceback
      local message = fallback_message
      local completion: foreign *titan_browser_completion = fallback_completion
      completion.operation_id = item.id
      completion.operation = ffi.TITAN_BROWSER_INVOKE as foreign uint32_t
      completion.status = ffi.TITAN_BROWSER_TITAN_ERROR as foreign uint32_t
      completion.application_status = 1
      completion.result_count = 0
      completion.results = nil
      completion.message = message as foreign const *unsigned char
      completion.message_length = #message
      completion.trace = trace as foreign const *unsigned char
      completion.trace_length = #trace
      ffi.fflush(ffi.stdout)
      ffi.fflush(ffi.stderr)
      ffi.titan_browser_host_settle(completion)
    end
    ffi.titan_browser_host_item_done(token, item.id)
  end
  while ffi.titan_browser_host_release_next(token, item) ~= 0 do
    apply_release(item.slot, item.generation, item.wrapper)
  end
end

--- Wake a relinquished drive of this instance; harmless from any state, thread or delivery.
-- @usage standard-library-browser.md#driver-interface-low-level
function wake()
  local token = state_record.token
  if token ~= 0 then ffi.titan_browser_host_wake(token) end
end

do
  local current = state_record
  gc.finalizable<|value|>(current, state_finalize)
  current.L = ffi.lmacro_mainthread(L)
  -- Clear the reservation sentinels without shrinking rollback storage.
  for index = #free_slots, 1, -1 do
    free_slots[index] = nil
  end
  invoke_provisioned[1] = nil
  local inv = invoke_entry
  local rel = release_entry
  invoke_handler = inv
  release_handler = rel
  current.invoke_handler = inv
  current.release_handler = rel
  current.fallback = fallback_completion
  current.configured = 1
  local token = ffi.titan_browser_host_state_open(current)
  if token == 0 then raise "browser state identity exhausted" end
  current.token = token
  -- Only the launcher's owner state drives; a C-created state never does.
  owner_state = ffi.titan_browser_owner_thread() == current.L
  if owner_state then ffi.titan_browser_host_owner(token) end
end
