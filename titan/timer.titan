local uv = import "uv.titan"

record Ticker
  local handle: uv.uv_timer_t
end

function sleep(milliseconds: integer)
  uv.sleep(milliseconds)
end

function yield()
  uv.yield()
end

function ticker(milliseconds: integer): Ticker
  return Ticker.new(uv.ticker(milliseconds))
end

function Ticker:tick(): boolean
  return uv.ticker_tick(self.handle)
end

function Ticker:close()
  uv.ticker_close(self.handle)
end
