--- Task-aware one-shot delays and recurring coalescing tickers.
-- @module titan.timer
-- @usage standard-library-timer.md

local async = import "async"
local uv = import "uv"

--- A Runtime-bound recurring timer that coalesces missed firings.
-- @usage standard-library-timer.md#recurring-tickers
record Ticker
  local timer: uv.timer_t
  local loop: uv.loop_t
  local subscription: async.CoalescingSubscription<|boolean, async.OperationError|>?
  local closed: boolean
  local close_done: async.Completion<|Ticker, nil, async.OperationError|>?
  local close_number: integer
end

local record Sleep
  local timer: uv.timer_t
  local task: async.Task
  local token: async.ResumeToken
  local close_done: async.Completion<|Sleep, nil, async.OperationError|>?
  local close_number: integer
end

local function operation_error(status: integer, operation: string): async.OperationError
  return async.OperationError(status, uv.err_name(status), uv.strerror(status), operation)
end

local function check_work()
  async.checkpoint()
end

local function ticker_closed(timer: uv.timer_t)
  local ticker: Ticker = uv.timer_get_data(timer)
  local done = ticker.close_done as async.Completion<|Ticker, nil, async.OperationError|>
  local number = ticker.close_number
  ticker.close_done = nil
  uv.timer_set_data(timer, nil)
  do done:resolve(number, nil)
  catch done:fatal(number, error, traceback); raise end
end

local function start_ticker_close(done: async.Completion<|Ticker, nil, async.OperationError|>, number: integer): uv.req_t?
  local ticker = done:context(number)
  ticker.close_done = done
  ticker.close_number = number
  uv.timer_set_data(ticker.timer, ticker)
  do uv.timer_close(ticker.timer, ticker_closed)
  catch
    ticker.close_done = nil
    uv.timer_set_data(ticker.timer, nil)
    raise
  end
  return nil
end

local function close_timer(ticker: Ticker)
  local result = async.await_cleanup_with<|Ticker, nil, async.OperationError|>(ticker, start_ticker_close)
  case result
  when error(failure) then raise failure
  else
  end
end

local function start_timer(milliseconds: integer, repeat_time: integer): Ticker
  local loop = async.current_loop()
  local timer = uv.timer_t.new()
  local ticker: Ticker = {timer = timer, loop = loop, subscription = nil,
    closed = false, close_done = nil, close_number = 0}
  local subscription = async.CoalescingSubscription<|boolean, async.OperationError|>(
    function (publish, _fail, _finish): async.SubscriptionActions<|boolean|>
      local fired = function (_: uv.timer_t) publish(true) end
      local stop = function ()
        local status = uv.timer_stop(timer)
        if status < 0 then raise operation_error(status, "timer.stop") end
      end
      local close = function (_drain: function (): (async.SubscriptionBatch<|boolean|>))
        ticker.closed = true
        close_timer(ticker)
      end
      local actions = async.SubscriptionActions<|boolean|>(stop, close)
      local initialized = false
      local accepted = false
      defer do
        if initialized and not accepted then uv.timer_close(timer) end
      end
      local status = uv.timer_init(loop, timer)
      if status < 0 then raise operation_error(status, "timer.init") end
      initialized = true
      status = uv.timer_start(timer, fired, milliseconds, repeat_time)
      if status < 0 then raise operation_error(status, "timer.start") end
      accepted = true
      return actions
    end)
  ticker.subscription = subscription
  return ticker
end

local function sleep_fired(timer: uv.timer_t)
  local sleep: Sleep = uv.timer_get_data(timer)
  -- Both native firing and cancellation request the same deferred token wake.
  -- A failed wake propagates to UV so Runtime shutdown can retry cancellation
  -- and still enter this Task's deferred ownership cleanup.
  sleep.task:resume(sleep.token)
end

local function sleep_closed(timer: uv.timer_t)
  local sleep: Sleep = uv.timer_get_data(timer)
  local done = sleep.close_done as async.Completion<|Sleep, nil, async.OperationError|>
  local number = sleep.close_number
  sleep.close_done = nil
  uv.timer_set_data(timer, nil)
  do done:resolve(number, nil)
  catch done:fatal(number, error, traceback); raise end
end

local function start_sleep_close(done: async.Completion<|Sleep, nil, async.OperationError|>, number: integer): uv.req_t?
  local sleep = done:context(number)
  sleep.close_done = done
  sleep.close_number = number
  do uv.timer_close(sleep.timer, sleep_closed)
  catch sleep.close_done = nil; raise end
  return nil
end

local function close_sleep(sleep: Sleep)
  local result = async.await_cleanup_with<|Sleep, nil, async.OperationError|>(sleep, start_sleep_close)
  case result
  when error(failure) then raise failure
  else
  end
end

--- Suspend the current Task until a one-shot timer fires.
-- @param milliseconds Delay or interval in milliseconds.
-- @usage standard-library-timer.md#one-shot-delays
function sleep(milliseconds: integer)
  check_work()
  if milliseconds < 0 then raise operation_error(uv.EINVAL, "timer.sleep") end
  local timer = uv.timer_t.new()
  local waiting = Sleep(timer, async.running(), async.ResumeToken("timer.sleep"), nil, 0)
  local status = uv.timer_init(async.current_loop(), timer)
  if status < 0 then raise operation_error(status, "timer.init") end
  defer close_sleep(waiting)
  uv.timer_set_data(timer, waiting)
  status = uv.timer_start(timer, sleep_fired, milliseconds, 0)
  if status < 0 then raise operation_error(status, "timer.start") end
  async.suspend(waiting.token)
end

--- Yield the current Task to a later event-loop turn.
-- @usage standard-library-timer.md#one-shot-delays
function yield()
  async.yield()
end

--- Create a recurring timer with a positive interval in milliseconds.
-- @param milliseconds Delay or interval in milliseconds.
-- @return New Runtime-bound recurring ticker; the caller owns closing it.
-- @usage standard-library-timer.md#recurring-tickers
function ticker(milliseconds: integer): Ticker
  if milliseconds <= 0 then raise "ticker interval must be positive" end
  check_work()
  return start_timer(milliseconds, milliseconds)
end

--- Wait for one firing, or return false after the ticker closes.
-- @return True for a firing, or false when the ticker is closed.
-- @usage standard-library-timer.md#recurring-tickers
function Ticker:tick(): boolean
  check_work()
  if self.closed or self.loop ~= async.current_loop() then return false end
  if self.subscription:has_waiter() then raise "Ticker already has a waiting Task" end
  local outcome = self.subscription:next()
  case outcome
  when item(value) then return value
  when error(failure) then raise failure
  else return false
  end
end

--- Stop and retire this ticker, waking a waiting Task with false.
-- @usage standard-library-timer.md#recurring-tickers
function Ticker:close()
  async.running()
  if self.closed or self.loop ~= async.current_loop() then return end
  self.subscription:close()
end
