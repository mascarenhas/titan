local function to_method_list(v: value): {MethodType}
  local res: {MethodType} = {}
  if v == nil then return res end
  local top = luac.lua_gettop(L)
  defer luac.lua_settop(L, top)
  ffi.lua_pushtvalue(L, v)
  if luac.lua_type(L, -1) ~= luac.LUA_TTABLE then return res end
  local rawlen = luac.lua_rawlen(L, -1) as integer
  if rawlen > 0 then
    local i = 1
    while i <= rawlen do
      luac.lua_rawgeti(L, (top + 1) as int, i as luac.lua_Integer)
      local item: value = ffi.lua_totvalue(L, -1)
      res[#res + 1] = item as MethodType
      luac.lua_settop(L, (top + 1) as int)
      i = i + 1
    end
    return res
  end
  local names: {string} = {}
  local map: {string: MethodType} = {}
  luac.lua_pushnil(L)
  while luac.lua_next(L, (top + 1) as int) ~= 0 do
    local k_val: value = ffi.lua_totvalue(L, -2)
    local m_val: value = ffi.lua_totvalue(L, -1)
    if k_val is string then
      local k = k_val as string
      names[#names + 1] = k
      map[k] = m_val as MethodType
    end
    luac.lua_settop(L, (top + 2) as int)
  end
  sort_strings(names)
  local j = 1
  while j <= #names do
    res[#res + 1] = map[names[j]]
    j = j + 1
  end
  return res
end

local function to_static_list(v: value): {StaticFunctionType}
  local res: {StaticFunctionType} = {}
  if v == nil then return res end
  local top = luac.lua_gettop(L)
  defer luac.lua_settop(L, top)
  ffi.lua_pushtvalue(L, v)
  if luac.lua_type(L, -1) ~= luac.LUA_TTABLE then return res end
  local rawlen = luac.lua_rawlen(L, -1) as integer
  if rawlen > 0 then
    local i = 1
    while i <= rawlen do
      luac.lua_rawgeti(L, (top + 1) as int, i as luac.lua_Integer)
      local item: value = ffi.lua_totvalue(L, -1)
      res[#res + 1] = item as StaticFunctionType
      luac.lua_settop(L, (top + 1) as int)
      i = i + 1
    end
    return res
  end
  local names: {string} = {}
  local map: {string: StaticFunctionType} = {}
  luac.lua_pushnil(L)
  while luac.lua_next(L, (top + 1) as int) ~= 0 do
    local k_val: value = ffi.lua_totvalue(L, -2)
    local s_val: value = ffi.lua_totvalue(L, -1)
    if k_val is string then
      local k = k_val as string
      names[#names + 1] = k
      map[k] = s_val as StaticFunctionType
    end
    luac.lua_settop(L, (top + 2) as int)
  end
  sort_strings(names)
  local j = 1
  while j <= #names do
    res[#res + 1] = map[names[j]]
    j = j + 1
  end
  return res
end

local function default_method(self_val: value, ...: value): (...: value)
end

local function default_static(...: value): (...: value)
end

local function default_variant(p: value): value
  return nil
end

local hydration_env: {string: value} = {}

local function init_hydration_env()
  hydration_env["Integer"] = function(): Type
    return Type.is_integer()
  end

  hydration_env["Boolean"] = function(): Type
    return Type.is_boolean()
  end

  hydration_env["String"] = function(): Type
    return Type.is_string()
  end

  hydration_env["Nil"] = function(): Type
    return Type.is_nil()
  end

  hydration_env["Float"] = function(): Type
    return Type.is_float()
  end

  hydration_env["Value"] = function(): Type
    return Type.is_value()
  end

  hydration_env["Void"] = function(): Type
    return Type.is_foreign_void()
  end

  hydration_env["CVoid"] = function(): Type
    return Type.is_foreign_void()
  end

  hydration_env["Option"] = function(base: Type): Type
    return Type.is_option(base)
  end

  hydration_env["Array"] = function(elem: Type, isconst: value): Type
    local c = false
    if isconst == true then c = true end
    return Type.is_array({ is_const = c, elem_descriptor = elem })
  end

  hydration_env["Map"] = function(keys: Type, values: Type): Type
    return Type.is_map({ key_descriptor = keys, value_descriptor = values })
  end

  hydration_env["Nominal"] = function(fqtn: string, ...: value): Type
    return Type.is_named({ name = fqtn })
  end

  hydration_env["Field"] = function(fqtn: string, name: string, typ: Type, index: integer, isconst: boolean): FieldType
    return {
      name = name,
      index = index,
      descriptor = typ,
      is_const = isconst
    }
  end

  hydration_env["Variant"] = function(fqtn: string, name: string, payload: value, index: integer): VariantType
    local desc: Type? = nil
    if payload ~= false and payload ~= nil then
      desc = payload as Type
    end
    local callable: (value) -> value = default_variant
    if active_statics then
      local statics_map = (active_statics as value) as {string: value}
      local fn = statics_map[name]
      if fn then
        callable = fn as (value) -> value
      end
    end
    return {
      name = name,
      tag = index,
      descriptor = desc,
      callable = callable
    }
  end

  hydration_env["Method"] = function(fqtn: string, name: string, params: value, rettypes: value, varargtype: value, flexrettype: value, paramnames: value, ...: value): MethodType
    local vararg_desc: Type? = nil
    if varargtype ~= false and varargtype ~= nil then
      vararg_desc = varargtype as Type
    end
    local flexret_desc: Type? = nil
    if flexrettype ~= false and flexrettype ~= nil then
      flexret_desc = flexrettype as Type
    end
    local callable: (value, ...: value) -> (...: value) = default_method
    if active_membermap ~= nil then
      local mm = (active_membermap as value) as {string: value}
      local fn = mm[name]
      if fn ~= nil then
        callable = fn as (value, ...: value) -> (...: value)
      end
    end
    return {
      name = name,
      param_names = to_string_array(paramnames) as const { string },
      param_descriptors = to_type_array(params) as const { Type },
      vararg_descriptor = vararg_desc,
      return_descriptors = to_type_array(rettypes) as const { Type },
      flexret_descriptor = flexret_desc,
      callable = callable
    }
  end

  hydration_env["StaticMethod"] = function(fqtn: string, name: string, params: value, rettypes: value, varargtype: value, flexrettype: value, paramnames: value, ...: value): StaticFunctionType
    local vararg_desc: Type? = nil
    if varargtype ~= false and varargtype ~= nil then
      vararg_desc = varargtype as Type
    end
    local flexret_desc: Type? = nil
    if flexrettype ~= false and flexrettype ~= nil then
      flexret_desc = flexrettype as Type
    end
    local callable: (...: value) -> (...: value) = default_static
    if active_statics ~= nil then
      local statics_map = (active_statics as value) as {string: value}
      local fn = statics_map[name]
      if fn ~= nil then
        callable = fn as (...: value) -> (...: value)
      end
    end
    return {
      name = name,
      param_names = to_string_array(paramnames) as const { string },
      param_descriptors = to_type_array(params) as const { Type },
      vararg_descriptor = vararg_desc,
      return_descriptors = to_type_array(rettypes) as const { Type },
      flexret_descriptor = flexret_desc,
      callable = callable
    }
  end

  hydration_env["Function"] = function(params: value, rettypes: value, dummy: value, varargtype: value, flexrettype: value): Type
    local vararg_desc: Type? = nil
    if varargtype ~= false and varargtype ~= nil then
      vararg_desc = varargtype as Type
    end
    local flexret_desc: Type? = nil
    if flexrettype ~= false and flexrettype ~= nil then
      flexret_desc = flexrettype as Type
    end
    return Type.is_function({
      param_descriptors = to_type_array(params) as const { Type },
      vararg_descriptor = vararg_desc,
      return_descriptors = to_type_array(rettypes) as const { Type },
      flexret_descriptor = flexret_desc
    })
  end

  hydration_env["Record"] = function(name: string, fields: value, functions_map: value, methods_map: value, ...: value): RecordType
    return {
      name = name,
      fields = to_field_array(fields) as const { FieldType },
      statics = to_static_list(functions_map) as const { StaticFunctionType },
      methods = to_method_list(methods_map) as const { MethodType }
    }
  end

  hydration_env["Union"] = function(name: string, variants: value, functions_map: value, methods_map: value, ...: value): UnionType
    return {
      name = name,
      variants = to_variant_array(variants) as const { VariantType },
      statics = to_static_list(functions_map) as const { StaticFunctionType },
      methods = to_method_list(methods_map) as const { MethodType }
    }
  end

  hydration_env["Interface"] = function(name: string, fields: value, methods: value, ...: value): InterfaceType
    return {
      name = name,
      fields = to_field_array(fields) as const { FieldType },
      methods = to_method_list(methods) as const { MethodType }
    }
  end

  hydration_env["COwned"] = function(pointee: Type, count: value): Type
    if count == true then
      return Type.is_owned_foreign_array({ elem_descriptor = pointee })
    else
      return Type.is_owned_foreign_pointer({ pointee_descriptor = pointee })
    end
  end

  hydration_env["CInteger"] = function(spelling: string, is_signed: boolean, rank: integer, bits: integer): Type
    return Type.is_foreign_integer({
      spelling = spelling,
      is_signed = is_signed,
      rank = rank,
      bits = bits
    })
  end

  hydration_env["CFloat"] = function(spelling: string): Type
    return Type.is_foreign_float({ spelling = spelling })
  end

  hydration_env["CPointer"] = function(pointee: Type, quals: {string}): Type
    return Type.is_foreign_pointer({
      pointee_descriptor = pointee,
      quals = quals as const { string }
    })
  end

  hydration_env["CArray"] = function(elem: Type, len: value, quals: {string}): Type
    return Type.is_foreign_array({
      elem_descriptor = elem,
      len = len,
      quals = quals as const { string }
    })
  end

  hydration_env["CStruct"] = function(cname: value, tagname: value, typedef: value, fields: value, complete: boolean, has_fam: boolean): Type
    local cn = ""
    if cname ~= false and cname ~= nil then cn = cname as string end
    local tn = ""
    if tagname ~= false and tagname ~= nil then tn = tagname as string end
    local td = ""
    if typedef ~= false and typedef ~= nil then td = typedef as string end
    return Type.is_foreign_struct({
      cname = cn,
      tagname = tn,
      typedef = td,
      fields = to_foreign_field_array(fields) as const { ForeignFieldType },
      is_complete = complete,
      has_fam = has_fam
    })
  end

  hydration_env["CUnion"] = function(cname: value, tagname: value, typedef: value, fields: value, complete: boolean): Type
    local cn = ""
    if cname ~= false and cname ~= nil then cn = cname as string end
    local tn = ""
    if tagname ~= false and tagname ~= nil then tn = tagname as string end
    local td = ""
    if typedef ~= false and typedef ~= nil then td = typedef as string end
    return Type.is_foreign_union({
      cname = cn,
      tagname = tn,
      typedef = td,
      fields = to_foreign_field_array(fields) as const { ForeignFieldType },
      is_complete = complete
    })
  end

  hydration_env["CField"] = function(owner: value, name: string, typ: Type, bitfield: value, flex: boolean): ForeignFieldType
    return {
      name = name,
      descriptor = typ,
      bitfield = bitfield,
      is_flexible_array = flex
    }
  end

  hydration_env["CTypedef"] = function(name: string, target: Type, quals: value): Type
    return Type.is_foreign_typedef({
      name = name,
      target_descriptor = target,
      quals = to_string_array(quals) as const { string }
    })
  end

  hydration_env["CFunction"] = function(params: value, ret: Type, vararg: boolean, abi: value): Type
    return Type.is_foreign_function({
      param_descriptors = to_type_array(params) as const { Type },
      is_vararg = vararg,
      return_descriptor = ret
    })
  end

  -- Ignored generic/module metadata tokens
  local ignore_fn = function(...: value): value return false end
  hydration_env["GenericScope"] = ignore_fn
  hydration_env["TypeParameter"] = ignore_fn
  hydration_env["Parameter"] = ignore_fn
  hydration_env["FunctionScheme"] = ignore_fn
  hydration_env["GenericAlias"] = ignore_fn
  hydration_env["Module"] = ignore_fn
  hydration_env["ModuleMember"] = ignore_fn
  hydration_env["ModuleVariable"] = ignore_fn
  hydration_env["CModule"] = ignore_fn
end

local function hydrate_with_context(typestr: string, mt: value?): value
  if mt ~= nil then
    active_membermap = rawgetp_val(mt as value, ffi.TITAN_MT_MEMBERMAP)
    active_statics = rawgetp_val(mt as value, ffi.TITAN_MT_STATICS)
  else
    active_membermap = nil
    active_statics = nil
  end
  local chunk = titan_lua.load("return " .. typestr, "=descriptor", hydration_env)
  local result: value = chunk()
  active_membermap = nil
  active_statics = nil
  return result
end

local function hydrate_type(typestr: string): Type
  local res = hydrate_with_context(typestr, nil)
  return res as Type
end

local function get_or_hydrate_record_type(mt: value): RecordType
  local cached = mt_cache[mt]
  if cached ~= nil then
    return cached as RecordType
  end
  local typestr_val = rawgetp_val(mt, ffi.TITAN_MT_TYPE)
  if typestr_val == nil then
    raise "record metatable has no type descriptor"
  end
  local typestr = typestr_val as string
  local rec_type = hydrate_with_context(typestr, mt) as RecordType
  mt_cache[mt] = rec_type
  nominal_cache[rec_type.name] = NominalType.is_record(rec_type)
  return rec_type
end

local function get_or_hydrate_union_type(mt: value): UnionType
  local cached = mt_cache[mt]
  if cached ~= nil then
    return cached as UnionType
  end
  local typestr_val = rawgetp_val(mt, ffi.TITAN_MT_TYPE)
  if typestr_val == nil then
    raise "union metatable has no type descriptor"
  end
  local typestr = typestr_val as string
  local union_type = hydrate_with_context(typestr, mt) as UnionType
  mt_cache[mt] = union_type
  nominal_cache[union_type.name] = NominalType.is_union(union_type)
  return union_type
end

local function get_or_hydrate_interface_type(mt: value): InterfaceType
  local cached = mt_cache[mt]
  if cached ~= nil then
    return cached as InterfaceType
  end
  local typestr_val = rawgetp_val(mt, ffi.TITAN_MT_TYPE)
  if typestr_val == nil then
    raise "interface metatable has no type descriptor"
  end
  local typestr = typestr_val as string
  local iface_type = hydrate_with_context(typestr, mt) as InterfaceType
  mt_cache[mt] = iface_type
  nominal_cache[iface_type.name] = NominalType.is_interface(iface_type)
  return iface_type
end

local function get_or_hydrate_owned_type(mt: value): Type
  local cached = mt_cache[mt]
  if cached ~= nil then
    return cached as Type
  end
  local typestr_val = rawgetp_val(mt, ffi.TITAN_MT_TYPE)
  if typestr_val == nil then
    raise "owned foreign metatable has no type descriptor"
  end
  local typestr = typestr_val as string
  local t = hydrate_with_context(typestr, mt) as Type
  mt_cache[mt] = t
  return t
end

function find_nominal(name: string): NominalType?
  local cached: NominalType? = nominal_cache[name]
  if cached ~= nil then
    return cached
  end
  local mt = get_metatable_by_name(name)
  if mt == nil then
    return nil
  end
  local brand_val = rawgetp_val(mt as value, ffi.TITAN_BRAND)
  if brand_val == nil or not (brand_val is integer) then
    return nil
  end
  local brand = brand_val as integer
  if brand == 3 then -- TITAN_RECORD
    local rec = get_or_hydrate_record_type(mt as value)
    local nom = NominalType.is_record(rec)
    nominal_cache[name] = nom
    return nom
  elseif brand == 4 then -- TITAN_UNION
    local u = get_or_hydrate_union_type(mt as value)
    local nom = NominalType.is_union(u)
    nominal_cache[name] = nom
    return nom
  elseif brand == 5 then -- TITAN_INTERFACE
    local iface = get_or_hydrate_interface_type(mt as value)
    local nom = NominalType.is_interface(iface)
    nominal_cache[name] = nom
    return nom
  else
    return nil
  end
end

function record_descriptor(name: string): RecordType?
  local nom: NominalType? = find_nominal(name)
  if nom ~= nil then
    local n = nom as NominalType
    case n
    when is_record: rec then
      return rec
    else
      return nil
    end
  end
  return nil
end

function union_descriptor(name: string): UnionType?
  local nom: NominalType? = find_nominal(name)
  if nom ~= nil then
    local n = nom as NominalType
    case n
    when is_union: un then
      return un
    else
      return nil
    end
  end
  return nil
end

function interface_descriptor(name: string): InterfaceType?
  local nom: NominalType? = find_nominal(name)
  if nom ~= nil then
    local n = nom as NominalType
    case n
    when is_interface: iface then
      return iface
    else
      return nil
    end
  end
  return nil
end

local function is_titan_closure(cl: *lobject.CClosure): boolean
  if (cl.nupvalues as integer) < 5 then
    return false
  end
  local upvalues: *lobject.TValue = cl.upvalue as *lobject.TValue
  local brand_slot = upvalues[3]
  if ffi.luamacro_ttislightuserdata(brand_slot) == 0 then
    return false
  end
  return ffi.lmacro_pvalue(brand_slot) == ffi.TITAN_BRAND
end

local function inspect_function(v: value): Value
  local tv: lobject.TValue = v
  if ffi.luamacro_ttisLclosure(tv) ~= 0 then
    local ar: owned *luac.lua_Debug = luac.lua_Debug.new()
    ffi.lua_pushtvalue(L, v)
    if luac.lua_getinfo(L, ">Su", ar) == 0 then
      raise "could not get Lua function info"
    end
    local src = ""
    if ar.source ~= nil then
      src = ar.source as string
    end
    local short_src = (ar.short_src as *char) as string
    local what = ""
    if ar.what ~= nil then
      what = ar.what as string
    end
    local desc: LuaFunctionType = {
      source = src,
      short_source = short_src,
      line_defined = ar.linedefined as integer,
      last_line_defined = ar.lastlinedefined as integer,
      what = what,
      is_vararg = ar.isvararg ~= 0,
      n_params = ar.nparams as integer
    }
    return Value.is_lua_function({
      val = v as (...: value) -> (...: value),
      descriptor = desc
    })
  elseif ffi.luamacro_ttisCclosure(tv) ~= 0 then
    local cl = ffi.lmacro_clCvalue(tv)
    if is_titan_closure(cl) then
      local upvalues: *lobject.TValue = cl.upvalue as *lobject.TValue
      local native_entry = ffi.lmacro_pvalue(upvalues[2])
      local lua_entry = ffi.luamacro_ccl_f(cl)
      local tag_ptr = ffi.lmacro_pvalue(upvalues[1]) as *char
      local tag_str = tag_ptr as string
      local ftype = hydrate_type(tag_str)
      local desc: FunctionType? = nil
      case ftype
      when is_function: ft then
        desc = ft
      end
      if desc == nil then
        raise "invalid function descriptor for Titan function"
      end
      return Value.is_titan_function({
        val = v as (...: value) -> (...: value),
        native_entry = native_entry,
        lua_entry = lua_entry,
        descriptor = desc as FunctionType
      })
    else
      local entry = ffi.luamacro_ccl_f(cl)
      return Value.is_lua_c_function({
        val = v as (...: value) -> (...: value),
        entry = entry
      })
    end
  elseif ffi.luamacro_ttislcf(tv) ~= 0 then
    local entry = ffi.luamacro_fvalue(tv)
    return Value.is_lua_c_function({
      val = v as (...: value) -> (...: value),
      entry = entry
    })
  else
    raise "unknown function representation"
  end
end

local brand_handlers: {(value, value) -> Value} = {}

local function init_brand_handlers()
  brand_handlers[1] = function(v: value, mt: value): Value
    return Value.is_array({ val = v as {value} })
  end

  brand_handlers[2] = function(v: value, mt: value): Value
    return Value.is_const_array({ val = v as const {value} })
  end

  brand_handlers[3] = function(v: value, mt: value): Value
    local desc = get_or_hydrate_record_type(mt)
    local tv: lobject.TValue = v
    local u = ffi.lmacro_uvalue(tv)
    local nuv = u.nuvalue as integer
    local uv_ptr = u.uv as *lobject.UValue
    local indexes: {integer} = {}
    local is_const: {boolean} = {}
    for i = 1, #desc.fields do
      indexes[#indexes + 1] = desc.fields[i].index
      is_const[#is_const + 1] = desc.fields[i].is_const
    end
    return Value.is_record({
      udata = u,
      nuvalue = nuv,
      uv = uv_ptr,
      indexes = indexes,
      is_const = is_const,
      n_fields = #desc.fields,
      val = v,
      descriptor = desc
    })

  end

  brand_handlers[4] = function(v: value, mt: value): Value
    local desc = get_or_hydrate_union_type(mt)
    local tv: lobject.TValue = v
    local u = ffi.lmacro_uvalue(tv)
    local uv_ptr = u.uv as *lobject.UValue
    local tag: integer = 0
    local tag_val: value = uv_ptr[0].uv
    if tag_val is integer then
      tag = tag_val as integer
    end
    local payload: value = nil
    if (u.nuvalue as integer) > 1 then
      payload = uv_ptr[1].uv
    end
    return Value.is_union({
      tag = tag,
      payload = payload,
      val = v,
      descriptor = desc
    })
  end

  brand_handlers[5] = function(v: value, mt: value): Value
    local desc = get_or_hydrate_interface_type(mt)
    local tv: lobject.TValue = v
    local u = ffi.lmacro_uvalue(tv)
    local nuv = u.nuvalue as integer
    local uv_ptr = u.uv as *lobject.UValue
    local wrapped = uv_ptr[1].uv
    return Value.is_interface({
      nuvalue = nuv,
      uv = uv_ptr,
      n_fields = #desc.fields,
      val = v,
      wrapped = wrapped,
      descriptor = desc
    })
  end

  brand_handlers[6] = function(v: value, mt: value): Value
    local t = get_or_hydrate_owned_type(mt)
    local tv: lobject.TValue = v
    local u = ffi.lmacro_uvalue(tv)
    local payload = ffi.luamacro_getudatamem(u)
    local size = u.len as integer
    case t
    when is_owned_foreign_array: arr_t then
      local count: integer = 0
      if (u.nuvalue as integer) > 0 then
        local uv_ptr = u.uv as *lobject.UValue
        local count_val: value = uv_ptr[0].uv
        if count_val is integer then
          count = count_val as integer
        end
      end
      return Value.is_owned_foreign_array({
        val = v,
        payload = payload,
        size = size,
        count = count,
        descriptor = arr_t
      })
    when is_owned_foreign_pointer: ptr_t then
      return Value.is_owned_foreign_pointer({
        val = v,
        payload = payload,
        size = size,
        descriptor = ptr_t
      })
    else
      return Value.is_lua_userdata({ val = v })
    end
  end
end

local function inspect_userdata(v: value): Value
  local mt = get_metatable_val(v)
  if mt == nil then
    return Value.is_lua_userdata({ val = v })
  end
  local brand_val = rawgetp_val(mt as value, ffi.TITAN_BRAND)
  if brand_val == nil or not (brand_val is integer) then
    return Value.is_lua_userdata({ val = v })
  end
  local brand = brand_val as integer
  if brand >= 1 and brand <= #brand_handlers then
    return brand_handlers[brand](v, mt as value)
  end
  return Value.is_lua_userdata({ val = v })
end

local tag_handlers: {(value) -> Value} = {}

local function init_tag_handlers()
  tag_handlers[1] = function(v: value): Value
    return Value.is_nil()
  end

  tag_handlers[2] = function(v: value): Value
    return Value.is_boolean(v as boolean)
  end

  tag_handlers[3] = function(v: value): Value
    local tv: lobject.TValue = v
    return Value.is_raw_pointer(ffi.lmacro_pvalue(tv))
  end

  tag_handlers[4] = function(v: value): Value
    if v is integer then
      return Value.is_integer(v as integer)
    else
      return Value.is_float(v as float)
    end
  end

  tag_handlers[5] = function(v: value): Value
    return Value.is_string(v as string)
  end

  tag_handlers[6] = function(v: value): Value
    return Value.is_map({ val = v as {value: value} })
  end

  tag_handlers[7] = function(v: value): Value
    return inspect_function(v)
  end

  tag_handlers[8] = function(v: value): Value
    return inspect_userdata(v)
  end

  tag_handlers[9] = function(v: value): Value
    local tv: lobject.TValue = v
    return Value.is_lua_thread({ val = v, thread = ffi.lmacro_thvalue(tv) })
  end
end

function inspect(v: value): Value
  local tv: lobject.TValue = v
  local tag = ffi.lmacro_ttype(tv)
  local idx = tag + 1
  if idx >= 1 and idx <= #tag_handlers then
    return tag_handlers[idx](v)
  end
  return Value.is_nil()
end


do
  init_hydration_env()
  init_brand_handlers()
  init_tag_handlers()
end
