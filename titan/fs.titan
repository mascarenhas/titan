local uv = import "uv"
local str = import "string"

local READ_CHUNK_BYTES = 64 * 1024

record File
  local handle: uv.uv_file
  local excess: string
end

record Stat
  size: integer
  kind: string
  mode: integer
  modified_seconds: integer
  modified_nanoseconds: integer
end

function open(path: string, mode: string): File
  return File.new(uv.fs_open(path, mode), "")
end

function File:read(max_bytes: integer?): string?
  local requested = READ_CHUNK_BYTES
  if max_bytes then requested = max_bytes as integer end
  if requested <= 0 then
    raise "file read size must be positive"
  end
  if self.handle.handle < 0 then
    self.excess = ""
    return nil
  end
  if #self.excess > 0 then
    local length = requested
    if length > #self.excess then length = #self.excess end
    local result = str.sub(self.excess, 1, length)
    self.excess = str.sub(self.excess, length + 1)
    return result
  end
  return uv.fs_read(self.handle, requested)
end

function File:read_until(delimiter: string,
                         chop: boolean?): string?
  if self.handle.handle < 0 then
    self.excess = ""
    return nil
  end
  if #delimiter == 0 then
    raise "read delimiter must not be empty"
  end

  local builder = str.writer()
  local tail = ""
  for chunk in self:read do
    local boundary = chunk
    if #tail > 0 then boundary = tail .. chunk end
    local match: integer? = str.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(str.sub(boundary, 1, result_end))
      end
      self.excess = str.sub(boundary, match_end + 1)
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(str.sub(boundary, 1, committed))
      end
    end
    tail = str.sub(boundary, committed + 1)
  end
  if #tail > 0 then builder:write(tail) end
  local result = builder:drain()
  if #result == 0 then return nil end
  return result
end

function File:write(data: string): integer
  return uv.fs_write(self.handle, data)
end

function File:flush()
  uv.fs_flush(self.handle)
end

function File:close()
  self.excess = ""
  uv.fs_close(self.handle)
end

function File:is_closed(): boolean
  return self.handle.handle < 0
end

function read_file(path: string): string
  local file = open(path, "r")
  defer file:close()

  local builder = str.writer()
  for bytes in file:read do
    builder:write(bytes)
  end
  return builder:drain()
end

function write_file(path: string, data: string)
  local file = open(path, "w")
  defer file:close()
  file:write(data)
end

function stat(path: string): Stat
  local size, kind, mode, modified_seconds, modified_nanoseconds =
    uv.fs_stat(path)
  return Stat.new(size, kind, mode, modified_seconds, modified_nanoseconds)
end

function lstat(path: string): Stat
  local size, kind, mode, modified_seconds, modified_nanoseconds =
    uv.fs_lstat(path)
  return Stat.new(size, kind, mode, modified_seconds, modified_nanoseconds)
end

function tmpname(): string
  return uv.fs_tmpname()
end

function tmpdir(): string
  return uv.os_tmpdir()
end

function homedir(): string
  return uv.os_homedir()
end

function pwd(): string
  return uv.current_directory("fs.pwd")
end

function chdir(path: string)
  uv.change_directory(path, "fs.chdir")
end

function mkdir(path: string)
  uv.fs_mkdir(path)
end

function unlink(path: string)
  uv.fs_unlink(path)
end

function rmdir(path: string)
  uv.fs_rmdir(path)
end

function rename(from: string, to: string)
  uv.fs_rename(from, to)
end

function list(path: string): {string}
  return uv.fs_list(path)
end
