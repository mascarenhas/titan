local uv = import "uv"
local str = import "string"

-- Fixed-size reads keep whole-file helpers independent of stat metadata. The
-- uv middle layer may return a shorter chunk and returns nil only at EOF.
local READ_CHUNK_BYTES = 64 * 1024
local MAX_READ_BYTES = 4294967295
local MAX_STRING_BYTES = 9223372036854775807

record File
  local handle: uv.uv_file
  local excess: string
end

record Stat
  size: integer
  kind: string
  mode: integer
  modified_seconds: integer
  modified_nanoseconds: integer
end

-- Validate at the public boundary so a bad mode has a stable fs diagnostic.
-- uv repeats this validation, then maps the mode only through UV_FS_O_*.
local function validated_mode(mode: string): string
  if mode == "r" or mode == "rb" or
      mode == "w" or mode == "wb" or
      mode == "a" or mode == "ab" or
      mode == "r+" or mode == "r+b" or mode == "rb+" or
      mode == "w+" or mode == "w+b" or mode == "wb+" or
      mode == "a+" or mode == "a+b" or mode == "ab+" then
    return mode
  end
  raise "invalid file mode '" .. mode .. "'"
end

function open(path: string, mode: string): File
  return File.new(uv._fs_open(path, validated_mode(mode)), "")
end

function File:read(max_bytes: integer?): string?
  local requested = READ_CHUNK_BYTES
  if max_bytes then requested = max_bytes as integer end
  if requested <= 0 then
    raise "file read size must be positive"
  end
  if requested > MAX_READ_BYTES then
    raise "read size exceeds the portable libuv buffer limit"
  end
  -- A terminal File is ordinary Reader EOF, including after its owning
  -- Runtime has gone stale. This scalar state check touches no native owner.
  if uv._fs_is_closed(self.handle) then
    self.excess = ""
    return nil
  end
  if #self.excess > 0 then
    -- Retained bytes do not submit a uv operation, but they must observe the
    -- same cancellation and File lifecycle checks as an ordinary read.
    uv._fs_validate_read(self.handle)
    local length = requested
    if length > #self.excess then length = #self.excess end
    local result = str.sub(self.excess, 1, length)
    self.excess = str.sub(self.excess, length + 1)
    return result
  end
  return uv._fs_read(self.handle, requested)
end

function File:read_until(delimiter: string,
                         chop: boolean?): string?
  if uv._fs_is_closed(self.handle) then
    self.excess = ""
    return nil
  end
  if #delimiter == 0 then
    raise "read delimiter must not be empty"
  end

  local builder = str.writer()
  -- StringWriter:write yields before committing its argument. Keep the
  -- current consumed chunk separately until that commit succeeds so an
  -- error or cancellation can restore every byte to the File excess.
  local pending = ""
  local total = 0
  local tail = ""
  local result: string? = nil
  local matched = false
  do
    for chunk in self:read do
      pending = chunk
      if total > MAX_STRING_BYTES - #chunk then
        raise "file read result exceeds Titan's string length limit"
      end

      builder:write(chunk)
      pending = ""
      local boundary = tail .. chunk
      local match: integer? = str.find(boundary, delimiter)
      total = total + #chunk
      if match then
        local match_end =
          total - #boundary + (match as integer) - 1 + #delimiter
        local result_end = match_end
        if chop then result_end = result_end - #delimiter end
        local all = builder:drain()
        result = str.sub(all, 1, result_end)
        self.excess =
          str.sub(all, match_end + 1) .. self.excess
        matched = true
        break
      else
        local keep = #delimiter - 1
        if keep > #boundary then keep = #boundary end
        tail = str.sub(boundary, #boundary - keep + 1)
      end
    end
    if not matched and total > 0 then result = builder:drain() end
  catch
    local restored = builder:drain()
    if #pending > 0 then restored = restored .. pending end
    if #restored > 0 then
      self.excess = restored .. self.excess
    end
    raise
  end
  return result
end

function File:write(data: string): integer
  local written = uv._fs_write(self.handle, data)
  -- One uv logical write owns all of its partial native submissions, so it
  -- cannot interleave with the next FIFO operation.
  if written ~= #data then
    raise "filesystem write completed without consuming the full input"
  end
  return written
end

function File:flush()
  uv._fs_flush(self.handle)
end

function File:close()
  -- The uv layer coalesces close waiters and cleanup-shields physical close.
  -- Clear before yielding so no later facade read can observe old excess,
  -- then clear again because an earlier queued read_until may finish while
  -- the low-level File is closing and restore or retain its consumed bytes.
  self.excess = ""
  do
    uv._fs_close(self.handle)
  finally
    self.excess = ""
  end
end

function File:is_closed(): boolean
  return uv._fs_is_closed(self.handle)
end

function read_file(path: string): string
  local file = open(path, "r")
  defer file:close()

  local builder = str.writer()
  local total = 0
  for bytes in file:read do
    local length = #bytes
    if total > MAX_STRING_BYTES - length then
      raise "file is too large to read into a string"
    end
    total = total + length
    builder:write(bytes)
  end
  return builder:drain()
end

function write_file(path: string, data: string)
  local file = open(path, "w")
  defer file:close()
  file:write(data)
end

function stat(path: string): Stat
  local size, kind, mode, modified_seconds, modified_nanoseconds =
    uv._fs_stat(path)
  return Stat.new(size, kind, mode, modified_seconds, modified_nanoseconds)
end

function lstat(path: string): Stat
  local size, kind, mode, modified_seconds, modified_nanoseconds =
    uv._fs_lstat(path)
  return Stat.new(size, kind, mode, modified_seconds, modified_nanoseconds)
end

function tmpname(): string
  return uv._fs_tmpname()
end

function tmpdir(): string
  return uv._os_tmpdir()
end

function homedir(): string
  return uv._os_homedir()
end

function pwd(): string
  return uv._fs_pwd()
end

function chdir(path: string)
  uv._fs_chdir(path)
end

function mkdir(path: string)
  uv._fs_mkdir(path)
end

function unlink(path: string)
  uv._fs_unlink(path)
end

function rmdir(path: string)
  uv._fs_rmdir(path)
end

function rename(from: string, to: string)
  uv._fs_rename(from, to)
end

function list(path: string): {string}
  return uv._fs_list(path)
end
