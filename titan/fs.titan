local uv = import "uv.titan"
local string = import "string"
foreign import "uv.h"
foreign import "lua.h"
foreign import "titan/ffi.h"

local READ_CHUNK_BYTES = 64 * 1024

record File
  local handle: foreign uv_file
  local excess: string
end

record Stat
  size: integer
  kind: string
  mode: integer
  device: integer
  inode: integer
  modified_seconds: integer
  modified_nanoseconds: integer
end

foreign type FsNoargCallbackEntry = function (*lua_State, *Udata, *CClosure, *Udata): void
foreign type FsEventCallbackEntry = function (*lua_State, *Udata, *CClosure, *Udata, const *char, lua_Integer, lua_Integer): void

local record RealpathRequest
  local handle: owned *uv_fs_t
  local callback: function (RealpathRequest): ()
  local waiter: uv.Task?
  local failed: boolean
  local payload: value
end

local record WatchRegistration
  local handle: owned *uv_fs_event_t
  local callback: function (WatchRegistration, foreign const *char, integer, integer): ()
  local runtime: uv.Runtime
  local path: string
  local directory: boolean
  local index: integer
  -- Slot in Runtime.handle_roots; zero after ownership moves to close_cb.
  local runtime_root_index: integer
end

local record WatcherNotification
  local registration: WatchRegistration
  local filename: string?
  local events: integer
  local status: integer
end

local realpath_roots: {RealpathRequest: boolean} = {}

foreign function fs_realpath_cb(request: *uv_fs_t)
  local owner = ffi.uv_req_get_data(
      request as foreign *uv_req_t) as foreign *Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local L = ffi.uv_loop_get_data(request.loop) as foreign *lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as foreign FsNoargCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner)
  ffi.lua_settop(L, top)
end

foreign function fs_watcher_event_cb(handle: *uv_fs_event_t,
                                      filename: const *char,
                                      events: int,
                                      status: int)
  local native_handle = handle as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(native_handle) as foreign *Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local loop = ffi.uv_handle_get_loop(native_handle)
  local L = ffi.uv_loop_get_data(loop) as foreign *lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as foreign FsEventCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner, filename,
        events as foreign lua_Integer, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

function open(path: string, mode: string): File
  return File.new(uv.fs_open(path, mode), "")
end

function File:read(max_bytes: integer?): string?
  local requested = READ_CHUNK_BYTES
  if max_bytes then requested = max_bytes end
  if requested <= 0 then
    raise "file read size must be positive"
  end
  if (self.handle as integer) < 0 then
    self.excess = ""
    return nil
  end
  if #self.excess > 0 then
    local length = requested
    if length > #self.excess then length = #self.excess end
    local result = string.sub(self.excess, 1, length)
    self.excess = string.sub(self.excess, length + 1)
    return result
  end
  return uv.fs_read(self.handle, requested)
end

function File:read_until(delimiter: string,
                         chop: boolean?): string?
  if (self.handle as integer) < 0 then
    self.excess = ""
    return nil
  end
  if #delimiter == 0 then
    raise "read delimiter must not be empty"
  end

  local builder = string.writer()
  local tail = ""
  for chunk in self:read do
    local boundary = chunk
    if #tail > 0 then boundary = tail .. chunk end
    local match: integer? = string.find(boundary, delimiter)
    if match then
      local match_first = match
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(string.sub(boundary, 1, result_end))
      end
      self.excess = string.sub(boundary, match_end + 1)
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(string.sub(boundary, 1, committed))
      end
    end
    tail = string.sub(boundary, committed + 1)
  end
  if #tail > 0 then builder:write(tail) end
  local result = builder:drain()
  if #result == 0 then return nil end
  return result
end

function File:write(data: string): integer
  local length = #data
  if length == 0 then return uv.fs_write(self.handle, data, 0) end
  local offset = 0
  while offset < length do
    local written = uv.fs_write(self.handle, data, offset)
    offset = offset + written
  end
  return offset
end

function File:flush()
  uv.fs_flush(self.handle)
end

function File:close()
  self.excess = ""
  if (self.handle as integer) < 0 then return end
  local descriptor = self.handle
  local operation = uv.FsCloseCall.new(descriptor, false)
  self.handle = -1 as foreign uv_file
  do
    uv.fs_close(operation)
  catch
    if not operation.accepted then self.handle = descriptor end
    raise
  end
end

function File:is_closed(): boolean
  return (self.handle as integer) < 0
end

function read_file(path: string): string
  local file = open(path, "r")
  defer file:close()

  local builder = string.writer()
  for bytes in file:read do
    builder:write(bytes)
  end
  return builder:drain()
end

function write_file(path: string, data: string)
  local file = open(path, "w")
  defer file:close()
  file:write(data)
end

local function missing_path(failure: value): boolean
  if failure is uv.OperationError then
    local operation = failure as uv.OperationError
    return operation.code == (ffi.UV_ENOENT as integer)
  end
  return false
end

function stat(path: string): Stat?
  do
    local size, kind, mode, device, inode,
      modified_seconds, modified_nanoseconds =
      uv.fs_stat(path)
    return Stat.new(size, kind, mode, device, inode,
                    modified_seconds, modified_nanoseconds)
  catch
    if missing_path(error) then return nil end
    raise
  end
end

function lstat(path: string): Stat?
  do
    local size, kind, mode, device, inode,
      modified_seconds, modified_nanoseconds =
      uv.fs_lstat(path)
    return Stat.new(size, kind, mode, device, inode,
                    modified_seconds, modified_nanoseconds)
  catch
    if missing_path(error) then return nil end
    raise
  end
end

function tmpname(): string
  return uv.fs_tmpname()
end

function tmpdir(): string
  return uv.os_tmpdir()
end

function homedir(): string
  return uv.os_homedir()
end

function pwd(): string
  return uv.current_directory("fs.pwd")
end

function chdir(path: string)
  uv.change_directory(path, "fs.chdir")
end

function mkdir(path: string)
  uv.fs_mkdir(path)
end

function unlink(path: string)
  uv.fs_unlink(path)
end

function rmdir(path: string)
  uv.fs_rmdir(path)
end

function rename(from: string, to: string)
  uv.fs_rename(from, to)
end

function list(path: string): {string}
  return uv.fs_list(path)
end

local function RealpathRequest:root()
  realpath_roots[self] = true
end

local function RealpathRequest:unroot()
  realpath_roots[self] = nil
end

local function RealpathRequest:finish()
  local waiter? = self.waiter
  self.waiter = nil
  local failed = false
  local payload: value = nil
  do
    defer ffi.uv_fs_req_cleanup(self.handle)
    local result = ffi.uv_fs_get_result(self.handle) as integer
    if result < 0 then
      failed = true
      payload = uv.make_error(result, "fs.realpath")
    else
      local resolved = ffi.uv_fs_get_ptr(
          self.handle) as foreign const *char
      payload = resolved as string
    end
  catch
    failed = true
    payload = error
  end

  self.failed = failed
  self.payload = payload
  self:unroot()
  if waiter then uv.resume_condition_waiter_from_callback(waiter) end
end

function realpath(path: string): string
  local task = uv.running_task()
  local runtime = task.runtime
  uv.accepting_work(runtime, "resolve a filesystem path")
  local checked = uv.checked_text(path, "fs.realpath")
  local resume_token = uv.ResumeToken.new("fs.realpath")
  local native: owned *uv_fs_t = foreign uv_fs_t.new()
  local callback = function (request: RealpathRequest)
    request:finish()
  end
  local request = RealpathRequest.new(
      native, callback, task, false, nil)
  local cancel_action = function ()
    if request.waiter == task then request.waiter = nil end
  end
  defer cancel_action()
  request:root()
  ffi.uv_req_set_data((native as foreign *uv_fs_t) as foreign *uv_req_t,
                        request as foreign *void)
  local status = ffi.uv_fs_realpath(
      runtime.loop, native, checked, fs_realpath_cb)
  if status < 0 then
    ffi.uv_fs_req_cleanup(native)
    request:unroot()
    raise uv.make_error(status, "fs.realpath")
  end

  uv.suspend(resume_token, cancel_action)
  if request.failed then raise request.payload end
  return request.payload as string
end

local WATCHER_IDLE = 0
local WATCHER_POLLING = 1
local WATCHER_CLEARING = 2
local WATCHER_POLLING_CLEARING = 3

record Watcher
  local runtime: uv.Runtime
  local registrations: {WatchRegistration}
  local paths: {string: WatchRegistration}
  local notifications: {WatcherNotification}
  local waiter: uv.Task?
  local resume_token: uv.ResumeToken?
  local operation_state: integer
end

union WatcherEvent
  created(string)
  deleted(string)
  modified(string)
  error(uv.OperationError)
end

local function Watcher:wake()
  local waiter? = self.waiter
  if not waiter then return end
  local resume_token = self.resume_token
  self.waiter = nil
  self.resume_token = nil
  waiter:resume(resume_token)
end

local function Watcher:wake_from_callback()
  local waiter? = self.waiter
  if not waiter then return end
  self.waiter = nil
  self.resume_token = nil
  uv.resume_condition_waiter_from_callback(waiter)
end

local function Watcher:fail_from_callback(failure: value,
                                            trace: string)
  local waiter? = self.waiter
  if waiter then
    self.waiter = nil
    self.resume_token = nil
    uv.fail_task_at_callback_boundary(waiter, failure, trace)
  else
    uv.report_task_error(failure, trace)
  end
end

local function Watcher:require_active_runtime()
  local active? = uv.active_runtime
  if not active or active ~= self.runtime then
    raise "Watcher Runtime is not active"
  end
  uv.accepting_work(self.runtime, "use a filesystem watcher")
end

local function Watcher:require_running_task(): uv.Task
  self:require_active_runtime()
  return uv.running_task()
end

local function Watcher:remove_registration(
    registration: WatchRegistration)
  if registration.index == 0 then return end
  self.paths[registration.path] = nil
  local index = registration.index
  local last_index = #self.registrations
  local last = self.registrations[last_index]
  self.registrations[index] = last
  last.index = index
  self.registrations[last_index] = nil
  registration.index = 0
  if #self.registrations == 0 then self:wake() end
end

local function WatchRegistration:stop()
  local status = ffi.uv_fs_event_stop(self.handle)
  if status < 0 then raise uv.make_error(status, "fs.watcher.stop") end
end

local function WatchRegistration:close(wait: boolean)
  local handle =
    (self.handle as foreign *uv_fs_event_t) as foreign *uv_handle_t
  if wait then
    uv.wait_handle_close(self.runtime, handle, self,
                         self.runtime_root_index)
  else
    uv.close_handle(self.runtime, handle, self,
                    self.runtime_root_index, nil, nil)
  end
  self.runtime_root_index = 0
end

local function Watcher:receive_event(
    registration: WatchRegistration,
    filename: foreign const *char,
    events: integer, status: integer)
  local copied: string? = nil
  if filename then copied = filename as string end
  self.notifications[#self.notifications + 1] =
    WatcherNotification.new(registration, copied, events, status)
  self:wake_from_callback()
end

local function Watcher:new_registration(
    path: string, directory: boolean): WatchRegistration
  local runtime = self.runtime
  local native: owned *uv_fs_event_t = foreign uv_fs_event_t.new()
  local callback = function (registration: WatchRegistration,
                             filename: foreign const *char,
                             events: integer, status: integer)
    do
      self:receive_event(registration, filename, events, status)
    catch
      self:fail_from_callback(error, traceback)
    end
  end
  local registration = WatchRegistration.new {
    handle = native,
    callback = callback,
    runtime = runtime,
    path = path,
    directory = directory,
    index = 0,
    runtime_root_index = 0,
  }
  registration.runtime_root_index = uv.root_handle(runtime, registration)
  local init_status = ffi.uv_fs_event_init(runtime.loop, native)
  if init_status < 0 then
    uv.unroot_handle(runtime, registration.runtime_root_index)
    registration.runtime_root_index = 0
    raise uv.make_error(init_status, "fs.watcher.init")
  end
  local handle = (native as foreign *uv_fs_event_t) as foreign *uv_handle_t
  ffi.uv_handle_set_data(
      handle, registration as foreign *void)
  local start_status = ffi.uv_fs_event_start(
      native, fs_watcher_event_cb, path, 0)
  if start_status < 0 then
    registration:close(false)
    raise uv.make_error(start_status, "fs.watcher.watch")
  end
  return registration
end

local function optional_realpath(path: string): string?
  do
    return realpath(path)
  catch
    if missing_path(error) then return nil end
    raise
  end
end

local function Watcher:find_registration(
    path: string): WatchRegistration?
  local canonical? = optional_realpath(path)
  if not canonical then return nil end
  return self.paths[canonical]
end

function watcher(): Watcher
  local task = uv.running_task()
  uv.accepting_work(task.runtime, "create a filesystem watcher")
  return Watcher.new(task.runtime, {}, {}, {}, nil, nil, WATCHER_IDLE)
end

function Watcher:watch(path: string)
  self:require_running_task()
  local canonical = realpath(path)
  local existing? = self.paths[canonical]
  if existing then return end

  local info? = stat(canonical)
  if not info then
    raise uv.make_error(ffi.UV_ENOENT as integer,
                        "fs.watcher.watch")
  end
  local registration = self:new_registration(
      canonical, info.kind == "directory")
  registration.index = #self.registrations + 1
  self.registrations[registration.index] = registration
  self.paths[canonical] = registration
end

function Watcher:stop(path: string)
  self:require_running_task()
  if #self.registrations == 0 then return end
  local registration? = self:find_registration(path)
  if not registration then return end
  registration:stop()
  self:remove_registration(registration)
  registration:close(true)
end

function Watcher:is_watching(path: string): boolean
  self:require_running_task()
  if #self.registrations == 0 then return false end
  local registration? = self:find_registration(path)
  return registration ~= nil
end

local function Watcher:begin_clear()
  if self.operation_state == WATCHER_CLEARING or
     self.operation_state == WATCHER_POLLING_CLEARING then
    raise "Watcher already has an active clear"
  end
  if self.operation_state == WATCHER_POLLING then
    self.operation_state = WATCHER_POLLING_CLEARING
  else
    self.operation_state = WATCHER_CLEARING
  end
end

local function Watcher:finish_clear()
  if self.operation_state == WATCHER_POLLING_CLEARING then
    self.operation_state = WATCHER_POLLING
  else
    self.operation_state = WATCHER_IDLE
  end
end

function Watcher:clear()
  self:require_running_task()
  self:begin_clear()
  defer self:finish_clear()
  while #self.registrations > 0 do
    local registration = self.registrations[#self.registrations]
    registration:stop()
    self:remove_registration(registration)
    registration:close(true)
  end
end

local function WatchRegistration:event_path(
    filename: string?): string
  if not self.directory or not filename then return self.path end
  if self.path == "/" then return "/" .. filename end
  return self.path .. "/" .. filename
end

local function Watcher:map_notification(
    notification: WatcherNotification): WatcherEvent
  do
    local registration = notification.registration
    if notification.status < 0 then
      if registration.index > 0 then
        self:remove_registration(registration)
        registration:close(true)
      end
      return WatcherEvent.error(
          uv.make_error(notification.status, "fs.watcher"))
    end

    local path = registration:event_path(notification.filename)
    local renamed =
      (notification.events & (ffi.UV_RENAME as integer)) ~= 0
    local exists = true
    if registration.directory then
      if not lstat(registration.path) then
        path = registration.path
        exists = false
      elseif renamed then
        exists = lstat(path) ~= nil
      end
    else
      exists = lstat(path) ~= nil
    end
    if not exists and path == registration.path and
       registration.index > 0 then
      registration:stop()
      self:remove_registration(registration)
      registration:close(true)
    end
    if not exists then return WatcherEvent.deleted(path) end
    if renamed then return WatcherEvent.created(path) end
    return WatcherEvent.modified(path)
  catch
    if error is uv.OperationError then
      return WatcherEvent.error(error as uv.OperationError)
    end
    raise
  end
end

local function Watcher:drain_notifications(): {WatcherEvent}
  local notifications = self.notifications
  self.notifications = {}
  local events: {WatcherEvent} = {}
  while #notifications > 0 do
    for index = 1, #notifications do
      events[#events + 1] = self:map_notification(notifications[index])
    end

    local crosses_retirement = false
    for index = 1, #self.notifications do
      if self.notifications[index].registration.index == 0 then
        crosses_retirement = true
        break
      end
    end
    if not crosses_retirement then return events end

    -- Preserve callback order by pulling the whole follow-on batch into this
    -- poll when any notification crossed a registration's retirement.
    notifications = self.notifications
    self.notifications = {}
  end
  return events
end

local function Watcher:begin_poll()
  if self.operation_state == WATCHER_CLEARING or
     self.operation_state == WATCHER_POLLING_CLEARING then
    raise "Watcher already has an active clear"
  end
  if self.operation_state == WATCHER_POLLING then
    raise "Watcher already has an active poll"
  end
  self.operation_state = WATCHER_POLLING
end

local function Watcher:finish_poll()
  if self.operation_state == WATCHER_POLLING_CLEARING then
    self.operation_state = WATCHER_CLEARING
  else
    self.operation_state = WATCHER_IDLE
  end
end

function Watcher:poll(): {WatcherEvent}
  local task = self:require_running_task()
  self:begin_poll()
  defer self:finish_poll()

  if #self.notifications > 0 then
    return self:drain_notifications()
  end
  if #self.registrations == 0 then return {} end

  local resume_token = uv.ResumeToken.new("fs.watcher")
  local cancel_action = function ()
    if self.waiter == task and self.resume_token == resume_token then
      self.waiter = nil
      self.resume_token = nil
    end
  end
  defer cancel_action()
  self.resume_token = resume_token
  self.waiter = task
  uv.suspend(resume_token, cancel_action)
  if #self.notifications > 0 then
    return self:drain_notifications()
  end
  return {}
end
