--- Task-aware files, filesystem metadata, path operations, and change notifications.
-- @module titan.fs
-- @usage standard-library-fs.md

local async = import "titan.async"
local uv = import "titan.uv"
local string = import "titan.string"
foreign import "fs_platform.h"

local READ_CHUNK_BYTES = 64 * 1024

--- Application-owned binary file descriptor; close it explicitly after use.
-- @usage standard-library-fs.md
record File
  local handle: integer
  local excess: string
  local pending_operations: integer
end

--- Filesystem metadata with an opaque device/inode identity pair.
-- @field size File size in bytes.
-- @field kind file, directory, symlink, or other.
-- @field mode Host file mode bits.
-- @field device Opaque host device bit pattern; may be negative.
-- @field inode Opaque host inode bit pattern; may be negative.
-- @field modified_seconds Modification timestamp seconds.
-- @field modified_nanoseconds Nanosecond component of the modification timestamp.
-- @usage standard-library-fs.md
record Stat
  size: integer
  kind: string
  mode: integer
  device: integer
  inode: integer
  modified_seconds: integer
  modified_nanoseconds: integer
end

local function operation_error(code: integer, operation: string): async.OperationError
  return async.OperationError(code, uv.err_name(code), uv.strerror(code), operation)
end

local function check_status(code: integer, operation: string)
  if code < 0 then raise operation_error(code, operation) end
end

local function checked_path(path: string, operation: string): string
  if string.find(path, "\0", 1, true) then
    raise operation_error(uv.EINVAL as integer, operation)
  end
  return path
end

-- Each accepted request owns its continuation and borrowed inputs until its
-- callback. Copy all results before cleaning the public request owner.
local record FileOperation<|T|>
  local request: uv.fs_t
  local submit: function (uv.loop_t, uv.fs_t, function (uv.fs_t): ()): (integer)
  local decode: function (uv.fs_t, integer): (T)
  local done: async.Completion<|FileOperation<|T|>, T, integer|>?
  local number: integer
end

local function file_completed<|T|>(request: uv.fs_t)
  local operation: FileOperation<|T|> = request:get_data()
  local done = operation.done as async.Completion<|FileOperation<|T|>, T, integer|>
  local number = operation.number
  request:set_data(nil)
  operation.done = nil
  do
    local copying = false
    do
      local result = uv.fs_get_result(request)
      if result < 0 then
        uv.fs_req_cleanup(request)
        done:reject(number, result)
        return
      end
      copying = true
      local copied = operation.decode(request, result)
      copying = false
      uv.fs_req_cleanup(request)
      done:resolve(number, copied)
    catch
      if copying and error is async.OperationError then
        uv.fs_req_cleanup(request)
        done:reject(number, (error as async.OperationError).code)
        return
      end
      raise
    end
  catch
    uv.fs_req_cleanup(request)
    done:fatal(number, error, traceback)
    raise
  end
end

local function start_file<|T|>(done: async.Completion<|FileOperation<|T|>, T, integer|>, number: integer): uv.req_t?
  local operation = done:context(number)
  operation.done = done
  operation.number = number
  operation.request:set_data(operation)
  local status = operation.submit(async.current_loop(), operation.request, file_completed)
  if status < 0 then
    operation.request:set_data(nil)
    operation.done = nil
    uv.fs_req_cleanup(operation.request)
    done:reject(number, status)
  end
  return nil
end

local function perform<|T|>(operation: string,
    submit: function (uv.loop_t, uv.fs_t, function (uv.fs_t): ()): (integer),
    decode: function (uv.fs_t, integer): (T)): T
  local context = FileOperation<|T|>(uv.fs_t.new(), submit, decode, nil, 0)
  local outcome = async.await_with<|FileOperation<|T|>, T, integer|>(context, start_file)
  case outcome
  when success(result) then return result
  when error(code) then raise operation_error(code, operation)
  end
end

-- Resource-producing completions attach the descriptor to an existing File
-- before calling a decoder whose prologue or result copy may allocate.
local record AcquireOperation<|T|>
  local file: File
  local request: uv.fs_t
  local submit: function (uv.loop_t, uv.fs_t, function (uv.fs_t): ()): (integer)
  local decode: function (uv.fs_t): (T)
  local done: async.Completion<|AcquireOperation<|T|>, T, integer|>?
  local number: integer
end

local function acquired<|T|>(request: uv.fs_t)
  local operation: AcquireOperation<|T|> = request:get_data()
  local done = operation.done as async.Completion<|AcquireOperation<|T|>, T, integer|>
  local number = operation.number
  request:set_data(nil)
  operation.done = nil
  do
    local result = uv.fs_get_result(request)
    if result >= 0 then operation.file.handle = result end
    if result < 0 then
      uv.fs_req_cleanup(request)
      done:reject(number, result)
    else
      local copied = operation.decode(request)
      uv.fs_req_cleanup(request)
      done:resolve(number, copied)
    end
  catch
    uv.fs_req_cleanup(request)
    done:fatal(number, error, traceback)
    raise
  end
end

local function start_acquire<|T|>(done: async.Completion<|AcquireOperation<|T|>, T, integer|>, number: integer): uv.req_t?
  local operation = done:context(number)
  operation.done = done
  operation.number = number
  operation.request:set_data(operation)
  local status = operation.submit(async.current_loop(), operation.request, acquired)
  if status < 0 then
    operation.request:set_data(nil)
    operation.done = nil
    uv.fs_req_cleanup(operation.request)
    done:reject(number, status)
  end
  return nil
end

local function acquire<|T|>(file: File, operation: string,
    submit: function (uv.loop_t, uv.fs_t, function (uv.fs_t): ()): (integer),
    decode: function (uv.fs_t): (T)): T
  local context = AcquireOperation<|T|>(file, uv.fs_t.new(), submit, decode, nil, 0)
  local outcome = async.await_with<|AcquireOperation<|T|>, T, integer|>(context, start_acquire)
  case outcome
  when success(result) then return result
  when error(code) then raise operation_error(code, operation)
  end
end

local function count_result(_: uv.fs_t, count: integer): integer
  return count
end

local function open_flags(mode: string): integer
  if mode == "r" or mode == "rb" then return uv.FS_O_RDONLY as integer end
  if mode == "w" or mode == "wb" then
    return (uv.FS_O_WRONLY as integer) | (uv.FS_O_CREAT as integer) |
           (uv.FS_O_TRUNC as integer)
  end
  if mode == "a" or mode == "ab" then
    return (uv.FS_O_WRONLY as integer) | (uv.FS_O_CREAT as integer) |
           (uv.FS_O_APPEND as integer)
  end
  if mode == "r+" or mode == "r+b" or mode == "rb+" then
    return uv.FS_O_RDWR as integer
  end
  if mode == "w+" or mode == "w+b" or mode == "wb+" then
    return (uv.FS_O_RDWR as integer) | (uv.FS_O_CREAT as integer) |
           (uv.FS_O_TRUNC as integer)
  end
  if mode == "a+" or mode == "a+b" or mode == "ab+" then
    return (uv.FS_O_RDWR as integer) | (uv.FS_O_CREAT as integer) |
           (uv.FS_O_APPEND as integer)
  end
  raise "invalid file mode '" .. mode .. "'"
end

local function File:require_open()
  if self.handle < 0 then raise "File is closed" end
end

--- Open a binary file in a running Task; the caller owns its close.
-- @param path File path without embedded NUL.
-- @param mode r, w, a, or their + forms, with optional b.
-- @return Open File.
-- @usage standard-library-fs.md
function open(path: string, mode: string): File
  checked_path(path, "fs.open")
  local flags = open_flags(mode)
  local file = File(-1, "", 0)
  do
    return acquire<|File|>(file, "fs.open", function (loop: uv.loop_t,
        request: uv.fs_t, callback: function (uv.fs_t): ()): integer
      return uv.fs_open(loop, request, path, flags, 438, callback)
    end, function (_: uv.fs_t): File
      return file
    end)
  catch
    file:close_with("fs.open.abandon.close")
    raise
  end
end

--- Read a byte chunk, returning nil only when no bytes remain at EOF.
-- @param max_bytes Maximum chunk size; nil defaults to 64 KiB.
-- @return Read bytes or nil at EOF.
-- @usage standard-library-fs.md
function File:read(max_bytes: integer?): string?
  self.pending_operations = self.pending_operations + 1
  defer self.pending_operations = self.pending_operations - 1
  local requested = READ_CHUNK_BYTES
  if max_bytes then requested = max_bytes end
  if requested <= 0 then
    raise "file read size must be positive"
  end
  if self.handle < 0 then
    self.excess = ""
    return nil
  end
  if #self.excess > 0 then
    local length = requested
    if length > #self.excess then length = #self.excess end
    local result = string.sub(self.excess, 1, length)
    self.excess = string.sub(self.excess, length + 1)
    return result
  end
  local buffer = uv.buf_t.allocate(requested)
  return perform<|string?|>("fs.read", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_read(loop, request, self.handle, {buffer}, -1, callback)
  end, function (_: uv.fs_t, count: integer): string?
    if count == 0 then return nil end
    return buffer:to_string(count)
  end)
end

--- Read through a delimiter, retaining bytes beyond it for the next read.
-- @param delimiter Nonempty binary delimiter, matched across chunk boundaries.
-- @param chop True removes the delimiter from the returned bytes.
-- @return Delimited bytes or final suffix, or nil at EOF.
-- @usage standard-library-fs.md
function File:read_until(delimiter: string,
                         chop: boolean?): string?
  self.pending_operations = self.pending_operations + 1
  defer self.pending_operations = self.pending_operations - 1
  if self.handle < 0 then
    self.excess = ""
    return nil
  end
  if #delimiter == 0 then
    raise "read delimiter must not be empty"
  end

  local builder = string.writer()
  local tail = ""
  for chunk in self:read do
    local boundary = chunk
    if #tail > 0 then boundary = tail .. chunk end
    local match: integer? = string.find(boundary, delimiter)
    if match then
      local match_first = match
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(string.sub(boundary, 1, result_end))
      end
      self.excess = string.sub(boundary, match_end + 1)
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(string.sub(boundary, 1, committed))
      end
    end
    tail = string.sub(boundary, committed + 1)
  end
  if #tail > 0 then builder:write(tail) end
  local result = builder:drain()
  if #result == 0 then return nil end
  return result
end

--- Write all supplied binary bytes to the file.
-- @param data Bytes to write, including any embedded NUL.
-- @return Number of bytes written.
-- @usage standard-library-fs.md
function File:write(data: string): integer
  self.pending_operations = self.pending_operations + 1
  defer self.pending_operations = self.pending_operations - 1
  self:require_open()
  local length = #data
  if length == 0 then return 0 end
  local buffer = uv.buf_t.from_string(data)
  local offset = 0
  while offset < length do
    local remainder = buffer:slice(offset + 1, length - offset)
    local written = perform<|integer|>("fs.write", function (loop: uv.loop_t,
        request: uv.fs_t, callback: function (uv.fs_t): ()): integer
      return uv.fs_write(loop, request, self.handle, {remainder}, -1, callback)
    end, count_result)
    offset = offset + written
  end
  return offset
end

--- Flush file data to stable storage before returning.
-- @usage standard-library-fs.md
function File:flush()
  self.pending_operations = self.pending_operations + 1
  defer self.pending_operations = self.pending_operations - 1
  self:require_open()
  perform<|integer|>("fs.flush", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_fsync(loop, request, self.handle, callback)
  end, count_result)
end

local record FileClose
  local request: uv.fs_t
  local descriptor: integer
  local accepted: boolean
  local done: async.Completion<|FileClose, integer, integer|>?
  local number: integer
end

local function file_closed(request: uv.fs_t)
  local close: FileClose = request:get_data()
  local done = close.done as async.Completion<|FileClose, integer, integer|>
  local number = close.number
  request:set_data(nil)
  close.done = nil
  do
    local result = uv.fs_get_result(request)
    uv.fs_req_cleanup(request)
    if result < 0 then done:reject(number, result) else done:resolve(number, result) end
  catch
    uv.fs_req_cleanup(request)
    done:fatal(number, error, traceback)
    raise
  end
end

local function start_file_close(done: async.Completion<|FileClose, integer, integer|>, number: integer): uv.req_t?
  local close = done:context(number)
  close.done = done
  close.number = number
  close.request:set_data(close)
  local status = uv.fs_close(async.current_loop(), close.request, close.descriptor, file_closed)
  if status < 0 then
    close.request:set_data(nil)
    close.done = nil
    uv.fs_req_cleanup(close.request)
    done:reject(number, status)
  else
    close.accepted = true
  end
  return nil
end

local function File:close_with(operation: string)
  self.pending_operations = self.pending_operations + 1
  defer self.pending_operations = self.pending_operations - 1
  self.excess = ""
  if self.handle < 0 then return end
  local close = FileClose(uv.fs_t.new(), self.handle, false, nil, 0)
  self.handle = -1
  do
    local outcome = async.await_cleanup_with<|FileClose, integer, integer|>(close, start_file_close)
    case outcome
    when success() then
    when error(code) then raise operation_error(code, operation)
    end
  catch
    if not close.accepted then self.handle = close.descriptor end
    raise
  end
end

--- Close the owned descriptor; repeated terminal closes are safe.
-- @usage standard-library-fs.md
function File:close()
  self:close_with("fs.close")
end

--- Report whether the File descriptor has been closed.
-- @return True after descriptor retirement.
-- @usage standard-library-fs.md
function File:is_closed(): boolean
  return self.handle < 0
end

--- Detach an idle descriptor and retained bytes into a manually owned payload.
-- @return Same-process descriptor and bytes, to be adopted exactly once.
-- @usage standard-library-fs.md#transferring-files
function File:to_transfer_payload(): (...: async.TransferValue)
  self:require_open()
  if self.pending_operations ~= 0 then
    raise "cannot transfer a File with a pending operation"
  end
  local payload: {async.TransferValue} = {
    async.TransferValue.is_integer(self.handle),
    async.TransferValue.is_string(self.excess),
  }
  self.handle = -1
  self.excess = ""
  return ...payload
end

--- Adopt a manually transferred descriptor and its retained read bytes.
-- @param ... Exactly one descriptor integer and one byte string.
-- @return File owning the descriptor; the caller must close it.
-- @usage standard-library-fs.md#transferring-files
function File.from_transfer_payload(...: async.TransferValue): File
  if #... ~= 2 then raise "invalid File transfer payload" end
  local descriptor = -1
  case ...[1]
  when is_integer(number) then descriptor = number
  else raise "invalid File transfer descriptor"
  end
  if descriptor < 0 or descriptor > 2147483647 then
    raise "invalid File transfer descriptor"
  end
  local excess = ""
  case ...[2]
  when is_string(bytes) then excess = bytes
  else raise "invalid File transfer buffer"
  end
  return File(descriptor, excess, 0)
end

--- Read a complete binary file and close the temporary File on every exit.
-- @param path File path.
-- @return Entire file contents.
-- @usage standard-library-fs.md
function read_file(path: string): string
  local file = open(path, "r")
  defer file:close()

  local builder = string.writer()
  for bytes in file:read do
    builder:write(bytes)
  end
  return builder:drain()
end

--- Replace a file with binary bytes and close the temporary File on every exit.
-- @param path Destination path.
-- @param data Complete replacement contents.
-- @usage standard-library-fs.md
function write_file(path: string, data: string)
  local file = open(path, "w")
  defer file:close()
  file:write(data)
end

local function missing_path(failure: value): boolean
  if failure is async.OperationError then
    return (failure as async.OperationError).code == uv.ENOENT as integer
  end
  return false
end

local function stat_result(request: uv.fs_t, _: integer): Stat
  local info = uv.fs_get_statbuf(request)
  local kind = "other"
  local file_type = info.st_mode & (uv.S_IFMT as integer)
  if file_type == uv.S_IFREG as integer then kind = "file"
  elseif file_type == uv.S_IFDIR as integer then kind = "directory"
  elseif uv.S_IFLNK ~= nil and file_type == uv.S_IFLNK as integer then kind = "symlink"
  end
  return Stat(info.st_size, kind, info.st_mode, info.st_dev, info.st_ino,
              info.st_mtim.tv_sec, info.st_mtim.tv_nsec)
end

--- Read metadata for a path, following symbolic links.
-- @param path Path to inspect.
-- @return Metadata, or nil for a missing path; other errors raise.
-- @usage standard-library-fs.md
function stat(path: string): Stat?
  checked_path(path, "fs.stat")
  do
    return perform<|Stat|>("fs.stat", function (loop: uv.loop_t,
        request: uv.fs_t, callback: function (uv.fs_t): ()): integer
      return uv.fs_stat(loop, request, path, callback)
    end, stat_result)
  catch
    if missing_path(error) then return nil end
    raise
  end
end

--- Read metadata for a path without following its final symbolic link.
-- @param path Path to inspect.
-- @return Metadata, or nil for a missing path; other errors raise.
-- @usage standard-library-fs.md
function lstat(path: string): Stat?
  checked_path(path, "fs.lstat")
  do
    return perform<|Stat|>("fs.lstat", function (loop: uv.loop_t,
        request: uv.fs_t, callback: function (uv.fs_t): ()): integer
      return uv.fs_lstat(loop, request, path, callback)
    end, stat_result)
  catch
    if missing_path(error) then return nil end
    raise
  end
end

local function sized_path(operation: string,
    query: function (integer): (integer, string?, integer)): string
  local capacity = 256
  while true do
    local status, result?, actual = query(capacity)
    if status >= 0 then return result as string end
    if status == uv.ENOBUFS as integer then capacity = actual
    elseif status == uv.ENOENT as integer then return result as string
    else raise operation_error(status, operation)
    end
  end
end

--- Create an empty temporary file and return its caller-owned path.
-- @return Temporary path whose file must be removed by the caller.
-- @usage standard-library-fs.md
function tmpname(): string
  local template = sized_path("fs.tmpname", uv.os_tmpdir) .. "/titan-fs-XXXXXX"
  local file = File(-1, "", 0)
  defer file:close_with("fs.tmpname.close")
  return acquire<|string|>(file, "fs.tmpname", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_mkstemp(loop, request, template, callback)
  end, function (request: uv.fs_t): string
    return uv.fs_get_path(request) as string
  end)
end

--- Return the operating-system temporary directory.
-- @return Directory path.
-- @usage standard-library-fs.md
function tmpdir(): string
  return sized_path("os.tmpdir", uv.os_tmpdir)
end

--- Return the current user home directory.
-- @return Directory path.
-- @usage standard-library-fs.md
function homedir(): string
  return sized_path("os.homedir", uv.os_homedir)
end

--- Return the process current working directory.
-- @return Directory path.
-- @usage standard-library-fs.md
function pwd(): string
  return sized_path("fs.pwd", uv.cwd)
end

--- Change the process-wide working directory.
-- @param path New working directory; coordinate and restore temporary changes.
-- @usage standard-library-fs.md
function chdir(path: string)
  check_status(uv.chdir(checked_path(path, "fs.chdir")), "fs.chdir")
end

--- Create a directory.
-- @param path Filesystem path without embedded NUL.
-- @usage standard-library-fs.md
function mkdir(path: string)
  checked_path(path, "fs.mkdir")
  perform<|integer|>("fs.mkdir", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_mkdir(loop, request, path, 511, callback)
  end, count_result)
end

--- Remove a file or symbolic link.
-- @param path Filesystem path without embedded NUL.
-- @usage standard-library-fs.md
function unlink(path: string)
  checked_path(path, "fs.unlink")
  perform<|integer|>("fs.unlink", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_unlink(loop, request, path, callback)
  end, count_result)
end

--- Remove an empty directory.
-- @param path Filesystem path without embedded NUL.
-- @usage standard-library-fs.md
function rmdir(path: string)
  checked_path(path, "fs.rmdir")
  perform<|integer|>("fs.rmdir", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_rmdir(loop, request, path, callback)
  end, count_result)
end

--- Rename or move a filesystem entry.
-- @param from Existing path.
-- @param to Destination path.
-- @usage standard-library-fs.md
function rename(from: string, to: string)
  checked_path(from, "fs.rename")
  checked_path(to, "fs.rename")
  perform<|integer|>("fs.rename", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_rename(loop, request, from, to, callback)
  end, count_result)
end

--- List a directory without dot entries or an ordering guarantee.
-- @param path Directory to list.
-- @return Entry names excluding the dot and parent-directory entries.
-- @usage standard-library-fs.md
function list(path: string): {string}
  checked_path(path, "fs.list")
  return perform<|{string}|>("fs.list", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_scandir(loop, request, path, 0, callback)
  end, function (request: uv.fs_t, _: integer): {string}
    local names: {string} = {}
    while true do
      local status, entry? = uv.fs_scandir_next(request)
      if status == uv.EOF as integer then break end
      check_status(status, "fs.list")
      names[#names + 1] = entry.name
    end
    return names
  end)
end

--- Resolve a path to its canonical absolute filesystem path.
-- @param path Existing path to resolve.
-- @return Canonical absolute path.
-- @usage standard-library-fs.md
function realpath(path: string): string
  checked_path(path, "fs.realpath")
  return perform<|string|>("fs.realpath", function (loop: uv.loop_t,
      request: uv.fs_t, callback: function (uv.fs_t): ()): integer
    return uv.fs_realpath(loop, request, path, callback)
  end, function (request: uv.fs_t, _: integer): string
    return uv.fs_get_string(request)
  end)
end

local record WatchRegistration
  local handle: uv.fs_event_t
  local view: uv.handle_t
  local path: string
  local directory: boolean
  local index: integer
  local close_done: async.Completion<|WatchRegistration, boolean, integer|>?
  local close_number: integer
end

local record WatcherNotification
  local registration: WatchRegistration
  local filename: string?
  local events: integer
  local status: integer
end

local WATCHER_IDLE = 0
local WATCHER_POLLING = 1
local WATCHER_CLEARING = 2
local WATCHER_POLLING_CLEARING = 3

--- Runtime-bound change watcher; Tasks must coordinate mutations externally.
-- @usage standard-library-fs.md
record Watcher
  local loop: uv.loop_t
  local registrations: {WatchRegistration}
  local paths: {string: WatchRegistration}
  local subscription: async.BufferedSubscription<|WatcherNotification, integer|>
  local publish: function (WatcherNotification): (boolean)
  local operation_state: integer
end

--- One classified filesystem notification or recoverable watcher error.
-- @field created Path created according to notification classification.
-- @field deleted Path deleted according to notification classification.
-- @field modified Path modified according to notification classification.
-- @field error OperationError from notification classification.
-- @usage standard-library-fs.md
union WatcherEvent
  created(string)
  deleted(string)
  modified(string)
  error(async.OperationError)
end

local function Watcher:require_running_task()
  local loop: uv.loop_t? = nil
  do loop = async.current_loop()
  catch raise "Watcher Runtime is not active" end
  if loop ~= self.loop then raise "Watcher Runtime is not active" end
  async.running()
end

local function Watcher:remove_registration(
    registration: WatchRegistration)
  if registration.index == 0 then return end
  self.paths[registration.path] = nil
  local index = registration.index
  local last_index = #self.registrations
  local last = self.registrations[last_index]
  self.registrations[index] = last
  last.index = index
  self.registrations[last_index] = nil
  registration.index = 0
  if #self.registrations == 0 then self.subscription:wake_batch() end
end

local function WatchRegistration:stop()
  check_status(uv.fs_event_stop(self.handle), "fs.watcher.stop")
end

local function watch_closed(handle: uv.handle_t)
  local registration: WatchRegistration = uv.handle_get_data(handle)
  local done = registration.close_done as async.Completion<|WatchRegistration, boolean, integer|>
  local number = registration.close_number
  registration.close_done = nil
  uv.handle_set_data(handle, nil)
  do done:resolve(number, true)
  catch done:fatal(number, error, traceback); raise end
end

local function start_watch_close(done: async.Completion<|WatchRegistration, boolean, integer|>, number: integer): uv.req_t?
  local registration = done:context(number)
  registration.close_done = done
  registration.close_number = number
  uv.handle_set_data(registration.view, registration)
  do uv.close(registration.view, watch_closed)
  catch
    registration.close_done = nil
    uv.handle_set_data(registration.view, nil)
    raise
  end
  return nil
end

local function WatchRegistration:close(wait: boolean)
  if not wait then uv.close(self.view); return end
  async.await_cleanup_with<|WatchRegistration, boolean, integer|>(self, start_watch_close)
end

local function Watcher:retire_registration(registration: WatchRegistration)
  if registration.index == 0 then return end
  -- Empty-batch wake can fail while preparing its scheduled continuation.
  -- Keep native close armed before removing the last domain-owned index.
  defer registration:close(true)
  self:remove_registration(registration)
end

local function Watcher:new_registration(
    path: string, directory: boolean): WatchRegistration
  local handle = uv.fs_event_t.new()
  local registration = WatchRegistration(handle, handle:as_handle_t(), path,
                                          directory, #self.registrations + 1, nil, 0)
  local callback = function (_: uv.fs_event_t, filename: string?,
                             events: integer, status: integer)
    self.publish(WatcherNotification(registration, filename, events, status))
  end
  -- Publish domain indexes before native acceptance; no callback can run until
  -- the next loop turn. Failed initialization/start rolls back these indexes.
  self.registrations[registration.index] = registration
  do self.paths[path] = registration
  catch
    self.registrations[registration.index] = nil
    registration.index = 0
    raise
  end
  local initialized = false
  do
    local init_status = uv.fs_event_init(self.loop, handle)
    if init_status < 0 then raise operation_error(init_status, "fs.watcher.init") end
    initialized = true
    local start_status = uv.fs_event_start(handle, callback, path, 0)
    if start_status < 0 then raise operation_error(start_status, "fs.watcher.watch") end
  catch
    defer if initialized then registration:close(false) end
    self:remove_registration(registration)
    raise
  end
  return registration
end

local function optional_realpath(path: string): string?
  do
    return realpath(path)
  catch
    if missing_path(error) then return nil end
    raise
  end
end

local function Watcher:find_registration(
    path: string): WatchRegistration?
  local canonical? = optional_realpath(path)
  if not canonical then return nil end
  return self.paths[canonical]
end

--- Create a reusable filesystem watcher in the current Task Runtime.
-- @return Watcher bound to the current Runtime.
-- @usage standard-library-fs.md
function watcher(): Watcher
  async.running()
  local publish: (function (WatcherNotification): (boolean))? = nil
  local subscription = async.BufferedSubscription<|WatcherNotification, integer|>(
      function (send: function (WatcherNotification): (boolean),
          _fail: function (integer): (boolean), _finish: function (): (boolean)):
          async.SubscriptionActions<|WatcherNotification|>
        publish = send
        -- Registrations are dynamic domain resources. clear retires those
        -- handles but keeps this notification transport reusable.
        return async.SubscriptionActions<|WatcherNotification|>(function () end,
            function (_drain: function (): (async.SubscriptionBatch<|WatcherNotification|>)) end)
      end)
  return Watcher(async.current_loop(), {}, {}, subscription, publish,
                 WATCHER_IDLE)
end

--- Start watching an existing canonical file or directory path.
-- @param path Existing path; duplicate registrations are ignored.
-- @usage standard-library-fs.md
function Watcher:watch(path: string)
  self:require_running_task()
  local canonical = realpath(path)
  local existing? = self.paths[canonical]
  if existing then return end

  local info? = stat(canonical)
  if not info then
    raise operation_error(uv.ENOENT as integer,
                        "fs.watcher.watch")
  end
  self:new_registration(canonical, info.kind == "directory")
end

--- Stop and retire a matching path registration.
-- @param path Registered path; an absent registration is ignored.
-- @usage standard-library-fs.md
function Watcher:stop(path: string)
  self:require_running_task()
  if #self.registrations == 0 then return end
  local registration? = self:find_registration(path)
  if not registration then return end
  registration:stop()
  self:retire_registration(registration)
end

--- Check whether a path currently has a watcher registration.
-- @param path Path to resolve and query.
-- @return True for a live registration.
-- @usage standard-library-fs.md
function Watcher:is_watching(path: string): boolean
  self:require_running_task()
  if #self.registrations == 0 then return false end
  local registration? = self:find_registration(path)
  return registration ~= nil
end

local function Watcher:begin_clear()
  if self.operation_state == WATCHER_CLEARING or
     self.operation_state == WATCHER_POLLING_CLEARING then
    raise "Watcher already has an active clear"
  end
  if self.operation_state == WATCHER_POLLING then
    self.operation_state = WATCHER_POLLING_CLEARING
  else
    self.operation_state = WATCHER_CLEARING
  end
end

local function Watcher:finish_clear()
  if self.operation_state == WATCHER_POLLING_CLEARING then
    self.operation_state = WATCHER_POLLING
  else
    self.operation_state = WATCHER_IDLE
  end
end

--- Stop and close all registrations while retaining the reusable watcher.
-- @usage standard-library-fs.md
function Watcher:clear()
  self:require_running_task()
  self:begin_clear()
  defer self:finish_clear()
  while #self.registrations > 0 do
    local registration = self.registrations[#self.registrations]
    registration:stop()
    self:retire_registration(registration)
  end
end

local function WatchRegistration:event_path(
    filename: string?): string
  if not self.directory or not filename then return self.path end
  local separator = ffi.TITAN_FS_DIRSEP as string
  if string.sub(self.path, -1) == separator then return self.path .. filename end
  return self.path .. separator .. filename
end

local function Watcher:map_notification(
    notification: WatcherNotification): WatcherEvent
  do
    local registration = notification.registration
    if notification.status < 0 then
      if registration.index > 0 then
        self:retire_registration(registration)
      end
      return WatcherEvent.error(
          operation_error(notification.status, "fs.watcher"))
    end

    local path = registration:event_path(notification.filename)
    local renamed =
      (notification.events & (uv.RENAME as integer)) ~= 0
    local exists = true
    if registration.directory then
      if not lstat(registration.path) then
        path = registration.path
        exists = false
      elseif renamed then
        exists = lstat(path) ~= nil
      end
    else
      exists = lstat(path) ~= nil
    end
    if not exists and path == registration.path and
       registration.index > 0 then
      registration:stop()
      self:retire_registration(registration)
    end
    if not exists then return WatcherEvent.deleted(path) end
    if renamed then return WatcherEvent.created(path) end
    return WatcherEvent.modified(path)
  catch
    if error is async.OperationError then
      return WatcherEvent.error(error as async.OperationError)
    end
    raise
  end
end

local function Watcher:drain_notifications(
    notifications: async.SubscriptionBatch<|WatcherNotification|>): {WatcherEvent}
  local events: {WatcherEvent} = {}
  while notifications.count > 0 do
    for index = 1, notifications.count do
      events[#events + 1] = self:map_notification(notifications:get(index))
    end
    -- Pull the entire follow-on FIFO only if any callback crossed retirement;
    -- live-only notifications stay queued for the next poll.
    local following? = self.subscription:drain_if(function (item: WatcherNotification): boolean
      return item.registration.index == 0
    end)
    if following == nil then return events end
    notifications = following
  end
  return events
end

local function Watcher:begin_poll()
  if self.operation_state == WATCHER_CLEARING or
     self.operation_state == WATCHER_POLLING_CLEARING then
    raise "Watcher already has an active clear"
  end
  if self.operation_state == WATCHER_POLLING then
    raise "Watcher already has an active poll"
  end
  self.operation_state = WATCHER_POLLING
end

local function Watcher:finish_poll()
  if self.operation_state == WATCHER_POLLING_CLEARING then
    self.operation_state = WATCHER_CLEARING
  else
    self.operation_state = WATCHER_IDLE
  end
end

--- Wait for notifications and classify one public event per raw notification.
-- @return Ordered event batch; notifications are hints and classification may suspend.
-- @usage standard-library-fs.md
function Watcher:poll(): {WatcherEvent}
  self:require_running_task()
  self:begin_poll()
  defer self:finish_poll()
  if #self.registrations == 0 then
    return self:drain_notifications(self.subscription:drain_pending())
  end
  case self.subscription:next_batch()
  when batch(notifications) then return self:drain_notifications(notifications)
  when error(code) then raise operation_error(code, "fs.watcher")
  else return {}
  end
end
