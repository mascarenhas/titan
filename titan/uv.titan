    previous_control = nil,
    callback_recorded = false,
    callback_result = 0,
    callback_aborted = false,
    result_pointer = nil,
    result_freed = false,
  }
  return control
end

local function allocate_dns_owner(runtime: Runtime,
                                  operation: NetOperation):
                                  (uv_getaddrinfo_t,
                                   ffi.titan_ffi_void_ptr)
