    kind = kind,
    owner = nil,
    process = process,
    close_requested = false,
    close_callback_seen = false,
    callback_aborted = false,
    read_active = false,
    read_terminal = TCP_READ_OPEN,
    read_error = nil,
    read_waiter = nil,
    read_epoch = 0,
    read_bytes = nil,
    output_head = nil,
    output_tail = nil,
    output_current = nil,
    close_waiter = nil,
    shutdown_requested = false,
    write_shutdown = false,
  }
