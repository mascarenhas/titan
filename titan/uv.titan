-- Fixed eight-slot owner layout consumed by titan_uv.c.
record uv_timer_t
  local handle: *libuv.uv_timer_t
  local storage: value
  local main_thread: value
  local module: value
  local dispatcher: (uv_timer_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local root: value
  local metadata: TimerControl
  local buffer: nil
end

-- One-shot signal watchers are private fixed-layout native callback owners.
-- They remain rooted in their Runtime list through stop + close callback.
local record uv_signal_t
  local handle: *libuv.uv_signal_t
  local storage: value
  local main_thread: value
  local module: value
  local dispatcher: (uv_signal_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local root: Task?
  local metadata: SignalControl
  local buffer: SignalSpec?
end

-- Persistent process handles are the only process resource that crosses the
-- private os/uv bridge.  All native callback owners keep the same exact eight
-- slots consumed by titan_uv.c.
record uv_process_t
  local handle: *libuv.uv_process_t
  local storage: value
  local main_thread: value
  local module: value
  local dispatcher: (uv_process_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local root: ProcessControl?
  local metadata: ProcessControl
  local buffer: value
end

local record uv_pipe_t
  local handle: *libuv.uv_pipe_t
  local storage: value
  local main_thread: value
  local module: value
  local dispatcher: (uv_pipe_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local root: ProcessControl?
  local metadata: PipeControl
  local buffer: value
end

local record uv_pipe_write_t
  local handle: *libuv.uv_write_t
