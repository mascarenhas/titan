  -- The wrapper is rooted on the Lua stack until its ProcessControl has been
  -- published in the Runtime list and the callback navigation pointer exists.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_process_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

