local function allocate_tcp_owner(runtime: Runtime):
                                  (uv_tcp_t, ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_tcp_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control: TcpControl = {
    runtime = runtime,
    generation = runtime.generation,
    lifecycle = TCP_ALLOCATED,
    server = false,
    owner = nil,
    next_control = nil,
    previous_control = nil,
    connect_pending = false,
    close_requested = false,
    shutdown_requested = false,
    write_shutdown = false,
    read_active = false,
    read_terminal = TCP_READ_OPEN,
    read_error = nil,
    read_waiter = nil,
    read_epoch = 0,
    read_bytes = nil,
    read_queue = {},
    output_head = nil,
    output_tail = nil,
    output_current = nil,
    close_waiter_head = nil,
    close_waiter_tail = nil,
    accept_waiter = nil,
    accept_epoch = 0,
    accept_queue = {},
    accept_head = 1,
    accept_tail = 0,
    accept_count = 0,
    accept_capacity = 0,
    accept_error = nil,
    setup_operation = nil,
  }
  local owner: uv_tcp_t = {
    handle = memory as *libuv.uv_tcp_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = tcp_dispatch,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_tcp_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function discard_tcp_storage(tcp: uv_tcp_t)
  local control = tcp.metadata
  if not control.owner then return end
  -- Unlink while every owner field is still intact.  After unlinking,
  -- only non-raising field clears remain in this frame.
  unlink_tcp_control(control)
  tcp.handle = nil
  tcp.storage = nil
  control.lifecycle = TCP_CLOSED
  control.owner = nil
end

local function initialize_tcp(runtime: Runtime): (uv_tcp_t, integer)
  local tcp, pointer = allocate_tcp_owner(runtime)
  local status = shim.titan_uvshim_tcp_init(runtime.loop.handle, tcp.handle,
                                            pointer)
  if (status as integer) < 0 then
    -- The handle was never accepted by libuv.  Inline terminal unlink so an
    -- emergency longjmp cannot strand an owner for which no callback is owed.
    local control = tcp.metadata
    local previous? = control.previous_control
    local next? = control.next_control
    if previous then
      previous.next_control = next
    else
      runtime.tcp_head = next
    end
    if next then
      next.previous_control = previous
    end
    control.previous_control = nil
    control.next_control = nil
    tcp.handle = nil
    tcp.storage = nil
    control.lifecycle = TCP_CLOSED
    control.owner = nil
    return tcp, status as integer
  end
  tcp.metadata.lifecycle = TCP_INITIALIZED
  return tcp, 0
end

local function start_tcp_close(tcp: uv_tcp_t)
  local control = tcp.metadata
  control.close_requested = true
  if control.lifecycle == TCP_CLOSED or
      control.lifecycle == TCP_CLOSING then return end
  if control.lifecycle == TCP_ALLOCATED then
    discard_tcp_storage(tcp)
    return
  end
  if control.read_active then
    shim.titan_uvshim_tcp_read_stop(tcp.handle)
    control.read_active = false
  end
  control.read_bytes = nil
  control.lifecycle = TCP_CLOSING
  shim.titan_uvshim_tcp_close(tcp.handle)
end

local function new_process_control(runtime: Runtime): ProcessControl
  local control: ProcessControl = {
    runtime = runtime,
    generation = runtime.generation,
    lifecycle = PROCESS_ALLOCATED,
    owner = nil,
    linked = false,
    next_control = nil,
    previous_control = nil,
    stdin_pipe = nil,
    stdout_pipe = nil,
    stderr_pipe = nil,
    spawn_operation = nil,
    pending_failure = nil,
    wait_task = nil,
    wait_epoch = 0,
    dispose_task = nil,
    dispose_epoch = 0,
    exit_seen = false,
    exit_status = 0,
    term_signal = 0,
    callback_aborted = false,
    shutdown_started = false,
    kill_sent = false,
    grace_owner = nil,
    grace_fired = false,
    grace_callback_aborted = false,
  }
  return control
end

local function allocate_process_owner(runtime: Runtime):
                                      (uv_process_t,
                                       ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_process_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_process_control(runtime)
  local owner: uv_process_t = {
    handle = memory as *libuv.uv_process_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = process_dispatch,
    metadata = control,
    buffer = nil,
  }
  -- The wrapper is rooted on the Lua stack until its ProcessControl has been
  -- published in the Runtime list and the callback navigation pointer exists.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_process_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function new_pipe_control(process: ProcessControl,
                                kind: integer): PipeControl
  local control: PipeControl = {
    runtime = process.runtime,
    lifecycle = PIPE_ALLOCATED,
    kind = kind,
    owner = nil,
    process = process,
    callback_aborted = false,
    read_active = false,
    read_terminal = TCP_READ_OPEN,
    read_error = nil,
    read_waiter = nil,
    read_epoch = 0,
    read_bytes = nil,
    read_queue = {},
    output_head = nil,
    output_tail = nil,
    output_current = nil,
    close_waiter = nil,
    shutdown_requested = false,
    write_shutdown = false,
  }
  return control
end

local function allocate_pipe_owner(process: ProcessControl,
                                   kind: integer):
                                   (uv_pipe_t,
                                    ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_pipe_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_pipe_control(process, kind)
  local owner: uv_pipe_t = {
    handle = memory as *libuv.uv_pipe_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = pipe_dispatch,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  if kind == PIPE_STDIN then
    process.stdin_pipe = owner
  elseif kind == PIPE_STDOUT then
    process.stdout_pipe = owner
  else
    process.stderr_pipe = owner
  end
  lua.lua_settop(L, top)
  return owner, pointer
end

local function discard_pipe_storage(pipe: uv_pipe_t)
  local control = pipe.metadata
  if control.lifecycle == PIPE_CLOSED then return end
  control.lifecycle = PIPE_CLOSED
  pipe.handle = nil
  pipe.storage = nil
  control.owner = nil
end

local function start_pipe_close(pipe: uv_pipe_t)
  local control = pipe.metadata
  if control.lifecycle == PIPE_CLOSED or
      control.lifecycle == PIPE_CLOSING then return end
  if control.read_active then
    shim.titan_uvshim_pipe_read_stop(pipe.handle)
    control.read_active = false
  end
  control.read_bytes = nil
  if control.lifecycle == PIPE_ALLOCATED then
    discard_pipe_storage(pipe)
    return
  end
  control.lifecycle = PIPE_CLOSING
  shim.titan_uvshim_pipe_close(pipe.handle)
end

local function discard_process_storage(process: uv_process_t)
  local control = process.metadata
  if control.lifecycle == PROCESS_CLOSED then return end
  control.lifecycle = PROCESS_CLOSED
  process.handle = nil
  process.storage = nil
  control.owner = nil
end

local function start_process_close(process: uv_process_t)
  local control = process.metadata
  if control.lifecycle == PROCESS_CLOSED or
      control.lifecycle == PROCESS_CLOSING then return end
  if control.lifecycle == PROCESS_ALLOCATED then
    discard_process_storage(process)
    return
  end
  control.lifecycle = PROCESS_CLOSING
  shim.titan_uvshim_process_close(process.handle)
end

local function new_process_request_control(runtime: Runtime,
                                           operation: ProcessOperation):
                                           ProcessRequestControl
  local control: ProcessRequestControl = {
    runtime = runtime,
    lifecycle = PROCESS_OWNER_ALLOCATED,
    owner = nil,
    operation = operation,
    next_control = nil,
    previous_control = nil,
  }
  return control
end

local function allocate_pipe_write_owner(runtime: Runtime,
                                         operation: ProcessOperation):
                                         (uv_pipe_write_t,
                                          ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_write_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_process_request_control(runtime, operation)
  local owner: uv_pipe_write_t = {
    handle = memory as *libuv.uv_write_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = pipe_write_dispatch,
    metadata = control,
    buffer = operation.prepared_buffer,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_process_request(control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function retire_process_request(control: ProcessRequestControl)
  if control.lifecycle == PROCESS_OWNER_RETIRED then return end
  local owner? = control.owner
  local operation = control.operation
  if not owner then
    unlink_process_request(control)
  else
    local owner = owner
    unlink_process_request(control)
    owner.handle = nil
    owner.storage = nil
    owner.buffer = nil
  end
  if operation.owner == owner then operation.owner = nil end
  control.owner = nil
  control.lifecycle = PROCESS_OWNER_RETIRED
end

local function allocate_process_grace(control: ProcessControl):
                                      (uv_process_grace_t,
                                       ffi.titan_ffi_void_ptr)
  local runtime = control.runtime
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_timer_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local owner: uv_process_grace_t = {
    handle = memory as *libuv.uv_timer_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = process_grace_dispatch,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.grace_owner = owner
  lua.lua_settop(L, top)
  return owner, pointer
end

local function close_process_grace(control: ProcessControl)
  if not control.grace_owner then return end
  local owner = control.grace_owner
  if owner.handle == nil then return end
  if (shim.titan_uvshim_timer_is_closing(owner.handle) as integer) == 0 then
    libuv.uv_timer_stop(owner.handle)
    shim.titan_uvshim_timer_close(owner.handle)
  end
end

local function start_process_grace(control: ProcessControl): integer
  if control.grace_owner then return 0 end
  local owner, pointer = allocate_process_grace(control)
  local status = libuv.uv_timer_init(control.runtime.loop.handle,
                                    owner.handle)
  if (status as integer) < 0 then
    control.grace_owner = nil
    owner.handle = nil
    owner.storage = nil
    return status as integer
  end
  shim.titan_uvshim_timer_set_data(owner.handle, pointer)
  status = libuv.uv_timer_start(owner.handle, shim.titan_uvshim_timer_cb,
                               PROCESS_GRACE_MILLISECONDS, 0)
  if (status as integer) < 0 then
    shim.titan_uvshim_timer_close(owner.handle)
  end
  return status as integer
end

local function free_dns_result(control: NetRequestControl)
  if control.result_pointer ~= nil then
    shim.titan_uvshim_addrinfo_free(control.result_pointer)
    control.result_pointer = nil
  end
end

local function retire_net_control(control: NetRequestControl)
  if control.lifecycle == NET_OWNER_RETIRED then return end
  free_dns_result(control)
  local owner = control.owner
  local operation = control.operation
  if owner == nil then
    unlink_net_control(control)
  elseif control.kind == NET_OWNER_DNS then
    local owner: uv_getaddrinfo_t = owner
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
  elseif control.kind == NET_OWNER_CONNECT then
    local owner: uv_connect_t = owner
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
  elseif control.kind == NET_OWNER_WRITE then
    local owner: uv_write_t = owner
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
    owner.buffer = nil
  else
    local owner: uv_shutdown_t = owner
    unlink_net_control(control)
    owner.handle = nil
    owner.storage = nil
  end
  if operation.owner == owner then operation.owner = nil end
  control.owner = nil
  control.lifecycle = NET_OWNER_RETIRED
end

local function clean_fs_owner(owner: uv_fs_t)
  if owner.metadata.lifecycle ~= FS_OWNER_CLEANED then
    libuv.uv_fs_req_cleanup(owner.handle)
  end
  owner.metadata.lifecycle = FS_OWNER_CLEANED
end

local function fs_operation_name(kind: integer): string
  if kind == FS.stat then return "fs.stat" end
  if kind == FS.open then return "fs.open" end
  if kind == FS.read then return "fs.read" end
  if kind == FS.write then return "fs.write" end
  if kind == FS.flush then return "fs.flush" end
  if kind == FS.close or kind == FS.internal_close then return "fs.close" end
  if kind == FS.mkdir then return "fs.mkdir" end
  if kind == FS.unlink then return "fs.unlink" end
  if kind == FS.rmdir then return "fs.rmdir" end
  if kind == FS.rename then return "fs.rename" end
  if kind == FS.list then return "fs.list" end
  return "fs.unknown"
end

local function fs_operation_subject(operation: FsOperation): string?
  if operation.file then
    return operation.file.subject
  elseif operation.path then
    return operation.path.source
  end
  return nil
end

local function fs_open_flags(mode: string): integer
  local read_only = libuv.UV_FS_O_RDONLY as integer
  local write_only = libuv.UV_FS_O_WRONLY as integer
  local read_write = libuv.UV_FS_O_RDWR as integer
  local create = libuv.UV_FS_O_CREAT as integer
  local truncate = libuv.UV_FS_O_TRUNC as integer
  local append = libuv.UV_FS_O_APPEND as integer
  if mode == "r" or mode == "rb" then return read_only end
  if mode == "w" or mode == "wb" then
    return write_only | create | truncate
  end
  if mode == "a" or mode == "ab" then
    return write_only | create | append
  end
  if mode == "r+" or mode == "r+b" or mode == "rb+" then
    return read_write
  end
  if mode == "w+" or mode == "w+b" or mode == "wb+" then
    return read_write | create | truncate
  end
  if mode == "a+" or mode == "a+b" or mode == "ab+" then
    return read_write | create | append
  end
  raise "invalid file mode '" .. mode .. "'"
end

local function fs_operation_runtime(operation: FsOperation): Runtime
  if operation.file then
    return operation.file.runtime
  end
  return operation.task.runtime
end

local function submit_fs_operation(operation: FsOperation):
                                   (uv_fs_t, integer)
  local runtime = fs_operation_runtime(operation)
  local open_flags = 0
  if operation.kind == FS.open then
    open_flags = fs_open_flags(operation.data)
  end
  -- Finish every allocating preparation before publishing a request owner as
  -- submitted. If preparation raises, libuv has seen no request and therefore
  -- owes no callback; the operation remains rooted by its Task/File for the
  -- outer fatal path without stranding a fake submitted owner.
  operation.prepared_buffer = nil
  if operation.kind == FS.read then
    operation.prepared_buffer = allocate_read_buffer(operation.maximum)
  elseif operation.kind == FS.write then
    if not operation.write_bytes then
      operation.write_bytes = copy_bytes(operation.data)
    end
    local bytes = operation.write_bytes
    local write_length = bytes.length - operation.write_offset
    operation.prepared_buffer =
        make_buffer(bytes, operation.write_offset, write_length)
  end
  -- Validate private operation state and cache every borrowed native argument
  -- before publishing the owner. The fast path of a record cast does not
  -- allocate, but its invariant-failure path raises; after publication that
  -- could otherwise strand a request that libuv has never seen.
  local kind = operation.kind
  local loop_handle: *libuv.uv_loop_t = runtime.loop.handle
  local path_data: *ffi.titan_ffi_char = nil
  local second_path_data: *ffi.titan_ffi_char = nil
  local file_handle: libuv.uv_file = -1 as libuv.uv_file
  local buffer_handle: *libuv.uv_buf_t = nil
  if kind == FS.stat or kind == FS.open or kind == FS.mkdir or
     kind == FS.unlink or kind == FS.rmdir or kind == FS.list then
    path_data = operation.path.bytes.data
  elseif kind == FS.rename then
    path_data = operation.path.bytes.data
    second_path_data = operation.second_path.bytes.data
  elseif kind == FS.read or kind == FS.write then
    file_handle = operation.file.handle
    buffer_handle = operation.prepared_buffer.handle
  elseif kind == FS.flush or kind == FS.close or
         kind == FS.internal_close then
    file_handle = operation.file.handle
  else
    raise "cannot submit unsupported filesystem operation"
  end
  local owner = allocate_fs_owner(runtime, operation)
  if operation.prepared_buffer then
    owner.buffer = operation.prepared_buffer
    operation.prepared_buffer = nil
  end
  owner.metadata.lifecycle = FS_OWNER_SUBMITTED
  operation.owner = owner
  local status: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
  if kind == FS.stat then
    status = libuv.uv_fs_stat(loop_handle, owner.handle, path_data,
                             shim.titan_uvshim_fs_cb)
  elseif kind == FS.open then
    status = libuv.uv_fs_open(loop_handle, owner.handle, path_data,
        open_flags as ffi.titan_ffi_int,
        438 as ffi.titan_ffi_int, shim.titan_uvshim_fs_cb)
  elseif kind == FS.read then
    status = libuv.uv_fs_read(loop_handle, owner.handle, file_handle,
        buffer_handle, 1, -1, shim.titan_uvshim_fs_cb)
  elseif kind == FS.write then
    status = libuv.uv_fs_write(loop_handle, owner.handle, file_handle,
        buffer_handle, 1, -1, shim.titan_uvshim_fs_cb)
  elseif kind == FS.flush then
    status = libuv.uv_fs_fsync(loop_handle, owner.handle, file_handle,
                              shim.titan_uvshim_fs_cb)
  elseif kind == FS.close or kind == FS.internal_close then
    status = libuv.uv_fs_close(loop_handle, owner.handle, file_handle,
                              shim.titan_uvshim_fs_cb)
  elseif kind == FS.mkdir then
    status = libuv.uv_fs_mkdir(loop_handle, owner.handle, path_data,
        511 as ffi.titan_ffi_int,
        shim.titan_uvshim_fs_cb)
  elseif kind == FS.unlink then
    status = libuv.uv_fs_unlink(loop_handle, owner.handle, path_data,
                               shim.titan_uvshim_fs_cb)
  elseif kind == FS.rmdir then
    status = libuv.uv_fs_rmdir(loop_handle, owner.handle, path_data,
                              shim.titan_uvshim_fs_cb)
  elseif kind == FS.rename then
    status = libuv.uv_fs_rename(loop_handle, owner.handle, path_data,
        second_path_data, shim.titan_uvshim_fs_cb)
  else
    status = libuv.uv_fs_scandir(loop_handle, owner.handle, path_data, 0,
                                shim.titan_uvshim_fs_cb)
  end
  if (status as integer) < 0 then
    clean_fs_owner(owner)
  end
  return owner, status as integer
end

local function start_owner(runtime: Runtime, kind: integer, task: Task?,
                           peer: value, epoch: integer,
                           timeout: integer, repeat_time: integer):
                           (uv_timer_t, integer)
  local owner, pointer = allocate_owner(runtime, kind, task, peer, epoch)
  local status = libuv.uv_timer_init(runtime.loop.handle, owner.handle)
  if (status as integer) < 0 then
    -- Keep synchronous rejection cleanup in this already-reserved frame.
    -- Calling unlink_owner here would enter another Titan function after the
    -- owner was published, opening an emergency GC/stack-growth longjmp gap.
    local previous? = owner.metadata.previous_owner
    local next? = owner.metadata.next_owner
    if previous then
      previous.metadata.next_owner = next
    else
      runtime.timer_owner_head = next
    end
    if next then
      next.metadata.previous_owner = previous
    end
    owner.metadata.previous_owner = nil
    owner.metadata.next_owner = nil
    owner.handle = nil
    owner.storage = nil
    owner.metadata.lifecycle = OWNER_CLOSED
    return owner, status as integer
  end
  owner.metadata.lifecycle = OWNER_ACTIVE
  shim.titan_uvshim_timer_set_data(owner.handle, pointer)
  status = libuv.uv_timer_start(owner.handle, shim.titan_uvshim_timer_cb,
                               timeout, repeat_time)
  if (status as integer) < 0 then
    -- As above, do not cross a fresh Titan function prologue after libuv owns
    -- an initialized handle. The Ticker caller rolls back its public `open`
    -- state immediately after this native owner transition returns.
    libuv.uv_timer_stop(owner.handle)
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(owner.handle)
  end
  return owner, status as integer
end

local function start_signal_owner(runtime: Runtime, task: Task,
                                  spec: SignalSpec, epoch: integer):
                                  (uv_signal_t, integer)
  local owner, pointer = allocate_signal_owner(runtime, task, spec, epoch)
  local status = shim.titan_uvshim_signal_init(runtime.loop.handle,
                                               owner.handle, pointer)
  if (status as integer) < 0 then
    -- This is the same callback-less init-failure boundary as timer init.
    -- Unlink inline in the already-reserved frame; do not enter a fresh Titan
    -- function after publishing the owner and before clearing its GC roots.
    local previous? = owner.metadata.previous_owner
    local next? = owner.metadata.next_owner
    if previous then
      previous.metadata.next_owner = next
    else
      runtime.signal_owner_head = next
    end
    if next then
      next.metadata.previous_owner = previous
    end
    owner.metadata.previous_owner = nil
    owner.metadata.next_owner = nil
    owner.metadata.lifecycle = OWNER_CLOSED
    owner.handle = nil
    owner.storage = nil
    return owner, status as integer
  end
  owner.metadata.lifecycle = OWNER_ACTIVE
  status = shim.titan_uvshim_signal_start_oneshot(
      owner.handle, spec.signum as ffi.titan_ffi_int)
  if (status as integer) < 0 then
    libuv.uv_signal_stop(owner.handle)
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_signal_close(owner.handle)
  end
  return owner, status as integer
end

local function terminal(state: integer): boolean
  return state == TASK_SUCCEEDED or state == TASK_FAILED or
         state == TASK_CANCELLED
end

local function promote_fatal(runtime: Runtime, err: value, trace: string)
  if not runtime.fatal then
    runtime.fatal = true
    -- Prevent the remainder of this callback from admitting ordinary work.
    -- Cleanup requests remain legal while the outer driver drains the session.
    runtime.closing = true
    runtime.fatal_error = err
    runtime.fatal_traceback = trace
    libuv.uv_stop(runtime.loop.handle)
  end
end

local function remove_joiner(task: Task)
  local target? = task.joining_target
  if not target then
    return
  end
  local target = target
  local previous? = task.join_previous
  local next? = task.join_next
  if previous then
    previous.join_next = next
  else
    target.joiner_head = next
  end
  if next then
    next.join_previous = previous
  end
  task.join_previous = nil
  task.join_next = nil
  task.joining_target = nil
  target.observer_count = target.observer_count - 1
  if target.observer_count < 0 then
    raise "Task observer count became negative"
  end
end

local function add_joiner(target: Task, task: Task)
  local previous? = target.joiner_head
  task.joining_target = target
  task.join_previous = nil
  task.join_next = previous
  if previous then
    previous.join_previous = task
  end
  target.joiner_head = task
  target.observer_count = target.observer_count + 1
end

local function schedule_observation(task: Task)
  local runtime = task.runtime
  runtime.pending_observations = runtime.pending_observations + 1
  local owner, status = start_owner(runtime, OWNER_OBSERVE, task, nil,
                                    task.epoch, 0, 0)
  if status < 0 then
    if owner.metadata.lifecycle == OWNER_CLOSED then
      runtime.pending_observations = runtime.pending_observations - 1
    end
    promote_fatal(runtime, make_error(status, "task.observe", nil), "")
  end
end

local function wake_joiners(task: Task)
  local joiner? = task.joiner_head
  while joiner do
    local owner, status = start_owner(task.runtime, OWNER_JOIN_WAKE,
                                      joiner, task, joiner.epoch, 0, 0)
    if status < 0 then
      promote_fatal(task.runtime,
                    make_error(status, "task.join.wake", nil), "")
    else
      joiner.operation = owner
    end
    joiner = joiner.join_next
  end
end

local function finish_task(task: Task, state: integer, result: value,
                           err: value, trace: string)
  if terminal(task.state) then
    return
  end
  local runtime = task.runtime
  task.operation = nil
  task.current_request = nil
  task.result = result
  task.error_value = err
  task.error_traceback = trace
  task.state = state
  task.cancel_fallback = false
  task.cleanup_shield_depth = 0
  local helper_group? = task.helper_group
  local helper_kind = task.helper_kind
  task.helper_group = nil
  task.helper_kind = 0
  unlink_task(task)
  if helper_group then
    complete_helper(helper_group, helper_kind,
                    result, err, trace)
  end
  if state == TASK_FAILED and task.main then
    promote_fatal(runtime, err, trace)
  elseif state == TASK_CANCELLED and task.main then
    promote_fatal(runtime, err, trace)
  end
  wake_joiners(task)
  if state == TASK_FAILED then
    if not task.main and not task.permanently_observed and
        task.observer_count == 0 and
        not runtime.fatal then
      schedule_observation(task)
    end
  end
  maybe_finish_session(runtime)
end

local function ticker_state(owner: uv_timer_t): TickerState
  return owner.metadata.peer
end

local function detach_fs_wait(task: Task, request: Request)
  local operation: FsOperation = request.subject
  if request.cleanup then
    return
  end
  if operation.kind == FS.close_wait and operation.file then
    if operation.linked and operation.close_waiter then
      remove_close_waiter(operation.file, operation)
    end
    return
  end
  if operation.owner then
    local fs_owner = operation.owner
    if fs_owner.metadata.lifecycle == FS_OWNER_SUBMITTED then
      -- Success still completes through the normal callback.  A too-late
      -- failure is likewise harmless because logical cancellation already won.
      shim.titan_uvshim_fs_cancel(fs_owner.handle)
    end
  elseif operation.file then
    local file = operation.file
    if operation.linked and not operation.close_waiter then
      remove_file_operation(file, operation)
      advance_file(file)
    end
  end
end

local function detach_net_wait(task: Task, request: Request)
  local operation: NetOperation = request.subject
  if request.cleanup then return end
  if operation.kind == NET_CONNECT or operation.kind == NET_LISTEN then
    if operation.tcp then
      start_tcp_close(operation.tcp)
    elseif operation.owner ~= nil then
      local dns: uv_getaddrinfo_t = operation.owner
      if dns.metadata.lifecycle == NET_OWNER_SUBMITTED then
        shim.titan_uvshim_getaddrinfo_cancel(dns.handle)
      end
    end
    return
  end
  local tcp = operation.tcp
  local control = tcp.metadata
  if operation.kind == NET_READ then
    if control.read_waiter == task and
        control.read_epoch == request.generation then
      control.read_waiter = nil
      control.read_epoch = 0
    end
  elseif operation.kind == NET_ACCEPT then
    if control.accept_waiter == task and
        control.accept_epoch == request.generation then
      control.accept_waiter = nil
      control.accept_epoch = 0
    end
  elseif operation.kind == NET_WRITE then
    if operation.owner == nil and operation.linked then
      remove_output(tcp, operation)
      advance_tcp_output(tcp, nil)
    end
  elseif operation.kind == NET_SHUTDOWN then
    if operation.owner == nil and operation.linked then
      -- Once shutdown_requested is published, the physical half-close is
      -- monotonic.  Cancellation detaches only the logical waiter; the FIFO
      -- retains this taskless operation until uv_shutdown completes.
      operation.task = nil
      operation.request = nil
    end
  end
end

local function detach_process_wait(task: Task, request: Request)
  local operation: ProcessOperation = request.subject
  if request.cleanup then return end
  if operation.kind == PROCESS_SPAWN then
    -- Native setup/close ownership is monotonic.  Cancellation revokes only
    -- result delivery; an unpublished child continues termination and reap.
    operation.task = nil
    operation.request = nil
    return
  end
  local process = operation.process
  local process_control = process.metadata
  if operation.kind == PROCESS_WAIT then
    if process_control.wait_task == task and
        process_control.wait_epoch == request.generation then
      process_control.wait_task = nil
      process_control.wait_epoch = 0
    end
    return
  end
  local pipe = operation.pipe
  local pipe_control = pipe.metadata
  if operation.kind == PROCESS_READ_STDOUT or
      operation.kind == PROCESS_READ_STDERR then
    if pipe_control.read_waiter == task and
        pipe_control.read_epoch == request.generation then
      pipe_control.read_waiter = nil
      pipe_control.read_epoch = 0
    end
  elseif operation.kind == PROCESS_WRITE_STDIN and
         not operation.owner and operation.linked then
    remove_pipe_output(pipe, operation)
    advance_pipe_output(pipe, nil)
  end
end

local function detach_wait(task: Task)
  local request? = task.current_request
  local owner = task.operation
  if request then
    local request = request
    if request.kind == REQUEST_JOIN then
      local target? = task.joining_target
      remove_joiner(task)
      if owner ~= nil then
        close_owner(owner)
      end
      if target then
        local target = target
        if target.state == TASK_FAILED and
            not target.permanently_observed and
            target.observer_count == 0 and
            not target.runtime.fatal then
          schedule_observation(target)
        end
      end
    elseif request.kind == REQUEST_TICK then
      local owner: uv_timer_t = request.subject
      local state = ticker_state(owner)
      if state.waiter == task and state.waiter_epoch == request.generation then
        state.waiter = nil
        state.waiter_epoch = 0
      end
    elseif request.kind == REQUEST_FS then
      detach_fs_wait(task, request)
    elseif request.kind == REQUEST_NET then
      detach_net_wait(task, request)
    elseif request.kind == REQUEST_PROCESS then
      detach_process_wait(task, request)
    elseif request.kind == REQUEST_HELPER then
      local group: HelperGroup = request.subject
      if group.waiter == task and
          group.waiter_epoch == request.generation then
        group.waiter = nil
        group.waiter_epoch = 0
        group.waiter_all = false
      end
    elseif request.kind == REQUEST_SIGNAL and owner ~= nil then
      local owner: uv_signal_t = owner
      if owner.metadata.task == task and
          owner.metadata.epoch == request.generation then
        owner.metadata.task = nil
        owner.metadata.epoch = 0
        close_signal_owner(owner)
      end
    elseif request.kind == REQUEST_SLEEP and owner ~= nil then
      close_owner(owner)
    end
  elseif owner ~= nil then
    close_owner(owner)
  end
  task.operation = nil
  task.current_request = nil
end

local function request_cancel(task: Task, reason: value)
  if terminal(task.state) or task.cancel_requested then
    return
  end
  local runtime = task.runtime
  if runtime.generation ~= task.generation then
    raise "Task belongs to a stale libuv Runtime"
  end
  task.cancel_requested = true
  task.cancel_value = Cancelled.new(reason)
  task.epoch = task.epoch + 1
  if task.cleanup_shield_depth > 0 then
    return
  end
  if task.state ~= TASK_RUNNING then
    detach_wait(task)
  end
  local owner, status = start_owner(runtime, OWNER_CANCEL, task, nil,
                                    task.epoch, 0, 0)
  if status < 0 then
    task.cancel_fallback = true
    promote_fatal(runtime, make_error(status, "task.cancel", nil), "")
  else
    task.operation = owner
  end
end

local function running_task(): Task
  if not coroutine.is_yieldable(UV_TAG) then
    raise "async operation used outside a UV Task"
  end
  local runtime = current_runtime()
  return runtime.running_task
end

local function ordinary_task(): Task
  local task = running_task()
  if task.cancel_requested then
    raise task.cancel_value
  end
  if task.runtime.closing then
    raise "the libuv Runtime is shutting down"
  end
  return task
end

local function new_request(kind: integer, subject: value,
                           milliseconds: integer): Request
  local task = ordinary_task()
  task.epoch = task.epoch + 1
  return Request.new(kind, task.epoch, task, subject, milliseconds, false)
end

local function new_cleanup_request(kind: integer, subject: value,
                                   milliseconds: integer): Request
  local task = running_task()
  task.epoch = task.epoch + 1
  return Request.new(kind, task.epoch, task, subject, milliseconds, true)
end

local function make_fs_operation(kind: integer, task: Task?,
                                 request: Request?, path: Text?,
                                 second_path: Text?, file: uv_file?,
                                 data: string, maximum: integer): FsOperation
  return FsOperation.new(kind, task, request, path, second_path, file,
      data, maximum, 0, nil, nil, nil, nil, nil, false, false)
end

local function make_net_operation(kind: integer, task: Task,
                                  request: Request, host: Text?,
                                  port: integer, backlog: integer,
                                  tcp: uv_tcp_t?, data: string): NetOperation
  local operation: NetOperation = {
    kind = kind,
    task = task,
    request = request,
    host = host,
    port = port,
    backlog = backlog,
    tcp = tcp,
    data = data,
    addresses = nil,
    address_index = 0,
    prepared_buffer = nil,
    owner = nil,
    next_operation = nil,
    previous_operation = nil,
    linked = false,
    close_waiter = false,
    last_error = nil,
  }
  return operation
end

local function new_fs_request(kind: integer, path: string,
                              second_path: string?, data: string): Request
  local request = new_request(REQUEST_FS, nil, 0)
  local copied_second: Text? = nil
  if second_path then
    local path = second_path
    copied_second = copy_text(path, "fs.path", path)
  end
  local operation = make_fs_operation(kind, request.task, request,
      copy_text(path, "fs.path", path), copied_second, nil, data, 0)
  request.subject = operation
  return request
end

local function new_file_request(kind: integer, file: uv_file, data: string,
                                maximum: integer,
                                cleanup: boolean): Request
  local request: Request? = nil
  if cleanup then
    request = new_cleanup_request(REQUEST_FS, nil, 0)
  else
    request = new_request(REQUEST_FS, nil, 0)
  end
  local request = request
  local operation = make_fs_operation(kind, request.task, request,
      nil, nil, file, data, maximum)
  request.subject = operation
  return request
end

local function new_net_request(kind: integer, host: string?, port: integer,
                               backlog: integer, tcp: uv_tcp_t?, data: string,
                               cleanup: boolean): Request
  local request: Request? = nil
  if cleanup then
    request = new_cleanup_request(REQUEST_NET, nil, 0)
  else
    request = new_request(REQUEST_NET, nil, 0)
  end
  local request = request
  local copied_host: Text? = nil
  if host then
    local host = host
    copied_host = copy_text(host, "net.host", host)
  end
  local operation = make_net_operation(kind, request.task, request,
      copied_host, port, backlog, tcp, data)
  request.subject = operation
  return request
end

local function make_process_operation(kind: integer, task: Task,
                                      request: Request,
                                      process: uv_process_t?,
                                      pipe: uv_pipe_t?, file: Text?,
                                      arguments: {Text}?): ProcessOperation
  local operation: ProcessOperation = {
    kind = kind,
    task = task,
    request = request,
    process = process,
    pipe = pipe,
    file = file,
    arguments = arguments,
    copied_bytes = nil,
    prepared_buffer = nil,
    owner = nil,
    next_operation = nil,
    previous_operation = nil,
    linked = false,
  }
  return operation
end

local function new_process_request(kind: integer, process: uv_process_t,
                                   pipe: uv_pipe_t?, cleanup: boolean): Request
  local request: Request? = nil
  if cleanup then
    request = new_cleanup_request(REQUEST_PROCESS, nil, 0)
  else
    request = new_request(REQUEST_PROCESS, nil, 0)
  end
  local request = request
  local operation = make_process_operation(kind, request.task, request,
      process, pipe, nil, nil)
  request.subject = operation
  return request
end

local function new_process_spawn_request(file: string,
                                          args: {string}): Request
  if #file == 0 then raise "process executable must not be empty" end
  local request = new_request(REQUEST_PROCESS, nil, 0)
  -- Copy every text root before any native process or pipe owner exists.
  local copied_file = copy_text(file, "process.spawn", file)
  local copied_args: {Text} = {}
  for index = 1, #args do
    copied_args[index] = copy_text(
        args[index], "process.spawn", args[index])
  end
  local operation = make_process_operation(PROCESS_SPAWN,
      request.task, request, nil, nil, copied_file, copied_args)
  request.subject = operation
  return request
end

local function new_helper_request(group: HelperGroup, wait_all: boolean,
                                  cleanup: boolean): Request
  local request: Request? = nil
  if cleanup then
    request = new_cleanup_request(
        REQUEST_HELPER, group, wait_all and 1 or 0)
  else
    request = new_request(REQUEST_HELPER, group,
                          wait_all and 1 or 0)
  end
  return request
end

local function process_operation_deliverable(
    operation: ProcessOperation): boolean
  if not operation.task or not operation.request then return false end
  local task = operation.task
  local request = operation.request
  if request.cleanup then
    return task.state == TASK_WAITING and
           task.current_request == request and task.cleanup_shield_depth > 0
  end
  return task.state == TASK_WAITING and task.current_request == request and
         not task.cancel_requested and task.epoch == request.generation
end

local function enqueue_pipe_output(pipe: uv_pipe_t,
                                   operation: ProcessOperation)
  local control = pipe.metadata
  local previous? = control.output_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    previous.next_operation = operation
  else
    control.output_head = operation
  end
  control.output_tail = operation
  operation.linked = true
end

local function remove_pipe_output(pipe: uv_pipe_t,
                                  operation: ProcessOperation)
  if not operation.linked then return end
  local control = pipe.metadata
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    previous.next_operation = next
  else
    control.output_head = next
  end
  if next then
    next.previous_operation = previous
  else
    control.output_tail = previous
  end
  if control.output_current == operation then
    control.output_current = nil
  end
  if control.close_waiter == operation then
    control.close_waiter = nil
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.owner = nil
  operation.prepared_buffer = nil
  operation.linked = false
end

local function process_pipe_closed(pipe: uv_pipe_t?): boolean
  if not pipe then return true end
  local pipe = pipe
  return pipe.metadata.lifecycle == PIPE_CLOSED and
         not pipe.metadata.owner
end

local function process_all_native_closed(control: ProcessControl): boolean
  local process_retired = control.lifecycle == PROCESS_CLOSED
  if process_retired and control.owner then
    process_retired = control.owner.handle == nil
  end
  return process_retired and
         process_pipe_closed(control.stdin_pipe) and
         process_pipe_closed(control.stdout_pipe) and
         process_pipe_closed(control.stderr_pipe) and
         not control.grace_owner
end

local function process_close_all_pipes(control: ProcessControl)
  if control.stdin_pipe then
    start_pipe_close(control.stdin_pipe)
  end
  if control.stdout_pipe then
    start_pipe_close(control.stdout_pipe)
  end
  if control.stderr_pipe then
    start_pipe_close(control.stderr_pipe)
  end
end

local function begin_one_process_shutdown(control: ProcessControl): integer
  if control.shutdown_started or control.exit_seen or
      control.lifecycle == PROCESS_CLOSED then return 0 end
  control.shutdown_started = true
  process_close_all_pipes(control)
  local process = control.owner
  local term = shim.titan_uvshim_signal_number("term")
  local kill_status = libuv.uv_process_kill(process.handle, term)
  local grace_status = start_process_grace(control)
  if grace_status < 0 and not control.exit_seen then
    control.kill_sent = true
    local kill = shim.titan_uvshim_signal_number("kill")
    local emergency_status = libuv.uv_process_kill(process.handle, kill)
    if (emergency_status as integer) < 0 and
        (emergency_status as integer) ~= UV_ESRCH
    then
      return emergency_status as integer
    end
  end
  if (kill_status as integer) < 0 and
      (kill_status as integer) ~= UV_ESRCH then
    return kill_status as integer
  end
  return grace_status
end

local function retire_unpublished_process(control: ProcessControl): Error?
  if not process_all_native_closed(control) then return nil end
  local operation? = control.spawn_operation
  local failure? = control.pending_failure
  control.spawn_operation = nil
  control.pending_failure = nil
  control.stdin_pipe = nil
  control.stdout_pipe = nil
  control.stderr_pipe = nil
  unlink_process_control(control)
  if operation then
    local spawn = operation
    spawn.process = nil
    spawn.file = nil
    spawn.arguments = nil
  end
  return failure
end

local function advance_pipe_output(pipe: uv_pipe_t,
                                   inline_task: Task?): DriveControl?
  local control = pipe.metadata
  if control.lifecycle == PIPE_CLOSING or
      control.lifecycle == PIPE_CLOSED then
    return nil
  end
  while not control.output_current and control.output_head do
    local operation = control.output_head
    local status: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
    if operation.kind == PROCESS_WRITE_STDIN then
      if not operation.prepared_buffer then
        local bytes = operation.copied_bytes
        operation.prepared_buffer = make_buffer(bytes, 0, bytes.length)
      end
      local buffer = operation.prepared_buffer
      local owner, pointer = allocate_pipe_write_owner(control.runtime,
                                                       operation)
      operation.owner = owner
      control.output_current = operation
      status = shim.titan_uvshim_pipe_write_start(
          owner.handle, pipe.handle, pointer, buffer.handle)
      if (status as integer) >= 0 then
        owner.metadata.lifecycle = PROCESS_OWNER_SUBMITTED
        operation.prepared_buffer = nil
        return nil
      end
      retire_process_request(owner.metadata)
      remove_pipe_output(pipe, operation)
      local failure = make_error(status as integer,
                                 "process.stdin.write", nil)
      if operation.task and operation.request then
        local task = operation.task
        local request = operation.request
        if inline_task == task and task.current_request == request and
            task.epoch == request.generation then
          task.current_request = nil
          return DriveControl.new(DRIVE_ERROR, failure, "", nil)
        elseif process_operation_deliverable(operation) then
          schedule_task_drive(task, request.generation, DRIVE_ERROR,
                              failure, "", nil)
        end
      else
        promote_fatal(control.runtime, failure, "")
        return nil
      end
    else
      -- Anonymous pipes do not support socket-style shutdown on Unix
      -- (libuv reports UV_ENOTSOCK).  Reaching this FIFO sentinel proves every
      -- accepted write callback has completed, so portable uv_close itself is
      -- the ordered write-end close that publishes EOF to the child.
      remove_pipe_output(pipe, operation)
      control.close_waiter = operation
      control.write_shutdown = true
      start_pipe_close(pipe)
      return nil
    end
  end
  return nil
end

local function arm_process_spawn(task: Task,
                                 request: Request): DriveControl?
  local runtime = task.runtime
  local operation: ProcessOperation = request.subject
  local file = operation.file
  local arguments = operation.arguments
  local argument_count = #arguments + 1

  -- The three initialized uv_pipe_t handles are passed directly to uv_spawn;
  -- libuv creates and opens their parent endpoints through UV_CREATE_PIPE.
  local process, process_pointer = allocate_process_owner(runtime)
  local process_control = process.metadata
  process_control.spawn_operation = operation
  operation.process = process
  local stdin_pipe, stdin_pointer = allocate_pipe_owner(
      process_control, PIPE_STDIN)
  local stdout_pipe, stdout_pointer = allocate_pipe_owner(
      process_control, PIPE_STDOUT)
  local stderr_pipe, stderr_pointer = allocate_pipe_owner(
      process_control, PIPE_STDERR)
  local argv = shim.titan_uvshim_char_ptr.new_array(argument_count + 1)
  argv[0] = file.bytes.data
  for index = 1, #arguments do
    argv[index] = arguments[index].bytes.data
  end
  argv[argument_count] = nil

  local status = shim.titan_uvshim_pipe_init(runtime.loop.handle,
      stdin_pipe.handle, stdin_pointer)
  local failed_operation = "process.stdin.init"
  if (status as integer) >= 0 then
    stdin_pipe.metadata.lifecycle = PIPE_INITIALIZED
    status = shim.titan_uvshim_pipe_init(runtime.loop.handle,
        stdout_pipe.handle, stdout_pointer)
    failed_operation = "process.stdout.init"
  end
  if (status as integer) >= 0 then
    stdout_pipe.metadata.lifecycle = PIPE_INITIALIZED
    status = shim.titan_uvshim_pipe_init(runtime.loop.handle,
        stderr_pipe.handle, stderr_pointer)
    failed_operation = "process.stderr.init"
  end
  if (status as integer) >= 0 then
    stderr_pipe.metadata.lifecycle = PIPE_INITIALIZED
    status = shim.titan_uvshim_process_spawn(runtime.loop.handle,
        process.handle, process_pointer, argv, stdin_pipe.handle,
        stdout_pipe.handle, stderr_pipe.handle)
    failed_operation = "process.spawn"
    process_control.lifecycle = PROCESS_SPAWNED
  end

  local spawn_status = status as integer
  if spawn_status >= 0 then
    stdin_pipe.metadata.lifecycle = PIPE_OPEN
    stdout_pipe.metadata.lifecycle = PIPE_OPEN
    stderr_pipe.metadata.lifecycle = PIPE_OPEN
    local read_status = start_pipe_read(stdout_pipe)
    local read_operation = "process.stdout.read.start"
    if read_status >= 0 then
      read_status = start_pipe_read(stderr_pipe)
      read_operation = "process.stderr.read.start"
    end
    if read_status >= 0 then
      process_control.spawn_operation = nil
      operation.process = nil
      operation.file = nil
      operation.arguments = nil
      task.current_request = nil
      return DriveControl.new(DRIVE_RESUME, process, "", nil)
    end

    -- A child exists, so a read-start rejection is not reportable until all
    -- pipe owners are closed and the child has been terminated and reaped.
    process_control.pending_failure = make_error(
        read_status, read_operation, file.source)
    process_close_all_pipes(process_control)
    local shutdown_status = begin_one_process_shutdown(process_control)
    if shutdown_status < 0 then
      promote_fatal(runtime,
          make_error(shutdown_status, "process.shutdown", file.source), "")
    end
    task.operation = process
    task.state = TASK_WAITING
    return nil
  end

  process_control.pending_failure = make_error(
      spawn_status, failed_operation, file.source)
  process_close_all_pipes(process_control)
  if process_control.lifecycle == PROCESS_ALLOCATED then
    discard_process_storage(process)
  else
    -- Failed uv_spawn owes no exit callback.  Its process and initialized
    -- pipe handles still owe the ordinary libuv close callbacks.
    start_process_close(process)
  end
  if process_all_native_closed(process_control) then
    local failure: Error? = retire_unpublished_process(process_control)
    task.current_request = nil
    return DriveControl.new(DRIVE_ERROR, failure, "", nil)
  end
  task.operation = process
  task.state = TASK_WAITING
  return nil
end

local function arm_process_request(task: Task,
                                   request: Request): DriveControl?
  local operation: ProcessOperation = request.subject
  if operation.kind == PROCESS_SPAWN then
    return arm_process_spawn(task, request)
  end
  local process = operation.process
  local process_control = process.metadata
  if operation.kind == PROCESS_WAIT then
    if process_control.exit_seen and
        process_control.lifecycle == PROCESS_CLOSED then
      task.current_request = nil
      return DriveControl.new(DRIVE_RESUME,
          ProcessExitResult.new(process_control.exit_status,
                                process_control.term_signal), "", nil)
    end
    process_control.wait_task = task
    process_control.wait_epoch = request.generation
    task.operation = process
    task.state = TASK_WAITING
    return nil
  elseif operation.kind == PROCESS_DISPOSE then
    if process_all_native_closed(process_control) then
      task.current_request = nil
      return DriveControl.new(DRIVE_RESUME, nil, "", request)
    end
    process_control.dispose_task = task
    process_control.dispose_epoch = request.generation
    task.operation = process
    task.state = TASK_WAITING
    return nil
  end

  local pipe = operation.pipe
  local pipe_control = pipe.metadata
  if operation.kind == PROCESS_READ_STDOUT or
      operation.kind == PROCESS_READ_STDERR then
    pipe_control.read_waiter = task
    pipe_control.read_epoch = request.generation
    task.operation = pipe
    task.state = TASK_WAITING
    return nil
  else
    enqueue_pipe_output(pipe, operation)
    task.operation = operation
    task.state = TASK_WAITING
    return advance_pipe_output(pipe, task)
  end
end

local function arm_helper_request(task: Task,
                                  request: Request): DriveControl?
  local group: HelperGroup = request.subject
  local wait_all = request.milliseconds ~= 0
  local ready = group.pending == 0 or
                (not wait_all and group.first_error ~= nil)
  if ready then
    task.current_request = nil
    local cleanup_request: Request? = nil
    if request.cleanup then cleanup_request = request end
    return DriveControl.new(DRIVE_RESUME, group, "", cleanup_request)
  end
  group.waiter = task
  group.waiter_epoch = request.generation
  group.waiter_all = wait_all
  group.wake_scheduled = false
  task.operation = group
  task.state = TASK_WAITING
  return nil
end

local function arm_request(task: Task, request: Request): DriveControl?
  local runtime = task.runtime
  task.current_request = request
  if request.kind == REQUEST_SLEEP then
    local owner, status = start_owner(runtime, OWNER_SLEEP, task, request,
                                      request.generation,
                                      request.milliseconds, 0)
    if status < 0 then
      task.current_request = nil
      return DriveControl.new(DRIVE_ERROR,
          make_error(status, "timer.start", nil), "", nil)
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_JOIN then
    local target: Task = request.subject
    add_joiner(target, task)
    task.operation = nil
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_TICK then
    local owner: uv_timer_t = request.subject
    local state = ticker_state(owner)
    state.waiter = task
    state.waiter_epoch = request.generation
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_FS then
    local operation: FsOperation = request.subject
    if operation.file then
      local file = operation.file
      if operation.kind == FS.close_wait then
        enqueue_close_waiter(file, operation)
        task.operation = operation
        task.state = TASK_WAITING
        return nil
      end
      enqueue_file_operation(file, operation)
      task.operation = operation
      task.state = TASK_WAITING
      local failure: Error? = submit_file_head(file, task)
      if failure then
        local cleanup_request: Request? = nil
        if request.cleanup then cleanup_request = request end
        return DriveControl.new(DRIVE_ERROR, failure, "", cleanup_request)
      end
      return nil
    end

    local owner, status = submit_fs_operation(operation)
    if status < 0 then
      task.current_request = nil
      local failure = make_error(status, fs_operation_name(operation.kind),
                                 fs_operation_subject(operation))
      retire_fs_owner_now(owner)
      return DriveControl.new(DRIVE_ERROR, failure, "", nil)
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_NET then
    local failure: Error? = arm_net_request(task, request)
    if failure then
      local cleanup_request: Request? = nil
      if request.cleanup then cleanup_request = request end
      return DriveControl.new(DRIVE_ERROR, failure, "", cleanup_request)
    end
    return nil
  elseif request.kind == REQUEST_SIGNAL then
    local spec: SignalSpec = request.subject
    local owner, status = start_signal_owner(runtime, task, spec,
                                             request.generation)
    if status < 0 then
      task.current_request = nil
      local operation = "signal.start"
      if owner.metadata.lifecycle == OWNER_CLOSED then
        operation = "signal.init"
      end
      return DriveControl.new(DRIVE_ERROR,
          make_error(status, operation, spec.name), "", nil)
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  elseif request.kind == REQUEST_PROCESS then
    return arm_process_request(task, request)
  else
    return arm_helper_request(task, request)
  end
end

local function drive_task(task: Task, initial_mode: integer,
                          initial_payload: value,
                          initial_trace: string)
  local runtime = task.runtime
  local mode = initial_mode
  local payload = initial_payload
  local source_trace = initial_trace
  while true do
    runtime.running_task = task
    task.state = TASK_RUNNING
    task.operation = nil
    task.current_request = nil
    local yielded: value = nil
    do
      if mode == DRIVE_ERROR then
        if #source_trace > 0 then
          -- Task:join's suspended catch combines this target trace with the
          -- join-site trace before the error reaches user code.  If it then
          -- escapes the child, coroutine.Coro appends the callback propagation
          -- trace once more using the same staged-trace protocol.
          stash_trace_for_append(source_trace)
        end
        yielded = task.root:error(payload, UV_TAG)
      else
        yielded = task.root:resume(payload, UV_TAG)
      end
    catch
      runtime.running_task = nil
      if task.cancel_requested and error == task.cancel_value then
        finish_task(task, TASK_CANCELLED, nil, error, traceback)
      else
        finish_task(task, TASK_FAILED, nil, error, traceback)
      end
      return
    end
    runtime.running_task = nil

    local status = task.root:status()
    if status == "dead" then
      if task.cancel_requested then
        finish_task(task, TASK_CANCELLED, nil, task.cancel_value, source_trace)
      else
        finish_task(task, TASK_SUCCEEDED, yielded, nil, "")
      end
      return
    elseif status ~= "suspended" then
      raise "invalid UV Task coroutine state"
    end

    local request: Request = yielded
    local cleanup_request = request.cleanup and
                            task.cleanup_shield_depth > 0
    if task.cancel_requested and not cleanup_request then
      mode = DRIVE_ERROR
      payload = task.cancel_value
      source_trace = ""
    else
      local outcome? = arm_request(task, request)
      if not outcome then
        return
      end
      local outcome = outcome
      mode = outcome.mode
      payload = outcome.payload
      source_trace = outcome.trace
    end
  end
end

local function schedule_task_drive(task: Task, epoch: integer, mode: integer,
                                   payload: value, trace: string,
                                   cleanup_request: Request?): boolean
  local control = DriveControl.new(mode, payload, trace, cleanup_request)
  local owner, status = start_owner(task.runtime, OWNER_TASK_DRIVE,
                                    task, control, epoch, 0, 0)
  if status < 0 then
    promote_fatal(task.runtime,
                  make_error(status, "task.drive.schedule", nil), "")
    return false
  else
    task.operation = owner
    return true
  end
end

local function retire_fs_owner_now(owner: uv_fs_t)
  owner.handle = nil
  owner.storage = nil
  owner.buffer = nil
  if owner.metadata.operation.owner == owner then
    owner.metadata.operation.owner = nil
  end
  unlink_fs_owner(owner)
end

local function submit_file_head(file: uv_file, inline_task: Task?): Error?
  while not file.current and file.queue_head do
    local operation = file.queue_head
    file.current = operation
    local owner, status = submit_fs_operation(operation)
    if status >= 0 then
      if operation.task then
        local task = operation.task
        if task.state == TASK_WAITING and
            task.current_request == operation.request then
          task.operation = owner
        end
      end
      return nil
    end

    local failure = make_error(status, fs_operation_name(operation.kind),
                               fs_operation_subject(operation))
    retire_fs_owner_now(owner)
    remove_file_operation(file, operation)
    if operation.kind == FS.close or
        operation.kind == FS.internal_close then
      file.close_enqueued = false
    end
    if operation.task then
      local task = operation.task
      local request = operation.request
      if inline_task == task and task.current_request == request and
          task.epoch == request.generation then
        task.current_request = nil
        return failure
      elseif task.state == TASK_WAITING and
             task.current_request == request and
             (task.epoch == request.generation or request.cleanup) then
        local epoch = request.generation
        if request.cleanup then epoch = task.epoch end
        local cleanup_request: Request? = nil
        if request.cleanup then cleanup_request = request end
        local scheduled = schedule_task_drive(task, epoch, DRIVE_ERROR,
            failure, "", cleanup_request)
        if request.cleanup and not scheduled then
          operation.kind = FS.close_wait
          enqueue_close_waiter(file, operation)
        end
      end
    else
      promote_fatal(file.runtime, failure, "")
      return nil
    end
  end
  return nil
end

local function advance_file(file: uv_file)
  submit_file_head(file, nil)
end

local function fs_operation_deliverable(operation: FsOperation): boolean
  if not operation.task or not operation.request then return false end
  local task = operation.task
  local request = operation.request
  if request.cleanup then
    return task.state == TASK_WAITING and
           task.current_request == request and task.cleanup_shield_depth > 0
  end
  return task.state == TASK_WAITING and task.current_request == request and
         not task.cancel_requested and
         task.epoch == request.generation
end

local function net_operation_deliverable(operation: NetOperation): boolean
  if not operation.task or not operation.request then return false end
  local task = operation.task
  local request = operation.request
  if request.cleanup then
    return task.state == TASK_WAITING and
           task.current_request == request and task.cleanup_shield_depth > 0
  end
  return task.state == TASK_WAITING and task.current_request == request and
         not task.cancel_requested and task.epoch == request.generation
end

local function net_operation_subject(operation: NetOperation): string?
  if operation.host then
    return operation.host.source
  elseif operation.tcp then
    local tcp = operation.tcp
    if tcp.metadata.server then return "server" end
    return "connection"
  end
  return nil
end

local function start_dns(operation: NetOperation):
                         (uv_getaddrinfo_t, integer)
  local task = operation.task
  local runtime = task.runtime
  local host = operation.host
  local loop_handle = runtime.loop.handle
  local node = host.bytes.data
  local port = operation.port as ffi.titan_ffi_int
  local owner, pointer = allocate_dns_owner(runtime, operation)
  operation.owner = owner
  local status = shim.titan_uvshim_getaddrinfo_start(
      loop_handle, owner.handle, pointer, node, port)
  if (status as integer) >= 0 then
    owner.metadata.lifecycle = NET_OWNER_SUBMITTED
  else
    retire_net_control(owner.metadata)
  end
  return owner, status as integer
end

local function finish_net_setup(operation: NetOperation, tcp: uv_tcp_t?,
                                failure: Error?)
  operation.addresses = nil
  operation.owner = nil
  operation.tcp = nil
  if not net_operation_deliverable(operation) then
    if tcp then start_tcp_close(tcp) end
    return
  end
  local task = operation.task
  if failure then
    drive_task(task, DRIVE_ERROR, failure, "")
  else
    local resource = tcp
    resource.metadata.setup_operation = nil
    drive_task(task, DRIVE_RESUME, resource, "")
  end
end

local function continue_net_setup(operation: NetOperation)
  if not net_operation_deliverable(operation) then
    operation.addresses = nil
    return
  end
  local addresses = operation.addresses
  while operation.address_index < addresses.count do
    operation.address_index = operation.address_index + 1
    local task = operation.task
    local runtime = task.runtime
    local tcp, init_status = initialize_tcp(runtime)
    if init_status < 0 then
      operation.last_error = make_error(init_status, "net.tcp.init",
                                        net_operation_subject(operation))
    else
      operation.tcp = tcp
      tcp.metadata.setup_operation = operation
      if operation.kind == NET_CONNECT then
        -- Cache every borrowed native argument before the request owner is
        -- linked.  From allocation through submit, only field stores and the
        -- non-raising C shim call are allowed.
        local tcp_handle = tcp.handle
        local address_data = addresses.data as ffi.titan_ffi_void_ptr
        local address_index = operation.address_index - 1
        local owner, pointer = allocate_connect_owner(runtime, operation)
        operation.owner = owner
        tcp.metadata.connect_pending = true
        local status = shim.titan_uvshim_tcp_connect_start(
            owner.handle, tcp_handle, pointer, address_data,
            address_index)
        if (status as integer) >= 0 then
          owner.metadata.lifecycle = NET_OWNER_SUBMITTED
          return
        end
        tcp.metadata.connect_pending = false
        retire_net_control(owner.metadata)
        operation.last_error = make_error(status as integer, "net.connect",
                                          net_operation_subject(operation))
        start_tcp_close(tcp)
        return
      else
        local status = shim.titan_uvshim_tcp_bind(
            tcp.handle, addresses.data as ffi.titan_ffi_void_ptr,
            operation.address_index - 1)
        if (status as integer) >= 0 then
          status = shim.titan_uvshim_tcp_listen(tcp.handle,
                                                operation.backlog)
        end
        if (status as integer) >= 0 then
          tcp.metadata.lifecycle = TCP_SERVER
          tcp.metadata.server = true
          tcp.metadata.accept_capacity = operation.backlog
          finish_net_setup(operation, tcp, nil)
          return
        end
        operation.last_error = make_error(status as integer, "net.listen",
                                          net_operation_subject(operation))
        start_tcp_close(tcp)
        return
      end
    end
  end
  local failure? = operation.last_error
  if not failure then
    failure = make_error(UV_EADDRNOTAVAIL,
                         "net.resolve", net_operation_subject(operation))
  end
  finish_net_setup(operation, nil, failure)
end

local function advance_tcp_output(tcp: uv_tcp_t,
                                  inline_task: Task?): Error?
  local control = tcp.metadata
  if control.lifecycle == TCP_CLOSING or
      control.lifecycle == TCP_CLOSED then
    while control.output_head do
      remove_output(tcp, control.output_head)
    end
    return nil
  end
  while not control.output_current and control.output_head do
    local operation = control.output_head
    local status: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
    if operation.kind == NET_WRITE then
      -- Prepare and root the copied bytes/buffer before publishing current or
      -- linking a libuv request owner.  A preparation failure therefore leaves
      -- an ordinary queued operation that shutdown can still repair.
      if not operation.prepared_buffer then
        local bytes = copy_bytes(operation.data)
        operation.prepared_buffer = make_buffer(bytes, 0, bytes.length)
      end
      local buffer = operation.prepared_buffer
      local buffer_handle = buffer.handle
      local tcp_handle = tcp.handle
      local owner, pointer = allocate_write_owner(control.runtime, operation)
      operation.owner = owner
      control.output_current = operation
      status = shim.titan_uvshim_tcp_write_start(
          owner.handle, tcp_handle, pointer, buffer_handle)
      if (status as integer) >= 0 then
        owner.metadata.lifecycle = NET_OWNER_SUBMITTED
        operation.prepared_buffer = nil
        return nil
      end
      retire_net_control(owner.metadata)
    else
      local tcp_handle = tcp.handle
      local owner, pointer = allocate_shutdown_owner(control.runtime,
                                                     operation)
      operation.owner = owner
      control.output_current = operation
      status = shim.titan_uvshim_tcp_shutdown_start(
          owner.handle, tcp_handle, pointer)
      if (status as integer) >= 0 then
        owner.metadata.lifecycle = NET_OWNER_SUBMITTED
        return nil
      end
      retire_net_control(owner.metadata)
    end

    -- Synchronous rejection owes no callback.  Retire the native owner and
    -- unlink/clear the FIFO publication before allocating its Error value.
    remove_output(tcp, operation)
    local failure = make_error(status as integer,
        operation.kind == NET_WRITE and "net.write" or "net.shutdown",
        net_operation_subject(operation))
    if operation.task and operation.request then
      local task = operation.task
      local request = operation.request
      if inline_task == task and task.current_request == request and
          task.epoch == request.generation then
        task.current_request = nil
        return failure
      elseif net_operation_deliverable(operation) then
        schedule_task_drive(task, request.generation, DRIVE_ERROR,
                            failure, "", nil)
      end
    else
      promote_fatal(control.runtime, failure, "")
      return nil
    end
  end
  if not control.output_current and not control.output_head and
      control.close_requested and not control.connect_pending then
    start_tcp_close(tcp)
  end
  return nil
end

local function start_tcp_read(tcp: uv_tcp_t): integer
  local status = shim.titan_uvshim_tcp_read_start(tcp.handle)
  if (status as integer) >= 0 then tcp.metadata.read_active = true end
  return status as integer
end

local function start_pipe_read(pipe: uv_pipe_t): integer
  local status = shim.titan_uvshim_pipe_read_start(pipe.handle)
  if (status as integer) >= 0 then pipe.metadata.read_active = true end
  return status as integer
end

local function stop_tcp_read(tcp: uv_tcp_t, discard_queue: boolean)
  local control = tcp.metadata
  if control.read_active then
    shim.titan_uvshim_tcp_read_stop(tcp.handle)
    control.read_active = false
  end
  control.read_bytes = nil
  if discard_queue then control.read_queue = {} end
end

local function close_accepted_queue(server: uv_tcp_t)
  while server.metadata.accept_count > 0 do
    local client = dequeue_accepted(server)
    start_tcp_close(client)
  end
end

local function stop_server_accept(server: uv_tcp_t)
  local control = server.metadata
  local waiter? = control.accept_waiter
  local epoch = control.accept_epoch
  control.accept_waiter = nil
  control.accept_epoch = 0
  close_accepted_queue(server)
  if waiter then
    local task = waiter
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      local failure = make_error(UV_ECANCELED,
                                 "net.accept", "server closed")
      schedule_task_drive(task, epoch, DRIVE_ERROR, failure, "", nil)
    end
  end
end

local function request_tcp_close(tcp: uv_tcp_t)
  local control = tcp.metadata
  if control.close_requested then return end
  control.close_requested = true
  if control.server then
    stop_server_accept(tcp)
  else
    stop_tcp_read(tcp, false)
    local waiter? = control.read_waiter
    local epoch = control.read_epoch
    control.read_waiter = nil
    control.read_epoch = 0
    if waiter then
      local task = waiter
      if task.state == TASK_WAITING and not task.cancel_requested and
          task.epoch == epoch then
        schedule_task_drive(task, epoch, DRIVE_ERROR,
                            "cannot read from a closed Connection", "", nil)
      end
    end
  end
  if not control.output_current and not control.output_head and
      not control.connect_pending then
    start_tcp_close(tcp)
  end
end

local function wake_tcp_close_waiters(tcp: uv_tcp_t)
  local control = tcp.metadata
  while control.close_waiter_head do
    local operation = control.close_waiter_head
    if not net_operation_deliverable(operation) then
      remove_tcp_close_waiter(tcp, operation)
    else
      local task = operation.task
      local request = operation.request
      local epoch = task.epoch
      if not request.cleanup then epoch = request.generation end
      if not schedule_task_drive(task, epoch, DRIVE_RESUME,
                                 nil, "", request) then
        return
      end
      remove_tcp_close_waiter(tcp, operation)
    end
  end
end

local function arm_net_request(task: Task, request: Request): Error?
  local operation: NetOperation = request.subject
  if operation.kind == NET_CONNECT or operation.kind == NET_LISTEN then
    local owner, status = start_dns(operation)
    if status < 0 then
      task.current_request = nil
      return make_error(status, "net.resolve",
                        net_operation_subject(operation))
    end
    task.operation = owner
    task.state = TASK_WAITING
    return nil
  end

  local tcp = operation.tcp
  local control = tcp.metadata
  if operation.kind == NET_READ then
    control.read_waiter = task
    control.read_epoch = request.generation
    task.operation = tcp
    task.state = TASK_WAITING
    return nil
  elseif operation.kind == NET_WRITE or
         operation.kind == NET_SHUTDOWN then
    enqueue_output(tcp, operation)
    task.operation = operation
    task.state = TASK_WAITING
    return advance_tcp_output(tcp, task)
  elseif operation.kind == NET_ACCEPT then
    control.accept_waiter = task
    control.accept_epoch = request.generation
    task.operation = tcp
    task.state = TASK_WAITING
    return nil
  else
    enqueue_tcp_close_waiter(tcp, operation)
    task.operation = operation
    task.state = TASK_WAITING
    request_tcp_close(tcp)
    return nil
  end
end

local function queue_internal_close(file: uv_file)
  if file.state == FS.file_closed or file.close_enqueued then return end
  file.state = FS.file_closing
  local operation = make_fs_operation(FS.internal_close, nil, nil,
      nil, nil, file, "", 0)
  enqueue_file_operation(file, operation)
  advance_file(file)
end

local function wake_close_waiters(file: uv_file, failure: Error?)
  while file.close_waiter_head do
    local operation = file.close_waiter_head
    if not fs_operation_deliverable(operation) then
      remove_close_waiter(file, operation)
    else
      local task = operation.task
      local request = operation.request
      local epoch = request.generation
      if request.cleanup then epoch = task.epoch end
      local scheduled = false
      if not failure then
        scheduled = schedule_task_drive(task, epoch, DRIVE_RESUME,
                                        nil, "", request)
      else
        scheduled = schedule_task_drive(task, epoch, DRIVE_ERROR,
                                        failure, "", request)
      end
      if not scheduled then
        -- The Runtime is fatal now. Keep this exact cleanup waiter linked so
        -- an outer safe point can retry without losing its only completion.
        return
      end
      remove_close_waiter(file, operation)
    end
  end
end

local function fs_stat_kind(kind: integer): string
  if kind == (shim.TITAN_UV_STAT_FILE as integer) then return "file" end
  if kind == (shim.TITAN_UV_STAT_DIRECTORY as integer) then
    return "directory"
  end
  if kind == (shim.TITAN_UV_STAT_SYMLINK as integer) then return "symlink" end
  return "other"
end

local function extract_fs_stat(owner: uv_fs_t): FsStatResult
  local size: libuv.int64_t = 0 as libuv.int64_t
  local mode: libuv.int64_t = 0 as libuv.int64_t
  local modified_seconds: libuv.int64_t = 0 as libuv.int64_t
  local modified_nanoseconds: libuv.int64_t = 0 as libuv.int64_t
  local kind: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
  local statbuf = libuv.uv_fs_get_statbuf(owner.handle)
  shim.titan_uvshim_stat_extract(
      statbuf as ffi.titan_ffi_void_ptr, size, mode,
      modified_seconds, modified_nanoseconds, kind)
  return FsStatResult.new(size as integer, fs_stat_kind(kind as integer),
      mode as integer, modified_seconds as integer,
      modified_nanoseconds as integer)
end

local function fs_dispatch_body(owner: uv_fs_t, result: integer)
  local runtime = owner.metadata.runtime
  owner.metadata.lifecycle = FS_OWNER_CALLBACK
  local operation = owner.metadata.operation
  local payload: value = nil
  local failure: Error? = nil
  if result < 0 then
    failure = make_error(result, fs_operation_name(operation.kind),
                         fs_operation_subject(operation))
  elseif operation.kind == FS.stat then
    payload = extract_fs_stat(owner)
  elseif operation.kind == FS.open then
    -- The thin dispatcher recorded the returned descriptor before entering
    -- this allocating body, so even body-entry GC failure can be repaired.
    payload = nil
  elseif operation.kind == FS.read then
    if result == 0 then
      payload = nil
    else
      payload = bytes_string(owner.buffer.bytes, result)
    end
  elseif operation.kind == FS.write then
    if result == 0 then
      failure = make_error(UV_EIO,
                           "fs.write",
                           fs_operation_subject(operation))
    else
      operation.write_offset = operation.write_offset + result
    end
  elseif operation.kind == FS.list then
    payload = extract_fs_list(owner)
  else
    payload = nil
  end
  clean_fs_owner(owner)

  if operation.kind == FS.open and not failure then
    local file = create_file(runtime, owner.metadata.acquired_file,
                             fs_operation_subject(operation))
    owner.metadata.acquired_file = -1 as libuv.uv_file
    if fs_operation_deliverable(operation) then
      payload = file
    else
      queue_internal_close(file)
    end
  elseif operation.kind == FS.write and not failure and
         operation.write_offset < #operation.data and
         fs_operation_deliverable(operation) then
    -- A partial write remains one logical File FIFO operation.  Root and
    -- submit its next request before retiring the completed request owner.
    local next_owner, status = submit_fs_operation(operation)
    if status >= 0 then
      operation.task.operation = next_owner
      retire_fs_owner_now(owner)
      return
    end
    failure = make_error(status, "fs.write",
                         fs_operation_subject(operation))
    retire_fs_owner_now(next_owner)
  end

  if operation.kind == FS.close or
     operation.kind == FS.internal_close then
    local file = operation.file
    file.close_enqueued = false
    remove_file_operation(file, operation)
    -- A close callback is terminal even when it reports an error. Retrying a
    -- failed close can act on a descriptor that the OS has already reused.
    file.handle = -1 as libuv.uv_file
    file.state = FS.file_closed
    wake_close_waiters(file, failure)
    if fs_operation_deliverable(operation) then
      local task = operation.task
      if not failure then
        drive_task(task, DRIVE_RESUME, nil, "")
      else
        drive_task(task, DRIVE_ERROR, failure, "")
      end
    elseif failure then
      promote_fatal(runtime, failure, "")
    end
    if file.state == FS.file_closed and not file.close_waiter_head then
      -- Unlink only after every potentially throwing wake/Task drive. The
      -- dispatcher catch can then repair any earlier failure from this root.
      unlink_file(file)
    end
    retire_fs_owner_now(owner)
    return
  end

  if fs_operation_deliverable(operation) then
    local task = operation.task
    if failure then
      drive_task(task, DRIVE_ERROR, failure, "")
    else
      drive_task(task, DRIVE_RESUME, payload, "")
    end
  end

  if operation.file then
    local file = operation.file
    remove_file_operation(file, operation)
    advance_file(file)
  end
  retire_fs_owner_now(owner)
end

-- Trusted direct filesystem dispatcher.  The native entry stays deliberately
-- thin; every allocating/extracting/bookkeeping helper call runs after this
-- function's setjmp target and under its trailing catch.
local function fs_dispatch(owner: uv_fs_t, _event_kind: integer,
                           result: integer, _size: libuv.size_t,
                           _pointer: ffi.titan_ffi_void_ptr)
  if result >= 0 and owner.metadata.operation.kind == FS.open then
    owner.metadata.acquired_file = result as libuv.uv_file
  end
  fs_dispatch_body(owner, result)
catch
  owner.metadata.callback_aborted = true
  if owner.metadata.lifecycle ~= FS_OWNER_CLEANED then
    libuv.uv_fs_req_cleanup(owner.handle)
  end
  owner.metadata.lifecycle = FS_OWNER_CLEANED
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function finish_closed_tcp(tcp: uv_tcp_t)
  local control = tcp.metadata
  if control.lifecycle ~= TCP_CLOSED or control.connect_pending or
      control.output_current then return end
  local setup? = control.setup_operation
  if setup then
    local operation = setup
    control.setup_operation = nil
    operation.tcp = nil
    continue_net_setup(operation)
    -- This is the callback tail: no allocating or user-code call follows the
    -- final unlink/field clears in discard_tcp_storage.
    discard_tcp_storage(tcp)
    return
  end
  wake_tcp_close_waiters(tcp)
  if not control.close_waiter_head then
    discard_tcp_storage(tcp)
  end
end

local function dns_dispatch_body(owner: uv_getaddrinfo_t, result: integer,
                                 pointer: ffi.titan_ffi_void_ptr)
  local control = owner.metadata
  control.lifecycle = NET_OWNER_CALLBACK
  local operation = control.operation
  local failure: Error? = nil
  if result < 0 then
    free_dns_result(control)
    failure = make_error(result, "net.resolve",
                         net_operation_subject(operation))
  else
    local addresses = copy_addresses(pointer, net_operation_subject(operation))
    -- Root the copied address array in the operation before entering another
    -- helper or releasing the borrowed addrinfo chain.
    operation.addresses = addresses
    free_dns_result(control)
    if addresses.count == 0 then
      failure = make_error(UV_EADDRNOTAVAIL,
                           "net.resolve", net_operation_subject(operation))
    end
  end

  -- Keep the native request owner runtime-rooted through setup continuation
  -- and any user Task drive.  A catch can then still dereference it safely.
  if failure then
    finish_net_setup(operation, nil, failure)
  elseif net_operation_deliverable(operation) then
    operation.address_index = 0
    continue_net_setup(operation)
  else
    operation.addresses = nil
  end
  retire_net_control(control)
end

-- The borrowed addrinfo pointer is captured before the allocating body.  The
-- trailing catch can therefore release it exactly once without allowing a
-- longjmp to cross libuv.
local function dns_dispatch(owner: uv_getaddrinfo_t, _event_kind: integer,
                            result: integer, _size: libuv.size_t,
                            pointer: ffi.titan_ffi_void_ptr)
  owner.metadata.result_pointer = pointer
  dns_dispatch_body(owner, result, pointer)
catch
  if owner.metadata.result_pointer ~= nil then
    shim.titan_uvshim_addrinfo_free(owner.metadata.result_pointer)
    owner.metadata.result_pointer = nil
  end
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function connect_dispatch_body(owner: uv_connect_t, result: integer)
  local control = owner.metadata
  control.lifecycle = NET_OWNER_CALLBACK
  local operation = control.operation
  local tcp = operation.tcp
  if result >= 0 and net_operation_deliverable(operation) then
    local read_status = start_tcp_read(tcp)
    if read_status < 0 then
      operation.last_error = make_error(
          read_status, "net.read.start", net_operation_subject(operation))
      operation.address_index = operation.addresses.count
      start_tcp_close(tcp)
      retire_net_control(control)
      return
    end
    tcp.metadata.lifecycle = TCP_CONNECTION
    tcp.metadata.server = false
    tcp.metadata.setup_operation = nil
    operation.addresses = nil
    operation.tcp = nil
    drive_task(operation.task, DRIVE_RESUME, tcp, "")
    retire_net_control(control)
    return
  end

  if result < 0 then
    operation.last_error = make_error(result, "net.connect",
                                      net_operation_subject(operation))
  end
  start_tcp_close(tcp)
  retire_net_control(control)
end

local function connect_dispatch(owner: uv_connect_t, _event_kind: integer,
                                result: integer, _size: libuv.size_t,
                                _pointer: ffi.titan_ffi_void_ptr)
  if owner.metadata.operation.tcp then
    owner.metadata.operation.tcp.metadata.connect_pending = false
  end
  connect_dispatch_body(owner, result)
catch
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function complete_output_callback(control: NetRequestControl,
                                        result: integer,
                                        operation_name: string)
  local runtime = control.runtime
  control.lifecycle = NET_OWNER_CALLBACK
  local operation = control.operation
  local tcp = operation.tcp
  local failure: Error? = nil
  if result < 0 then
    failure = make_error(result, operation_name,
                         net_operation_subject(operation))
  end

  -- The completed owner remains linked and roots operation while the FIFO is
  -- advanced and user continuation runs.  Terminal unlink is the callback
  -- tail, preserving a valid owner for the outer catch on every earlier path.
  remove_output(tcp, operation)
  advance_tcp_output(tcp, nil)
  if net_operation_deliverable(operation) then
    if failure then
      drive_task(operation.task, DRIVE_ERROR, failure, "")
    else
      drive_task(operation.task, DRIVE_RESUME, nil, "")
    end
  elseif failure and not operation.task then
    promote_fatal(runtime, failure, "")
  end
  retire_net_control(control)
end

local function write_dispatch(owner: uv_write_t, _event_kind: integer,
                              result: integer, _size: libuv.size_t,
                              _pointer: ffi.titan_ffi_void_ptr)
  complete_output_callback(owner.metadata, result, "net.write")
catch
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function shutdown_dispatch(owner: uv_shutdown_t,
                                 _event_kind: integer, result: integer,
                                 _size: libuv.size_t,
                                 _pointer: ffi.titan_ffi_void_ptr)
  if result >= 0 and owner.metadata.operation.tcp then
    owner.metadata.operation.tcp.metadata.write_shutdown = true
  end
  complete_output_callback(owner.metadata, result, "net.shutdown")
catch
  owner.metadata.lifecycle = NET_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function tcp_alloc_dispatch(tcp: uv_tcp_t, size: libuv.size_t,
                                  pointer: ffi.titan_ffi_void_ptr)
  local control = tcp.metadata
  if control.read_bytes then raise internal_error("net.read.alloc.pending") end
  local bytes = allocate_stream_bytes(size)
  control.read_bytes = bytes
  shim.titan_uvshim_buf_init(pointer, bytes.data, size)
end

local function tcp_read_dispatch(tcp: uv_tcp_t, result: integer)
  local control = tcp.metadata
  if result == 0 then
    control.read_bytes = nil
    return
  end
  local waiter? = control.read_waiter
  local epoch = control.read_epoch
  local bytes? = control.read_bytes
  if result < 0 then
    if control.read_active then
      shim.titan_uvshim_tcp_read_stop(tcp.handle)
      control.read_active = false
    end
    control.read_bytes = nil
    control.read_waiter = nil
    control.read_epoch = 0
    if result == UV_EOF then
      control.read_terminal = TCP_READ_EOF
      if waiter then
        local task = waiter
        if task.state == TASK_WAITING and not task.cancel_requested and
            task.epoch == epoch then
          drive_task(task, DRIVE_RESUME, nil, "")
        end
      end
    else
      control.read_terminal = TCP_READ_ERROR
      local failure = make_error(result, "net.read", "connection")
      control.read_error = failure
      start_tcp_close(tcp)
      if waiter then
        local task = waiter
        if task.state == TASK_WAITING and not task.cancel_requested and
            task.epoch == epoch then
          drive_task(task, DRIVE_ERROR, failure, "")
        end
      end
    end
    return
  end

  if not bytes then raise internal_error("net.read.missing.allocation") end
  local bytes = bytes
  if waiter then
    local task = waiter
    control.read_waiter = nil
    control.read_epoch = 0
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      local payload = bytes_string(bytes, result)
      control.read_bytes = nil
      drive_task(task, DRIVE_RESUME, payload, "")
      return
    end
  end
  control.read_waiter = nil
  control.read_epoch = 0
  bytes.length = result
  control.read_queue[#control.read_queue + 1] = bytes
  control.read_bytes = nil
end

local function server_callback_failure(server: uv_tcp_t, failure: Error)
  local control = server.metadata
  control.accept_error = failure
  local waiter? = control.accept_waiter
  local epoch = control.accept_epoch
  control.accept_waiter = nil
  control.accept_epoch = 0
  close_accepted_queue(server)
  control.close_requested = true
  start_tcp_close(server)
  if waiter then
    local task = waiter
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      drive_task(task, DRIVE_ERROR, failure, "")
    end
  end
end

local function tcp_connection_dispatch(server: uv_tcp_t, result: integer)
  if result < 0 then
    server_callback_failure(server,
        make_error(result, "net.accept", "server"))
    return
  end
  local client, init_status = initialize_tcp(server.metadata.runtime)
  if init_status < 0 then
    server_callback_failure(server,
        make_error(init_status, "net.accept.init", "server"))
    return
  end
  local status = shim.titan_uvshim_tcp_accept(server.handle, client.handle)
  if (status as integer) < 0 then
    start_tcp_close(client)
    server_callback_failure(server,
        make_error(status as integer, "net.accept", "server"))
    return
  end
  client.metadata.lifecycle = TCP_CONNECTION
  client.metadata.server = false
  local control = server.metadata
  local waiter? = control.accept_waiter
  local epoch = control.accept_epoch
  local recipient: Task? = nil
  if waiter then
    local task = waiter
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      recipient = task
    else
      control.accept_waiter = nil
      control.accept_epoch = 0
    end
  end
  if not recipient and control.accept_count >= control.accept_capacity then
    start_tcp_close(client)
    return
  end
  local read_status = start_tcp_read(client)
  if read_status < 0 then
    start_tcp_close(client)
    server_callback_failure(server,
        make_error(read_status, "net.accept.read.start", "server"))
    return
  end
  if recipient then
    control.accept_waiter = nil
    control.accept_epoch = 0
    drive_task(recipient, DRIVE_RESUME, client, "")
  elseif not enqueue_accepted(server, client) then
    -- Capacity was checked before initialization and callbacks are serial, so
    -- reaching this branch indicates an internal queue invariant failure.
    start_tcp_close(client)
    raise internal_error("net.accept.queue")
  end
end

local function tcp_dispatch_body(owner: uv_tcp_t, event_kind: integer,
                                 result: integer, size: libuv.size_t,
                                 pointer: ffi.titan_ffi_void_ptr)
  local control = owner.metadata
  if event_kind == EVENT_HANDLE_CLOSE then
    finish_closed_tcp(owner)
  elseif event_kind == EVENT_STREAM_ALLOC then
    tcp_alloc_dispatch(owner, size, pointer)
  elseif event_kind == EVENT_STREAM_READ then
    tcp_read_dispatch(owner, result)
  elseif event_kind == EVENT_CONNECTION then
    if control.lifecycle == TCP_CLOSING or
       control.lifecycle == TCP_CLOSED then
      return
    end
    tcp_connection_dispatch(owner, result)
  end
end

local function tcp_dispatch(owner: uv_tcp_t, event_kind: integer,
                            result: integer, size: libuv.size_t,
                            pointer: ffi.titan_ffi_void_ptr)
  if event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.lifecycle = TCP_CLOSED
  end
  tcp_dispatch_body(owner, event_kind, result, size, pointer)
catch
  -- A failed alloc callback returns the shim's NULL/zero descriptor. libuv's
  -- Unix stream path must then issue UV_ENOBUFS through read_cb; stopping here
  -- would clear that callback before libuv calls it.
  if event_kind ~= EVENT_STREAM_ALLOC and
      owner.metadata.read_active and owner.handle ~= nil then
    shim.titan_uvshim_tcp_read_stop(owner.handle)
    owner.metadata.read_active = false
  end
  owner.metadata.read_bytes = nil
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function deliver_process_disposer(task: Task?, epoch: integer)
  if task then
    local task = task
    local request? = task.current_request
    if request then
      local request = request
      if request.kind == REQUEST_PROCESS and request.cleanup and
          task.state == TASK_WAITING and task.cleanup_shield_depth > 0 and
          request.generation == epoch then
        drive_task(task, DRIVE_RESUME, nil, "")
        return
      end
    end
  end
end

local function finish_process_control(control: ProcessControl)
  if not control.linked or not process_all_native_closed(control) then return end
  if control.spawn_operation then
    local operation? = control.spawn_operation
    local failure = control.pending_failure
    retire_unpublished_process(control)
    if operation then
      local operation = operation
      if process_operation_deliverable(operation) then
        drive_task(operation.task, DRIVE_ERROR,
                   failure, "")
      end
    end
    return
  end
  -- Successfully spawned wrappers retain their terminal PipeControls so
  -- repeated EOF, read-error, stdin-close, and cached-wait queries remain
  -- allocation-free.
  local raw_disposer? = control.dispose_task
  local dispose_epoch = control.dispose_epoch
  control.dispose_task = nil
  control.dispose_epoch = 0
  control.owner = nil
  unlink_process_control(control)
  deliver_process_disposer(raw_disposer, dispose_epoch)
end

local function deliver_process_waiter(control: ProcessControl)
  local task? = control.wait_task
  local epoch = control.wait_epoch
  if task then
    local task = task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      local result = ProcessExitResult.new(control.exit_status,
                                           control.term_signal)
      control.wait_task = nil
      control.wait_epoch = 0
      drive_task(task, DRIVE_RESUME, result, "")
      return
    end
  end
  control.wait_task = nil
  control.wait_epoch = 0
end

local function process_dispatch_body(owner: uv_process_t,
                                     event_kind: integer)
  local control = owner.metadata
  local runtime = control.runtime
  if event_kind == EVENT_PROCESS_EXIT then
    close_process_grace(control)
    if control.stdin_pipe then
      start_pipe_close(control.stdin_pipe)
    end
    -- A successful spawn is never closed before this exit callback.  Publish
    -- the close transition before any eventual waiter continuation runs.
    start_process_close(owner)
    control.callback_aborted = false
    return
  elseif event_kind == EVENT_HANDLE_CLOSE then
    owner.handle = nil
    owner.storage = nil
    control.owner = owner
    deliver_process_waiter(control)
    control.callback_aborted = false
    finish_process_control(control)
    maybe_finish_session(runtime)
    return
  end
end

-- The native trampoline calls this trusted Titan entry directly.  Exit/close
-- state is recorded before the allocating body; its trailing catch is the
-- sole longjmp fence and no protected Lua call is inserted in the hot path.
local function process_dispatch(owner: uv_process_t, event_kind: integer,
                                result: integer, size: libuv.size_t,
                                _pointer: ffi.titan_ffi_void_ptr)
  if event_kind == EVENT_PROCESS_EXIT then
    owner.metadata.exit_seen = true
    owner.metadata.exit_status = result
    owner.metadata.term_signal = size as integer
    owner.metadata.lifecycle = PROCESS_EXITED
  elseif event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.lifecycle = PROCESS_CLOSED
  end
  process_dispatch_body(owner, event_kind)
catch
  owner.metadata.callback_aborted = true
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function pipe_alloc_dispatch(pipe: uv_pipe_t, size: libuv.size_t,
                                   pointer: ffi.titan_ffi_void_ptr)
  local control = pipe.metadata
  if control.read_bytes then
    raise internal_error("process.read.alloc.pending")
  end
  local bytes = allocate_stream_bytes(size)
  control.read_bytes = bytes
  shim.titan_uvshim_buf_init(pointer, bytes.data, size)
end

local function pipe_read_dispatch(pipe: uv_pipe_t, result: integer)
  local control = pipe.metadata
  if result == 0 then
    control.read_bytes = nil
    return
  end
  local waiter? = control.read_waiter
  local epoch = control.read_epoch
  local bytes? = control.read_bytes
  if result < 0 then
    if control.read_active then
      shim.titan_uvshim_pipe_read_stop(pipe.handle)
      control.read_active = false
    end
    control.read_bytes = nil
    control.read_waiter = nil
    control.read_epoch = 0
    if result == UV_EOF then
      control.read_terminal = TCP_READ_EOF
      start_pipe_close(pipe)
      if waiter then
        local task = waiter
        if task.state == TASK_WAITING and not task.cancel_requested and
            task.epoch == epoch then
          drive_task(task, DRIVE_RESUME, nil, "")
        end
      end
    else
      control.read_terminal = TCP_READ_ERROR
      local operation = control.kind == PIPE_STDOUT and
                        "process.stdout.read" or "process.stderr.read"
      local failure = make_error(result, operation, nil)
      control.read_error = failure
      start_pipe_close(pipe)
      if waiter then
        local task = waiter
        if task.state == TASK_WAITING and not task.cancel_requested and
            task.epoch == epoch then
          drive_task(task, DRIVE_ERROR, failure, "")
        end
      end
    end
    return
  end

  if not bytes then
    raise internal_error("process.read.missing.allocation")
  end
  local bytes = bytes
  if waiter then
    local task = waiter
    control.read_waiter = nil
    control.read_epoch = 0
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      local payload = bytes_string(bytes, result)
      control.read_bytes = nil
      drive_task(task, DRIVE_RESUME, payload, "")
      return
    end
  end
  control.read_waiter = nil
  control.read_epoch = 0
  bytes.length = result
  control.read_queue[#control.read_queue + 1] = bytes
  control.read_bytes = nil
end

local function finish_pipe_close(pipe: uv_pipe_t)
  local control = pipe.metadata
  local runtime = control.runtime
  local close? = control.close_waiter
  while control.output_head do
    local operation = control.output_head
    remove_pipe_output(pipe, operation)
    if operation.kind == PROCESS_CLOSE_STDIN then
      close = operation
      control.close_waiter = operation
    elseif process_operation_deliverable(operation) then
      local failure = make_error(UV_ECANCELED, "process.stdin.write", nil)
      drive_task(operation.task, DRIVE_ERROR, failure, "")
    end
  end
  pipe.handle = nil
  pipe.storage = nil
  control.owner = nil
  control.callback_aborted = false
  finish_process_control(control.process)
  maybe_finish_session(runtime)
  if close then
    local operation = close
    control.close_waiter = nil
    if process_operation_deliverable(operation) then
      drive_task(operation.task, DRIVE_RESUME, nil, "")
    end
  end
end

local function pipe_dispatch_body(owner: uv_pipe_t, event_kind: integer,
                                  result: integer, size: libuv.size_t,
                                  pointer: ffi.titan_ffi_void_ptr)
  if event_kind == EVENT_HANDLE_CLOSE then
    finish_pipe_close(owner)
  elseif event_kind == EVENT_STREAM_ALLOC then
    pipe_alloc_dispatch(owner, size, pointer)
  elseif event_kind == EVENT_STREAM_READ then
    pipe_read_dispatch(owner, result)
  end
end

local function pipe_dispatch(owner: uv_pipe_t, event_kind: integer,
                             result: integer, size: libuv.size_t,
                             pointer: ffi.titan_ffi_void_ptr)
  if event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.lifecycle = PIPE_CLOSED
  end
  pipe_dispatch_body(owner, event_kind, result, size, pointer)
catch
  owner.metadata.callback_aborted = true
  -- Preserve read_cb after an alloc failure so libuv can report UV_ENOBUFS
  -- for the shim's NULL/zero descriptor before the read side is stopped.
  if event_kind ~= EVENT_STREAM_ALLOC and
      owner.metadata.read_active and owner.handle ~= nil then
    shim.titan_uvshim_pipe_read_stop(owner.handle)
    owner.metadata.read_active = false
  end
  owner.metadata.read_bytes = nil
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function complete_pipe_request(control: ProcessRequestControl,
                                     result: integer)
  control.lifecycle = PROCESS_OWNER_CALLBACK
  local operation = control.operation
  local pipe = operation.pipe
  local failure: Error? = nil
  if result < 0 then
    failure = make_error(result, "process.stdin.write", nil)
  end
  remove_pipe_output(pipe, operation)
  advance_pipe_output(pipe, nil)
  if process_operation_deliverable(operation) then
    if failure then
      drive_task(operation.task, DRIVE_ERROR, failure, "")
    else
      drive_task(operation.task, DRIVE_RESUME, nil, "")
    end
  end
  retire_process_request(control)
end

local function pipe_write_dispatch(owner: uv_pipe_write_t,
                                   _event_kind: integer,
                                   result: integer,
                                   _size: libuv.size_t,
                                   _pointer: ffi.titan_ffi_void_ptr)
  complete_pipe_request(owner.metadata, result)
catch
  owner.metadata.lifecycle = PROCESS_OWNER_CALLBACK
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function process_grace_dispatch(owner: uv_process_grace_t,
                                      event_kind: integer,
                                      _result: integer,
                                      _size: libuv.size_t,
                                      _pointer: ffi.titan_ffi_void_ptr)
  local control = owner.metadata
  local runtime = control.runtime
  if event_kind == EVENT_TIMER then control.grace_fired = true end
  if event_kind == EVENT_TIMER then
    libuv.uv_timer_stop(owner.handle)
    if not control.exit_seen and not control.kill_sent then
      local process = control.owner
      local kill = shim.titan_uvshim_signal_number("kill")
      local status = libuv.uv_process_kill(process.handle, kill)
      if (status as integer) < 0 and
          (status as integer) ~= UV_ESRCH then
        raise make_error(status as integer, "process.kill", "kill")
      end
      control.kill_sent = true
    end
    shim.titan_uvshim_timer_close(owner.handle)
  elseif event_kind == EVENT_HANDLE_CLOSE then
    control.grace_owner = nil
    control.grace_callback_aborted = false
    owner.handle = nil
    owner.storage = nil
    finish_process_control(control)
    maybe_finish_session(runtime)
  end
catch
  owner.metadata.grace_callback_aborted = true
  if event_kind == EVENT_TIMER then
    libuv.uv_timer_stop(owner.handle)
    if not owner.metadata.exit_seen and not owner.metadata.kill_sent and
        owner.metadata.owner then
      local process = owner.metadata.owner
      local kill = shim.titan_uvshim_signal_number("kill")
      local status = libuv.uv_process_kill(process.handle, kill)
      if (status as integer) >= 0 or
          (status as integer) == UV_ESRCH then
        owner.metadata.kill_sent = true
      end
    end
    if (shim.titan_uvshim_timer_is_closing(owner.handle) as integer) == 0 then
      shim.titan_uvshim_timer_close(owner.handle)
    end
  elseif event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.grace_owner = nil
    owner.handle = nil
    owner.storage = nil
  end
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

-- Trusted one-shot signal dispatcher.  Stop + close state is published before
-- a signal can resume arbitrary Titan code; the trailing catch never unwinds
-- through libuv's native callback frame.
local function signal_dispatch(owner: uv_signal_t, event_kind: integer,
                               _result: integer, _size: libuv.size_t,
                               _pointer: ffi.titan_ffi_void_ptr)
  local runtime = owner.metadata.runtime

  if event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.lifecycle = OWNER_CLOSED
    maybe_finish_session(runtime)
    owner.handle = nil
    owner.storage = nil
    unlink_signal_owner(owner)
    return
  end

  local task? = owner.metadata.task
  local epoch = owner.metadata.epoch
  local name = owner.metadata.name
  owner.metadata.task = nil
  owner.metadata.epoch = 0
  close_signal_owner(owner)

  if task then
    local task = task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == epoch then
      drive_task(task, DRIVE_RESUME, name, "")
    end
  end
catch
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

-- Trusted direct native dispatcher.  drive_task owns the inner Task catch;
-- this function's trailing catch is the non-raising Runtime invariant fence.
local function timer_dispatch(owner: uv_timer_t, event_kind: integer,
                              _result: integer, _size: libuv.size_t,
                              _pointer: ffi.titan_ffi_void_ptr)
  local runtime = owner.metadata.runtime

  if event_kind == EVENT_HANDLE_CLOSE then
    local kind = owner.metadata.kind
    owner.metadata.lifecycle = OWNER_CLOSED
    if kind == OWNER_OBSERVE then
      runtime.pending_observations = runtime.pending_observations - 1
    end
    -- Keep this callback's owner strongly reachable while a helper can run or
    -- raise.  Only non-raising field clears remain after session bookkeeping;
    -- unlinking is the final owner operation before returning to the shim.
    maybe_finish_session(runtime)
    owner.handle = nil
    owner.storage = nil
    unlink_owner(owner)
    return
  end

  local kind = owner.metadata.kind
  if kind ~= OWNER_TICKER then
    close_owner(owner)
  end

  if kind == OWNER_START then
    local task = owner.metadata.task
    if task.state == TASK_READY and not task.cancel_requested then
      drive_task(task, DRIVE_RESUME, nil, "")
    end
  elseif kind == OWNER_SLEEP then
    local task = owner.metadata.task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_RESUME, nil, "")
    end
  elseif kind == OWNER_CANCEL then
    local task = owner.metadata.task
    if not terminal(task.state) and task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_ERROR, task.cancel_value, "")
    end
  elseif kind == OWNER_JOIN_WAKE then
    local task = owner.metadata.task
    local target: Task = owner.metadata.peer
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      -- A waiting join is only permanently observed when this delivery wins.
      -- Until now cancellation may revoke the observer and promote an
      -- otherwise-unobserved target failure on its own next turn.
      target.permanently_observed = true
      remove_joiner(task)
      if target.state == TASK_SUCCEEDED then
        drive_task(task, DRIVE_RESUME, target.result, "")
      elseif target.state == TASK_FAILED or target.state == TASK_CANCELLED then
        drive_task(task, DRIVE_ERROR, target.error_value,
                   target.error_traceback)
      else
        raise "Join wakeup target is not terminal"
      end
    end
  elseif kind == OWNER_OBSERVE then
    local task = owner.metadata.task
    if task.state == TASK_FAILED and not task.permanently_observed and
        task.observer_count == 0 then
      promote_fatal(runtime, task.error_value, task.error_traceback)
    end
  elseif kind == OWNER_TASK_DRIVE then
    local task = owner.metadata.task
    local control: DriveControl = owner.metadata.peer
    local deliver = false
    if control.cleanup_request then
      local request = control.cleanup_request
      deliver = request.cleanup and task.state == TASK_WAITING and
                task.current_request == request and
                task.cleanup_shield_depth > 0
    else
      deliver = task.state == TASK_WAITING and
                task.epoch == owner.metadata.epoch
    end
    if deliver then
      drive_task(task, control.mode, control.payload, control.trace)
    end
  elseif kind == OWNER_TICKER then
    local state: TickerState = owner.metadata.peer
    if state.open and state.waiter then
      local task = state.waiter
      local epoch = state.waiter_epoch
      state.waiter = nil
      state.waiter_epoch = 0
      if task.state == TASK_WAITING and not task.cancel_requested and
          task.epoch == epoch then
        drive_task(task, DRIVE_RESUME, true, "")
      end
    end
  elseif kind == OWNER_TICKER_CLOSE_WAKE then
    local task = owner.metadata.task
    if task.state == TASK_WAITING and not task.cancel_requested and
        task.epoch == owner.metadata.epoch then
      drive_task(task, DRIVE_RESUME, false, "")
    end
  end
catch
  if not owner.metadata.runtime.fatal then
    owner.metadata.runtime.fatal = true
    owner.metadata.runtime.closing = true
    owner.metadata.runtime.fatal_error = error
    owner.metadata.runtime.fatal_traceback = traceback
  end
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function adapt(func: () -> value): (value) -> value
  return function (_ignored: value): value
    return func()
  end
end

local function run_internal(func: () -> value, is_main: boolean): Task
  local runtime = ensure_runtime()
  local root = coroutine.create(adapt(func), UV_TAG)
  local task: Task = {
    root = root,
    runtime = runtime,
    generation = runtime.generation,
    state = TASK_NEW,
    epoch = 0,
    result = nil,
    error_value = nil,
    error_traceback = "",
    cancel_requested = false,
    cancel_value = nil,
    operation = nil,
    current_request = nil,
    joiner_head = nil,
    join_next = nil,
    join_previous = nil,
    joining_target = nil,
    next_task = nil,
    previous_task = nil,
    permanently_observed = false,
    observer_count = 0,
    cleanup_shield_depth = 0,
    cancel_fallback = false,
    helper_group = nil,
    helper_kind = 0,
    main = is_main,
  }
  link_task(runtime, task)

  local owner, status = start_owner(runtime, OWNER_START, task, nil, 0, 0, 0)
  task.operation = owner
  if status < 0 then
    finish_task(task, TASK_FAILED, nil,
                make_error(status, "task.start", nil), "")
  else
    task.state = TASK_READY
  end
  return task
end

function _run(func: () -> value): Task
  return run_internal(func, false)
end

function Task:status(): string
  if self.state == TASK_NEW then return "new" end
  if self.state == TASK_READY then return "ready" end
  if self.state == TASK_RUNNING then return "running" end
  if self.state == TASK_WAITING then return "waiting" end
  if self.state == TASK_SUCCEEDED then return "succeeded" end
  if self.state == TASK_FAILED then return "failed" end
  return "cancelled"
end

function Task:cancel(reason: value)
  request_cancel(self, reason)
end

function Task:join(): value
  if self.state == TASK_SUCCEEDED then
    self.permanently_observed = true
    return self.result
  elseif self.state == TASK_FAILED or self.state == TASK_CANCELLED then
    self.permanently_observed = true
    raise_joined(self.error_value, self.error_traceback)
  end

  local task = running_task()
  if task == self then
    raise "a Task cannot join itself"
  end
  if task.runtime ~= self.runtime or task.generation ~= self.generation then
    raise "cannot join a Task from another libuv Runtime"
  end
  local request = new_request(REQUEST_JOIN, self, 0)
  do
    return coroutine.yield(request, UV_TAG)
  catch
    local target_trace? = pop_trace_for_append()
    if target_trace then
      reinstall_trace(target_trace .. "\n" .. traceback)
    end
    raise error
  end
end

function _sleep(milliseconds: integer)
  if milliseconds < 0 then
    raise "sleep duration must not be negative"
  end
  local request = new_request(REQUEST_SLEEP, nil, milliseconds)
  coroutine.yield(request, UV_TAG)
end

function _yield()
  _sleep(0)
end

local function cleanup_begin()
  local task = running_task()
  task.cleanup_shield_depth = task.cleanup_shield_depth + 1
end

local function cleanup_end()
  local task = running_task()
  task.cleanup_shield_depth = task.cleanup_shield_depth - 1
end

function _fs_open(path: string, mode: string): uv_file
  fs_open_flags(mode)
  local request = new_fs_request(FS.open, path, nil, mode)
  return coroutine.yield(request, UV_TAG)
end

function _fs_read(file: uv_file, max_bytes: integer): string?
  if max_bytes <= 0 then raise "read size must be positive" end
  if max_bytes > UV_BUF_MAX then
    raise "read size exceeds the portable libuv buffer limit"
  end
  validate_file(file, "read from", false)
  local request = new_file_request(FS.read, file, "", max_bytes, false)
  return coroutine.yield(request, UV_TAG)
end

function _fs_write(file: uv_file, data: string): integer
  ordinary_task()
  validate_file(file, "write to", false)
  if #data == 0 then return 0 end
  if #data > UV_BUF_MAX then
    raise "write data exceeds the portable libuv buffer limit"
  end
  local request = new_file_request(FS.write, file, data, 0, false)
  coroutine.yield(request, UV_TAG)
  return #data
end

function _fs_flush(file: uv_file)
  validate_file(file, "flush", false)
  local request = new_file_request(FS.flush, file, "", 0, false)
  coroutine.yield(request, UV_TAG)
end

function _fs_is_closed(file: uv_file): boolean
  return file.state == FS.file_closed
end

function _fs_close(file: uv_file)
  if file.state == FS.file_closed then return end
  validate_file(file, "close", true)
  local kind = FS.close_wait
  if file.state == FS.file_open then
    file.state = FS.file_closing
  end
  if not file.close_enqueued then
    kind = FS.close
  end
  cleanup_begin()
  do
    local request = new_file_request(kind, file, "", 0, true)
    coroutine.yield(request, UV_TAG)
  finally
    cleanup_end()
  end
end

function _fs_stat(path: string): (integer, string, integer, integer, integer)
  local request = new_fs_request(FS.stat, path, nil, "")
  local result: FsStatResult = coroutine.yield(request, UV_TAG)
  return result.size, result.kind, result.mode,
         result.modified_seconds, result.modified_nanoseconds
end

function _fs_mkdir(path: string)
  coroutine.yield(new_fs_request(FS.mkdir, path, nil, ""), UV_TAG)
end

function _fs_unlink(path: string)
  coroutine.yield(new_fs_request(FS.unlink, path, nil, ""), UV_TAG)
end

function _fs_rmdir(path: string)
  coroutine.yield(new_fs_request(FS.rmdir, path, nil, ""), UV_TAG)
end

function _fs_rename(from: string, to: string)
  coroutine.yield(new_fs_request(FS.rename, from, to, ""), UV_TAG)
end

function _fs_list(path: string): {string}
  return coroutine.yield(new_fs_request(FS.list, path, nil, ""),
                         UV_TAG)
end

function _net_connect(host: string, port: integer): uv_tcp_t
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
  local request = new_net_request(NET_CONNECT, host, port, 0,
                                  nil, "", false)
  return coroutine.yield(request, UV_TAG)
end

function _net_listen(host: string, port: integer,
                     backlog: integer): uv_tcp_t
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
  if backlog <= 0 then raise "TCP listen backlog must be positive" end
  if backlog > 2147483647 then
    raise "TCP listen backlog is not representable by libuv"
  end
  local request = new_net_request(NET_LISTEN, host, port, backlog,
                                  nil, "", false)
  return coroutine.yield(request, UV_TAG)
end

function _net_read(tcp: uv_tcp_t): string?
  local task = ordinary_task()
  local control = tcp.metadata
  if control.runtime ~= task.runtime or
      control.generation ~= task.runtime.generation then
    raise "TCP resource belongs to a stale libuv Runtime"
  end
  if control.server then raise "read from requires a Connection" end
  if #control.read_queue > 0 then
    local payload = queued_bytes_string(control.read_queue)
    control.read_queue = {}
    return payload
  end
  if control.read_terminal == TCP_READ_EOF then return nil end
  if control.read_terminal == TCP_READ_ERROR then raise control.read_error end
  if control.close_requested or control.lifecycle == TCP_CLOSING or
      control.lifecycle == TCP_CLOSED then
    raise "cannot read from a closed Connection"
  end
  if control.read_waiter then
    raise "Connection already has a waiting reader"
  end
  local request = new_net_request(NET_READ, nil, 0, 0,
                                  tcp, "", false)
  return coroutine.yield(request, UV_TAG)
end

function _net_read_error_is(tcp: uv_tcp_t, candidate: value): boolean
  local control = tcp.metadata
  if control.read_terminal ~= TCP_READ_ERROR or not control.read_error then
    return false
  end
  return candidate == control.read_error
end

function _net_write(tcp: uv_tcp_t, data: string)
  ordinary_task()
  validate_tcp(tcp, "write to", false, false)
  if tcp.metadata.shutdown_requested then
    raise "cannot write after Connection shutdown"
  end
  if #data == 0 then return end
  if #data > UV_BUF_MAX then
    raise "TCP write data exceeds the portable libuv buffer limit"
  end
  local request = new_net_request(NET_WRITE, nil, 0, 0,
                                  tcp, data, false)
  coroutine.yield(request, UV_TAG)
end

function _net_shutdown(tcp: uv_tcp_t)
  ordinary_task()
  validate_tcp(tcp, "shut down", false, false)
  if tcp.metadata.shutdown_requested then return end
  cleanup_begin()
  do
    -- Construct the complete shielded Request before publishing the monotonic
    -- shutdown flag. Once visible, cancellation cannot detach the physical
    -- FIFO work and is delivered only after uv_shutdown completes.
    local request = new_net_request(NET_SHUTDOWN, nil, 0, 0,
                                    tcp, "", true)
    tcp.metadata.shutdown_requested = true
    coroutine.yield(request, UV_TAG)
  finally
    cleanup_end()
  end
end

function _net_accept(server: uv_tcp_t): uv_tcp_t
  ordinary_task()
  local control = validate_tcp_identity(server, "accept on", true)
  if control.accept_error then raise control.accept_error end
  validate_tcp_lifecycle(control, "accept on", false)
  if control.accept_count > 0 then
    local client = dequeue_accepted(server)
    return client
  end
  if control.accept_waiter then
    raise "Server already has a waiting accept Task"
  end
  local request = new_net_request(NET_ACCEPT, nil, 0, 0,
                                  server, "", false)
  return coroutine.yield(request, UV_TAG)
end

function _net_close(tcp: uv_tcp_t)
  if tcp.metadata.lifecycle == TCP_CLOSED then return end
  validate_tcp(tcp, "close", tcp.metadata.server, true)
  cleanup_begin()
  do
    local kind = NET_CLOSE
    if tcp.metadata.close_requested then kind = NET_CLOSE_WAIT end
    local request = new_net_request(kind, nil, 0, 0,
                                    tcp, "", true)
    coroutine.yield(request, UV_TAG)
  finally
    cleanup_end()
  end
end

function _net_is_closed(tcp: uv_tcp_t): boolean
  return tcp.metadata.lifecycle == TCP_CLOSED
end

function _bytes_find(haystack: string, needle: string): integer
  return shim.titan_uvshim_bytes_find(
      haystack, #haystack, needle, #needle) as integer
end

function _bytes_slice(data: string, offset: integer,
                      length: integer): string
  if offset < 0 or length < 0 or offset > #data or
      length > #data - offset then
    raise "byte slice is out of range"
  end
  local bytes = allocate_bytes(length)
  shim.titan_uvshim_bytes_slice_copy(bytes.data, data, offset, length)
  return bytes_string(bytes, length)
end

function _net_eof_error(operation: string, message: string,
                        subject: string): Error
  local code = UV_EOF
  return Error.new(code,
      libuv.uv_err_name(code as ffi.titan_ffi_int) as string,
      message, operation, subject)
end

local function os_error_from_status(operation: string,
                                    subject: string?):
                                    (ffi.titan_ffi_int) -> Error
  return function (status: ffi.titan_ffi_int): Error
    return make_error(status as integer, operation, subject)
  end
end

-- Foreign C functions are not Titan closure values, so these tiny adapters
-- give the generic sized-buffer helper one uniform callable type.
local function os_cwd_buffer(bytes: *ffi.titan_ffi_char,
                             sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_cwd(bytes, sizes)
end

local function os_homedir_buffer(bytes: *ffi.titan_ffi_char,
                                 sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_os_homedir(bytes, sizes)
end

local function os_tmpdir_buffer(bytes: *ffi.titan_ffi_char,
                                sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_os_tmpdir(bytes, sizes)
end

local function os_hostname_buffer(bytes: *ffi.titan_ffi_char,
                                  sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_os_gethostname(bytes, sizes)
end

local function os_exepath_buffer(bytes: *ffi.titan_ffi_char,
                                 sizes: *libuv.size_t): ffi.titan_ffi_int
  local capacity = sizes[0]
  local status = libuv.uv_exepath(bytes, sizes)
  -- Linux and macOS report a truncated path as a saturated success rather
  -- than UV_ENOBUFS. Translate only that public-API result into the generic
  -- recursive retry contract.
  local supplied = capacity as integer
  if (status as integer) >= 0 and
      (sizes[0] as integer) == supplied - 1 then
    sizes[0] = (supplied * 2) as libuv.size_t
    return UV_ENOBUFS as ffi.titan_ffi_int
  end
  return status
end

function _os_getenv(name: string): string?
  local copied = copy_text(name, "os.getenv", name)
  local getenv_buffer = function (bytes: *ffi.titan_ffi_char,
                                  sizes: *libuv.size_t): ffi.titan_ffi_int
    return libuv.uv_os_getenv(copied.bytes.data, bytes, sizes)
  end
  return os_sized_buffer(getenv_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      os_error_from_status("os.getenv", name))
end

function _os_setenv(name: string, contents: string)
  local copied_name = copy_text(name, "os.setenv", name)
  -- Never retain or echo the environment value in an Error subject.
  local copied_value = copy_text(contents, "os.setenv", name)
  local status = libuv.uv_os_setenv(copied_name.bytes.data,
                                    copied_value.bytes.data)
  if (status as integer) < 0 then
    raise make_error(status as integer, "os.setenv", name)
  end
end

function _os_unsetenv(name: string)
  local copied = copy_text(name, "os.unsetenv", name)
  local status = libuv.uv_os_unsetenv(copied.bytes.data)
  if (status as integer) < 0 then
    raise make_error(status as integer, "os.unsetenv", name)
  end
end

function _os_cwd(): string
  return os_sized_buffer(os_cwd_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      os_error_from_status("os.cwd", nil))
end

function _os_chdir(path: string)
  local copied = copy_text(path, "os.chdir", path)
  local status = libuv.uv_chdir(copied.bytes.data)
  if (status as integer) < 0 then
    raise make_error(status as integer, "os.chdir", path)
  end
end

function _os_homedir(): string
  return os_sized_buffer(os_homedir_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      os_error_from_status("os.homedir", nil))
end

function _os_tmpdir(): string
  return os_sized_buffer(os_tmpdir_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      os_error_from_status("os.tmpdir", nil))
end

function _os_hostname(): string
  return os_sized_buffer(os_hostname_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      os_error_from_status("os.hostname", nil))
end

function _os_exepath(): string
  if not program_args_ready then
    raise "os.exepath is only available in a compiled Titan program"
  end
  return os_sized_buffer(os_exepath_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      os_error_from_status("os.exepath", nil))
end

function _os_pid(): integer
  return libuv.uv_os_getpid() as integer
end

function _os_ppid(): integer
  return libuv.uv_os_getppid() as integer
end

function _os_wait_signal(name: string): string
  local copied = copy_text(name, "signal.name", name)
  local signum = shim.titan_uvshim_signal_number(
      copied.bytes.data) as integer
  if signum <= 0 or name == "kill" then
    raise "unsupported waitable signal name '" .. name .. "'"
  end
  local canonical = shim.titan_uvshim_signal_name(
      signum as ffi.titan_ffi_int) as string
  local request = new_request(REQUEST_SIGNAL,
      SignalSpec.new(canonical, signum), 0)
  return coroutine.yield(request, UV_TAG)
end

function _os_signal_name(signal_number: integer): string?
  if signal_number <= 0 then return nil end
  local name = shim.titan_uvshim_signal_name(
      signal_number as ffi.titan_ffi_int)
  if not name then return nil end
  return name as string
end

local function validate_process(process: uv_process_t,
                                operation: string,
                                allow_exited: boolean)
  local runtime = current_runtime()
  local control = process.metadata
  if control.runtime ~= runtime or
      control.generation ~= runtime.generation then
    raise "Process belongs to a stale libuv Runtime"
  end
  if control.exit_seen and not allow_exited then
    raise "cannot " .. operation .. " an exited Process"
  end
end

local function process_pipe(process: uv_process_t,
                            kind: integer): uv_pipe_t
  local pipe: uv_pipe_t? = nil
  if kind == PIPE_STDIN then
    pipe = process.metadata.stdin_pipe
  elseif kind == PIPE_STDOUT then
    pipe = process.metadata.stdout_pipe
  else
    pipe = process.metadata.stderr_pipe
  end
  if not pipe then raise "Process pipe is no longer available" end
  return pipe
end

function _os_process_spawn(file: string, args: {string}): uv_process_t
  local request = new_process_spawn_request(file, args)
  return coroutine.yield(request, UV_TAG)
end

function _os_process_wait(process: uv_process_t): (integer, integer)
  ordinary_task()
  validate_process(process, "wait for", true)
  local control = process.metadata
  if control.wait_task then
    raise "Process already has a waiting Task"
  end
  local request = new_process_request(PROCESS_WAIT, process, nil, false)
  local result: ProcessExitResult = coroutine.yield(request, UV_TAG)
  return result.code, result.signal_number
end

function _os_process_kill(process: uv_process_t, signal: string)
  ordinary_task()
  validate_process(process, "signal", false)
  local copied = copy_text(signal, "process.kill", signal)
  local signum = shim.titan_uvshim_signal_number(copied.bytes.data)
  if (signum as integer) <= 0 then
    raise "unsupported process signal name '" .. signal .. "'"
  end
  local status = libuv.uv_process_kill(process.handle, signum)
  if (status as integer) < 0 and
      (status as integer) ~= UV_ESRCH then
    raise make_error(status as integer, "process.kill", signal)
  end
end

function _os_process_write_stdin(process: uv_process_t, data: string)
  ordinary_task()
  validate_process(process, "write to", false)
  local pipe = process_pipe(process, PIPE_STDIN)
  local control = pipe.metadata
  if control.shutdown_requested or control.write_shutdown or
      control.lifecycle == PIPE_CLOSING or
      control.lifecycle == PIPE_CLOSED then
    raise "cannot write after Process stdin close"
  end
  if #data == 0 then return end
  if #data > UV_BUF_MAX then
    raise "process stdin data exceeds the portable libuv buffer limit"
  end
  -- Writes own their bytes before entering the shared FIFO; later cancellation
  -- can detach a Task without invalidating submitted native storage.
  local bytes = copy_bytes(data)
  local request = new_process_request(PROCESS_WRITE_STDIN,
      process, pipe, false)
  local operation: ProcessOperation = request.subject
  operation.copied_bytes = bytes
  coroutine.yield(request, UV_TAG)
end

function _os_process_close_stdin(process: uv_process_t)
  ordinary_task()
  validate_process(process, "close stdin for", true)
  local pipe = process_pipe(process, PIPE_STDIN)
  local control = pipe.metadata
  if control.shutdown_requested or control.write_shutdown or
      control.lifecycle == PIPE_CLOSING or
      control.lifecycle == PIPE_CLOSED then return end
  cleanup_begin()
  do
    -- Construct the cleanup Request before publishing the monotonic flag.
    -- Once visible, cancellation cannot revoke the ordered pipe close.
    local request = new_process_request(PROCESS_CLOSE_STDIN,
        process, pipe, true)
    control.shutdown_requested = true
    coroutine.yield(request, UV_TAG)
  finally
    cleanup_end()
  end
end

local function process_read(process: uv_process_t, kind: integer): string?
  ordinary_task()
  validate_process(process, "read from", true)
  local pipe = process_pipe(process,
      kind == PROCESS_READ_STDOUT and PIPE_STDOUT or PIPE_STDERR)
  local control = pipe.metadata
  if #control.read_queue > 0 then
    local payload = queued_bytes_string(control.read_queue)
    control.read_queue = {}
    return payload
  end
  if control.read_terminal == TCP_READ_EOF then return nil end
  if control.read_terminal == TCP_READ_ERROR then raise control.read_error end
  if control.lifecycle == PIPE_CLOSING or
      control.lifecycle == PIPE_CLOSED then
    raise "cannot read from a closed Process pipe"
  end
  if control.read_waiter then
    raise "process pipe already has a waiting reader"
  end
  local request = new_process_request(kind, process, pipe, false)
  return coroutine.yield(request, UV_TAG)
end

function _os_process_read_stdout(process: uv_process_t): string?
  return process_read(process, PROCESS_READ_STDOUT)
end

function _os_process_read_stderr(process: uv_process_t): string?
  return process_read(process, PROCESS_READ_STDERR)
end

function _os_process_read_error_is(process: uv_process_t,
                                   stdout: boolean,
                                   candidate: value): boolean
  local pipe = process_pipe(process, stdout and PIPE_STDOUT or PIPE_STDERR)
  local control = pipe.metadata
  if control.read_terminal ~= TCP_READ_ERROR or not control.read_error then
    return false
  end
  return candidate == control.read_error
end

local function wake_helper_group(group: HelperGroup)
  if not group.waiter or group.wake_scheduled then return end
  local ready = group.pending == 0 or
                (not group.waiter_all and group.first_error ~= nil)
  if not ready then return end
  local task = group.waiter
  local epoch = group.waiter_epoch
  local request = task.current_request
  group.waiter = nil
  group.waiter_epoch = 0
  group.waiter_all = false
  group.wake_scheduled = true
  local cleanup_request: Request? = nil
  if request.cleanup then cleanup_request = request end
  if not schedule_task_drive(task, epoch, DRIVE_RESUME, group, "",
                             cleanup_request) then
    return
  end
end

local function complete_helper(group: HelperGroup, kind: integer,
                               payload: value, failure: value,
                               trace: string)
  if group.completed[kind] then return end
  group.completed[kind] = true
  if failure ~= nil and group.first_error == nil and not group.canceling then
    group.first_error = failure
    group.first_traceback = trace
  elseif failure == nil then
    if kind == HELPER_STDOUT then
      group.stdout = payload
    elseif kind == HELPER_STDERR then
      group.stderr = payload
    elseif kind == HELPER_WAIT then
      group.exit_result = payload
    end
  end
  group.pending = group.pending - 1
  if group.pending < 0 then
    raise "HelperGroup pending count became negative"
  end
  wake_helper_group(group)
end

local function read_process_output(process: uv_process_t,
                                   stdout: boolean): string
  local chunks: {string} = {}
  local chunk: string? = nil
  if stdout then
    chunk = _os_process_read_stdout(process)
  else
    chunk = _os_process_read_stderr(process)
  end
  while chunk do
    chunks[#chunks + 1] = chunk
    if stdout then
      chunk = _os_process_read_stdout(process)
    else
      chunk = _os_process_read_stderr(process)
    end
  end
  -- Pairwise joining keeps total copying logarithmic in the number of chunks
  -- instead of repeatedly copying the complete prefix.
  while #chunks > 1 do
    local joined: {string} = {}
    local index = 1
    while index <= #chunks do
      if index < #chunks then
        joined[#joined + 1] = chunks[index] .. chunks[index + 1]
      else
        joined[#joined + 1] = chunks[index]
      end
      index = index + 2
    end
    chunks = joined
  end
  if #chunks == 0 then return "" end
  return chunks[1]
end

local function execute_helper(group: HelperGroup, kind: integer)
  local process = group.process
  local payload: value = nil
  local failure: value = nil
  local trace = ""
  do
    if kind == HELPER_STDOUT then
      payload = read_process_output(process, true)
    elseif kind == HELPER_STDERR then
      payload = read_process_output(process, false)
    elseif kind == HELPER_STDIN then
      if group.input then
        _os_process_write_stdin(process, group.input)
      end
      _os_process_close_stdin(process)
    else
      local code, signal_number = _os_process_wait(process)
      payload = ProcessExitResult.new(code, signal_number)
    end
  catch
    failure = error
    trace = traceback
  end
  complete_helper(group, kind, payload, failure, trace)
  local task = running_task()
  task.helper_group = nil
  task.helper_kind = 0
end

local function start_helper(group: HelperGroup, kind: integer)
  local root = coroutine.create(adapt(function (): value
    execute_helper(group, kind)
    return nil
  end), UV_TAG)
  local task: Task = {
    root = root,
    runtime = group.runtime,
    generation = group.generation,
    state = TASK_NEW,
    epoch = 0,
    result = nil,
    error_value = nil,
    error_traceback = "",
    cancel_requested = false,
    cancel_value = nil,
    operation = nil,
    current_request = nil,
    joiner_head = nil,
    join_next = nil,
    join_previous = nil,
    joining_target = nil,
    next_task = nil,
    previous_task = nil,
    permanently_observed = true,
    observer_count = 0,
    cleanup_shield_depth = 0,
    cancel_fallback = false,
    helper_group = group,
    helper_kind = kind,
    main = false,
  }
  -- Publish permanent observation and HelperGroup identity before OWNER_START
  -- is armed.  Even synchronous infrastructure failure is therefore owned by
  -- the parent group before any observation callback can run.
  group.helpers[kind] = task
  link_task(group.runtime, task)
  local owner, status = start_owner(group.runtime, OWNER_START,
                                    task, nil, 0, 0, 0)
  task.operation = owner
  if status < 0 then
    finish_task(task, TASK_FAILED, nil,
                make_error(status, "task.start", nil), "")
  else
    task.state = TASK_READY
  end
end

local function wait_helper_group(group: HelperGroup, wait_all: boolean,
                                 cleanup: boolean)
  if group.pending == 0 or
      (not wait_all and group.first_error ~= nil) then return end
  local request = new_helper_request(group, wait_all, cleanup)
  coroutine.yield(request, UV_TAG)
end

local function cancel_helper_group(group: HelperGroup, reason: value)
  group.canceling = true
  for index = 1, #group.helpers do
    local task = group.helpers[index]
    if not terminal(task.state) then task:cancel(reason) end
  end
end

local function dispose_process_cleanup(process: uv_process_t)
  local request = new_process_request(PROCESS_DISPOSE, process, nil, true)
  coroutine.yield(request, UV_TAG)
end

local function communicate_cleanup(group: HelperGroup, reason: value,
                                   trace: string)
  cancel_helper_group(group, reason)
  local process = group.process
  local control = process.metadata
  if not control.exit_seen and control.lifecycle == PROCESS_SPAWNED then
    local status = begin_one_process_shutdown(control)
    if status < 0 then
      -- Keep the original helper/cancellation failure authoritative while
      -- marking the Runtime for outer repair of the cleanup infrastructure.
      promote_fatal(group.runtime, reason, trace)
    end
  else
    process_close_all_pipes(control)
    if control.exit_seen and control.lifecycle ~= PROCESS_CLOSING and
        control.lifecycle ~= PROCESS_CLOSED and control.owner then
      start_process_close(control.owner)
    end
  end
  wait_helper_group(group, true, true)
  dispose_process_cleanup(process)
end

function _os_communicate(file: string, args: {string},
                         input: string?):
                         (string, string, integer, integer)
  local parent = ordinary_task()
  local process = _os_process_spawn(file, args)
  local group = HelperGroup.new(parent.runtime, parent.generation,
      process, input, {}, {}, 4, nil, 0, false, false,
      nil, "", "", "", nil, false)
  for index = 1, 4 do group.completed[index] = false end
  start_helper(group, HELPER_STDOUT)
  start_helper(group, HELPER_STDERR)
  start_helper(group, HELPER_STDIN)
  start_helper(group, HELPER_WAIT)

  local primary_error: value = nil
  local primary_traceback = ""
  local succeeded = false
  do
    wait_helper_group(group, false, false)
    if group.first_error ~= nil then
      raise_saved(group.first_error, group.first_traceback)
    end
    succeeded = true
  catch
    primary_error = error
    primary_traceback = traceback
  end

  cleanup_begin()
  do
    if succeeded then
      dispose_process_cleanup(process)
    else
      communicate_cleanup(group, primary_error, primary_traceback)
    end
  finally
    cleanup_end()
  end

  if not succeeded then
    raise_saved(primary_error, primary_traceback)
  end
  local exit = group.exit_result
  return group.stdout, group.stderr, exit.code, exit.signal_number
end

function _ticker(milliseconds: integer): uv_timer_t
  if milliseconds <= 0 then
    raise "Ticker interval must be positive"
  end
  local task = running_task()
  if task.cancel_requested then
    raise task.cancel_value
  end
  if task.runtime.closing then
    raise "the libuv Runtime is shutting down"
  end
  local runtime = task.runtime
  local state: TickerState = {
    runtime = runtime,
    generation = runtime.generation,
    open = true,
    owner = nil,
    waiter = nil,
    waiter_epoch = 0,
  }
  local owner, status = start_owner(runtime, OWNER_TICKER, nil, state, 0,
                                    milliseconds, milliseconds)
  state.owner = owner
  if status < 0 then
    state.open = false
    raise make_error(status, "ticker.start", nil)
  end
  return owner
end

function _ticker_tick(owner: uv_timer_t): boolean
  local state = ticker_state(owner)
  if not state.open then
    return false
  end
  -- The loop is serial: checking before the yield makes a second waiter a
  -- normal Task error instead of letting it reach arm_request as an internal
  -- dispatcher invariant failure.
  if state.waiter then
    raise "Ticker already has a waiting Task"
  end
  local request = new_request(REQUEST_TICK, owner, 0)
  return coroutine.yield(request, UV_TAG)
end

function _ticker_close(owner: uv_timer_t)
  local state = ticker_state(owner)
  if not state.open then
    return
  end
  if state.generation ~= state.runtime.generation then
    raise "Ticker belongs to a stale libuv Runtime"
  end
  state.open = false
  close_owner(owner)
  if state.waiter then
    local task = state.waiter
    local epoch = state.waiter_epoch
    state.waiter = nil
    state.waiter_epoch = 0
    local wake, status = start_owner(state.runtime,
        OWNER_TICKER_CLOSE_WAKE, task, owner, epoch, 0, 0)
    if status < 0 then
      promote_fatal(state.runtime,
                    make_error(status, "ticker.close.wake", nil), "")
    else
      task.operation = wake
    end
  end
end

local function repair_aborted_fs_callback(owner: uv_fs_t)
  if not owner.metadata.callback_aborted then return end
  local operation = owner.metadata.operation
  if operation.owner and operation.owner ~= owner then
    -- A partial write may already have rooted its next submitted request.
    -- That newer callback, not this retired owner, still owns logical repair.
    return
  end
  if operation.owner == owner then operation.owner = nil end
  if not operation.file then return end

  local file = operation.file
  if operation.kind == FS.close or
      operation.kind == FS.internal_close then
    if operation.linked and not operation.close_waiter then
      remove_file_operation(file, operation)
      file.close_enqueued = false
    end

    -- A public close whose native callback reached the invariant catch still
    -- owns a shielded continuation. Convert it into an ordinary close waiter
    -- so an outer safe point can finish that continuation.
    if operation.kind == FS.close and operation.task and
        operation.request and not operation.linked then
      local task = operation.task
      local request = operation.request
      if task.state == TASK_WAITING and task.current_request == request and
          request.cleanup and task.cleanup_shield_depth > 0 then
        operation.kind = FS.close_wait
        enqueue_close_waiter(file, operation)
      end
    end

    file.handle = -1 as libuv.uv_file
    file.state = FS.file_closed
  elseif operation.linked and not operation.close_waiter then
    -- The native operation is terminal even though result delivery or
    -- bookkeeping failed. Remove it so fatal cancellation and File shutdown
    -- can make progress; no obsolete result is delivered.
    remove_file_operation(file, operation)
  end
end

local function retire_fs_owners(runtime: Runtime)
  local owner? = runtime.fs_pending_head
  while owner do
    local to_retire = owner
    owner = to_retire.metadata.next_owner
    if to_retire.metadata.lifecycle == FS_OWNER_CLEANED then
      repair_aborted_fs_callback(to_retire)
      if (to_retire.metadata.acquired_file as integer) < 0 then
        retire_fs_owner_now(to_retire)
      end
    end
  end
end

local function repair_acquired_files(runtime: Runtime)
  local owner? = runtime.fs_pending_head
  while owner do
    if owner.metadata.lifecycle == FS_OWNER_CLEANED and
        (owner.metadata.acquired_file as integer) >= 0 then
      local operation = owner.metadata.operation
      local subject = "<late-open>"
      local actual_subject? = fs_operation_subject(operation)
      if actual_subject then subject = actual_subject end
      local file = create_file(runtime, owner.metadata.acquired_file,
                               subject)
      owner.metadata.acquired_file = -1 as libuv.uv_file
      queue_internal_close(file)
    end
    owner = owner.metadata.next_owner
  end
  retire_fs_owners(runtime)
end

local function begin_file_shutdown(runtime: Runtime)
  local file? = runtime.file_head
  while file do
    queue_internal_close(file)
    file = file.next_file
  end
end

local function advance_file_shutdown(runtime: Runtime)
  local file? = runtime.file_head
  while file do
    local to_advance = file
    file = to_advance.next_file
    if to_advance.state == FS.file_closed then
      wake_close_waiters(to_advance, nil)
      if not to_advance.close_waiter_head then unlink_file(to_advance) end
    elseif not to_advance.current and not to_advance.close_enqueued and
        not to_advance.queue_head then
      queue_internal_close(to_advance)
    elseif not to_advance.current then
      advance_file(to_advance)
    end
  end
end

local function retire_aborted_net_requests(runtime: Runtime)
  local control? = runtime.net_pending_head
  while control do
    local to_retire = control
    control = to_retire.next_control
    if to_retire.lifecycle == NET_OWNER_CALLBACK or
        to_retire.lifecycle == NET_OWNER_ALLOCATED then
      local operation = to_retire.operation
      if to_retire.kind == NET_OWNER_CONNECT and operation.tcp then
        local tcp = operation.tcp
        tcp.metadata.connect_pending = false
        start_tcp_close(tcp)
      elseif (to_retire.kind == NET_OWNER_WRITE or
              to_retire.kind == NET_OWNER_SHUTDOWN) and
             operation.tcp then
        if operation.linked then remove_output(operation.tcp, operation) end
      end
      retire_net_control(to_retire)
    end
  end
end

local function begin_tcp_shutdown(runtime: Runtime)
  local control? = runtime.tcp_head
  while control do
    local to_shutdown = control
    control = to_shutdown.next_control
    local owner? = to_shutdown.owner
    if owner then
      local tcp = owner
      to_shutdown.close_requested = true
      if to_shutdown.server then
        to_shutdown.accept_waiter = nil
        to_shutdown.accept_epoch = 0
        close_accepted_queue(tcp)
      else
        stop_tcp_read(tcp, true)
      end
      start_tcp_close(tcp)
      if not to_shutdown.output_current then
        while to_shutdown.output_head do
          remove_output(tcp, to_shutdown.output_head)
        end
      end
    end
  end
end

local function advance_tcp_shutdown(runtime: Runtime)
  retire_aborted_net_requests(runtime)
  local control? = runtime.tcp_head
  while control do
    local to_advance = control
    control = to_advance.next_control
    if to_advance.owner then
      local tcp = to_advance.owner
      if to_advance.lifecycle == TCP_CLOSED then
        finish_closed_tcp(tcp)
      elseif to_advance.lifecycle ~= TCP_CLOSING then
        start_tcp_close(tcp)
      end
    end
  end
end

local function retire_aborted_process_requests(runtime: Runtime)
  local control? = runtime.process_request_head
  while control do
    local to_retire = control
    control = to_retire.next_control
    if to_retire.lifecycle == PROCESS_OWNER_CALLBACK or
        to_retire.lifecycle == PROCESS_OWNER_ALLOCATED then
      local operation = to_retire.operation
      local pipe = operation.pipe
      if operation.linked then remove_pipe_output(pipe, operation) end
      advance_pipe_output(pipe, nil)
      retire_process_request(to_retire)
    end
  end
end

local function begin_process_shutdown(runtime: Runtime)
  local control? = runtime.process_head
  while control do
    if control.stdout_pipe then
      control.stdout_pipe.metadata.read_queue = {}
    end
    if control.stderr_pipe then
      control.stderr_pipe.metadata.read_queue = {}
    end
    if control.lifecycle == PROCESS_ALLOCATED then
      if control.owner then
        discard_process_storage(control.owner)
      end
      process_close_all_pipes(control)
    elseif not control.exit_seen and
           control.lifecycle == PROCESS_SPAWNED then
      local status = begin_one_process_shutdown(control)
      if status < 0 and not runtime.fatal then
        promote_fatal(runtime,
            make_error(status, "process.shutdown", nil), "")
      end
    elseif control.exit_seen and
           control.lifecycle ~= PROCESS_CLOSING and
           control.lifecycle ~= PROCESS_CLOSED and
           control.owner then
      start_process_close(control.owner)
    end
    if control.exit_seen then process_close_all_pipes(control) end
    control = control.next_control
  end
end

local function repair_aborted_grace(control: ProcessControl)
  if not control.grace_callback_aborted or
      not control.grace_owner then return end
  local owner = control.grace_owner
  if owner.handle == nil then
    control.grace_owner = nil
    control.grace_callback_aborted = false
    return
  end
  if control.grace_fired then
    libuv.uv_timer_stop(owner.handle)
    if not control.exit_seen and not control.kill_sent and
        control.owner then
      local kill = shim.titan_uvshim_signal_number("kill")
      local status = libuv.uv_process_kill(control.owner.handle, kill)
      if (status as integer) >= 0 or
          (status as integer) == UV_ESRCH then
        control.kill_sent = true
      end
    end
    if (shim.titan_uvshim_timer_is_closing(owner.handle) as integer) == 0 then
      shim.titan_uvshim_timer_close(owner.handle)
    end
  end
end

local function repair_aborted_pipe(pipe: uv_pipe_t?)
  if not pipe then return end
  local pipe = pipe
  if pipe.metadata.callback_aborted and
      pipe.metadata.lifecycle == PIPE_CLOSED and
      pipe.metadata.owner then
    finish_pipe_close(pipe)
    pipe.metadata.callback_aborted = false
  end
end

local function repair_aborted_process(control: ProcessControl)
  repair_aborted_grace(control)
  repair_aborted_pipe(control.stdin_pipe)
  repair_aborted_pipe(control.stdout_pipe)
  repair_aborted_pipe(control.stderr_pipe)
  if not control.callback_aborted or not control.owner then return end
  local process = control.owner
  if control.lifecycle == PROCESS_EXITED then
    close_process_grace(control)
    if control.stdin_pipe then
      start_pipe_close(control.stdin_pipe)
    end
    start_process_close(process)
    control.callback_aborted = false
  elseif control.lifecycle == PROCESS_CLOSED then
    process_dispatch_body(process, EVENT_HANDLE_CLOSE)
    control.callback_aborted = false
  end
end

local function advance_process_shutdown(runtime: Runtime)
  retire_aborted_process_requests(runtime)
  begin_process_shutdown(runtime)
  local control? = runtime.process_head
  while control do
    local to_advance = control
    control = to_advance.next_control
    repair_aborted_process(to_advance)
    if to_advance.linked and process_all_native_closed(to_advance) then
      finish_process_control(to_advance)
    end
  end
end

local function drive_cancel_fallbacks(runtime: Runtime)
  local task? = runtime.task_head
  while task do
    local to_drive = task
    task = to_drive.next_task
    if to_drive.cancel_fallback and not terminal(to_drive.state) then
      to_drive.cancel_fallback = false
      drive_task(to_drive, DRIVE_ERROR, to_drive.cancel_value, "")
    end
  end
end

local function begin_fatal_shutdown(runtime: Runtime)
  runtime.closing = true
  local task? = runtime.task_head
  while task do
    request_cancel(task, runtime.fatal_error)
    task = task.next_task
  end

  local owner? = runtime.timer_owner_head
  while owner do
    if owner.metadata.kind == OWNER_TICKER or
        owner.metadata.kind == OWNER_OBSERVE then
      close_owner(owner)
    end
    owner = owner.metadata.next_owner
  end
  close_all_signal_owners(runtime)
end

local function retire_closed_owners(runtime: Runtime)
  local owner? = runtime.timer_owner_head
  while owner do
    local to_retire = owner
    owner = to_retire.metadata.next_owner
    if to_retire.metadata.lifecycle == OWNER_CLOSED then
      to_retire.handle = nil
      to_retire.storage = nil
      unlink_owner(to_retire)
    end
  end
end

local function retire_closed_signal_owners(runtime: Runtime)
  local owner? = runtime.signal_owner_head
  while owner do
    local to_retire = owner
    owner = to_retire.metadata.next_owner
    if to_retire.metadata.lifecycle == OWNER_CLOSED then
      to_retire.handle = nil
      to_retire.storage = nil
      unlink_signal_owner(to_retire)
    end
  end
end

local function close_runtime(runtime: Runtime)
  retire_closed_owners(runtime)
  retire_closed_signal_owners(runtime)
  retire_fs_owners(runtime)
  repair_acquired_files(runtime)
  retire_aborted_net_requests(runtime)
  retire_aborted_process_requests(runtime)
  begin_file_shutdown(runtime)
  advance_file_shutdown(runtime)
  begin_tcp_shutdown(runtime)
  advance_tcp_shutdown(runtime)
  begin_process_shutdown(runtime)
  advance_process_shutdown(runtime)
  close_all_owners(runtime)
  close_all_signal_owners(runtime)
  retire_closed_owners(runtime)
  retire_closed_signal_owners(runtime)
  -- Drain owners registered in the Runtime. An unknown active handle must not
  -- make UV_RUN_DEFAULT hang here; once known owners are gone, loop_close
  -- reports the remaining failure.
  while not not runtime.timer_owner_head or
        not not runtime.fs_pending_head or
        not not runtime.file_head or
        not not runtime.net_pending_head or
        not not runtime.tcp_head or
        not not runtime.signal_owner_head or
        not not runtime.process_head or
        not not runtime.process_request_head do
    local alive = libuv.uv_run(runtime.loop.handle,
                              libuv.UV_RUN_DEFAULT) as integer
    retire_closed_owners(runtime)
    retire_closed_signal_owners(runtime)
    retire_fs_owners(runtime)
    repair_acquired_files(runtime)
    advance_file_shutdown(runtime)
    advance_tcp_shutdown(runtime)
    advance_process_shutdown(runtime)
    -- A callback may have called uv_stop or created a cleanup owner before it
    -- returned.  Re-close/re-run only from this outer driver safe point.
    close_all_owners(runtime)
    close_all_signal_owners(runtime)
    retire_closed_owners(runtime)
    retire_closed_signal_owners(runtime)
    retire_fs_owners(runtime)
    advance_tcp_shutdown(runtime)
    advance_process_shutdown(runtime)
    if not not runtime.timer_owner_head or
        not not runtime.fs_pending_head or
        not not runtime.file_head or
        not not runtime.net_pending_head or
        not not runtime.tcp_head or
        not not runtime.signal_owner_head or
        not not runtime.process_head or
        not not runtime.process_request_head then
      if alive == 0 then
        if not runtime.fatal then
          runtime.fatal = true
          runtime.closing = true
          runtime.fatal_error = internal_error("shutdown.no-progress")
          runtime.fatal_traceback = ""
        end
        -- Preserve every still-rooted native allocation and return the first
        -- fatal error instead of spinning an idle uv_run forever.
        return
      end
    end
  end
  local status = libuv.uv_loop_close(runtime.loop.handle)
  if (status as integer) ~= 0 then
    if not runtime.fatal then
      runtime.fatal = true
      runtime.fatal_error = make_error(status as integer, "loop.close", nil)
      runtime.fatal_traceback = ""
    end
    -- Keep active_runtime and its storage root intact: reclaiming a busy loop
    -- would be a native use-after-free even on an error-reporting path.
    return
  end
  runtime.loop.handle = nil
  runtime.loop.storage = nil
  if not runtime.file_head and not runtime.net_pending_head and
      not runtime.tcp_head and not runtime.signal_owner_head and
      not runtime.process_head and
      not runtime.process_request_head then
    active_runtime = nil
  end
end

function _loop()
  if not on_main_thread() or coroutine.is_yieldable(UV_TAG) then
    raise "async.loop must be driven from the Lua main thread"
  end
  if not active_runtime then
    return
  end
  if (lua.lua_checkstack(L, lua.LUA_MINSTACK) as integer) == 0 then
    raise "cannot reserve stack for libuv native callbacks"
  end
  local runtime = active_runtime
  if runtime.loop.handle == nil then
    raise_saved(runtime.fatal_error, runtime.fatal_traceback)
  end
  if runtime.in_loop then
    raise "async.loop is already active"
  end
  runtime.in_loop = true
  libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)
  runtime.in_loop = false
  retire_closed_owners(runtime)
  retire_closed_signal_owners(runtime)
  retire_fs_owners(runtime)
  repair_acquired_files(runtime)
  retire_aborted_net_requests(runtime)

  if not runtime.fatal and runtime.task_head then
    runtime.fatal = true
    runtime.closing = true
    runtime.fatal_error = "libuv loop became idle while Tasks were waiting"
    runtime.fatal_traceback = ""
  end
  if runtime.fatal then
    begin_fatal_shutdown(runtime)
    advance_file_shutdown(runtime)
    begin_tcp_shutdown(runtime)
    advance_tcp_shutdown(runtime)
    begin_process_shutdown(runtime)
    advance_process_shutdown(runtime)
    drive_cancel_fallbacks(runtime)
    while runtime.task_head do
      if (libuv.uv_loop_alive(runtime.loop.handle) as integer) == 0 then
        -- No callback can make progress.  The only legal callback-less
        -- cancellation delivery is this outer-driver fallback.
        local task? = runtime.task_head
        while task do
          if task.cancel_requested and task.cleanup_shield_depth == 0 then
            task.cancel_fallback = true
          end
          task = task.next_task
        end
        drive_cancel_fallbacks(runtime)
        if runtime.task_head and
            (libuv.uv_loop_alive(runtime.loop.handle) as integer) == 0 then
          -- A shielded Task without any live cleanup owner is an internal
          -- deadlock, not a reason to return with a suspended root retained.
          -- The first Runtime fatal remains authoritative; terminalize these
          -- impossible leftovers at the outer safe point so owner draining and
          -- uv_loop_close remain total.
          local invariant_error = internal_error("shutdown.deadlock")
          local stranded? = runtime.task_head
          while stranded do
            local to_finish = stranded
            stranded = to_finish.next_task
            finish_task(to_finish, TASK_FAILED, nil, invariant_error, "")
          end
        end
      else
        libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)
        retire_closed_owners(runtime)
        retire_closed_signal_owners(runtime)
        retire_fs_owners(runtime)
        repair_acquired_files(runtime)
        retire_aborted_net_requests(runtime)
        retire_aborted_process_requests(runtime)
        advance_file_shutdown(runtime)
        advance_tcp_shutdown(runtime)
        advance_process_shutdown(runtime)
        drive_cancel_fallbacks(runtime)
      end
    end
  else
    advance_file_shutdown(runtime)
    advance_tcp_shutdown(runtime)
    advance_process_shutdown(runtime)
  end
  close_runtime(runtime)
  if runtime.fatal then
    raise_saved(runtime.fatal_error, runtime.fatal_traceback)
  end
end

local function bootstrap(main_callable: ({string}) -> integer,
                         args: {string}): integer
  local task = run_internal(function (): value
    return main_callable(args)
  end, true)
  _loop()
  if task.state ~= TASK_SUCCEEDED then
    raise_saved(task.error_value, task.error_traceback)
  end
  return task.result
end

function _version(): string
  return libuv.uv_version_string() as string
end

-- A generated Titan entrypoint publishes its original argc/argv before it
-- loads any module. Keep uv_setup_args in this canonical provider image and
-- publish libuv's possibly replaced argv pointer back to the entrypoint.
local function setup_program_args(): boolean
  local top = lua.lua_gettop(L)
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_ARGC_KEY)
  if (lua.lua_type(L, -1) as integer) == (lua.LUA_TNIL as integer) then
    lua.lua_settop(L, top)
    return false
  end
  local argc = lua.lua_tointegerx(L, -1, nil) as ffi.titan_ffi_int
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_ARGV_KEY)
  local argv = lua.lua_touserdata(L, -1) as *shim.titan_uvshim_char_ptr
  local configured = libuv.uv_setup_args(argc, argv)
  lua.lua_pushlightuserdata(
      L, configured as ffi.titan_ffi_void_ptr)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_ARGV_KEY)
  lua.lua_settop(L, top)
  return true
end

do
  UV_EIO = shim.titan_uvshim_error_eio() as integer
  UV_EOF = shim.titan_uvshim_error_eof() as integer
  UV_ECANCELED = shim.titan_uvshim_error_ecanceled() as integer
  UV_EADDRNOTAVAIL = shim.titan_uvshim_error_eaddrnotavail() as integer
  UV_EINVAL = shim.titan_uvshim_error_einval() as integer
  UV_ENOBUFS = shim.titan_uvshim_error_enobufs() as integer
  UV_ENOENT = shim.titan_uvshim_error_enoent() as integer
  UV_ESRCH = shim.titan_uvshim_error_esrch() as integer
  UV_BUF_MAX = shim.titan_uvshim_buf_max_length() as integer
  EVENT_TIMER = shim.TITAN_UV_EVENT_TIMER as integer
  EVENT_HANDLE_CLOSE = shim.TITAN_UV_EVENT_HANDLE_CLOSE as integer
  EVENT_STREAM_ALLOC = shim.TITAN_UV_EVENT_STREAM_ALLOC as integer
  EVENT_STREAM_READ = shim.TITAN_UV_EVENT_STREAM_READ as integer
  EVENT_CONNECTION = shim.TITAN_UV_EVENT_CONNECTION as integer
  EVENT_PROCESS_EXIT = shim.TITAN_UV_EVENT_PROCESS_EXIT as integer
  local sigpipe_status =
    shim.titan_uvshim_ignore_sigpipe_if_default() as integer
  if sigpipe_status < 0 then
    raise make_error(sigpipe_status, "runtime.sigpipe", nil)
  end
  main_thread = main_thread_value()
  check_alignment()
  program_args_ready = setup_program_args()
  ffi.lua_pushtvalue(L, bootstrap)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_BOOTSTRAP_KEY)
end
