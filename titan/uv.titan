-- A single tag identity belongs to this module instance and is shared by all
-- tasks and by every sequential Runtime session in the Lua state.
local UV_TAG: value = {}
local generation = 0
local active_runtime: Runtime? = nil
-- TITAN_UV_PHASE5_TEST_STATE
-- TITAN_UV_PHASE6_TEST_STATE

local function reinstall_trace(trace: string)
  ffi.lua_pushtvalue(L, trace)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  lua.lua_pushboolean(L, 1)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
end

local function stash_trace_for_append(trace: string)
  ffi.lua_pushtvalue(L, trace)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
end

local function pop_trace_for_append(): string?
  local top = lua.lua_gettop(L)
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  local trace: value = ffi.lua_totvalue(L, -1)
  lua.lua_pushnil(L)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  lua.lua_settop(L, top)
  return trace as string?
end

local function raise_joined(err: value, target_trace: string)
  stash_trace_for_append(target_trace)
  do
    raise err
  catch
    local inner? = pop_trace_for_append()
    if inner then
      reinstall_trace((inner as string) .. "\n" .. traceback)
    end
    raise error
  end
end

local function raise_saved(err: value, trace: string)
  if #trace > 0 then
    reinstall_trace(trace)
  end
  raise err
end

local function main_thread_value(): value
  local top = lua.lua_gettop(L)
  lua.lua_rawgeti(L, lua.LUA_REGISTRYINDEX,
                  lua.LUA_RIDX_MAINTHREAD as lua.lua_Integer)
  local thread = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return thread
end

local function on_main_thread(): boolean
  local top = lua.lua_gettop(L)
  local is_main = lua.lua_pushthread(L)
  lua.lua_settop(L, top)
  return (is_main as integer) ~= 0
end

local function allocate_bytes(length: integer): Bytes
  if length < 0 then
    raise "buffer length must not be negative"
  end
  if (shim.titan_uvshim_allocation_length_is_valid(
          length) as integer) == 0 then
    raise "buffer length exceeds the platform allocation limit"
  end
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, length, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local bytes = Bytes.new(memory as *ffi.titan_ffi_char, storage, length)
  lua.lua_settop(L, top)
  return bytes
end

local function copy_text(source: string, operation: string): Text
  local length = #source
  if length >= 9223372036854775807 then
    raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                     operation, source)
  end
  if (shim.titan_uvshim_bytes_find(source, length, "\0", 1) as integer) >= 0 then
    raise make_error(shim.titan_uvshim_error_einval() as integer,
                     operation, source)
  end
  local bytes = allocate_bytes(length + 1)
  shim.titan_uvshim_text_copy(bytes.data, source, length)
  return Text.new(bytes, source)
end

local function copy_text_with_subject(source: string, operation: string,
                                      subject: string?): Text
  local length = #source
  if length >= 9223372036854775807 then
    raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                     operation, subject)
  end
  if (shim.titan_uvshim_bytes_find(source, length, "\0", 1) as integer) >= 0 then
    raise make_error(shim.titan_uvshim_error_einval() as integer,
                     operation, subject)
  end
  local bytes = allocate_bytes(length + 1)
  shim.titan_uvshim_text_copy(bytes.data, source, length)
  return Text.new(bytes, source)
end

local function copy_bytes(source: string): Bytes
  local length = #source
  local bytes = allocate_bytes(length)
  shim.titan_uvshim_bytes_copy(bytes.data, source, length)
  return bytes
end

local function copy_addresses(pointer: ffi.titan_ffi_void_ptr,
                              subject: string): AddressList
  local count = shim.titan_uvshim_addrinfo_count(pointer) as integer
  if count < 0 then
    raise make_error(count, "net.resolve.copy", subject)
  end
  local cell_size = shim.titan_uvshim_address.sizeof as integer
  if count > 0 and count > 9223372036854775807 // cell_size then
    raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                     "net.resolve.copy", subject)
  end
  local bytes = allocate_bytes(count * cell_size)
  shim.titan_uvshim_addrinfo_copy(pointer, bytes.data)
  return AddressList.new((bytes.data as ffi.titan_ffi_void_ptr) as
                         *shim.titan_uvshim_address,
                         bytes.storage, count)
end

local function make_buffer(bytes: Bytes, offset: integer,
                           length: integer, operation: string): Buffer
  if offset < 0 or length < 0 or offset > bytes.length or
      length > bytes.length - offset or
      (shim.titan_uvshim_buf_length_is_valid(length) as integer) == 0 then
    raise make_error(shim.titan_uvshim_error_einval() as integer,
                     operation, nil)
  end
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_buf_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  shim.titan_uvshim_buf_init_slice(memory, bytes.data, offset, length)
  local buffer = Buffer.new(memory as *libuv.uv_buf_t, storage, bytes,
                            offset, length)
  lua.lua_settop(L, top)
  return buffer
end

local function allocate_read_buffer(length: integer): Buffer
  return make_buffer(allocate_bytes(length), 0, length, "fs.buffer.init")
end

local function bytes_string(bytes: Bytes, length: integer): string
  if length < 0 or length > bytes.length then
    raise "native result exceeds its rooted buffer"
  end
  local top = lua.lua_gettop(L)
  lua.lua_pushlstring(L, bytes.data, length as libuv.size_t)
  local raw: value = ffi.lua_totvalue(L, -1)
  local result = raw as string
  lua.lua_settop(L, top)
  return result
end

local function os_buffer_operation(kind: integer): string
  if kind == OS_GETENV then return "os.getenv" end
  if kind == OS_CWD then return "os.cwd" end
  if kind == OS_HOMEDIR then return "os.homedir" end
  if kind == OS_TMPDIR then return "os.tmpdir" end
  if kind == OS_HOSTNAME then return "os.hostname" end
  return "os.exepath"
end

local function os_buffer_subject(argument: Text?): string?
  if argument then return (argument as Text).source end
  return nil
end

local function os_sized_buffer(kind: integer,
                               argument: Text?): string?
  -- TITAN_UV_PHASE6_OS_BUFFER_INIT
  local capacity = OS_BUFFER_INITIAL
  local sizes = libuv.size_t.new_array(1)
  local attempts = 0
  while attempts < OS_BUFFER_RETRY_LIMIT do
    attempts = attempts + 1
    local bytes = allocate_bytes(capacity)
    sizes[0] = capacity as libuv.size_t
    local status: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
    if kind == OS_GETENV then
      local name = argument as Text
      status = libuv.uv_os_getenv(name.bytes.data, bytes.data, sizes)
    elseif kind == OS_CWD then
      status = libuv.uv_cwd(bytes.data, sizes)
    elseif kind == OS_HOMEDIR then
      status = libuv.uv_os_homedir(bytes.data, sizes)
    elseif kind == OS_TMPDIR then
      status = libuv.uv_os_tmpdir(bytes.data, sizes)
    elseif kind == OS_HOSTNAME then
      status = libuv.uv_os_gethostname(bytes.data, sizes)
    elseif kind == OS_EXEPATH then
      status = libuv.uv_exepath(bytes.data, sizes)
    else
      raise "invalid private OS buffer operation"
    end
    -- TITAN_UV_PHASE6_OS_BUFFER_RESULT

    if (status as integer) >= 0 then
      local used = shim.titan_uvshim_size_as_int64(sizes[0]) as integer
      if used < 0 or used >= capacity then
        raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                         os_buffer_operation(kind),
                         os_buffer_subject(argument))
      end
      -- Linux and macOS uv_exepath return success when truncating.  A result
      -- that saturates the payload capacity is ambiguous, so retry larger;
      -- an exact fit resolves on that next iteration as an unsaturated result.
      if kind ~= OS_EXEPATH or used ~= capacity - 1 then
        return bytes_string(bytes, used)
      end
    elseif kind == OS_GETENV and
        (shim.titan_uvshim_status_is_enoent(status) as integer) ~= 0 then
      return nil
    elseif (shim.titan_uvshim_status_is_enobufs(status) as integer) == 0 then
      raise make_error(status as integer, os_buffer_operation(kind),
                       os_buffer_subject(argument))
    end

    local required = shim.titan_uvshim_size_as_int64(sizes[0]) as integer
    if required < 0 then
      raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                       os_buffer_operation(kind),
                       os_buffer_subject(argument))
    end
    local next_capacity = required
    if next_capacity <= capacity then
      if capacity > 9223372036854775807 // 2 then
        raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                         os_buffer_operation(kind),
                         os_buffer_subject(argument))
      end
      next_capacity = capacity * 2
    end
    if next_capacity <= capacity or
        (shim.titan_uvshim_allocation_length_is_valid(
            next_capacity) as integer) == 0 then
      raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                       os_buffer_operation(kind),
                       os_buffer_subject(argument))
    end
    -- TITAN_UV_PHASE6_OS_BUFFER_GROW
    capacity = next_capacity
  end
  raise make_error(shim.titan_uvshim_error_eoverflow() as integer,
                   os_buffer_operation(kind), os_buffer_subject(argument))
end

local function allocate_dirent(): Dirent
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_dirent_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local entry = Dirent.new(memory as *libuv.uv_dirent_t, storage)
  lua.lua_settop(L, top)
  return entry
end

local function extract_fs_list(owner: uv_fs_t): {string}
  local names: {string} = {}
  local entry = allocate_dirent()
  while true do
    local status = shim.titan_uvshim_fs_scandir_next(owner.handle,
        entry.handle as ffi.titan_ffi_void_ptr)
    if (status as integer) == 1 then break end
    if (status as integer) < 0 then
      raise make_error(status as integer, "fs.list.next",
                       fs_operation_subject(owner.metadata.operation))
    end
    names[#names + 1] = shim.titan_uvshim_dirent_name(
        entry.handle as ffi.titan_ffi_void_ptr) as string
  end
  return names
end

local function make_error(status: integer, operation: string,
                          subject: string?): Error
  local code = status as ffi.titan_ffi_int
  return Error.new(status, libuv.uv_err_name(code) as string,
                   libuv.uv_strerror(code) as string, operation, subject)
end

local function internal_error(operation: string): Error
  return Error.new(-1, "EINTERNAL", "libuv Runtime invariant failed",
                   operation, nil)
end

local function task_state_name(state: integer): string
  if state == TASK_NEW then return "new" end
  if state == TASK_READY then return "ready" end
  if state == TASK_RUNNING then return "running" end
  if state == TASK_WAITING then return "waiting" end
  if state == TASK_SUCCEEDED then return "succeeded" end
  if state == TASK_FAILED then return "failed" end
  return "cancelled"
end

local function request_kind_name(kind: integer): string
  if kind == REQUEST_SLEEP then return "sleep" end
  if kind == REQUEST_JOIN then return "join" end
  if kind == REQUEST_TICK then return "ticker.tick" end
  if kind == REQUEST_CLEANUP_SLEEP then return "cleanup.sleep" end
  if kind == REQUEST_FS then return "filesystem" end
  if kind == REQUEST_NET then return "network" end
  if kind == REQUEST_SIGNAL then return "signal" end
  if kind == REQUEST_PROCESS then return "process" end
  if kind == REQUEST_HELPER then return "helper" end
  return "unknown"
end

local function waiting_task_diagnostic(runtime: Runtime): string
  local diagnostic = ""
  local raw? = runtime.task_head
  while raw do
    local task = raw as Task
    if #diagnostic > 0 then diagnostic = diagnostic .. ", " end
    diagnostic = diagnostic .. "Task(state=" .. task_state_name(task.state)
    if task.current_request then
      local request = task.current_request as Request
      diagnostic = diagnostic .. ", request=" ..
                   request_kind_name(request.kind)
    else
      diagnostic = diagnostic .. ", request=none"
    end
    diagnostic = diagnostic .. ")"
    raw = task.next_task
  end
  if #diagnostic == 0 then return "no live Tasks" end
  return diagnostic
end

local function check_alignment()
  if libuv.uv_loop_t.alignof > ffi.TValue.alignof or
      libuv.uv_timer_t.alignof > ffi.TValue.alignof or
      libuv.uv_fs_t.alignof > ffi.TValue.alignof or
      libuv.uv_getaddrinfo_t.alignof > ffi.TValue.alignof or
      libuv.uv_connect_t.alignof > ffi.TValue.alignof or
      libuv.uv_write_t.alignof > ffi.TValue.alignof or
      libuv.uv_shutdown_t.alignof > ffi.TValue.alignof or
      libuv.uv_tcp_t.alignof > ffi.TValue.alignof or
      libuv.uv_signal_t.alignof > ffi.TValue.alignof or
      libuv.uv_process_t.alignof > ffi.TValue.alignof or
      libuv.uv_pipe_t.alignof > ffi.TValue.alignof or
      libuv.uv_buf_t.alignof > ffi.TValue.alignof or
      libuv.uv_dirent_t.alignof > ffi.TValue.alignof or
      shim.titan_uvshim_address.alignof > ffi.TValue.alignof then
    raise "libuv requires over-aligned storage on this target"
  end
end

local function allocate_loop(next_generation: integer): Loop
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_loop_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local loop = Loop.new(memory as *libuv.uv_loop_t, storage, next_generation)
  lua.lua_settop(L, top)
  return loop
end

local function new_runtime(): Runtime
  check_alignment()
  generation = generation + 1
  local loop = allocate_loop(generation)
  local status = libuv.uv_loop_init(loop.handle)
  if (status as integer) < 0 then
    loop.handle = nil
    loop.storage = nil
    raise make_error(status as integer, "loop.init", nil)
  end
  local runtime = Runtime.new(loop, generation, main_thread_value(), M,
      nil, nil, nil, nil, nil, nil,
      nil, nil, nil, nil, nil, false, false, false, nil, "", 0)
  active_runtime = runtime
  return runtime
end

local function current_runtime(): Runtime
  if not active_runtime then
    raise "no active libuv Runtime"
  end
  return active_runtime as Runtime
end

local function ensure_runtime(): Runtime
  if active_runtime then
    local runtime = active_runtime as Runtime
    if runtime.closing then
      raise "the libuv Runtime is shutting down"
    end
    return runtime
  end
  return new_runtime()
end

local function link_owner(runtime: Runtime, owner: uv_timer_t)
  local previous? = runtime.timer_owner_head
  owner.metadata.next_owner = previous
  owner.metadata.previous_owner = nil
  if previous then
    local old = previous as uv_timer_t
    old.metadata.previous_owner = owner
  end
  runtime.timer_owner_head = owner
end

local function unlink_owner(owner: uv_timer_t)
  local runtime = owner.metadata.runtime
  local previous? = owner.metadata.previous_owner
  local next? = owner.metadata.next_owner
  if previous then
    local before = previous as uv_timer_t
    before.metadata.next_owner = next
  else
    runtime.timer_owner_head = next
  end
  if next then
    local after = next as uv_timer_t
    after.metadata.previous_owner = previous
  end
  owner.metadata.previous_owner = nil
  owner.metadata.next_owner = nil
end

local function link_signal_owner(runtime: Runtime, owner: uv_signal_t)
  local previous? = runtime.signal_owner_head
  owner.metadata.next_owner = previous
  owner.metadata.previous_owner = nil
  if previous then
    local old = previous as uv_signal_t
    old.metadata.previous_owner = owner
  end
  runtime.signal_owner_head = owner
end

local function unlink_signal_owner(owner: uv_signal_t)
  local runtime = owner.metadata.runtime
  local previous? = owner.metadata.previous_owner
  local next? = owner.metadata.next_owner
  if previous then
    local before = previous as uv_signal_t
    before.metadata.next_owner = next
  else
    runtime.signal_owner_head = next
  end
  if next then
    local after = next as uv_signal_t
    after.metadata.previous_owner = previous
  end
  owner.metadata.previous_owner = nil
  owner.metadata.next_owner = nil
end

local function link_fs_owner(runtime: Runtime, owner: uv_fs_t)
  local previous? = runtime.fs_pending_head
  owner.metadata.next_owner = previous
  owner.metadata.previous_owner = nil
  if previous then
    local old = previous as uv_fs_t
    old.metadata.previous_owner = owner
  end
  runtime.fs_pending_head = owner
end

local function unlink_fs_owner(owner: uv_fs_t)
  local runtime = owner.metadata.runtime
  local previous? = owner.metadata.previous_owner
  local next? = owner.metadata.next_owner
  if previous then
    local before = previous as uv_fs_t
    before.metadata.next_owner = next
  else
    runtime.fs_pending_head = next
  end
  if next then
    local after = next as uv_fs_t
    after.metadata.previous_owner = previous
  end
  owner.metadata.previous_owner = nil
  owner.metadata.next_owner = nil
end

local function link_task(runtime: Runtime, task: Task)
  local previous? = runtime.task_head
  task.next_task = previous
  task.previous_task = nil
  if previous then
    local old = previous as Task
    old.previous_task = task
  end
  runtime.task_head = task
end

local function unlink_task(task: Task)
  local runtime = task.runtime
  local previous? = task.previous_task
  local next? = task.next_task
  if previous then
    local before = previous as Task
    before.next_task = next
  else
    runtime.task_head = next
  end
  if next then
    local after = next as Task
    after.previous_task = previous
  end
  task.previous_task = nil
  task.next_task = nil
end

local function link_file(runtime: Runtime, file: uv_file)
  local previous? = runtime.file_head
  file.next_file = previous
  file.previous_file = nil
  if previous then
    local old = previous as uv_file
    old.previous_file = file
  end
  runtime.file_head = file
end

local function unlink_file(file: uv_file)
  local runtime = file.runtime
  local previous? = file.previous_file
  local next? = file.next_file
  if previous then
    local before = previous as uv_file
    before.next_file = next
  else
    runtime.file_head = next
  end
  if next then
    local after = next as uv_file
    after.previous_file = previous
  end
  file.previous_file = nil
  file.next_file = nil
end

local function link_net_control(runtime: Runtime,
                                control: NetRequestControl)
  local previous? = runtime.net_pending_head
  control.next_control = previous
  control.previous_control = nil
  if previous then
    local old = previous as NetRequestControl
    old.previous_control = control
  end
  runtime.net_pending_head = control
end

local function unlink_net_control(control: NetRequestControl)
  local runtime = control.runtime
  local previous? = control.previous_control
  local next? = control.next_control
  if previous then
    local before = previous as NetRequestControl
    before.next_control = next
  else
    runtime.net_pending_head = next
  end
  if next then
    local after = next as NetRequestControl
    after.previous_control = previous
  end
  control.previous_control = nil
  control.next_control = nil
end

local function link_tcp_control(runtime: Runtime, control: TcpControl)
  local previous? = runtime.tcp_head
  control.next_control = previous
  control.previous_control = nil
  if previous then
    local old = previous as TcpControl
    old.previous_control = control
  end
  runtime.tcp_head = control
end

local function unlink_tcp_control(control: TcpControl)
  local runtime = control.runtime
  local previous? = control.previous_control
  local next? = control.next_control
  if previous then
    local before = previous as TcpControl
    before.next_control = next
  else
    runtime.tcp_head = next
  end
  if next then
    local after = next as TcpControl
    after.previous_control = previous
  end
  control.previous_control = nil
  control.next_control = nil
end

local function link_process_control(runtime: Runtime,
                                    control: ProcessControl)
  local previous? = runtime.process_head
  control.next_control = previous
  control.previous_control = nil
  if previous then
    local old = previous as ProcessControl
    old.previous_control = control
  end
  runtime.process_head = control
  control.linked = true
end

local function unlink_process_control(control: ProcessControl)
  if not control.linked then return end
  local runtime = control.runtime
  local previous? = control.previous_control
  local next? = control.next_control
  if previous then
    local before = previous as ProcessControl
    before.next_control = next
  else
    runtime.process_head = next
  end
  if next then
    local after = next as ProcessControl
    after.previous_control = previous
  end
  control.previous_control = nil
  control.next_control = nil
  control.linked = false
end

local function link_process_request(control: ProcessRequestControl)
  local runtime = control.runtime
  local previous? = runtime.process_request_head
  control.next_control = previous
  control.previous_control = nil
  if previous then
    local old = previous as ProcessRequestControl
    old.previous_control = control
  end
  runtime.process_request_head = control
end

local function unlink_process_request(control: ProcessRequestControl)
  local runtime = control.runtime
  local previous? = control.previous_control
  local next? = control.next_control
  if previous then
    local before = previous as ProcessRequestControl
    before.next_control = next
  else
    runtime.process_request_head = next
  end
  if next then
    local after = next as ProcessRequestControl
    after.previous_control = previous
  end
  control.previous_control = nil
  control.next_control = nil
end

local function validate_tcp(tcp: uv_tcp_t, operation: string,
                            require_server: boolean,
                            allow_closing: boolean)
  local runtime = current_runtime()
  local control = tcp.metadata
  if control.runtime ~= runtime or
      control.generation ~= runtime.generation then
    raise "TCP resource belongs to a stale libuv Runtime"
  end
  if require_server ~= control.server then
    if require_server then
      raise operation .. " requires a Server"
    else
      raise operation .. " requires a Connection"
    end
  end
  if control.lifecycle == TCP_CLOSED then
    raise "cannot " .. operation .. " a closed TCP resource"
  end
  if control.lifecycle == TCP_CLOSING and not allow_closing then
    raise "cannot " .. operation .. " a closing TCP resource"
  end
  if control.close_requested and not allow_closing then
    raise "cannot " .. operation .. " a closing TCP resource"
  end
end

local function enqueue_output(tcp: uv_tcp_t, operation: NetOperation)
  local control = tcp.metadata
  local previous? = control.output_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    local tail = previous as NetOperation
    tail.next_operation = operation
  else
    control.output_head = operation
  end
  control.output_tail = operation
  operation.linked = true
  operation.close_waiter = false
end

local function remove_output(tcp: uv_tcp_t, operation: NetOperation)
  if not operation.linked or operation.close_waiter then return end
  local control = tcp.metadata
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    local before = previous as NetOperation
    before.next_operation = next
  else
    control.output_head = next
  end
  if next then
    local after = next as NetOperation
    after.previous_operation = previous
  else
    control.output_tail = previous
  end
  if control.output_current == operation then
    control.output_current = nil
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.owner = nil
  operation.prepared_buffer = nil
  operation.linked = false
end

local function enqueue_tcp_close_waiter(tcp: uv_tcp_t,
                                        operation: NetOperation)
  local control = tcp.metadata
  local previous? = control.close_waiter_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    local tail = previous as NetOperation
    tail.next_operation = operation
  else
    control.close_waiter_head = operation
  end
  control.close_waiter_tail = operation
  operation.linked = true
  operation.close_waiter = true
end

local function remove_tcp_close_waiter(tcp: uv_tcp_t,
                                       operation: NetOperation)
  if not operation.linked or not operation.close_waiter then return end
  local control = tcp.metadata
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    local before = previous as NetOperation
    before.next_operation = next
  else
    control.close_waiter_head = next
  end
  if next then
    local after = next as NetOperation
    after.previous_operation = previous
  else
    control.close_waiter_tail = previous
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.linked = false
  operation.close_waiter = false
end

local function enqueue_accepted(server: uv_tcp_t, client: uv_tcp_t): boolean
  local control = server.metadata
  if control.accept_count >= control.accept_capacity then return false end
  control.accept_tail = control.accept_tail % control.accept_capacity + 1
  control.accept_queue[control.accept_tail] = client
  control.accept_count = control.accept_count + 1
  return true
end

local function dequeue_accepted(server: uv_tcp_t): uv_tcp_t
  local control = server.metadata
  if control.accept_count == 0 then
    raise "cannot dequeue from an empty Server accept queue"
  end
  local raw? = control.accept_queue[control.accept_head]
  control.accept_queue[control.accept_head] = nil
  control.accept_head = control.accept_head % control.accept_capacity + 1
  control.accept_count = control.accept_count - 1
  return raw as uv_tcp_t
end

local function create_file(runtime: Runtime, handle: libuv.uv_file,
                           subject: string): uv_file
  local file = uv_file.new(handle, runtime, runtime.generation, FS.file_open,
      subject, nil, nil, nil, nil, nil, nil, nil, false, 0, false)
  link_file(runtime, file)
  return file
end

local function validate_file(file: uv_file, operation: string,
                             allow_closing: boolean)
  local runtime = current_runtime()
  if file.runtime ~= runtime or file.generation ~= runtime.generation then
    raise "File belongs to a stale libuv Runtime"
  end
  if file.state == FS.file_closed then
    raise "cannot " .. operation .. " a closed File"
  end
  if file.state == FS.file_closing and not allow_closing then
    raise "cannot " .. operation .. " a closing File"
  end
end

local function enqueue_file_operation(file: uv_file, operation: FsOperation)
  local previous? = file.queue_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    local tail = previous as FsOperation
    tail.next_operation = operation
  else
    file.queue_head = operation
  end
  file.queue_tail = operation
  operation.linked = true
  operation.close_waiter = false
  if operation.kind == FS.close or operation.kind == FS.internal_close then
    file.close_enqueued = true
  end
end

local function remove_file_operation(file: uv_file,
                                     operation: FsOperation)
  if not operation.linked or operation.close_waiter then return end
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    local before = previous as FsOperation
    before.next_operation = next
  else
    file.queue_head = next
  end
  if next then
    local after = next as FsOperation
    after.previous_operation = previous
  else
    file.queue_tail = previous
  end
  if file.current == operation then file.current = nil end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.owner = nil
  operation.linked = false
end

local function enqueue_close_waiter(file: uv_file, operation: FsOperation)
  local previous? = file.close_waiter_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    local tail = previous as FsOperation
    tail.next_operation = operation
  else
    file.close_waiter_head = operation
  end
  file.close_waiter_tail = operation
  operation.linked = true
  operation.close_waiter = true
end

local function remove_close_waiter(file: uv_file, operation: FsOperation)
  if not operation.linked or not operation.close_waiter then return end
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    local before = previous as FsOperation
    before.next_operation = next
  else
    file.close_waiter_head = next
  end
  if next then
    local after = next as FsOperation
    after.previous_operation = previous
  else
    file.close_waiter_tail = previous
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.linked = false
  operation.close_waiter = false
end

local function close_owner(owner: uv_timer_t)
  if owner.metadata.lifecycle == OWNER_ACTIVE then
    if owner.metadata.kind == OWNER_TICKER then
      local state = owner.metadata.peer as TickerState
      state.open = false
    end
    libuv.uv_timer_stop(owner.handle)
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(owner.handle)
  end
end

local function close_all_owners(runtime: Runtime)
  local raw? = runtime.timer_owner_head
  while raw do
    local owner = raw as uv_timer_t
    raw = owner.metadata.next_owner
    close_owner(owner)
  end
end

local function close_signal_owner(owner: uv_signal_t)
  if owner.metadata.lifecycle == OWNER_ACTIVE then
    shim.titan_uvshim_signal_stop(owner.handle)
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_signal_close(owner.handle)
  end
end

local function close_all_signal_owners(runtime: Runtime)
  local raw? = runtime.signal_owner_head
  while raw do
    local owner = raw as uv_signal_t
    raw = owner.metadata.next_owner
    close_signal_owner(owner)
  end
end

local function maybe_finish_session(runtime: Runtime)
  if not runtime.task_head and runtime.pending_observations == 0 then
    runtime.closing = true
    close_all_owners(runtime)
    close_all_signal_owners(runtime)
    begin_file_shutdown(runtime)
    begin_tcp_shutdown(runtime)
    begin_process_shutdown(runtime)
  end
end

local function allocate_owner(runtime: Runtime, kind: integer, task: Task?,
                              peer: value, epoch: integer):
                              (uv_timer_t, ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_timer_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local metadata = TimerControl.new(runtime, runtime.generation,
      OWNER_ALLOCATED, kind, task, peer, epoch, nil, nil)
  local owner: uv_timer_t = {
    handle = memory as *libuv.uv_timer_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = timer_dispatch,
    root = task,
    metadata = metadata,
    buffer = nil,
  }
  -- Root the wrapper on the Lua stack before link_owner's entry GC check,
  -- and compute callback navigation while that root is still present.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  link_owner(runtime, owner)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_signal_owner(runtime: Runtime, task: Task,
                                     spec: SignalSpec, epoch: integer):
                                     (uv_signal_t,
                                      ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_signal_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local metadata = SignalControl.new(runtime, runtime.generation,
      OWNER_ALLOCATED, task, epoch, spec.name, spec.signum, nil, nil,
      false, false)
  local owner: uv_signal_t = {
    handle = memory as *libuv.uv_signal_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = signal_dispatch,
    root = task,
    metadata = metadata,
    buffer = spec,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  link_signal_owner(runtime, owner)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_fs_owner(runtime: Runtime,
                                 operation: FsOperation): uv_fs_t
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_fs_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local metadata = FsControl.new(runtime, runtime.generation,
      FS_OWNER_ALLOCATED, false, false, 0, false, operation, nil, nil,
      -1 as libuv.uv_file, false)
  local owner: uv_fs_t = {
    handle = memory as *libuv.uv_fs_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = fs_dispatch,
    root = operation.task,
    metadata = metadata,
    buffer = nil,
  }
  -- No allocating Titan helper may run after this owner is linked and before
  -- libuv accepts (or synchronously rejects) its request.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  link_fs_owner(runtime, owner)
  shim.titan_uvshim_fs_set_data(owner.handle, pointer)
  lua.lua_settop(L, top)
  return owner
end

