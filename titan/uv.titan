  local cancel_requested: boolean
  local cancel_reason: value
  local cancel_value: Cancelled?
  local operation: value
  local current_request: Request?
  local joiner_head: Task?
  local join_next: Task?
  local join_previous: Task?
  local joining_target: Task?
  local next_task: Task?
  local previous_task: Task?
  local permanently_observed: boolean
  local observer_count: integer
  local cleanup_shield_depth: integer
  local cancel_deferred: boolean
  local cancel_fallback: boolean
  local helper_group: HelperGroup?
  local helper_kind: integer
  -- TITAN_UV_PHASE6_HELPER_TASK_FIELDS
  local main: boolean
end

