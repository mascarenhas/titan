local function allocate_tcp_owner(runtime: Runtime):
                                  (uv_tcp_t, ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_tcp_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control: TcpControl = {
    runtime = runtime,
    generation = runtime.generation,
    lifecycle = TCP_ALLOCATED,
    server = false,
    published = false,
    owner = nil,
    next_control = nil,
    previous_control = nil,
    connect_pending = false,
    close_callback_seen = false,
    close_requested = false,
    shutdown_requested = false,
    write_shutdown = false,
    read_active = false,
    read_terminal = TCP_READ_OPEN,
    read_error = nil,
    read_waiter = nil,
    read_epoch = 0,
    read_bytes = nil,
    output_head = nil,
    output_tail = nil,
    output_current = nil,
    close_waiter_head = nil,
    close_waiter_tail = nil,
    accept_waiter = nil,
    accept_epoch = 0,
    accept_queue = {},
    accept_head = 1,
    accept_tail = 0,
    accept_count = 0,
    accept_capacity = 0,
    accept_error = nil,
    -- TITAN_UV_PHASE5_TCP_TEST_INIT
    setup_operation = nil,
  }
  local owner: uv_tcp_t = {
    handle = memory as *libuv.uv_tcp_t,
    storage = storage,
    main_thread = runtime.main_thread,
    module = runtime.module,
    dispatcher = tcp_dispatch,
    root = control,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_tcp_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function discard_tcp_storage(tcp: uv_tcp_t)
  local control = tcp.metadata
  if not control.owner then return end
  -- Unlink while every owner/root field is still intact.  After unlinking,
  -- only non-raising field clears remain in this frame.
  unlink_tcp_control(control)
  tcp.handle = nil
  tcp.storage = nil
  tcp.root = nil
  tcp.buffer = nil
  control.lifecycle = TCP_CLOSED
  control.owner = nil
end

local function initialize_tcp(runtime: Runtime): (uv_tcp_t, integer)
  local tcp, pointer = allocate_tcp_owner(runtime)
  local status = shim.titan_uvshim_tcp_init(runtime.loop.handle, tcp.handle,
                                            pointer)
  if (status as integer) < 0 then
    -- The handle was never accepted by libuv.  Inline terminal unlink so an
    -- emergency longjmp cannot strand an owner for which no callback is owed.
    local control = tcp.metadata
    local previous? = control.previous_control
    local next? = control.next_control
    if previous then
      local before = previous as TcpControl
      before.next_control = next
    else
      runtime.tcp_head = next
    end
    if next then
      local after = next as TcpControl
      after.previous_control = previous
    end
    control.previous_control = nil
    control.next_control = nil
    tcp.handle = nil
    tcp.storage = nil
    tcp.root = nil
    tcp.buffer = nil
    control.lifecycle = TCP_CLOSED
    control.owner = nil
    return tcp, status as integer
  end
  tcp.metadata.lifecycle = TCP_INITIALIZED
  return tcp, 0
end

local function start_tcp_close(tcp: uv_tcp_t)
  local control = tcp.metadata
  control.close_requested = true
  if control.lifecycle == TCP_CLOSED or
      control.lifecycle == TCP_CLOSING then return end
  if control.lifecycle == TCP_ALLOCATED then
    discard_tcp_storage(tcp)
    return
  end
  if control.read_active then
    shim.titan_uvshim_tcp_read_stop(tcp.handle)
    control.read_active = false
    control.read_waiter = nil
    control.read_epoch = 0
    control.read_bytes = nil
    tcp.buffer = nil
  end
  control.lifecycle = TCP_CLOSING
  shim.titan_uvshim_tcp_close(tcp.handle)
end

