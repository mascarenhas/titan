  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_SHUTDOWN, operation)
  local owner: uv_shutdown_t = {
    handle = memory as *libuv.uv_shutdown_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = shutdown_dispatch,
