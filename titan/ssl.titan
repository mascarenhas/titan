--- Verified TLS connections and listeners over Task-aware TCP streams.
-- @module titan.ssl
-- @usage standard-library-ssl.md

local async = import "async"
local uv = import "uv"
local fs = import "fs"
local net = import "net"
local string = import "string"
local gc = import "gc"
foreign import "openssl/err.h"
foreign import "openssl/x509v3.h"
foreign import "openssl/pem.h"
foreign import "openssl/ssl.h"
foreign import "stddef.h"
foreign import "string.h"

foreign type VoidPointer = *void

local TLS_RECORD_BYTES = 16 * 1024
local MAX_PEM_BYTES = 2147483647
local STATE_HANDSHAKING = "handshaking"
local STATE_OPEN = "open"
local STATE_WRITE_SHUTDOWN = "write-shutdown"
local STATE_PEER_CLOSED = "peer-closed"
local STATE_SHUTDOWN = "shutdown"
local STATE_TERMINATING = "terminating"
local STATE_FAILED = "failed"
local STATE_CLOSED = "closed"

local record DefaultClientContextOwner
  local context: foreign *SSL_CTX
end

-- This private record is the module's owning full-userdata GC root. The raw
-- pointer is only a borrowed fast path; each default-trust connection takes
-- and releases an independent reference around SSL_new.
local default_client_context_owner: DefaultClientContextOwner? = nil
local default_client_context: foreign *SSL_CTX = nil

local function finalize_default_client_context(
    owner: DefaultClientContextOwner)
  local context = owner.context
  if not context then return end

  -- Clear both views before releasing the native object. Besides making the
  -- finalizer idempotent, this prevents a borrowed pointer from surviving the
  -- typed owner field that governs its lifetime.
  owner.context = nil
  default_client_context = nil
  ffi.SSL_CTX_free(context)
end

local function allocate_default_client_context_owner():
    DefaultClientContextOwner
  local owner = DefaultClientContextOwner(nil)
  default_client_context_owner = owner
  gc.finalizable<|DefaultClientContextOwner|>(
      owner, finalize_default_client_context)
  return owner
end

--- A structured TLS or certificate failure with a stable name and operation.
-- @field code Numeric TLS error code.
-- @field name Stable TLS failure name, such as TLS_TRUNCATED_EOF.
-- @field message Human-readable failure description.
-- @field operation Operation that reported the failure.
-- @usage standard-library-ssl.md#errors
record Error
  code: integer
  name: string
  message: string
  operation: string
end

local union OperationResult
  success(string?)
  failure(async.Error)
end

local record ProgressWait
  task: async.Task<|value, value|>
  token: async.ResumeToken
end

-- Admission belongs to the public parent until its epilogue. Engine access
-- belongs to the internal child and retires before shared cleanup can settle.
local record Operation
  kind: string
  engine_live: boolean
  child: async.Task<|OperationResult, value|>?
  progress: ProgressWait?
end

local record CleanupWait
  done: async.Completion<|Connection, value, value|>
  number: integer
end

local record ChildDrain
  child: async.Task<|OperationResult, value|>
  remove: (function (): ())?
end

--- An owned TLS byte stream permitting one reader and one writer concurrently.
-- @usage standard-library-ssl.md#server-connections-and-handshakes
record Connection
  local transport: net.Connection
  local handle: foreign *SSL
  local input: foreign *BIO
  local output: foreign *BIO
  local client: boolean
  local state: string
  local reader: Operation?
  local writer: Operation?
  local control: Operation?
  local handshaker: Operation?
  local feeder: Operation?
  local retry: Operation?
  local cleanup_waiters: {CleanupWait}
  local scope_waiters: {CleanupWait}
  local transport_eof: boolean
  local transport_shutdown: boolean
  local transport_closed: boolean
  local excess: string
end

--- An owned TLS listener whose accepted connections have independent lifetimes.
-- @usage standard-library-ssl.md#server-connections-and-handshakes
record Server
  local listener: net.Server
  local context: foreign *SSL_CTX
  local closed: boolean
  local listener_closed: boolean
end

local record PemBlock
  local name_buffer: foreign *void
  local header_buffer: foreign *void
  local data_buffer: foreign *void
  local name: string
  local header: string
  local length: integer
end

local record CertificateResult
  local pointer: foreign *X509
  local found: boolean
end

local record PrivateKeyResult
  local pointer: foreign *EVP_PKEY
  local found: boolean
end

local function checked_text(text: string, operation: string): string
  if ffi.strlen(text) ~= (#text as foreign size_t) then
    raise Error {
      code = 0,
      name = "INVALID_TEXT",
      message = "text must not contain an embedded NUL",
      operation = operation,
    }
  end
  return text
end

-- A zone identifier selects a local interface for a scoped IPv6 connection;
-- it is not part of the certificate IP identity. OpenSSL's IP parser rejects
-- the `%zone` suffix, so remove it only for verification while retaining the
-- original address for net.connect.
local function verification_host(host: string): string
  local colon? = string.find(host, ":")
  local scope? = string.find(host, "%")
  if colon and scope and (colon as integer) < (scope as integer) then
    return string.sub(host, 1, (scope as integer) - 1)
  end
  return host
end

local function error_reason(fallback: string): string
  local packed = ffi.ERR_get_error()
  if packed ~= 0 then
    local reason = ffi.ERR_reason_error_string(packed)
    if reason then return reason as string end
  end
  return fallback
end

local function openssl_error(operation: string,
                             fallback: string): Error
  local packed = ffi.ERR_get_error()
  if packed ~= 0 then
    local reason = ffi.ERR_reason_error_string(packed)
    if reason then
      return Error {
        code = packed as integer,
        name = "OPENSSL",
        message = reason as string,
        operation = operation,
      }
    end
    return Error {
      code = packed as integer,
      name = "OPENSSL",
      message = fallback,
      operation = operation,
    }
  end
  return Error {
    code = 0,
    name = "OPENSSL",
    message = fallback,
    operation = operation,
  }
end

local function ssl_error_name(code: integer): string
  if code == ffi.SSL_ERROR_NONE then return "SSL_ERROR_NONE" end
  if code == ffi.SSL_ERROR_SSL then return "SSL_ERROR_SSL" end
  if code == ffi.SSL_ERROR_WANT_READ then return "SSL_ERROR_WANT_READ" end
  if code == ffi.SSL_ERROR_WANT_WRITE then return "SSL_ERROR_WANT_WRITE" end
  if code == ffi.SSL_ERROR_WANT_X509_LOOKUP then
    return "SSL_ERROR_WANT_X509_LOOKUP"
  end
  if code == ffi.SSL_ERROR_SYSCALL then return "SSL_ERROR_SYSCALL" end
  if code == ffi.SSL_ERROR_ZERO_RETURN then
    return "SSL_ERROR_ZERO_RETURN"
  end
  if code == ffi.SSL_ERROR_WANT_CONNECT then
    return "SSL_ERROR_WANT_CONNECT"
  end
  if code == ffi.SSL_ERROR_WANT_ACCEPT then
    return "SSL_ERROR_WANT_ACCEPT"
  end
  if code == ffi.SSL_ERROR_WANT_ASYNC then
    return "SSL_ERROR_WANT_ASYNC"
  end
  if code == ffi.SSL_ERROR_WANT_ASYNC_JOB then
    return "SSL_ERROR_WANT_ASYNC_JOB"
  end
  if code == ffi.SSL_ERROR_WANT_CLIENT_HELLO_CB then
    return "SSL_ERROR_WANT_CLIENT_HELLO_CB"
  end
  if code == ffi.SSL_ERROR_WANT_RETRY_VERIFY then
    return "SSL_ERROR_WANT_RETRY_VERIFY"
  end
  return "SSL_ERROR_UNKNOWN"
end

local function ssl_error(code: integer, operation: string): Error
  return Error {
    code = code,
    name = ssl_error_name(code),
    message = error_reason("TLS operation failed"),
    operation = operation,
  }
end

local function truncated_eof_error(code: integer,
                                   operation: string): Error
  return Error {
    code = code,
    name = "TLS_TRUNCATED_EOF",
    message = "TLS transport closed without close_notify",
    operation = operation,
  }
end

local function operation_error(connection: Connection, code: integer,
                               operation: string): Error
  local failure = ssl_error(code, operation)
  if connection.transport_eof and
     (code == ffi.SSL_ERROR_SSL or
      code == ffi.SSL_ERROR_SYSCALL) then
    return truncated_eof_error(code, operation)
  end
  return failure
end

local function verify_error(code: integer): Error
  local message = "certificate verification failed"
  local reason = ffi.X509_verify_cert_error_string(
      code as foreign long)
  if reason then message = reason as string end
  return Error {
    code = code,
    name = "CERTIFICATE_VERIFY_FAILED",
    message = message,
    operation = "ssl.handshake.verify",
  }
end

local function bytes_string(bytes: foreign const *char,
                            length: integer): string
  if length == 0 then return "" end
  local storage: owned char[] =
    foreign char.new_array(length)
  ffi.memcpy(storage, bytes, length as foreign size_t)
  return storage as string
end

local function free_engine(connection: Connection)
  if connection.handle then ffi.SSL_free(connection.handle) end
  connection.handle = nil
  connection.input = nil
  connection.output = nil
  connection.excess = ""
end

local function close_transport(connection: Connection)
  if connection.transport_closed then return end
  connection.transport:close()
  connection.transport_closed = true
end

local function interrupted(operation: string): Error
  return Error {code = 0, name = "TLS_INTERRUPTED",
    message = "TLS Connection was interrupted", operation = operation}
end

local function require_engine(connection: Connection, operation: string)
  if connection.state == STATE_TERMINATING or not connection.handle then
    raise interrupted(operation)
  end
end

local function wake_operation(operation: Operation?)
  if operation == nil then return end
  local waiter? = operation.progress
  operation.progress = nil
  if waiter ~= nil then waiter.task:resume(waiter.token) end
end

local function wake_progress(connection: Connection)
  wake_operation(connection.reader)
  wake_operation(connection.writer)
  wake_operation(connection.control)
end

local function wait_progress(connection: Connection, operation: Operation)
  require_engine(connection, "ssl." .. operation.kind)
  local waiter = ProgressWait(async.running(), async.ResumeToken.new("ssl.progress"))
  operation.progress = waiter
  local detach = function ()
    if operation.progress == waiter then operation.progress = nil end
  end
  defer detach()
  async.suspend(waiter.token, detach)
  require_engine(connection, "ssl." .. operation.kind)
end

local function scopes_retired(connection: Connection): boolean
  return (connection.reader == nil or not connection.reader.engine_live) and
         (connection.writer == nil or not connection.writer.engine_live) and
         (connection.control == nil or not connection.control.engine_live)
end

local function settle_cleanup(waiters: {CleanupWait})
  for index = 1, #waiters do
    local waiter = waiters[index]
    waiter.done:resolve(waiter.number, nil)
  end
end

local function retire_scope(connection: Connection, operation: Operation)
  operation.engine_live = false
  operation.progress = nil
  if connection.handshaker == operation then connection.handshaker = nil end
  if connection.feeder == operation then connection.feeder = nil end
  if connection.retry == operation then connection.retry = nil end
  wake_progress(connection)
  if scopes_retired(connection) and #connection.scope_waiters > 0 then
    local waiters = connection.scope_waiters
    connection.scope_waiters = {}
    settle_cleanup(waiters)
  end
end

local function start_cleanup(done: async.Completion<|Connection, value, value|>,
                             number: integer): uv.req_t?
  local connection = done:context(number)
  if connection.state == STATE_CLOSED or connection.state == STATE_FAILED then done:resolve(number, nil)
  else
    connection.cleanup_waiters[#connection.cleanup_waiters + 1] = CleanupWait(done, number)
  end
  return nil
end

local function start_scopes(done: async.Completion<|Connection, value, value|>,
                            number: integer): uv.req_t?
  local connection = done:context(number)
  if scopes_retired(connection) then done:resolve(number, nil)
  else connection.scope_waiters[#connection.scope_waiters + 1] = CleanupWait(done, number) end
  return nil
end

local function cancel_operation(operation: Operation?)
  if operation ~= nil and operation.child ~= nil and
     (operation.child as async.Task<|value, value|>) ~= async.running() then
    operation.child:cancel(async.CancellationReason.simple("TLS transport retirement"))
  end
end

-- This core never joins an internal Task: its child may be waiting for this
-- very completion. Only engine-scope retirement is the quiescence condition.
local function terminate(connection: Connection, graceful: boolean)
  if connection.state == STATE_CLOSED or connection.state == STATE_FAILED then return end
  if connection.state == STATE_TERMINATING then
    async.await_cleanup_with(connection, start_cleanup)
    return
  end
  connection.state = STATE_TERMINATING
  wake_progress(connection)
  cancel_operation(connection.reader)
  cancel_operation(connection.writer)
  cancel_operation(connection.control)
  do close_transport(connection) catch end
  if not scopes_retired(connection) then
    async.await_cleanup_with(connection, start_scopes)
  end
  free_engine(connection)
  if graceful then connection.state = STATE_CLOSED
  else connection.state = STATE_FAILED end
  local waiters = connection.cleanup_waiters
  connection.cleanup_waiters = {}
  settle_cleanup(waiters)
end

local function start_child_drain(
    done: async.Completion<|ChildDrain, async.TaskStatus<|OperationResult, value|>, value|>,
    number: integer): uv.req_t?
  local drain = done:context(number)
  drain.remove = drain.child:add_terminal_listener(function (
      status: async.TaskStatus<|OperationResult, value|>)
    done:resolve(number, status)
  end)
  local status = drain.child:status()
  if status:has_finished() then done:resolve(number, status) end
  return nil
end

local function drain_child(child: async.Task<|OperationResult, value|>)
  if child:status():has_finished() then return end
  local drain = ChildDrain(child, nil)
  defer (function () if drain.remove ~= nil then drain.remove() end end)()
  async.await_cleanup_with(drain, start_child_drain)
end

local function begin_operation(connection: Connection, kind: string): Operation?
  if connection.state == STATE_CLOSED then return nil end
  if connection.state == STATE_TERMINATING or connection.state == STATE_FAILED then
    raise interrupted("ssl." .. kind)
  end
  if connection.control ~= nil or
     (kind == "read" and connection.reader ~= nil) or
     (kind == "write" and connection.writer ~= nil) or
     (kind ~= "read" and kind ~= "write" and
      (connection.reader ~= nil or connection.writer ~= nil)) then
    raise "ssl." .. kind .. ": SSL Connection already has an operation in progress"
  end
  if kind == "write" and
     (connection.state == STATE_WRITE_SHUTDOWN or
      connection.state == STATE_PEER_CLOSED or connection.state == STATE_SHUTDOWN) then
    raise "ssl.write: SSL Connection is shutting down"
  end
  local operation = Operation(kind, false, nil, nil)
  if kind == "read" then connection.reader = operation
  elseif kind == "write" then connection.writer = operation
  else connection.control = operation end
  return operation
end

local function release_operation(connection: Connection, operation: Operation)
  if connection.reader == operation then connection.reader = nil end
  if connection.writer == operation then connection.writer = nil end
  if connection.control == operation then connection.control = nil end
  wake_progress(connection)
end

local function supervise(connection: Connection, operation: Operation,
                          body: function (): (string?)): string?
  defer release_operation(connection, operation)
  local child = async.run<|OperationResult, value|>(function (): OperationResult
    do
      if connection.state == STATE_TERMINATING or connection.state == STATE_CLOSED or
         connection.state == STATE_FAILED then
        raise interrupted("ssl." .. operation.kind)
      end
      operation.engine_live = true
      local result? = body()
      retire_scope(connection, operation)
      return OperationResult.success(result)
    catch
      local failure = async.Error(error, traceback)
      retire_scope(connection, operation)
      terminate(connection, false)
      return OperationResult.failure(failure)
    end
  end)
  operation.child = child
  local parent = async.running()
  local token = async.ResumeToken.new("ssl.operation")
  local waiting = false
  local remove = child:add_terminal_listener(function (_: async.TaskStatus<|OperationResult, value|>)
    if waiting then
      waiting = false
      parent:resume(token)
    end
  end)
  defer remove()
  do
    if not child:status():has_finished() then
      waiting = true
      local detach = function () waiting = false end
      async.suspend(token, detach)
    end
  catch
    local failure = async.Error(error, traceback)
    waiting = false
    child:cancel(async.CancellationReason.simple("TLS operation cancelled"))
    terminate(connection, false)
    drain_child(child)
    failure:raise()
  end
  drain_child(child)
  case child:status()
  when succeeded(result) then
    case result
    when success(bytes) then return bytes
    when failure(failure) then failure:raise()
    end
  when failed(failure) then failure:raise()
  when cancelled(_) then raise interrupted("ssl." .. operation.kind)
  else raise "SSL child did not finish"
  end
  return nil
end

local function engine_gate(connection: Connection, operation: Operation)
  require_engine(connection, "ssl." .. operation.kind)
  while connection.retry ~= nil and connection.retry ~= operation do
    wait_progress(connection, operation)
  end
end

local function retry_owner(connection: Connection, operation: Operation, code: integer)
  if code == ffi.SSL_ERROR_WANT_WRITE then connection.retry = operation
  elseif connection.retry == operation then
    connection.retry = nil
    wake_progress(connection)
  end
end

-- Detach the entire step's output without yielding, then submit exactly one
-- immutable batch. net.write accepts before its first suspension, preserving
-- engine-step submission order across independently progressing directions.
local function drain_output(connection: Connection): integer
  require_engine(connection, "ssl.output")
  local pending = ffi.BIO_ctrl_pending(connection.output) as integer
  if pending == 0 then return 0 end
  local buffer: owned char[] = foreign char.new_array(pending)
  local lengths = foreign size_t.new_array(1)
  lengths[0] = 0 as foreign size_t
  ffi.ERR_clear_error()
  local ok = ffi.BIO_read_ex(connection.output, buffer,
                            pending as foreign size_t, lengths)
  if ok ~= 1 or (lengths[0] as integer) ~= pending then
    raise openssl_error("ssl.output.read", "failed to detach the TLS output BIO")
  end
  local batch = buffer as string
  connection.transport:write(batch)
  require_engine(connection, "ssl.output")
  return pending
end

local function drain_step(connection: Connection, code: integer,
                           failure: Error): integer
  do return drain_output(connection)
  catch
    if code == ffi.SSL_ERROR_SSL or code == ffi.SSL_ERROR_SYSCALL then
      raise failure
    end
    raise error
  end
  return 0
end

-- BIO_set_mem_eof_return is a public function-like macro unavailable to the
-- FFI. BIO_ctrl with BIO_C_SET_BUF_MEM_EOF_RETURN is its documented primitive
-- expansion for configuring a memory BIO's empty-read result.
local function set_memory_bio_eof_return(bio: foreign *BIO,
                                         result: integer)
  ffi.BIO_ctrl(bio, ffi.BIO_C_SET_BUF_MEM_EOF_RETURN,
                   result as foreign long, nil)
end

local function mark_transport_eof(connection: Connection)
  connection.transport_eof = true
  set_memory_bio_eof_return(connection.input, 0)
end

local function feed_input(connection: Connection, owner: Operation, operation: string)
  require_engine(connection, operation)
  if connection.feeder ~= nil then
    wait_progress(connection, owner)
    return
  end
  connection.feeder = owner
  defer (function ()
    if connection.feeder == owner then connection.feeder = nil end
    wake_progress(connection)
  end)()
  if connection.transport_eof then return end
  local encrypted: string? = (function (
      connection: Connection, operation: string): string?
    return connection.transport:read()
  catch
    if error is async.OperationError then
      local failure = error as async.OperationError
      if failure.name == "ECONNRESET" and
         failure.operation == "net.read" then
        -- FIN and RST are different TCP presentations of the same TLS
        -- truncation boundary when no authenticated close_notify arrived.
        -- Convert the reset here: feeding EOF back through OpenSSL queues a
        -- fatal alert whose write to the reset transport could otherwise
        -- replace this authoritative TLS failure.
        raise truncated_eof_error(ffi.SSL_ERROR_SYSCALL, operation)
      end
    end
    raise error
  end)(connection, operation)
  require_engine(connection, operation)
  if not encrypted then
    mark_transport_eof(connection)
    return
  end

  local input = encrypted as string
  local bytes = input as foreign const *char
  local offset = 0
  while offset < #input do
    local lengths = foreign size_t.new_array(1)
    lengths[0] = 0 as foreign size_t
    ffi.ERR_clear_error()
    local ok = ffi.BIO_write_ex(
        connection.input, bytes + offset,
        (#input - offset) as foreign size_t, lengths)
    if ok ~= 1 or lengths[0] == 0 then
      raise openssl_error("ssl.input.write",
                          "failed to feed the TLS input BIO")
    end
    offset = offset + (lengths[0] as integer)
  end
end

local function want_retry(connection: Connection, owner: Operation, code: integer,
                          operation: string, drained: integer): boolean
  if code == ffi.SSL_ERROR_WANT_READ then
    if connection.transport_eof then
      raise truncated_eof_error(code, operation)
    end
    if connection.state == STATE_PEER_CLOSED then
      raise interrupted(operation)
    end
    feed_input(connection, owner, operation)
    return true
  elseif code == ffi.SSL_ERROR_WANT_WRITE then
    if drained == 0 then
      raise Error {
        code = code,
        name = "SSL_ERROR_WANT_WRITE",
        message = "TLS requested output progress without producing output",
        operation = operation,
      }
    end
    return true
  end
  return false
end

local function handshake_locked(connection: Connection, owner: Operation)
  while connection.state == STATE_HANDSHAKING and
        connection.handshaker ~= nil and connection.handshaker ~= owner do
    wait_progress(connection, owner)
  end
  require_engine(connection, "ssl.handshake")
  if connection.state ~= STATE_HANDSHAKING then return end
  connection.handshaker = owner

  while true do
    engine_gate(connection, owner)
    ffi.ERR_clear_error()
    local result = ffi.SSL_do_handshake(connection.handle)
    if result == 1 then
      retry_owner(connection, owner, ffi.SSL_ERROR_NONE)
      if connection.client then
        local verification =
          ffi.SSL_get_verify_result(connection.handle) as integer
        if verification ~= ffi.X509_V_OK then
          local failure = verify_error(verification)
          drain_step(connection, ffi.SSL_ERROR_SSL, failure)
          raise failure
        end
      end
      drain_output(connection)
      connection.state = STATE_OPEN
      connection.handshaker = nil
      wake_progress(connection)
      return
    end

    -- SSL_get_error must be the first OpenSSL call after the failed operation.
    local code = ffi.SSL_get_error(connection.handle, result) as integer
    retry_owner(connection, owner, code)
    local failure = operation_error(connection, code, "ssl.handshake")
    if connection.client then
      local verification =
        ffi.SSL_get_verify_result(connection.handle) as integer
      if verification ~= ffi.X509_V_OK then
        failure = verify_error(verification)
      end
    end
    local drained = drain_step(connection, code, failure)
    if not want_retry(connection, owner, code, "ssl.handshake", drained) then
      raise failure
    end
  end
end

local function send_shutdown_locked(connection: Connection, owner: Operation)
  if connection.state == STATE_WRITE_SHUTDOWN or
     connection.state == STATE_SHUTDOWN then return end
  require_engine(connection, "ssl.shutdown")
  if connection.state == STATE_HANDSHAKING then
    handshake_locked(connection, owner)
  end

  while true do
    engine_gate(connection, owner)
    ffi.ERR_clear_error()
    local result = ffi.SSL_shutdown(connection.handle)
    if result >= 0 then
      retry_owner(connection, owner, ffi.SSL_ERROR_NONE)
      drain_output(connection)
      if result == 1 or connection.state == STATE_PEER_CLOSED then
        connection.state = STATE_SHUTDOWN
      else
        connection.state = STATE_WRITE_SHUTDOWN
      end
      break
    end

    local code = ffi.SSL_get_error(connection.handle, result) as integer
    retry_owner(connection, owner, code)
    local failure = operation_error(connection, code, "ssl.shutdown")
    local drained = drain_step(connection, code, failure)
    if code == ffi.SSL_ERROR_WANT_READ then
      local flags = ffi.SSL_get_shutdown(connection.handle)
      if (flags & ffi.SSL_SENT_SHUTDOWN) ~= 0 then
        connection.state = STATE_WRITE_SHUTDOWN
        break
      end
    end
    if not want_retry(connection, owner, code, "ssl.shutdown", drained) then
      raise failure
    end
  end

  if not connection.transport_shutdown then
    connection.transport:shutdown()
    connection.transport_shutdown = true
  end
end

local function read_locked(connection: Connection, owner: Operation): string?
  require_engine(connection, "ssl.read")
  if #connection.excess > 0 then
    local result = connection.excess
    connection.excess = ""
    return result
  end
  if connection.state == STATE_PEER_CLOSED or
     connection.state == STATE_SHUTDOWN then return nil end
  handshake_locked(connection, owner)

  local buffer = foreign char.new_array(TLS_RECORD_BYTES)
  while true do
    engine_gate(connection, owner)
    local lengths = foreign size_t.new_array(1)
    lengths[0] = 0 as foreign size_t
    ffi.ERR_clear_error()
    local result = ffi.SSL_read_ex(
        connection.handle, buffer,
        TLS_RECORD_BYTES as foreign size_t, lengths)
    if result == 1 then
      retry_owner(connection, owner, ffi.SSL_ERROR_NONE)
      drain_output(connection)
      local length = lengths[0] as integer
      if length > 0 then return bytes_string(buffer, length) end
    else
      local code = ffi.SSL_get_error(connection.handle, result) as integer
      local failure = operation_error(connection, code, "ssl.read")
      retry_owner(connection, owner, code)
      -- Peer EOF stops write admission before any output network wait.
      if code == ffi.SSL_ERROR_ZERO_RETURN then
        if connection.state == STATE_WRITE_SHUTDOWN then
          connection.state = STATE_SHUTDOWN
        else
          connection.state = STATE_PEER_CLOSED
        end
        wake_progress(connection)
      end
      local drained = drain_step(connection, code, failure)
      if code == ffi.SSL_ERROR_ZERO_RETURN then
        while connection.writer ~= nil and connection.writer.engine_live do
          wait_progress(connection, owner)
        end
        do
          send_shutdown_locked(connection, owner)
        catch
          local shutdown_failure = error
          -- Receipt of close_notify is authenticated EOF. If our reciprocal
          -- alert was written and only the TCP half-close failed because the
          -- peer had already closed, preserve that clean EOF result. Do not
          -- hide cancellation or another transport failure merely because the
          -- TLS state reached SHUTDOWN before net.shutdown reported it.
          if not (connection.state == STATE_SHUTDOWN and
                  shutdown_failure is async.OperationError and
                  (shutdown_failure as async.OperationError).name == "ENOTCONN" and
                  (shutdown_failure as async.OperationError).operation ==
                    "net.shutdown") then
            raise shutdown_failure
          end
        end
        return nil
      elseif not want_retry(connection, owner, code, "ssl.read", drained) then
        raise failure
      end
    end
  end
  return nil
end

local function write_piece_locked(connection: Connection, owner: Operation, piece: string)
  local bytes = piece as foreign const *char
  while true do
    engine_gate(connection, owner)
    local lengths = foreign size_t.new_array(1)
    lengths[0] = 0 as foreign size_t
    ffi.ERR_clear_error()
    local result = ffi.SSL_write_ex(
        connection.handle, bytes,
        #piece as foreign size_t, lengths)
    if result == 1 then
      retry_owner(connection, owner, ffi.SSL_ERROR_NONE)
      if (lengths[0] as integer) ~= #piece then
        raise Error {
          code = 0,
          name = "TLS_PARTIAL_WRITE",
          message = "OpenSSL accepted only part of a TLS write",
          operation = "ssl.write",
        }
      end
      drain_output(connection)
      return
    end

    -- Keep `piece`, its pointer, and its exact length unchanged across retry.
    local code = ffi.SSL_get_error(connection.handle, result) as integer
    retry_owner(connection, owner, code)
    local failure = operation_error(connection, code, "ssl.write")
    local drained = drain_step(connection, code, failure)
    if not want_retry(connection, owner, code, "ssl.write", drained) then
      raise failure
    end
  end
end

local function write_locked(connection: Connection, owner: Operation, data: string)
  require_engine(connection, "ssl.write")
  if connection.state == STATE_WRITE_SHUTDOWN or
     connection.state == STATE_SHUTDOWN or
     connection.state == STATE_PEER_CLOSED then
    raise "ssl.write: SSL Connection is shutting down"
  end
  handshake_locked(connection, owner)

  local offset = 1
  while offset <= #data do
    local last = offset + TLS_RECORD_BYTES - 1
    if last > #data then last = #data end
    local piece = string.sub(data, offset, last)
    write_piece_locked(connection, owner, piece)
    offset = last + 1
  end
end

local function new_connection(transport: net.Connection,
                              context: foreign *SSL_CTX,
                              client: boolean): Connection
  ffi.ERR_clear_error()
  local handle = ffi.SSL_new(context)
  if not handle then
    raise openssl_error("ssl.connection.new",
                        "failed to allocate an SSL object")
  end

  ffi.ERR_clear_error()
  local input = ffi.BIO_new(ffi.BIO_s_mem())
  if not input then
    ffi.SSL_free(handle)
    raise openssl_error("ssl.input.new",
                        "failed to allocate the TLS input BIO")
  end
  ffi.ERR_clear_error()
  local output = ffi.BIO_new(ffi.BIO_s_mem())
  if not output then
    ffi.BIO_free(input)
    ffi.SSL_free(handle)
    raise openssl_error("ssl.output.new",
                        "failed to allocate the TLS output BIO")
  end

  set_memory_bio_eof_return(input, -1)
  ffi.SSL_set0_rbio(handle, input)
  ffi.SSL_set0_wbio(handle, output)
  if client then
    ffi.SSL_set_connect_state(handle)
  else
    ffi.SSL_set_accept_state(handle)
  end
  return Connection {
    transport = transport,
    handle = handle,
    input = input,
    output = output,
    client = client,
    state = STATE_HANDSHAKING,
    reader = nil, writer = nil, control = nil,
    handshaker = nil, feeder = nil, retry = nil,
    cleanup_waiters = {}, scope_waiters = {},
    transport_eof = false,
    transport_shutdown = false,
    transport_closed = false,
    excess = "",
  }
end

-- SSL_CTX_set_min_proto_version is a public function-like macro unavailable
-- to the FFI. This direct SSL_CTX_ctrl expansion applies its documented TLS
-- version control without a C wrapper.
local function configure_context(context: foreign *SSL_CTX,
                                 operation: string)
  ffi.ERR_clear_error()
  if ffi.SSL_CTX_ctrl(context,
      ffi.SSL_CTRL_SET_MIN_PROTO_VERSION,
      ffi.TLS1_2_VERSION as foreign long, nil) ~= 1 then
    raise openssl_error(operation,
                        "failed to require TLS 1.2 or newer")
  end
end

local function new_client_context(): foreign *SSL_CTX
  ffi.ERR_clear_error()
  local context = ffi.SSL_CTX_new(ffi.TLS_client_method())
  if not context then
    raise openssl_error("ssl.client.context",
                        "failed to allocate a client SSL context")
  end
  do
    configure_context(context, "ssl.client.minimum-version")
    ffi.SSL_CTX_set_verify(context, ffi.SSL_VERIFY_PEER, nil)
  catch
    local failure = error
    ffi.SSL_CTX_free(context)
    raise failure
  end
  return context
end

local function pem_memory_bio(data: string,
                              operation: string): foreign *BIO
  if #data > MAX_PEM_BYTES then
    raise Error {
      code = 0,
      name = "PEM_TOO_LARGE",
      message = "PEM data is too large for OpenSSL",
      operation = operation,
    }
  end

  local source = data as foreign const *char
  ffi.ERR_clear_error()
  local bio = ffi.BIO_new_mem_buf(
      source as foreign const *void,
      #data as foreign int)
  if not bio then
    raise openssl_error(operation,
                        "failed to allocate a PEM memory BIO")
  end
  return bio
end

-- OPENSSL_free is a public function-like macro unavailable to Titan's FFI.
-- CRYPTO_free is its exported primitive; nil and zero are valid source
-- attribution because Titan is not using OpenSSL's allocation diagnostics.
local function openssl_free(pointer: foreign *void)
  if pointer then
    ffi.CRYPTO_free(pointer, nil, 0)
  end
end

local function free_pem_buffers(name: foreign *void,
                                header: foreign *void,
                                data: foreign *void)
  openssl_free(name)
  openssl_free(header)
  openssl_free(data)
end

local function free_pem_block(block: PemBlock)
  free_pem_buffers(block.name_buffer, block.header_buffer,
                   block.data_buffer)
end

-- ERR_GET_LIB and ERR_GET_REASON are inline header helpers without exported
-- symbols. This is their public non-system error bit extraction; PEM parser
-- EOF is never a system error.
local function pem_no_start_line(packed: integer): boolean
  local library =
    (packed >> (ffi.ERR_LIB_OFFSET as integer)) &
    (ffi.ERR_LIB_MASK as integer)
  local reason = packed & (ffi.ERR_REASON_MASK as integer)
  return library == (ffi.ERR_LIB_PEM as integer) and
         reason == (ffi.PEM_R_NO_START_LINE as integer)
end

local function read_pem_block(bio: foreign *BIO,
                              operation: string): PemBlock?
  local names = foreign VoidPointer.new_array(1)
  local headers = foreign VoidPointer.new_array(1)
  local data = foreign VoidPointer.new_array(1)
  local lengths = foreign long.new_array(1)
  names[0] = nil
  headers[0] = nil
  data[0] = nil
  lengths[0] = 0 as foreign long

  ffi.ERR_clear_error()
  local result = ffi.PEM_read_bio(
      bio,
      names as foreign *(*char),
      headers as foreign *(*char),
      data as foreign *(*unsigned char),
      lengths)
  if result ~= 1 then
    local packed = ffi.ERR_peek_last_error() as integer
    free_pem_buffers(names[0], headers[0], data[0])
    if packed ~= 0 and pem_no_start_line(packed) then
      ffi.ERR_clear_error()
      return nil
    end
    raise openssl_error(operation, "failed to parse PEM data")
  end

  if not names[0] or not headers[0] or not data[0] or lengths[0] < 0 then
    free_pem_buffers(names[0], headers[0], data[0])
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "OpenSSL returned an invalid PEM block",
      operation = operation,
    }
  end
  do
    local name = (names[0] as foreign *char) as string
    local header = (headers[0] as foreign *char) as string
    return PemBlock {
      name_buffer = names[0],
      header_buffer = headers[0],
      data_buffer = data[0],
      name = name,
      header = header,
      length = lengths[0] as integer,
    }
  catch
    local failure = error
    free_pem_buffers(names[0], headers[0], data[0])
    raise failure
  end
end

local function certificate_pem_name(name: string): boolean
  return name == "CERTIFICATE" or name == "X509 CERTIFICATE" or
         name == "TRUSTED CERTIFICATE"
end

local function private_key_pem_name(name: string): boolean
  return name == "PRIVATE KEY" or name == "RSA PRIVATE KEY" or
         name == "DSA PRIVATE KEY" or name == "EC PRIVATE KEY"
end

local function decode_certificate(block: PemBlock,
                                  operation: string): foreign *X509
  local cursors = foreign VoidPointer.new_array(1)
  cursors[0] = block.data_buffer
  ffi.ERR_clear_error()
  local certificate: foreign *X509 = nil
  if block.name == "TRUSTED CERTIFICATE" then
    certificate = ffi.d2i_X509_AUX(
        nil, cursors as foreign *(const *unsigned char),
        block.length as foreign long)
  else
    certificate = ffi.d2i_X509(
        nil, cursors as foreign *(const *unsigned char),
        block.length as foreign long)
  end
  if not certificate then
    raise openssl_error(operation, "failed to decode a PEM certificate")
  end
  local expected =
    (block.data_buffer as foreign const *unsigned char) + block.length
  if (cursors[0] as foreign const *unsigned char) ~= expected then
    ffi.X509_free(certificate)
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "certificate PEM block has trailing DER data",
      operation = operation,
    }
  end
  return certificate
end

local function decode_private_key(block: PemBlock): foreign *EVP_PKEY
  if #block.header > 0 then
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "encrypted private keys are not supported",
      operation = "ssl.server.private-key",
    }
  end
  local cursors = foreign VoidPointer.new_array(1)
  cursors[0] = block.data_buffer
  ffi.ERR_clear_error()
  local private_key = ffi.d2i_AutoPrivateKey(
      nil, cursors as foreign *(const *unsigned char),
      block.length as foreign long)
  if not private_key then
    raise openssl_error("ssl.server.private-key",
                        "failed to decode a PEM private key")
  end
  local expected =
    (block.data_buffer as foreign const *unsigned char) + block.length
  if (cursors[0] as foreign const *unsigned char) ~= expected then
    ffi.EVP_PKEY_free(private_key)
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "private-key PEM block has trailing DER data",
      operation = "ssl.server.private-key",
    }
  end
  return private_key
end

local function decode_certificate_block(
    block: PemBlock, operation: string): foreign *X509
  defer free_pem_block(block)
  return decode_certificate(block, operation)
end

local function decode_private_key_block(
    block: PemBlock): foreign *EVP_PKEY
  defer free_pem_block(block)
  return decode_private_key(block)
end

local function next_certificate(bio: foreign *BIO,
                                operation: string): CertificateResult
  while true do
    local block? = read_pem_block(bio, operation)
    if not block then return CertificateResult { pointer = nil, found = false } end
    local exact = block as PemBlock
    if certificate_pem_name(exact.name) then
      return CertificateResult {
        pointer = decode_certificate_block(exact, operation),
        found = true,
      }
    end
    free_pem_block(exact)
  end
  return CertificateResult { pointer = nil, found = false }
end

local function next_private_key(
    bio: foreign *BIO): PrivateKeyResult
  while true do
    local block? = read_pem_block(bio, "ssl.server.private-key")
    if not block then return PrivateKeyResult { pointer = nil, found = false } end
    local exact = block as PemBlock
    if exact.name == "ENCRYPTED PRIVATE KEY" then
      free_pem_block(exact)
      raise Error {
        code = 0,
        name = "OPENSSL",
        message = "encrypted private keys are not supported",
        operation = "ssl.server.private-key",
      }
    elseif private_key_pem_name(exact.name) then
      return PrivateKeyResult { pointer = decode_private_key_block(exact), found = true }
    end
    free_pem_block(exact)
  end
  return PrivateKeyResult { pointer = nil, found = false }
end

local function load_ca_certificates(context: foreign *SSL_CTX,
                                    data: string)
  local bio = pem_memory_bio(data, "ssl.client.trust")
  defer ffi.BIO_free(bio)
  local store = ffi.SSL_CTX_get_cert_store(context)
  if not store then
    raise openssl_error("ssl.client.trust",
                        "failed to access the certificate store")
  end

  local certificates = 0
  while true do
    local next_result = next_certificate(bio, "ssl.client.trust")
    if not next_result.found then break end
    local certificate = next_result.pointer
    do
      ffi.ERR_clear_error()
      if ffi.X509_STORE_add_cert(
          store, certificate) ~= 1 then
        raise openssl_error("ssl.client.trust",
                            "failed to add a CA certificate")
      end
    catch
      local failure = error
      ffi.X509_free(certificate)
      raise failure
    end
    -- X509_STORE_add_cert retains its own reference.
    ffi.X509_free(certificate)
    certificates = certificates + 1
  end
  if certificates == 0 then
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "PEM data contains no certificates",
      operation = "ssl.client.trust",
    }
  end
end

local function explicit_client_context(data: string): foreign *SSL_CTX
  local context = new_client_context()
  do
    load_ca_certificates(context, data)
  catch
    local failure = async.Error(error, traceback)
    ffi.SSL_CTX_free(context)
    failure:raise()
    raise "saved TLS trust failure unexpectedly returned"
  end
  return context
end

local function acquire_default_client_context(): foreign *SSL_CTX
  local context = default_client_context
  if not context then
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "default trust context is unavailable",
      operation = "ssl.client.trust",
    }
  end
  ffi.ERR_clear_error()
  if ffi.SSL_CTX_up_ref(context) ~= 1 then
    raise openssl_error("ssl.client.context",
                        "failed to retain the default client SSL context")
  end
  return context
end

-- SSL_CTX_add1_chain_cert is a public function-like macro, which the Titan
-- FFI cannot call directly. SSL_CTX_ctrl with SSL_CTRL_CHAIN_CERT and arg 1
-- is its documented expansion and makes the context retain each chain cert.
local function load_certificate_chain(context: foreign *SSL_CTX,
                                      data: string)
  local bio = pem_memory_bio(data, "ssl.server.certificate")
  defer ffi.BIO_free(bio)
  local certificates = 0
  while true do
    local next_result = next_certificate(bio, "ssl.server.certificate")
    if not next_result.found then break end
    local certificate = next_result.pointer
    do
      ffi.ERR_clear_error()
      if certificates == 0 then
        if ffi.SSL_CTX_use_certificate(context, certificate) ~= 1 then
          raise openssl_error("ssl.server.certificate",
                              "failed to load the server certificate")
        end
      elseif ffi.SSL_CTX_ctrl(
          context, ffi.SSL_CTRL_CHAIN_CERT, 1,
          certificate as foreign *void) ~= 1 then
        raise openssl_error("ssl.server.certificate",
                            "failed to load the certificate chain")
      end
    catch
      local failure = error
      ffi.X509_free(certificate)
      raise failure
    end
    -- Both SSL_CTX_use_certificate and the add1-chain control retain their
    -- own references before Titan releases the decoded certificate.
    ffi.X509_free(certificate)
    certificates = certificates + 1
  end
  if certificates == 0 then
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "PEM data contains no certificates",
      operation = "ssl.server.certificate",
    }
  end
end

local function load_private_key(context: foreign *SSL_CTX, data: string)
  local bio = pem_memory_bio(data, "ssl.server.private-key")
  defer ffi.BIO_free(bio)
  local next_result = next_private_key(bio)
  if not next_result.found then
    raise Error {
      code = 0,
      name = "OPENSSL",
      message = "PEM data contains no unencrypted private key",
      operation = "ssl.server.private-key",
    }
  end
  local private_key = next_result.pointer
  do
    -- Continue through the file before retaining the selected key so a valid
    -- first block cannot hide malformed trailing PEM input.
    while true do
      local trailing = next_private_key(bio)
      if not trailing.found then break end
      ffi.EVP_PKEY_free(trailing.pointer)
    end
    ffi.ERR_clear_error()
    if ffi.SSL_CTX_use_PrivateKey(
        context, private_key) ~= 1 then
      raise openssl_error("ssl.server.private-key",
                          "failed to load the private key")
    end
  catch
    local failure = error
    ffi.EVP_PKEY_free(private_key)
    raise failure
  end
  -- SSL_CTX_use_PrivateKey retains its own reference.
  ffi.EVP_PKEY_free(private_key)
end

local function server_context(certificate_data: string,
                              private_key_data: string): foreign *SSL_CTX
  ffi.ERR_clear_error()
  local context = ffi.SSL_CTX_new(ffi.TLS_server_method())
  if not context then
    raise openssl_error("ssl.server.context",
                        "failed to allocate a server SSL context")
  end
  do
    configure_context(context, "ssl.server.minimum-version")
    load_certificate_chain(context, certificate_data)
    load_private_key(context, private_key_data)
    ffi.ERR_clear_error()
    if ffi.SSL_CTX_check_private_key(context) ~= 1 then
      raise openssl_error("ssl.server.private-key",
                          "private key does not match the certificate")
    end
  catch
    local failure = error
    ffi.SSL_CTX_free(context)
    raise failure
  end
  return context
end

-- SSL_set_tlsext_host_name is a public function-like macro unavailable to the
-- FFI. SSL_ctrl with SSL_CTRL_SET_TLSEXT_HOSTNAME is its documented primitive
-- expansion. OpenSSL consumes the mutable NUL-terminated copy during the call.
local function configure_server_name(handle: foreign *SSL, host: string)
  local server_name = foreign char.new_array(#host + 1)
  ffi.memcpy(server_name,
                 host as foreign const *char,
                 #host as foreign size_t)
  server_name[#host] = 0 as foreign char
  ffi.ERR_clear_error()
  if ffi.SSL_ctrl(
      handle, ffi.SSL_CTRL_SET_TLSEXT_HOSTNAME,
      ffi.TLSEXT_NAMETYPE_host_name as foreign long,
      server_name as foreign *void) ~= 1 then
    raise openssl_error("ssl.connect.sni",
                        "failed to configure TLS server name indication")
  end
end

local function client_context(ca_file: string?): foreign *SSL_CTX
  if ca_file ~= nil then return explicit_client_context(fs.read_file(ca_file)) end
  return acquire_default_client_context()
end

local function configure_client(connection: Connection, host: string)
    ffi.ERR_clear_error()
    local parameters = ffi.SSL_get0_param(connection.handle)
    if not parameters then
      raise openssl_error("ssl.connect.verify-host",
                          "failed to access peer verification parameters")
    end
    ffi.ERR_clear_error()
    local identity = verification_host(host)
    local ip_identity = ffi.X509_VERIFY_PARAM_set1_ip_asc(
        parameters, identity) == 1
    if not ip_identity then
      -- A failed IP parse is the ordinary DNS-name branch, not the error
      -- context for SSL_set1_host.
      ffi.ERR_clear_error()
      if ffi.SSL_set1_host(connection.handle, host) ~= 1 then
        raise openssl_error("ssl.connect.verify-host",
                            "failed to configure peer-name verification")
      end
    end
    ffi.SSL_set_hostflags(
        connection.handle,
        ffi.X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS as
          foreign unsigned int)
    if not ip_identity then
      configure_server_name(connection.handle, host)
    end
end

local function adopt_client(transport: net.Connection, context: foreign *SSL_CTX,
                            host: string): Connection
  local connection: Connection? = nil
  do
    connection = new_connection(transport, context, true)
    configure_client(connection, host)
    return connection
  catch
    local failure = async.Error(error, traceback)
    if connection ~= nil then free_engine(connection) end
    do transport:close() catch end
    failure:raise()
    raise "saved TLS adoption failure unexpectedly returned"
  end
end

--- Adopt a TCP transport with verified client TLS configured for the original hostname.
-- @param transport TCP transport whose ownership transfers to the TLS connection.
-- @param host Connection hostname, numeric IP, or local bind address.
-- @param ca_file Optional PEM trust bundle replacing the default trust roots.
-- @return Lazy verified client TLS state owning the adopted TCP transport.
-- @usage standard-library-ssl.md#verified-client-connections
function client(transport: net.Connection, host: string,
                ca_file: string?): Connection
  checked_text(host, "ssl.client.host")
  if #host == 0 then raise "ssl.client: host must not be empty" end
  if ca_file ~= nil then checked_text(ca_file, "ssl.client.ca-file") end
  -- Ownership transfers only after argument validation. Trust loading may
  -- suspend; the opening supervisor may retain TCP solely as abort authority.
  do
    local context = client_context(ca_file)
    defer ffi.SSL_CTX_free(context)
    return adopt_client(transport, context, host)
  catch
    local failure = async.Error(error, traceback)
    do transport:close() catch end
    failure:raise()
    raise "saved TLS trust failure unexpectedly returned"
  end
end

--- Connect TCP and complete a TLS handshake with certificate and hostname verification.
-- @param host Connection hostname, numeric IP, or local bind address.
-- @param port Numeric TCP port.
-- @param ca_file Optional PEM trust bundle replacing the default trust roots.
-- @return Verified TLS connection whose handshake is complete.
-- @usage standard-library-ssl.md#verified-client-connections
function connect(host: string, port: integer,
                 ca_file: string?): Connection
  checked_text(host, "ssl.connect.host")
  if ca_file ~= nil then checked_text(ca_file, "ssl.connect.ca-file") end
  -- Preserve existing validation/trust-before-dial order.
  local context = client_context(ca_file)
  defer ffi.SSL_CTX_free(context)
  local connection = adopt_client(net.connect(host, port), context, host)
  do
    connection:handshake()
    return connection
  catch
    local failure = async.Error(error, traceback)
    connection:abort()
    failure:raise()
    raise "saved TLS connection failure unexpectedly returned"
  end
end

--- Create a TLS listener from a PEM certificate chain and private key.
-- @param host Connection hostname, numeric IP, or local bind address.
-- @param port Numeric TCP port.
-- @param certificate_file PEM certificate-chain path, optionally including its private key.
-- @param private_key_file PEM private-key path; nil uses the certificate file.
-- @param backlog Positive listen backlog; nil defaults to 128.
-- @param reuse_port Permit independent listeners on the same address; nil or false disables it.
-- @return New TLS listener owning its certificate context and TCP listener.
-- @usage standard-library-ssl.md#server-connections-and-handshakes
function listen(host: string, port: integer, certificate_file: string,
                private_key_file: string?, backlog: integer?,
                reuse_port: boolean?): Server
  checked_text(host, "ssl.listen.host")
  checked_text(certificate_file, "ssl.listen.certificate")
  if #certificate_file == 0 then
    raise "ssl.listen: certificate file must not be empty"
  end
  local actual_private_key_file = certificate_file
  if private_key_file then
    actual_private_key_file = private_key_file as string
  end
  checked_text(actual_private_key_file, "ssl.listen.private-key")
  if #actual_private_key_file == 0 then
    raise "ssl.listen: private key file must not be empty"
  end

  local certificate_data = fs.read_file(certificate_file)
  local private_key_data = certificate_data
  if actual_private_key_file ~= certificate_file then
    private_key_data = fs.read_file(actual_private_key_file)
  end
  local context = server_context(certificate_data, private_key_data)
  do
    local listener = net.listen(host, port, backlog, reuse_port)
    return Server {
      listener = listener,
      context = context,
      closed = false,
      listener_closed = false,
    }
  catch
    local failure = error
    ffi.SSL_CTX_free(context)
    raise failure
  end
end

--- Complete the lazy TLS handshake before application I/O.
-- @usage standard-library-ssl.md#server-connections-and-handshakes
function Connection:handshake()
  local operation? = begin_operation(self, "handshake")
  if operation == nil then return end
  supervise(self, operation, function (): string?
    handshake_locked(self, operation)
    return nil
  end)
end

--- Query buffered plaintext/ciphertext or a state that is not fully open.
-- @return True for pending input or non-open state; a TLS control or partial record may still need I/O.
-- @usage standard-library-ssl.md#reading-and-writing
function Connection:has_pending_input(): boolean
  if self.state ~= STATE_OPEN then return true end
  return #self.excess > 0 or ffi.SSL_has_pending(self.handle) ~= 0 or
    ffi.BIO_ctrl_pending(self.input) > 0 or self.transport:has_pending_input()
end

--- Observe newly buffered TCP input or terminal receive events without processing TLS.
-- @param listener Nonyielding receive observer; encrypted data may be partial or control records.
-- @return Idempotent remover; does not drive reads or report already buffered TLS input.
-- @usage standard-library-ssl.md#reading-and-writing
function Connection:add_input_listener(listener: function (): ()): function (): ()
  if self.state ~= STATE_OPEN then raise "cannot observe input on a non-open TLS Connection" end
  return self.transport:add_input_listener(listener)
end

--- Read decrypted bytes, returning nil only after authenticated TLS shutdown.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-ssl.md#reading-and-writing
function Connection:read(): string?
  local operation? = begin_operation(self, "read")
  if operation == nil then return nil end
  return supervise(self, operation, function (): string?
    return read_locked(self, operation)
  end)
end

--- Read decrypted bytes through a delimiter, retaining the unused suffix.
-- @param delimiter Nonempty byte delimiter to include or remove.
-- @param chop Remove the delimiter when true; nil or false retains it.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-ssl.md#reading-and-writing
function Connection:read_until(delimiter: string, chop: boolean?): string?
  if #delimiter == 0 then raise "read delimiter must not be empty" end
  local operation? = begin_operation(self, "read")
  if operation == nil then return nil end
  return supervise(self, operation, function (): string?
    local builder = string.writer()
    local tail = ""
    while true do
      local chunk? = read_locked(self, operation)
      if not chunk then
        if #tail > 0 then builder:write(tail) end
        local result = builder:drain()
        if #result == 0 then return nil end
        return result
      end
      local bytes = chunk as string
      local boundary = bytes
      if #tail > 0 then boundary = tail .. bytes end
      local match: integer? = string.find(boundary, delimiter)
      if match then
        local match_first = match as integer
        local match_end = match_first + #delimiter - 1
        local result_end = match_end
        if chop then result_end = match_first - 1 end
        if result_end > 0 then
          builder:write(string.sub(boundary, 1, result_end))
        end
        self.excess = string.sub(boundary, match_end + 1)
        return builder:drain()
      end
      local keep = #delimiter - 1
      if keep > #boundary then keep = #boundary end
      local committed = #boundary - keep
      if committed > 0 then
        if committed == #boundary then
          builder:write(boundary)
        else
          builder:write(string.sub(boundary, 1, committed))
        end
      end
      tail = string.sub(boundary, committed + 1)
    end
    return nil
  end)
end

--- Write application bytes through TLS and wait for transport completion.
-- @param data Immutable binary bytes to write or decode.
-- @usage standard-library-ssl.md#reading-and-writing
function Connection:write(data: string)
  local operation? = begin_operation(self, "write")
  if operation == nil then raise "ssl.write: SSL Connection is closed" end
  supervise(self, operation, function (): string?
    write_locked(self, operation, data)
    return nil
  end)
end

--- Send close_notify and half-close TCP output while retaining the read side.
-- @usage standard-library-ssl.md#tls-shutdown-and-eof
function Connection:shutdown()
  local operation? = begin_operation(self, "shutdown")
  if operation == nil then return end
  supervise(self, operation, function (): string?
    send_shutdown_locked(self, operation)
    return nil
  end)
end

--- Abort the transport before draining active operations and retire TLS state.
-- @usage standard-library-ssl.md#tls-shutdown-and-eof
function Connection:abort()
  local reader? = self.reader
  local writer? = self.writer
  local control? = self.control
  terminate(self, false)
  if reader ~= nil and reader.child ~= nil then drain_child(reader.child) end
  if writer ~= nil and writer.child ~= nil then drain_child(writer.child) end
  if control ~= nil and control.child ~= nil then drain_child(control.child) end
end

--- Best-effort perform exclusive TLS shutdown and retire the TCP transport.
-- @usage standard-library-ssl.md#tls-shutdown-and-eof
function Connection:close()
  if self.state == STATE_CLOSED or self.state == STATE_FAILED then return end
  local operation? = begin_operation(self, "close")
  if operation == nil then return end
  supervise(self, operation, function (): string?
    if self.state ~= STATE_HANDSHAKING then
      do
        send_shutdown_locked(self, operation)
      catch
        if not (error is async.OperationError and
                (error as async.OperationError).name == "ENOTCONN" and
                (error as async.OperationError).operation == "net.shutdown") then
          raise error
        end
      end
    end
    retire_scope(self, operation)
    terminate(self, true)
    return nil
  end)
end

--- Accept TCP and return a TLS connection whose handshake is still lazy.
-- @return Accepted TLS connection with a lazy handshake.
-- @usage standard-library-ssl.md#server-connections-and-handshakes
function Server:accept(): Connection
  if self.closed or not self.context then
    raise "ssl.accept: Server is closed"
  end
  local context = self.context
  ffi.ERR_clear_error()
  if ffi.SSL_CTX_up_ref(context) ~= 1 then
    raise openssl_error("ssl.accept.context",
                        "failed to retain the server SSL context")
  end
  defer ffi.SSL_CTX_free(context)
  local transport = self.listener:accept()
  do
    -- The TLS handshake is deliberately lazy so a slow ClientHello cannot
    -- serialize the Server's accept loop. First I/O or handshake() drives it.
    return new_connection(transport, context, false)
  catch
    local failure = error
    do
      transport:close()
    catch
    end
    raise failure
  end
end

--- Close this listener while leaving accepted connections independently owned.
-- @usage standard-library-ssl.md#server-connections-and-handshakes
function Server:close()
  if self.closed and self.listener_closed then return end
  if not self.closed then
    self.closed = true
    if self.context then ffi.SSL_CTX_free(self.context) end
    self.context = nil
  end
  if not self.listener_closed then
    self.listener:close()
    self.listener_closed = true
  end
end

do
  -- This is the only eager filesystem-backed OpenSSL trust operation. It runs
  -- once per loaded ssl module, honors SSL_CERT_FILE/SSL_CERT_DIR, and leaves
  -- one shared, GC-finalized context reference for all default-trust
  -- connections. OpenSSL may still read a configured hashed CA directory
  -- lazily during the first verification that needs it; sharing the context
  -- caches and amortizes it.
  --
  -- Root the nil owner field before any OpenSSL allocation. The native context
  -- is transferred into it only after default trust succeeds, so every failure
  -- path retains one unambiguous cleanup owner.
  local owner = allocate_default_client_context_owner()
  local context = new_client_context()
  do
    ffi.ERR_clear_error()
    if ffi.SSL_CTX_set_default_verify_paths(context) ~= 1 then
      raise openssl_error("ssl.client.trust",
                          "failed to load default certificate trust roots")
    end
    owner.context = context
    default_client_context = context
  catch
    local failure = error
    ffi.SSL_CTX_free(context)
    raise failure
  end
end
