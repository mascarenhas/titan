local function check_no_nul(subject: string, operation: string)
  local position? = string.find(subject, "\0")
  if position ~= nil then
    raise Error {
      message = "embedded NUL is not permitted",
      code = nil,
      extended_code = nil,
      operation = operation
    }
  end
end

-- Titan strings are bytes. Accept canonical UTF-8 scalar encodings only;
-- SQL TEXT excludes embedded NUL, while Blob preserves arbitrary bytes.
local function valid_text(subject: string): boolean
  local index = 1
  while index <= #subject do
    local first: integer = string.byte(subject, index)
    if first == 0 then return false end
    if first < 128 then
      index = index + 1
    else
      local length = 0
      local lower = 128
      local upper = 191
      if first >= 194 and first <= 223 then
        length = 2
      elseif first >= 224 and first <= 239 then
        length = 3
        if first == 224 then lower = 160 end
        if first == 237 then upper = 159 end
      elseif first >= 240 and first <= 244 then
        length = 4
        if first == 240 then lower = 144 end
        if first == 244 then upper = 143 end
      else
        return false
      end
      if length > #subject - index + 1 then return false end
      local second: integer = string.byte(subject, index + 1)
      if second < lower or second > upper then return false end
      for offset = 2, length - 1 do
        local byte: integer = string.byte(subject, index + offset)
        if byte < 128 or byte > 191 then return false end
      end
      index = index + length
    end
  end
  return true
end

local function native_allocation_error(operation: string)
  raise Error {
    message = "out of memory allocating SQLite operation",
    code = ffi.SQLITE_NOMEM,
    extended_code = ffi.SQLITE_NOMEM,
    operation = operation
  }
end

local function copy_input(packet: foreign *TitanSqlitePacket,
                          input: string, operation: string)
  packet.input_length = #input
  packet.input = sqlite_copy_bytes(input, packet.input_length)
  if not packet.input then native_allocation_error(operation) end
end

local function copy_argument_bytes(cell: foreign *TitanSqliteCell,
                                   bytes: string, operation: string)
  cell.length = #bytes
  cell.bytes = sqlite_copy_bytes(bytes, cell.length)
  if not cell.bytes then native_allocation_error(operation) end
end

local function unsupported_argument(index: integer, kind: string,
                                    operation: string)
  raise Error {
    message = "argument " .. index .. " has unsupported kind " .. kind,
    code = nil,
    extended_code = nil,
    operation = operation
  }
end

local function bind_argument(cell: foreign *TitanSqliteCell,
                             candidate: value, index: integer,
                             operation: string)
  case reflect.inspect(candidate)
  when is_nil() then
    cell.kind = ffi.SQLITE_NULL
  when is_boolean(flag) then
    cell.kind = ffi.SQLITE_INTEGER
    if flag then cell.integer_value = 1 else cell.integer_value = 0 end
  when is_integer(number) then
    cell.kind = ffi.SQLITE_INTEGER
    cell.integer_value = number
  when is_float(number) then
    if number ~= number or number == math.huge or number == -math.huge then
      raise Error {
        message = "argument " .. index .. " must be finite",
        code = nil,
        extended_code = nil,
        operation = operation
      }
    end
    cell.kind = ffi.SQLITE_FLOAT
    cell.float_value = number
  when is_string(bytes) then
    if not valid_text(bytes) then
      raise Error {
        message = "argument " .. index ..
          " must be UTF-8 TEXT without NUL; use Blob for bytes",
        code = nil,
        extended_code = nil,
        operation = operation
      }
    end
    cell.kind = ffi.SQLITE_TEXT
    copy_argument_bytes(cell, bytes, operation)
  when is_record(inspected) then
    if inspected.value is Blob then
      local blob: Blob = inspected.value
      cell.kind = ffi.SQLITE_BLOB
      copy_argument_bytes(cell, blob.bytes, operation)
    else
      unsupported_argument(index, "record", operation)
    end
  when is_array() then unsupported_argument(index, "Array", operation)
  when is_const_array() then unsupported_argument(index, "const Array", operation)
  when is_map() then unsupported_argument(index, "Map", operation)
  when is_union() then unsupported_argument(index, "union", operation)
  when is_interface() then unsupported_argument(index, "Interface", operation)
  when is_titan_function() then unsupported_argument(index, "Titan function", operation)
  when is_lua_function() then unsupported_argument(index, "Lua function", operation)
  when is_lua_c_function() then unsupported_argument(index, "Lua C function", operation)
  when is_owned_foreign_pointer() then unsupported_argument(index, "owned pointer", operation)
  when is_owned_foreign_array() then unsupported_argument(index, "owned Array", operation)
  when is_lua_userdata() then unsupported_argument(index, "userdata", operation)
  when is_lua_thread() then unsupported_argument(index, "thread", operation)
  when is_raw_pointer() then unsupported_argument(index, "raw pointer", operation)
  end
end

local function Statement:bind(packet: foreign *TitanSqlitePacket,
                              operation: string, ...: value)
  if #... ~= self.parameter_count then
    raise Error {
      message = "expected " .. self.parameter_count .. " arguments, got " ..
        #...,
      code = nil,
      extended_code = nil,
      operation = operation
    }
  end
  packet.argument_count = #...
  if #... <= 0 then return end
  packet.arguments = ffi.calloc(#..., foreign TitanSqliteCell.sizeof)
  if not packet.arguments then native_allocation_error(operation) end
  -- Preserve the vararg run itself: an Array loses its trailing nil positions.
  for index = 1, #... do
    bind_argument(packet.arguments + (index - 1), ...[index], index, operation)
  end
end

local function copy_result_bytes(cell: foreign *TitanSqliteCell): string
  local bytes: owned char[] = foreign char.new_array(cell.length)
  if cell.length > 0 then ffi.memcpy(bytes, cell.bytes, cell.length) end
  return bytes as string
end

local function decode_columns(packet: foreign *TitanSqlitePacket): const {Column}
  local columns: {Column} = {}
  local count: integer = packet.column_count
  for index = 1, count do
    local native_column = packet.columns + (index - 1)
    local declared_type: string?
    if native_column.declared_type ~= nil then
      declared_type = native_column.declared_type as string
    end
    columns[index] = Column(native_column.name as string, declared_type)
  end
  return columns as const {Column}
end

local function decode_row(packet: foreign *TitanSqlitePacket,
                           columns: const {Column}): Row
  local cells: {value} = {}
  for index = 1, #columns do
    local cell = packet.cells + (index - 1)
    if cell.kind == ffi.SQLITE_INTEGER then
      local number: integer = cell.integer_value
      cells[index] = number
    elseif cell.kind == ffi.SQLITE_FLOAT then
      local number: float = cell.float_value
      cells[index] = number
    elseif cell.kind == ffi.SQLITE_TEXT then
      cells[index] = copy_result_bytes(cell)
    elseif cell.kind == ffi.SQLITE_BLOB then
      cells[index] = Blob(copy_result_bytes(cell))
    end
  end
  return Row(columns, cells as const {value})
end
