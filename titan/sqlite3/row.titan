-- Rows contain only copied Titan values. Their native execution can be gone
-- before get/fill runs, and NULL cells never determine the column count.
--- Binary SQLite cell bytes, distinct from a TEXT string.
-- @field bytes Copied binary BLOB bytes.
-- @usage standard-library-sqlite3.md#rows-and-mapping
record Blob
  const bytes: string
end

--- Immutable column name and optional declared SQL type.
-- @field name Received column name; duplicates are preserved.
-- @field declared_type Declared SQL type text, or nil for expressions without one.
-- @usage standard-library-sqlite3.md#rows-and-mapping
record Column
  const name: string
  const declared_type: string?
end

--- A copied result row whose cells survive cursor and connection cleanup.
-- @field columns Ordered immutable column metadata; its length includes SQL NULL cells.
-- @usage standard-library-sqlite3.md#rows-and-mapping
record Row
  const columns: const {Column}
  local const cells: const {value}
end

--- Return a cell at a one-based column index; SQL NULL becomes nil.
-- @param i One-based public field, part, or column ordinal.
-- @return Cell value; SQL NULL becomes nil and BLOB becomes Blob.
-- @usage standard-library-sqlite3.md#rows-and-mapping
function Row:get(i: integer): value
  if i < 1 or i > #self.columns then
    raise Error {
      message = "column index " .. i .. " out of bounds [1, " ..
        #self.columns .. "]",
      code = nil,
      extended_code = nil,
      operation = "row.get"
    }
  end
  return self.cells[i]
end

local function fill_type_supported(descriptor: reflect.Type): boolean
  case descriptor
  when is_nil() then return true
  when is_value() then return true
  when is_boolean() then return true
  when is_integer() then return true
  when is_float() then return true
  when is_string() then return true
  when is_option(inner) then return fill_type_supported(inner)
  when is_named(named) then return named.name == "titan.sqlite3.Blob"
  when is_record(record_type) then
    return record_type.name == "titan.sqlite3.Blob"
  end
  return false
end

local function fill_value(cell: value, descriptor: reflect.Type,
                          name: string): value
  case descriptor
  when is_value() then return cell
  when is_nil() then
    if cell == nil then return nil end
  when is_option(inner) then
    if cell == nil then return nil end
    return fill_value(cell, inner, name)
  when is_boolean() then
    case reflect.inspect(cell)
    when is_integer(number) then
      if number == 0 then return false end
      if number == 1 then return true end
    end
    raise Error {
      message = "field " .. name .. " requires SQL integer 0 or 1",
      code = nil,
      extended_code = nil,
      operation = "row.fill"
    }
  when is_integer() then
    if cell ~= nil then return cell end
  when is_float() then
    if cell ~= nil then return cell end
  when is_string() then
    if cell is string then return cell end
  when is_named() then
    if cell is Blob then return cell end
  when is_record() then
    if cell is Blob then return cell end
  end
  raise Error {
    message = "incompatible SQL value for field " .. name,
    code = nil,
    extended_code = nil,
    operation = "row.fill"
  }
end

local function Row:fill_field(target: reflect.RecordValue, ordinal: integer,
                             column: integer)
  const field = target.type.fields[ordinal]
  const cell = fill_value(self:get(column), field.type, field.name)
  target:set(ordinal, cell)
catch
  if error is Error then raise end
  raise Error {
    message = "field " .. target.type.fields[ordinal].name ..
      ": " .. string.tostring(error),
    code = nil,
    extended_code = nil,
    operation = "row.fill"
  }
end

--- Fill an existing mutable record from matching public column names.
-- @param target Mutable record with public fields matching all column names.
-- @usage standard-library-sqlite3.md#rows-and-mapping
function Row:fill(target: value)
  const inspected = reflect.inspect(target)
  case inspected
  when is_record(record_value) then
    const positions: {string: integer} = {}
    for index = 1, #self.columns do
      const name = self.columns[index].name
      if positions[name] ~= nil then
        raise Error {
          message = "duplicate column name " .. name,
          code = nil,
          extended_code = nil,
          operation = "row.fill"
        }
      end
      positions[name] = index
    end
    if record_value.n_fields ~= #self.columns then
      raise Error {
        message = "column names must match every public record field",
        code = nil,
        extended_code = nil,
        operation = "row.fill"
      }
    end
    -- Validate the whole shape before the first write. Value conversions are
    -- deliberately in public descriptor order and may leave prior writes.
    for ordinal = 1, record_value.n_fields do
      const field = record_value.type.fields[ordinal]
      if positions[field.name] == nil then
        raise Error {
          message = "missing column for field " .. field.name,
          code = nil,
          extended_code = nil,
          operation = "row.fill"
        }
      end
      if field.is_const then
        raise Error {
          message = "cannot fill const field " .. field.name,
          code = nil,
          extended_code = nil,
          operation = "row.fill"
        }
      end
      if not fill_type_supported(field.type) then
        raise Error {
          message = "unsupported field type for " .. field.name,
          code = nil,
          extended_code = nil,
          operation = "row.fill"
        }
      end
    end
    for ordinal = 1, record_value.n_fields do
      self:fill_field(record_value, ordinal,
                      positions[record_value.type.fields[ordinal].name])
    end
  else
    raise Error {
      message = "row.fill requires a record",
      code = nil,
      extended_code = nil,
      operation = "row.fill"
    }
  end
end
