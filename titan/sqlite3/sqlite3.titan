--- Task-aware SQLite connections, prepared statements, streamed results, and transactions.
-- @module titan.sqlite3
-- @usage standard-library-sqlite3.md

local async = import "async"
local uv = import "uv"
local reflect = import "reflect"
local string = import "string"
local math = import "math"

--- A SQLite validation or native-operation failure with optional SQLite result codes.
-- @field message Human-readable failure description.
-- @field code Primary native result code, or nil when no native code is available.
-- @field extended_code Extended SQLite result code, or nil for a nonnative validation failure.
-- @field operation Operation that reported the failure.
-- @usage standard-library-sqlite3.md#errors-and-cancellation
record Error
  const message: string
  const code: integer?
  const extended_code: integer?
  const operation: string
end

--- An owned SQLite database connection with serialized native work.
-- @usage standard-library-sqlite3.md#connections-and-statement-lifetime
record Connection
  local handle: foreign *sqlite3
  local statements: integer
  local busy: boolean
  local active_statement: Statement?
end

--- A reusable prepared SQL statement owned by one connection.
-- @usage standard-library-sqlite3.md#connections-and-statement-lifetime
record Statement
  local const connection: Connection
  local handle: foreign *sqlite3_stmt
  local parameter_count: integer
end

--- One streamed statement execution with immutable column metadata.
-- @field columns Ordered immutable column metadata; its length includes SQL NULL cells.
-- @usage standard-library-sqlite3.md#executing-and-querying
record Cursor
  const columns: const {Column}
  local const statement: Statement
  local pending: Row?
  local exhausted: boolean
  local closed: boolean
end

local function check_result(packet: foreign *TitanSqlitePacket,
                             operation: string)
  if packet.failed == 0 then return end
  local message = "SQLite operation failed"
  if packet.message ~= nil then
    message = packet.message as string
  elseif packet.fallback_message ~= nil then
    message = packet.fallback_message as string
  end
  if packet.cleanup_code ~= 0 then
    message = message .. "; cleanup: "
    if packet.cleanup_message ~= nil then
      message = message .. (packet.cleanup_message as string)
    else
      message = message .. "SQLite code " .. (packet.cleanup_code as integer)
    end
  end
  local code: integer?, extended_code: integer? =
    (function (packet: foreign *TitanSqlitePacket): (integer?, integer?)
      if packet.code ~= 0 then return packet.code, packet.extended_code end
      return nil, nil
    end)(packet)
  raise Error {
    message = message,
    code = code,
    extended_code = extended_code,
    operation = operation
  }
end

-- Cleanup work must finish even when its caller is already cancelled. The
-- public request retains the packet until its terminal callback has returned.
local record CleanupWork
  local request: uv.work_t
  local worker: foreign function (*void): void
  local packet: owned *TitanSqlitePacket
  local done: async.Completion<|CleanupWork, nil, integer|>?
  local number: integer
end

local function cleanup_completed(request: uv.work_t, status: integer)
  local work: CleanupWork = request:get_data()
  local done = work.done as async.Completion<|CleanupWork, nil, integer|>
  local number = work.number
  request:set_data(nil)
  work.done = nil
  do
    if status ~= 0 then done:reject(number, status)
    else done:resolve(number, nil) end
  catch done:fatal(number, error, traceback); raise end
end

local function start_cleanup(done: async.Completion<|CleanupWork, nil, integer|>, number: integer): uv.req_t?
  local work = done:context(number)
  work.done = done
  work.number = number
  work.request:set_data(work)
  local status = uv.queue_work(async.current_loop(), work.request,
      work.worker, work.packet, cleanup_completed, work.packet)
  if status ~= 0 then
    work.request:set_data(nil)
    work.done = nil
    done:reject(number, status)
  end
  return nil
end

local function run_foreign_cleanup(worker: foreign function (*void): void,
                                    packet: owned *TitanSqlitePacket)
  local work = CleanupWork(uv.work_t(), worker, packet, nil, 0)
  local result = async.await_cleanup_with<|CleanupWork, nil, integer|>(work, start_cleanup)
  case result
  when error(status) then
    raise async.OperationError(status, uv.err_name(status), uv.strerror(status),
                               "async.run_foreign")
  else
  end
end

-- A packet is rooted by its suspended caller and this lexical cleanup. Raw
-- pointers passed to run_foreign alone do not retain their pointees. SQLite
-- resource retirement remains on a worker even during cancellation unwind.
local function retire_packet(packet: owned *TitanSqlitePacket)
  if packet.owns_db ~= 0 or packet.owns_stmt ~= 0 or packet.needs_reset ~= 0 then
    run_foreign_cleanup(sqlite_retire_worker, packet)
  end
end

local function Connection:reserve(operation: string, allow_cursor: boolean)
  if not self.handle then
    raise Error {
      message = "connection is closed",
      code = nil,
      extended_code = nil,
      operation = operation
    }
  end
  if self.busy then
    raise Error {
      message = "connection has an outstanding operation",
      code = nil,
      extended_code = nil,
      operation = operation
    }
  end
  if not allow_cursor and self.active_statement ~= nil then
    raise Error {
      message = "connection has an active cursor",
      code = nil,
      extended_code = nil,
      operation = operation
    }
  end
  self.busy = true
end

local function Statement:require_open(operation: string)
  if not self.handle then
    raise Error {
      message = "statement is closed",
      code = nil,
      extended_code = nil,
      operation = operation
    }
  end
end

--- Open a SQLite database, including the special :memory: database.
-- @param name Database filename, URI, or :memory:.
-- @return Owned database connection.
-- @usage standard-library-sqlite3.md#connections-and-statement-lifetime
function connect(name: string): Connection
  check_no_nul(name, "connect")
  -- Allocate the public shell before acquiring the native handle.
  local connection = Connection {
    handle = nil,
    statements = 0,
    busy = false,
    active_statement = nil
  }
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  defer retire_packet(packet)
  copy_input(packet, name, "connect")
  async.run_foreign(sqlite_open_worker, packet)
  check_result(packet, "connect")
  connection.handle = packet.db
  packet.owns_db = 0
  return connection
end

--- Compile one SQL statement for repeated binding and execution.
-- @param sql One SQL statement to prepare.
-- @return Reusable prepared statement; close it before closing the connection.
-- @usage standard-library-sqlite3.md#connections-and-statement-lifetime
function Connection:prepare(sql: string): Statement
  self:reserve("prepare", true)
  defer self.busy = false
  check_no_nul(sql, "prepare")
  local statement = Statement { connection = self, handle = nil, parameter_count = 0 }
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  defer retire_packet(packet)
  packet.db = self.handle
  copy_input(packet, sql, "prepare")
  async.run_foreign(sqlite_prepare_worker, packet)
  check_result(packet, "prepare")
  statement.parameter_count = packet.parameter_count
  statement.handle = packet.stmt
  self.statements = self.statements + 1
  packet.owns_stmt = 0
  return statement
end

--- Close a database connection after its statements are released.
-- @usage standard-library-sqlite3.md#connections-and-statement-lifetime
function Connection:close()
  if not self.handle then return end
  self:reserve("close", false)
  defer self.busy = false
  if self.statements ~= 0 then
    raise Error {
      message = "connection owns open statements",
      code = nil,
      extended_code = nil,
      operation = "close"
    }
  end
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  packet.db = self.handle
  -- A failed submission leaves the public owner open and available for retry.
  defer do
    if packet.db == nil then self.handle = nil end
  end
  run_foreign_cleanup(sqlite_close_worker, packet)
  check_result(packet, "close")
end

--- Finalize this statement after its active cursor is released.
-- @usage standard-library-sqlite3.md#connections-and-statement-lifetime
function Statement:close()
  if not self.handle then return end
  self.connection:reserve("statement.close", true)
  defer self.connection.busy = false
  if self.connection.active_statement == self then
    raise Error {
      message = "statement has an active cursor",
      code = nil,
      extended_code = nil,
      operation = "statement.close"
    }
  end
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  packet.db = self.connection.handle
  packet.stmt = self.handle
  defer do
    if packet.stmt == nil then
      self.handle = nil
      self.connection.statements = self.connection.statements - 1
    end
  end
  run_foreign_cleanup(sqlite_finalize_worker, packet)
  check_result(packet, "statement.close")
end

local function Connection:transaction(worker: foreign function (*void): void,
                                      operation: string)
  self:reserve(operation, false)
  defer self.busy = false
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  packet.db = self.handle
  async.run_foreign(worker, packet)
  check_result(packet, operation)
end

--- Commit an active transaction, or do nothing in autocommit mode.
-- @usage standard-library-sqlite3.md#transactions
function Connection:commit()
  self:transaction(sqlite_commit_worker, "commit")
end

--- Roll back an active transaction, or do nothing in autocommit mode.
-- @usage standard-library-sqlite3.md#transactions
function Connection:rollback()
  self:transaction(sqlite_rollback_worker, "rollback")
end

--- Read SQLite's actual transaction state.
-- @return True when SQLite is outside an explicit transaction.
-- @usage standard-library-sqlite3.md#transactions
function Connection:get_autocommit(): boolean
  self:reserve("get_autocommit", true)
  defer self.busy = false
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  packet.db = self.handle
  async.run_foreign(sqlite_autocommit_worker, packet)
  return packet.autocommit ~= 0
end

--- Begin a deferred transaction when false, or commit when true.
-- @param autocommit True commits the active transaction; false begins one when needed.
-- @usage standard-library-sqlite3.md#transactions
function Connection:set_autocommit(autocommit: boolean)
  if autocommit then
    self:transaction(sqlite_commit_worker, "set_autocommit")
  else
    self:transaction(sqlite_begin_worker, "set_autocommit")
  end
end

--- Bind values and execute a statement without returning rows.
-- @param ... SQL binding values in placeholder order, including nil for SQL NULL.
-- @return Number of rows changed by this execution.
-- @usage standard-library-sqlite3.md#executing-and-querying
function Statement:execute(...: value): integer
  self:require_open("execute")
  self.connection:reserve("execute", false)
  defer self.connection.busy = false
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  defer retire_packet(packet)
  packet.db = self.connection.handle
  packet.stmt = self.handle
  self:bind(packet, "execute", ...)
  async.run_foreign(sqlite_execute_worker, packet)
  check_result(packet, "execute")
  return packet.changes
end

--- Bind values and start a streamed query execution.
-- @param ... SQL binding values in placeholder order, including nil for SQL NULL.
-- @return Cursor owning this execution until exhaustion or close.
-- @usage standard-library-sqlite3.md#executing-and-querying
function Statement:query(...: value): Cursor
  self:require_open("query")
  self.connection:reserve("query", false)
  defer self.connection.busy = false
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  defer retire_packet(packet)
  packet.db = self.connection.handle
  packet.stmt = self.handle
  self:bind(packet, "query", ...)
  async.run_foreign(sqlite_query_worker, packet)
  check_result(packet, "query")
  local columns = decode_columns(packet)
  local row: Row?
  if packet.has_row ~= 0 then row = decode_row(packet, columns) end
  local cursor = Cursor {
    columns = columns,
    statement = self,
    pending = row,
    exhausted = packet.done ~= 0,
    closed = false
  }
  if not cursor.exhausted then self.connection.active_statement = self end
  packet.needs_reset = 0
  return cursor
end

--- Return the next copied row, or nil after exhaustion.
-- @return Copied row, or nil after the query is exhausted.
-- @usage standard-library-sqlite3.md#executing-and-querying
function Cursor:fetch(): Row?
  if self.closed then
    raise Error {
      message = "cursor is closed",
      code = nil,
      extended_code = nil,
      operation = "fetch"
    }
  end
  if self.pending ~= nil then
    local row: Row? = self.pending
    self.pending = nil
    return row
  end
  if self.exhausted then return nil end
  self.statement.connection:reserve("fetch", true)
  defer self.statement.connection.busy = false
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  packet.db = self.statement.connection.handle
  packet.stmt = self.statement.handle
  packet.needs_reset = 1
  local published = false
  defer do
    if not published then
      retire_packet(packet)
      self.closed = true
      self.statement.connection.active_statement = nil
    end
  end
  async.run_foreign(sqlite_fetch_worker, packet)
  check_result(packet, "fetch")
  if packet.done ~= 0 then
    self.exhausted = true
    self.statement.connection.active_statement = nil
    published = true
    return nil
  end
  local row = decode_row(packet, self.columns)
  packet.needs_reset = 0
  published = true
  return row
end

--- Retire this execution and make its prepared statement reusable.
-- @usage standard-library-sqlite3.md#executing-and-querying
function Cursor:close()
  if self.closed then return end
  if self.exhausted then
    self.closed = true
    return
  end
  self.statement.connection:reserve("cursor.close", true)
  defer self.statement.connection.busy = false
  local packet: owned *TitanSqlitePacket = foreign TitanSqlitePacket.new()
  defer sqlite_free_packet(packet)
  packet.db = self.statement.connection.handle
  packet.stmt = self.statement.handle
  packet.needs_reset = 1
  defer do
    if packet.needs_reset == 0 then
      self.closed = true
      self.pending = nil
      self.statement.connection.active_statement = nil
    end
  end
  run_foreign_cleanup(sqlite_reset_worker, packet)
  check_result(packet, "cursor.close")
end
