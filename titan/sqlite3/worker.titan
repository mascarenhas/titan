foreign import "native.h"
foreign import "sqlite3.h"
foreign import "stdlib.h"
foreign import "string.h"

-- Native byte copies always have an additional NUL byte. BLOB length remains
-- explicit, and even an empty BLOB has a non-NULL address at the bind boundary.
foreign function sqlite_copy_bytes(source: const *void,
                                   length: size_t): *char
  if length + 1 == 0 then return nil end
  local copy = ffi.malloc(length + 1) as foreign *char
  if copy == nil then return nil end
  if length > 0 then ffi.memcpy(copy, source, length) end
  (copy + length)[0] = 0 as foreign char
  return copy
end

foreign function sqlite_wrapper_error(packet: *TitanSqlitePacket,
                                      message: const *char)
  if packet.failed ~= 0 then return end
  packet.failed = 1
  packet.code = 0
  packet.extended_code = 0
  packet.fallback_message = message
end

-- Capture the original status and connection diagnostic before reset/finalize
-- can replace them. Allocation failure must never replace that original code.
foreign function sqlite_capture_error(packet: *TitanSqlitePacket,
                                      status: int)
  if packet.failed ~= 0 then return end
  packet.failed = 1
  packet.code = status & 255
  packet.extended_code = status
  local message = ffi.sqlite3_errstr(status)
  if packet.db ~= nil then
    local extended = ffi.sqlite3_extended_errcode(packet.db)
    if extended & 255 == packet.code then
      packet.extended_code = extended
      message = ffi.sqlite3_errmsg(packet.db)
    end
  end
  packet.fallback_message = "SQLite error (diagnostic allocation failed)"
  if message ~= nil then
    packet.message = sqlite_copy_bytes(message, ffi.strlen(message))
  end
end

foreign function sqlite_copy_error(packet: *TitanSqlitePacket)
  if packet.failed ~= 0 then return end
  packet.failed = 1
  packet.code = ffi.SQLITE_NOMEM
  packet.extended_code = ffi.SQLITE_NOMEM
  packet.fallback_message = "out of memory copying SQLite result"
end

foreign function sqlite_capture_cleanup(packet: *TitanSqlitePacket,
                                        status: int)
  if status == ffi.SQLITE_OK then return end
  if packet.failed == 0 then
    sqlite_capture_error(packet, status)
    return
  end
  if packet.cleanup_code ~= 0 then return end
  packet.cleanup_code = status & 255
  packet.cleanup_extended_code = status
  local message = ffi.sqlite3_errstr(status)
  if packet.db ~= nil then
    local extended = ffi.sqlite3_extended_errcode(packet.db)
    if extended & 255 == packet.cleanup_code then
      packet.cleanup_extended_code = extended
      message = ffi.sqlite3_errmsg(packet.db)
    end
  end
  if message ~= nil then
    packet.cleanup_message = sqlite_copy_bytes(message, ffi.strlen(message))
  end
end

foreign function sqlite_reset_statement(packet: *TitanSqlitePacket)
  local status = ffi.sqlite3_reset(packet.stmt)
  sqlite_capture_cleanup(packet, status)
  status = ffi.sqlite3_clear_bindings(packet.stmt)
  sqlite_capture_cleanup(packet, status)
  -- Reset retires execution even if it reports the prior step's failure.
  packet.needs_reset = 0
end

foreign function sqlite_bind_arguments(packet: *TitanSqlitePacket)
  sqlite_reset_statement(packet)
  if packet.failed ~= 0 then return end
  local count = ffi.sqlite3_bind_parameter_count(packet.stmt)
  if packet.argument_count ~= count then
    sqlite_wrapper_error(packet, "argument count does not match SQL parameter count")
    return
  end
  packet.needs_reset = 1
  local index: foreign int = 0
  while index < count do
    local cell = packet.arguments + index
    local position = index + 1
    local status: foreign int = ffi.SQLITE_OK
    if cell.kind == ffi.SQLITE_NULL then
      status = ffi.sqlite3_bind_null(packet.stmt, position)
    elseif cell.kind == ffi.SQLITE_INTEGER then
      status = ffi.sqlite3_bind_int64(packet.stmt, position, cell.integer_value)
    elseif cell.kind == ffi.SQLITE_FLOAT then
      status = ffi.sqlite3_bind_double(packet.stmt, position, cell.float_value)
    elseif cell.kind == ffi.SQLITE_TEXT then
      status = ffi.sqlite3_bind_text64(packet.stmt, position, cell.bytes,
          cell.length as foreign sqlite3_uint64, ffi.SQLITE_TRANSIENT,
          ffi.SQLITE_UTF8 as foreign unsigned char)
    elseif cell.kind == ffi.SQLITE_BLOB then
      status = ffi.sqlite3_bind_blob64(packet.stmt, position, cell.bytes,
          cell.length as foreign sqlite3_uint64, ffi.SQLITE_TRANSIENT)
    else
      sqlite_wrapper_error(packet, "invalid native SQL parameter kind")
      return
    end
    if status ~= ffi.SQLITE_OK then
      sqlite_capture_error(packet, status)
      return
    end
    index = index + 1
  end
end

foreign function sqlite_copy_columns(packet: *TitanSqlitePacket)
  packet.column_count = ffi.sqlite3_column_count(packet.stmt)
  if packet.column_count == 0 then return end
  packet.columns = ffi.calloc(packet.column_count as foreign size_t,
                                    foreign TitanSqliteColumn.sizeof)
  if packet.columns == nil then
    sqlite_copy_error(packet)
    return
  end
  local index: foreign int = 0
  while index < packet.column_count do
    local name = ffi.sqlite3_column_name(packet.stmt, index)
    if name == nil then
      sqlite_capture_error(packet, ffi.SQLITE_NOMEM)
      return
    end
    packet.columns[index].name = sqlite_copy_bytes(name, ffi.strlen(name))
    if packet.columns[index].name == nil then
      sqlite_copy_error(packet)
      return
    end
    local declared = ffi.sqlite3_column_decltype(packet.stmt, index)
    if declared ~= nil then
      packet.columns[index].declared_type =
          sqlite_copy_bytes(declared, ffi.strlen(declared))
      if packet.columns[index].declared_type == nil then
        sqlite_copy_error(packet)
        return
      end
    elseif ffi.sqlite3_errcode(packet.db) == ffi.SQLITE_NOMEM then
      sqlite_capture_error(packet, ffi.SQLITE_NOMEM)
      return
    end
    index = index + 1
  end
end

foreign function sqlite_copy_row(packet: *TitanSqlitePacket)
  packet.cell_count = ffi.sqlite3_column_count(packet.stmt)
  packet.cells = ffi.calloc(packet.cell_count as foreign size_t,
                                 foreign TitanSqliteCell.sizeof)
  if packet.cells == nil then
    sqlite_copy_error(packet)
    return
  end
  local index: foreign int = 0
  while index < packet.cell_count do
    local cell = packet.cells + index
    cell.kind = ffi.sqlite3_column_type(packet.stmt, index)
    if cell.kind == ffi.SQLITE_INTEGER then
      cell.integer_value = ffi.sqlite3_column_int64(packet.stmt, index)
    elseif cell.kind == ffi.SQLITE_FLOAT then
      cell.float_value = ffi.sqlite3_column_double(packet.stmt, index)
    elseif cell.kind ~= ffi.SQLITE_NULL then
      local source: foreign const *void = nil
      if cell.kind == ffi.SQLITE_TEXT then
        source = ffi.sqlite3_column_text(packet.stmt, index)
      else
        source = ffi.sqlite3_column_blob(packet.stmt, index)
      end
      -- Check the suspect NULL before any other SQLite call. Empty BLOB is
      -- legitimately NULL; TEXT, even empty, has a terminator on success.
      if source == nil then
        if ffi.sqlite3_errcode(packet.db) == ffi.SQLITE_NOMEM then
          sqlite_capture_error(packet, ffi.SQLITE_NOMEM)
          return
        end
        if cell.kind == ffi.SQLITE_TEXT then
          sqlite_capture_error(packet, ffi.SQLITE_NOMEM)
          return
        end
      end
      local length = ffi.sqlite3_column_bytes(packet.stmt, index)
      if length == 0 then
        if ffi.sqlite3_errcode(packet.db) == ffi.SQLITE_NOMEM then
          sqlite_capture_error(packet, ffi.SQLITE_NOMEM)
          return
        end
      end
      cell.length = length as foreign size_t
      cell.bytes = sqlite_copy_bytes(source, cell.length)
      if cell.bytes == nil then
        sqlite_copy_error(packet)
        return
      end
    end
    index = index + 1
  end
  packet.has_row = 1
end

foreign function sqlite_open_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  local db: foreign *sqlite3 = nil
  local status = ffi.sqlite3_open_v2(packet.input, db,
      ffi.SQLITE_OPEN_READWRITE | ffi.SQLITE_OPEN_CREATE |
      ffi.SQLITE_OPEN_FULLMUTEX, nil)
  packet.db = db
  if db ~= nil then packet.owns_db = 1 end
  if status ~= ffi.SQLITE_OK then
    sqlite_capture_error(packet, status)
    return
  end
  status = ffi.sqlite3_extended_result_codes(db, 1)
  if status ~= ffi.SQLITE_OK then sqlite_capture_error(packet, status) end
end

foreign function sqlite_prepare_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  local statement: foreign *sqlite3_stmt = nil
  local tail: foreign const *char = nil
  local status = ffi.sqlite3_prepare_v2(packet.db, packet.input, -1,
                                        statement, tail)
  packet.stmt = statement
  if statement ~= nil then packet.owns_stmt = 1 end
  if status ~= ffi.SQLITE_OK then
    sqlite_capture_error(packet, status)
    return
  end
  if statement == nil then
    sqlite_wrapper_error(packet, "SQL must contain exactly one statement")
    return
  end
  -- Ask SQLite to parse the tail, so comments, quoted semicolons, triggers,
  -- and empty statements keep SQLite's own syntax rather than a second lexer.
  while tail[0] ~= 0 do
    local extra: foreign *sqlite3_stmt = nil
    local next_tail: foreign const *char = nil
    status = ffi.sqlite3_prepare_v2(packet.db, tail, -1, extra, next_tail)
    if status ~= ffi.SQLITE_OK then
      sqlite_capture_error(packet, status)
      return
    end
    if extra ~= nil then
      sqlite_wrapper_error(packet, "SQL must contain exactly one statement")
      status = ffi.sqlite3_finalize(extra)
      sqlite_capture_cleanup(packet, status)
      return
    end
    tail = next_tail
  end
  packet.parameter_count = ffi.sqlite3_bind_parameter_count(statement)
  packet.column_count = ffi.sqlite3_column_count(statement)
end

foreign function sqlite_execute_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  sqlite_bind_arguments(packet)
  if packet.failed == 0 then
    packet.needs_reset = 1
    local status = ffi.sqlite3_step(packet.stmt)
    if status == ffi.SQLITE_DONE then
      packet.changes = ffi.sqlite3_changes64(packet.db)
      packet.done = 1
    elseif status == ffi.SQLITE_ROW then
      sqlite_wrapper_error(packet, "execute expected SQLITE_DONE; use query for rows")
    else
      sqlite_capture_error(packet, status)
    end
  end
  if packet.needs_reset ~= 0 then sqlite_reset_statement(packet) end
end

foreign function sqlite_query_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  if ffi.sqlite3_column_count(packet.stmt) == 0 then
    sqlite_wrapper_error(packet, "query requires a statement with result columns")
    return
  end
  sqlite_bind_arguments(packet)
  if packet.failed == 0 then
    packet.needs_reset = 1
    local status = ffi.sqlite3_step(packet.stmt)
    if status == ffi.SQLITE_ROW then
      sqlite_copy_columns(packet)
      if packet.failed == 0 then sqlite_copy_row(packet) end
    elseif status == ffi.SQLITE_DONE then
      packet.done = 1
      sqlite_copy_columns(packet)
      sqlite_reset_statement(packet)
    else
      sqlite_capture_error(packet, status)
    end
  end
  if packet.failed ~= 0 then
    if packet.needs_reset ~= 0 then sqlite_reset_statement(packet) end
  end
end

foreign function sqlite_fetch_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  packet.needs_reset = 1
  local status = ffi.sqlite3_step(packet.stmt)
  if status == ffi.SQLITE_ROW then
    sqlite_copy_row(packet)
  elseif status == ffi.SQLITE_DONE then
    packet.done = 1
    sqlite_reset_statement(packet)
  else
    sqlite_capture_error(packet, status)
  end
  if packet.failed ~= 0 then
    if packet.needs_reset ~= 0 then sqlite_reset_statement(packet) end
  end
end

foreign function sqlite_reset_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  sqlite_reset_statement(packet)
end

foreign function sqlite_finalize_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  local status = ffi.sqlite3_finalize(packet.stmt)
  -- Finalize destroys the statement even when it reports an execution error.
  packet.stmt = nil
  packet.owns_stmt = 0
  packet.needs_reset = 0
  sqlite_capture_cleanup(packet, status)
end

foreign function sqlite_close_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  local status = ffi.sqlite3_close(packet.db)
  if status == ffi.SQLITE_OK then
    packet.db = nil
    packet.owns_db = 0
  else
    sqlite_capture_cleanup(packet, status)
  end
end

foreign function sqlite_autocommit_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  packet.autocommit = ffi.sqlite3_get_autocommit(packet.db)
end

foreign function sqlite_transaction(packet: *TitanSqlitePacket,
                                     command: const *char)
  local status = ffi.sqlite3_exec(packet.db, command, nil, nil, nil)
  if status ~= ffi.SQLITE_OK then sqlite_capture_error(packet, status) end
  packet.autocommit = ffi.sqlite3_get_autocommit(packet.db)
end

foreign function sqlite_begin_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  packet.autocommit = ffi.sqlite3_get_autocommit(packet.db)
  if packet.autocommit ~= 0 then sqlite_transaction(packet, "BEGIN DEFERRED") end
end

foreign function sqlite_commit_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  packet.autocommit = ffi.sqlite3_get_autocommit(packet.db)
  if packet.autocommit == 0 then sqlite_transaction(packet, "COMMIT") end
end

foreign function sqlite_rollback_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  packet.autocommit = ffi.sqlite3_get_autocommit(packet.db)
  if packet.autocommit == 0 then sqlite_transaction(packet, "ROLLBACK") end
end

-- Called through cancellation-insensitive foreign cleanup when publication
-- fails or accepted work completes with cancellation pending. No operation is
-- repeated: this retires only the native ownership still held by the packet.
foreign function sqlite_retire_worker(argument: *void)
  local packet = argument as foreign *TitanSqlitePacket
  if packet.owns_stmt ~= 0 then
    sqlite_finalize_worker(argument)
  elseif packet.needs_reset ~= 0 then
    sqlite_reset_statement(packet)
  end
  if packet.owns_db ~= 0 then sqlite_close_worker(argument) end
end

-- Pure malloc/free ownership may retire synchronously on the loop thread.
-- SQLite handles and execution have already been retired or transferred.
foreign function sqlite_free_packet(packet: *TitanSqlitePacket)
  ffi.free(packet.input)
  packet.input = nil
  local index: foreign int = 0
  if packet.arguments ~= nil then
    while index < packet.argument_count do
      ffi.free(packet.arguments[index].bytes)
      index = index + 1
    end
    ffi.free(packet.arguments)
    packet.arguments = nil
  end
  index = 0
  if packet.columns ~= nil then
    while index < packet.column_count do
      ffi.free(packet.columns[index].name)
      ffi.free(packet.columns[index].declared_type)
      index = index + 1
    end
    ffi.free(packet.columns)
    packet.columns = nil
  end
  index = 0
  if packet.cells ~= nil then
    while index < packet.cell_count do
      ffi.free(packet.cells[index].bytes)
      index = index + 1
    end
    ffi.free(packet.cells)
    packet.cells = nil
  end
  ffi.free(packet.message)
  packet.message = nil
  ffi.free(packet.cleanup_message)
  packet.cleanup_message = nil
end
