local mco = foreign import "minicoro.h"
local lua = foreign import "lua.h"
local lual = foreign import "lauxlib.h"
local ffi = foreign import "titan/ffi.h"
local coro_native = foreign import "titan/coro.h"

local STACK_SIZE = 2 * 1024 * 1024
local TITAN_CORO_OWNER_USERVALUES = 5
local runtime = mco.mco_runtime.new()

record Coro
  local udata: value -- just for GC rooting
  local handle: *mco.mco_coro
  local default_tag: value
end

local function missing_tag()
  raise "must provide tag argument if no default_tag was provided"
end

local function missing_yield_tag()
  raise "must provide non-nil tag argument to coroutine.yield"
end

local function effective_tag(default_tag: value, explicit_tag: value): value
  local tag = explicit_tag
  if tag == nil then
    tag = default_tag
  end
  if tag == nil then
    missing_tag()
  end
  return tag
end

local function check_mco_result(result: mco.mco_result)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    raise (mco.mco_result_description(result) as string)
  end
end

local function root_transfer(co: *mco.mco_coro, payload: value)
  if not co then
    return
  end
  local owner: *ffi.Udata =
    mco.mco_get_user_data(co) as *ffi.Udata
  local top = lua.lua_gettop(L)
  if (lua.lua_checkstack(L, 2) as integer) == 0 then
    lua.lua_settop(L, top)
    raise "cannot reserve Lua stack for coroutine transfer root"
  end
  ffi.lua_pushtvalue(L, owner)
  ffi.lua_pushtvalue(L, payload)
  local set = lua.lua_setiuservalue(
    L, -2, TITAN_CORO_OWNER_USERVALUES)
  if (set as integer) == 0 then
    lua.lua_settop(L, top)
    raise "cannot set coroutine transfer root"
  end
  lua.lua_settop(L, top)
end

local function clear_transfer(co: *mco.mco_coro)
  root_transfer(co, nil)
end

local function push_transfer(source: *mco.mco_coro,
                             ok: ffi.titan_ffi_int, payload: value)
  root_transfer(source, payload)
  local result = mco.mco_push(source, payload, ffi.TValue.sizeof)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    clear_transfer(source)
    check_mco_result(result)
  end
  result = mco.mco_push(source, ok, ffi.titan_ffi_int.sizeof)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    local rollback = mco.mco_pop(source, nil, ffi.TValue.sizeof)
    check_mco_result(rollback)
    clear_transfer(source)
    check_mco_result(result)
  end
end

local function discard_transfer(source: *mco.mco_coro)
  if source then
    local ok_result = mco.mco_pop(source, nil, ffi.titan_ffi_int.sizeof)
    check_mco_result(ok_result)
    local payload_result = mco.mco_pop(source, nil, ffi.TValue.sizeof)
    check_mco_result(payload_result)
    clear_transfer(source)
  end
end

local function reinstall_trace(trace: string)
  ffi.lua_pushtvalue(L, trace)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  lua.lua_pushboolean(L, 1)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
end

local function stash_trace_for_append(trace: string)
  ffi.lua_pushtvalue(L, trace)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
end

local function pop_trace_for_append(): value
  local top = lua.lua_gettop(L)
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  local trace = ffi.lua_totvalue(L, -1)
  lua.lua_pushnil(L)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  lua.lua_settop(L, top)
  return trace
end

local function raise_with_appended_trace(err: value)
  do
    raise err
  catch
    local inner = pop_trace_for_append()
    if inner ~= nil then
      reinstall_trace((inner as string) .. "\n" .. traceback)
    end
    raise error
  end
end

local function transfer_source(co: *mco.mco_coro): *mco.mco_coro
  if co and co.stacked_co then
    return co.stacked_co
  end
  return co
end

local function pop_transfer_or_raise(co: *mco.mco_coro,
                                     append_trace: boolean): value
  local ok: ffi.titan_ffi_int = 0 as ffi.titan_ffi_int
  local payload: ffi.TValue = nil
  local ok_result = mco.mco_pop(co, ok, ffi.titan_ffi_int.sizeof)
  check_mco_result(ok_result)
  local payload_result = mco.mco_pop(co, payload, ffi.TValue.sizeof)
  check_mco_result(payload_result)
  clear_transfer(co)
  if (ok as integer) == 0 then
    if append_trace then
      raise_with_appended_trace(payload)
    else
      raise payload
    end
  end
  return payload
end

local function resume_result_or_raise(co: *mco.mco_coro,
                                      source: *mco.mco_coro,
                                      tag: value): value
  local ctag: ffi.TValue = tag
  local result = mco.mco_resume(co, ctag)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    discard_transfer(source)
    check_mco_result(result)
  end
  local result_source = co
  if co and co.stacked_co then
    result_source = co.stacked_co
  end
  return pop_transfer_or_raise(result_source, true)
end

local function yield_result_or_raise(co: *mco.mco_coro, tag: value): value
  local ctag: ffi.TValue = tag
  local result = mco.mco_yield(co, ctag)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    discard_transfer(co)
    check_mco_result(result)
  end
  return pop_transfer_or_raise(co, false)
end

function Coro:resume(arg: value, tag: value): value
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  push_transfer(source, 1, arg)
  return resume_result_or_raise(co, source, effective)
end

function Coro:error(err: value, tag: value): value
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  push_transfer(source, 0, err)
  return resume_result_or_raise(co, source, effective)
end

function Coro:status(): string
  local status = mco.mco_status(self.handle)
  if (status as integer) == (mco.MCO_SUSPENDED as integer) then
    return "suspended"
  end
  if (status as integer) == (mco.MCO_RUNNING as integer) then
    return "running"
  end
  if (status as integer) == (mco.MCO_NORMAL as integer) then
    return "normal"
  end
  if (status as integer) == (mco.MCO_STACKED as integer) then
    return "stacked"
  end
  return "dead"
end

function yield(arg: value, tag: value): value
  if tag == nil then
    missing_yield_tag()
  end
  local co = runtime.current_co
  push_transfer(co, 1, arg)
  return yield_result_or_raise(co, tag)
end

function is_yieldable(tag: value): boolean
  if tag == nil then
    missing_yield_tag()
  end
  local ctag: ffi.TValue = tag
  return (mco.mco_is_yieldable(runtime.current_co, ctag) as integer) ~= 0
end

local function coro_gc(handle: value)
  ffi.lua_pushtvalue(L, handle)
  local co = (lua.lua_touserdata(L, -1) as **mco.mco_coro)[0]
  mco.mco_destroy(co)
end

local function coro_entry(func: (value) -> value, co: *mco.mco_coro)
  local arg = pop_transfer_or_raise(co, false)
  local res = func(arg)
  push_transfer(co, 1, res)
catch
  stash_trace_for_append(traceback)
  push_transfer(co, 0, error)
end

function create(func: (value) -> value, default_tag: value): Coro
  local slot: **mco.mco_coro = lua.lua_newuserdatauv(
    L, ffi.titan_ffi_void_ptr.sizeof, TITAN_CORO_OWNER_USERVALUES)
  local T = ffi.titan_newthread(L)
  lua.lua_setiuservalue(L, -2, 1)
  ffi.lua_pushtvalue(L, M)
  lua.lua_setiuservalue(L, -2, 2)
  ffi.lua_pushtvalue(L, coro_entry)
  lua.lua_setiuservalue(L, -2, 3)
  ffi.lua_pushtvalue(L, func)
  lua.lua_setiuservalue(L, -2, 4)
  lual.luaL_setmetatable(L, "titan.coroutine")

  local desc = mco.mco_desc_init(nil, STACK_SIZE)
  desc.runtime = runtime
  desc.func = coro_native.titan_coro_entry
  desc.user_data = ffi.lua_togco(L, -1)

  local res = mco.mco_create(slot, desc)
  if res as integer ~= mco.MCO_SUCCESS as integer then
    raise "could not create coroutine: " .. (mco.mco_result_description(res) as string)
  end

  return Coro.new(ffi.lua_totvalue(L, -1), slot[0], default_tag)
end

do
  local res = lual.luaL_newmetatable(L, "titan.coroutine")
  if res as integer == 1 then
    ffi.lua_pushtvalue(L, coro_gc)
    lua.lua_setfield(L, -2, "__gc")
  end
end
