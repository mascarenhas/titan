foreign import "minicoro.h"
foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"

local type VoidPointer = *void

local type coro_entry_func = foreign (
  *ffi.lua_State, *ffi.Udata, *ffi.CClosure,
  ffi.TValue, *ffi.mco_coro
) -> ()

foreign function coro_entry_trampoline(co: *ffi.mco_coro)
  local owner = ffi.mco_get_user_data(co) as *ffi.Udata
  local T = ffi.lmacro_thvalue(owner.uv[0].uv)
  local module = ffi.lmacro_uvalue(owner.uv[1].uv)
  local callback = ffi.lmacro_clCvalue(owner.uv[2].uv)
  local func = owner.uv[3].uv
  local entry = ffi.lmacro_pvalue(callback.upvalue[2]) as coro_entry_func
  entry(T, module, nil, func, co)
end

local STACK_SIZE = 2 * 1024 * 1024
local TITAN_CORO_OWNER_USERVALUES = 5
local runtime = ffi.mco_runtime.new()

record Coro
  local udata: value -- just for GC rooting
  local handle: *ffi.mco_coro
  local default_tag: value
end

local function missing_tag()
  raise "must provide tag argument if no default_tag was provided"
end

local function missing_yield_tag()
  raise "must provide non-nil tag argument to coroutine.yield"
end

local function effective_tag(default_tag: value, explicit_tag: value): value
  local tag = explicit_tag
  if tag == nil then
    tag = default_tag
  end
  if tag == nil then
    missing_tag()
  end
  return tag
end

local function check_mco_result(result: ffi.mco_result)
  if result ~= ffi.MCO_SUCCESS then
    raise (ffi.mco_result_description(result) as string)
  end
end

local function root_transfer(co: *ffi.mco_coro, payload: value)
  if not co then
    return
  end
  local owner: *ffi.Udata =
    ffi.mco_get_user_data(co) as *ffi.Udata
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then
    raise "cannot reserve Lua stack for coroutine transfer root"
  end
  ffi.lua_pushtvalue(L, owner)
  ffi.lua_pushtvalue(L, payload)
  local set = ffi.lua_setiuservalue(
    L, -2, TITAN_CORO_OWNER_USERVALUES)
  if set == 0 then
    raise "cannot set coroutine transfer root"
  end
end

local function clear_transfer(co: *ffi.mco_coro)
  root_transfer(co, nil)
end

local function push_transfer(source: *ffi.mco_coro,
                             ok: int, payload: value)
  root_transfer(source, payload)
  local result = ffi.mco_push(
    source, payload as ffi.TValue, ffi.TValue.sizeof)
  if result ~= ffi.MCO_SUCCESS then
    clear_transfer(source)
    check_mco_result(result)
  end
  result = ffi.mco_push(source, ok, int.sizeof)
  if result ~= ffi.MCO_SUCCESS then
    local rollback = ffi.mco_pop(source, nil, ffi.TValue.sizeof)
    check_mco_result(rollback)
    clear_transfer(source)
    check_mco_result(result)
  end
end

local function discard_transfer(source: *ffi.mco_coro)
  if source then
    local ok_result = ffi.mco_pop(source, nil, int.sizeof)
    check_mco_result(ok_result)
    local payload_result = ffi.mco_pop(source, nil, ffi.TValue.sizeof)
    check_mco_result(payload_result)
    clear_transfer(source)
  end
end

local function reinstall_trace(trace: string)
  ffi.lua_pushtvalue(L, trace)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  ffi.lua_pushboolean(L, 1)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
end

local function stash_trace_for_append(trace: string)
  ffi.lua_pushtvalue(L, trace)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
end

local function pop_trace_for_append(): value
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  ffi.lua_getfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  local trace = ffi.lua_totvalue(L, -1)
  ffi.lua_pushnil(L)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_APPEND_KEY)
  return trace
end

local function raise_with_appended_trace(err: value)
  do
    raise err
  catch
    local inner = pop_trace_for_append()
    if inner ~= nil then
      reinstall_trace((inner as string) .. "\n" .. traceback)
    end
    raise error
  end
end

local function transfer_source(co: *ffi.mco_coro): *ffi.mco_coro
  if co and co.stacked_co then
    return co.stacked_co
  end
  return co
end

local function pop_transfer_or_raise(co: *ffi.mco_coro,
                                     append_trace: boolean): value
  local ok: int = 0 as int
  local payload: ffi.TValue = nil
  local ok_result = ffi.mco_pop(co, ok, int.sizeof)
  check_mco_result(ok_result)
  local payload_result = ffi.mco_pop(co, payload, ffi.TValue.sizeof)
  check_mco_result(payload_result)
  clear_transfer(co)
  if ok == 0 then
    if append_trace then
      raise_with_appended_trace(payload)
    else
      raise payload
    end
  end
  return payload
end

local function resume_result_or_raise(co: *ffi.mco_coro,
                                      source: *ffi.mco_coro,
                                      tag: value): value
  local ctag: ffi.TValue = tag
  local result = ffi.mco_resume(co, ctag)
  if result ~= ffi.MCO_SUCCESS then
    discard_transfer(source)
    check_mco_result(result)
  end
  local result_source = co
  if co and co.stacked_co then
    result_source = co.stacked_co
  end
  return pop_transfer_or_raise(result_source, true)
end

local function yield_result_or_raise(co: *ffi.mco_coro, tag: value): value
  local ctag: ffi.TValue = tag
  local result = ffi.mco_yield(co, ctag)
  if result ~= ffi.MCO_SUCCESS then
    discard_transfer(co)
    check_mco_result(result)
  end
  return pop_transfer_or_raise(co, false)
end

function Coro:resume(arg: value, tag: value): value
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  push_transfer(source, 1, arg)
  return resume_result_or_raise(co, source, effective)
end

function Coro:error(err: value, tag: value): value
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  push_transfer(source, 0, err)
  return resume_result_or_raise(co, source, effective)
end

function Coro:status(): string
  local status = ffi.mco_status(self.handle)
  if status == ffi.MCO_SUSPENDED then
    return "suspended"
  end
  if status == ffi.MCO_RUNNING then
    return "running"
  end
  if status == ffi.MCO_NORMAL then
    return "normal"
  end
  if status == ffi.MCO_STACKED then
    return "stacked"
  end
  return "dead"
end

function yield(arg: value, tag: value): value
  if tag == nil then
    missing_yield_tag()
  end
  local co = runtime.current_co
  push_transfer(co, 1, arg)
  return yield_result_or_raise(co, tag)
end

function is_yieldable(tag: value): boolean
  if tag == nil then
    missing_yield_tag()
  end
  local ctag: ffi.TValue = tag
  return ffi.mco_is_yieldable(runtime.current_co, ctag) ~= 0
end

local function coro_gc(handle: value)
  ffi.lua_pushtvalue(L, handle)
  local co = (ffi.lua_touserdata(L, -1) as **ffi.mco_coro)[0]
  ffi.mco_destroy(co)
end

local function coro_entry(func: (value) -> value, co: *ffi.mco_coro)
  local arg = pop_transfer_or_raise(co, false)
  local res = func(arg)
  push_transfer(co, 1, res)
catch
  stash_trace_for_append(traceback)
  push_transfer(co, 0, error)
end

function create(func: (value) -> value, default_tag: value): Coro
  local slot: **ffi.mco_coro = ffi.lua_newuserdatauv(
    L, VoidPointer.sizeof, TITAN_CORO_OWNER_USERVALUES)
  local _ = ffi.titan_newthread(L)
  ffi.lua_setiuservalue(L, -2, 1)
  ffi.lua_pushtvalue(L, M)
  ffi.lua_setiuservalue(L, -2, 2)
  ffi.lua_pushtvalue(L, coro_entry)
  ffi.lua_setiuservalue(L, -2, 3)
  ffi.lua_pushtvalue(L, func)
  ffi.lua_setiuservalue(L, -2, 4)
  ffi.luaL_setmetatable(L, "titan.coroutine")

  local desc = ffi.mco_desc_init(nil, STACK_SIZE)
  desc.runtime = runtime
  desc.func = coro_entry_trampoline
  desc.user_data = ffi.lua_togco(L, -1)

  local res = ffi.mco_create(slot, desc)
  if res ~= ffi.MCO_SUCCESS then
    raise "could not create coroutine: " .. (ffi.mco_result_description(res) as string)
  end

  return Coro.new(ffi.lua_totvalue(L, -1), slot[0], default_tag)
end

do
  ffi.lua_getfield(L, ffi.LUA_REGISTRYINDEX, "titan.coroutine")
  local kind = ffi.lua_type(L, -1)
  if kind == ffi.LUA_TNIL then
    ffi.lua_settop(L, -2)
    ffi.lua_createtable(L, 0, 2)
    ffi.lua_pushstring(L, "titan.coroutine")
    ffi.lua_setfield(L, -2, "__name")
    ffi.lua_pushtvalue(L, coro_gc)
    ffi.lua_setfield(L, -2, "__gc")
    ffi.lua_pushvalue(L, -1)
    ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "titan.coroutine")
  elseif kind ~= ffi.LUA_TTABLE then
    raise "invalid Titan coroutine metatable registry entry"
  end
end
