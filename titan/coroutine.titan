--- Low-level stackful coroutines with tagged control transfer and stable handle identity.
-- @module titan.coroutine
-- @usage coroutines.md

foreign import "minicoro.h"
foreign import "lua.h"
foreign import "titan.h"
foreign import "titan/ffi.h"
local gc = import "gc"

local runtime = foreign mco_runtime.new()
-- Transfer flags popped by pop_transfer_or_raise. TRANSFER_UNWIND is both the
-- request coro_gc pushes into an abandoned chain and the final transfer of an
-- unwound coroutine (pushed by titan_coroutine_enter in minicoro.c).
local const TRANSFER_ERROR = 0
local const TRANSFER_VALUE = 1
local const TRANSFER_UNWIND = 2
-- A failed coroutine body leaves its trace here for the resumer to append.
local pending_append_trace: string? = nil

--- Opaque tagged coroutine created by coroutine.create; use async Tasks for scheduling.
-- @usage coroutines.md
record Coroutine
  -- The record owns its coroutine; minicoro's user data points back at it.
  -- `handle` is nil before the native stack exists and after its finalizer
  -- destroyed it. `pending` roots the one pending transfer, which minicoro
  -- stores as bytes.
  local handle: foreign *mco_coro
  local default_tag: value
  local thread: value
  local entry: function (Coroutine)
  local body: function (value): (value)
  local pending: value
end

foreign type coro_entry_func = function (*lua_State, *Udata, *CClosure, *Udata): void

-- Implementation notes: doc/implementation/coroutines.md#entry-function
local foreign function coro_entry_trampoline(co: *mco_coro)
  local owner = ffi.mco_get_user_data(co) as foreign *Udata
  local T = ffi.lmacro_thvalue(ffi.titan_record_field(owner, "Coroutine", "thread"))
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "Coroutine", "entry"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign coro_entry_func
  -- The C shim installs the unwind floor below the entry on T.
  ffi.titan_coroutine_enter(T, module, owner, co, entry)
end

-- The record that owns `co`.
local function owner_of(co: foreign *mco_coro): Coroutine
  local owner: value = ffi.mco_get_user_data(co) as foreign *Udata
  return owner as Coroutine
end

local function missing_tag()
  raise "must provide tag argument if no default_tag was provided"
end

local function missing_yield_tag()
  raise "must provide non-nil tag argument to coroutine.yield"
end

local function effective_tag(default_tag: value, explicit_tag: value): value
  local tag = explicit_tag
  if tag == nil then
    tag = default_tag
  end
  if tag == nil then
    missing_tag()
  end
  return tag
end

local function check_mco_result(result: foreign mco_result)
  if result ~= ffi.MCO_SUCCESS then
    raise (ffi.mco_result_description(result) as string)
  end
end

-- Implementation notes: doc/implementation/coroutines.md#tvalue-ffi-boundary
local function root_transfer(co: foreign *mco_coro, payload: value)
  if not co then
    return
  end
  local owner = owner_of(co)
  owner.pending = payload
end

local function clear_transfer(co: foreign *mco_coro)
  root_transfer(co, nil)
end

local function push_transfer(source: foreign *mco_coro,
                             ok: foreign int, payload: value)
  root_transfer(source, payload)
  local result = ffi.mco_push(
    source, payload as foreign TValue, foreign TValue.sizeof)
  if result ~= ffi.MCO_SUCCESS then
    clear_transfer(source)
    check_mco_result(result)
  end
  result = ffi.mco_push(source, ok, foreign int.sizeof)
  if result ~= ffi.MCO_SUCCESS then
    local rollback = ffi.mco_pop(source, nil, foreign TValue.sizeof)
    check_mco_result(rollback)
    clear_transfer(source)
    check_mco_result(result)
  end
end

local function discard_transfer(source: foreign *mco_coro)
  if source then
    local ok_result = ffi.mco_pop(source, nil, foreign int.sizeof)
    check_mco_result(ok_result)
    local payload_result = ffi.mco_pop(source, nil, foreign TValue.sizeof)
    check_mco_result(payload_result)
    clear_transfer(source)
  end
end

local function stash_trace_for_append(trace: string)
  pending_append_trace = trace
end

local function pop_trace_for_append(): string?
  local trace? = pending_append_trace
  pending_append_trace = nil
  return trace
end

local function raise_with_appended_trace(err: value)
  raise err
catch
  local inner? = pop_trace_for_append()
  if inner ~= nil then raise error, inner .. "\n" .. traceback end
  raise
end

local function transfer_source(co: foreign *mco_coro): foreign *mco_coro
  if co and co.stacked_co then
    return co.stacked_co
  end
  return co
end

-- Pop the pending transfer of `co`: true and the payload for an error, false
-- and the payload for a value.
local function pop_transfer(co: foreign *mco_coro): (boolean, value)
  local ok: foreign int = 0 as foreign int
  local payload: foreign TValue = nil
  local ok_result = ffi.mco_pop(co, ok, foreign int.sizeof)
  check_mco_result(ok_result)
  local payload_result = ffi.mco_pop(co, payload, foreign TValue.sizeof)
  check_mco_result(payload_result)
  clear_transfer(co)
  if ok == TRANSFER_ERROR then return true, payload end
  if ok ~= TRANSFER_VALUE then
    -- TRANSFER_UNWIND: this coroutine is being collected while suspended
    -- here, or the coroutine it resumed finished unwinding. Continue the
    -- unwind from this frame; titan_unwind never returns.
    ffi.titan_unwind(L)
  end
  return false, payload
end

local function pop_transfer_or_raise(co: foreign *mco_coro,
                                     append_trace: boolean): value
  local failed, payload = pop_transfer(co)
  if failed then
    if append_trace then
      raise_with_appended_trace(payload)
    else
      raise payload
    end
  end
  return payload
end

-- Switch into `co` and return the coroutine whose transfer holds the result:
-- a tagged nested yield leaves it in the deepest stacked coroutine.
local function resume_switch(co: foreign *mco_coro, source: foreign *mco_coro,
                             tag: value): foreign *mco_coro
  local ctag: foreign TValue = tag
  local result = ffi.mco_resume(co, ctag)
  if result ~= ffi.MCO_SUCCESS then
    discard_transfer(source)
    check_mco_result(result)
  end
  if co and co.stacked_co then
    return co.stacked_co
  end
  return co
end

local function resume_result_or_raise(co: foreign *mco_coro,
                                      source: foreign *mco_coro,
                                      tag: value): value
  return pop_transfer_or_raise(resume_switch(co, source, tag), true)
end

local function yield_result_or_raise(co: foreign *mco_coro, tag: value): value
  local ctag: foreign TValue = tag
  local result = ffi.mco_yield(co, ctag)
  if result ~= ffi.MCO_SUCCESS then
    discard_transfer(co)
    check_mco_result(result)
  end
  return pop_transfer_or_raise(co, false)
end

local function resume_from_finalizer()
  raise "cannot resume a coroutine from a finalizer"
end

--- Resume a suspended coroutine and return its yielded or final value.
-- @param arg Value delivered to the coroutine.
-- @param tag Resumer tag; nil uses the stored default tag.
-- @return Yielded or returned value.
-- @usage coroutines.md
function Coroutine:resume(arg: value, tag: value): value
  if ffi.titan_in_finalizer(L) ~= 0 then resume_from_finalizer() end
  -- A synchronous C callback runs where no stack can suspend (a browser
  -- callback under JSPI), so an explicit switch raises instead. The guard
  -- stays inline: natively titan_no_switch is the constant 0, and the whole
  -- branch folds away.
  if ffi.titan_no_switch(L) ~= 0 then
    raise "coroutine.resume is unavailable in a synchronous callback"
  end
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  push_transfer(source, TRANSFER_VALUE, arg)
  return resume_result_or_raise(co, source, effective)
end

--- Resume a suspended coroutine by raising a value at its yield point.
-- @param err Error value injected into the coroutine.
-- @param tag Resumer tag; nil uses the stored default tag.
-- @return Next yielded or returned value if the coroutine handles the error.
-- @usage coroutines.md
function Coroutine:error(err: value, tag: value): value
  if ffi.titan_in_finalizer(L) ~= 0 then resume_from_finalizer() end
  if ffi.titan_no_switch(L) ~= 0 then -- see Coroutine:resume
    raise "coroutine.error is unavailable in a synchronous callback"
  end
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  push_transfer(source, TRANSFER_ERROR, err)
  return resume_result_or_raise(co, source, effective)
end

--- Transfer control without raising an uncaught callee error.
-- @param payload Value delivered normally or injected as an error.
-- @param tag Resumer tag; nil uses the stored default tag.
-- @param inject_error True injects payload as an error at the suspension point.
-- @return Failed flag, yielded/returned/error value, and optional callee traceback.
-- @usage coroutines.md
function Coroutine:transfer(payload: value, tag: value,
                            inject_error: boolean): (boolean, value, string?)
  if ffi.titan_in_finalizer(L) ~= 0 then resume_from_finalizer() end
  if ffi.titan_no_switch(L) ~= 0 then -- see Coroutine:resume
    raise "coroutine.transfer is unavailable in a synchronous callback"
  end
  local effective = effective_tag(self.default_tag, tag)
  local co = self.handle
  local source = transfer_source(co)
  if inject_error then
    push_transfer(source, TRANSFER_ERROR, payload)
  else
    push_transfer(source, TRANSFER_VALUE, payload)
  end
  local failed, result = pop_transfer(resume_switch(co, source, effective))
  local trace: string? = nil
  if failed then trace = pop_trace_for_append() end
  return failed, result, trace
end

--- Query the current low-level coroutine state.
-- @return suspended, running, normal, stacked, or dead.
-- @usage coroutines.md
function Coroutine:status(): string
  local status = ffi.mco_status(self.handle)
  if status == ffi.MCO_SUSPENDED then
    return "suspended"
  end
  if status == ffi.MCO_RUNNING then
    return "running"
  end
  if status == ffi.MCO_NORMAL then
    return "normal"
  end
  if status == ffi.MCO_STACKED then
    return "stacked"
  end
  return "dead"
end

--- Yield a value to the nearest active resumer with the same nonnil tag.
-- @param arg Value delivered to the matching resumer.
-- @param tag Explicit tag compared by raw equality.
-- @return Value supplied when the matching suspended stack resumes.
-- @usage coroutines.md
function yield(arg: value, tag: value): value
  if tag == nil then
    missing_yield_tag()
  end
  if ffi.titan_in_finalizer(L) ~= 0 then
    raise "cannot yield from a finalizer"
  end
  if ffi.titan_no_switch(L) ~= 0 then -- see Coroutine:resume
    raise "coroutine.yield is unavailable in a synchronous callback"
  end
  local co = runtime.current_co
  push_transfer(co, TRANSFER_VALUE, arg)
  return yield_result_or_raise(co, tag)
end

--- Check whether an active resumer can receive the given nonnil tag.
-- @param tag Explicit control-transfer tag.
-- @return True when a matching tagged yield is possible.
-- @usage coroutines.md
function is_yieldable(tag: value): boolean
  if tag == nil then
    missing_yield_tag()
  end
  if ffi.titan_in_finalizer(L) ~= 0 or ffi.titan_no_switch(L) ~= 0 then
    return false
  end
  local ctag: foreign TValue = tag
  return ffi.mco_is_yieldable(runtime.current_co, ctag) ~= 0
end

-- The coroutine floor stays linked on the coroutine's own Lua thread from the
-- entry's first instruction until it returns.
local function coroutine_started(co: foreign *mco_coro): boolean
  local owner: foreign TValue = owner_of(co).thread
  local thread = ffi.lmacro_thvalue(owner)
  return thread.errorJmp ~= nil
end

-- Resume the suspended handler of an abandoned chain with an unwind request.
-- Minicoro switches into the deepest stacked coroutine; each member unwinds,
-- finishes dead and returns to its resumer, which unwinds in turn.
local function unwind_chain(handler: foreign *mco_coro)
  local source = transfer_source(handler)
  push_transfer(source, TRANSFER_UNWIND, nil)
  -- No yield can compare this tag: yields raise inside finalizers.
  local nil_tag: foreign TValue = nil
  local result = ffi.mco_resume(handler, nil_tag)
  if result ~= ffi.MCO_SUCCESS then
    discard_transfer(source)
    return
  end
  if ffi.mco_status(handler) == ffi.MCO_DEAD then
    discard_transfer(handler)
  end
end

-- Implementation notes: doc/implementation/coroutines.md#unwinding-an-abandoned-coroutine
local function coro_gc(finalized: value)
  local owner = finalized as Coroutine
  local co = owner.handle
  if not co then
    -- No native stack: it was never created, or this record was resurrected
    -- and is finalized again.
    return
  end
  local status = ffi.mco_status(co)
  if status == ffi.MCO_SUSPENDED or status == ffi.MCO_STACKED then
    -- A stacked member's chain is owned by its first suspended ancestor.
    local handler = co
    while handler and ffi.mco_status(handler) == ffi.MCO_STACKED do
      handler = handler.prev_co
    end
    if handler and ffi.mco_status(handler) == ffi.MCO_SUSPENDED and
        coroutine_started(handler) then
      if ffi.titan_no_switch(L) ~= 0 then
        -- Unwinding would switch stacks, which a synchronous callback cannot.
        -- Registering the finalizer again marks the record for finalization
        -- once more: the next collection outside a callback, or lua_close,
        -- unwinds the chain.
        gc.finalizable<|value|>(finalized, coro_gc)
        return
      end
      unwind_chain(handler)
    end
    status = ffi.mco_status(co)
  end
  if status ~= ffi.MCO_DEAD and
      not (status == ffi.MCO_SUSPENDED and not coroutine_started(co)) then
    -- A running coroutine (state closed from inside it) or an undeliverable
    -- request: leave the stack mapped rather than free live frames.
    return
  end
  ffi.mco_destroy(co)
  owner.handle = nil
end

local function coro_entry(owner: Coroutine)
  local co = owner.handle
  local res = owner.body(pop_transfer_or_raise(co, false))
  push_transfer(co, TRANSFER_VALUE, res)
catch
  stash_trace_for_append(traceback)
  push_transfer(owner.handle, TRANSFER_ERROR, error)
end

--- Create a suspended coroutine without running its function.
-- @param func Coroutine body receiving its initial resume argument.
-- @param default_tag Default nonnil resume tag, or nil to require explicit tags.
-- @return Stable public Coroutine handle.
-- @usage coroutines.md
function create(func: function (value): (value), default_tag: value): Coroutine
  -- titan_newthread leaves the thread on the stack until the record holds it.
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for coroutine creation"
  end
  local _ = ffi.titan_newthread(L)
  local co = Coroutine {
    handle = nil,
    default_tag = default_tag,
    thread = ffi.lua_totvalue(L, -1),
    entry = coro_entry,
    body = func,
    pending = nil,
  }
  -- Registered before the native stack exists, so none can outlive its
  -- finalizer; coro_gc ignores a record without one.
  gc.finalizable<|value|>(co, coro_gc)

  local desc = ffi.mco_desc_init(nil, ffi.TITAN_COROUTINE_STACK_SIZE as integer)
  desc.runtime = runtime
  desc.func = coro_entry_trampoline
  desc.user_data = co as foreign *void

  local handle: foreign *mco_coro = nil
  local res = ffi.mco_create(handle, desc)
  if res ~= ffi.MCO_SUCCESS then
    raise "could not create coroutine: " .. (ffi.mco_result_description(res) as string)
  end
  co.handle = handle
  return co
end

--- Return the innermost currently executing Titan coroutine.
-- @return Exact public Coroutine handle, or nil outside Titan coroutine execution.
-- @usage coroutines.md
function running(): Coroutine?
  -- A synchronous callback sees no current coroutine, even when it runs
  -- inside a binding that a coroutine called.
  if ffi.titan_no_switch(L) ~= 0 then return nil end
  -- Outside a coroutine the user data is null, which boxes as nil.
  local owner: value = ffi.mco_get_user_data(runtime.current_co) as foreign *Udata
  return owner as Coroutine?
end
