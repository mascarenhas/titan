-- Module-local implementations of the complete capture surface declared
-- in peg.titan.

local function _capture_impl(pattern: Pattern): Pattern
  return _pattern(
    _C(pattern.raw), _checked_unary(pattern, 1))
end

local function _constant_impl(...: value): Pattern
  local count = #...
  local size = 1
  if count == 1 then
    size = 2
  elseif count > 1 then
    size = 3 * count
  end
  if size > MAX_PATTERN_SIZE then raise "PEG pattern is too large" end
  return _pattern(_Cc(...), size)
end

local function _match_time_impl(
    pattern: Pattern,
    callback: (string, integer, value, ...: value) ->
      (...: value)): Pattern
  _require_raw_function(callback, "match-time")
  return _pattern(
    _Cmt(pattern.raw, callback), _checked_unary(pattern, 1))
end

local function _back_capture_impl(key: value): Pattern
  if key == nil then raise "PEG back-capture key must be non-nil" end
  return _pattern(_Cb(key), 2)
end

local function _argument_impl(index: integer): Pattern
  if index < 1 or index > MAX_SHORT then
    raise "PEG argument index is out of range"
  end
  return _pattern(_Carg(index), 2)
end

local function _position_impl(): Pattern
  return _pattern(_Cp(), 2)
end

local function _substitution_impl(pattern: Pattern): Pattern
  return _pattern(
    _Cs(pattern.raw), _checked_unary(pattern, 1))
end

local function _table_capture_impl(pattern: Pattern): Pattern
  return _pattern(
    _Ct(pattern.raw), _checked_unary(pattern, 1))
end

local function _fold_capture_impl(
    pattern: Pattern,
    callback: (value, ...: value) -> value): Pattern
  _require_raw_function(callback, "fold-capture")
  return _pattern(
    _Cf(pattern.raw, callback), _checked_unary(pattern, 1))
end

local function _group_impl(
    pattern: Pattern, key: value): Pattern
  return _pattern(
    _Cg(pattern.raw, key), _checked_unary(pattern, 1))
end

local function _select_capture_impl(
    pattern: Pattern, index: integer): Pattern
  if index < 0 or index > MAX_SHORT then
    raise "PEG capture index is out of range"
  end
  return _pattern(
    _capture_replace(pattern.raw, index),
    _checked_unary(pattern, 1))
end

local function _template_capture_impl(
    pattern: Pattern, template: string): Pattern
  return _pattern(
    _capture_replace(pattern.raw, template),
    _checked_unary(pattern, 1))
end

local function _query_capture_impl(
    pattern: Pattern, lookup: {value: value}): Pattern
  return _pattern(
    _capture_replace(pattern.raw, lookup),
    _checked_unary(pattern, 1))
end

local function _function_capture_impl(
    pattern: Pattern,
    callback: (value, ...: value) -> (...: value)): Pattern
  _require_raw_function(callback, "function-capture")
  return _pattern(
    _capture_replace(pattern.raw, callback),
    _checked_unary(pattern, 1))
end
