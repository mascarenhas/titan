-- Module-local LPegLabel state and raw-Lua helpers used by peg.titan.

local function _field(table_value: value, name: string): value
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  ffi.lua_pushtvalue(L, table_value)
  lua.lua_getfield(L, -1, name)
  return ffi.lua_totvalue(L, -1)
end

local function _require_function(table_value: value,
                                 name: string): value
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  ffi.lua_pushtvalue(L, table_value)
  lua.lua_getfield(L, -1, name)
  if lua.lua_type(L, -1) ~= lua.LUA_TFUNCTION then
    raise "embedded LPegLabel is missing function '" .. name .. "'"
  end
  return ffi.lua_totvalue(L, -1)
end

local function _initialize_native()
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  if private_lpeg.titan_lpeglabel_open(L) ~= 1 or
      lua.lua_type(L, -1) ~= lua.LUA_TTABLE then
    raise "embedded LPegLabel opener did not return its module table"
  end
  _engine = ffi.lua_totvalue(L, -1)

  _P = _require_function(_engine, "P")
  _S = _require_function(_engine, "S")
  _R = _require_function(_engine, "R")
  _utfR = _require_function(_engine, "utfR")
  _V = _require_function(_engine, "V")
  _B = _require_function(_engine, "B")
  _T = _require_function(_engine, "T")
  _C = _require_function(_engine, "C")
  _Cc = _require_function(_engine, "Cc")
  _Cmt = _require_function(_engine, "Cmt")
  _Cb = _require_function(_engine, "Cb")
  _Carg = _require_function(_engine, "Carg")
  _Cp = _require_function(_engine, "Cp")
  _Cs = _require_function(_engine, "Cs")
  _Ct = _require_function(_engine, "Ct")
  _Cf = _require_function(_engine, "Cf")
  _Cg = _require_function(_engine, "Cg")
  _match = _require_function(_engine, "match")
  _locale = _require_function(_engine, "locale")
  _setmaxstack = _require_function(_engine, "setmaxstack")
  _version_text = _field(_engine, "version") as string

  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, PATTERN_REGISTRY_KEY)
  if lua.lua_type(L, -1) ~= lua.LUA_TTABLE then
    raise "embedded LPegLabel did not install its private pattern metatable"
  end
  local metatable: value = ffi.lua_totvalue(L, -1)
  _sequence = _require_function(metatable, "__mul")
  _choice = _require_function(metatable, "__add")
  _difference = _require_function(metatable, "__sub")
  _lookahead = _require_function(metatable, "__len")
  _negative = _require_function(metatable, "__unm")
  _repeat = _require_function(metatable, "__pow")
  _capture_replace = _require_function(metatable, "__div")

  -- Matching is wrapped with an identity sentinel and a final position
  -- capture.  The sentinel makes a native failure triple unambiguous even
  -- when successful user captures begin with nil, "fail", and an integer.
  -- The wrapper is stripped on the raw Lua stack before its results cross
  -- the PEG adapter's 200-value public-result boundary.
  lua.lua_createtable(L, 0, 0)
  _match_success_sentinel = ffi.lua_totvalue(L, -1)
end

local function _pattern(raw: value, tree_size: integer): Pattern
  return Pattern.new(raw, tree_size)
end

local function _checked_sum(first: integer, second: integer,
                            overhead: integer): integer
  if first < 0 or second < 0 or overhead < 0 or
      first > MAX_PATTERN_SIZE - overhead or
      second > MAX_PATTERN_SIZE - overhead - first then
    raise "PEG pattern is too large"
  end
  return first + second + overhead
end

local function _checked_unary(pattern: Pattern,
                              overhead: integer): integer
  return _checked_sum(pattern.tree_size, 0, overhead)
end

local function _is_integer_value(item: value): boolean
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  ffi.lua_pushtvalue(L, item)
  return lua.lua_isinteger(L, -1) ~= 0
end

local function _encoded_name(name: value): string
  if name is string then
    return "\0s" .. (name as string)
  elseif _is_integer_value(name) then
    return "\0i" .. (name as integer)
  end
  raise "PEG names and labels must be strings or integers"
end

local function _string_from(source: string, offset: integer): string
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  local data = source as const *ffi.titan_ffi_char
  lua.lua_pushlstring(
    L, data + offset, (#source - offset) as lua.size_t)
  return ffi.lua_totvalue(L, -1) as value
end

local function _decoded_label(label: value): value
  if not (label is string) then return label end
  local encoded = label as string
  if #encoded < 2 then return label end
  local bytes = encoded as const *ffi.titan_ffi_unsigned_char
  if bytes[0] ~= 0 then return label end
  if bytes[1] == 115 then
    return _string_from(encoded, 2)
  elseif bytes[1] == 105 then
    local body = _string_from(encoded, 2)
    local top = lua.lua_gettop(L)
    defer lua.lua_settop(L, top)
    local valid: ffi.titan_ffi_int = 0
    ffi.lua_pushtvalue(L, body)
    local converted = lua.lua_tointegerx(L, -1, valid)
    if valid == 0 then raise "invalid private PEG integer label" end
    return converted as integer
  end
  return label
end

local function _normalized_init(subject: string,
                                supplied: integer?): integer
  if not supplied then return 1 end
  local init = supplied as integer
  local length = #subject
  if init > 0 then
    if init > length + 1 then return length + 1 end
    return init
  elseif init == 0 then
    return length + 1
  elseif init < -length then
    return 1
  else
    return length + init + 1
  end
end

local function _raw_table_item(items: value,
                               index: integer): value
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  ffi.lua_pushtvalue(L, items)
  lua.lua_rawgeti(L, -1, index)
  return ffi.lua_totvalue(L, -1)
end

local function _unpack_results(items: value, index: integer,
                               limit: integer): (...: value)
  if index > limit then return end
  return _raw_table_item(items, index),
    _unpack_results(items, index + 1, limit)
end
