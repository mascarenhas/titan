--- Private size accounting shared by public PEG repetition combinators.
-- @module titan.peg
-- @usage standard-library-peg.md

-- Shared size projections for public repetition combinators in peg.titan.

local function _at_least_size(pattern: Pattern,
                              count: integer): integer
  -- Native formula: (count + 1) * (tree_size + 1).
  const unit = pattern.tree_size + 1
  if count > MAX_PATTERN_SIZE // unit - 1 then
    raise "PEG pattern is too large"
  end
  return (count + 1) * unit
end

local function _at_most_size(pattern: Pattern,
                             count: integer): integer
  -- Native formula: count * (tree_size + 3) - 1.
  const unit = pattern.tree_size + 3
  if count > (MAX_PATTERN_SIZE + 1) // unit then
    raise "PEG pattern is too large"
  end
  return count * unit - 1
end
