-- Native worker-pool offload: run_foreign and its after-work completion.

local record ForeignWork
  local const request: uv.work_t
  local const worker: foreign function (*void): void
  local const argument: foreign *void
  local done: Completion<|ForeignWork, value, OperationError|>?
  local number: integer
  local const abandoned: foreign function (*void): void
end

local function ForeignWork:release_abandoned()
  const release = self.abandoned
  release(self.argument)
end

-- Implementation notes: doc/implementation/libuv-runtime.md#foreign-workers
-- A Lua state close unwound the wait before the job returned. The Runtime
-- finalizer releases after its drain, when the job has returned; a Runtime
-- already finalized has drained, so release at once.
local function ForeignWork:abandon()
  if not self.abandoned then return end
  const runtime? = active_runtime
  if runtime == nil then
    self:release_abandoned()
    return
  end
  runtime.backend.abandoned_work[#runtime.backend.abandoned_work + 1] = self
end

local function foreign_work_completed(request: uv.work_t, status: integer)
  const work: ForeignWork = request:get_data()
  const done = work.done as Completion<|ForeignWork, value, OperationError|>
  const number = work.number
  request:set_data(nil)
  work.done = nil
  do
    if status < 0 then done:reject(number, operation_error(status, "async.run_foreign"))
    else done:resolve(number, nil) end
  catch done:fatal(number, error, traceback); raise end
end

local function start_foreign_work(done: Completion<|ForeignWork, value, OperationError|>, number: integer): uv.req_t?
  const work = done:context(number)
  work.done = done
  work.number = number
  work.request:set_data(work)
  const status = uv.queue_work(current_loop(), work.request, work.worker,
      work.argument, foreign_work_completed, nil)
  if status < 0 then
    work.request:set_data(nil)
    work.done = nil
    done:reject(number, operation_error(status, "async.run_foreign"))
  end
  return nil
end

--- Run one blocking C function-pointer call in the shared worker pool and wait for completion.
-- @param f C-only entry; it must never enter the calling Lua/Titan state. Separately owned states follow the titan.lua isolation protocol.
-- @param arg Native pointer whose owner remains live until after-work completion, including cancellation.
-- @param abandoned Optional C-only release for arg, called on the closing thread after f returns if a Lua state close abandons the wait.
-- @usage async-io.md
function run_foreign(f: foreign function (*void): void, arg: foreign *void,
                     abandoned: foreign function (*void): void)
  if not f then raise "async.run_foreign callback must not be NULL" end
  const work = ForeignWork(uv.work_t(), f, arg, nil, 0, abandoned)
  -- catch never runs during an unwind, so `waiting` stays set only when a
  -- Lua state close abandons the wait.
  local waiting = true
  defer if waiting and ffi.titan_state_closing(L) ~= 0 then work:abandon() end
  local result: Result<|value, OperationError|>? = nil
  do
    result = await_with<|ForeignWork, value, OperationError|>(work, start_foreign_work)
  catch
    waiting = false
    raise
  end
  waiting = false
  case result
  when error(failure) then raise failure
  else
  end
end
