--- Copy and borrow policies for values crossing independent Lua states.
-- @module titan.transfer
-- @usage standard-library-transfer.md

foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"
foreign import "stdlib.h"
foreign import "string.h"
foreign import "transfer.h"
foreign import "transfer_native.h"
foreign import "protobuf/native.h"
local reflect = import "reflect"
local protobuf = import "protobuf"
local gc = import "gc"

-- This chain is C-only, including every registered release callback. Detach
-- the complete table before invoking callbacks: Receiver release can recurse
-- into other packet disposals without observing this table as still owned.
local foreign function dispose_resources(table: *titan_transfer_resource_table)
  local entries = table.entries
  local count = table.count
  table.entries = nil
  table.count = 0 as foreign size_t
  table.capacity = 0 as foreign size_t
  local index = 0 as foreign size_t
  while index < count do
    local entry = entries + index
    if entry.claimed == 0 then
      entry.claimed = 1
      local resource = entry.resource
      local release = entry.release
      entry.resource = nil
      if resource ~= nil then release(resource) end
    end
    index = index + 1
  end
  ffi.free(entries)
end

--- Consume a raw packet owner, releasing unclaimed resources entirely in C.
-- NULL is harmless; disposing the same non-NULL owner twice is invalid.
foreign function discard_message(raw: *void)
  if raw == nil then return end
  local message = raw as foreign *titan_async_message
  dispose_resources(ffi.titan_transfer_message_resources(message))
  ffi.free(message)
end

local foreign function take_packet_message(raw_owner: *void): *void
  local owner = raw_owner as foreign *titan_transfer_packet_owner
  local message = owner.message
  owner.message = nil
  return message as foreign *void
end

local foreign function dispose_scope(owner: *titan_transfer_scope_owner)
  local message = owner.message
  owner.message = nil
  dispose_resources(ffi.titan_transfer_scope_resources(owner))
  discard_message(message as foreign *void)
end

local foreign function move_slot_to_scope(owner: *titan_transfer_scope_owner,
    slot: *(*void))
  owner.message = slot[0] as foreign *titan_async_message
  slot[0] = nil
end

--- Move a guarded raw packet slot into a previously prepared/rooted Packet owner.
-- Return 0 and clear slot on success; -2 (NULL owner/slot), -4 (occupied
-- destination), or -5 (NULL source) leave both unchanged. This C-only move
-- cannot allocate, enter Lua, or throw; retain the raw cleanup guard on failure.
foreign function adopt_into(raw_owner: *void, slot: *(*void)): int
  if raw_owner == nil then return -2 end
  if slot == nil then return -2 end
  local owner = raw_owner as foreign *titan_transfer_packet_owner
  if owner.message ~= nil then return -4 end
  if slot[0] == nil then return -5 end
  owner.message = slot[0] as foreign *titan_async_message
  slot[0] = nil
  return 0
end

--- Copy an attachment-free packet, returning a new raw owner or NULL.
-- Resource-bearing packets cannot be cloned; move their single owner instead.
foreign function copy_message(raw: const *void): *void
  if raw == nil then return nil end
  local input = raw as foreign const *titan_async_message
  if input.resources.entries ~= nil then return nil end
  if input.resources.count ~= 0 then return nil end
  if input.resources.capacity ~= 0 then return nil end
  local length = 0 as foreign size_t
  local name_length = 0 as foreign size_t
  local module_length = 0 as foreign size_t
  if input.kind == ffi.TITAN_ASYNC_MESSAGE_STRING then
    length = input.length
  elseif input.kind >= ffi.TITAN_ASYNC_MESSAGE_RECORD then
    -- The four contiguous nominal kinds are the only other byte carriers.
    if input.kind <= ffi.TITAN_ASYNC_MESSAGE_RECORD_PAYLOAD then
      length = input.length
      name_length = input.name_length
      module_length = input.module_length
    end
  end
  local header_size = foreign titan_async_message.sizeof
  if length > ffi.SIZE_MAX - header_size then return nil end
  if name_length > ffi.SIZE_MAX - header_size - length then return nil end
  if module_length > ffi.SIZE_MAX - header_size - length - name_length then return nil end
  local message = ffi.malloc(header_size + length + name_length + module_length)
    as foreign *titan_async_message
  if message == nil then return nil end
  ffi.memset(message, 0, header_size)
  message.kind = input.kind
  message.integer = input.integer
  message.number = input.number
  message.length = input.length
  message.name_length = input.name_length
  message.module_length = input.module_length
  message.state = input.state
  message.function = input.function
  message.pointer = input.pointer
  message.entry = input.entry
  local bytes = (message + 1) as foreign *char
  message.bytes = bytes
  if length > 0 then ffi.memcpy(bytes, input.bytes, length) end
  message.name = bytes + length
  if name_length > 0 then ffi.memcpy(bytes + length, input.name, name_length) end
  message.module = bytes + length + name_length
  if module_length > 0 then
    ffi.memcpy(bytes + length + name_length, input.module, module_length)
  end
  return message as foreign *void
end

local foreign function reserve_resource(table: *titan_transfer_resource_table): int
  if table.count >= ffi.TITAN_TRANSFER_INVALID_INDEX then return 0 end
  if table.count < table.capacity then return 1 end
  local capacity = table.capacity
  if capacity == 0 then capacity = 4 as foreign size_t
  elseif capacity > ((ffi.TITAN_TRANSFER_INVALID_INDEX / 2) as foreign size_t) then
    capacity = ffi.TITAN_TRANSFER_INVALID_INDEX as foreign size_t
  else capacity = capacity * 2 end
  if capacity > ffi.SIZE_MAX / foreign titan_transfer_resource.sizeof then return 0 end
  local entries = ffi.realloc(table.entries,
      capacity * foreign titan_transfer_resource.sizeof) as foreign *titan_transfer_resource
  if entries == nil then return 0 end
  table.entries = entries
  table.capacity = capacity
  return 1
end

local foreign function attach_reserved(table: *titan_transfer_resource_table,
    resource: *void, retain: function(*void): void,
    release: function(*void): void): unsigned int
  local index = table.count
  retain(resource)
  local entry = table.entries + index
  entry.resource = resource
  entry.release = release
  entry.claimed = 0
  table.count = index + 1
  return index as foreign unsigned int
end

local foreign function commit_resources(message: *titan_async_message,
    table: *titan_transfer_resource_table)
  message.resources.entries = table.entries
  message.resources.count = table.count
  message.resources.capacity = table.capacity
  table.entries = nil
  table.count = 0 as foreign size_t
  table.capacity = 0 as foreign size_t
end

local record ResourceScope
  local encoding: boolean
  local native: foreign titan_transfer_scope_owner
  local message: foreign *titan_async_message
  local execution: value
  local previous: ResourceScope?
end

local resource_scopes: {value: ResourceScope} = {}

-- Titan's stackful coroutines each execute on their own real Lua thread.
-- Root that exact thread value as the map key, not a reusable raw address.
local function current_execution(): value
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "transfer: cannot reserve execution scope stack"
  end
  ffi.lua_pushthread(L)
  return ffi.lua_totvalue(L, -1) as value
end

local function finalize_resource_scope(scope: ResourceScope)
  -- An abandoned suspended stack may never execute its lexical defer.
  -- Its native owners still have one nonyielding cleanup path.
  dispose_scope(scope.native)
end

local function ResourceScope:attach(resource: foreign *void,
    retain: foreign function(*void): void,
    release: foreign function(*void): void): integer
  if not self.encoding then raise "transfer: resource attachment requires an encode scope" end
  if resource == nil or retain == nil or release == nil then
    raise "transfer: invalid native resource attachment"
  end
  if reserve_resource(ffi.titan_transfer_scope_resources(self.native)) == 0 then
    raise "transfer: out of memory reserving resource attachment"
  end
  return attach_reserved(
    ffi.titan_transfer_scope_resources(self.native), resource, retain, release)
end

-- Public opaque hooks resolve the exact execution's top on every call. The
-- registered codec alone receives the packet's already-resolved scope.
function attach_resource(resource: foreign *void,
    retain: foreign function(*void): void,
    release: foreign function(*void): void): string
  local scope? = resource_scopes[current_execution()]
  if scope == nil then raise "transfer: resource attachment requires an encode scope" end
  local index = scope:attach(resource, retain, release) as foreign unsigned int
  local bytes = foreign unsigned char.new_array(4)
  protobuf.write_resource_index_bytes(bytes as foreign *void, index)
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then raise "transfer: cannot reserve attachment index stack" end
  ffi.lua_pushlstring(L, bytes as foreign const *char, 4 as foreign size_t)
  return ffi.lua_totvalue(L, -1) as value
end

local function ResourceScope:claim(data: foreign const *void, length: integer,
    expected_release: foreign function(*void): void): foreign *void
  if self.encoding then raise "transfer: resource claim requires a decode scope" end
  if length ~= 4 then raise "transfer: invalid resource attachment index width" end
  -- Inverse of protobuf.write_resource_index_bytes; the width check above
  -- precedes every read, and the slice is always inside the owned packet.
  local bytes = data as foreign const *unsigned char
  local index = (bytes[0] as foreign unsigned int)
    | ((bytes[1] as foreign unsigned int) << 8)
    | ((bytes[2] as foreign unsigned int) << 16)
    | ((bytes[3] as foreign unsigned int) << 24)
  if index == ffi.TITAN_TRANSFER_INVALID_INDEX
      or (index as foreign size_t) >= self.message.resources.count then
    raise "transfer: resource attachment index is out of bounds"
  end
  local entry = self.message.resources.entries + index
  if expected_release == nil or entry.release ~= expected_release then
    raise "transfer: resource attachment kind mismatch"
  end
  if entry.claimed ~= 0 then raise "transfer: resource attachment was already claimed" end
  -- The caller has already created and finalized an inert destination owner.
  -- No allocation, hook, checked conversion, or yield follows this commit.
  local resource = entry.resource
  entry.claimed = 1
  entry.resource = nil
  return resource
end

function claim_resource(index_bytes: string,
    expected_release: foreign function(*void): void): foreign *void
  local scope? = resource_scopes[current_execution()]
  if scope == nil then raise "transfer: resource claim requires a decode scope" end
  return scope:claim(ffi.titan_protobuf_bytes_ptr(index_bytes) as foreign const *void,
      #index_bytes, expected_release)
end

-- Internal compiled constructor collaboration. The context is never serialized
-- or cached: the decoder keeps its owning ResourceScope traced for this call.
function claim_registered_resource(context: value, data: foreign const *void,
    length: integer, expected_release: foreign function(*void): void): foreign *void
  if context == nil then raise "transfer: resource claim requires a decode scope" end
  local scope: ResourceScope = context
  return scope:claim(data, length, expected_release)
end

local function packet_context(encoding: boolean): value
  local scope? = resource_scopes[current_execution()]
  if scope == nil then return nil end
  if scope.encoding ~= encoding then return nil end
  return scope
end

-- Register only exact typed accessors and finalizer-first constructors. These
-- fixed callables retain their declaring module; retain/release remain native
-- C-only capabilities and no userdata field offsets cross module boundaries.
function register_resource(candidate: value,
    get: function (value): (foreign *void),
    retain: foreign function(*void): void,
    release: foreign function(*void): void,
    construct: function (value, foreign const *void, integer): (value))
  case reflect.inspect(candidate)
  when is_record(record_value) then
    protobuf.register_resource_codec(candidate, record_value.type,
        function (context: value, endpoint: value): integer
          if context == nil then raise "transfer: resource attachment requires an encode scope" end
          local scope: ResourceScope = context
          return scope:attach(get(endpoint), retain, release)
        end,
        construct)
  else raise "transfer: registered resource must be a record"
  end
end

-- These private C-ABI functions run only inside the owning state's protected
-- entry. They retain no state and leave all surviving values rooted on its
-- stack. The generated callbacks know the exact capture storage types.
local foreign function transfer_module_value(state: *lua_State, index: int): *Udata
  if ffi.lua_type(state, index) ~= ffi.LUA_TUSERDATA then
    ffi.luaL_error(state, "closure transfer requires a Titan module")
    return nil
  end
  local candidate = ffi.lua_totvalue(state, index)
  local module = ffi.lmacro_uvalue(candidate)
  if module.len < foreign TitanModuleData.sizeof then
    ffi.luaL_error(state, "closure transfer module has no native descriptor")
    return nil
  end
  return module
end

local foreign function transfer_manifest(state: *lua_State,
                                   owner: *Udata): const *TitanTransferModule
  if owner.len < foreign TitanModuleData.sizeof then
    ffi.luaL_error(state, "transfer owner has no native module descriptor")
    return nil
  end
  local data = ffi.lmacro_getudatamem(owner) as foreign const *TitanModuleData
  if data.symbols == nil then
    ffi.luaL_error(state, "transfer owner has no native module descriptor")
    return nil
  end
  local module = data.symbols(ffi.TITAN_TRANSFER_MANIFEST_SYMBOL)
    as foreign const *TitanTransferModule
  if module == nil then
    ffi.luaL_error(state, "transfer owner has no module manifest")
    return nil
  end
  if module.name == nil then
    ffi.luaL_error(state, "transfer owner has no module name")
    return nil
  end
  if module.entry_count ~= 0 then
    if module.entries == nil then
      ffi.luaL_error(state, "transfer owner has no closure entries")
      return nil
    end
  end
  return module
end

-- Push the real owner name alongside the returned immutable source entry.
local foreign function transfer_closure_entry(state: *lua_State,
                                        index: int): const *TitanTransferEntry
  local candidate = ffi.lua_totvalue(state, index)
  if ffi.lmacro_ttisCclosure(candidate) == 0 then
    ffi.luaL_error(state, "cannot transfer a value that is not a Titan closure")
    return nil
  end
  local closure = ffi.lmacro_clCvalue(candidate)
  if closure.nupvalues < 5 then
    ffi.luaL_error(state, "invalid Titan closure header")
    return nil
  end
  if ffi.lmacro_ttisfulluserdata(closure.upvalue[0]) == 0 then
    ffi.luaL_error(state, "invalid Titan closure module")
    return nil
  end
  if ffi.lmacro_ttislightuserdata(closure.upvalue[2]) == 0 then
    ffi.luaL_error(state, "invalid Titan closure native entry")
    return nil
  end
  if ffi.lmacro_ttislightuserdata(closure.upvalue[3]) == 0 then
    ffi.luaL_error(state, "invalid Titan closure brand")
    return nil
  end
  if ffi.lmacro_pvalue(closure.upvalue[3]) ~= ffi.TITAN_BRAND then
    ffi.luaL_error(state, "invalid Titan closure brand")
    return nil
  end
  if ffi.lmacro_ttislcf(closure.upvalue[closure.nupvalues - 1]) == 0 then
    ffi.luaL_error(state, "invalid Titan closure strict entry")
    return nil
  end
  local module = transfer_manifest(state, ffi.lmacro_uvalue(closure.upvalue[0]))
  local ordinal = 0 as foreign unsigned int
  while ordinal < module.entry_count do
    local entry = module.entries + ordinal
    if entry.native == ffi.lmacro_pvalue(closure.upvalue[2]) then
      if entry.strict == ffi.lmacro_fvalue(closure.upvalue[closure.nupvalues - 1]) then
        ffi.luaL_checkstack(state, 1, "copying a closure module name")
        ffi.lua_pushstring(state, module.name)
        return entry
      end
    end
    ordinal = ordinal + 1
  end
  ffi.luaL_error(state, "Titan closure entry is absent from its module manifest")
  return nil
end

local foreign function transfer_capture_count(entry: const *TitanTransferEntry): unsigned int
  return entry.capture_count
end

local foreign function transfer_project(state: *lua_State, index: int,
                                  entry: const *TitanTransferEntry)
  ffi.luaL_checkstack(state, (entry.capture_count as foreign int) + 2,
    "projecting immediate closure captures")
  local candidate = ffi.lua_totvalue(state, index)
  entry.project(state, ffi.lmacro_clCvalue(candidate))
end

--- Load and verify a native Titan module from package.preload in the given Lua state, pushing its module userdata.
-- @param state Target Lua state with an initialized native preload table.
-- @param name Canonical module name bytes.
-- @param length Byte length of the module name.
-- @usage standard-library-transfer.md
foreign function transfer_load_module(state: *lua_State,
                                      name: const *char, length: unsigned long long)
  if length > (ffi.SIZE_MAX as foreign unsigned long long) then
    ffi.luaL_error(state, "transfer module name exceeds native size")
    return
  end
  local native_length = length as foreign size_t
  local top = ffi.lua_gettop(state)
  ffi.luaL_checkstack(state, 3, "loading a transfer module")
  ffi.lua_pushstring(state, ffi.LUA_PRELOAD_TABLE)
  ffi.lua_rawget(state, ffi.LUA_REGISTRYINDEX)
  if ffi.lua_type(state, -1) ~= ffi.LUA_TTABLE then
    ffi.luaL_error(state, "transfer module has no native preload table")
    return
  end
  ffi.lua_pushlstring(state, name, native_length)
  ffi.lua_rawget(state, -2)
  if ffi.lua_type(state, -1) ~= ffi.LUA_TFUNCTION then
    ffi.luaL_error(state, "transfer module has no preload loader")
    return
  end
  ffi.lua_copy(state, -1, top + 1)
  ffi.lua_settop(state, top + 1)
  ffi.lua_callk(state, 0, 1, 0 as foreign lua_KContext, nil)
  -- The generated initializer publishes this exact module before returning.
  -- A preload wrapper may not substitute unrelated native userdata.
  ffi.lua_pushstring(state, "Titan module ")
  ffi.lua_pushlstring(state, name, native_length)
  ffi.lua_concat(state, 2)
  ffi.lua_rawget(state, ffi.LUA_REGISTRYINDEX)
  if ffi.lua_type(state, -1) ~= ffi.LUA_TUSERDATA then
    ffi.luaL_error(state, "transfer loader did not initialize its Titan module")
    return
  end
  if ffi.lua_rawequal(state, top + 1, -1) == 0 then
    ffi.luaL_error(state, "transfer loader returned a different Titan module")
    return
  end
  ffi.lua_settop(state, top + 1)
end

local foreign function transfer_resolve(state: *lua_State, index: int,
                                  token: const *void): const *TitanTransferEntry
  local module = transfer_manifest(state, transfer_module_value(state, index))
  local ordinal = 0 as foreign unsigned int
  while ordinal < module.entry_count do
    local entry = module.entries + ordinal
    -- Compare addresses before reading any part of the incoming token.
    if (entry as foreign const *void) == token then return entry end
    ordinal = ordinal + 1
  end
  ffi.luaL_error(state, "closure transfer entry belongs to a different provider or is invalid")
  return nil
end

local foreign function transfer_restore(state: *lua_State,
                                  entry: const *TitanTransferEntry,
                                  module_index: int, capture_base: int)
  local top = ffi.lua_gettop(state)
  local module = transfer_module_value(state, module_index)
  capture_base = ffi.lua_absindex(state, capture_base)
  if entry.capture_count ~= 0 then
    if capture_base < 1 then
      ffi.luaL_error(state, "closure transfer is missing captures")
      return
    end
    if capture_base > top then
      ffi.luaL_error(state, "closure transfer is missing captures")
      return
    end
    if entry.capture_count > ((top - capture_base + 1) as foreign unsigned int) then
      ffi.luaL_error(state, "closure transfer is missing captures")
      return
    end
  end
  ffi.luaL_checkstack(state, (entry.capture_count as foreign int) + 2,
    "restoring immediate closure captures")
  entry.restore(state, module, capture_base)
end

local foreign function transfer_nominal_module(state: *lua_State, index: int)
  local top = ffi.lua_gettop(state)
  index = ffi.lua_absindex(state, index)
  ffi.luaL_checkstack(state, 2, "resolving a nominal's declaring module")
  if ffi.lua_getmetatable(state, index) == 0 then
    ffi.luaL_error(state, "transfer nominal has no metatable")
    return
  end
  ffi.lua_rawgetp(state, -1, ffi.TITAN_MT_MOD)
  local module = transfer_manifest(state, transfer_module_value(state, -1))
  ffi.lua_settop(state, top)
  ffi.lua_pushstring(state, module.name)
end

--- Values copied or borrowed across independent Lua states.
-- @usage async-io.md#transfer-values
union TransferValue
  is_nil()
  is_boolean(boolean)
  is_integer(integer)
  is_float(float)
  is_string(string)
  is_lua_state(foreign *lua_State)
  is_function(foreign function (*lua_State): int)
  is_pointer(foreign *void)
  is_record(module: string, name: string, data: string)
  is_union(module: string, name: string, data: string)
  is_closure(module: string, entry: foreign const *void, data: string)
  is_record_payload(module: string, name: string, data: string)
end

local transfer_active_closures: {value: boolean} = {}
local closure_fields: const {reflect.Type} = {}

local function nominal_module(candidate: value): string
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then raise "cannot reserve nominal transfer stack" end
  ffi.lua_pushtvalue(L, candidate)
  transfer_nominal_module(L, -1)
  return ffi.lua_totvalue(L, -1) as value
end

local function project_closure_captures(
    candidate: value): (string, foreign const *void, {TransferValue}, {boolean})
  if transfer_active_closures[candidate] then raise "cannot transfer cyclic closure captures" end
  transfer_active_closures[candidate] = true
  defer transfer_active_closures[candidate] = nil
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then raise "cannot reserve transfer closure stack" end
  ffi.lua_pushtvalue(L, candidate)
  local closure_index = ffi.lua_gettop(L)
  local entry = transfer_closure_entry(L, closure_index)
  local module: string = ffi.lua_totvalue(L, -1) as value
  local count = transfer_capture_count(entry) as integer
  local capture_base = ffi.lua_gettop(L) + 1
  -- Project the complete immediate frontier before any custom hook can change
  -- a captured cell. The Lua stack keeps every projected value rooted.
  transfer_project(L, closure_index, entry)
  local policies: {TransferValue} = {}
  local was_policy: {boolean} = {}
  for index = 0, count - 1 do
    local capture: value = ffi.lua_totvalue(L, (capture_base + index) as foreign int)
    was_policy[index + 1] = capture is TransferValue
    policies[index + 1] = TransferValue.from_value(capture)
  end
  return module, entry as foreign const *void, policies, was_policy
end

local function snapshot_closure(candidate: value): TransferValue
  local module, entry, policies, was_policy = project_closure_captures(candidate)
  return TransferValue.is_closure(module, entry,
    protobuf.serialize_fields(closure_fields, policies, was_policy))
end

local function snapshot_closure_to_buffer(
    buf: foreign *titan_protobuf_buffer,
    candidate: value): (string, foreign const *void)
  local module, entry, policies, was_policy = project_closure_captures(candidate)
  protobuf.serialize_fields_to_buffer(
      buf as foreign *void, closure_fields, policies, was_policy)
  return module, entry
end

local function encode_record_payload(
    record_value: reflect.RecordValue,
    encode: reflect.MethodType): string
  return protobuf.encode_transfer_payload(
      record_value.value,
      encode,
      "transfer: cyclic record payload for " .. record_value.type.name)
end

local function initialize_nominal_raw(
    module: foreign const *char,
    module_len: foreign size_t,
    name: string)
  if reflect.find_nominal(name) ~= nil then return end
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  transfer_load_module(L, module, module_len as foreign unsigned long long)
end

local function initialize_nominal(module: string, name: string)
  initialize_nominal_raw(module, #module as foreign size_t, name)
end

-- Classify scalar Lua tags without allocating a reflect.Value. A branded
-- closure returns false and is then fully checked against its module manifest;
-- neither path requests reflection's eagerly hydrated function signature.
local function scalar_to_message(
    candidate: value, message: foreign *titan_async_message): boolean
  local raw: foreign TValue = candidate
  local tag = ffi.lmacro_ttype(raw)
  if tag == ffi.LUA_TNIL then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_NIL
  elseif tag == ffi.LUA_TBOOLEAN then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_BOOLEAN
    if candidate then message.integer = 1 else message.integer = 0 end
  elseif tag == ffi.LUA_TNUMBER then
    if ffi.lmacro_ttypetag(raw) == ffi.LUA_VNUMINT then
      local item: integer = candidate
      message.kind = ffi.TITAN_ASYNC_MESSAGE_INTEGER
      message.integer = item
    else
      local item: float = candidate
      message.kind = ffi.TITAN_ASYNC_MESSAGE_FLOAT
      message.number = item
    end
  elseif tag == ffi.LUA_TSTRING then
    local item: string = candidate
    message.kind = ffi.TITAN_ASYNC_MESSAGE_STRING
    message.bytes = item
    message.length = #item
  elseif tag == ffi.LUA_TLIGHTUSERDATA then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_POINTER
    message.pointer = ffi.lmacro_pvalue(raw)
  elseif tag == ffi.LUA_TTHREAD then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_STATE
    message.state = ffi.lmacro_thvalue(raw)
  elseif tag == ffi.LUA_TUSERDATA then
    local userdata = ffi.lmacro_uvalue(raw)
    if userdata.metatable ~= nil then
      local mt_value: foreign TValue = nil
      ffi.lmacro_sethvalue(L, mt_value, userdata.metatable)
      local mt: {value: value} = mt_value as value
      local brand: integer? = mt[ffi.TITAN_BRAND]
      if brand ~= nil then
        if brand >= (ffi.TITAN_ARRAY as integer) and brand <= (ffi.TITAN_OWNED as integer) then
          return false
        end
      end
    end
    -- Unbranded/unknown-brand Lua userdata keeps the existing borrowed payload
    -- policy; known unsupported Titan brands still go through normal rejection.
    message.kind = ffi.TITAN_ASYNC_MESSAGE_POINTER
    message.pointer = ffi.lmacro_getudatamem(userdata)
  elseif tag == ffi.LUA_TFUNCTION then
    local entry: foreign function(*lua_State): int = nil
    if ffi.lmacro_ttislcf(raw) ~= 0 then
      entry = ffi.lmacro_fvalue(raw)
    elseif ffi.lmacro_ttisCclosure(raw) ~= 0 then
      local closure = ffi.lmacro_clCvalue(raw)
      if closure.nupvalues == 0 then
        entry = closure.f
      else
        if closure.nupvalues >= 5 then
          local upvalues = closure.upvalue as foreign *TValue
          if ffi.lmacro_ttislightuserdata(upvalues[3]) ~= 0 then
            if ffi.lmacro_pvalue(upvalues[3]) == ffi.TITAN_BRAND then return false end
          end
        end
        raise "transfer: cannot transfer a Lua C closure with upvalues"
      end
    else
      raise "transfer: unsupported value"
    end
    if entry == nil then raise "cannot transfer a NULL Lua C function" end
    message.kind = ffi.TITAN_ASYNC_MESSAGE_FUNCTION
    message.function = entry
  else
    return false
  end
  return true
end

local function snapshot_record(candidate: reflect.RecordValue): string
  local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
  ffi.titan_protobuf_buf_init_heap(buf, 0)
  defer ffi.titan_protobuf_buf_free_heap(buf)
  protobuf.serialize_inspected_record_to_buffer(buf as foreign *void, candidate)
  return copy_native_bytes(buf.data as foreign const *char, buf.length)
end

local function snapshot_union(candidate: reflect.UnionValue): string
  local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
  ffi.titan_protobuf_buf_init_heap(buf, 0)
  defer ffi.titan_protobuf_buf_free_heap(buf)
  protobuf.serialize_inspected_union_to_buffer(buf as foreign *void, candidate)
  return copy_native_bytes(buf.data as foreign const *char, buf.length)
end

--- Select the copy or borrow policy for a value, preserving an explicit TransferValue.
-- Public records may provide synchronous to_transfer_payload/from_transfer_payload hooks.
-- The hooks take precedence over structural protobuf encoding and may encapsulate private fields.
-- @param candidate Scalar, public nominal, Titan closure, or explicit transfer policy.
-- @return Flat transfer policy; closure captures and custom hooks are snapshotted now.
-- @usage async-io.md#custom-record-transfer
function TransferValue.from_value(candidate: value): TransferValue
  if candidate is TransferValue then return candidate end
  local message = foreign titan_async_message.new()
  if scalar_to_message(candidate, message) then
    local kind = message.kind
    if kind == ffi.TITAN_ASYNC_MESSAGE_NIL then return TransferValue.is_nil()
    elseif kind == ffi.TITAN_ASYNC_MESSAGE_BOOLEAN then
      return TransferValue.is_boolean(message.integer ~= 0)
    elseif kind == ffi.TITAN_ASYNC_MESSAGE_INTEGER then
      return TransferValue.is_integer(message.integer)
    elseif kind == ffi.TITAN_ASYNC_MESSAGE_FLOAT then
      return TransferValue.is_float(message.number)
    elseif kind == ffi.TITAN_ASYNC_MESSAGE_STRING then return TransferValue.is_string(candidate)
    elseif kind == ffi.TITAN_ASYNC_MESSAGE_POINTER then
      return TransferValue.is_pointer(message.pointer)
    elseif kind == ffi.TITAN_ASYNC_MESSAGE_STATE then
      return TransferValue.is_lua_state(message.state)
    else return TransferValue.is_function(message.function)
    end
  end
  local raw: foreign TValue = candidate
  if ffi.lmacro_ttype(raw) == ffi.LUA_TFUNCTION then return snapshot_closure(candidate) end
  case reflect.inspect(candidate)
  when is_lua_userdata() then
    return TransferValue.is_pointer(ffi.lmacro_getudatamem(ffi.lmacro_uvalue(raw)))
  when is_record(record_value) then
    local encode? = protobuf.find_transfer_hooks(record_value.type, "transfer")
    local module = nominal_module(candidate)
    if encode ~= nil then
      local payload = encode_record_payload(record_value, encode)
      return TransferValue.is_record_payload(module, record_value.type.name, payload)
    end
    return TransferValue.is_record(
        module, record_value.type.name, snapshot_record(record_value))
  when is_union(union_value) then
    return TransferValue.is_union(
        nominal_module(candidate), union_value.type.name, snapshot_union(union_value))
  else raise "transfer: unsupported value"
  end
end

local function pointer_to_value(pointer: foreign *void): value
  local top = ffi.lua_gettop(L)
  if ffi.lua_checkstack(L, 1) == 0 then raise "cannot reserve transfer pointer stack" end
  ffi.lua_pushlightuserdata(L, pointer)
  local result: value = ffi.lua_totvalue(L, -1)
  ffi.lua_settop(L, top)
  return result
end

local function cfunction_to_value(item: foreign function (*lua_State): int): value
  if not item then raise "cannot transfer a NULL Lua C function" end
  local top = ffi.lua_gettop(L)
  if ffi.lua_checkstack(L, 1) == 0 then raise "cannot reserve transfer function stack" end
  ffi.lua_pushcclosure(L, item, 0)
  local result: value = ffi.lua_totvalue(L, -1)
  ffi.lua_settop(L, top)
  return result
end

--- Wrap copied closure packet fields at a trusted Lua/lightuserdata boundary.
-- The entry is validated against the destination manifest only by to_value.
function TransferValue.from_closure_payload(module: string, entry: value,
    data: string): TransferValue
  return TransferValue.is_closure(module, entry as foreign const *void, data)
end

local function restore_closure_from_buffer(
    module: foreign const *char,
    module_len: foreign size_t,
    token: foreign const *void,
    data: foreign const *void,
    data_len: integer): value
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  transfer_load_module(L, module, module_len as foreign unsigned long long)
  local module_index = ffi.lua_gettop(L)
  -- Resolve the token by equality against the destination module's manifest
  -- before dereferencing it or reconstructing resource-bearing captures.
  local entry = transfer_resolve(L, module_index, token)
  local count = transfer_capture_count(entry) as integer
  local policies: {TransferValue}, was_policy: {value} =
    protobuf.deserialize_fields_buffer(data, data_len, closure_fields)
  if #policies ~= count or #was_policy ~= count then
    raise "invalid closure capture count"
  end
  -- Arrays can contain holes independently of their element descriptor.
  -- Check the complete frontier before a custom decoder can adopt anything.
  for index = 1, count do
    local policy: TransferValue = policies[index]
    -- An implicit projection checks the boolean tag; written `is boolean`
    -- accepts every value through Lua truthiness.
    local flag: boolean = was_policy[index]
  end
  if ffi.lua_checkstack(L, (count + 1) as foreign int) == 0 then
    raise "cannot reserve transfer closure stack"
  end
  for index = 1, count do
    local policy = policies[index]
    if was_policy[index] then ffi.lua_pushtvalue(L, policy)
    else ffi.lua_pushtvalue(L, policy:to_value()) end
  end
  transfer_restore(L, entry, module_index, (module_index + 1) as foreign int)
  return ffi.lua_totvalue(L, -1) as value
end

local function decode_record_payload(
    module: foreign const *char,
    module_len: foreign size_t,
    name: string,
    payload: string): value
  initialize_nominal_raw(module, module_len, name)
  local nominal? = reflect.find_nominal(name)
  if nominal == nil then raise "transfer: unknown record type " .. name end
  case nominal
  when is_record(descriptor) then
    local _?, decode? = protobuf.find_transfer_hooks(descriptor, "transfer")
    if decode == nil then raise "transfer: record has no payload hooks: " .. name end
    local result: value = decode.callable(payload)
    case reflect.inspect(result)
    when is_record(record_value) then
      if record_value.type.name == name then return result end
    end
    raise "transfer: from_transfer_payload returned a different record: " .. name
  else raise "transfer: nominal type is not a record: " .. name
  end
end

--- Recover a semantic value from a transfer policy in the current Lua state.
-- Custom record reconstruction invokes its synchronous from_transfer_payload hook.
-- Raw pointer policies remain borrowed; custom resource hooks may adopt ownership.
-- @return Scalar, borrowed address, callable, or reconstructed nominal value.
-- @usage async-io.md#custom-record-transfer
function TransferValue:to_value(): value
  case self
  when is_nil() then return nil
  when is_boolean(item) then return item
  when is_integer(item) then return item
  when is_float(item) then return item
  when is_string(item) then return item
  when is_lua_state(item) then return pointer_to_value(item)
  when is_pointer(item) then return pointer_to_value(item)
  when is_function(item) then return cfunction_to_value(item)
  when is_record(module, name, data) then
    initialize_nominal(module, name)
    return protobuf.deserialize_nominal(data, name, false)
  when is_union(module, name, data) then
    initialize_nominal(module, name)
    return protobuf.deserialize_nominal(data, name, true)
  when is_closure(module, token, data) then
    -- data remains rooted in self throughout restore_closure_from_buffer.
    return restore_closure_from_buffer(
        module,
        #module as foreign size_t,
        token,
        ffi.titan_protobuf_bytes_ptr(data) as foreign const *void,
        #data)
  when is_record_payload(module, name, payload) then
    return decode_record_payload(module, #module as foreign size_t, name, payload)
  end
end


local function copy_async_message(
    input: foreign *titan_async_message): foreign *titan_async_message
  local copied = copy_message(input as foreign const *void) as foreign *titan_async_message
  if copied == nil then
    raise "transfer: out of memory copying message"
  end
  return copied
end

local function finalize_buf_message(
    buf: foreign *titan_protobuf_buffer,
    kind: foreign titan_async_message_kind,
    name: string,
    module: string,
    entry: foreign const *void): foreign *titan_async_message
  local header_size = foreign titan_async_message.sizeof
  local wire_len = (buf.length - header_size) as foreign size_t
  local name_len = #name as foreign size_t
  local module_len = #module as foreign size_t
  if ffi.titan_protobuf_buf_write_raw(buf, name, name_len) == 0 then
    raise "transfer: out of memory copying message"
  end
  if ffi.titan_protobuf_buf_write_raw(buf, module, module_len) == 0 then
    raise "transfer: out of memory copying message"
  end
  local msg = ffi.titan_protobuf_buf_take_data(buf) as foreign *titan_async_message
  local base = (msg + 1) as foreign *char
  ffi.memset(msg, 0, header_size)
  msg.kind = kind
  msg.bytes = base
  msg.length = wire_len
  msg.name = base + wire_len
  msg.name_length = name_len
  msg.module = base + wire_len + name_len
  msg.module_length = module_len
  msg.entry = entry
  return msg
end

local function transfer_policy_to_message(
    data: TransferValue): foreign *titan_async_message
  local message = foreign titan_async_message.new()
  case data
  when is_nil() then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_NIL
  when is_boolean(item) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_BOOLEAN
    if item then message.integer = 1 else message.integer = 0 end
  when is_integer(item) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_INTEGER
    message.integer = item
  when is_float(item) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_FLOAT
    message.number = item
  when is_string(item) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_STRING
    message.bytes = item
    message.length = #item
  when is_lua_state(item) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_STATE
    message.state = item
  when is_function(item) then
    if not item then
      raise "cannot send a NULL Lua C function"
    end
    message.kind = ffi.TITAN_ASYNC_MESSAGE_FUNCTION
    message.function = item
  when is_pointer(item) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_POINTER
    message.pointer = item
  when is_record(module, name, bytes) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_RECORD
    message.module = module
    message.module_length = #module
    message.name = name
    message.name_length = #name
    message.bytes = bytes
    message.length = #bytes
  when is_union(module, name, bytes) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_UNION
    message.module = module
    message.module_length = #module
    message.name = name
    message.name_length = #name
    message.bytes = bytes
    message.length = #bytes
  when is_closure(module, entry, bytes) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_CLOSURE
    message.module = module
    message.module_length = #module
    message.entry = entry
    message.bytes = bytes
    message.length = #bytes
  when is_record_payload(module, name, payload) then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_RECORD_PAYLOAD
    message.module = module
    message.module_length = #module
    message.name = name
    message.name_length = #name
    message.bytes = payload
    message.length = #payload
  end
  return copy_async_message(message)
end

local function encode_packet(candidate: value, scope: ResourceScope): foreign *void
  if candidate is TransferValue then
    return transfer_policy_to_message(candidate as TransferValue) as foreign *void
  end
  local message = foreign titan_async_message.new()
  if scalar_to_message(candidate, message) then
    return copy_async_message(message) as foreign *void
  end
  local raw: foreign TValue = candidate
  if ffi.lmacro_ttype(raw) == ffi.LUA_TFUNCTION then
    local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
    if ffi.titan_protobuf_buf_init_heap(buf, foreign titan_async_message.sizeof) == 0 then
      raise "transfer: out of memory copying message"
    end
    defer ffi.titan_protobuf_buf_free_heap(buf)
    local module, entry = snapshot_closure_to_buffer(buf, candidate)
    return finalize_buf_message(
        buf, ffi.TITAN_ASYNC_MESSAGE_CLOSURE, "", module, entry) as foreign *void
  end
  case reflect.inspect(candidate)
  when is_lua_userdata() then
    message.kind = ffi.TITAN_ASYNC_MESSAGE_POINTER
    message.pointer = ffi.lmacro_getudatamem(ffi.lmacro_uvalue(raw))
    return copy_async_message(message) as foreign *void
  when is_record(record_value) then
    local encode? = protobuf.find_transfer_hooks(record_value.type, "transfer")
    local module = nominal_module(candidate)
    local name = record_value.type.name
    if encode ~= nil then
      local payload = encode_record_payload(record_value, encode)
      local message = foreign titan_async_message.new()
      message.kind = ffi.TITAN_ASYNC_MESSAGE_RECORD_PAYLOAD
      message.module = module
      message.module_length = #module
      message.name = name
      message.name_length = #name
      message.bytes = payload
      message.length = #payload
      return copy_async_message(message) as foreign *void
    end
    local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
    if ffi.titan_protobuf_buf_init_heap(buf, foreign titan_async_message.sizeof) == 0 then
      raise "transfer: out of memory copying message"
    end
    defer ffi.titan_protobuf_buf_free_heap(buf)
    protobuf.serialize_inspected_record_to_buffer(buf as foreign *void, record_value, scope)
    return finalize_buf_message(
        buf, ffi.TITAN_ASYNC_MESSAGE_RECORD, name, module, nil) as foreign *void
  when is_union(union_value) then
    local module = nominal_module(candidate)
    local name = union_value.type.name
    local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
    if ffi.titan_protobuf_buf_init_heap(buf, foreign titan_async_message.sizeof) == 0 then
      raise "transfer: out of memory copying message"
    end
    defer ffi.titan_protobuf_buf_free_heap(buf)
    protobuf.serialize_inspected_union_to_buffer(buf as foreign *void, union_value, scope)
    return finalize_buf_message(
        buf, ffi.TITAN_ASYNC_MESSAGE_UNION, name, module, nil) as foreign *void
  else
    raise "transfer: unsupported value"
  end
end
--- Encode one independently owned packet. Nested calls get their own exact
-- scope; all protobuf and hook work belonging to this packet shares its table.
function encode_message(candidate: value): foreign *void
  local native = foreign titan_transfer_scope_owner.new()
  local execution = current_execution()
  local previous? = resource_scopes[execution]
  local scope = ResourceScope {
    encoding = true,
    native = native,
    message = nil,
    execution = execution,
    previous = previous,
  }
  gc.finalizable(scope, finalize_resource_scope)
  defer do
    resource_scopes[execution] = previous
    dispose_scope(scope.native)
  end
  resource_scopes[execution] = scope
  local raw = encode_packet(candidate, scope)
  -- Native commit cannot allocate or yield. Until this point only the scope
  -- owns the table, independent of payload buffer reallocation/detachment.
  commit_resources(raw as foreign *titan_async_message,
      ffi.titan_transfer_scope_resources(scope.native))
  return raw
end


local function copy_native_bytes(bytes: foreign const *char, length: foreign size_t): string
  if length == 0 then return "" end
  local top = ffi.lua_gettop(L)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for transfer message bytes"
  end
  ffi.lua_pushlstring(L, bytes, length)
  local result: value = ffi.lua_totvalue(L, -1)
  ffi.lua_settop(L, top)
  return result as string
end

-- The foreign boundary retains the caller's slot through this ordinary
-- worker's entry preparation. Only a completely prepared scope takes it.
local function decode_message_worker(slot_value: value): value
  local slot = slot_value as foreign *(*void)
  local message = slot[0] as foreign *titan_async_message
  if message == nil then raise "transfer: cannot decode a NULL packet" end
  local native = foreign titan_transfer_scope_owner.new()
  local execution = current_execution()
  local previous? = resource_scopes[execution]
  local scope = ResourceScope {
    encoding = false,
    native = native,
    message = message,
    execution = execution,
    previous = previous,
  }
  gc.finalizable(scope, finalize_resource_scope)
  defer do
    resource_scopes[execution] = previous
    dispose_scope(scope.native)
  end
  resource_scopes[execution] = scope
  -- A single native move commits both sides after all allocating preparation.
  move_slot_to_scope(scope.native, slot)
  local kind = message.kind
  if kind == ffi.TITAN_ASYNC_MESSAGE_NIL then
    return nil
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_BOOLEAN then
    return message.integer ~= 0
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_INTEGER then
    return message.integer
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_FLOAT then
    return message.number
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_STRING then
    return copy_native_bytes(message.bytes, message.length)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_STATE then
    return pointer_to_value(message.state as foreign *void)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_FUNCTION then
    return cfunction_to_value(message.function)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_POINTER then
    return pointer_to_value(message.pointer)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_RECORD then
    local name = copy_native_bytes(message.name, message.name_length)
    initialize_nominal_raw(message.module, message.module_length, name)
    return protobuf.deserialize_nominal_buffer_with_context(
        message.bytes as foreign const *void,
        message.length as integer,
        name,
        false, scope)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_UNION then
    local name = copy_native_bytes(message.name, message.name_length)
    initialize_nominal_raw(message.module, message.module_length, name)
    return protobuf.deserialize_nominal_buffer_with_context(
        message.bytes as foreign const *void,
        message.length as integer,
        name,
        true, scope)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_CLOSURE then
    return restore_closure_from_buffer(
        message.module,
        message.module_length,
        message.entry,
        message.bytes as foreign const *void,
        message.length as integer)
  elseif kind == ffi.TITAN_ASYNC_MESSAGE_RECORD_PAYLOAD then
    local name = copy_native_bytes(message.name, message.name_length)
    local payload = copy_native_bytes(message.bytes, message.length)
    return decode_record_payload(
        message.module, message.module_length, name, payload)
  end
  raise "invalid transfer message kind"
end
--- An opaque, single-owner packet capability with idempotent close.
-- Reference copies share its consumed state; they do not clone the packet.
record Packet
  local native: foreign titan_transfer_packet_owner
end

--- Dispose the current packet and its unclaimed resources; repeated close is safe.
function Packet:close()
  discard_message(take_packet_message(self.native as foreign *void))
end

local function finalize_packet(packet: Packet)
  discard_message(take_packet_message(packet.native as foreign *void))
end

--- Prepare an inert, finalized holder before acquiring any raw packet ownership.
function Packet.new(): Packet
  local native = foreign titan_transfer_packet_owner.new()
  local packet: Packet = { native = native }
  gc.finalizable(packet, finalize_packet)
  return packet
end

--- Borrow the stable native holder; this pointer neither owns nor roots the Packet.
function Packet:borrow_owner(): foreign *void
  return self.native as foreign *void
end


--- Encode a value and acquire its resource attachments in a finalized Packet.
function Packet.from_value(candidate: value): Packet
  local packet = Packet.new()
  local owner = packet:borrow_owner()
  local raw = encode_message(candidate)
  defer discard_message(raw)
  local status = adopt_into(owner, raw)
  if status ~= 0 then raise_message_error(status, nil) end
  return packet
end

--- Borrow the current message without transferring ownership or rooting its Packet.
-- The borrow expires on close, decode, take, or committed publication; it must
-- never be discarded, decoded, or adopted while this Packet still owns it.
function Packet:borrow_message(): foreign *void
  local raw = self.native.message as foreign *void
  if raw == nil then raise "transfer: packet is consumed or closed" end
  return raw
end

--- Consume this Packet and transfer its raw owner to exactly one consuming API.
function Packet:take_message(): foreign *void
  local raw = self.native.message as foreign *void
  if raw == nil then raise "transfer: packet is consumed or closed" end
  return take_packet_message(self.native as foreign *void)
end

-- This zero-upvalue thunk and its protected caller are C-only. In
-- particular no ordinary Titan preamble runs after a raw slot is entrusted to
-- this boundary and before its native residual-owner cleanup is installed.
local foreign function decode_message_dispatch(state: *lua_State): int
  local slot = ffi.lua_touserdata(state, 1) as foreign *(*void)
  ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, "Titan transfer decode worker")
  if ffi.lua_type(state, -1) ~= ffi.LUA_TFUNCTION then
    ffi.lua_settop(state, 1)
    transfer_load_module(state, "titan.transfer", 14 as foreign unsigned long long)
    ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, "Titan transfer decode worker")
  end
  ffi.lua_pushlightuserdata(state, slot)
  ffi.lua_callk(state, 1, 1, 0 as foreign lua_KContext, nil)
  return 1
end

--- Consume and clear the actual guarded packet slot through protected Lua decode.
-- Call directly at that local so its cleared spill commits before ordinary
-- error propagation. Never rethrow inside this foreign boundary.
-- Status 0 leaves one result; positive Lua status leaves one rooted error;
-- negative status adds no stack value (-2 invalid slot, -3 stack OOM).
-- Snapshot a positive-status error in the caller before any ordinary helper,
-- then restore its stack and pass that traced value to raise_message_error.
foreign function decode_message(state: *lua_State, slot: *(*void)): int
  if slot == nil then return -2 end
  if ffi.lua_checkstack(state, 3) == 0 then
    local raw = slot[0]
    slot[0] = nil
    discard_message(raw)
    return -3
  end
  local top = ffi.lua_gettop(state)
  -- Keep these pushes allocation-free (zero-upvalue C closures/lightuserdata).
  -- A Packet owner may already have moved its message into a raw C local;
  -- no throwing operation may precede the protected call that guards it.
  ffi.lua_pushcclosure(state, ffi.errorhandler, 0)
  ffi.lua_pushcclosure(state, decode_message_dispatch, 0)
  ffi.lua_pushlightuserdata(state, slot)
  local status = ffi.lua_pcallk(state, 1, 1, top + 1, 0 as foreign lua_KContext, nil)
  local remaining = slot[0]
  slot[0] = nil
  discard_message(remaining)
  -- Keep exactly the result/error rooted while removing the message handler.
  ffi.lua_copy(state, -1, top + 1)
  ffi.lua_settop(state, top + 1)
  return status as foreign int
end

local foreign function decode_packet_owner(state: *lua_State, raw_owner: *void): int
  local owner = raw_owner as foreign *titan_transfer_packet_owner
  if owner.message == nil then return -1 end
  local raw = take_packet_message(raw_owner)
  return decode_message(state, raw)
end

--- Raise an error after a native packet operation commits its owner-slot update.
-- Pass the caller's traced error for a positive status, nil for a negative
-- setup status. Success needs no ordinary helper entry.
function raise_message_error(status: integer, failure: value)
  if status == -1 then raise "transfer: packet is consumed or closed" end
  if status == -2 then raise "transfer: invalid packet owner slot" end
  if status == -4 then raise "transfer: packet destination is not empty" end
  if status == -5 then raise "transfer: cannot adopt a NULL packet" end
  if status < 0 then raise "transfer: cannot reserve packet operation stack" end
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "transfer: cannot reserve packet error stack"
  end
  ffi.lua_pushboolean(L, 1)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
  raise failure
end

--- Consume and decode the packet, disposing unclaimed attachments on every outcome.
function Packet:decode(): value
  local owner = self:borrow_owner()
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  local status = decode_packet_owner(L, owner)
  if status ~= 0 then
    local failure: value = nil
    if status > 0 then failure = ffi.lua_totvalue(L, -1) as value end
    raise_message_error(status, failure)
  end
  return ffi.lua_totvalue(L, -1) as value
end


do
  protobuf.set_packet_context_provider(packet_context)
  gc.ephemeron(resource_scopes as {value: value})
  gc.ephemeron(transfer_active_closures as {value: value})
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then raise "transfer: cannot reserve packet worker stack" end
  ffi.lua_pushtvalue(L, decode_message_worker)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "Titan transfer decode worker")
  closure_fields = {
    reflect.Type.is_array(reflect.ArrayTypeConstness.is_mutable(),
      reflect.Type.is_named(reflect.NamedType("titan.transfer.TransferValue"))),
    reflect.Type.is_array(reflect.ArrayTypeConstness.is_mutable(),
      reflect.Type.is_boolean()),
  }
end
