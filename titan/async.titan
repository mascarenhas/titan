    if completed == 3 then waiting:resume() end
  end
  defer third:remove_terminal_listener(third_listener)
  if third_result == nil then third:add_terminal_listener(third_listener) end

  suspend()
  return first_result as TaskStatus, second_result as TaskStatus,
         third_result as TaskStatus
end

