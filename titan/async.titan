--- Wait for every one of 5 Tasks and return their terminal statuses without raising their outcomes.
-- @param first First Task operand.
-- @param second Second Task operand.
-- @param third Third Task operand.
-- @param fourth Fourth Task operand.
-- @param fifth Fifth Task operand.
-- @return 5 TaskStatus values in operand order.
-- @usage async-io.md
function join_five<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>,
    third: Task<|A3, B3|>, fourth: Task<|A4, B4|>,
    fifth: Task<|A5, B5|>):
    (TaskStatus<|A1, B1|>, TaskStatus<|A2, B2|>,
     TaskStatus<|A3, B3|>, TaskStatus<|A4, B4|>, TaskStatus<|A5, B5|>)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)
  reject_running(current, fourth)
  reject_running(current, fifth)

  local completed = 0
  local first_result: TaskStatus<|value, value|>? = nil
  if first.phase == TASK_FINISHED then
    first_result = first:status()
    completed = completed + 1
  end
  local second_result: TaskStatus<|value, value|>? = nil
  if second.phase == TASK_FINISHED then
    second_result = second:status()
    completed = completed + 1
  end
  local third_result: TaskStatus<|value, value|>? = nil
  if third.phase == TASK_FINISHED then
    third_result = third:status()
    completed = completed + 1
  end
  local fourth_result: TaskStatus<|value, value|>? = nil
  if fourth.phase == TASK_FINISHED then
    fourth_result = fourth:status()
    completed = completed + 1
  end
  local fifth_result: TaskStatus<|value, value|>? = nil
  if fifth.phase == TASK_FINISHED then
    fifth_result = fifth:status()
    completed = completed + 1
  end
  if completed == 5 then
    return first_result as TaskStatus<|A1, B1|>, second_result as TaskStatus<|A2, B2|>,
           third_result as TaskStatus<|A3, B3|>, fourth_result as TaskStatus<|A4, B4|>,
           fifth_result as TaskStatus<|A5, B5|>
  end

  local resume_token = ResumeToken("async.join_five")
  local waiting = current
  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if first_result ~= nil then return end
    first_result = status
    completed = completed + 1
    if completed == 5 then waiting:resume(resume_token) end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if second_result ~= nil then return end
    second_result = status
    completed = completed + 1
    if completed == 5 then waiting:resume(resume_token) end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<|A3, B3|>)
    if third_result ~= nil then return end
    third_result = status
    completed = completed + 1
    if completed == 5 then waiting:resume(resume_token) end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  local fourth_listener = function (status: TaskStatus<|A4, B4|>)
    if fourth_result ~= nil then return end
    fourth_result = status
    completed = completed + 1
    if completed == 5 then waiting:resume(resume_token) end
  end
  local remove_fourth_listener = fourth:add_terminal_listener(fourth_listener)
  defer remove_fourth_listener()

  local fifth_listener = function (status: TaskStatus<|A5, B5|>)
    if fifth_result ~= nil then return end
    fifth_result = status
    completed = completed + 1
    if completed == 5 then waiting:resume(resume_token) end
  end
  local remove_fifth_listener = fifth:add_terminal_listener(fifth_listener)
  defer remove_fifth_listener()

  suspend(resume_token)
  return first_result as TaskStatus<|A1, B1|>, second_result as TaskStatus<|A2, B2|>,
         third_result as TaskStatus<|A3, B3|>, fourth_result as TaskStatus<|A4, B4|>,
         fifth_result as TaskStatus<|A5, B5|>
end

-- Contributor to async. All Task/Runtime ownership stays inside this module;
-- an ordinary os import calls this public operation without source privileges.
--- Request a process exit after cancellation and native ownership cleanup.
-- @param code Final process exit code.
-- @usage async-io.md
function request_exit(code: integer)
  local task = running()
  local runtime = task.runtime
  if runtime.exit_code == nil then runtime.exit_code = code end
  uv.unbind_transfer_loop(runtime.loop)
  local index = 1
  while index < runtime.next_task do
    local other? = runtime.tasks[index]
    if other ~= nil then
      other:cancel(CancellationReason.simple("program exit"))
    end
    index = index + 1
  end
  raise task.cancel_value
end

-- Merge declarations into async and the final initializer into its sole root
-- initializer. async already imports lua.h and titan/ffi.h; this header is
-- OS-only and introduces no transitive libuv dependency.
foreign import "async_signal_platform.h"

local function bootstrap(main_callable: function ({string}): (integer),
                         args: {string}): integer
  local result = 1
  local task = run<|value, value|>(function (): value
    result = main_callable(args)
    return nil
  end)
  loop()
  local exit_code? = task.runtime.exit_code
  if exit_code ~= nil then return exit_code end
  local succeeded = task:status():has_succeeded()
  if succeeded then return result end
  return 1
end

local const COMPACT_MIN_PREFIX = 32

-- Payload presence is carried by this record, never by Array length or truthiness.
local record Item<|T|>
  value: T
end

--- Transferred subscription items with explicit count, preserving nil and false payloads.
-- @field count Number of items available through one-based get.
-- @usage async-io.md
record SubscriptionBatch<|T|>
  const count: integer
  local const first: integer
  local const items: {Item<|T|>}
end

--- Read one item from a transferred batch without using payload truthiness.
-- @param index One-based index in 1..count.
-- @return Exact typed item, including nil when its type permits it.
-- @usage async-io.md
function SubscriptionBatch:get(index: integer): T
  if index < 1 or index > self.count then raise "subscription batch index out of range" end
  return self.items[self.first + index - 1].value
end

--- One persistent-source item or terminal subscription outcome.
-- @field item One item, including nil or false payloads.
-- @field error Terminal producer error after queued items.
-- @field ended Producer finished and queued items are exhausted.
-- @field closed Subscription was closed.
-- @usage async-io.md
union SubscriptionResult<|T, E|>
  item(T)
  error(E)
  ended()
  closed()
end

--- Buffered items or a terminal persistent-source outcome.
-- @field batch Transferred batch with explicit count.
-- @field error Terminal producer error after queued items.
-- @field ended Producer finished and queued items are exhausted.
-- @field closed Subscription was closed.
-- @usage async-io.md
union SubscriptionBatchResult<|T, E|>
  batch(SubscriptionBatch<|T|>)
  error(E)
  ended()
  closed()
end

--- Producer-owned stop and close actions returned during subscription registration.
-- @field stop Synchronous nonyielding action stopping production.
-- @field close Cleanup action receiving an unread-batch drain function for resource disposal.
-- @usage async-io.md
record SubscriptionActions<|T|>
  const stop: function (): ()
  const close: function (function (): (SubscriptionBatch<|T|>)): ()
end

local union Terminal<|E|>
  live()
  ended()
  error(E)
  closed()
end

local record Waiter
  task: Task<|value, value|>
  token: ResumeToken
  notified: boolean
  batch: boolean
end

local record Core<|T, E|>
  items: {Item<|T|>}
  first: integer
  count: integer
  coalescing: boolean
  terminal: Terminal<|E|>
  stopped: boolean
  waiter: Waiter?
  actions: SubscriptionActions<|T|>?
  drain: (function (): (SubscriptionBatch<|T|>))?
end

--- Persistent source retaining only the latest safely discardable unread item.
-- @usage async-io.md
record CoalescingSubscription<|T, E|>
  local core: Core<|T, E|>
end

--- Persistent source retaining every unread item in publication order.
-- @usage async-io.md
record BufferedSubscription<|T, E|>
  local core: Core<|T, E|>
end

local function Core:is_live(): boolean
  case self.terminal
  when live() then return true
  else return false
  end
end

local function Core:wake()
  local waiter? = self.waiter
  if waiter == nil or waiter.notified then return end
  waiter.notified = true
  do waiter.task:resume(waiter.token)
  catch waiter.notified = false; raise end
end

local function Core:publish(value: T): boolean
  if not self:is_live() then return false end
  local item = Item<|T|>(value)
  local index = self.first
  local old_count = self.count
  if not self.coalescing or self.count == 0 then index = self.first + self.count end
  local previous? = self.items[index]
  self.items[index] = item
  if not self.coalescing or self.count == 0 then self.count = self.count + 1 end
  do self:wake()
  catch
    -- Task.resume either schedules its deferred wake or raises before doing
    -- so. Restore the exact old slot/count before returning producer ownership.
    self.items[index] = previous
    self.count = old_count
    raise
  end
  return true
end

local function Core:fail(error: E): boolean
  if not self:is_live() then return false end
  local previous = self.terminal
  self.terminal = Terminal<|E|>.error(error)
  do self:wake()
  catch self.terminal = previous; raise end
  return true
end

local function Core:finish(): boolean
  if not self:is_live() then return false end
  local previous = self.terminal
  self.terminal = Terminal<|E|>.ended()
  do self:wake()
  catch self.terminal = previous; raise end
  return true
end

local function Core:detach(): SubscriptionBatch<|T|>
  local replacement: {Item<|T|>} = {}
  local batch: SubscriptionBatch<|T|> = {
    count = self.count, first = self.first, items = self.items}
  self.items = replacement
  self.first = 1
  self.count = 0
  return batch
end

local function Core.new(coalescing: boolean): Core<|T, E|>
  local core: Core<|T, E|> = {items = {}, first = 1, count = 0,
    coalescing = coalescing, terminal = Terminal<|E|>.live(), stopped = false,
    waiter = nil, actions = nil, drain = nil}
  core.drain = function (): SubscriptionBatch<|T|> return core:detach() end
  return core
end

local function Core:register(producer: function (function (T): (boolean), function (E): (boolean), function (): (boolean)): (SubscriptionActions<|T|>))
  local core = self
  local publish = function (item: T): boolean return core:publish(item) end
  local fail = function (error: E): boolean return core:fail(error) end
  local finish = function (): boolean return core:finish() end
  -- The producer must prebuild its actions before accepting resources. Until
  -- it returns, partial-registration rollback remains the producer's job.
  local actions = producer(publish, fail, finish)
  core.actions = actions
end

--- Register a persistent producer retaining the latest safely discardable value.
-- @param producer Called once with publish, fail, and finish capabilities; prebuild actions and roll back partial resource acceptance.
-- @return Registered subscription; rejected publication leaves event ownership with the producer.
-- @usage async-io.md
function CoalescingSubscription.new(producer: function (function (T): (boolean), function (E): (boolean), function (): (boolean)): (SubscriptionActions<|T|>)): CoalescingSubscription<|T, E|>
  local core = Core<|T, E|>(true)
  local subscription: CoalescingSubscription<|T, E|> = {core = core}
  core:register(producer)
  return subscription
end

--- Register a persistent producer retaining the every value in order.
-- @param producer Called once with publish, fail, and finish capabilities; prebuild actions and roll back partial resource acceptance.
-- @return Registered subscription; rejected publication leaves event ownership with the producer.
-- @usage async-io.md
function BufferedSubscription.new(producer: function (function (T): (boolean), function (E): (boolean), function (): (boolean)): (SubscriptionActions<|T|>)): BufferedSubscription<|T, E|>
  local core = Core<|T, E|>(false)
  local subscription: BufferedSubscription<|T, E|> = {core = core}
  core:register(producer)
  return subscription
end

local function Core:wait(batch: boolean)
  local task = running()
  local token = ResumeToken("subscription")
  local waiter = Waiter(task, token, false, batch)
  local core = self
  local detach = function ()
    if core.waiter == waiter then core.waiter = nil end
  end
  self.waiter = waiter
  defer detach()
  suspend(token, detach)
end

local function Core:prepare_read(batch: boolean)
  local task = running()
  if self.waiter ~= nil then raise "subscription already has a waiter" end
  -- Check before transferring any queued resource, without yielding.
  local reason? = task.cancel_value
  if reason ~= nil then raise reason end
  if task.runtime.closing then raise (task.runtime.failure as Error).error end
  if self.count == 0 and self:is_live() then self:wait(batch) end
end

local function Core:compact()
  -- Copy only after the consumed prefix can pay for all remaining elements.
  -- Keep the entire old FIFO owned until replacement allocation/copy succeeds.
  if self.first <= COMPACT_MIN_PREFIX or self.first <= self.count then return end
  local replacement: {Item<|T|>} = {}
  for index = 1, self.count do
    replacement[index] = self.items[self.first + index - 1]
  end
  self.items = replacement
  self.first = 1
end

local function Core:next(): SubscriptionResult<|T, E|>
  self:prepare_read(false)
  case self.terminal
  when closed() then return SubscriptionResult<|T, E|>.closed()
  else
  end
  if self.count > 0 then
    self:compact()
    local item = self.items[self.first]
    local result = SubscriptionResult<|T, E|>.item(item.value)
    self.items[self.first] = nil
    self.first = self.first + 1
    self.count = self.count - 1
    if self.count == 0 then self.first = 1 end
    return result
  end
  case self.terminal
  when error(failure) then return SubscriptionResult<|T, E|>.error(failure)
  when ended() then return SubscriptionResult<|T, E|>.ended()
  when closed() then return SubscriptionResult<|T, E|>.closed()
  when live() then raise "subscription wake has no outcome"
  end
end

local function Core:next_batch(): SubscriptionBatchResult<|T, E|>
  self:prepare_read(true)
  case self.terminal
  when closed() then return SubscriptionBatchResult<|T, E|>.closed()
  else
  end
  if self.count > 0 then
    local replacement: {Item<|T|>} = {}
    local batch: SubscriptionBatch<|T|> = {
      count = self.count, first = self.first, items = self.items}
    local result = SubscriptionBatchResult<|T, E|>.batch(batch)
    self.items = replacement
    self.first = 1
    self.count = 0
    return result
  end
  case self.terminal
  when error(failure) then return SubscriptionBatchResult<|T, E|>.error(failure)
  when ended() then return SubscriptionBatchResult<|T, E|>.ended()
  when closed() then return SubscriptionBatchResult<|T, E|>.closed()
  when live() then return SubscriptionBatchResult<|T, E|>.batch(self:detach())
  end
end

local function Core:stop()
  if self.stopped then return end
  local terminal = self.terminal
  if self:is_live() then terminal = Terminal<|E|>.ended() end
  defer self:wake()
  self.stopped = true
  self.terminal = terminal
  self.actions.stop()
end

local function Core:discard()
  self.items = {}
  self.first = 1
  self.count = 0
  self.actions = nil
  self.drain = nil
end

local function Core:close()
  case self.terminal
  when closed() then return
  else
  end
  running()
  local closing = Terminal<|E|>.closed()
  local actions = self.actions
  local drain = self.drain
  -- Close blocks ordinary delivery immediately. The producer's cleanup may
  -- suspend via await_cleanup and can drain unread resource-bearing events.
  -- Repeated close calls initiate nothing, including while cleanup is pending.
  defer self:discard()
  defer actions.close(drain)
  self.terminal = closing
  self:stop()
  self:wake()
end

--- Read one persistent-source outcome with one shared reader reservation.
-- @return Item or terminal outcome; wait cancellation leaves the producer and queued items alive.
-- @usage async-io.md
function CoalescingSubscription:next(): SubscriptionResult<|T, E|>
  return self.core:next()
end

-- Admission queries use the same reservation that cancellation detaches.
-- A queued wake remains reserved until that reader leaves its wait.
--- Query the exact active reader reservation, including an already queued wake.
-- @return True while a next reader still owns its reservation.
-- @usage async-io.md
function CoalescingSubscription:has_waiter(): boolean
  return self.core.waiter ~= nil
end

--- Stop production synchronously, retaining queued items before the terminal outcome.
-- @usage async-io.md
function CoalescingSubscription:stop()
  self.core:stop()
end

--- Block delivery, stop production, dispose unread items, and finish producer cleanup once.
-- @usage async-io.md
function CoalescingSubscription:close()
  self.core:close()
end

--- Read one persistent-source outcome with one shared reader reservation.
-- @return Item or terminal outcome; wait cancellation leaves the producer and queued items alive.
-- @usage async-io.md
function BufferedSubscription:next(): SubscriptionResult<|T, E|>
  return self.core:next()
end

--- Query the exact active reader reservation, including an already queued wake.
-- @return True while a next or next_batch reader still owns its reservation.
-- @usage async-io.md
function BufferedSubscription:has_waiter(): boolean
  return self.core.waiter ~= nil
end

--- Query whether an unread item or terminal outcome is already available.
-- @return True for queued items, ended, error, or closed; this does not consume or reserve them.
-- @usage async-io.md
function BufferedSubscription:has_pending(): boolean
  return self.core.count > 0 or not self.core:is_live()
end

--- Read and transfer the complete queued batch with the shared reader reservation.
-- @return Batch or terminal outcome; a domain wake may supply an empty batch.
-- @usage async-io.md
function BufferedSubscription:next_batch(): SubscriptionBatchResult<|T, E|>
  return self.core:next_batch()
end

--- Stop production synchronously, retaining queued items before the terminal outcome.
-- @usage async-io.md
function BufferedSubscription:stop()
  self.core:stop()
end

--- Block delivery, stop production, dispose unread items, and finish producer cleanup once.
-- @usage async-io.md
function BufferedSubscription:close()
  self.core:close()
end

-- Producer/domain control operations are synchronous and never suspend.
--- Copy the unread queue and inspect its terminal outcome without consuming it.
-- @return Independent batch plus nil while live, or the ended/error/closed outcome.
-- @usage async-io.md
function BufferedSubscription:snapshot_pending(): (SubscriptionBatch<|T|>, SubscriptionResult<|T, E|>?)
  local core = self.core
  local copied: {Item<|T|>} = {}
  for index = 1, core.count do
    copied[index] = Item<|T|>(core.items[core.first + index - 1].value)
  end
  local batch = SubscriptionBatch<|T|>(core.count, 1, copied)
  case core.terminal
  when live() then return batch, nil
  when ended() then return batch, SubscriptionResult<|T, E|>.ended()
  when error(failure) then return batch, SubscriptionResult<|T, E|>.error(failure)
  when closed() then return batch, SubscriptionResult<|T, E|>.closed()
  end
end

--- Synchronously transfer the complete unread batch to its domain owner.
-- @return Batch with explicit count, possibly empty.
-- @usage async-io.md
function BufferedSubscription:drain_pending(): SubscriptionBatch<|T|>
  return self.core:detach()
end

--- Transfer the complete unread batch only if any item satisfies a domain predicate.
-- @param predicate Nonyielding predicate that must not mutate the subscription.
-- @return Complete batch when any item matches, otherwise nil.
-- @usage async-io.md
function BufferedSubscription:drain_if(predicate: function (T): (boolean)): SubscriptionBatch<|T|>?
  local core = self.core
  for index = core.first, core.first + core.count - 1 do
    if predicate(core.items[index].value) then return core:detach() end
  end
  return nil
end

--- Wake only a blocked batch reader, permitting an empty domain-control batch.
-- @usage async-io.md
function BufferedSubscription:wake_batch()
  local waiter? = self.core.waiter
  if waiter ~= nil and waiter.batch then self.core:wake() end
end

local function Receiver:begin_close()
  if self.handle_view:is_initialized() and not uv.is_closing(self.handle_view) then
    uv.close(self.handle_view)
  end
end

local function Receiver:wake()
  local reader = self.reader
  local task? = reader.task
  if task == nil or reader.notified then return end
  reader.notified = true
  do task:resume(reader.token)
  catch reader.notified = false; raise end
end

-- Runtime shutdown disables admission before its generic native handle close.
local function Receiver:disable()
  receiver_disable_native(self.native)
  self:wake()
end

-- lua_close finalizes rooted owners too; senders must already be quiescent.
local function receiver_finalize(owner: Receiver)
  receiver_disable_native(owner.native)
end

--- Create a coalescing receiver without driving its Runtime or requiring a Task.
-- Keep this owner and its Lua state alive until all borrowed-handle sends return.
-- After sender quiescence, close and drain the owning loop before releasing roots.
-- @return Receiver retained by its native handle until close completes.
-- @usage async-io.md#cross-state-receivers
function receiver(): Receiver
  local runtime = ensure_runtime()
  if runtime.closing or runtime.exit_code ~= nil then
    raise "cannot create a receiver while async Runtime is shutting down"
  end
  local handle = uv.async_t.new()
  local reader = ReceiverReader(nil, false, ResumeToken("async.Receiver.wait"), nil)
  -- Task:cancel runs this only while the reserving Task is suspended in wait,
  -- so the reservation it withdraws is necessarily that Task's.
  reader.withdraw = function () reader.task = nil end
  local owner = Receiver {
    native = foreign titan_async_receiver.new(),
    native_handle = handle,
    handle_view = handle:as_handle_t(),
    reader = reader
  }
  owner.native.closed = 1
  gc.finalizable(owner, receiver_finalize)
  do
    -- A notification carries no resource. The actual packet stays in the
    -- native slot, including while a reader's deferred wake is queued.
    local callback = function (_: uv.async_t) owner:wake() end
    uv.handle_set_data(owner.handle_view, owner)
    owner.native.send = uv.async_send_function()
    check_status(uv.async_init(runtime.loop, handle, callback), "async.receiver")
    owner.native.handle = handle:borrow()
    owner.native.closed = 0
  catch
    owner:close()
    raise
  end
  return owner
end

--- Borrow the cross-state send address; retain this receiver and its Lua state.
-- Withdraw the address from all senders and finish in-flight sends before close.
-- @usage async-io.md#cross-state-receivers
function Receiver:handle(): foreign *void
  return self.native
end

--- Encode and replace the latest value, disposing any unread predecessor natively.
-- Rejection before exchange discards the encoded packet. Notification failure
-- after exchange still commits delivery ownership; never retry a committed send.
-- Only packet-registered resources are released on discard; manual handoff bytes
-- still require their explicit adoption/disposal protocol.
-- @param handle Borrowed address; retain its Receiver and state through all sends.
-- @param candidate Transferable value or explicit TransferValue copy/borrow policy.
-- @usage async-io.md#cross-state-receivers
function send(handle: foreign *void, candidate: value)
  if not handle then raise "receiver handle must not be NULL" end
  local raw = transfer.encode_message(candidate)
  defer transfer.discard_message(raw)
  -- Call at the real guarded local so its cleared mutable-address spill commits
  -- before check_status can enter ordinary Titan code or raise.
  local status = receiver_send_native(handle as foreign *titan_async_receiver, raw)
  if status == 2 then raise "receiver is closed" end
  check_status(status, "async.send")
end

--- Reserve the sole reader and consume/decode the latest value, waiting if needed.
-- Cancellation withdraws only the reservation, leaving an unread packet intact.
-- Decode failures consume the packet and raise here; no lazy retry is possible.
-- @return Decoded value, including nil and false as data.
-- @usage async-io.md#cross-state-receivers
function Receiver:wait(): value
  local task = running()
  local reader = self.reader
  if reader.task ~= nil then raise "receiver already has a waiting reader" end
  -- Cancellation withdraws the reservation before this Task unwinds, so a
  -- successor may already hold it on exit; release only this Task's own.
  defer if reader.task == task then reader.task = nil end
  -- Reserve before even inspecting the slot, not just before suspension.
  -- Cancellation withdraws only this reservation; it never takes the packet.
  reader.task = task
  reader.notified = false
  while true do
    checkpoint()
    local raw: foreign *void = nil
    local status = receiver_take_native(self.native, raw)
    if status == 2 then raise "receiver is closed" end
    if status == 1 then
      -- Guard only after the native take, so no later write reaches `raw`;
      -- decode consumes and clears that actual local on return and on raise.
      defer transfer.discard_message(raw)
      return transfer.decode_message(raw)
    end
    -- A stale/coalesced notification may have no packet. Re-arm the same
    -- reservation and suspend: send between the check and registration leaves
    -- the UV async notification pending until this Task has yielded.
    reader.notified = false
    suspend(reader.token, reader.withdraw)
  end
end

--- Close idempotently, dispose an unread packet natively, and wake the reader.
-- @usage async-io.md#cross-state-receivers
function Receiver:close()
  defer self:begin_close()
  self:disable()
end

do
  local native_error = ffi.titan_async_ignore_sigpipe_if_default()
  if native_error ~= 0 then
    check_status(uv.translate_sys_error(native_error), "runtime.sigpipe")
  end
  -- The generated entrypoint has not yet built its Titan argument Array.
  -- This still runs with --no-uv-bootstrap; only invoking bootstrap is skipped.
  uv.setup_process_args()
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for async bootstrap registration"
  end
  ffi.lua_pushtvalue(L, bootstrap)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_BOOTSTRAP_KEY)
end
