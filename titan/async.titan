         third_result as A3, fourth_result as A4,
         fifth_result as A5
end

--- Wait for one Task to finish and return its status without raising its outcome.
-- @param task Task to observe; waiting on the current Task is rejected.
-- @return Exact terminal TaskStatus.
-- @usage async-io.md
function join<|A, B|>(task: Task<|A, B|>): TaskStatus<|A, B|>
  local current = running()
  reject_running(current, task)
  if task.phase == TASK_FINISHED then return task:status() end

  local resume_token = ResumeToken("async.join")
  local waiting = current
  local result: TaskStatus<|value, value|>? = nil
  local listener = function (terminal_status: TaskStatus<|A, B|>)
    result = terminal_status
    waiting:resume(resume_token)
  end
  local remove_listener = task:add_terminal_listener(listener)
  defer remove_listener()

  suspend(resume_token)
  return result as TaskStatus<|A, B|>
end

--- Wait for every one of 2 Tasks and return their terminal statuses without raising their outcomes.
-- @param first First Task operand.
-- @param second Second Task operand.
-- @return 2 TaskStatus values in operand order.
-- @usage async-io.md
function join_two<|A1, B1, A2, B2|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>):
    (TaskStatus<|A1, B1|>, TaskStatus<|A2, B2|>)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local completed = 0
  local first_result: TaskStatus<|value, value|>? = nil
  if first.phase == TASK_FINISHED then
    first_result = first:status()
    completed = completed + 1
  end
  local second_result: TaskStatus<|value, value|>? = nil
  if second.phase == TASK_FINISHED then
    second_result = second:status()
    completed = completed + 1
  end
  if completed == 2 then
    return first_result as TaskStatus<|A1, B1|>, second_result as TaskStatus<|A2, B2|>
  end

  local resume_token = ResumeToken("async.join_two")
  local waiting = current
  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if first_result ~= nil then return end
    first_result = status
    completed = completed + 1
    if completed == 2 then waiting:resume(resume_token) end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if second_result ~= nil then return end
    second_result = status
    completed = completed + 1
    if completed == 2 then waiting:resume(resume_token) end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  suspend(resume_token)
  return first_result as TaskStatus<|A1, B1|>, second_result as TaskStatus<|A2, B2|>
end

