function race_two(first: Task, second: Task): RaceTwoResult
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local first_status = first:status()
  if first_status:has_finished() then
    return RaceTwoResult.first(first_status)
  end
  local second_status = second:status()
  if second_status:has_finished() then
    return RaceTwoResult.second(second_status)
  end

  local waiting? = current
  defer waiting = nil
  local winner = 0
  local result?: TaskStatus = nil

  local first_listener = function (status: TaskStatus)
    if waiting == nil or winner ~= 0 then return end
    winner = 1
    result = status
    waiting:resume()
  end
  defer first:remove_terminal_listener(first_listener)
  first:add_terminal_listener(first_listener)

  local second_listener = function (status: TaskStatus)
    if waiting == nil or winner ~= 0 then return end
    winner = 2
    result = status
    waiting:resume()
  end
  defer second:remove_terminal_listener(second_listener)
  second:add_terminal_listener(second_listener)

  suspend()
  if winner == 1 then
    return RaceTwoResult.first(result as TaskStatus)
  end
  return RaceTwoResult.second(result as TaskStatus)
end

function race_three(first: Task, second: Task,
                    third: Task): RaceThreeResult
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)

  local first_status = first:status()
  if first_status:has_finished() then
    return RaceThreeResult.first(first_status)
  end
  local second_status = second:status()
  if second_status:has_finished() then
    return RaceThreeResult.second(second_status)
  end
  local third_status = third:status()
  if third_status:has_finished() then
    return RaceThreeResult.third(third_status)
  end

  local waiting? = current
  defer waiting = nil
  local winner = 0
  local result?: TaskStatus = nil

  local first_listener = function (status: TaskStatus)
    if waiting == nil or winner ~= 0 then return end
    winner = 1
    result = status
    waiting:resume()
  end
  defer first:remove_terminal_listener(first_listener)
  first:add_terminal_listener(first_listener)

  local second_listener = function (status: TaskStatus)
    if waiting == nil or winner ~= 0 then return end
