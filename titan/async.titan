function join(task: Task): TaskStatus
  local current = running()
  reject_running(current, task)
  local status = task:status()
  if status:has_finished() then return status end

  local waiting? = current
  defer waiting = nil
  local result?: TaskStatus = nil
  local listener = function (terminal_status: TaskStatus)
    if waiting == nil then return end
    result = terminal_status
    waiting:resume()
  end
  defer task:remove_terminal_listener(listener)
  task:add_terminal_listener(listener)

  suspend()
  return result as TaskStatus
end

function join_two(first: Task, second: Task): (TaskStatus, TaskStatus)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local completed = 0
  local first_result?: TaskStatus = nil
  local first_status = first:status()
  if first_status:has_finished() then
    first_result = first_status
    completed = completed + 1
  end
  local second_result?: TaskStatus = nil
  local second_status = second:status()
  if second_status:has_finished() then
    second_result = second_status
    completed = completed + 1
  end
  if completed == 2 then
    return first_result as TaskStatus, second_result as TaskStatus
  end

  local waiting? = current
  defer waiting = nil
  local first_listener = function (status: TaskStatus)
    if waiting == nil or first_result ~= nil then return end
    first_result = status
    completed = completed + 1
    if completed == 2 then waiting:resume() end
  end
  defer first:remove_terminal_listener(first_listener)
  if first_result == nil then first:add_terminal_listener(first_listener) end

  local second_listener = function (status: TaskStatus)
    if waiting == nil or second_result ~= nil then return end
    second_result = status
    completed = completed + 1
    if completed == 2 then waiting:resume() end
  end
  defer second:remove_terminal_listener(second_listener)
  if second_result == nil then second:add_terminal_listener(second_listener) end

  suspend()
  return first_result as TaskStatus, second_result as TaskStatus
end

