  if winner == 2 then return AnyFiveResult<|A1, A2, A3, A4, A5|>.second(result) end
  if winner == 3 then return AnyFiveResult<|A1, A2, A3, A4, A5|>.third(result) end
  if winner == 4 then return AnyFiveResult<|A1, A2, A3, A4, A5|>.fourth(result) end
  if winner == 5 then return AnyFiveResult<|A1, A2, A3, A4, A5|>.fifth(result) end
  return AnyFiveResult<|A1, A2, A3, A4, A5|>.none()
end

