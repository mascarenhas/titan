--- Cooperative Tasks, cancellation, callback waits, channels, and persistent subscriptions.
-- @module titan.async
-- @usage async-io.md

foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"
foreign import "unistd.h"
foreign import "errno.h"
foreign import "stdint.h"
foreign import "stdlib.h"
foreign import "string.h"
foreign import "async_receiver_native.h"
local uv = import "uv"
local coroutine = import "coroutine"
local gc = import "gc"
local string = import "string"
local transfer = import "transfer"
local iteration = import "iteration"

--- Nonyielding cancellation callback that detaches one exact explicit-suspension waiter.
-- @usage async-io.md
type SuspendCancelAction = function (): ()

--- Copy and borrow policies shared with low-level resource owners.
-- Transparent alias of transfer.TransferValue; constructors and methods are identical.
-- @usage async-io.md#transfer-values
type TransferValue = transfer.TransferValue

-- One persistent single-reader state per Receiver: a wait reserves by setting
-- task and reuses the token and cancellation action instead of allocating them.
local record ReceiverReader
  task: Task<|value, value|>?
  notified: boolean
  token: ResumeToken
  withdraw: SuspendCancelAction?
end

--- A lossy latest-value receiver whose borrowed handle can cross Lua states.
-- Values decode eagerly in wait; overwritten packets are disposed entirely in C.
-- @usage async-io.md#cross-state-receivers
record Receiver
  local native: foreign titan_async_receiver
  local native_handle: uv.async_t
  local handle_view: uv.handle_t
  local reader: ReceiverReader
end

-- Positive status 2 rejects admission; libuv's zero/negative statuses follow
-- publication. Clear the actual caller slot before disposal or notification.
-- Send/close and borrowed-handle lifetime remain externally serialized.
local foreign function receiver_send_native(receiver: *titan_async_receiver,
    source: *(*void)): int
  if receiver.closed ~= 0 then return 2 end
  local message = source[0] as foreign *titan_async_message
  local previous = ffi.titan_async_receiver_exchange(receiver, message)
  source[0] = nil
  transfer.discard_message(previous)
  return receiver.send(receiver.handle)
end

local foreign function receiver_take_native(receiver: *titan_async_receiver,
    destination: *(*void)): int
  if receiver.closed ~= 0 then return 2 end
  local message = ffi.titan_async_receiver_exchange(receiver, nil)
  destination[0] = message as foreign *void
  if message == nil then return 0 end
  return 1
end

local foreign function receiver_disable_native(receiver: *titan_async_receiver)
  receiver.closed = 1
  transfer.discard_message(ffi.titan_async_receiver_exchange(receiver, nil))
end

local foreign function retirement_poll_native(state: *titan_async_retirement): int
  if state.ready ~= 0 then return 0 end
  if state.status < 0 then return state.status end
  local status = state.retire(state.context)
  state.status = status
  if status == 0 then state.ready = 1 end
  return status
end

local ASYNC_TAG: value = {}
local YIELD_TAG: value = {}
local active_runtime: Runtime? = nil
local const WAIT_ORDINARY = 0
local const WAIT_CANCELLABLE = 1
local const WAIT_CLEANUP = 2
local const WAIT_REGISTERING = 0
local const WAIT_PENDING = 1
local const WAIT_SETTLED = 2
local const WAIT_RETIRED = 3
local const OUTCOME_SUCCESS = 0
local const OUTCOME_ERROR = 1
local const OUTCOME_FATAL = 2
local const TASK_READY = 0
local const TASK_RUNNING = 1
local const TASK_WAITING = 2
local const TASK_FINISHED = 3
local const READY_START = 0
local const READY_DELIVER = 1
local const READY_RESUME = 2
local const READY_YIELD = 3
local const READY_BATCH_LIMIT = 64
local const READY_TERMINAL = 4
local const READY_UNWIND = 5
local const TERMINAL_NONE = 0
local const TERMINAL_SUCCEEDED = 1
local const TERMINAL_FAILED = 2

--- Original Task error value paired with its preserved traceback.
-- @field error Original raised value.
-- @field traceback Traceback captured at the failure.
-- @usage async-io.md
record Error
  error: value
  traceback: string
end

--- Portable native-operation failure with its status and operation name.
-- @field code Native status code.
-- @field name Symbolic native error name.
-- @field message Native error explanation.
-- @field operation Operation that failed.
-- @usage async-io.md
record OperationError
  code: integer
  name: string
  message: string
  operation: string
end

--- Identity capability authorizing one exact explicit Task suspension.
-- @field source Optional diagnostic source; token comparison uses record identity.
-- @usage async-io.md
record ResumeToken
  const source: string?
end

--- First-wins cancellation reason with a message or typed payload.
-- @field simple Human-readable cancellation message.
-- @field complex Typed cancellation payload.
-- @usage async-io.md
union CancellationReason<|B|>
  simple(string)
  complex(B)
end

--- Immutable Task phase snapshot with typed success or cancellation payloads.
-- @field ready Scheduled to start on a deferred turn.
-- @field running Currently executing.
-- @field waiting Suspended pending an operation or authorized wake.
-- @field succeeded Successful result payload.
-- @field failed Error value and traceback.
-- @field cancelled Authoritative first cancellation reason.
-- @usage async-io.md
union TaskStatus<|A, B|>
  ready()
  running()
  waiting()
  succeeded(A)
  failed(Error)
  cancelled(CancellationReason<|B|>)
end

--- Success or expected error from a completed generic callback wait.
-- @field success Successful operation payload.
-- @field error Expected operation error.
-- @usage async-io.md
union Result<|T, E|>
  success(T)
  error(E)
end

--- Completed callback-wait outcome including sticky Task cancellation.
-- @field success Successful operation payload.
-- @field error Expected operation error.
-- @field cancelled Task cancellation reason after native completion.
-- @usage async-io.md
union CancellableResult<|T, E|>
  success(T)
  error(E)
  cancelled(CancellationReason<|value|>)
end

--- Opaque readable string-channel endpoint created by reader_writer_channel.
-- @usage async-io.md
record ChannelReader
  local receive: function (): (string)
  local close_channel: function (): ()
  local excess: string?
  local closed: boolean
end

--- Opaque writable string-channel endpoint created by reader_writer_channel.
-- @usage async-io.md
record ChannelWriter
  local send: function (string): ()
  local close_channel: function (): ()
end

--- First successful result among 2 named Tasks, or none when all reject.
-- @field first Success payload from the first operand.
-- @field second Success payload from the second operand.
-- @field none Every operand failed or was cancelled.
-- @usage async-io.md
union AnyTwoResult<|A1, A2|>
  first(A1)
  second(A2)
  none()
end

--- First successful result among 3 named Tasks, or none when all reject.
-- @field first Success payload from the first operand.
-- @field second Success payload from the second operand.
-- @field third Success payload from the third operand.
-- @field none Every operand failed or was cancelled.
-- @usage async-io.md
union AnyThreeResult<|A1, A2, A3|>
  first(A1)
  second(A2)
  third(A3)
  none()
end

--- First successful result among 4 named Tasks, or none when all reject.
-- @field first Success payload from the first operand.
-- @field second Success payload from the second operand.
-- @field third Success payload from the third operand.
-- @field fourth Success payload from the fourth operand.
-- @field none Every operand failed or was cancelled.
-- @usage async-io.md
union AnyFourResult<|A1, A2, A3, A4|>
  first(A1)
  second(A2)
  third(A3)
  fourth(A4)
  none()
end

--- First successful result among 5 named Tasks, or none when all reject.
-- @field first Success payload from the first operand.
-- @field second Success payload from the second operand.
-- @field third Success payload from the third operand.
-- @field fourth Success payload from the fourth operand.
-- @field fifth Success payload from the fifth operand.
-- @field none Every operand failed or was cancelled.
-- @usage async-io.md
union AnyFiveResult<|A1, A2, A3, A4, A5|>
  first(A1)
  second(A2)
  third(A3)
  fourth(A4)
  fifth(A5)
  none()
end

--- First terminal status among 2 named Tasks, preserving its position.
-- @field first Terminal TaskStatus from the first operand.
-- @field second Terminal TaskStatus from the second operand.
-- @usage async-io.md
union RaceTwoResult<|A1, B1, A2, B2|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
end

--- First terminal status among 3 named Tasks, preserving its position.
-- @field first Terminal TaskStatus from the first operand.
-- @field second Terminal TaskStatus from the second operand.
-- @field third Terminal TaskStatus from the third operand.
-- @usage async-io.md
union RaceThreeResult<|A1, B1, A2, B2, A3, B3|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
  third(TaskStatus<|A3, B3|>)
end

--- First terminal status among 4 named Tasks, preserving its position.
-- @field first Terminal TaskStatus from the first operand.
-- @field second Terminal TaskStatus from the second operand.
-- @field third Terminal TaskStatus from the third operand.
-- @field fourth Terminal TaskStatus from the fourth operand.
-- @usage async-io.md
union RaceFourResult<|A1, B1, A2, B2, A3, B3, A4, B4|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
  third(TaskStatus<|A3, B3|>)
  fourth(TaskStatus<|A4, B4|>)
end

--- First terminal status among 5 named Tasks, preserving its position.
-- @field first Terminal TaskStatus from the first operand.
-- @field second Terminal TaskStatus from the second operand.
-- @field third Terminal TaskStatus from the third operand.
-- @field fourth Terminal TaskStatus from the fourth operand.
-- @field fifth Terminal TaskStatus from the fifth operand.
-- @usage async-io.md
union RaceFiveResult<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
  third(TaskStatus<|A3, B3|>)
  fourth(TaskStatus<|A4, B4|>)
  fifth(TaskStatus<|A5, B5|>)
end

--- Positional failure or cancellation raised when all_two cannot succeed.
-- @field first Rejecting TaskStatus from the first operand.
-- @field second Rejecting TaskStatus from the second operand.
-- @usage async-io.md
union AllTwoError<|A1, B1, A2, B2|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
end

--- Positional failure or cancellation raised when all_three cannot succeed.
-- @field first Rejecting TaskStatus from the first operand.
-- @field second Rejecting TaskStatus from the second operand.
-- @field third Rejecting TaskStatus from the third operand.
-- @usage async-io.md
union AllThreeError<|A1, B1, A2, B2, A3, B3|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
  third(TaskStatus<|A3, B3|>)
end

--- Positional failure or cancellation raised when all_four cannot succeed.
-- @field first Rejecting TaskStatus from the first operand.
-- @field second Rejecting TaskStatus from the second operand.
-- @field third Rejecting TaskStatus from the third operand.
-- @field fourth Rejecting TaskStatus from the fourth operand.
-- @usage async-io.md
union AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
  third(TaskStatus<|A3, B3|>)
  fourth(TaskStatus<|A4, B4|>)
end

--- Positional failure or cancellation raised when all_five cannot succeed.
-- @field first Rejecting TaskStatus from the first operand.
-- @field second Rejecting TaskStatus from the second operand.
-- @field third Rejecting TaskStatus from the third operand.
-- @field fourth Rejecting TaskStatus from the fourth operand.
-- @field fifth Rejecting TaskStatus from the fifth operand.
-- @usage async-io.md
union AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>
  first(TaskStatus<|A1, B1|>)
  second(TaskStatus<|A2, B2|>)
  third(TaskStatus<|A3, B3|>)
  fourth(TaskStatus<|A4, B4|>)
  fifth(TaskStatus<|A5, B5|>)
end

--- Opaque reusable callback capability checked by its captured operation number.
-- @usage async-io.md
record Completion<|C, T, E|>
  local stored_context: C
  local register: (function (Completion<|C, T, E|>, integer): (uv.req_t?))?
  local task: Task
  local epoch: integer
  local policy: integer
  local phase: integer
  local kind: integer
  local payload: value
  local request: uv.req_t?
end

local type Wait = Completion<|value, value, value|>

local record Orphan
  local task: Task
  local wait: Wait?
  local epoch: integer
end

local record TerminalRegistration<|A, B|>
  local listener: function (TaskStatus<|A, B|>): ()
  local live: boolean
end

local record CloseRegistration
  local listener: function (): ()
  local live: boolean
end

local record Runtime
  local loop: uv.loop_t
  local wake: uv.timer_t
  local ready_head: Task?
  local ready_tail: Task?
  local ready_count: integer
  local wake_armed: boolean
  local tasks: {Task}
  local next_task: integer
  local current_task: Task?
  local driving: boolean
  local closing: boolean
  local failure: Error?
  local shutdown_cancelled: boolean
  local exit_code: integer?
  local close_registrations: {CloseRegistration}
  local external: ExternalBridge?
  local retirement_error: ExternalWait?
end

local record ExternalBridge
  runtime: Runtime
  wake: uv.external_wake_t
  waits: {integer: ExternalWait}
  next_identity: integer
  closed: boolean
end

record ExternalWait
  local bridge: ExternalBridge
  local identity: integer
  local target: foreign *void
  local register_fn: (function (foreign *void): boolean)?
  local unregister_fn: (function (): ())?
  local token: ResumeToken
  local cancel_action: (function (): ())?
  local done: Wait?
  local number: integer
  local used: boolean
  local registered: boolean
  local notified: boolean
  local retired: boolean
  local cleanup_task: Task?
  local native: foreign titan_async_retirement
  local native_owner: value
  local awaited: boolean
  local close_requested: boolean
end

--- Deferred cooperative computation with typed success and complex-cancellation payloads.
-- @usage async-io.md
record Task<|A, B|>
  local root: coroutine.Coroutine
  local runtime: Runtime
  local phase: integer
  local state: TaskStatus<|A, B|>?
  local epoch: integer
  local ready_next: Task?
  local ready_queued: boolean
  local ready_kind: integer
  local ready_epoch: integer
  local ready_wait: Wait?
  local cancel_value: CancellationReason<|B|>?
  local wait: Wait?
  local completion: Wait?
  local root_index: integer
  local terminal_registrations: {TerminalRegistration<|A, B|>}
  local suspended: boolean
  local resume_token: ResumeToken?
  local resume_pending: boolean
  local suspend_cancel: (function (): ())?
  local cleanup_start: boolean
  local cleanup_active: boolean
  local cleanup_wait: ExternalWait?
  local terminal_kind: integer
  local terminal_value: value
  local terminal_trace: string?
  local root_done: boolean
end

--- Return the phase name without projecting generic payloads.
-- @return ready, running, waiting, succeeded, failed, or cancelled.
-- @usage async-io.md
function TaskStatus:as_string(): string
  case self
  when ready() then return "ready"
  when running() then return "running"
  when waiting() then return "waiting"
  when succeeded() then return "succeeded"
  when failed() then return "failed"
  when cancelled() then return "cancelled"
  end
end

--- Check whether the snapshot is succeeded, failed, or cancelled.
-- @return True for a terminal status.
-- @usage async-io.md
function TaskStatus:has_finished(): boolean
  case self
  when succeeded() then return true
  when failed() then return true
  when cancelled() then return true
  else return false
  end
end

--- Inspect a successful status without confusing a nil payload with failure.
-- @return Success flag and optional typed result.
-- @usage async-io.md
function TaskStatus:has_succeeded(): (boolean, A?)
  case self
  when succeeded(result) then return true, result
  else return false, nil
  end
end

--- Inspect whether the snapshot contains a Task failure.
-- @return Failure flag and optional Error.
-- @usage async-io.md
function TaskStatus:has_failed(): (boolean, Error?)
  case self
  when failed(failure) then return true, failure
  else return false, nil
  end
end

--- Inspect whether the snapshot contains authoritative cancellation.
-- @return Cancellation flag and optional reason.
-- @usage async-io.md
function TaskStatus:has_cancelled(): (boolean, CancellationReason<|B|>?)
  case self
  when cancelled(reason) then return true, reason
  else return false, nil
  end
end

--- Return an immutable snapshot of the current Task phase.
-- @return Current TaskStatus; previously returned snapshots never mutate.
-- @usage async-io.md
function Task:status(): TaskStatus<|A, B|>
  if self.state == nil then
    if self.phase == TASK_READY then self.state = TaskStatus<|A, B|>.ready()
    elseif self.phase == TASK_RUNNING then self.state = TaskStatus<|A, B|>.running()
    elseif self.phase == TASK_WAITING then self.state = TaskStatus<|A, B|>.waiting()
    else raise "finished Task has no terminal status" end
  end
  return self.state
end

--- Register one ordered terminal observer on an unfinished Task.
-- @param listener Nonyielding observer called outside Task execution; errors are isolated.
-- @return Idempotent remover; an already-terminal Task does not invoke the listener.
-- @usage async-io.md
function Task:add_terminal_listener(listener: function (TaskStatus<|A, B|>): ()): function (): ()
  if self.phase == TASK_FINISHED then return function () end end
  local registration = TerminalRegistration<|A, B|> {listener = listener, live = true}
  self.terminal_registrations[#self.terminal_registrations + 1] = registration
  local task = self
  return function ()
    if not registration.live then return end
    registration.live = false
    local registrations = task.terminal_registrations
    for index = 1, #registrations do
      if registrations[index] == registration then
        for following = index, #registrations - 1 do
          registrations[following] = registrations[following + 1]
        end
        registrations[#registrations] = nil
        return
      end
    end
  end
end

local function operation_error(code: integer, operation: string): OperationError
  return OperationError(code, uv.err_name(code), uv.strerror(code), operation)
end

local function check_status(code: integer, operation: string)
  if code < 0 then raise operation_error(code, operation) end
end

local function has_tasks(runtime: Runtime): boolean
  for index = 1, runtime.next_task - 1 do
    if runtime.tasks[index] ~= nil then return true end
  end
  return false
end

local function require_main_thread()
  local top = ffi.lua_gettop(L)
  ffi.lua_rawgeti(L, ffi.LUA_REGISTRYINDEX, ffi.LUA_RIDX_MAINTHREAD as foreign lua_Integer)
  local main = ffi.lua_tothread(L, -1)
  ffi.lua_settop(L, top)
  if L ~= main then raise "async.loop must be driven from the Lua main thread" end
end

local function rethrow_failure(failure: Error)
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then raise "cannot reserve error handoff" end
  ffi.lua_pushtvalue(L, failure.traceback)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  ffi.lua_pushboolean(L, 1)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
  raise failure.error
end

--- Rethrow the original error value with its preserved traceback.
-- @usage async-io.md
function Error:raise()
  rethrow_failure(self)
end

local function new_runtime(): Runtime
  local runtime = Runtime {loop = uv.loop_t.new(), wake = uv.timer_t.new(),
    ready_head = nil, ready_tail = nil, ready_count = 0, wake_armed = false,
    tasks = {}, next_task = 1,
    current_task = nil, driving = false, closing = false, failure = nil, shutdown_cancelled = false, exit_code = nil, close_registrations = {}, external = nil, retirement_error = nil}
  check_status(uv.loop_init(runtime.loop), "runtime.loop.init")
  do uv.bind_transfer_loop(runtime.loop)
  catch uv.loop_close(runtime.loop); raise end
  local status = uv.timer_init(runtime.loop, runtime.wake)
  if status < 0 then
    uv.unbind_transfer_loop(runtime.loop)
    uv.loop_close(runtime.loop)
    raise operation_error(status, "runtime.timer.init")
  end
  uv.timer_set_data(runtime.wake, runtime)
  return runtime
end

local function ensure_runtime(): Runtime
  local runtime? = active_runtime
  if runtime ~= nil then return runtime end
  local created = new_runtime()
  active_runtime = created
  return created
end

--- Borrow the active Runtime loop without creating or driving a Runtime.
-- @return Runtime-owned loop; valid from Tasks, registration, and loop callbacks.
-- @usage async-io.md
function current_loop(): uv.loop_t
  local runtime? = active_runtime
  if runtime == nil then raise "async Runtime is not active" end
  return runtime.loop
end

-- Domain resource constructors may reject shutdown without turning their
-- synchronous operation into a Task cancellation boundary.
--- Query shutdown state of an already active Runtime.
-- @return True while the Runtime is closing; does not check Task cancellation.
-- @usage async-io.md
function is_closing(): boolean
  local runtime? = active_runtime
  if runtime == nil then raise "async Runtime is not active" end
  return runtime.closing
end

--- Observe Runtime retirement after all Tasks and native handles have finished.
-- @param listener Nonyielding cleanup outside Task execution; errors propagate from loop after all listeners run.
-- @return Idempotent remover; registration requires an active, nonclosing Runtime.
-- @usage async-io.md#runtime-close-listeners
function add_close_listener(listener: function (): ()): function (): ()
  local runtime? = active_runtime
  if runtime == nil then raise "async Runtime is not active" end
  if runtime.closing or runtime.exit_code ~= nil then
    raise "cannot register a close listener while async Runtime is shutting down"
  end
  local registration = CloseRegistration(listener, true)
  runtime.close_registrations[#runtime.close_registrations + 1] = registration
  return function ()
    if not registration.live then return end
    registration.live = false
    local registrations = runtime.close_registrations
    for index = 1, #registrations do
      if registrations[index] == registration then
        for following = index, #registrations - 1 do
          registrations[following] = registrations[following + 1]
        end
        registrations[#registrations] = nil
        return
      end
    end
  end
end

local function notify_runtime_closed(runtime: Runtime)
  uv.unbind_transfer_loop(runtime.loop)
  runtime.closing = true
  local registrations = runtime.close_registrations
  runtime.close_registrations = {}
  for index = 1, #registrations do
    local registration = registrations[index]
    if registration.live then
      registration.live = false
      do registration.listener()
      catch
        if runtime.failure == nil then runtime.failure = Error(error, traceback) end
      end
    end
  end
end

--- Return the current Task through the all-value view; raises outside a Task.
-- @return The same Task userdata as the typed owner view.
-- @usage async-io.md
function running(): Task<|value, value|>
  local runtime? = active_runtime
  if runtime == nil then raise "async Runtime is not active" end
  local task? = runtime.current_task
  if task == nil then raise "asynchronous operation must be called from an async Task" end
  return task
end

-- Admission for synchronous work that already has no scheduling boundary.
-- Keep the same precedence as an ordinary await before registration.
--- Check sticky cancellation and Runtime failure synchronously without yielding.
-- @usage async-io.md
function checkpoint()
  local task = running()
  local reason? = task.cancel_value
  if reason ~= nil then raise reason end
  if task.runtime.closing then raise (task.runtime.failure as Error).error end
end

local function clear_suspension(task: Task)
  task.suspended = false
  task.resume_token = nil
  task.resume_pending = false
  task.suspend_cancel = nil
end

local function set_phase(task: Task, phase: integer)
  task.phase = phase
  task.state = nil
end

local function begin_suspension(task: Task, operation: Wait?)
  local limit = ffi.LUA_MAXINTEGER as integer
  local final_wait? = task.cleanup_wait
  if final_wait ~= nil then
    -- The reserved epoch belongs to one prepared retirement capability, not
    -- arbitrary yielding code reached while its cleanup callback is running.
    -- Named function values are canonical module closures, so this comparison
    -- is identity-preserving and cannot allocate a callable adapter.
    local registrar: value = start_native_retirement_wait
    local designated = task.cleanup_active and operation ~= nil and
      operation.policy == WAIT_CLEANUP and operation.stored_context == final_wait and
      operation.register == registrar
    if not designated then limit = limit - 1 end
  end
  if task.epoch >= limit then
    raise "async Task suspension epoch exhausted"
  end
  task.epoch = task.epoch + 1
end

local function release_completion(wait: Wait)
  wait.stored_context = nil
  wait.register = nil
  wait.payload = nil
  wait.request = nil
end

local function finish_task(task: Task, state: TaskStatus)
  local barrier? = task.cleanup_wait
  if barrier ~= nil and barrier.native.ready == 0 then return end
  -- An exceptional Result allocation can occur after task.wait was detached.
  local cached? = task.completion
  if cached ~= nil then cached.phase = WAIT_RETIRED; release_completion(cached) end
  clear_suspension(task)
  local wait? = task.wait
  if wait ~= nil then wait.phase = WAIT_RETIRED; release_completion(wait) end
  task.wait = nil
  task.phase = TASK_FINISHED
  task.state = state
  task.terminal_kind = TERMINAL_NONE
  task.terminal_value = nil
  task.terminal_trace = nil
  task.cleanup_wait = nil
  local listeners = task.terminal_registrations
  for index = 1, #listeners do listeners[index].live = false end
  for index = 1, #listeners do
    do listeners[index].listener(state) catch end
    listeners[index] = nil
  end
  task.runtime.tasks[task.root_index] = nil
  if not has_tasks(task.runtime) then
    uv.unbind_transfer_loop(task.runtime.loop)
    task.runtime.closing = true
    uv.stop(task.runtime.loop)
  end
end

local function error_text(err: value): string
  local text = "<error while rendering Task failure>"
  do
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    if err is OperationError then
      local failure = err as OperationError
      text = failure.operation .. ": " .. failure.name ..
             " (" .. failure.code .. "): " .. failure.message
    else
      if ffi.lua_checkstack(L, 2) == 0 then
        raise "cannot reserve Lua stack for Task error rendering"
      end
      ffi.lua_pushtvalue(L, err)
      local rendered = ffi.luaL_tolstring(L, -1, nil)
      if rendered then
        text = rendered as string
      else
        text = "<unprintable error>"
      end
    end
  catch
    -- Keep the conservative fallback already installed above.
  end
  return text
end

local function report_task_error(err: value, trace: string)
  local text = "uncaught error in async Task: " .. error_text(err) .. "\n"
  if #trace > 0 then
    text = text .. "stack traceback:\n" .. trace .. "\n"
  end
  -- stderr is a macro on the supported C libraries and therefore is not a
  -- portable FFI object. Descriptor 2 is the inherited stderr boundary. The
  -- typed call checks its count against this platform's actual write parameter.
  local bytes = text as foreign const *char
  local offset = 0
  while offset < #text do
    local written = ffi.write(
        2 as foreign int, bytes + offset,
        #text - offset)
    if written < 0 then
      if ffi.errno == ffi.EINTR then
        -- Retry the same suffix.
      else
        return
      end
    elseif written == 0 then
      return
    else
      offset = offset + (written as integer)
    end
  end
end

local function publish_terminal(task: Task)
  if not task.root_done or task.terminal_kind == TERMINAL_NONE or
      task.phase == TASK_FINISHED then return end
  local barrier? = task.cleanup_wait
  if barrier ~= nil then
    local status = retirement_poll_native(barrier.native)
    if status > 0 then return end
    if status < 0 then
      if task.runtime.retirement_error == nil then task.runtime.retirement_error = barrier end
      uv.stop(task.runtime.loop)
      return
    end
    -- Native retirement is complete before clearing the map/borrow and
    -- consuming the registration. There is no ordinary entry in this interval.
    local target = barrier.target
    barrier.target = nil
    barrier.bridge.waits[barrier.identity] = nil
    barrier.registered = false
    if target ~= nil then uv.native_external_wake_unregister(target) end
    barrier:retire()
  end
  local kind = task.terminal_kind
  local payload = task.terminal_value
  local reason? = task.cancel_value
  if reason ~= nil then
    finish_task(task, TaskStatus.cancelled(reason))
  elseif kind == TERMINAL_FAILED then
    local trace = task.terminal_trace or ""
    finish_task(task, TaskStatus.failed(Error(payload, trace)))
    report_task_error(payload, trace)
  else
    finish_task(task, TaskStatus.succeeded(payload))
  end
end

local function finish_failure(task: Task, error: value, trace: string)
  task.terminal_kind = TERMINAL_FAILED
  task.terminal_value = error
  task.terminal_trace = trace
  task.root_done = true
  task.phase = TASK_WAITING
  task.state = nil
  publish_terminal(task)
end

local function resume_root(task: Task, failed: boolean, payload: value): value
  task.runtime.current_task = task
  defer task.runtime.current_task = nil
  if failed then return task.root:error(payload, ASYNC_TAG) end
  return task.root:resume(payload, ASYNC_TAG)
end

local function wait_result(wait: Wait): (boolean, value)
  if wait.kind == OUTCOME_FATAL then return true, wait.payload end
  local reason? = wait.task.cancel_value
  if wait.policy ~= WAIT_CLEANUP and reason ~= nil then
    if wait.policy == WAIT_CANCELLABLE then
      return false, CancellableResult<|value, value|>.cancelled(reason)
    end
    return true, reason
  end
  if wait.policy == WAIT_CANCELLABLE then
    if wait.kind == OUTCOME_SUCCESS then
      return false, CancellableResult<|value, value|>.success(wait.payload)
    end
    return false, CancellableResult<|value, value|>.error(wait.payload)
  end
  if wait.kind == OUTCOME_SUCCESS then return false, Result<|value, value|>.success(wait.payload) end
  return false, Result<|value, value|>.error(wait.payload)
end

local function deliver_wait(wait: Wait)
  if wait.phase ~= WAIT_SETTLED then raise "async operation is not settled" end
  local task = wait.task
  if task.wait ~= wait or task.epoch ~= wait.epoch then
    raise "stale async operation settlement"
  end
  wait.phase = WAIT_RETIRED
  wait.request = nil
  task.wait = nil
  clear_suspension(task)
  local failed, payload = wait_result(wait)
  release_completion(wait)
  advance_task(task, failed, payload)
end

local function settle(wait: Wait, kind: integer, payload: value)
  if wait.phase == WAIT_SETTLED or wait.phase == WAIT_RETIRED then
    raise "async operation already settled"
  end
  if wait.task.wait ~= wait or wait.task.epoch ~= wait.epoch then
    raise "stale async operation settlement"
  end
  local registering = wait.phase == WAIT_REGISTERING
  local deferred = not registering and wait.task.runtime.current_task ~= nil
  -- A peer Task cannot advance this Task inline. Accept its deferred wake
  -- before committing settlement: synchronous scheduling failure leaves the
  -- exact pending wait available for retry or shutdown. The wake cannot run
  -- until this call returns; only nonallocating field writes follow acceptance.
  if deferred then enqueue_ready(wait.task, READY_DELIVER, wait) end
  wait.kind = kind
  wait.payload = payload
  wait.phase = WAIT_SETTLED
  if not registering and not deferred then deliver_wait(wait) end
end

-- This capability belongs to one terminal operation, not to whichever wait
-- the Task happens to have when a late callback reports its failure.
local function fatal(wait: Wait, error: value, trace: string)
  local task = wait.task
  local runtime = task.runtime
  if runtime.current_task ~= nil then
    raise "async fatal callback must run outside an async Task"
  end
  if wait.phase == WAIT_REGISTERING then
    wait.kind = OUTCOME_FATAL
    wait.payload = error
    wait.phase = WAIT_SETTLED
    fail_runtime(runtime, error, trace)
    cancel_shutdown_tasks(runtime, task)
    return
  end
  if wait.phase ~= WAIT_PENDING or task.wait ~= wait or task.epoch ~= wait.epoch then
    fail_runtime(runtime, error, trace)
    return
  end
  -- Its native completion has already been consumed. Retire the exact old
  -- capability before cancellation or lexical cleanup can create a new wait.
  wait.phase = WAIT_RETIRED
  wait.request = nil
  task.wait = nil
  clear_suspension(task)
  release_completion(wait)
  fail_runtime(runtime, error, trace)
  cancel_shutdown_tasks(runtime, task)
  do advance_task(task, true, error)
  catch
    -- The original callback failure remains authoritative. If advancement
    -- itself failed before installing a wait, the driver's orphan pass can
    -- still unwind the rooted Task after native ownership is quiescent.
  end
end

local function advance_task(task: Task, failed: boolean, payload: value)
  local next_failed = failed
  local next_payload = payload
  while true do
    set_phase(task, TASK_RUNNING)
    local yielded: value = nil
    do yielded = resume_root(task, next_failed, next_payload)
    catch
      -- Trace the terminal candidate before entering any fallible publisher.
      if task.terminal_kind ~= TERMINAL_FAILED then
        task.terminal_kind = TERMINAL_FAILED
        task.terminal_value = error
        task.terminal_trace = traceback
      end
      task.root_done = true
      task.phase = TASK_WAITING
      task.state = nil
      publish_terminal(task)
      return
    end
    if task.root:status() == "dead" then
      task.terminal_kind = TERMINAL_SUCCEEDED
      task.terminal_value = yielded
      task.terminal_trace = nil
      task.root_done = true
      task.phase = TASK_WAITING
      task.state = nil
      publish_terminal(task)
      return
    end
    local yielding = yielded == YIELD_TAG
    local operation: Wait? = nil
    local policy = WAIT_ORDINARY
    if not yielding then
      operation = yielded as Wait
      policy = operation.policy
    end
    local reason? = task.cancel_value
    if policy ~= WAIT_CLEANUP and reason ~= nil then
      if operation ~= nil then operation.phase = WAIT_RETIRED; release_completion(operation) end
      if policy == WAIT_CANCELLABLE then
        next_failed = false
        next_payload = CancellableResult<|value, value|>.cancelled(reason)
      else next_failed = true; next_payload = reason end
    elseif policy ~= WAIT_CLEANUP and task.runtime.closing then
      if operation ~= nil then operation.phase = WAIT_RETIRED; release_completion(operation) end
      next_failed = true
      next_payload = (task.runtime.failure as Error).error
    else
      -- Both exhaustion and a failed wake arm belong to this suspended call.
      -- Feed them through the same bounded trampoline as registration errors.
      local admitted = true
      do begin_suspension(task, operation)
      catch
        admitted = false
        if operation ~= nil then operation.phase = WAIT_RETIRED; release_completion(operation) end
        next_failed = true
        next_payload = error
      end
      if admitted then
        set_phase(task, TASK_WAITING)
        if yielding then
          do
            enqueue_ready(task, READY_YIELD, nil)
            return
          catch
            next_failed = true
            next_payload = error
          end
        else
          local wait = operation as Wait
          wait.epoch = task.epoch
          task.wait = wait
          local request: uv.req_t? = nil
          local registration_failed = false
          do
            local start = wait.register
            request = start(wait, wait.epoch)
          catch
            wait.phase = WAIT_RETIRED
            release_completion(wait)
            task.wait = nil
            clear_suspension(task)
            registration_failed = true
            next_failed = true
            next_payload = error
          end
          wait.register = nil
          if not registration_failed then
            if wait.phase == WAIT_SETTLED then
              wait.phase = WAIT_RETIRED
              task.wait = nil
              clear_suspension(task)
              next_failed, next_payload = wait_result(wait)
              release_completion(wait)
            elseif policy == WAIT_CANCELLABLE and request == nil then
              wait.phase = WAIT_RETIRED
              task.wait = nil
              clear_suspension(task)
              next_failed = true
              next_payload = "cancellable registration returned nil without settling"
              release_completion(wait)
            else
              wait.request = request
              wait.phase = WAIT_PENDING
              if policy == WAIT_CANCELLABLE and task.cancel_value ~= nil then
                uv.cancel(request as uv.req_t)
              end
              return
            end
          end
        end
      end
    end
  end
end

local function arm_ready(runtime: Runtime)
  if runtime.wake_armed then return end
  check_status(uv.timer_start(runtime.wake, ready_tick, 0, 0), "runtime.timer.start")
  runtime.wake_armed = true
end

local function enqueue_ready(task: Task, kind: integer, wait: Wait?)
  if task.ready_queued then raise "async Task already has a queued continuation" end
  local runtime = task.runtime
  -- Only nonallocating fields change after wake acceptance. Callers commit
  -- settlement or resume_pending after this returns, so failure is retryable.
  do arm_ready(runtime)
  catch
    if runtime.failure == nil then raise end
    -- During fatal shutdown the outer driver also drains accepted ready work
    -- before blocking, even if the shared native wake is no longer usable.
  end
  task.ready_next = nil
  task.ready_kind = kind
  task.ready_epoch = task.epoch
  task.ready_wait = wait
  task.ready_queued = true
  local tail? = runtime.ready_tail
  if tail == nil then runtime.ready_head = task
  else tail.ready_next = task end
  runtime.ready_tail = task
  runtime.ready_count = runtime.ready_count + 1
end

local function drain_ready(runtime: Runtime)
  local count = runtime.ready_count
  if count > READY_BATCH_LIMIT then count = READY_BATCH_LIMIT end
  for index = 1, count do
    local task = runtime.ready_head as Task
    local kind = task.ready_kind
    local epoch = task.ready_epoch
    local wait? = task.ready_wait
    runtime.ready_head = task.ready_next
    runtime.ready_count = runtime.ready_count - 1
    if runtime.ready_head == nil then runtime.ready_tail = nil end
    -- A continuation may immediately requeue the same Task. No code after
    -- entry may read or clear these old mutable queue fields.
    task.ready_next = nil
    task.ready_queued = false
    task.ready_kind = READY_START
    task.ready_epoch = 0
    task.ready_wait = nil
    if task.phase ~= TASK_FINISHED and task.epoch == epoch and task.wait == wait then
      if kind == READY_START or kind == READY_YIELD then
        local reason? = task.cancel_value
        if reason ~= nil and not (kind == READY_START and task.cleanup_start) then
          advance_task(task, true, reason)
        else advance_task(task, false, nil) end
      elseif kind == READY_DELIVER then
        deliver_wait(wait)
      elseif kind == READY_RESUME then
        settle(wait, OUTCOME_SUCCESS, nil)
      elseif kind == READY_TERMINAL then
        publish_terminal(task)
      elseif kind == READY_UNWIND then
        advance_task(task, true, (runtime.failure as Error).error)
      else raise "invalid async queued continuation" end
    end
  end
end

local function ready_tick(timer: uv.timer_t)
  local runtime: Runtime = uv.timer_get_data(timer)
  runtime.wake_armed = false
  local failed = false
  do drain_ready(runtime)
  catch
    failed = true
    fail_runtime(runtime, error, traceback)
  end
  -- Undispatched entries remain linked and rooted even after delivery fails.
  -- Preserve the first error if the replacement wake also fails.
  if runtime.ready_head ~= nil and not runtime.wake_armed then
    do arm_ready(runtime)
    catch
      failed = true
      fail_runtime(runtime, error, traceback)
    end
  end
  if failed then rethrow_failure(runtime.failure) end
end

local function ready_closed(timer: uv.timer_t)
  uv.timer_set_data(timer, nil)
end

--- Request sticky cancellation without completing accepted native work early.
-- @param reason First reason wins; nil selects simple cancellation with message cancelled.
-- @usage async-io.md
function Task:cancel(reason: CancellationReason<|B|>?)
  if self.phase == TASK_FINISHED or self.cancel_value ~= nil then return end
  local actual? = reason
  if actual == nil then actual = CancellationReason.simple("cancelled") end
  self.cancel_value = actual
  local wait? = self.wait
  if wait ~= nil and wait.policy == WAIT_CANCELLABLE and wait.request ~= nil then
    uv.cancel(wait.request as uv.req_t)
  end
  if self.suspended then
    local action? = self.suspend_cancel
    if action ~= nil then action() end
    self:resume(self.resume_token as ResumeToken)
  end
end

--- Schedule a deferred wake for the exact token authorizing the current explicit suspension.
-- @param token Exact ResumeToken passed to suspend; a mismatch raises in the caller.
-- @usage async-io.md
function Task:resume(token: ResumeToken)
  if token ~= self.resume_token then
    local source = "unknown source"
    local expected? = self.resume_token
    if expected ~= nil then source = expected.source or source end
    raise "Task resume token mismatch (expected source: " .. source .. ")"
  end
  if not self.suspended or self.resume_pending or self.phase == TASK_FINISHED then return end
  local wait = self.wait as Wait
  enqueue_ready(self as Task<|value, value|>, READY_RESUME, wait)
  self.resume_pending = true
end


--- Read context for the exact still-live callback operation.
-- @param number Operation number captured with this Completion during registration.
-- @return Typed registration context; stale numbers raise.
-- @usage async-io.md
function Completion:context(number: integer): C
  if self.epoch ~= number or number == 0 then raise "stale async operation number" end
  if self.phase == WAIT_RETIRED then raise "retired async operation context" end
  return self.stored_context
end

--- Settle one exact callback operation successfully.
-- @param number Captured operation number; stale or duplicate settlement raises.
-- @param result Successful payload; finish native cleanup before settlement.
-- @usage async-io.md
function Completion:resolve(number: integer, result: T)
  if self.epoch ~= number or number == 0 then raise "stale async operation number" end
  settle(self as Wait, OUTCOME_SUCCESS, result)
end

--- Settle one exact callback operation with an expected error.
-- @param number Captured operation number; stale or duplicate settlement raises.
-- @param error Expected operation error.
-- @usage async-io.md
function Completion:reject(number: integer, error: E)
  if self.epoch ~= number or number == 0 then raise "stale async operation number" end
  settle(self as Wait, OUTCOME_ERROR, error)
end

--- Report consumed terminal callback failure while preserving Runtime failure ownership.
-- @param number Captured operation number; a late failure must not retire a successor.
-- @param error Original unexpected raised value.
-- @param trace Original traceback; the callback must rethrow after reporting.
-- @usage async-io.md
function Completion:fatal(number: integer, error: value, trace: string)
  if self.epoch ~= number or number == 0 then
    if self.task.runtime.current_task ~= nil then raise "async fatal callback must run outside an async Task" end
    fail_runtime(self.task.runtime, error, trace)
    return
  end
  fatal(self as Wait, error, trace)
end

local function completion<|C, T, E|>(context: C, start: function (Completion<|C, T, E|>, integer): (uv.req_t?), policy: integer): Completion<|C, T, E|>
  local task = running()
  local saved? = task.completion
  if saved == nil then
    local created = Completion<|C, T, E|> {stored_context = context, register = start,
      task = task, epoch = 0, policy = policy, phase = WAIT_REGISTERING,
      kind = OUTCOME_SUCCESS, payload = nil, request = nil}
    task.completion = created as Wait
    return created
  end
  local reused = saved as Completion<|C, T, E|>
  reused.epoch = 0
  reused.stored_context = context
  reused.register = start
  reused.policy = policy
  reused.phase = WAIT_REGISTERING
  reused.kind = OUTCOME_SUCCESS
  reused.payload = nil
  reused.request = nil
  return reused
end

--- Register a typed callback wait and defer cancellation until accepted work completes.
-- @param context Typed context retained until operation retirement.
-- @param start Nonyielding registrar receiving Completion and operation number; may return nil or an accepted request.
-- @return Tagged operation result; cancellable waits may return cancelled.
-- @usage async-io.md
function await_with<|C, T, E|>(context: C, start: function (Completion<|C, T, E|>, integer): (uv.req_t?)): Result<|T, E|>
  return coroutine.yield(completion(context, start, WAIT_ORDINARY), ASYNC_TAG) as Result<|T, E|>
end

--- Register a typed ownership-cleanup wait despite pending cancellation or shutdown.
-- @param context Typed context retained until operation retirement.
-- @param start Nonyielding registrar receiving Completion and operation number; may return nil or an accepted request.
-- @return Tagged operation result; cancellable waits may return cancelled.
-- @usage async-io.md
function await_cleanup_with<|C, T, E|>(context: C, start: function (Completion<|C, T, E|>, integer): (uv.req_t?)): Result<|T, E|>
  return coroutine.yield(completion(context, start, WAIT_CLEANUP), ASYNC_TAG) as Result<|T, E|>
end

--- Register a typed wait, request native cancellation, and still await terminal completion.
-- @param context Typed context retained until operation retirement.
-- @param start Nonyielding registrar receiving Completion and operation number; returns the accepted request or settles inline.
-- @return Tagged operation result; cancellable waits may return cancelled.
-- @usage async-io.md
function await_cancellable_with<|C, T, E|>(context: C, start: function (Completion<|C, T, E|>, integer): (uv.req_t?)): CancellableResult<|T, E|>
  return coroutine.yield(completion(context, start, WAIT_CANCELLABLE), ASYNC_TAG) as CancellableResult<|T, E|>
end


local function legacy_settle(done: Wait, number: integer, kind: integer, payload: value)
  -- Old closure capabilities belonged to a retired fresh Wait, and duplicate
  -- invocation kept this diagnostic even after a successor was registered.
  if done.epoch ~= number then raise "async operation already settled" end
  settle(done, kind, payload)
end

local function old_start<|T, E|>(done: Completion<|function (function (T): (), function (E): (), function (value, string): ()): (uv.req_t?), T, E|>, number: integer): uv.req_t?
  local op = done:context(number)
  return op(function (result: T) legacy_settle(done as Wait, number, OUTCOME_SUCCESS, result) end,
      function (error: E) legacy_settle(done as Wait, number, OUTCOME_ERROR, error) end,
      function (error: value, trace: string) done:fatal(number, error, trace) end)
end

local function old_void_start<|T, E|>(done: Completion<|function (function (T): (), function (E): (), function (value, string): ()): (), T, E|>, number: integer): uv.req_t?
  local op = done:context(number)
  op(function (result: T) legacy_settle(done as Wait, number, OUTCOME_SUCCESS, result) end,
      function (error: E) legacy_settle(done as Wait, number, OUTCOME_ERROR, error) end,
      function (error: value, trace: string) done:fatal(number, error, trace) end)
  return nil
end

--- Wait for one callback-triple operation, retaining accepted ownership through cancellation.
-- @param op Nonyielding registrar receiving resolve, reject, and fatal callbacks; settle exactly once.
-- @return Tagged operation result; cancellable waits may return cancelled.
-- @usage async-io.md
function await<|T, E|>(op: function (function (T): (), function (E): (), function (value, string): ()): ()): Result<|T, E|>
  return await_with<|function (function (T): (), function (E): (), function (value, string): ()): (), T, E|>(op, old_void_start)
end

--- Wait for ownership cleanup despite pending cancellation or Runtime shutdown.
-- @param op Nonyielding registrar receiving resolve, reject, and fatal callbacks; settle exactly once.
-- @return Tagged operation result; cancellable waits may return cancelled.
-- @usage async-io.md
function await_cleanup<|T, E|>(op: function (function (T): (), function (E): (), function (value, string): ()): ()): Result<|T, E|>
  return await_cleanup_with<|function (function (T): (), function (E): (), function (value, string): ()): (), T, E|>(op, old_void_start)
end

--- Request supported native cancellation but wait for the promised terminal callback.
-- @param op Nonyielding registrar receiving resolve, reject, and fatal callbacks; settle exactly once.
-- @return Tagged operation result; cancellable waits may return cancelled.
-- @usage async-io.md
function await_cancellable<|T, E|>(op: function (function (T): (), function (E): (), function (value, string): ()): (uv.req_t?)): CancellableResult<|T, E|>
  return await_cancellable_with<|function (function (T): (), function (E): (), function (value, string): ()): (uv.req_t?), T, E|>(op, old_start)
end

--- Yield the current Task to a callback-deferred later scheduling turn.
-- @usage async-io.md
function yield()
  running()
  coroutine.yield(YIELD_TAG, ASYNC_TAG)
end

local function start_suspend(done: Completion<|ResumeToken, value, value|>, number: integer): uv.req_t?
  local token = done:context(number)
  local task = done.task
  task.suspended = true
  task.resume_token = token
  task.resume_pending = false
  return nil
end

--- Suspend the current Task for explicit token-authorized coordination.
-- @param token Identity capability shared only with authorized wake paths.
-- @param cancel_action Optional nonyielding, nonraising action detaching the exact waiter on cancellation.
-- @usage async-io.md
function suspend(token: ResumeToken, cancel_action: (function (): ())?)
  local task = running()
  -- The token remains unpublished until registration accepts this suspension.
  -- Even a finalizer during Completion construction must see a wrong-time
  -- resume as a mismatch. Rejection and setup errors clear the staged action.
  task.suspend_cancel = cancel_action
  defer clear_suspension(task)
  local result = await_with<|ResumeToken, value, value|>(token, start_suspend)
  case result
  when error(failure) then raise failure
  else
  end
end

--- Schedule a new Task and return before its function starts.
-- @param func Task body producing one success payload.
-- @return Initially ready Task; supply both success and cancellation type arguments or neither.
-- @usage async-io.md
function run<|A, B|>(func: function (): (A)): Task<|A, B|>
  local runtime = ensure_runtime()
  if runtime.closing or runtime.exit_code ~= nil then raise "cannot start a Task while async Runtime is shutting down" end
  local root = coroutine.create(function (_: value): value return func() end, ASYNC_TAG)
  local task = Task<|A, B|> {root = root, runtime = runtime, phase = TASK_READY, state = nil,
    epoch = 0, ready_next = nil, ready_queued = false, ready_kind = READY_START,
    ready_epoch = 0, ready_wait = nil,
    cancel_value = nil, wait = nil, completion = nil, root_index = runtime.next_task,
    terminal_registrations = {}, suspended = false, resume_token = nil,
    resume_pending = false, suspend_cancel = nil, cleanup_start = false,
    cleanup_active = false, cleanup_wait = nil, terminal_kind = TERMINAL_NONE,
    terminal_value = nil, terminal_trace = nil, root_done = false}
  local erased = task as Task<|value, value|>
  runtime.tasks[runtime.next_task] = erased
  runtime.next_task = runtime.next_task + 1
  do enqueue_ready(erased, READY_START, nil)
  catch finish_failure(erased, error, traceback); raise end
  return task
end

local function ExternalWait:check_cleanup_binding(runtime: Runtime)
  if self.bridge.runtime ~= runtime then
    raise "cleanup external wait belongs to another async Runtime"
  end
  if self.cleanup_task ~= nil then
    raise "cleanup external wait is already bound to a Task"
  end
  if self.used or self.retired then
    raise "cleanup external wait is consumed or closed"
  end
  if self.native.retire == nil then
    raise "cleanup external wait requires a native retirement capability"
  end
end

--- Schedule a body with deferred cleanup, including pre-start cancellation.
-- An optional same-Runtime native retirement capability is armed before
-- exposure and gates every terminal outcome, even if ordinary entries fail.
-- Only the bound Task's cleanup may await that capability.
function run_with_cleanup<|A, B|>(
    body: function (): (A),
    cleanup: function (CancellationReason<|B|>?): (),
    final_wait: ExternalWait?): Task<|A, B|>
  local runtime = ensure_runtime()
  if runtime.closing or runtime.exit_code ~= nil then
    raise "cannot start a Task while async Runtime is shutting down"
  end
  if final_wait ~= nil then final_wait:check_cleanup_binding(runtime) end
  local root = coroutine.create(function (_: value): value
    local task = running() as Task<|A, B|>
    defer do
      task.cleanup_active = true
      cleanup(task.cancel_value)
    end
    do
      checkpoint()
      local result = body()
      task.terminal_value = result
      return result
    catch
      -- Preserve the body's original error even if a cleanup entry later fails.
      task.terminal_kind = TERMINAL_FAILED
      task.terminal_value = error
      task.terminal_trace = traceback
      raise
    end
  end, ASYNC_TAG)
  local task = Task<|A, B|> {
    root = root, runtime = runtime, phase = TASK_READY, state = nil,
    epoch = 0, ready_next = nil, ready_queued = false, ready_kind = READY_START,
    ready_epoch = 0, ready_wait = nil, cancel_value = nil, wait = nil,
    completion = nil, root_index = runtime.next_task, terminal_registrations = {},
    suspended = false, resume_token = nil, resume_pending = false,
    suspend_cancel = nil, cleanup_start = true, cleanup_active = false,
    cleanup_wait = final_wait, terminal_kind = TERMINAL_NONE,
    terminal_value = nil, terminal_trace = nil, root_done = false
  }
  local erased = task as Task<|value, value|>
  -- Ownership-retiring cleanup must not need its first Completion allocation
  -- after the Task has already accepted cancellation.
  task.completion = Completion<|value, value, value|> {
    stored_context = nil, register = nil, task = erased, epoch = 0,
    policy = WAIT_CLEANUP, phase = WAIT_RETIRED, kind = OUTCOME_SUCCESS,
    payload = nil, request = nil
  }
  -- Allocations above may have run finalizers. Revalidate immediately before
  -- exclusive binding; no user code can consume or close the capability now.
  if final_wait ~= nil then
    final_wait:check_cleanup_binding(runtime)
    final_wait.cleanup_task = erased
  end
  local admitted = false
  defer if not admitted and final_wait ~= nil and final_wait.cleanup_task == erased then
    final_wait.cleanup_task = nil
  end
  do
    local index = runtime.next_task
    runtime.next_task = index + 1
    task.root_index = index
    runtime.tasks[index] = erased
    if final_wait ~= nil then
      check_status(final_wait.bridge.wake:activate(final_wait.target),
        "async.native_retirement.activate")
      -- All callbacks and their traced owner exist before native admission.
      -- The register contract has no linked waiter/ref on a negative result.
      local status = final_wait.native.register_wait(
        final_wait.native.context, final_wait.target)
      if status < 0 then check_status(status, "async.native_retirement.register") end
      final_wait.native.armed = 1
      final_wait.used = true
      final_wait.registered = status ~= 0
      if status == 0 then
        local retired = retirement_poll_native(final_wait.native)
        if retired > 0 then raise "native retirement is not complete" end
        check_status(retired, "async.native_retirement.retire")
        local target = final_wait.target
        final_wait.target = nil
        final_wait.bridge.waits[final_wait.identity] = nil
        uv.native_external_wake_unregister(target)
      end
    end
    enqueue_ready(erased, READY_START, nil)
  catch
    if final_wait ~= nil then
      -- Constructor rollback is native through release. It is not completion:
      -- the original domain owner still owns any running resource.
      if final_wait.registered then
        final_wait.registered = false
        final_wait.native.unregister_wait(final_wait.native.context)
      end
      local target = final_wait.target
      final_wait.target = nil
      final_wait.bridge.waits[final_wait.identity] = nil
      if target ~= nil then uv.native_external_wake_unregister(target) end
      final_wait.native.armed = 0
      final_wait.retired = true
      final_wait.cleanup_task = nil
      final_wait.native_owner = nil
      final_wait.native.context = nil
      task.cleanup_wait = nil
    end
    -- No Task was exposed and no body was entered. Admission failure is the
    -- constructor's synchronous error, not an unrelated unhandled Task failure.
    runtime.tasks[task.root_index] = nil
    task.phase = TASK_FINISHED
    raise
  end
  admitted = true
  return task
end

local function ExternalWait:detach_domain()
  if not self.registered then return end
  self.registered = false
  if self.native.unregister_wait ~= nil then
    self.native.unregister_wait(self.native.context)
  else
    self.unregister_fn()
  end
end

local function ExternalWait:retire()
  if self.retired then return end
  if self.native.armed ~= 0 and self.native.ready == 0 then
    -- The owning Task keeps an accepted retirement barrier even when its
    -- user-facing wait is closed or an ordinary cleanup entry failed.
    self.close_requested = true
    return
  end
  self.retired = true
  local target = self.target
  self.target = nil
  self.bridge.waits[self.identity] = nil
  -- No target borrow survives unregister: it consumes the registration ref.
  if target ~= nil then uv.native_external_wake_unregister(target) end
  self.done = nil
  self.cancel_action = nil
  self.register_fn = nil
  self.unregister_fn = nil
  self.cleanup_task = nil
  self.native_owner = nil
  self.native.context = nil
  self.native.register_wait = nil
  self.native.unregister_wait = nil
  self.native.retire = nil
end

local function ExternalWait:cancel_wait()
  self:detach_domain()
  self:retire()
end

function ExternalWait:close()
  if self.retired then return end
  local bound? = self.cleanup_task
  if bound ~= nil and bound.phase ~= TASK_FINISHED then
    if bound.runtime.current_task ~= bound or not bound.cleanup_active then
      raise "external wait is reserved for its Task cleanup"
    end
  end
  if self.done ~= nil then raise "cannot close an active external wait" end
  if self.native.armed ~= 0 and self.native.ready == 0 then
    self.close_requested = true
    return
  end
  self:retire()
end

local function ExternalWait:notify()
  if self.retired or self.notified then return end
  if self.native.retire ~= nil and self.native.ready == 0 then return end
  local bound? = self.cleanup_task
  if bound ~= nil and bound.root_done and bound.terminal_kind ~= TERMINAL_NONE then
    if not bound.ready_queued then enqueue_ready(bound, READY_TERMINAL, nil) end
    self.notified = true
    return
  end
  local done? = self.done
  if done == nil then return end
  local task = done.task
  if done.epoch ~= self.number or task.epoch ~= self.number or
      task.wait ~= done or done.phase ~= WAIT_PENDING then return end
  if done.policy == WAIT_CLEANUP then
    enqueue_ready(task, READY_RESUME, done)
  else
    task:resume(self.token)
  end
  self.notified = true
end

local function ExternalBridge:drain()
  if self.closed then return end
  local identities = foreign unsigned long long.new_array(64)
  local status, count = self.wake:drain(identities, 64)
  -- Count remains valid on an error. Schedule the consumed identities before
  -- reporting status; valid live libuv async handles have no recoverable send failure.
  local failed = false
  for index = 0, (count as integer) - 1 do
    local identity: integer = identities[index]
    local owner? = self.waits[identity]
    if owner ~= nil then
      if owner.native.retire ~= nil then
        -- The durable native receipt is retired/latching-ready before entering
        -- any ordinary notification method which could grow the Lua stack.
        local retired = retirement_poll_native(owner.native)
        if retired == 0 then
          local target = owner.target
          owner.target = nil
          self.waits[owner.identity] = nil
          owner.registered = false
          if target ~= nil then uv.native_external_wake_unregister(target) end
        elseif retired < 0 then
          if self.runtime.retirement_error == nil then self.runtime.retirement_error = owner end
          uv.stop(self.runtime.loop)
        end
      end
      do owner:notify()
      catch
        failed = true
        fail_runtime(self.runtime, error, traceback)
        -- The scheduler preserves ready work after its first Runtime failure,
        -- even when its timer can no longer be armed.
        owner:notify()
      end
    end
  end
  check_status(status, "async.external_wait.drain")
  if failed then rethrow_failure(self.runtime.failure) end
end

local function external_bridge(runtime: Runtime): ExternalBridge
  local existing? = runtime.external
  if existing ~= nil then return existing end
  local bridge = ExternalBridge {
    runtime = runtime, wake = uv.external_wake_t.new(), waits = {},
    next_identity = 1, closed = false
  }
  local callback = function (_: uv.external_wake_t) bridge:drain() end
  check_status(uv.external_wake_init(runtime.loop, bridge.wake, callback),
    "async.external_wait.init")
  runtime.external = bridge
  return bridge
end

local function prepare_wait(
    register_fn: (function (foreign *void): boolean)?,
    unregister_fn: (function (): ())?,
    native_owner: value, context: foreign *void,
    native_register: foreign function (*void, *void): int,
    native_unregister: foreign function (*void): void,
    native_retire: foreign function (*void): int): ExternalWait
  local runtime = ensure_runtime()
  if runtime.closing or runtime.exit_code ~= nil then
    raise "cannot prepare an external wait while async Runtime is shutting down"
  end
  local bridge = external_bridge(runtime)
  local identity = bridge.next_identity
  if identity == 0 then raise "async external wait identity exhausted" end
  if identity == (ffi.LUA_MAXINTEGER as integer) then bridge.next_identity = 0
  else bridge.next_identity = identity + 1 end
  local owner = ExternalWait {
    bridge = bridge, identity = identity, target = nil,
    register_fn = register_fn, unregister_fn = unregister_fn,
    token = ResumeToken("async.external_wait"), cancel_action = nil,
    done = nil, number = 0, used = false, registered = false,
    notified = false, retired = false, cleanup_task = nil,
    native = foreign titan_async_retirement.new(), native_owner = native_owner,
    awaited = false, close_requested = false
  }
  owner.native.context = context
  owner.native.register_wait = native_register
  owner.native.unregister_wait = native_unregister
  owner.native.retire = native_retire
  if native_retire == nil then
    owner.cancel_action = function () owner:cancel_wait() end
  end
  bridge.waits[identity] = owner
  do
    local status, target = bridge.wake:reserve(identity)
    owner.target = target
    check_status(status, "async.external_wait.reserve")
  catch
    owner:close()
    raise
  end
  return owner
end

--- Reserve a single-use external wait without keeping the Runtime loop alive.
-- At await, register_fn rechecks readiness and retains/publishes the wake
-- target only when returning true; false completes inline. unregister_fn must
-- detach a published target before releasing its native reference.
function prepare_external_wait(
    register_fn: function (foreign *void): boolean,
    unregister_fn: function (): ()): ExternalWait
  return prepare_wait(register_fn, unregister_fn, nil, nil, nil, nil, nil)
end

--- Prepare a native terminal gate for run_with_cleanup; retain owner as a root.
-- C-only register_fn returns 0 (ready), 1 (linked), or a negative native status
-- without admission. retire_fn returns 0 (retired), 1 (pending), or a negative
-- status (retryable through explicit loop entry after admission). unregister_fn
-- rolls back admission.
function prepare_native_retirement(
    owner: value, context: foreign *void,
    register_fn: foreign function (*void, *void): int,
    unregister_fn: foreign function (*void): void,
    retire_fn: foreign function (*void): int): ExternalWait
  if register_fn == nil or unregister_fn == nil or retire_fn == nil then
    raise "native retirement callbacks must not be NULL"
  end
  return prepare_wait(nil, nil, owner, context, register_fn, unregister_fn, retire_fn)
end

local function start_external_wait(
    done: Completion<|ExternalWait, nil, value|>, number: integer): uv.req_t?
  local owner = done:context(number)
  local task = done.task
  owner.done = done as Wait
  owner.number = number
  if done.policy ~= WAIT_CLEANUP then
    task.suspended = true
    task.resume_token = owner.token
    task.resume_pending = false
    task.suspend_cancel = owner.cancel_action
  end
  -- Preparation reserves native storage without keeping the loop alive.
  -- Activation is allocation-free and precedes native waiter publication.
  check_status(owner.bridge.wake:activate(owner.target), "async.external_wait.activate")
  -- The registrar checks readiness and publishes its retained native target
  -- under its domain mutex. An inline notification cannot run this loop.
  owner.registered = true
  local waiting = false
  do
    if owner.native.register_wait ~= nil then
      local status = owner.native.register_wait(owner.native.context, owner.target)
      if status < 0 then check_status(status, "async.external_wait.register") end
      waiting = status ~= 0
    else
      waiting = owner.register_fn(owner.target)
    end
  catch
    defer owner:retire()
    owner:detach_domain()
    raise
  end
  if not waiting then
    owner.registered = false
    owner:retire()
    done:resolve(number, nil)
  end
  return nil
end

local function start_native_retirement_wait(
    done: Completion<|ExternalWait, nil, value|>, number: integer): uv.req_t?
  local owner = done:context(number)
  owner.done = done as Wait
  owner.number = number
  if owner.native.ready ~= 0 then done:resolve(number, nil) end
  return nil
end

local function ExternalWait:await(policy: integer)
  local task = running()
  if task.runtime ~= self.bridge.runtime then
    raise "external wait belongs to another async Runtime"
  end
  if self.retired then raise "external wait is consumed or closed" end
  local bound? = self.cleanup_task
  if bound ~= nil and (bound ~= task or not task.cleanup_active or policy ~= WAIT_CLEANUP) then
    raise "external wait is reserved for its Task cleanup"
  end
  if self.native.retire ~= nil then
    if bound == nil then raise "native retirement is not bound to a cleanup Task" end
    if self.awaited or self.close_requested then raise "external wait is consumed or closed" end
    self.awaited = true
    defer do
      self.done = nil
      clear_suspension(task)
    end
    -- This exact cleanup boundary follows the domain's ordinary forwarding
    -- attempt. The native callback may begin approved reasonless retirement.
    local status = retirement_poll_native(self.native)
    if status == 0 then
      local target = self.target
      self.target = nil
      self.bridge.waits[self.identity] = nil
      self.registered = false
      if target ~= nil then uv.native_external_wake_unregister(target) end
      return
    end
    if status < 0 then
      if task.runtime.retirement_error == nil then task.runtime.retirement_error = self end
      uv.stop(task.runtime.loop)
    end
    local result = coroutine.yield(
      completion<|ExternalWait, nil, value|>(self, start_native_retirement_wait, WAIT_CLEANUP),
      ASYNC_TAG) as Result<|nil, value|>
    case result
    when error(failure) then raise failure
    else
    end
    return
  end
  if self.used then raise "external wait is consumed or closed" end
  self.used = true
  local completed = false
  defer do
    if not completed then self:detach_domain() end
    self:retire()
    clear_suspension(task)
  end
  local result = coroutine.yield(
    completion<|ExternalWait, nil, value|>(self, start_external_wait, policy),
    ASYNC_TAG) as Result<|nil, value|>
  case result
  when error(failure) then raise failure
  else
  end
  completed = true
end

--- Await this single-use generic wait with ordinary Task cancellation.
function ExternalWait:wait()
  self:await(WAIT_ORDINARY)
end

--- Await with cancellation shielding; native waits require bound Task cleanup.
function ExternalWait:wait_cleanup()
  self:await(WAIT_CLEANUP)
end

--- Prepare, await and close one ordinary cancellable external wait.
function wait_external(register_fn: function (foreign *void): boolean,
                       unregister_fn: function (): ())
  running()
  local owner = prepare_external_wait(register_fn, unregister_fn)
  defer owner:close()
  owner:wait()
end

--- Await one ordinary external wait through C-only registrars, rooting owner.
-- Context is borrowed until return, including synchronous cancellation unlink.
-- register_fn returns 0 (ready), 1 (linked), or a negative status with no link.
-- This is not a native retirement capability and cannot gate Task publication.
function wait_external_native(owner: value, context: foreign *void,
    register_fn: foreign function (*void, *void): int,
    unregister_fn: foreign function (*void): void)
  running()
  if register_fn == nil or unregister_fn == nil then
    raise "native external wait callbacks must not be NULL"
  end
  local wait = prepare_wait(nil, nil, owner, context, register_fn, unregister_fn, nil)
  defer wait:close()
  wait:wait()
end

--- Prepare, await and close one cancellation-shielded external wait.
function wait_external_cleanup(register_fn: function (foreign *void): boolean,
                               unregister_fn: function (): ())
  running()
  local owner = prepare_external_wait(register_fn, unregister_fn)
  defer owner:close()
  owner:wait_cleanup()
end

local function ExternalBridge:close()
  if self.closed then return end
  for _, owner in iteration.pairs(self.waits) do owner:close() end
  check_status(self.wake:close(), "async.external_wait.close")
  self.closed = true
end

local function close_handles(runtime: Runtime)
  local external? = runtime.external
  if external ~= nil then external:close() end
  uv.walk(runtime.loop, function (handle: uv.handle_t, _: value)
    if not uv.is_closing(handle) then
      case handle
      when timer(owner) then
        if owner == runtime.wake then uv.timer_close(owner, ready_closed)
        else uv.close(handle) end
      when async() then
        defer uv.close(handle)
        local data = uv.handle_get_data(handle)
        if data is Receiver then (data as Receiver):disable() end
      else uv.close(handle)
      end
    end
  end)
end

local function fail_runtime(runtime: Runtime, error: value, trace: string)
  if runtime.failure == nil then runtime.failure = Error(error, trace) end
  uv.unbind_transfer_loop(runtime.loop)
  runtime.closing = true
  -- The failing callback may have stopped or closed the borrowed loop's wake
  -- handle. Revalidate it before the driver can block on unrelated handles.
  runtime.wake_armed = false
  if runtime.driving then uv.stop(runtime.loop) end
end

local function cancel_shutdown_tasks(runtime: Runtime, origin: Task?)
  if runtime.shutdown_cancelled then return end
  runtime.shutdown_cancelled = true
  for index = 1, runtime.next_task - 1 do
    local task? = runtime.tasks[index]
    if task ~= nil and task ~= origin and task.terminal_kind == TERMINAL_NONE then
      do task:cancel(CancellationReason.simple("async Runtime stopped after callback failure")) catch end
    end
  end
end

local function unwind_orphans(runtime: Runtime)
  local stranded: {Orphan} = {}
  for index = 1, runtime.next_task - 1 do
    local task? = runtime.tasks[index]
    if task ~= nil and not task.root_done then
      stranded[#stranded + 1] = Orphan(task, task.wait, task.epoch)
    end
  end
  -- Cancellation may queue legitimate explicit wakes or settle another
  -- captured wait. Never reinterpret a newer wait as one from this snapshot.
  cancel_shutdown_tasks(runtime, nil)
  for index = 1, #stranded do
    local orphan = stranded[index]
    local task = orphan.task
    local wait? = orphan.wait
    if task.phase ~= TASK_FINISHED and task.epoch == orphan.epoch and
        task.wait == wait and not task.ready_queued and not task.resume_pending and
        (wait == nil or wait.phase == WAIT_PENDING) then
      if wait ~= nil then wait.phase = WAIT_RETIRED; release_completion(wait) end
      task.wait = nil
      clear_suspension(task)
      local failure = runtime.failure as Error
      advance_task(task, true, failure.error)
    end
  end
end

--- Drive the active Runtime on the Lua main thread until Tasks and native cleanup finish.
-- @usage async-io.md
function loop()
  require_main_thread()
  local runtime? = active_runtime
  if runtime == nil then return end
  if runtime.current_task ~= nil then raise "async.loop must be driven from the Lua main thread" end
  if runtime.driving then raise "async.loop is already being driven" end
  runtime.driving = true
  defer runtime.driving = false
  -- A negative native retirement result leaves this Runtime and every native
  -- owner intact. Only an explicit new loop() invocation retries those calls.
  runtime.retirement_error = nil
  for index = 1, runtime.next_task - 1 do
    local task? = runtime.tasks[index]
    if task ~= nil then
      local barrier? = task.cleanup_wait
      if barrier ~= nil and barrier.native.status < 0 then barrier.native.status = 1 end
    end
  end
  local recover_native = true
  while true do
    if recover_native or runtime.failure ~= nil then
      recover_native = false
      -- Emergency recovery uses the existing Task inventory, not a channel
      -- registry. It runs before blocking even when a native wait refs UV.
      for index = 1, runtime.next_task - 1 do
        local task? = runtime.tasks[index]
        if task ~= nil then
          local barrier? = task.cleanup_wait
          if barrier ~= nil and barrier.native.armed ~= 0 and barrier.native.ready == 0 then
            local notified = uv.native_external_wake_is_notified(barrier.target) ~= 0
            if notified or task.root_done or barrier.awaited then
              local status = retirement_poll_native(barrier.native)
              if status == 0 then
                local target = barrier.target
                barrier.target = nil
                barrier.bridge.waits[barrier.identity] = nil
                barrier.registered = false
                if target ~= nil then uv.native_external_wake_unregister(target) end
              elseif status < 0 then
                if runtime.retirement_error == nil then runtime.retirement_error = barrier end
              end
            end
          end
          if task.root_done and task.terminal_kind ~= TERMINAL_NONE and
              (barrier == nil or barrier.native.ready ~= 0) then
            if not task.ready_queued then
              do enqueue_ready(task, READY_TERMINAL, nil)
              catch recover_native = true; fail_runtime(runtime, error, traceback) end
            end
          elseif barrier ~= nil and barrier.native.ready ~= 0 and
              barrier.done ~= nil and not barrier.notified then
            do barrier:notify()
            catch recover_native = true; fail_runtime(runtime, error, traceback) end
          end
          if runtime.failure ~= nil and not task.root_done and not task.ready_queued then
            if task.phase == TASK_READY then
              -- An entry allocation may have failed after dequeue but before
              -- the startup trampoline ran. Preserve run_with_cleanup's entry.
              do enqueue_ready(task, READY_START, nil)
              catch recover_native = true; fail_runtime(runtime, error, traceback) end
            else
              local waiting? = task.wait
              if waiting ~= nil and waiting.phase == WAIT_SETTLED then
                do enqueue_ready(task, READY_DELIVER, waiting)
                catch recover_native = true; fail_runtime(runtime, error, traceback) end
              else
                local registrar: value = start_native_retirement_wait
                local unaccepted_native = waiting ~= nil and barrier ~= nil and
                  waiting.phase == WAIT_REGISTERING and waiting.stored_context == barrier and
                  waiting.register == registrar
                if waiting == nil or waiting.phase == WAIT_RETIRED or unaccepted_native then
                  -- These operations have no outstanding domain acceptance.
                  -- A cleanup barrier itself remains preaccepted and retained.
                  task.wait = nil
                  task.suspended = false
                  task.resume_token = nil
                  task.resume_pending = false
                  task.suspend_cancel = nil
                  if barrier ~= nil and task.terminal_kind == TERMINAL_NONE then
                    local failure = runtime.failure as Error
                    task.terminal_kind = TERMINAL_FAILED
                    task.terminal_value = failure.error
                    task.terminal_trace = failure.traceback
                  end
                  do enqueue_ready(task, READY_UNWIND, nil)
                  catch recover_native = true; fail_runtime(runtime, error, traceback) end
                end
              end
            end
          end
        end
      end
    end
    local retirement_error? = runtime.retirement_error
    if retirement_error ~= nil then
      raise operation_error(retirement_error.native.status, "async.native_retirement.retire")
    end
    if runtime.failure ~= nil then cancel_shutdown_tasks(runtime, nil) end
    if runtime.ready_head ~= nil and not runtime.wake_armed then
      local wake_failed = false
      do arm_ready(runtime)
      catch
        wake_failed = true
        fail_runtime(runtime, error, traceback)
      end
      if wake_failed then
        cancel_shutdown_tasks(runtime, nil)
        -- An unrelated referenced handle may need one of these continuations
        -- to close it. Recover ready work before a blocking uv.run, not only
        -- once native liveness reaches zero. Pending native waits stay owned.
        do drain_ready(runtime) catch fail_runtime(runtime, error, traceback) end
      end
    end
    -- Task-owned cleanup may have accepted a handle-based wait. Leave its
    -- completion and scheduler wakes intact until every Task has unwound.
    if not has_tasks(runtime) and runtime.ready_head == nil then
      uv.unbind_transfer_loop(runtime.loop)
      runtime.closing = true
      do close_handles(runtime) catch fail_runtime(runtime, error, traceback) end
    end
    local mode = uv.RUN_DEFAULT
    if runtime.ready_head ~= nil and not runtime.wake_armed then mode = uv.RUN_NOWAIT end
    if recover_native then mode = uv.RUN_NOWAIT end
    do uv.run(runtime.loop, mode)
    catch
      fail_runtime(runtime, error, traceback)
      recover_native = true
    end
    if not uv.loop_alive(runtime.loop) then
      if runtime.ready_head ~= nil then
        -- Accepted work remains in the ready queue. The next outer iteration
        -- rearms it or recovers a bounded batch before classifying orphans.
        runtime.wake_armed = false
      elseif has_tasks(runtime) then
        if runtime.failure == nil then fail_runtime(runtime, "libuv loop became idle while async Tasks were waiting", "") end
        unwind_orphans(runtime)
      else
        -- Native liveness excludes initialized inactive handles. Last-Task
        -- retirement can reach this branch before the next outer iteration.
        do close_handles(runtime) catch fail_runtime(runtime, error, traceback) end
        if not uv.loop_alive(runtime.loop) then
          local status = uv.loop_close(runtime.loop)
          if status == 0 then
            uv.timer_set_data(runtime.wake, nil)
            notify_runtime_closed(runtime)
            active_runtime = nil
            local failure? = runtime.failure
            if failure ~= nil then rethrow_failure(failure) end
            return
          end
          check_status(status, "runtime.loop.close")
        end
      end
    end
  end
end

--- Return the bundled libuv version string.
-- @return Native libuv version.
-- @usage async-io.md
function version(): string
  return uv.version_string()
end

local record ForeignWork
  local request: uv.work_t
  local worker: foreign function (*void): void
  local argument: foreign *void
  local done: Completion<|ForeignWork, value, OperationError|>?
  local number: integer
end

local function foreign_work_completed(request: uv.work_t, status: integer)
  local work: ForeignWork = request:get_data()
  local done = work.done as Completion<|ForeignWork, value, OperationError|>
  local number = work.number
  request:set_data(nil)
  work.done = nil
  do
    if status < 0 then done:reject(number, operation_error(status, "async.run_foreign"))
    else done:resolve(number, nil) end
  catch done:fatal(number, error, traceback); raise end
end

local function start_foreign_work(done: Completion<|ForeignWork, value, OperationError|>, number: integer): uv.req_t?
  local work = done:context(number)
  work.done = done
  work.number = number
  work.request:set_data(work)
  local status = uv.queue_work(current_loop(), work.request, work.worker,
      work.argument, foreign_work_completed, nil)
  if status < 0 then
    work.request:set_data(nil)
    work.done = nil
    done:reject(number, operation_error(status, "async.run_foreign"))
  end
  return nil
end

--- Run one blocking C function-pointer call in the shared worker pool and wait for completion.
-- @param f C-only entry; it must never enter the calling Lua/Titan state. Separately owned states follow the titan.lua isolation protocol.
-- @param arg Native pointer whose owner remains live until after-work completion, including cancellation.
-- @usage async-io.md
function run_foreign(f: foreign function (*void): void, arg: foreign *void)
  if not f then raise "async.run_foreign callback must not be NULL" end
  local work = ForeignWork(uv.work_t.new(), f, arg, nil, 0)
  local result = await_with<|ForeignWork, value, OperationError|>(work, start_foreign_work)
  case result
  when error(failure) then raise failure
  else
  end
end

--- Create a bounded FIFO channel with at most one blocked sender and receiver.
-- @param size Positive capacity; nil defaults to one.
-- @return Send, receive, and idempotent close functions; close discards buffered values.
-- @usage async-io.md
function channel<|T|>(size: integer?):
    (function (T): (), function (): (T), function (): ())
  local capacity = size or 1
  if capacity < 1 then raise "channel size must be at least 1" end

  -- Count is authoritative because a channel may carry nil. The array slots
  -- only retain the live values in the bounded circular buffer.
  local transfer: {T} = {}
  local first = 1
  local next = 1
  local count = 0
  local send_waiter: Task<|value, value|>? = nil
  local receive_waiter: Task<|value, value|>? = nil
  local closed = false
  local resume_token = ResumeToken("channel")

  local send: function (T): () = function (item: T)
    if closed then raise "channel is closed" end
    if send_waiter ~= nil then
      raise "channel already has a blocked sender"
    end
    if count == capacity then
      local current = running()
      send_waiter = current
      defer do
        if send_waiter == current then send_waiter = nil end
      end
      suspend(resume_token)
      send_waiter = nil
      if closed then raise "channel is closed" end
    end

    transfer[next] = item
    next = next + 1
    if next > capacity then next = 1 end
    count = count + 1
    if receive_waiter ~= nil then receive_waiter:resume(resume_token) end
  end

  local receive: function (): (T) = function (): T
    if closed then raise "channel is closed" end
    if receive_waiter ~= nil then
      raise "channel already has a blocked receiver"
    end
    if count == 0 then
      local current = running()
      receive_waiter = current
      defer do
        if receive_waiter == current then receive_waiter = nil end
      end
      suspend(resume_token)
      receive_waiter = nil
      if closed then raise "channel is closed" end
    end

    local item = transfer[first]
    transfer[first] = nil
    first = first + 1
    if first > capacity then first = 1 end
    count = count - 1
    if send_waiter ~= nil then send_waiter:resume(resume_token) end
    return item
  end

  local close: function (): () = function ()
    if closed then return end
    closed = true
    transfer = {}
    first = 1
    next = 1
    count = 0
    if send_waiter ~= nil then send_waiter:resume(resume_token) end
    if receive_waiter ~= nil then receive_waiter:resume(resume_token) end
  end

  return send, receive, close
end

--- Read a string channel message or a buffered delimiter suffix.
-- @return String chunk, or nil after reader close; empty strings are data.
-- @usage async-io.md
function ChannelReader:read(): string?
  if self.closed then return nil end
  if self.excess then
    local excess = self.excess
    self.excess = nil
    return excess
  end
  return self.receive()
end

--- Read through a delimiter across string-channel message boundaries.
-- @param delimiter Nonempty binary delimiter.
-- @param chop True removes the delimiter.
-- @return Delimited bytes or final suffix, or nil after reader close.
-- @usage async-io.md
function ChannelReader:read_until(delimiter: string,
                                  chop: boolean?): string?
  if self.closed then return nil end
  if #delimiter == 0 then raise "read delimiter must not be empty" end

  local builder = string.writer()
  local tail = ""
  while true do
    local chunk? = self:read()
    if not chunk then
      if #tail > 0 then builder:write(tail) end
      local result = builder:drain()
      if #result == 0 then return nil end
      return result
    end
    local bytes = chunk as string
    local boundary = bytes
    if #tail > 0 then boundary = tail .. bytes end
    local match: integer? = string.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(string.sub(boundary, 1, result_end))
      end
      local excess = string.sub(boundary, match_end + 1)
      if #excess > 0 then
        self.excess = excess
      else
        self.excess = nil
      end
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(string.sub(boundary, 1, committed))
      end
    end
    tail = string.sub(boundary, committed + 1)
  end
end

--- Close the string channel and discard this reader buffered suffix.
-- @usage async-io.md
function ChannelReader:close()
  if self.closed then return end
  self.closed = true
  self.excess = nil
  self.close_channel()
end

--- Send binary bytes through the bounded string channel.
-- @param data String message; may suspend while the channel is full.
-- @usage async-io.md
function ChannelWriter:write(data: string)
  self.send(data)
end

--- Close the underlying channel while preserving any suffix already held by its reader.
-- @usage async-io.md
function ChannelWriter:close()
  self.close_channel()
end

--- Create opaque Reader and Writer facades over a bounded string channel.
-- @param size Positive channel capacity; nil defaults to one.
-- @return Paired ChannelReader and ChannelWriter.
-- @usage async-io.md
function reader_writer_channel(size: integer?):
    (ChannelReader, ChannelWriter)
  local send, receive, close = channel<|string|>(size)
  return ChannelReader {
    receive = receive,
    close_channel = close,
    excess = nil,
    closed = false,
  }, ChannelWriter(send, close)
end

-- The Runtime never runs two Tasks reentrantly, so a named operand equal to
-- the current Task is exactly the self-dependency that cannot become terminal
-- while this combinator is suspended.
local function reject_running<|A, B|>(current: Task<|value, value|>, task: Task<|A, B|>)
  if current == task then
    raise "async combinator cannot wait for its running Task"
  end
end

-- Keep the fixed-arity bodies expanded over their named operands: collecting
-- Tasks into one array would erase the independent result/cancellation type
-- positions of the public generic Task API.

--- Wait for the first success among 2 Tasks without cancelling other operands.
-- @param first First Task; already-terminal ties choose the leftmost success.
-- @param second Second Task; already-terminal ties choose the leftmost success.
-- @return AnyTwoResult preserving the winner, or none when all operands reject.
-- @usage async-io.md
function any_two<|A1, B1, A2, B2|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>):
    AnyTwoResult<|A1, A2|>
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local terminal_count = 0
  if first.phase == TASK_FINISHED then
    case first:status()
    when succeeded(result) then return AnyTwoResult<|A1, A2|>.first(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if second.phase == TASK_FINISHED then
    case second:status()
    when succeeded(result) then return AnyTwoResult<|A1, A2|>.second(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if terminal_count == 2 then return AnyTwoResult<|A1, A2|>.none() end

  local resume_token = ResumeToken("async.any_two")
  local waiting = current
  local winner = 0
  local result: value = nil

  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 1
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 2
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  suspend(resume_token)
  if winner == 1 then return AnyTwoResult<|A1, A2|>.first(result) end
  if winner == 2 then return AnyTwoResult<|A1, A2|>.second(result) end
  return AnyTwoResult<|A1, A2|>.none()
end

--- Wait for the first success among 3 Tasks without cancelling other operands.
-- @param first First Task; already-terminal ties choose the leftmost success.
-- @param second Second Task; already-terminal ties choose the leftmost success.
-- @param third Third Task; already-terminal ties choose the leftmost success.
-- @return AnyThreeResult preserving the winner, or none when all operands reject.
-- @usage async-io.md
function any_three<|A1, B1, A2, B2, A3, B3|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>,
    third: Task<|A3, B3|>):
    AnyThreeResult<|A1, A2, A3|>
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)

  local terminal_count = 0
  if first.phase == TASK_FINISHED then
    case first:status()
    when succeeded(result) then return AnyThreeResult<|A1, A2, A3|>.first(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if second.phase == TASK_FINISHED then
    case second:status()
    when succeeded(result) then return AnyThreeResult<|A1, A2, A3|>.second(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if third.phase == TASK_FINISHED then
    case third:status()
    when succeeded(result) then return AnyThreeResult<|A1, A2, A3|>.third(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if terminal_count == 3 then return AnyThreeResult<|A1, A2, A3|>.none() end

  local resume_token = ResumeToken("async.any_three")
  local waiting = current
  local winner = 0
  local result: value = nil

  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 1
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 2
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<|A3, B3|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 3
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  suspend(resume_token)
  if winner == 1 then return AnyThreeResult<|A1, A2, A3|>.first(result) end
  if winner == 2 then return AnyThreeResult<|A1, A2, A3|>.second(result) end
  if winner == 3 then return AnyThreeResult<|A1, A2, A3|>.third(result) end
  return AnyThreeResult<|A1, A2, A3|>.none()
end

--- Wait for the first success among 4 Tasks without cancelling other operands.
-- @param first First Task; already-terminal ties choose the leftmost success.
-- @param second Second Task; already-terminal ties choose the leftmost success.
-- @param third Third Task; already-terminal ties choose the leftmost success.
-- @param fourth Fourth Task; already-terminal ties choose the leftmost success.
-- @return AnyFourResult preserving the winner, or none when all operands reject.
-- @usage async-io.md
function any_four<|A1, B1, A2, B2, A3, B3, A4, B4|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>,
    third: Task<|A3, B3|>, fourth: Task<|A4, B4|>):
    AnyFourResult<|A1, A2, A3, A4|>
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)
  reject_running(current, fourth)

  local terminal_count = 0
  if first.phase == TASK_FINISHED then
    case first:status()
    when succeeded(result) then return AnyFourResult<|A1, A2, A3, A4|>.first(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if second.phase == TASK_FINISHED then
    case second:status()
    when succeeded(result) then return AnyFourResult<|A1, A2, A3, A4|>.second(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if third.phase == TASK_FINISHED then
    case third:status()
    when succeeded(result) then return AnyFourResult<|A1, A2, A3, A4|>.third(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if fourth.phase == TASK_FINISHED then
    case fourth:status()
    when succeeded(result) then return AnyFourResult<|A1, A2, A3, A4|>.fourth(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if terminal_count == 4 then return AnyFourResult<|A1, A2, A3, A4|>.none() end

  local resume_token = ResumeToken("async.any_four")
  local waiting = current
  local winner = 0
  local result: value = nil

  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 1
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 2
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<|A3, B3|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 3
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  local fourth_listener = function (status: TaskStatus<|A4, B4|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 4
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 4 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_fourth_listener = fourth:add_terminal_listener(fourth_listener)
  defer remove_fourth_listener()

  suspend(resume_token)
  if winner == 1 then return AnyFourResult<|A1, A2, A3, A4|>.first(result) end
  if winner == 2 then return AnyFourResult<|A1, A2, A3, A4|>.second(result) end
  if winner == 3 then return AnyFourResult<|A1, A2, A3, A4|>.third(result) end
  if winner == 4 then return AnyFourResult<|A1, A2, A3, A4|>.fourth(result) end
  return AnyFourResult<|A1, A2, A3, A4|>.none()
end

--- Wait for the first success among 5 Tasks without cancelling other operands.
-- @param first First Task; already-terminal ties choose the leftmost success.
-- @param second Second Task; already-terminal ties choose the leftmost success.
-- @param third Third Task; already-terminal ties choose the leftmost success.
-- @param fourth Fourth Task; already-terminal ties choose the leftmost success.
-- @param fifth Fifth Task; already-terminal ties choose the leftmost success.
-- @return AnyFiveResult preserving the winner, or none when all operands reject.
-- @usage async-io.md
function any_five<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>,
    third: Task<|A3, B3|>, fourth: Task<|A4, B4|>,
    fifth: Task<|A5, B5|>):
    AnyFiveResult<|A1, A2, A3, A4, A5|>
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)
  reject_running(current, fourth)
  reject_running(current, fifth)

  local terminal_count = 0
  if first.phase == TASK_FINISHED then
    case first:status()
    when succeeded(result) then return AnyFiveResult<|A1, A2, A3, A4, A5|>.first(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if second.phase == TASK_FINISHED then
    case second:status()
    when succeeded(result) then return AnyFiveResult<|A1, A2, A3, A4, A5|>.second(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if third.phase == TASK_FINISHED then
    case third:status()
    when succeeded(result) then return AnyFiveResult<|A1, A2, A3, A4, A5|>.third(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if fourth.phase == TASK_FINISHED then
    case fourth:status()
    when succeeded(result) then return AnyFiveResult<|A1, A2, A3, A4, A5|>.fourth(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if fifth.phase == TASK_FINISHED then
    case fifth:status()
    when succeeded(result) then return AnyFiveResult<|A1, A2, A3, A4, A5|>.fifth(result)
    when failed() then
      terminal_count = terminal_count + 1
    when cancelled() then
      terminal_count = terminal_count + 1
    end
  end

  if terminal_count == 5 then return AnyFiveResult<|A1, A2, A3, A4, A5|>.none() end

  local resume_token = ResumeToken("async.any_five")
  local waiting = current
  local winner = 0
  local result: value = nil

  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 1
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 5 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
      if terminal_count == 5 then
        winner = -1
        waiting:resume(resume_token)
      end
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if winner ~= 0 then return end
    case status
    when succeeded(payload) then
      winner = 2
      result = payload
      waiting:resume(resume_token)
    when failed() then
      terminal_count = terminal_count + 1
      if terminal_count == 5 then
        winner = -1
        waiting:resume(resume_token)
      end
    when cancelled() then
      terminal_count = terminal_count + 1
