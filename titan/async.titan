local uv = import "uv"
local str = import "string"

type Error = uv.Error
type OperationError = uv.OperationError
type CancellationReason = uv.CancellationReason
type TaskStatus = uv.TaskStatus
type Task = uv.Task

record ChannelReader
  local receive: () -> value
  local close_channel: () -> ()
  local excess: string?
  local closed: boolean
end

record ChannelWriter
  local send: (value) -> ()
  local close_channel: () -> ()
end

union AnyTwoResult
  first: value
  second: value
  none
end

union AnyThreeResult
  first: value
  second: value
  third: value
  none
end

union AnyFourResult
  first: value
  second: value
  third: value
  fourth: value
  none
end

union AnyFiveResult
  first: value
  second: value
  third: value
  fourth: value
  fifth: value
  none
end

union RaceTwoResult
  first: TaskStatus
  second: TaskStatus
end

union RaceThreeResult
  first: TaskStatus
  second: TaskStatus
  third: TaskStatus
end

union RaceFourResult
  first: TaskStatus
  second: TaskStatus
  third: TaskStatus
  fourth: TaskStatus
end

union RaceFiveResult
  first: TaskStatus
  second: TaskStatus
  third: TaskStatus
  fourth: TaskStatus
  fifth: TaskStatus
end

union AllTwoError
  first: TaskStatus
  second: TaskStatus
end

union AllThreeError
  first: TaskStatus
  second: TaskStatus
  third: TaskStatus
end

union AllFourError
  first: TaskStatus
  second: TaskStatus
  third: TaskStatus
  fourth: TaskStatus
end

union AllFiveError
  first: TaskStatus
  second: TaskStatus
  third: TaskStatus
  fourth: TaskStatus
  fifth: TaskStatus
end

function run(func: () -> value): Task
  return uv._run(func)
end

function loop()
  uv._loop()
end

function yield()
  uv._yield()
end

function running(): Task
  return uv._running()
end

function suspend()
  uv._suspend()
end

function version(): string
  return uv._version()
end

function channel(size: integer?):
    ((value) -> (), () -> value, () -> ())
  local capacity = 1
  if size ~= nil then capacity = size end
  if capacity < 1 then raise "channel size must be at least 1" end

  -- Count is authoritative because a channel may carry nil. The array slots
  -- only retain the live values in the bounded circular buffer.
  local transfer: {value} = {}
  local first = 1
  local next = 1
  local count = 0
  local send_waiter: Task? = nil
  local receive_waiter: Task? = nil
  local closed = false

  local send: (value) -> () = function (item: value)
    if closed then raise "channel is closed" end
    if send_waiter ~= nil then
      raise "channel already has a blocked sender"
    end
    if count == capacity then
      local current = running()
      send_waiter = current
      defer do
        if send_waiter == current then send_waiter = nil end
      end
      -- A caller that holds this Task may also request a wake. Recheck the
      -- channel condition so such a coalesced wake cannot overwrite a full
      -- buffer.
      while not closed and count == capacity do suspend() end
      send_waiter = nil
      if closed then raise "channel is closed" end
    end

    transfer[next] = item
    next = next + 1
    if next > capacity then next = 1 end
    count = count + 1
    if receive_waiter ~= nil then receive_waiter:resume() end
  end

  local receive: () -> value = function (): value
    if closed then raise "channel is closed" end
    if receive_waiter ~= nil then
      raise "channel already has a blocked receiver"
    end
    if count == 0 then
      local current = running()
      receive_waiter = current
      defer do
        if receive_waiter == current then receive_waiter = nil end
      end
      -- As with send, a direct Task:resume is only a wake request. The buffer
      -- condition remains the authority for whether receive may continue.
      while not closed and count == 0 do suspend() end
      receive_waiter = nil
      if closed then raise "channel is closed" end
    end

    local item = transfer[first]
    transfer[first] = nil
    first = first + 1
    if first > capacity then first = 1 end
    count = count - 1
    if send_waiter ~= nil then send_waiter:resume() end
    return item
  end

  local close: () -> () = function ()
    if closed then return end
    closed = true
    transfer = {}
    first = 1
    next = 1
    count = 0
    if send_waiter ~= nil then send_waiter:resume() end
    if receive_waiter ~= nil then receive_waiter:resume() end
  end

  return send, receive, close
end

function ChannelReader:read(): string?
  if self.closed then return nil end
  if self.excess then
    local excess = self.excess
    self.excess = nil
    return excess
  end
  return self.receive() as string?
end

function ChannelReader:read_until(delimiter: string,
                                  chop: boolean?): string?
  if self.closed then return nil end
  if #delimiter == 0 then raise "read delimiter must not be empty" end

  local builder = str.writer()
  local tail = ""
  while true do
    local chunk? = self:read()
    if not chunk then
      if #tail > 0 then builder:write(tail) end
      local result = builder:drain()
      if #result == 0 then return nil end
      return result
    end
    local bytes = chunk as string
    local boundary = bytes
    if #tail > 0 then boundary = tail .. bytes end
    local match: integer? = str.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(str.sub(boundary, 1, result_end))
      end
      local excess = str.sub(boundary, match_end + 1)
      if #excess > 0 then
        self.excess = excess
      else
        self.excess = nil
      end
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(str.sub(boundary, 1, committed))
      end
    end
    tail = str.sub(boundary, committed + 1)
  end
end

function ChannelReader:close()
  if self.closed then return end
  self.closed = true
  self.excess = nil
  self.close_channel()
end

function ChannelWriter:write(data: string)
  self.send(data)
end

function ChannelWriter:close()
  self.close_channel()
end

function reader_writer_channel(size: integer?):
    (ChannelReader, ChannelWriter)
  local send, receive, close = channel(size)
  return ChannelReader.new(receive, close, nil, false),
         ChannelWriter.new(send, close)
end

-- The Runtime never runs two Tasks reentrantly, so a named operand equal to
-- the current Task is exactly the self-dependency that cannot become terminal
-- while this combinator is suspended.
local function reject_running(current: Task, task: Task)
  if current == task then
    raise "async combinator cannot wait for its running Task"
  end
end

-- Keep the fixed-arity bodies expanded over their named operands: collecting
-- Tasks into one array would erase the independent result/cancellation type
-- positions needed by a future polymorphic Task.

function any_two(first: Task, second: Task): AnyTwoResult
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local terminal_count = 0
  local first_terminal = false
  case first:status()
  when succeeded: result then return AnyTwoResult.first(result)
  when failed then
    first_terminal = true
    terminal_count = terminal_count + 1
  when cancelled then
    first_terminal = true
    terminal_count = terminal_count + 1
  else
  end

  local second_terminal = false
  case second:status()
  when succeeded: result then return AnyTwoResult.second(result)
  when failed then
    second_terminal = true
    terminal_count = terminal_count + 1
  when cancelled then
    second_terminal = true
    terminal_count = terminal_count + 1
  else
  end

  if terminal_count == 2 then return AnyTwoResult.none() end

  local waiting? = current
  defer waiting = nil
  local winner = 0
  local result: value = nil

  local first_listener = function (status: TaskStatus)
    if waiting == nil or winner ~= 0 then return end
    case status
    when succeeded: payload then
      winner = 1
      result = payload
      waiting:resume()
    when failed then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume()
      end
    when cancelled then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume()
      end
    else
    end
  end
  defer first:remove_terminal_listener(first_listener)
  if not first_terminal then first:add_terminal_listener(first_listener) end

  local second_listener = function (status: TaskStatus)
    if waiting == nil or winner ~= 0 then return end
    case status
    when succeeded: payload then
      winner = 2
      result = payload
      waiting:resume()
    when failed then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume()
      end
    when cancelled then
      terminal_count = terminal_count + 1
      if terminal_count == 2 then
        winner = -1
        waiting:resume()
      end
    else
    end
  end
  defer second:remove_terminal_listener(second_listener)
  if not second_terminal then second:add_terminal_listener(second_listener) end

  suspend()
  if winner == 1 then return AnyTwoResult.first(result) end
  if winner == 2 then return AnyTwoResult.second(result) end
  return AnyTwoResult.none()
end

