function all_two<A1, B1, A2, B2>(
    first: Task<A1, B1>, second: Task<A2, B2>): (A1, A2)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local completed = 0
  local first_result: value = nil
  local first_status = first:status()
  case first_status
  when succeeded: result then
    first_result = result
    completed = completed + 1
  when failed then raise AllTwoError<A1, B1, A2, B2>.first(first_status)
  when cancelled then raise AllTwoError<A1, B1, A2, B2>.first(first_status)
  end

  local second_result: value = nil
  local second_status = second:status()
  case second_status
  when succeeded: result then
    second_result = result
    completed = completed + 1
  when failed then raise AllTwoError<A1, B1, A2, B2>.second(second_status)
  when cancelled then raise AllTwoError<A1, B1, A2, B2>.second(second_status)
  end

  if completed == 2 then
    return first_result as A1, second_result as A2
  end

  local waiting? = current
  defer waiting = nil
  local rejected = 0
  local rejection = TaskStatus<value, value>.ready()

  local first_listener = function (status: TaskStatus<A1, B1>)
    if waiting == nil or rejected ~= 0 then return end
    case status
    when succeeded: result then
      first_result = result
      completed = completed + 1
      if completed == 2 then waiting:resume() end
    when failed then
      rejected = 1
      rejection = status
      waiting:resume()
    when cancelled then
      rejected = 1
      rejection = status
      waiting:resume()
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<A2, B2>)
    if waiting == nil or rejected ~= 0 then return end
    case status
    when succeeded: result then
      second_result = result
      completed = completed + 1
      if completed == 2 then waiting:resume() end
    when failed then
      rejected = 2
      rejection = status
      waiting:resume()
    when cancelled then
      rejected = 2
      rejection = status
      waiting:resume()
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  suspend()
  if rejected == 1 then
    raise AllTwoError<A1, B1, A2, B2>.first(rejection as TaskStatus<A1, B1>)
  end
  if rejected == 2 then
    raise AllTwoError<A1, B1, A2, B2>.second(rejection as TaskStatus<A2, B2>)
  end
  return first_result as A1, second_result as A2
end

