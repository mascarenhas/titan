  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<|A3, B3|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      third_result = result
      completed = completed + 1
      if completed == 3 then waiting:resume(resume_token) end
    when failed() then
      rejected = 3
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 3
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  suspend(resume_token)
  if rejected == 1 then
    raise AllThreeError<|A1, B1, A2, B2, A3, B3|>.first(rejection as TaskStatus<|A1, B1|>)
  end
  if rejected == 2 then
    raise AllThreeError<|A1, B1, A2, B2, A3, B3|>.second(rejection as TaskStatus<|A2, B2|>)
  end
  if rejected == 3 then
    raise AllThreeError<|A1, B1, A2, B2, A3, B3|>.third(rejection as TaskStatus<|A3, B3|>)
  end
  return first_result as A1, second_result as A2,
         third_result as A3
end

--- Wait for 4 successes or raise the first positional rejection; operands are not cancelled.
-- @param first First Task operand.
-- @param second Second Task operand.
-- @param third Third Task operand.
-- @param fourth Fourth Task operand.
-- @return 4 success payloads in operand order; raises AllFourError on failure or cancellation.
-- @usage async-io.md
function all_four<|A1, B1, A2, B2, A3, B3, A4, B4|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>,
    third: Task<|A3, B3|>, fourth: Task<|A4, B4|>):
    (A1, A2, A3, A4)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)
  reject_running(current, fourth)

  local completed = 0
  local first_result: value = nil
  if first.phase == TASK_FINISHED then
    local first_status = first:status()
    case first_status
    when succeeded(result) then
      first_result = result
      completed = completed + 1
    when failed() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.first(first_status)
    when cancelled() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.first(first_status)
    end
  end

  local second_result: value = nil
  if second.phase == TASK_FINISHED then
    local second_status = second:status()
    case second_status
    when succeeded(result) then
      second_result = result
      completed = completed + 1
    when failed() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.second(second_status)
    when cancelled() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.second(second_status)
    end
  end

  local third_result: value = nil
  if third.phase == TASK_FINISHED then
    local third_status = third:status()
    case third_status
    when succeeded(result) then
      third_result = result
      completed = completed + 1
    when failed() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.third(third_status)
    when cancelled() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.third(third_status)
    end
  end

  local fourth_result: value = nil
  if fourth.phase == TASK_FINISHED then
    local fourth_status = fourth:status()
    case fourth_status
    when succeeded(result) then
      fourth_result = result
      completed = completed + 1
    when failed() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.fourth(fourth_status)
    when cancelled() then raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.fourth(fourth_status)
    end
  end

  if completed == 4 then
    return first_result as A1, second_result as A2,
           third_result as A3, fourth_result as A4
  end

  local resume_token = ResumeToken("async.all_four")
  local waiting = current
  local rejected = 0
  local rejection: TaskStatus<|value, value|>? = nil

  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      first_result = result
      completed = completed + 1
      if completed == 4 then waiting:resume(resume_token) end
    when failed() then
      rejected = 1
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 1
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      second_result = result
      completed = completed + 1
      if completed == 4 then waiting:resume(resume_token) end
    when failed() then
      rejected = 2
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 2
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<|A3, B3|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      third_result = result
      completed = completed + 1
      if completed == 4 then waiting:resume(resume_token) end
    when failed() then
      rejected = 3
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 3
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  local fourth_listener = function (status: TaskStatus<|A4, B4|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      fourth_result = result
      completed = completed + 1
      if completed == 4 then waiting:resume(resume_token) end
    when failed() then
      rejected = 4
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 4
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_fourth_listener = fourth:add_terminal_listener(fourth_listener)
  defer remove_fourth_listener()

  suspend(resume_token)
  if rejected == 1 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.first(rejection as TaskStatus<|A1, B1|>)
  end
  if rejected == 2 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.second(rejection as TaskStatus<|A2, B2|>)
  end
  if rejected == 3 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.third(rejection as TaskStatus<|A3, B3|>)
  end
  if rejected == 4 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.fourth(rejection as TaskStatus<|A4, B4|>)
  end
  return first_result as A1, second_result as A2,
         third_result as A3, fourth_result as A4
end

