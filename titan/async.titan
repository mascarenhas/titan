function all_two(first: Task, second: Task): (value, value)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)

  local completed = 0
  local first_succeeded = false
  local first_result: value = nil
  local first_status = first:status()
  case first_status
  when succeeded: result then
    first_succeeded = true
    first_result = result
    completed = completed + 1
  when failed then raise AllTwoError.first(first_status)
  when cancelled then raise AllTwoError.first(first_status)
  else
  end

  local second_succeeded = false
  local second_result: value = nil
  local second_status = second:status()
  case second_status
  when succeeded: result then
    second_succeeded = true
    second_result = result
    completed = completed + 1
  when failed then raise AllTwoError.second(second_status)
  when cancelled then raise AllTwoError.second(second_status)
  else
  end

  if completed == 2 then return first_result, second_result end

  local waiting? = current
  defer waiting = nil
  local rejected = 0
  local rejection?: TaskStatus = nil

  local first_listener = function (status: TaskStatus)
    if waiting == nil or rejected ~= 0 then return end
    case status
    when succeeded: result then
      first_result = result
      completed = completed + 1
      if completed == 2 then waiting:resume() end
    when failed then
      rejected = 1
      rejection = status
      waiting:resume()
    when cancelled then
      rejected = 1
      rejection = status
      waiting:resume()
    else
    end
  end
  defer first:remove_terminal_listener(first_listener)
  if not first_succeeded then first:add_terminal_listener(first_listener) end

  local second_listener = function (status: TaskStatus)
    if waiting == nil or rejected ~= 0 then return end
    case status
    when succeeded: result then
      second_result = result
      completed = completed + 1
      if completed == 2 then waiting:resume() end
    when failed then
      rejected = 2
      rejection = status
      waiting:resume()
    when cancelled then
      rejected = 2
      rejection = status
      waiting:resume()
    else
    end
  end
  defer second:remove_terminal_listener(second_listener)
  if not second_succeeded then second:add_terminal_listener(second_listener) end

  suspend()
  if rejected == 1 then
    raise AllTwoError.first(rejection as TaskStatus)
  end
  if rejected == 2 then
    raise AllTwoError.second(rejection as TaskStatus)
  end
  return first_result, second_result
end

