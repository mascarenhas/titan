    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.first(rejection as TaskStatus<|A1, B1|>)
  end
  if rejected == 2 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.second(rejection as TaskStatus<|A2, B2|>)
  end
  if rejected == 3 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.third(rejection as TaskStatus<|A3, B3|>)
  end
  if rejected == 4 then
    raise AllFourError<|A1, B1, A2, B2, A3, B3, A4, B4|>.fourth(rejection as TaskStatus<|A4, B4|>)
  end
  return first_result as A1, second_result as A2,
         third_result as A3, fourth_result as A4
end

function all_five<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>,
    third: Task<|A3, B3|>, fourth: Task<|A4, B4|>,
    fifth: Task<|A5, B5|>):
    (A1, A2, A3, A4, A5)
  local current = running()
  reject_running(current, first)
  reject_running(current, second)
  reject_running(current, third)
  reject_running(current, fourth)
  reject_running(current, fifth)

  local completed = 0
  local first_result: value = nil
  local first_status = first:status()
  case first_status
  when succeeded(result) then
    first_result = result
    completed = completed + 1
  when failed() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.first(first_status)
  when cancelled() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.first(first_status)
  end

  local second_result: value = nil
  local second_status = second:status()
  case second_status
  when succeeded(result) then
    second_result = result
    completed = completed + 1
  when failed() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.second(second_status)
  when cancelled() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.second(second_status)
  end

  local third_result: value = nil
  local third_status = third:status()
  case third_status
  when succeeded(result) then
    third_result = result
    completed = completed + 1
  when failed() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.third(third_status)
  when cancelled() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.third(third_status)
  end

  local fourth_result: value = nil
  local fourth_status = fourth:status()
  case fourth_status
  when succeeded(result) then
    fourth_result = result
    completed = completed + 1
  when failed() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.fourth(fourth_status)
  when cancelled() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.fourth(fourth_status)
  end

  local fifth_result: value = nil
  local fifth_status = fifth:status()
  case fifth_status
  when succeeded(result) then
    fifth_result = result
    completed = completed + 1
  when failed() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.fifth(fifth_status)
  when cancelled() then raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.fifth(fifth_status)
  end

  if completed == 5 then
    return first_result as A1, second_result as A2,
           third_result as A3, fourth_result as A4,
           fifth_result as A5
  end

  local resume_token = ResumeToken("async.all_five")
  local waiting = current
  local rejected = 0
  local rejection = TaskStatus<|value, value|>.ready()

  local first_listener = function (status: TaskStatus<|A1, B1|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      first_result = result
      completed = completed + 1
      if completed == 5 then waiting:resume(resume_token) end
    when failed() then
      rejected = 1
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 1
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<|A2, B2|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      second_result = result
      completed = completed + 1
      if completed == 5 then waiting:resume(resume_token) end
    when failed() then
      rejected = 2
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 2
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<|A3, B3|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      third_result = result
      completed = completed + 1
      if completed == 5 then waiting:resume(resume_token) end
    when failed() then
      rejected = 3
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 3
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  local fourth_listener = function (status: TaskStatus<|A4, B4|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      fourth_result = result
      completed = completed + 1
      if completed == 5 then waiting:resume(resume_token) end
    when failed() then
      rejected = 4
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 4
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_fourth_listener = fourth:add_terminal_listener(fourth_listener)
  defer remove_fourth_listener()

  local fifth_listener = function (status: TaskStatus<|A5, B5|>)
    if rejected ~= 0 then return end
    case status
    when succeeded(result) then
      fifth_result = result
      completed = completed + 1
      if completed == 5 then waiting:resume(resume_token) end
    when failed() then
      rejected = 5
      rejection = status
      waiting:resume(resume_token)
    when cancelled() then
      rejected = 5
      rejection = status
      waiting:resume(resume_token)
    end
  end
  local remove_fifth_listener = fifth:add_terminal_listener(fifth_listener)
  defer remove_fifth_listener()

  suspend(resume_token)
  if rejected == 1 then
    raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.first(rejection as TaskStatus<|A1, B1|>)
  end
  if rejected == 2 then
    raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.second(rejection as TaskStatus<|A2, B2|>)
  end
  if rejected == 3 then
    raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.third(rejection as TaskStatus<|A3, B3|>)
  end
  if rejected == 4 then
    raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.fourth(rejection as TaskStatus<|A4, B4|>)
  end
  if rejected == 5 then
    raise AllFiveError<|A1, B1, A2, B2, A3, B3, A4, B4, A5, B5|>.fifth(rejection as TaskStatus<|A5, B5|>)
  end
  return first_result as A1, second_result as A2,
         third_result as A3, fourth_result as A4,
         fifth_result as A5
end

function join<|A, B|>(task: Task<|A, B|>): TaskStatus<|A, B|>
  local current = running()
  reject_running(current, task)
  local status = task:status()
  if status:has_finished() then return status end

  local resume_token = ResumeToken("async.join")
  local waiting = current
  local result = TaskStatus<|value, value|>.ready()
  local listener = function (terminal_status: TaskStatus<|A, B|>)
    result = terminal_status
    waiting:resume(resume_token)
  end
  local remove_listener = task:add_terminal_listener(listener)
  defer remove_listener()

  suspend(resume_token)
  return result as TaskStatus<|A, B|>
end

function join_two<|A1, B1, A2, B2|>(
    first: Task<|A1, B1|>, second: Task<|A2, B2|>):
    (TaskStatus<|A1, B1|>, TaskStatus<|A2, B2|>)
