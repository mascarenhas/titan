  end

  if terminal_count == 3 then return AnyThreeResult<A1, A2, A3>.none() end

  local waiting? = current
  defer waiting = nil
  local winner = 0
  local result: value = nil

  local first_listener = function (status: TaskStatus<A1, B1>)
    if waiting == nil or winner ~= 0 then return end
    case status
    when succeeded: payload then
      winner = 1
      result = payload
      waiting:resume()
    when failed then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume()
      end
    when cancelled then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume()
      end
    end
  end
  local remove_first_listener = first:add_terminal_listener(first_listener)
  defer remove_first_listener()

  local second_listener = function (status: TaskStatus<A2, B2>)
    if waiting == nil or winner ~= 0 then return end
    case status
    when succeeded: payload then
      winner = 2
      result = payload
      waiting:resume()
    when failed then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume()
      end
    when cancelled then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume()
      end
    end
  end
  local remove_second_listener = second:add_terminal_listener(second_listener)
  defer remove_second_listener()

  local third_listener = function (status: TaskStatus<A3, B3>)
    if waiting == nil or winner ~= 0 then return end
    case status
    when succeeded: payload then
      winner = 3
      result = payload
      waiting:resume()
    when failed then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume()
      end
    when cancelled then
      terminal_count = terminal_count + 1
      if terminal_count == 3 then
        winner = -1
        waiting:resume()
      end
    end
  end
  local remove_third_listener = third:add_terminal_listener(third_listener)
  defer remove_third_listener()

  suspend()
  if winner == 1 then return AnyThreeResult<A1, A2, A3>.first(result) end
  if winner == 2 then return AnyThreeResult<A1, A2, A3>.second(result) end
  if winner == 3 then return AnyThreeResult<A1, A2, A3>.third(result) end
  return AnyThreeResult<A1, A2, A3>.none()
end

function any_four<A1, B1, A2, B2, A3, B3, A4, B4>(
    first: Task<A1, B1>, second: Task<A2, B2>,
    third: Task<A3, B3>, fourth: Task<A4, B4>):
