local fs = import "fs"

local function replace_literal(subject: string, needle: string,
                               replacement: string): string
  local builder = string.writer()
  local position = 1
  while position <= #subject do
    local found: integer? = string.find(subject, needle, position)
    if not found then break end
    local first = found as integer
    if first > position then
      builder:write(string.sub(subject, position, first - 1))
    end
    builder:write(replacement)
    position = first + #needle
  end
  if position <= #subject then
    builder:write(string.sub(subject, position))
  end
  return builder:drain()
end

local function open_source_candidate(filename: string): fs.File?
  local opened: fs.File? = nil
  do
    opened = fs.open(filename, "r")
  catch
    -- Lua's source searcher treats every failure to open a candidate as a
    -- non-match. Cancellation and non-filesystem errors still propagate.
    if error is async.OperationError then return nil end
    raise
  end
  return opened
end

local function source_search(modname: string, path: string):
    (value, value, string)
  local module_path = replace_literal(modname, ".", "/")
  local messages = string.writer()
  local position = 1
  local finished = false

  while not finished do
    local separator: integer? = string.find(path, ";", position)
    local template = ""
    if separator then
      local separator_position = separator as integer
      template = string.sub(path, position, separator_position - 1)
      position = separator_position + 1
    else
      template = string.sub(path, position)
      finished = true
    end

    local filename = replace_literal(template, "?", module_path)
    local maybe_file: fs.File? = open_source_candidate(filename)
    if maybe_file then
      local file = maybe_file as fs.File
      defer file:close()
      local loaded = (function (file: fs.File, modname: string,
                                filename: string): LuaChunk
        return load_from_reader(file, "@" .. filename, nil)
      catch
        raise "error loading module '" .. modname ..
              "' from file '" .. filename .. "':\n\t" ..
              string.tostring(error)
      end)(file, modname, filename)
      return loaded, filename, ""
    end

    messages:write("\n\tno file '" .. filename .. "'")
  end

  return nil, nil, messages:drain()
end

--- Read and execute a Lua file, closing its File on every exit.
-- @param filename Path loaded within an async Task.
-- @param ... Arguments forwarded to the chunk.
-- @return Every result returned by the chunk, including nil slots.
-- @usage standard-library-lua.md
function dofile(filename: string, ...: value): (...: value)
  local file = fs.open(filename, "r")
  defer file:close()
  local chunk: LuaChunk =
    load_from_reader(file, "@" .. filename, nil)
  return chunk(...)
end
