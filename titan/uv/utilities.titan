-- Isolated candidate for the public titan.uv utility family.
-- Native libuv 1.52.1; no C-header types cross the public interface.
foreign import "uv.h"
foreign import "utility_bits.h"

union clock_id
  monotonic()
  realtime()
end

record timeval_t
  tv_sec: integer
  tv_usec: integer
end

record timeval64_t
  tv_sec: integer
  tv_usec: integer
end

record timespec64_t
  tv_sec: integer
  tv_nsec: integer
end

record rusage_t
  ru_utime: timeval_t
  ru_stime: timeval_t
  ru_maxrss: integer
  ru_ixrss: integer
  ru_idrss: integer
  ru_isrss: integer
  ru_minflt: integer
  ru_majflt: integer
  ru_nswap: integer
  ru_inblock: integer
  ru_oublock: integer
  ru_msgsnd: integer
  ru_msgrcv: integer
  ru_nsignals: integer
  ru_nvcsw: integer
  ru_nivcsw: integer
end

record utsname_t
  sysname: string
  release: string
  version: string
  machine: string
end

const CLOCK_MONOTONIC = clock_id.monotonic()
const CLOCK_REALTIME = clock_id.realtime()

local function utility_native_clock(clock: clock_id): foreign uv_clock_id
  case clock
  when monotonic() then return ffi.UV_CLOCK_MONOTONIC
  when realtime() then return ffi.UV_CLOCK_REALTIME
  end
end

-- Preserve all 64 native bits, including UINT64_MAX as -1.
local function utility_u64(value: foreign uint64_t): integer
  return value as foreign lua_Integer
end

local function utility_copy_rusage(native: foreign *uv_rusage_t): rusage_t
  return rusage_t {
    ru_utime = timeval_t(native.ru_utime.tv_sec, native.ru_utime.tv_usec),
    ru_stime = timeval_t(native.ru_stime.tv_sec, native.ru_stime.tv_usec),
    ru_maxrss = utility_u64(native.ru_maxrss),
    ru_ixrss = utility_u64(native.ru_ixrss),
    ru_idrss = utility_u64(native.ru_idrss),
    ru_isrss = utility_u64(native.ru_isrss),
    ru_minflt = utility_u64(native.ru_minflt),
    ru_majflt = utility_u64(native.ru_majflt),
    ru_nswap = utility_u64(native.ru_nswap),
    ru_inblock = utility_u64(native.ru_inblock),
    ru_oublock = utility_u64(native.ru_oublock),
    ru_msgsnd = utility_u64(native.ru_msgsnd),
    ru_msgrcv = utility_u64(native.ru_msgrcv),
    ru_nsignals = utility_u64(native.ru_nsignals),
    ru_nvcsw = utility_u64(native.ru_nvcsw),
    ru_nivcsw = utility_u64(native.ru_nivcsw),
  }
end

function version(): integer
  return ffi.uv_version()
end

function version_string(): string
  return ffi.uv_version_string() as string
end

function translate_sys_error(sys_errno: integer): integer
  return ffi.uv_translate_sys_error(sys_errno)
end

function strerror(err: integer): string
  return ffi.uv_strerror(err) as string
end

function err_name(err: integer): string
  return ffi.uv_err_name(err) as string
end

function strerror_r(err: integer, capacity: integer): string
  local buffer = foreign char.new_array(capacity)
  ffi.uv_strerror_r(err, buffer, capacity)
  if capacity == 0 then return "" end
  return (buffer as foreign *char) as string
end

function err_name_r(err: integer, capacity: integer): string
  local buffer = foreign char.new_array(capacity)
  ffi.uv_err_name_r(err, buffer, capacity)
  if capacity == 0 then return "" end
  return (buffer as foreign *char) as string
end

function available_parallelism(): integer
  return ffi.uv_available_parallelism()
end

function cpumask_size(): integer
  return ffi.uv_cpumask_size()
end

function get_available_memory(): integer
  return utility_u64(ffi.uv_get_available_memory())
end

function get_constrained_memory(): integer
  return utility_u64(ffi.uv_get_constrained_memory())
end

function get_free_memory(): integer
  return utility_u64(ffi.uv_get_free_memory())
end

function get_total_memory(): integer
  return utility_u64(ffi.uv_get_total_memory())
end

function hrtime(): integer
  return utility_u64(ffi.uv_hrtime())
end

function os_getpid(): integer
  return ffi.uv_os_getpid()
end

function os_getppid(): integer
  return ffi.uv_os_getppid()
end

function chdir(dir: string): integer
  return ffi.uv_chdir(dir)
end

function set_process_title(title: string): integer
  return ffi.uv_set_process_title(title)
end

function os_setenv(name: string, value: string): integer
  return ffi.uv_os_setenv(name, value)
end

function os_unsetenv(name: string): integer
  return ffi.uv_os_unsetenv(name)
end

function os_setpriority(pid: integer, priority: integer): integer
  return ffi.uv_os_setpriority(pid, priority)
end

function cwd(capacity: integer): (integer, string?, integer)
  local size: foreign size_t = capacity
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_cwd(buffer, size)
  if status ~= 0 then return status, nil, size end
  return status, (buffer as foreign *char) as string, size
end

function exepath(capacity: integer): (integer, string?, integer)
  local size: foreign size_t = capacity
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_exepath(buffer, size)
  if status ~= 0 then return status, nil, size end
  return status, (buffer as foreign *char) as string, size
end

function os_gethostname(capacity: integer): (integer, string?, integer)
  local size: foreign size_t = capacity
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_os_gethostname(buffer, size)
  if status ~= 0 then return status, nil, size end
  return status, (buffer as foreign *char) as string, size
end

function os_homedir(capacity: integer): (integer, string?, integer)
  local size: foreign size_t = capacity
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_os_homedir(buffer, size)
  if status ~= 0 then return status, nil, size end
  return status, (buffer as foreign *char) as string, size
end

function os_tmpdir(capacity: integer): (integer, string?, integer)
  local size: foreign size_t = capacity
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_os_tmpdir(buffer, size)
  if status ~= 0 then return status, nil, size end
  return status, (buffer as foreign *char) as string, size
end

function os_getenv(name: string, capacity: integer): (integer, string?, integer)
  local size: foreign size_t = capacity
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_os_getenv(name, buffer, size)
  if status ~= 0 then return status, nil, size end
  return status, (buffer as foreign *char) as string, size
end

function get_process_title(capacity: integer): (integer, string?)
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_get_process_title(buffer, capacity)
  if status ~= 0 then return status, nil end
  return status, (buffer as foreign *char) as string
end

function os_getpriority(pid: integer): (integer, integer?)
  local priority: foreign int = 0
  local status: integer = ffi.uv_os_getpriority(pid, priority)
  if status ~= 0 then return status, nil end
  return status, priority
end

function resident_set_memory(): (integer, integer?)
  local rss: foreign size_t = 0
  local status: integer = ffi.uv_resident_set_memory(rss)
  if status ~= 0 then return status, nil end
  return status, rss
end

function uptime(): (integer, float?)
  local seconds: foreign double = 0.0
  local status: integer = ffi.uv_uptime(seconds)
  if status ~= 0 then return status, nil end
  return status, seconds
end

function getrusage(): (integer, rusage_t?)
  local native = foreign uv_rusage_t.new()
  local status: integer = ffi.uv_getrusage(native)
  if status ~= 0 then return status, nil end
  return status, utility_copy_rusage(native)
end

function getrusage_thread(): (integer, rusage_t?)
  local native = foreign uv_rusage_t.new()
  local status: integer = ffi.uv_getrusage_thread(native)
  if status ~= 0 then return status, nil end
  return status, utility_copy_rusage(native)
end

function gettimeofday(): (integer, timeval64_t?)
  local native = foreign uv_timeval64_t.new()
  local status: integer = ffi.uv_gettimeofday(native)
  if status ~= 0 then return status, nil end
  return status, timeval64_t(native.tv_sec, native.tv_usec)
end

function clock_gettime(clock: clock_id): (integer, timespec64_t?)
  local native = foreign uv_timespec64_t.new()
  local status: integer = ffi.uv_clock_gettime(utility_native_clock(clock), native)
  if status ~= 0 then return status, nil end
  return status, timespec64_t(native.tv_sec, native.tv_nsec)
end

function loadavg(): (float, float, float)
  local average = foreign double.new_array(3)
  ffi.uv_loadavg(average)
  return average[0], average[1], average[2]
end

function os_uname(): (integer, utsname_t?)
  local native = foreign uv_utsname_t.new()
  local status: integer = ffi.uv_os_uname(native)
  if status ~= 0 then return status, nil end
  return status, utsname_t {
    sysname = (native.sysname as foreign *char) as string,
    release = (native.release as foreign *char) as string,
    version = (native.version as foreign *char) as string,
    machine = (native.machine as foreign *char) as string,
  }
end

function sleep(msec: integer)
  ffi.uv_sleep(msec)
end
