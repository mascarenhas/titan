local type Bytes = owned char[]

local record StreamWriteOwner
  local handle: owned *ffi.uv_write_t
  local callback: (StreamWriteOwner, integer) -> ()
end

local record Immediate
  local failed: boolean
  local payload: value
end

local record Runtime
  local loop: owned *ffi.uv_loop_t
  local task_roots: {Task}
  local next_task_root: integer
  local handle_roots: {value}
  local next_handle_root: integer
  local current_task: Task?
  local closing: boolean
  local cleanup_done: boolean
  local exit_code: integer?
end

local record HandleCloseCall
  local runtime: Runtime
  local handle: *ffi.uv_handle_t
  local keepalive: value
  local root_index: integer
end

-- The callback closure retains the native owner and optional suspended Task.
-- The record itself contains only the root slot and the callback in reviewed
-- zero-based Udata slot 1 used by uv_close_cb.
local record CloseOwner
  local root_index: integer
  local callback: (CloseOwner) -> ()
end

local record WalkOwner
  local handle: *void
  local callback: (WalkOwner, *void) -> ()
end

foreign function uv_write_cb(req: *ffi.uv_write_t,
                             status: int)
  local owner = ffi.uv_req_get_data(
      req as *ffi.uv_req_t) as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local handle = req.handle as *ffi.uv_handle_t
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as *ffi.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvIntegerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner, status as ffi.lua_Integer)
  ffi.lua_settop(L, top)
end

foreign function uv_alloc_cb(handle: *ffi.uv_handle_t,
                             suggested_size: ffi.size_t,
                             buf: *ffi.uv_buf_t)
  local owner = ffi.uv_handle_get_data(handle) as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as *ffi.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvSizePointerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner, suggested_size,
        buf as *void)
  ffi.lua_settop(L, top)
end

foreign function uv_read_cb(stream: *ffi.uv_stream_t,
                            nread: ffi.ssize_t,
                            buf: const *ffi.uv_buf_t)
  local handle = stream as *ffi.uv_handle_t
  local owner = ffi.uv_handle_get_data(handle) as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[2].uv)
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as *ffi.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvIntegerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner, nread as ffi.lua_Integer)
  ffi.lua_settop(L, top)
end

foreign function uv_close_cb(handle: *ffi.uv_handle_t)
  local owner = ffi.uv_handle_get_data(handle) as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as *ffi.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvNoargCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner)
  ffi.lua_settop(L, top)
end

foreign function uv_walk_cb(handle: *ffi.uv_handle_t,
                            arg: *void)
  local owner = arg as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as *ffi.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvPointerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner,
        handle as *void)
  ffi.lua_settop(L, top)
end

local function main_thread_state(): *ffi.lua_State
  local top = ffi.lua_gettop(L)
  ffi.lua_rawgeti(L, ffi.LUA_REGISTRYINDEX,
                  ffi.LUA_RIDX_MAINTHREAD as ffi.lua_Integer)
  local thread = ffi.lua_tothread(L, -1)
  ffi.lua_settop(L, top)
  if not thread then raise "Lua main thread is unavailable" end
  return thread
end

local function make_error(code: integer,
                          operation: string): OperationError
  local status = code as int
  return OperationError.new(code, ffi.uv_err_name(status) as string,
                            ffi.uv_strerror(status) as string, operation)
end

local function immediate_ok(payload: value): Immediate
  return Immediate.new(false, payload)
end

local function immediate_error(code: integer,
                               operation: string): Immediate
  return Immediate.new(true, make_error(code, operation))
end

local function check_status(status: integer, operation: string)
  if status < 0 then raise make_error(status, operation) end
end

local function contains_nul(source: string): boolean
  return ffi.strlen(source) ~= (#source as ffi.size_t)
end

local function checked_text(source: string, operation: string): string
  if contains_nul(source) then
    raise make_error(ffi.UV_EINVAL, operation)
  end
  return source
end

local function bytes_string(bytes: const *char,
                            length: integer): string
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  ffi.lua_pushlstring(L, bytes, length as ffi.size_t)
  local result: value = ffi.lua_totvalue(L, -1)
  return result as string
end

local function complete_status(task: Task, status: integer,
                               operation: string)
  if status < 0 then
    resume_task_from_callback(
        task, true, make_error(status, operation))
  else
    resume_task_from_callback(task, false, nil)
  end
catch
  fail_task_at_callback_boundary(task, error, traceback)
end

local function submitted(task: Task, status: integer,
                         operation: string): Immediate?
  if status >= 0 then return nil end
  task.pending = nil
  return immediate_error(status, operation)
end

local function submit_stream_write(task: Task,
                                    stream: *ffi.uv_stream_t,
                                    data: string,
                                    operation: string): Immediate?
  local descriptor = ffi.uv_buf_t.new()
  descriptor.base = data
  descriptor.len = #data as ffi.size_t
  local native: owned *ffi.uv_write_t = ffi.uv_write_t.new()
  local callback = function (_owner: StreamWriteOwner, status: integer)
    -- Libuv borrows the string bytes through write_cb, so retain the string.
    local _data = data
    complete_status(task, status, operation)
  end
  local owner = StreamWriteOwner.new(native, callback)
  task.pending = owner
  local request: *ffi.uv_write_t = native
  ffi.uv_req_set_data(request as *ffi.uv_req_t,
                        owner as *void)
  local status = ffi.uv_write {
    req = request,
    handle = stream,
    bufs = descriptor,
    nbufs = 1,
    cb = uv_write_cb,
  }
  return submitted(task, status, operation)
end

local function error_text(err: value): string
  local text = "<error while rendering Task failure>"
  do
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    if err is OperationError then
      local failure = err as OperationError
      text = failure.operation .. ": " .. failure.name ..
             " (" .. failure.code .. "): " .. failure.message
    else
      if ffi.lua_checkstack(L, 2) == 0 then
        raise "cannot reserve Lua stack for Task error rendering"
      end
      ffi.lua_pushtvalue(L, err)
      local rendered = ffi.luaL_tolstring(L, -1, nil)
      if rendered then
        text = rendered as string
      else
        text = "<unprintable error>"
      end
    end
  catch
    -- Keep the conservative fallback already installed above.
  end
  return text
end

local function report_task_error(err: value, trace: string)
  local text = "uncaught error in async Task: " .. error_text(err) .. "\n"
  if #trace > 0 then
    text = text .. "stack traceback:\n" .. trace .. "\n"
  end
  -- stderr is a macro on the supported C libraries and therefore is not a
  -- portable FFI object. Descriptor 2 is the POSIX stderr boundary already
  -- required by the libuv runtime.
  local bytes = text as const *char
  local offset = 0
  while offset < #text do
    local written = ffi.write(
        2 as int, bytes + offset,
        (#text - offset) as ffi.size_t)
    if written < 0 then
      if ffi.errno == ffi.EINTR then
        -- Retry the same suffix.
      else
        return
      end
    elseif written == 0 then
      return
    else
      offset = offset + (written as integer)
    end
  end
end

local function root_task(runtime: Runtime, task: Task): integer
  local index = runtime.next_task_root
  runtime.next_task_root = index + 1
  runtime.task_roots[index] = task
  return index
end

local function unroot_task(runtime: Runtime, index: integer)
  if index > 0 then runtime.task_roots[index] = nil end
end

local function has_user_tasks(runtime: Runtime): boolean
  local index = 1
  while index < runtime.next_task_root do
    local task? = runtime.task_roots[index]
    if task and not (task as Task).cleanup then return true end
    index = index + 1
  end
  return false
end

local function root_handle(runtime: Runtime, owner: value): integer
  local index = runtime.next_handle_root
  runtime.next_handle_root = index + 1
  runtime.handle_roots[index] = owner
  return index
end

local function unroot_handle(runtime: Runtime, index: integer)
  if index > 0 then runtime.handle_roots[index] = nil end
end

local function running_task(): Task
  local runtime? = active_runtime
  if not runtime then raise "async Runtime is not active" end
  local task? = (runtime as Runtime).current_task
  if not task then
    raise "asynchronous operation must be called from an async Task"
  end
  return task as Task
end

local function accepting_work(runtime: Runtime, operation: string)
  if runtime.closing then
    raise "cannot " .. operation .. " while async Runtime is shutting down"
  end
end

local function new_runtime(): Runtime
  local native: owned *ffi.uv_loop_t = ffi.uv_loop_t.new()
  -- Allocate every GC-owned Runtime field before uv_loop_init gives the native
  -- loop resources that require an explicit uv_loop_close.
  local runtime = Runtime.new {
    loop = native,
    task_roots = {},
    next_task_root = 1,
    handle_roots = {},
    next_handle_root = 1,
    current_task = nil,
    closing = false,
    cleanup_done = false,
    exit_code = nil,
  }
  check_status(ffi.uv_loop_init(native), "runtime.loop.init")
  ffi.uv_loop_set_data(native,
                         main_thread as *void)
  return runtime
end

local function ensure_runtime(): Runtime
  local runtime? = active_runtime
  if runtime then return runtime as Runtime end
  local created = new_runtime()
  active_runtime = created
  return created
end

local function begin_close(runtime: Runtime, handle: *ffi.uv_handle_t,
                           keepalive: value, old_root_index: integer,
                           completion: () -> ()): boolean
  if ffi.uv_is_closing(handle) ~= 0 then return false end
  local callback = function (owner: CloseOwner)
    -- Capturing the native owner keeps its FFI handle alive through close_cb.
    local _keepalive = keepalive
    unroot_handle(runtime, owner.root_index)
    completion()
  end
  local owner = CloseOwner.new(0, callback)
  owner.root_index = root_handle(runtime, owner)
  if old_root_index > 0 then unroot_handle(runtime, old_root_index) end
  ffi.uv_handle_set_data(handle, owner as *void)
  ffi.uv_close(handle, uv_close_cb)
  return true
end

local function close_handle(runtime: Runtime, handle: *ffi.uv_handle_t,
                            keepalive: value, old_root_index: integer,
                            task: Task?, payload: value): boolean
  local completion = function ()
    if task then
      do
        resume_task_from_callback(task, false, payload)
      catch
        fail_task_at_callback_boundary(task, error, traceback)
      end
    end
  end
  local submitted = begin_close(
      runtime, handle, keepalive, old_root_index, completion)
  if submitted and task then task.cancel_action = nil end
  return submitted
end

local function HandleCloseCall:dispatch(task: Task): Immediate?
  if close_handle(self.runtime, self.handle, self.keepalive,
                  self.root_index, task, nil) then
    return nil
  end
  return Immediate.new(false, nil)
end

local function wait_handle_close(runtime: Runtime,
                                 handle: *ffi.uv_handle_t,
                                 keepalive: value,
                                 root_index: integer)
  await(Call.handle_close(HandleCloseCall.new(
      runtime, handle, keepalive, root_index)))
end

local function walk_callback(owner: WalkOwner,
                             pointer: *void)
  local handle = pointer as *ffi.uv_handle_t
  -- Select at most one currently live handle. The cleanup Task submits its
  -- close immediately, then walks again only after close_cb; no raw pointer is
  -- retained across an unrelated event-loop turn.
  if ffi.uv_is_closing(handle) == 0 then
    if owner.handle == nil then owner.handle = pointer end
  end
end

local function collect_handle(runtime: Runtime): *void
  local owner = WalkOwner.new(nil, walk_callback)
  ffi.uv_walk(runtime.loop, uv_walk_cb,
                owner as *void)
  return owner.handle
end

local function loop_owns_handle(runtime: Runtime,
                                target: *ffi.uv_handle_t): boolean
  local callback = function (owner: WalkOwner,
                             pointer: *void)
    if pointer == target then owner.handle = pointer end
  end
  local owner = WalkOwner.new(nil, callback)
  ffi.uv_walk(runtime.loop, uv_walk_cb,
                owner as *void)
  return owner.handle ~= nil
end

local function loop()
  if L ~= main_thread then
    raise "async.loop must be driven from the Lua main thread"
  end
  local runtime? = active_runtime
  if not runtime then return end
  local runtime = runtime as Runtime
  if ffi.lua_checkstack(L, ffi.LUA_MINSTACK) == 0 then
    raise "cannot reserve stack for libuv callbacks"
  end

  ffi.uv_run(runtime.loop, ffi.UV_RUN_DEFAULT)

  if has_user_tasks(runtime) then
    raise "libuv loop became idle while async Tasks were waiting"
  end
  if not runtime.cleanup_done then
    raise "async Runtime cleanup did not finish"
  end
  check_status(ffi.uv_loop_close(runtime.loop),
               "runtime.loop.close")

  runtime.task_roots = {}
  runtime.handle_roots = {}
  active_runtime = nil
end

local function version(): string
  return ffi.uv_version_string() as string
end
