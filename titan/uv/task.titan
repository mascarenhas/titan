local type CancelAction = () -> ()

union CancellationReason<B>
  simple: string
  complex: B
end

union TaskStatus<A, B>
  ready
  running
  waiting
  succeeded: A
  failed: Error
  cancelled: CancellationReason<B>
end

function TaskStatus:as_string(): string
  case self
  when ready then return "ready"
  when running then return "running"
  when waiting then return "waiting"
  when succeeded then return "succeeded"
  when failed then return "failed"
  when cancelled then return "cancelled"
  end
end

function TaskStatus:has_finished(): boolean
  case self
  when succeeded then return true
  when failed then return true
  when cancelled then return true
  else return false
  end
end

function TaskStatus:has_succeeded(): (boolean, A?)
  case self
  when succeeded: result then return true, result
  else return false, nil
  end
end

function TaskStatus:has_failed(): (boolean, Error?)
  case self
  when failed: failure then return true, failure
  else return false, nil
  end
end

function TaskStatus:has_cancelled(): (boolean, CancellationReason<B>?)
  case self
  when cancelled: reason then return true, reason
  else return false, nil
  end
end

local record TurnCall
end

local record SuspendCall
  local cancel_action: CancelAction?
end

local record SleepCall
  local milliseconds: integer
end

local record TickerTickCall
  local ticker: uv_timer_t
end

local record TickerCloseCall
  local ticker: uv_timer_t
end

local record CleanupStepCall
end

-- Every operational payload variant is one Task suspension action with its
-- ordinary parameters in a record. It may submit a callback-bearing operation
-- or consume/install state on a persistent handle. The case below is only a
-- router; each record owns its operation-specific dispatch method.
local union Call
  turn: TurnCall
  suspend: SuspendCall
  sleep: SleepCall
  ticker_tick: TickerTickCall
  ticker_close: TickerCloseCall
  handle_close: HandleCloseCall

  fs_open: FsOpenCall
  fs_read: FsReadCall
  fs_write: FsWriteCall
  fs_flush: FsFlushCall
  fs_close: FsCloseCall
  fs_stat: FsStatCall
  fs_lstat: FsLstatCall
  fs_tmpname: FsTmpnameCall
  fs_mkdir: FsMkdirCall
  fs_unlink: FsUnlinkCall
  fs_rmdir: FsRmdirCall
  fs_rename: FsRenameCall
  fs_list: FsListCall

  getaddrinfo: GetaddrinfoCall
  tcp_connect: TcpConnectCall
  tcp_read: TcpReadCall
  tcp_write: TcpWriteCall
  tcp_shutdown: TcpShutdownCall
  tcp_close: TcpCloseCall
  tcp_accept: TcpAcceptCall

  signal_wait: SignalWaitCall
  stream_read: StreamReadCall
  stream_write: StreamWriteCall
  stream_close: StreamCloseCall
  process_wait: ProcessWaitCall
  process_spawn_failure: ProcessSpawnFailureCall

  cleanup_step: CleanupStepCall
end

-- Cancellation-sensitive calls are suspension points at which a pending
-- cancellation is injected instead of submitting new work. Cleanup calls
-- must still be submitted, and their ordinary completion must be delivered,
-- so one deferred cleanup can continue through several asynchronous closes.
local function Call:is_cancellation_affected(): boolean
  case self
  when ticker_close then return false
  when handle_close then return false
  when fs_close then return false
  when tcp_close then return false
  when stream_close then return false
  when process_spawn_failure then return false
  when cleanup_step then return false
  else return true
  end
end

-- The callback closure retains the Task and result through the timer's close
-- callback, which is the completion point for every one-shot timer.
local record TimerOwner
  local handle: owned *libuv.uv_timer_t
  local callback: (TimerOwner) -> ()
  local root_index: integer
end

foreign function uv_timer_cb(timer: *libuv.uv_timer_t)
  local handle = timer as *libuv.uv_handle_t
  local owner = libuv.uv_handle_get_data(handle) as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local loop = libuv.uv_handle_get_loop(handle)
  local L = libuv.uv_loop_get_data(loop) as *lua.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvNoargCallbackEntry
  local top = lua.lua_gettop(L)
  entry(L, module, callback, owner)
  lua.lua_settop(L, top)
end

-- A repeating timer retains only its latest tick and at most one waiter.
local record uv_timer_t
  local handle: owned *libuv.uv_timer_t
  local callback: (uv_timer_t) -> ()
  local runtime: Runtime
  local waiting: Task?
  local fired: boolean
  local root_index: integer
end

local record TerminalRegistration<A, B>
  local listener: (TaskStatus<A, B>) -> ()
  local live: boolean
end

record Task<A, B>
  local root: coroutine.Coro
  local runtime: Runtime
  local state: TaskStatus<A, B>
  local cancel_value: CancellationReason<B>?
  local cancel_action: CancelAction?
  local pending: value
  local root_index: integer
  local cleanup: boolean
  local terminal_registrations: {TerminalRegistration<A, B>}
  -- Only async.suspend installs this resumable state. A pending zero-timer
  -- wake is coalesced so cancellation and terminal listeners cannot queue the
  -- same continuation twice.
  local suspended: boolean
  local resume_pending: boolean
  -- Policy of the accepted Call whose callback currently owns this Task's
  -- continuation. The initial next-turn callback is cancellation-sensitive.
  local pending_cancellation_affected: boolean
end

local function terminal(state: TaskStatus): boolean
  return state:has_finished()
end

function Task:status(): TaskStatus<A, B>
  return self.state
end

function Task:add_terminal_listener(
    listener: (TaskStatus<A, B>) -> ()): () -> ()
  if self.state:has_finished() then
    return function () end
  end

  local registration = TerminalRegistration<A, B>.new(listener, true)
  self.terminal_registrations[#self.terminal_registrations + 1] = registration
  local task = self
  return function ()
    if not registration.live then return end
    registration.live = false

    local registrations = task.terminal_registrations
    local count = #registrations
    for index = 1, count do
      if registrations[index] == registration then
        for following = index, count - 1 do
          registrations[following] = registrations[following + 1]
        end
        registrations[count] = nil
        return
      end
    end
  end
end

function Task:cancel(reason: CancellationReason<B>?)
  if self.state:has_finished() or self.cleanup or
     self.cancel_value then return end
  local actual? = reason
  if actual == nil then
    actual = CancellationReason.simple("cancelled")
  end
  self.cancel_value = actual as CancellationReason<B>
  local action? = self.cancel_action
  if action and self.pending_cancellation_affected then
    (action as CancelAction)()
  end
end

local function await(call: Call): value
  running_task()
  return coroutine.yield(call, UV_TAG)
end

local function dispatch_call(task: Task, call: Call): Immediate?
  case call
  when turn: operation then return operation:dispatch(task)
  when suspend: operation then return operation:dispatch(task)
  when sleep: operation then return operation:dispatch(task)
  when ticker_tick: operation then return operation:dispatch(task)
  when ticker_close: operation then return operation:dispatch(task)
  when handle_close: operation then return operation:dispatch(task)

  when fs_open: operation then return operation:dispatch(task)
  when fs_read: operation then return operation:dispatch(task)
  when fs_write: operation then return operation:dispatch(task)
  when fs_flush: operation then return operation:dispatch(task)
  when fs_close: operation then return operation:dispatch(task)
  when fs_stat: operation then return operation:dispatch(task)
  when fs_lstat: operation then return operation:dispatch(task)
  when fs_tmpname: operation then return operation:dispatch(task)
  when fs_mkdir: operation then return operation:dispatch(task)
  when fs_unlink: operation then return operation:dispatch(task)
  when fs_rmdir: operation then return operation:dispatch(task)
  when fs_rename: operation then return operation:dispatch(task)
  when fs_list: operation then return operation:dispatch(task)

  when getaddrinfo: operation then return operation:dispatch(task)
  when tcp_connect: operation then return operation:dispatch(task)
  when tcp_read: operation then return operation:dispatch(task)
  when tcp_write: operation then return operation:dispatch(task)
  when tcp_shutdown: operation then return operation:dispatch(task)
  when tcp_close: operation then return operation:dispatch(task)
  when tcp_accept: operation then return operation:dispatch(task)

  when signal_wait: operation then return operation:dispatch(task)
  when stream_read: operation then return operation:dispatch(task)
  when stream_write: operation then return operation:dispatch(task)
  when stream_close: operation then return operation:dispatch(task)
  when process_wait: operation then return operation:dispatch(task)
  when process_spawn_failure: operation then return operation:dispatch(task)

  when cleanup_step: operation then return operation:dispatch(task)
  end
end

local function retire_task(task: Task, state: TaskStatus)
  task.state = state
  task.pending = nil
  task.cancel_action = nil
  unroot_task(task.runtime, task.root_index)
end

local function notify_terminal(task: Task, state: TaskStatus)
  task.state = state
  -- Detach the terminal snapshot before delivery and release every
  -- registration from live ownership. A remover called during delivery is
  -- therefore a no-op and cannot shift this stable traversal.
  local registrations = task.terminal_registrations
  task.terminal_registrations = {}
  for index = 1, #registrations do
    registrations[index].live = false
  end
  for index = 1, #registrations do
    do
      registrations[index].listener(state)
    catch
    end
  end
end

local function finish_cleanup_task(task: Task)
  task.runtime.cleanup_done = true
  retire_task(task, TaskStatus<value, value>.succeeded(nil))
end

local function fail_cleanup_task(task: Task, err: value, trace: string)
  retire_task(task, TaskStatus<value, value>.failed(Error.new(err, trace)))
  report_task_error(err, trace)
end

local function finish_user_task(task: Task, state: TaskStatus)
  local runtime = task.runtime
  notify_terminal(task, state)
  retire_task(task, state)

  if not has_user_tasks(runtime) and not runtime.closing then
    begin_shutdown(runtime)
  end
  case state
  when failed: failure then
    report_task_error(failure.error, failure.traceback)
  end
end

-- A cancellation request is authoritative over every terminal user path.
-- User code may catch or transform the injected reason, but the observable
-- Task retains the caller's original reason.
local function finish_user_failure(task: Task, err: value, trace: string)
  local cancellation? = task.cancel_value
  if cancellation then
    finish_user_task(task, TaskStatus<value, value>.cancelled(
        cancellation as CancellationReason<value>))
  else
    finish_user_task(task, TaskStatus<value, value>.failed(Error.new(err, trace)))
  end
end

-- The callback continuation trampoline. It may consume several immediate
-- synchronous failures, but an accepted libuv submission always returns from
-- here so the callback itself can return to the event loop.
local function resume_root(task: Task, failed: boolean,
                           payload: value): value
  task.runtime.current_task = task
  defer task.runtime.current_task = nil
  if failed then return task.root:error(payload, UV_TAG) end
  return task.root:resume(payload, UV_TAG)
end

local function advance_task(task: Task, failed: boolean, payload: value,
                            cancellation_affected: boolean)
  local next_failed = failed
  local next_payload = payload
  local next_cancellation_affected = cancellation_affected

  while true do
    local cancellation? = task.cancel_value
    if cancellation and not task.cleanup and
       next_cancellation_affected then
      next_failed = true
      next_payload = cancellation
    end

    task.state = TaskStatus<value, value>.running()
    local yielded: value = nil
    do
      yielded = resume_root(task, next_failed, next_payload)
    catch
      if task.cleanup then
        fail_cleanup_task(task, error, traceback)
      else
        finish_user_failure(task, error, traceback)
      end
      return
    end

    local status = task.root:status()
    if status == "dead" then
      if task.cleanup then
        finish_cleanup_task(task)
      else
        local requested? = task.cancel_value
        if requested then
          finish_user_task(task, TaskStatus<value, value>.cancelled(
              requested as CancellationReason<value>))
        else
          finish_user_task(task, TaskStatus<value, value>.succeeded(yielded))
        end
      end
      return
    end
    if status ~= "suspended" then
      finish_user_failure(task, "invalid async coroutine state", "")
      return
    end

    local call = yielded as Call
    local call_cancellation_affected =
      call:is_cancellation_affected()
    cancellation = task.cancel_value
    if cancellation and not task.cleanup and
       call_cancellation_affected then
      next_failed = true
      next_payload = cancellation
      -- This is the deliberate cancellation injection for the yielded Call,
      -- not a completion that should itself be replaced before resumption.
      next_cancellation_affected = false
    else
      task.state = TaskStatus<value, value>.waiting()
      next_cancellation_affected = call_cancellation_affected
      task.pending_cancellation_affected =
        call_cancellation_affected
      do
        local immediate? = dispatch_call(task, call)
        if not immediate then return end
        task.pending_cancellation_affected = true
        local completion = immediate as Immediate
        next_failed = completion.failed
        next_payload = completion.payload
      catch
        task.pending_cancellation_affected = true
        next_failed = true
        next_payload = error
      end
    end
  end
end

-- An error raised while a native callback is preparing or resuming its
-- continuation belongs to that Task. Retiring it here keeps an unrelated Task
-- running and lets the task-root set decide whether shutdown should begin.
local function fail_task_at_callback_boundary(task: Task, err: value,
                                               trace: string)
  if terminal(task.state) then
    report_task_error(err, trace)
  elseif task.cleanup then
    fail_cleanup_task(task, err, trace)
  else
    finish_user_failure(task, err, trace)
  end
end

local function resume_task_from_callback(task: Task, failed: boolean,
                                         payload: value)
  local cancellation_affected = task.pending_cancellation_affected
  task.pending_cancellation_affected = true
  task.pending = nil
  task.cancel_action = nil
  task.suspended = false
  task.resume_pending = false
  do
    advance_task(task, failed, payload, cancellation_affected)
  catch
    fail_task_at_callback_boundary(task, error, traceback)
  end
end

local function ticker_callback(ticker: uv_timer_t)
  local waiter? = ticker.waiting
  if waiter then
    ticker.waiting = nil
    do
      resume_task_from_callback(waiter as Task, false, true)
    catch
      fail_task_at_callback_boundary(waiter as Task, error, traceback)
    end
  else
    ticker.fired = true
  end
end

local function activate_timer(runtime: Runtime,
                              native: owned *libuv.uv_timer_t,
                              owner: value,
                              owner_pointer: ffi.titan_ffi_void_ptr,
                              milliseconds: integer,
                              repeat_time: integer): integer
  -- Root the native storage before init links the handle into the loop. If
  -- reserving the root fails, libuv has not seen the handle yet.
  local root_index = root_handle(runtime, owner)
  local status = libuv.uv_timer_init(runtime.loop, native)
  if status < 0 then
    unroot_handle(runtime, root_index)
    raise make_error(status, "timer.init")
  end
  local timer_handle: *libuv.uv_timer_t = native
  libuv.uv_handle_set_data(
      timer_handle as *libuv.uv_handle_t,
      owner_pointer)
  status = libuv.uv_timer_start(
      native, uv_timer_cb,
      milliseconds as libuv.uint64_t,
      repeat_time as libuv.uint64_t)
  if status < 0 then
    close_handle(runtime, timer_handle as *libuv.uv_handle_t,
                 owner, root_index, nil, nil)
    raise make_error(status, "timer.start")
  end
  return root_index
end

-- A one-shot timer callback submits uv_close but never resumes its Task. The
-- close callback releases the native owner and then delivers the stored
-- result, so no Task continues while its timer remains in libuv's close queue.
local function start_timer(task: Task, milliseconds: integer,
                           failed: boolean,
                           payload: value): TimerOwner
  local runtime = task.runtime
  local native: owned *libuv.uv_timer_t = libuv.uv_timer_t.new()
  local completion = function ()
    do
      resume_task_from_callback(task, failed, payload)
    catch
      fail_task_at_callback_boundary(task, error, traceback)
    end
  end
  local callback = function (owner: TimerOwner)
    local timer_handle: *libuv.uv_timer_t = owner.handle
    do
      task.cancel_action = nil
      begin_close(runtime, timer_handle as *libuv.uv_handle_t,
                  owner, owner.root_index, completion)
      owner.root_index = 0
    catch
      fail_task_at_callback_boundary(task, error, traceback)
    end
  end
  local owner = TimerOwner.new(native, callback, 0)
  owner.root_index = activate_timer(
      runtime, native, owner, owner as ffi.titan_ffi_void_ptr,
      milliseconds, 0)
  return owner
end

-- Resume is meaningful only for an explicit async.suspend. It is synchronous:
-- terminal listeners run in the main-thread scheduler, so they only install
-- the target Task's ordinary zero-timer continuation and return. Multiple
-- requests before that timer fires coalesce.
function Task:resume()
  if not self.suspended or self.resume_pending or
     self.state:has_finished() then return end
  self.resume_pending = true
  do
    start_timer(self, 0, false, nil)
  catch
    self.resume_pending = false
    raise
  end
end

local function start_ticker(task: Task,
                            milliseconds: integer): uv_timer_t
  local runtime = task.runtime
  local native: owned *libuv.uv_timer_t = libuv.uv_timer_t.new()
  local ticker = uv_timer_t.new(native, ticker_callback, runtime,
                                nil, false, 0)
  ticker.root_index = activate_timer(
      runtime, native, ticker, ticker as ffi.titan_ffi_void_ptr,
      milliseconds, milliseconds)
  return ticker
end

-- Detaching a waiter from a shared multi-shot handle must not resume it inside
-- the Task that requested cancellation or close. A private zero timer gives
-- that Task its own ordinary callback on the next event-loop turn.
local function wake_task_next_turn(task: Task, failed: boolean,
                                   payload: value)
  start_timer(task, 0, failed, payload)
  task.cancel_action = nil
end

local function TurnCall:dispatch(task: Task): Immediate?
  start_timer(task, 0, false, nil)
  return nil
end

local function SuspendCall:dispatch(task: Task): Immediate?
  task.suspended = true
  task.resume_pending = false
  local requested? = self.cancel_action
  task.cancel_action = function ()
    if requested then requested() end
    task:resume()
  end
  return nil
end

local function SleepCall:dispatch(task: Task): Immediate?
  if self.milliseconds < 0 then
    return immediate_error(libuv.UV_EINVAL, "timer.sleep")
  end
  -- Build the cancellation closure before libuv accepts the timer. Once
  -- uv_timer_start succeeds, dispatch performs only non-allocating installs.
  local timer: TimerOwner? = nil
  local cancel_action: CancelAction = function ()
    local owner = timer as TimerOwner
    local timer_handle: *libuv.uv_timer_t = owner.handle
    close_handle(task.runtime,
                 timer_handle as *libuv.uv_handle_t,
                 owner, owner.root_index,
                 task, nil)
  end
  timer = start_timer(task, self.milliseconds, false, nil)
  task.cancel_action = cancel_action
  return nil
end

local function ticker_open_for(ticker: uv_timer_t,
                               task: Task): boolean
  if ticker.runtime ~= task.runtime then return false end
  local timer_handle: *libuv.uv_timer_t = ticker.handle
  return libuv.uv_is_closing(
      timer_handle as *libuv.uv_handle_t) == 0
end

local function TickerTickCall:dispatch(task: Task): Immediate?
  local ticker = self.ticker
  if not ticker_open_for(ticker, task) then return immediate_ok(false) end
  if ticker.fired then
    ticker.fired = false
    return immediate_ok(true)
  end
  if ticker.waiting then
    return Immediate.new(true, "Ticker already has a waiting Task")
  end
  local cancel_action: CancelAction = function ()
    if ticker.waiting == task then
      wake_task_next_turn(task, false, nil)
      ticker.waiting = nil
    end
  end
  ticker.waiting = task
  task.cancel_action = cancel_action
  return nil
end

local function TickerCloseCall:dispatch(task: Task): Immediate?
  local ticker = self.ticker
  if not ticker_open_for(ticker, task) then return immediate_ok(nil) end
  local timer_handle: *libuv.uv_timer_t = ticker.handle
  local waiter? = ticker.waiting
  if waiter then
    wake_task_next_turn(waiter as Task, false, false)
    ticker.waiting = nil
  end
  close_handle(ticker.runtime,
               timer_handle as *libuv.uv_handle_t,
               ticker, ticker.root_index, task, nil)
  ticker.root_index = 0
  return nil
end

local function CleanupStepCall:dispatch(task: Task): Immediate?
  local pointer = collect_handle(task.runtime)
  if pointer == nil then return immediate_ok(false) end
  close_handle(task.runtime, pointer as *libuv.uv_handle_t,
               nil, 0, task, true)
  return nil
end

local function cleanup_runtime(runtime: Runtime)
  while await(Call.cleanup_step(CleanupStepCall.new())) as boolean do end
end

local function begin_shutdown(runtime: Runtime)
  runtime.closing = true
  local root = coroutine.create(function (_: value): ()
    cleanup_runtime(runtime)
  end, UV_TAG)
  local task = Task<value, value>.new(
      root, runtime, TaskStatus<value, value>.ready(),
                        nil, nil, nil, 0, true, {}, false, false, true)
  task.root_index = root_task(runtime, task)
  start_timer(task, 0, false, nil)
end

local function run_internal(func: () -> value): Task<value, value>
  local runtime = ensure_runtime()
  accepting_work(runtime, "start a Task")
  local root = coroutine.create(function (_: value): value
    return func()
  end, UV_TAG)
  local task = Task<value, value>.new(
      root, runtime, TaskStatus<value, value>.ready(),
                        nil, nil, nil, 0, false, {}, false, false, true)
  task.root_index = root_task(runtime, task)

  do
    start_timer(task, 0, false, nil)
  catch
    finish_user_failure(task, error, traceback)
    raise
  end
  return task
end

local function yield()
  await(Call.turn(TurnCall.new()))
end

local function suspend(cancel_action: CancelAction?)
  await(Call.suspend(SuspendCall.new(cancel_action)))
end

local function sleep(milliseconds: integer)
  await(Call.sleep(SleepCall.new(milliseconds)))
end

local function ticker(milliseconds: integer): uv_timer_t
  if milliseconds <= 0 then
    raise "ticker interval must be positive"
  end
  local task = running_task()
  accepting_work(task.runtime, "create a Ticker")
  return start_ticker(task, milliseconds)
end

local function ticker_tick(ticker: uv_timer_t): boolean
  return await(Call.ticker_tick(TickerTickCall.new(ticker))) as boolean
end

local function ticker_close(ticker: uv_timer_t)
  await(Call.ticker_close(TickerCloseCall.new(ticker)))
end

local function os_exit(code: integer)
  local task = running_task()
  local runtime = task.runtime
  if runtime.exit_code == nil then
    runtime.exit_code = code
  end
  local index = 1
  while index < runtime.next_task_root do
    local other? = runtime.task_roots[index]
    if other and not (other as Task).cleanup then
      (other as Task):cancel(
          CancellationReason.simple("program exit"))
    end
    index = index + 1
  end
  raise task.cancel_value as CancellationReason<value>
end
