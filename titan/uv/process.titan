foreign type ExitEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, lua_Integer): void

--- Concrete process handle owner; initialize before use and close explicitly.
-- @usage uv/types.md#process_t
record process_t
  local native: foreign uv_process_t
  local phase: integer
  local loop: loop_t?
  local exit_callback: (function (process_t, integer, integer): ())?
  local close_callback: (function (handle_t): ())?
  local handler: function (process_t, loop_t, integer, integer): ()
  local close_handler: function (process_t, loop_t): ()
  local userdata: value
end

--- Tagged stdio data values for native operations.
-- @field fd Fd variant.
-- @field stream Stream variant.
-- @usage uv/types.md#stdio_data_t
union stdio_data_t
  fd(file: integer)
  stream(handle: stream_t)
end

--- One child stdio entry with combinable flags and an optional stream or descriptor.
-- @field flags Flag-discriminated input; stream owner or descriptor; create/read/write/overlapped flags combine subject to native restrictions.
-- @field data Data in the copied native result.
-- @usage uv/types.md#stdio_container_t
record stdio_container_t
  flags: integer
  data: stdio_data_t
end

--- Owned process arguments, environment, stdio, and native spawn options.
-- @field exit_cb Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field file Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field args Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field env Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field cwd Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field flags Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field stdio Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field uid Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @field gid Submission input in ordinary Titan fields/Arrays; the binding constructs any required native terminated vectors. nil env/cwd selects inheritance. The exit callback remains retained through exit; selected stdio owners keep their own handle lifetimes.
-- @usage uv/types.md#process_options_t
record process_options_t
  exit_cb: (function (process_t, integer, integer): ())?
  file: string
  args: {string}
  env: {string}?
  cwd: string?
  flags: integer
  stdio: {stdio_container_t}
  uid: integer
  gid: integer
end

--- Create process options retaining the supplied executable text and argument Array.
-- @param file File supplied to the native operation.
-- @param args Args supplied to the native operation.
-- @return Native process_options_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#process_options_tnew
function process_options_t.new(file: string, args: {string}): process_options_t
  return {exit_cb = nil, file = file, args = args, env = nil, cwd = nil,
          flags = 0, stdio = {}, uid = 0, gid = 0}
end

local function process_deliver(owner: process_t, loop: loop_t,
                              exit_status: integer, term_signal: integer)
  local callback? = owner.exit_callback
  owner.exit_callback = nil
  if callback ~= nil then callback(owner, exit_status, term_signal) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function process_closed(owner: process_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  local callback? = owner.close_callback
  owner.exit_callback = nil
  owner.close_callback = nil
  if callback ~= nil then callback(handle_t.process(owner)) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function process_callback(native: *uv_process_t, exit_status: int64_t, term_signal: int)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "process_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign ExitEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, exit_status as foreign lua_Integer, term_signal as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

local foreign function process_close_callback(base: *uv_handle_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "process_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

--- Allocate a concrete handle owner without initializing its native lifetime.
-- @return Native process_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#process_tnew
function process_t.new(): process_t
  local native = foreign uv_process_t.new()
  return {native = native, phase = HANDLE_FRESH, loop = nil,
          exit_callback = nil, close_callback = nil,
          handler = process_deliver, close_handler = process_closed, userdata = nil}
end

--- Return a tagged view of the same concrete owner.
-- @return Native handle_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#process_tas_handle_t
function process_t:as_handle_t(): handle_t
  return handle_t.process(self)
end

local function process_strings(strings: {string}): owned (*char)[]
  local output = foreign (*char).new_array(#strings + 1)
  for index = 1, #strings do output[index - 1] = strings[index] as foreign *char end
  return output
end

-- The final handoff cannot execute Titan loop-backedge GC checks. These
-- owners are already rooted, and every selected entry was validated above.
local foreign function consume_spawn_pipes(options: *uv_process_options_t)
  for index = 0, options.stdio_count - 1 do
    local entry = options.stdio[index]
    if (entry.flags & ffi.UV_CREATE_PIPE) ~= 0 then
      local owner = ffi.uv_handle_get_data(entry.data.stream as foreign *uv_handle_t) as foreign *Udata
      local eligibility = ffi.titan_record_field(owner, "pipe_t", "eligibility")
      eligibility.available = 0
    end
  end
end

--- Start a child process from process_options_t.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param process Mutable final process_t owner in fresh or retired state, before this native initialization; successful initialization establishes a close obligation.
-- @param options Input configuration record; file/args/env/cwd and stdio arrays are prepared before spawn, exit callback retained to exit, native stdio handles/descriptors follow their own lifetimes.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/process.md#spawn
function spawn(loop: loop_t, process: process_t, options: process_options_t): integer
  if not loop.initialized or process.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  local allowed = (ffi.UV_PROCESS_DETACHED as integer) | (ffi.UV_PROCESS_SETUID as integer) |
    (ffi.UV_PROCESS_SETGID as integer) | (ffi.UV_PROCESS_WINDOWS_FILE_PATH_EXACT_NAME as integer) |
    (ffi.UV_PROCESS_WINDOWS_HIDE as integer) | (ffi.UV_PROCESS_WINDOWS_HIDE_CONSOLE as integer) |
    (ffi.UV_PROCESS_WINDOWS_HIDE_GUI as integer) | (ffi.UV_PROCESS_WINDOWS_VERBATIM_ARGUMENTS as integer)
  if (options.flags & ~allowed) ~= 0 then return ffi.UV_EINVAL end
  local native = foreign uv_process_options_t.new()
  native.flags = options.flags as foreign unsigned int
  native.uid = options.uid as foreign uv_uid_t
  native.gid = options.gid as foreign uv_gid_t
  native.file = options.file
  local args = process_strings(options.args)
  native.args = args
  local env: (owned (*char)[])? = nil
  if options.env ~= nil then
    env = process_strings(options.env as {string})
    native.env = env as owned (*char)[]
  end
  if options.cwd ~= nil then native.cwd = options.cwd as string end
  local stdio = foreign uv_stdio_container_t.new_array(#options.stdio)
  native.stdio_count = #options.stdio as foreign int
  native.stdio = stdio
  native.exit_cb = process_callback
  local stdio_allowed = (ffi.UV_CREATE_PIPE as integer) | (ffi.UV_INHERIT_FD as integer) |
    (ffi.UV_INHERIT_STREAM as integer) | (ffi.UV_READABLE_PIPE as integer) |
    (ffi.UV_WRITABLE_PIPE as integer) | (ffi.UV_NONBLOCK_PIPE as integer)
  local created_pipes: {value: boolean} = {}
  for index = 1, #options.stdio do
    local item = options.stdio[index]
    if (item.flags & ~stdio_allowed) ~= 0 then return ffi.UV_EINVAL end
    local kind = item.flags & ((ffi.UV_CREATE_PIPE as integer) |
      (ffi.UV_INHERIT_FD as integer) | (ffi.UV_INHERIT_STREAM as integer))
    stdio[index - 1].flags = item.flags as foreign uv_stdio_flags
    if kind == ffi.UV_IGNORE as integer then
      stdio[index - 1].data.fd = -1
    elseif kind == ffi.UV_INHERIT_FD as integer then
      case item.data
      when fd(file) then stdio[index - 1].data.fd = file as foreign int
      when stream() then return ffi.UV_EINVAL
      end
    elseif kind == ffi.UV_CREATE_PIPE as integer or kind == ffi.UV_INHERIT_STREAM as integer then
      case item.data
      when fd() then return ffi.UV_EINVAL
      when stream(handle) then
        local pointer = handle:pointer()
        if pointer == nil or ffi.uv_is_closing(pointer as foreign *uv_handle_t) ~= 0 then
          return ffi.UV_EINVAL
        end
        if kind == ffi.UV_CREATE_PIPE as integer then
          if ffi.uv_handle_get_type(pointer as foreign *uv_handle_t) ~= ffi.UV_NAMED_PIPE or
              ffi.uv_handle_get_loop(pointer as foreign *uv_handle_t) ~= loop.native then
            return ffi.UV_EINVAL
          end
        end
        if kind == ffi.UV_CREATE_PIPE as integer then
          case handle
          when pipe(owner) then
            if owner.eligibility.available == 0 or created_pipes[owner] then return ffi.UV_EINVAL end
            created_pipes[owner] = true
          else return ffi.UV_EINVAL
          end
        end
        stdio[index - 1].data.stream = pointer
      end
    else return ffi.UV_EINVAL end
  end
  -- All conversions and allocation precede native ownership. Failed spawn may
  -- still initialize the handle, and even start a child: retain until close.
  process.native.pid = 0
  loop.handles[process] = true
  process.loop = loop
  process.exit_callback = options.exit_cb
  ffi.uv_handle_set_data(process.native as foreign *uv_handle_t, process as foreign *void)
  -- Validation, snapshots and fallible setup are complete. Native attempts can
  -- consume a pipe even on failure; never restore eligibility from status.
  consume_spawn_pipes(native)
  local status = ffi.uv_spawn(loop.native, process.native, native) as integer
  process.phase = HANDLE_LIVE
  return status
end

--- Read the PID associated with the process handle.
-- @param process Mutable initialized process_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/process.md#process_get_pid
function process_get_pid(process: process_t): integer
  if process.phase ~= HANDLE_LIVE then raise "process handle is not initialized" end
  return ffi.uv_process_get_pid(process.native) as integer
end

--- Send signum to the process represented by the handle.
-- @param process Mutable initialized process_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param signum Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/process.md#process_kill
function process_kill(process: process_t, signum: integer): integer
  local signal = signum as foreign int
  if process.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(process.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  if ffi.uv_process_get_pid(process.native) <= 0 then return ffi.UV_EINVAL end
  return ffi.uv_process_kill(process.native, signal)
end

--- Send signum to a native PID using platform process-signal semantics; no process handle is acquired.
-- @param pid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param signum Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/process.md#kill
function kill(pid: integer, signum: integer): integer
  return ffi.uv_kill(pid as foreign int, signum as foreign int)
end

--- Ask libuv to disable inherited stdio/handle inheritance where supported.
-- @usage uv/functions/process.md#disable_stdio_inheritance
function disable_stdio_inheritance()
  ffi.uv_disable_stdio_inheritance()
end
