foreign import "process_platform.h"
foreign import "process_environment.h"

foreign type CharPointer = *char
foreign type EnvironmentPointer = *uv_env_item_t
foreign type ParentStdioProbe = titan_parent_stdio_probe

-- Stream reads are the one multi-shot operation in this contributor. A
-- stream therefore buffers callback chunks and has at most one suspended
-- reader. Every write independently owns one uv_write_t; libuv supplies the
-- native stream ordering.
local union StdioNative
  pipe(foreign uv_pipe_t)
  tty(foreign uv_tty_t)
end

local record uv_stdio_t
  local native: StdioNative
  local alloc_callback: function (uv_stdio_t, foreign size_t, foreign *void): ()
  local read_callback: function (uv_stdio_t, integer): ()
  local buffer: Bytes?
  local runtime: Runtime
  local waiter: Task?
  local chunks: {string}
  local chunk_head: integer
  local read_error: value
  local root_index: integer
end

local record ProcessExitResult
  local code: integer
  local signal_number: integer
end

local record uv_process_t
  local handle: foreign uv_process_t
  local exit_callback: function (uv_process_t, integer, integer): ()
  local runtime: Runtime
  local waiter: Task?
  local result: ProcessExitResult
  local root_index: integer
end

foreign function uv_process_exit_cb(process: *uv_process_t,
                                    exit_status: int64_t,
                                    term_signal: int)
  local handle = process as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(handle) as foreign *Udata
  local callback = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "uv_process_t", "exit_callback"))
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as foreign *lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as foreign UvTwoIntegerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner,
        exit_status as foreign lua_Integer,
        term_signal as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

local union SpawnSlot
  inherit(uv_stdio_t)
  capture(uv_stdio_t)
  merged(child: uv_stdio_t, parent: uv_stdio_t)
end

local record SpawnEnvironmentEntry
  local name: string
  local contents: string
end

local record uv_spawn_config
  local runtime: Runtime
  local options: foreign uv_process_options_t
  local const stdio: foreign uv_stdio_container_t[]
  local slots: {SpawnSlot}
  local environment: {SpawnEnvironmentEntry}
  local consumed: boolean
end

-- Yield payloads.  Each dispatch method is the small main-thread adapter for
-- one callback-taking libuv operation.
local record StreamReadCall
  local stream: uv_stdio_t
end

local record StreamWriteCall
  local stream: uv_stdio_t
  local data: string
end

local record StreamCloseCall
  local stream: uv_stdio_t
end

local record ProcessWaitCall
  local process: uv_process_t
end

local record ProcessSpawnFailureCall
  local process: uv_process_t
end

-- os.stdin/out/err are stable facade records, but every Runtime owns fresh
-- duplicated native handles. The facade compares the wrapper records
-- themselves when rebinding to a newly initialized Runtime.
local parent_runtime: Runtime? = nil
local cached_parent_stdio: {uv_stdio_t} = {}

local function stream_native(stdio: uv_stdio_t): foreign *uv_stream_t
  case stdio.native
  when pipe(native) then
    return (native as foreign *uv_pipe_t) as foreign *uv_stream_t
  when tty(native) then
    return (native as foreign *uv_tty_t) as foreign *uv_stream_t
  end
end

local function stream_handle(stdio: uv_stdio_t): foreign *uv_handle_t
  return stream_native(stdio) as foreign *uv_handle_t
end

local function slot_child(slot: SpawnSlot): uv_stdio_t
  case slot
  when inherit(stream) then return stream
  when capture(stream) then return stream
  when merged{child} then return child
  end
end

local function slot_parent(slot: SpawnSlot): uv_stdio_t?
  case slot
  when inherit() then return nil
  when capture(stream) then return stream
  when merged{parent} then return parent
  end
end

local function slot_merged_child(slot: SpawnSlot): uv_stdio_t?
  case slot
  when merged{child} then return child
  else return nil
  end
end

local function new_stdio(native: StdioNative,
                         runtime: Runtime): uv_stdio_t
  return uv_stdio_t.new {
    native = native,
    alloc_callback = stream_alloc,
    read_callback = stream_read_callback,
    buffer = nil,
    runtime = runtime,
    waiter = nil,
    chunks = {},
    chunk_head = 1,
    read_error = nil,
    root_index = 0,
  }
end

local function validate_stdio(stdio: uv_stdio_t)
  if stdio.runtime ~= running_task().runtime then
    raise "stdio stream belongs to a different async Runtime"
  end
end

local function next_chunk(stdio: uv_stdio_t): string?
  if stdio.chunk_head > #stdio.chunks then return nil end
  local chunk = stdio.chunks[stdio.chunk_head]
  stdio.chunks[stdio.chunk_head] = ""
  stdio.chunk_head = stdio.chunk_head + 1
  if stdio.chunk_head > #stdio.chunks then
    stdio.chunks = {}
    stdio.chunk_head = 1
  end
  return chunk
end

local function stop_stream_read(stdio: uv_stdio_t)
  ffi.uv_read_stop(stream_native(stdio))
end

local function close_stream_from_callback(stdio: uv_stdio_t)
  local handle = stream_handle(stdio)
  close_handle(stdio.runtime, handle, stdio,
               stdio.root_index, nil, nil)
  stdio.root_index = 0
end

local function stream_alloc(stdio: uv_stdio_t, size: foreign size_t,
                            pointer: foreign *void)
  local descriptor = pointer as foreign *uv_buf_t
  do
    local length: integer = size
    descriptor.len = length
    local bytes = foreign char.new_array(length)
    stdio.buffer = bytes
    descriptor.base = bytes
  catch
    -- A direct native callback cannot unwind through libuv. Return the zero
    -- buffer that makes libuv invoke the paired read_cb, preserving the exact
    -- allocation error for that Task boundary rather than inventing a status
    -- or a recovery path.
    stdio.buffer = nil
    stdio.read_error = error
    descriptor.base = nil
    descriptor.len = 0
  end
end

local function take_stream_waiter(stdio: uv_stdio_t): Task?
  local waiter: Task? = stdio.waiter
  stdio.waiter = nil
  return waiter
end

local function fail_stream_callback(stdio: uv_stdio_t,
                                    failure: value,
                                    failure_traceback: string)
  local waiter? = take_stream_waiter(stdio)
  defer if waiter then
    resume_task_from_callback(waiter as Task, true, failure)
  else
    report_task_error(failure, failure_traceback)
  end
  stdio.buffer = nil
  stdio.read_error = failure
  stop_stream_read(stdio)
  close_stream_from_callback(stdio)
catch
  report_task_error(error, traceback)
end

local function deliver_stream_read(stdio: uv_stdio_t, result: integer)
  local buffer? = stdio.buffer
  stdio.buffer = nil

  if not buffer and stdio.read_error ~= nil then
    fail_stream_callback(stdio, stdio.read_error, "")
    return
  end

  if result == 0 then return end
  if result > 0 then
    local bytes = buffer as Bytes
    local payload = bytes_string(bytes, result)
    local waiter? = take_stream_waiter(stdio)
    if waiter then
      resume_task_from_callback(waiter as Task, false, payload)
    else
      stdio.chunks[#stdio.chunks + 1] = payload
    end
    return
  end

  stop_stream_read(stdio)
  local failed = false
  local payload: value = nil
  if result ~= ffi.UV_EOF then
    failed = true
    payload = make_error(result, "stdio.read")
    stdio.read_error = payload
  end
  close_stream_from_callback(stdio)
  local waiter? = take_stream_waiter(stdio)
  if waiter then
    resume_task_from_callback(waiter as Task, failed, payload)
  end
end

local function stream_read_callback(stdio: uv_stdio_t, result: integer)
  deliver_stream_read(stdio, result)
catch
  fail_stream_callback(stdio, error, traceback)
end

local function start_stream_read(stdio: uv_stdio_t): integer
  local status = ffi.uv_read_start(
      stream_native(stdio), uv_stdio_alloc_cb,
      uv_stdio_read_cb)
  if status == ffi.UV_EALREADY then return 0 end
  return status
end

local function StreamReadCall:dispatch(task: Task): Immediate?
  local state = self.stream
  local chunk? = next_chunk(state)
  if chunk then return immediate_ok(chunk) end
  if state.read_error ~= nil then
    return Immediate.new(true, state.read_error)
  end
  if ffi.uv_is_closing(stream_handle(state)) ~= 0 then
    return immediate_ok(nil)
  end
  if state.waiter then
    return Immediate.new(true, "stream already has a waiting reader")
  end
  local cancel_action: CancelAction = function ()
    if state.waiter == task then
      wake_task_next_turn(task, false, nil)
      state.waiter = nil
    end
  end
  local status = start_stream_read(state)
  if status < 0 then
    return immediate_error(status, "stdio.read.start")
  end
  state.waiter = task
  task.cancel_action = cancel_action
  return nil
end

local function StreamWriteCall:dispatch(task: Task): Immediate?
  local state = self.stream
  if ffi.uv_is_closing(stream_handle(state)) ~= 0 then
    return Immediate.new(true, "cannot write to a closed stream")
  end
  if #self.data == 0 then return immediate_ok(nil) end
  return submit_stream_write(
      task, stream_native(state), self.data, "stdio.write")
end

local function StreamCloseCall:dispatch(task: Task): Immediate?
  local state = self.stream
  local handle = stream_handle(state)
  if ffi.uv_is_closing(handle) ~= 0 then
    return immediate_ok(nil)
  end
  local reader? = state.waiter
  if reader then
    wake_task_next_turn(reader as Task, false, nil)
    state.waiter = nil
  end
  state.read_error = nil
  state.chunks = {}
  state.chunk_head = 1

  close_handle(state.runtime, handle, state,
               state.root_index, task, nil)
  state.root_index = 0
  return nil
end

local function process_exit_callback(owner: uv_process_t,
                                     exit_status: integer,
                                     term_signal: integer)
  local waiter: Task? = owner.waiter
  do
    owner.waiter = nil
    owner.result.code = exit_status
    owner.result.signal_number = term_signal
    local native: foreign *uv_process_t = owner.handle
    close_handle(owner.runtime, native as foreign *uv_handle_t,
                 owner, owner.root_index, nil, nil)
    owner.root_index = 0
    if waiter then
      resume_task_from_callback(waiter as Task, false, owner.result)
    end
  catch
    if waiter then
      resume_task_from_callback(waiter as Task, true, error)
    else
      report_task_error(error, traceback)
    end
  end
end

local function ProcessWaitCall:dispatch(task: Task): Immediate?
  local state = self.process
  local native: foreign *uv_process_t = state.handle
  if ffi.uv_is_active(native as foreign *uv_handle_t) == 0 then
    return immediate_ok(state.result)
  end
  if state.waiter then
    return Immediate.new(true, "Process already has a waiting Task")
  end
  local cancel_action: CancelAction = function ()
    if state.waiter == task then
      wake_task_next_turn(task, false, nil)
      state.waiter = nil
    end
  end
  state.waiter = task
  task.cancel_action = cancel_action
  return nil
end

-- A failed uv_spawn may or may not leave an initialized handle in the loop,
-- depending on the platform and failure point. Walk only while the Task is
-- suspended, then either await the required close or release the
-- never-published owner immediately.
local function ProcessSpawnFailureCall:dispatch(task: Task): Immediate?
  local process = self.process
  local runtime = process.runtime
  local native: foreign *uv_process_t = process.handle
  local handle = native as foreign *uv_handle_t
  if loop_owns_handle(runtime, handle) then
    close_handle(runtime, handle, process,
                 process.root_index, task, nil)
    process.root_index = 0
    return nil
  end
  unroot_handle(runtime, process.root_index)
  process.root_index = 0
  return immediate_ok(nil)
end

local function new_pipe_stdio(runtime: Runtime): (integer, uv_stdio_t?)
  local stdio = new_stdio(StdioNative.pipe(foreign uv_pipe_t.new()), runtime)
  local native = stream_native(stdio) as foreign *uv_pipe_t
  stdio.root_index = root_handle(runtime, stdio)
  local status = ffi.uv_pipe_init(runtime.loop, native, 0)
  if status < 0 then
    unroot_handle(runtime, stdio.root_index)
    stdio.root_index = 0
    return status, nil
  end
  local native_pointer: foreign *uv_pipe_t = native
  ffi.uv_handle_set_data(native_pointer as foreign *uv_handle_t,
                           stdio as foreign *void)
  return 0, stdio
end

-- Spawn options own initialized streams before a Process is published. They
-- have no waiter, so replacing or abandoning an option can start uv_close
-- directly without suspending the configurator.
local function discard_unpublished_stdio(stdio: uv_stdio_t?)
  if not stdio then return end
  local stream = stdio as uv_stdio_t
  local handle = stream_handle(stream)
  if ffi.uv_is_closing(handle) ~= 0 then return end
  stream.chunks = {}
  stream.chunk_head = 1
  close_handle(stream.runtime, handle, stream,
               stream.root_index, nil, nil)
  stream.root_index = 0
end

local function start_captured_read(stdio: uv_stdio_t,
                                   operation: string)
  local status = start_stream_read(stdio)
  if status >= 0 then return end
  stdio.read_error = make_error(status, operation)
  discard_unpublished_stdio(stdio)
end

local function duplicate_descriptor(
    descriptor: foreign uv_file): foreign uv_file
  local duplicate = foreign uv_file.new_array(1)
  local cloexec_failed = foreign int.new_array(1)
  local status = ffi.titan_duplicate_parent_descriptor(
      descriptor, duplicate, cloexec_failed)
  if status < 0 then
    ffi.titan_close_parent_duplicate(duplicate[0])
    local operation = "stdio.parent.duplicate"
    if cloexec_failed[0] ~= 0 then
      operation = "stdio.parent.duplicate.cloexec"
    end
    raise make_error(status, operation)
  end
  return duplicate[0]
end

local function parent_stdio_kind_error(code: integer, descriptor: integer,
                                       probe: string): OperationError
  local failure = make_error(code, "stdio.parent.kind")
  failure.message = "fd " .. descriptor .. ": " .. probe .. ": " ..
                    failure.message
  return failure
end

local function parent_stdio_pipe_hint(descriptor: integer): boolean
  local configured? = os_getenv("TITAN_STDIO_PIPE_FDS")
  if not configured then return false end
  local hint = configured as string
  if #hint == 0 or #hint % 2 == 0 then return false end
  local bytes = hint as foreign const *char
  local selected = false
  for index = 0, #hint - 1 do
    local byte = bytes[index] as integer
    if index % 2 == 0 then
      -- Only single ASCII fd digits 0, 1, and 2 are valid tokens. Validate
      -- the whole list before trusting any selected descriptor.
      if byte < 48 or byte > 50 then return false end
      if byte == descriptor + 48 then selected = true end
    elseif byte ~= 44 then
      return false
    end
  end
  return selected
end

local function parent_stdio_kind(descriptor: integer): foreign uv_handle_type
  local fd = descriptor as foreign uv_file
  local guessed = ffi.uv_guess_handle(fd)
  if guessed == ffi.UV_TTY or guessed == ffi.UV_NAMED_PIPE then
    return guessed
  end
  if guessed ~= ffi.UV_UNKNOWN_HANDLE then
    raise parent_stdio_kind_error(ffi.UV_ENOTSUP, descriptor,
      "uv_guess_handle classified unsupported kind " .. (guessed as integer))
  end

  -- uv_guess_handle does not promise errno; its isatty probe can leave an
  -- unrelated value behind. Inspect this UNKNOWN fd explicitly.
  local probe = foreign ParentStdioProbe.new()
  ffi.titan_probe_parent_stdio(fd, probe)
  if probe.status < 0 then
    raise parent_stdio_kind_error(probe.status, descriptor,
                                   probe.operation as string)
  end
  if probe.is_socket == 0 then
    raise parent_stdio_kind_error(ffi.UV_ENOTSUP, descriptor,
                                   "fstat did not identify a socket")
  end
  local name_errno = probe.name_errno as integer
  local type_errno = probe.type_errno as integer

  -- Both probes run even when the first fails: any available contradiction
  -- defeats launcher knowledge about the missing metadata.
  if name_errno == 0 and probe.is_unix == 0 then
    raise parent_stdio_kind_error(ffi.UV_ENOTSUP, descriptor,
      "getsockname reported family " .. (probe.family as integer))
  end
  if type_errno == 0 and probe.is_stream == 0 then
    raise parent_stdio_kind_error(ffi.UV_ENOTSUP, descriptor,
      "getsockopt(SO_TYPE) did not identify SOCK_STREAM")
  end
  if name_errno ~= 0 and name_errno ~= ffi.EPERM and
     name_errno ~= ffi.EACCES then
    raise parent_stdio_kind_error(ffi.uv_translate_sys_error(name_errno),
                                   descriptor, "getsockname")
  end
  if type_errno ~= 0 and type_errno ~= ffi.EPERM and
     type_errno ~= ffi.EACCES then
    raise parent_stdio_kind_error(ffi.uv_translate_sys_error(type_errno),
                                   descriptor, "getsockopt(SO_TYPE)")
  end
  if name_errno == 0 and type_errno == 0 then
    raise parent_stdio_kind_error(ffi.UV_ENOTSUP, descriptor,
      "uv_guess_handle remained unknown with inspectable socket metadata")
  end
  if parent_stdio_pipe_hint(descriptor) then return ffi.UV_NAMED_PIPE end

  local missing_probe = "getsockname"
  local denied_errno = name_errno
  if denied_errno == 0 then
    missing_probe = "getsockopt(SO_TYPE)"
    denied_errno = type_errno
  end
  raise parent_stdio_kind_error(ffi.uv_translate_sys_error(denied_errno),
    descriptor, missing_probe ..
      " denied without a valid TITAN_STDIO_PIPE_FDS hint for this fd")
end

local function initialize_parent_stdio(runtime: Runtime,
                                       descriptor: integer): uv_stdio_t
  if parent_runtime ~= runtime then
    parent_runtime = runtime
    cached_parent_stdio = {}
  end
  local cache_index = descriptor + 1
  local cached: uv_stdio_t? = cached_parent_stdio[cache_index]
  if cached and ffi.uv_is_closing(
      stream_handle(cached as uv_stdio_t)) == 0 then
    return cached as uv_stdio_t
  end
  cached_parent_stdio[cache_index] = nil

  local guessed = parent_stdio_kind(descriptor)
  local duplicate = duplicate_descriptor(descriptor as foreign uv_file)
  defer ffi.titan_close_parent_duplicate(duplicate)
  local stdio: uv_stdio_t? = nil
  local keep = false
  defer if not keep then discard_unpublished_stdio(stdio) end
  if guessed == ffi.UV_TTY then
    local owner = new_stdio(StdioNative.tty(foreign uv_tty_t.new()), runtime)
    local native = stream_native(owner) as foreign *uv_tty_t
    owner.root_index = root_handle(runtime, owner)
    local status = ffi.uv_tty_init(
        runtime.loop, native, duplicate, 0)
    if status < 0 then
      unroot_handle(runtime, owner.root_index)
      owner.root_index = 0
      stdio = nil
      raise make_error(status, "stdio.parent.init")
    end
    local native_pointer: foreign *uv_tty_t = native
    ffi.uv_handle_set_data(native_pointer as foreign *uv_handle_t,
                             owner as foreign *void)
    stdio = owner

    local actual = foreign uv_os_fd_t.new_array(1)
    status = ffi.uv_fileno(native_pointer as foreign *uv_handle_t, actual)
    check_status(status, "stdio.parent.fileno")
    if actual[0] ~= ffi.uv_get_osfhandle(duplicate) then
      status = ffi.titan_close_parent_duplicate(duplicate)
      check_status(status, "stdio.parent.duplicate.close")
    end
    duplicate = -1 as foreign uv_file
  else
    local status = 0
    status, stdio = new_pipe_stdio(runtime)
    check_status(status, "stdio.parent.init")
    status = ffi.uv_pipe_open(
        stream_native(stdio as uv_stdio_t) as foreign *uv_pipe_t, duplicate)
    check_status(status, "stdio.parent.open")
    if ffi.TITAN_UV_WINDOWS ~= 0 then
      -- Windows libuv duplicates descriptors 0..2 internally. Compare the
      -- real OS handles before relinquishing our independently owned CRT fd.
      local actual = foreign uv_os_fd_t.new_array(1)
      status = ffi.uv_fileno(
          stream_handle(stdio as uv_stdio_t), actual)
      check_status(status, "stdio.parent.fileno")
      if actual[0] ~= ffi.uv_get_osfhandle(duplicate) then
        status = ffi.titan_close_parent_duplicate(duplicate)
        check_status(status, "stdio.parent.duplicate.close")
      end
    end
    duplicate = -1 as foreign uv_file
  end

  local result = stdio as uv_stdio_t
  cached_parent_stdio[cache_index] = result
  keep = true
  return result
end

local function validate_config(state: uv_spawn_config): integer
  local task = running_task()
  if state.consumed or state.runtime ~= task.runtime then
    return ffi.UV_EINVAL
  end
  return 0
end

local function discard_slot(candidate: SpawnSlot?,
                            keep_a: SpawnSlot?, keep_b: SpawnSlot?)
  if not candidate or candidate == keep_a or candidate == keep_b then return end
  local slot = candidate as SpawnSlot
  case slot
  when inherit() then
    return
  when capture(stream) then
    discard_unpublished_stdio(stream)
  when merged{child, parent} then
    discard_unpublished_stdio(child)
    discard_unpublished_stdio(parent)
  end
end

local function bind_slot(state: uv_spawn_config, index: integer,
                         slot: SpawnSlot, flags: integer)
  state.stdio[index].flags = flags as foreign uv_stdio_flags
  state.stdio[index].data.stream = stream_native(slot_child(slot))
end

local function config_slot(state: uv_spawn_config,
                           descriptor: integer): SpawnSlot?
  return state.slots[descriptor + 1]
end

local function configure_slot(state: uv_spawn_config,
                              descriptor: integer,
                              slot: SpawnSlot, flags: integer)
  local old? = config_slot(state, descriptor)
  state.slots[descriptor + 1] = slot
  bind_slot(state, descriptor, slot, flags)
  if old ~= config_slot(state, 0) and
     old ~= config_slot(state, 1) and
     old ~= config_slot(state, 2) then
    discard_slot(old, nil, nil)
  end
end

local function discard_config_streams(state: uv_spawn_config)
  local stdin? = config_slot(state, 0)
  local stdout? = config_slot(state, 1)
  local stderr? = config_slot(state, 2)
  state.slots = {}
  discard_slot(stdin, stdout, stderr)
  discard_slot(stdout, stderr, nil)
  discard_slot(stderr, nil, nil)
end

local function config_capture(
    state: uv_spawn_config): (integer, SpawnSlot?)
  local status, stream = new_pipe_stdio(state.runtime)
  if status < 0 then return status, nil end
  local captured = stream as uv_stdio_t
  return 0, SpawnSlot.capture(captured)
end

local function prepare_inherited_stdio(state: uv_spawn_config,
                                       descriptor: integer):
                                       (integer, SpawnSlot?)
  local prepared: uv_stdio_t? = nil
  do
    prepared = initialize_parent_stdio(state.runtime, descriptor)
  catch
    if error is OperationError then
      local failure = error as OperationError
      return failure.code, nil
    end
    raise
  end
  return 0, SpawnSlot.inherit(prepared as uv_stdio_t)
end

local function config_merged_output(state: uv_spawn_config):
                                    (integer, SpawnSlot?)
  local status, parent? = new_pipe_stdio(state.runtime)
  if status < 0 then return status, nil end
  local parent_stream = parent as uv_stdio_t
  local child: uv_stdio_t? = nil
  status, child = new_pipe_stdio(state.runtime)
  if status < 0 then
    discard_unpublished_stdio(parent_stream)
    return status, nil
  end
  local child_stream = child as uv_stdio_t
  local keep = false
  defer if not keep then
    discard_unpublished_stdio(parent_stream)
    discard_unpublished_stdio(child_stream)
  end

  local descriptors = foreign uv_file.new_array(2)
  descriptors[0] = -1 as foreign uv_file
  descriptors[1] = -1 as foreign uv_file
  defer do
    close_descriptor(descriptors[0])
    close_descriptor(descriptors[1])
  end
  status = ffi.uv_pipe(
      descriptors, ffi.UV_NONBLOCK_PIPE as foreign int, 0)
  if status < 0 then return status, nil end
  status = ffi.uv_pipe_open(
      stream_native(parent_stream) as foreign *uv_pipe_t, descriptors[0])
  if status < 0 then return status, nil end
  descriptors[0] = -1 as foreign uv_file
  status = ffi.uv_pipe_open(
      stream_native(child_stream) as foreign *uv_pipe_t, descriptors[1])
  if status < 0 then return status, nil end
  descriptors[1] = -1 as foreign uv_file
  status = ffi.uv_stream_set_blocking(stream_native(child_stream), 1)
  if status < 0 then return status, nil end
  keep = true
  return 0, SpawnSlot.merged(child_stream, parent_stream)
end

local function os_spawn_config_new(): uv_spawn_config
  local task = running_task()
  accepting_work(task.runtime, "configure a Process")
  local config = uv_spawn_config.new {
    runtime = task.runtime,
    options = foreign uv_process_options_t.new(),
    stdio = foreign uv_stdio_container_t.new_array(3),
    slots = {},
    environment = {},
    consumed = false,
  }
  config.options.exit_cb = uv_process_exit_cb
  config.options.stdio_count = 3 as foreign int
  config.options.stdio = config.stdio
  return config
end

local function configure_capture(config: uv_spawn_config,
                                 descriptor: integer): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local captured: SpawnSlot? = nil
  status, captured = config_capture(config)
  if status < 0 then return status end
  local slot = captured as SpawnSlot
  if descriptor == 0 then
    configure_slot(config, descriptor, slot,
                   ffi.UV_CREATE_PIPE | ffi.UV_READABLE_PIPE)
    return 0
  end
  configure_slot(config, descriptor, slot,
                 ffi.UV_CREATE_PIPE | ffi.UV_WRITABLE_PIPE)
  return 0
end

local function configure_parent(config: uv_spawn_config,
                                descriptor: integer): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local parent: SpawnSlot? = nil
  status, parent = prepare_inherited_stdio(config, descriptor)
  if status < 0 then return status end
  local slot = parent as SpawnSlot
  configure_slot(config, descriptor, slot, ffi.UV_INHERIT_STREAM)
  return 0
end

local function os_spawn_config_with_merged_output(
    config: uv_spawn_config): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local merged: SpawnSlot? = nil
  status, merged = config_merged_output(config)
  if status >= 0 then
    local slot = merged as SpawnSlot
    configure_slot(config, 1, slot, ffi.UV_INHERIT_STREAM)
    configure_slot(config, 2, slot, ffi.UV_INHERIT_STREAM)
  end
  return status
end

local function os_spawn_config_with_env(config: uv_spawn_config,
                                         name: string,
                                         contents: string): integer
  local status = validate_config(config)
  if status < 0 then return status end
  if #name == 0 or contains_nul(name) or contains_nul(contents) then
    return ffi.UV_EINVAL
  end
  local bytes = name as foreign const *unsigned char
  local byte_index = 0
  while byte_index < #name do
    if bytes[byte_index] == 61 then return ffi.UV_EINVAL end
    byte_index = byte_index + 1
  end
  local entry = SpawnEnvironmentEntry.new(name, contents)
  local index = 1
  while index <= #config.environment do
    local equal = ffi.titan_process_environment_name_equal(
        config.environment[index].name, name) as integer
    if equal < 0 then return equal end
    if equal == 1 then
      config.environment[index] = entry
      return 0
    end
    index = index + 1
  end
  config.environment[#config.environment + 1] = entry
  return 0
end

-- uv_os_environ owns a native snapshot only while this helper copies its
-- entries. The returned Titan strings own all bytes borrowed by uv_spawn.
local function spawn_environment(config: uv_spawn_config): {string}
  local result: {string} = {}
  if #config.environment == 0 then return result end
  local entries = foreign EnvironmentPointer.new_array(1)
  local count = foreign int.new_array(1)
  check_status(ffi.uv_os_environ(entries, count), "process.spawn.environment")
  defer ffi.uv_os_free_environ(entries[0], count[0])
  local index = 0
  while index < count[0] as integer do
    local inherited = entries[0][index]
    local replaced = false
    local option_index = 1
    while option_index <= #config.environment do
      local equal = ffi.titan_process_environment_name_equal(
          inherited.name, config.environment[option_index].name) as integer
      check_status(equal, "process.spawn.environment")
      if equal == 1 then
        replaced = true
        break
      end
      option_index = option_index + 1
    end
    if not replaced then
      result[#result + 1] = (inherited.name as string) .. "=" ..
                            (inherited.value as string)
    end
    index = index + 1
  end
  index = 1
  while index <= #config.environment do
    local entry = config.environment[index]
    result[#result + 1] = entry.name .. "=" .. entry.contents
    index = index + 1
  end
  return result
end

local function os_spawn_config_close(config: uv_spawn_config)
  if config.consumed then return end
  local task = running_task()
  if config.runtime ~= task.runtime then
    raise "SpawnConfig belongs to a different async Runtime"
  end
  config.consumed = true
  discard_config_streams(config)
end

local function os_spawn_config_error(config: uv_spawn_config, status: integer)
  os_spawn_config_close(config)
  raise make_error(status, "process.spawn.config")
end

local function new_process(runtime: Runtime): uv_process_t
  return uv_process_t.new {
    handle = foreign uv_process_t.new(),
    exit_callback = process_exit_callback,
    runtime = runtime,
    waiter = nil,
    result = ProcessExitResult.new(0, 0),
    root_index = 0,
  }
end

local function os_process_spawn_with_config(file: string, args: {string},
                                       config: uv_spawn_config):
                                       (uv_process_t, uv_stdio_t?,
                                        uv_stdio_t?, uv_stdio_t?)
  local state = config
  local status = validate_config(state)
  if status < 0 then os_spawn_config_error(config, status) end
  local stdin_slot? = config_slot(state, 0)
  local stdout_slot? = config_slot(state, 1)
  local stderr_slot? = config_slot(state, 2)
  if not stdin_slot or not stdout_slot or not stderr_slot then
    os_spawn_config_error(config, ffi.UV_EINVAL)
  end
  accepting_work(state.runtime, "spawn a Process")

  if contains_nul(file) then
    raise make_error(ffi.UV_EINVAL, "process.spawn.file")
  end
  local index = 1
  while index <= #args do
    if contains_nul(args[index]) then
      raise make_error(
          ffi.UV_EINVAL, "process.spawn.argument")
    end
    index = index + 1
  end
  local stdin? = slot_parent(stdin_slot as SpawnSlot)
  local stdout? = slot_parent(stdout_slot as SpawnSlot)
  local stderr? = slot_parent(stderr_slot as SpawnSlot)
  local stdout_merged_child? =
      slot_merged_child(stdout_slot as SpawnSlot)
  local stderr_merged_child? =
      slot_merged_child(stderr_slot as SpawnSlot)
  local environment = spawn_environment(state)
  local envp = foreign CharPointer.new_array(#environment + 1)
  index = 1
  while index <= #environment do
    envp[index - 1] = environment[index]
    index = index + 1
  end
  envp[#environment] = nil
  if #state.environment > 0 then state.options.env = envp end
  local process = new_process(state.runtime)
  local process_handle: foreign *uv_process_t = process.handle
  local argument_count = #args + 1
  local argv = foreign CharPointer.new_array(argument_count + 1)
  argv[0] = file
  index = 1
  while index <= #args do
    argv[index] = args[index]
    index = index + 1
  end
  argv[argument_count] = nil
  state.options.file = file
  state.options.args = argv
  process.root_index = root_handle(state.runtime, process)
  state.consumed = true
  local spawn_status = ffi.uv_spawn(
      state.runtime.loop, process_handle, state.options)
  state.options.env = nil

  if spawn_status < 0 then
    defer discard_config_streams(state)
    await(Call.process_spawn_failure(
        ProcessSpawnFailureCall.new(process)))
    raise make_error(spawn_status, "process.spawn")
  end

  -- uv_spawn has now initialized the handle and the non-reentrant loop cannot
  -- deliver exit_callback until control returns to uv_run.
  ffi.uv_handle_set_data(process_handle as foreign *uv_handle_t,
                           process as foreign *void)

  state.slots = {}
  discard_unpublished_stdio(stdout_merged_child)
  discard_unpublished_stdio(stderr_merged_child)

  if stdout then
    local output = stdout as uv_stdio_t
    start_captured_read(output, "process.stdout.read.start")
  end
  if stderr and stderr ~= stdout then
    local error_output = stderr as uv_stdio_t
    start_captured_read(error_output,
                        "process.stderr.read.start")
  end
  return process, stdin, stdout, stderr
end

local function validate_process(process: uv_process_t)
  if process.runtime ~= running_task().runtime then
    raise "Process belongs to a different async Runtime"
  end
end

local function os_process_wait(process: uv_process_t): (integer, integer)
  validate_process(process)
  local result = await(Call.process_wait(
      ProcessWaitCall.new(process))) as ProcessExitResult
  return result.code, result.signal_number
end

local function os_process_kill(process: uv_process_t, signal: string)
  validate_process(process)
  local signum = signal_number(signal)
  if signum <= 0 then
    raise "unsupported process signal name '" .. signal .. "'"
  end
  local native: foreign *uv_process_t = process.handle
  if ffi.uv_is_active(native as foreign *uv_handle_t) == 0 then
    raise "cannot signal an exited Process"
  end
  local status = ffi.uv_process_kill(process.handle, signum)
  if status < 0 and status ~= ffi.UV_ESRCH then
    raise make_error(status, "process.kill")
  end
end

local function os_process_is_running(process: uv_process_t): boolean
  validate_process(process)
  local native: foreign *uv_process_t = process.handle
  return ffi.uv_is_active(native as foreign *uv_handle_t) ~= 0
end

local function os_parent_stdio(descriptor: integer): uv_stdio_t
  return initialize_parent_stdio(running_task().runtime, descriptor)
end

local function os_stdio_is_tty(stdio: uv_stdio_t): boolean
  validate_stdio(stdio)
  case stdio.native
  when tty() then return true
  else return false
  end
end

local function os_stdio_read(stdio: uv_stdio_t): string?
  validate_stdio(stdio)
  return await(Call.stream_read(StreamReadCall.new(stdio)))
end

local function os_stdio_write(stdio: uv_stdio_t, data: string)
  validate_stdio(stdio)
  await(Call.stream_write(StreamWriteCall.new(stdio, data)))
end

local function os_stdio_close(stdio: uv_stdio_t)
  validate_stdio(stdio)
  await(Call.stream_close(StreamCloseCall.new(stdio)))
end
