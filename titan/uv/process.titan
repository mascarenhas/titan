local process_fcntl = foreign import "fcntl.h"
local process_unistd = foreign import "unistd.h"

-- Stream reads are the one multi-shot operation in this contributor. A
-- stream therefore buffers callback chunks and has at most one suspended
-- reader. Every write independently owns one uv_write_t; libuv supplies the
-- native stream ordering.
local union StdioNative
  pipe: owned *libuv.uv_pipe_t
  tty: owned *libuv.uv_tty_t
end

record uv_stdio_t
  local native: StdioNative
  local alloc_callback: (uv_stdio_t, libuv.size_t,
                         ffi.titan_ffi_void_ptr) -> ()
  local read_callback: (uv_stdio_t, integer) -> ()
  local buffer: Bytes?
  local runtime: Runtime
  local waiter: Task?
  local chunks: {string}
  local chunk_head: integer
  local read_error: value
  local root_index: integer
end

local record ProcessExitResult
  local code: integer
  local signal_number: integer
end

record uv_process_t
  local handle: owned *libuv.uv_process_t
  local exit_callback: (uv_process_t, integer, integer) -> ()
  local runtime: Runtime
  local stdin: uv_stdio_t?
  local stdout: uv_stdio_t?
  local stderr: uv_stdio_t?
  local waiter: Task?
  local result: ProcessExitResult?
  local root_index: integer
end

local record SpawnSlot
  local child: uv_stdio_t
  local parent: uv_stdio_t?
end

record uv_spawn_config
  local runtime: Runtime
  local options: owned *libuv.uv_process_options_t
  local stdio: owned libuv.uv_stdio_container_t[]
  local stdin: SpawnSlot?
  local stdout: SpawnSlot?
  local stderr: SpawnSlot?
  local consumed: boolean
end

-- Yield payloads.  Each dispatch method is the small main-thread adapter for
-- one callback-taking libuv operation.
local record StreamReadCall
  local stream: uv_stdio_t
end

local record StreamWriteCall
  local stream: uv_stdio_t
  local data: string
end

local record StreamCloseCall
  local stream: uv_stdio_t
end

local record ProcessWaitCall
  local process: uv_process_t
end

local record uv_stream_write_t
  local handle: owned *libuv.uv_write_t
  local callback: (uv_stream_write_t, integer) -> ()
  local data: string
  local buffer: owned *libuv.uv_buf_t
end

-- os.stdin/out/err are stable facade records, but every Runtime owns fresh
-- duplicated native handles. The facade compares the wrapper records
-- themselves when rebinding to a newly initialized Runtime.
local parent_runtime: Runtime? = nil
local cached_parent_stdin: uv_stdio_t? = nil
local cached_parent_stdout: uv_stdio_t? = nil
local cached_parent_stderr: uv_stdio_t? = nil

local function stream_native(stdio: uv_stdio_t): *libuv.uv_stream_t
  case stdio.native
  when pipe: native then
    return (native as *libuv.uv_pipe_t) as *libuv.uv_stream_t
  when tty: native then
    return (native as *libuv.uv_tty_t) as *libuv.uv_stream_t
  end
  raise "invalid stdio native handle"
end

local function stream_handle(stdio: uv_stdio_t): *libuv.uv_handle_t
  return stream_native(stdio) as *libuv.uv_handle_t
end

local function new_stdio(
    native: StdioNative,
    alloc_callback: (uv_stdio_t, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> (),
    read_callback: (uv_stdio_t, integer) -> (),
    runtime: Runtime): uv_stdio_t
  return uv_stdio_t.new {
    native = native,
    alloc_callback = alloc_callback,
    read_callback = read_callback,
    buffer = nil,
    runtime = runtime,
    waiter = nil,
    chunks = {},
    chunk_head = 1,
    read_error = nil,
    root_index = 0,
  }
end

local function validate_stdio(stdio: uv_stdio_t)
  if stdio.runtime ~= running_task().runtime then
    raise "stdio stream belongs to a different async Runtime"
  end
end

local function next_chunk(stdio: uv_stdio_t): string?
  if stdio.chunk_head > #stdio.chunks then return nil end
  local chunk = stdio.chunks[stdio.chunk_head]
  stdio.chunks[stdio.chunk_head] = ""
  stdio.chunk_head = stdio.chunk_head + 1
  if stdio.chunk_head > #stdio.chunks then
    stdio.chunks = {}
    stdio.chunk_head = 1
  end
  return chunk
end

local function stop_stream_read(stdio: uv_stdio_t)
  libuv.uv_read_stop(stream_native(stdio))
end

local function close_stream_from_callback(stdio: uv_stdio_t)
  local handle = stream_handle(stdio)
  close_handle(stdio.runtime, handle, stdio,
               stdio.root_index, nil, false, nil)
  stdio.root_index = 0
end

local function stream_alloc(stdio: uv_stdio_t, size: libuv.size_t,
                            pointer: ffi.titan_ffi_void_ptr)
  local descriptor = pointer as *libuv.uv_buf_t
  do
    local bytes = ffi.titan_ffi_char.new_array(size as integer)
    stdio.buffer = bytes
    descriptor.base = bytes
    descriptor.len = size
  catch
    -- A direct native callback cannot unwind through libuv. Return the zero
    -- buffer that makes libuv invoke the paired read_cb, preserving the exact
    -- allocation error for that Task boundary rather than inventing a status
    -- or a recovery path.
    stdio.buffer = nil
    stdio.read_error = error
    descriptor.base = nil
    descriptor.len = 0
  end
end

local function take_stream_waiter(stdio: uv_stdio_t): Task?
  local waiter: Task? = stdio.waiter
  stdio.waiter = nil
  return waiter
end

local function fail_stream_callback(stdio: uv_stdio_t,
                                    failure: value,
                                    failure_traceback: string)
  local waiter? = take_stream_waiter(stdio)
  defer if waiter then
    resume_task_from_callback(waiter as Task, true, failure)
  else
    report_task_error(failure, failure_traceback)
  end
  stdio.buffer = nil
  stdio.read_error = failure
  stop_stream_read(stdio)
  close_stream_from_callback(stdio)
catch
  report_task_error(error, traceback)
end

local function deliver_stream_read(stdio: uv_stdio_t, result: integer)
  local buffer? = stdio.buffer
  stdio.buffer = nil

  if not buffer and stdio.read_error ~= nil then
    fail_stream_callback(stdio, stdio.read_error, "")
    return
  end

  if result == 0 then return end
  if result > 0 then
    local bytes = buffer as Bytes
    local payload = bytes_string(bytes, result)
    local waiter? = take_stream_waiter(stdio)
    if waiter then
      resume_task_from_callback(waiter as Task, false, payload)
    else
      stdio.chunks[#stdio.chunks + 1] = payload
    end
    return
  end

  stop_stream_read(stdio)
  local failed = false
  local payload: value = nil
  if result ~= libuv.UV_EOF then
    failed = true
    payload = make_error(result, "stdio.read", nil)
    stdio.read_error = payload
  end
  close_stream_from_callback(stdio)
  local waiter? = take_stream_waiter(stdio)
  if waiter then
    resume_task_from_callback(waiter as Task, failed, payload)
  end
end

local function stream_read_callback(stdio: uv_stdio_t, result: integer)
  deliver_stream_read(stdio, result)
catch
  fail_stream_callback(stdio, error, traceback)
end

local function start_stream_read(stdio: uv_stdio_t): integer
  if libuv.uv_is_active(stream_handle(stdio)) ~= 0 then return 0 end
  return libuv.uv_read_start(
      stream_native(stdio), shim.titan_uvshim_alloc_cb,
      shim.titan_uvshim_read_cb)
end

local function StreamReadCall:dispatch(task: Task): Immediate?
  local state = self.stream
  local chunk? = next_chunk(state)
  if chunk then return immediate_ok(chunk) end
  if state.read_error ~= nil then
    return Immediate.new(true, state.read_error)
  end
  if libuv.uv_is_closing(stream_handle(state)) ~= 0 then
    return immediate_ok(nil)
  end
  if state.waiter then
    return Immediate.new(true, "stream already has a waiting reader")
  end
  local cancel_action: CancelAction = function ()
    if state.waiter == task then
      wake_task_next_turn(task, false, nil)
      state.waiter = nil
    end
  end
  local status = start_stream_read(state)
  if status < 0 then
    return immediate_error(status, "stdio.read.start", nil)
  end
  state.waiter = task
  task.cancel_action = cancel_action
  return nil
end

local function StreamWriteCall:dispatch(task: Task): Immediate?
  local state = self.stream
  if libuv.uv_is_closing(stream_handle(state)) ~= 0 then
    return Immediate.new(true, "cannot write to a closed stream")
  end
  if #self.data == 0 then return immediate_ok(nil) end

  local descriptor = libuv.uv_buf_t.new()
  local bytes = self.data as const *ffi.titan_ffi_char
  shim.titan_uvshim_buf_init_const(
      descriptor, bytes, #self.data as libuv.size_t)
  local request = libuv.uv_write_t.new()
  local callback = function (_owner: uv_stream_write_t,
                             result: integer)
    if result < 0 then
      resume_task_from_callback(
          task, true, make_error(result, "stdio.write", nil))
    else
      resume_task_from_callback(task, false, nil)
    end
  catch
    fail_task_at_callback_boundary(task, error, traceback)
  end
  local owner = uv_stream_write_t.new(
      request, callback, self.data, descriptor)
  task.pending = owner
  local request_pointer: *libuv.uv_write_t = request
  libuv.uv_req_set_data(request_pointer as *libuv.uv_req_t,
                        owner as ffi.titan_ffi_void_ptr)
  local status = libuv.uv_write {
    req = request,
    handle = stream_native(state),
    bufs = owner.buffer,
    nbufs = 1,
    cb = shim.titan_uvshim_write_cb,
  }
  if status < 0 then
    task.pending = nil
    return immediate_error(status, "stdio.write", nil)
  end
  return nil
end

local function StreamCloseCall:dispatch(task: Task): Immediate?
  local state = self.stream
  local handle = stream_handle(state)
  if libuv.uv_is_closing(handle) ~= 0 then
    return immediate_ok(nil)
  end
  local reader? = state.waiter
  if reader then
    wake_task_next_turn(reader as Task, false, nil)
    state.waiter = nil
  end
  state.read_error = nil
  state.chunks = {}
  state.chunk_head = 1

  close_handle(state.runtime, handle, state,
               state.root_index, task, false, nil)
  state.root_index = 0
  return nil
end

local function process_exit_callback(owner: uv_process_t,
                                     exit_status: integer,
                                     term_signal: integer)
  local waiter: Task? = owner.waiter
  local result: ProcessExitResult? = nil
  do
    result = ProcessExitResult.new(exit_status, term_signal)
    owner.waiter = nil
    owner.result = result
    local native: *libuv.uv_process_t = owner.handle
    close_handle(owner.runtime, native as *libuv.uv_handle_t,
                 owner, owner.root_index, nil, false, nil)
    owner.root_index = 0
    if waiter then
      resume_task_from_callback(
          waiter as Task, false, result as ProcessExitResult)
    end
  catch
    if waiter then
      resume_task_from_callback(waiter as Task, true, error)
    else
      report_task_error(error, traceback)
    end
  end
end

local function ProcessWaitCall:dispatch(task: Task): Immediate?
  local state = self.process
  if state.result then return immediate_ok(state.result) end
  if state.waiter then
    return Immediate.new(true, "Process already has a waiting Task")
  end
  local cancel_action: CancelAction = function ()
    if state.waiter == task then
      wake_task_next_turn(task, false, nil)
      state.waiter = nil
    end
  end
  state.waiter = task
  task.cancel_action = cancel_action
  return nil
end

local function new_pipe_stdio(runtime: Runtime): (integer, uv_stdio_t?)
  local native = libuv.uv_pipe_t.new()
  local stdio = new_stdio(StdioNative.pipe(native),
                          stream_alloc, stream_read_callback,
                          runtime)
  stdio.root_index = root_handle(runtime, stdio)
  local status = libuv.uv_pipe_init(runtime.loop, native, 0)
  if status < 0 then
    unroot_handle(runtime, stdio.root_index)
    stdio.root_index = 0
    return status, nil
  end
  local native_pointer: *libuv.uv_pipe_t = native
  libuv.uv_handle_set_data(native_pointer as *libuv.uv_handle_t,
                           stdio as ffi.titan_ffi_void_ptr)
  return 0, stdio
end

-- Spawn options own initialized streams before a Process is published. They
-- have no waiter, so replacing or abandoning an option can start uv_close
-- directly without suspending the configurator.
local function discard_unpublished_stdio(stdio: uv_stdio_t?)
  if not stdio then return end
  local stream = stdio as uv_stdio_t
  local handle = stream_handle(stream)
  if libuv.uv_is_closing(handle) ~= 0 then return end
  stream.chunks = {}
  stream.chunk_head = 1
  if stream.root_index > 0 then
    close_handle(stream.runtime, handle, stream,
                 stream.root_index, nil, false, nil)
    stream.root_index = 0
  end
end

local function start_captured_read(stdio: uv_stdio_t,
                                   operation: string, file: string)
  local status = start_stream_read(stdio)
  if status >= 0 then return end
  stdio.read_error = make_error(status, operation, file)
  discard_unpublished_stdio(stdio)
end

local function duplicate_descriptor(
    descriptor: libuv.uv_file): libuv.uv_file
  local duplicate = process_unistd.dup(descriptor)
  while duplicate < 0 and cerrno.errno == cerrno.EINTR do
    duplicate = process_unistd.dup(descriptor)
  end
  if duplicate < 0 then
    raise make_error(libuv.uv_translate_sys_error(cerrno.errno),
                     "stdio.parent.duplicate", nil)
  end
  local status = process_fcntl.fcntl(
      duplicate, process_fcntl.F_SETFD, process_fcntl.FD_CLOEXEC)
  while status < 0 and cerrno.errno == cerrno.EINTR do
    status = process_fcntl.fcntl(
        duplicate, process_fcntl.F_SETFD, process_fcntl.FD_CLOEXEC)
  end
  if status < 0 then
    local saved_errno = cerrno.errno
    close_descriptor(duplicate as libuv.uv_file)
    raise make_error(libuv.uv_translate_sys_error(saved_errno),
                     "stdio.parent.duplicate.cloexec", nil)
  end
  return duplicate as libuv.uv_file
end

local function initialize_parent_stdio(runtime: Runtime,
                                       descriptor: integer): uv_stdio_t
  if parent_runtime ~= runtime then
    parent_runtime = runtime
    cached_parent_stdin = nil
    cached_parent_stdout = nil
    cached_parent_stderr = nil
  end
  local cached: uv_stdio_t? = cached_parent_stderr
  if descriptor == 0 then
    cached = cached_parent_stdin
  elseif descriptor == 1 then
    cached = cached_parent_stdout
  end
  if cached and libuv.uv_is_closing(
      stream_handle(cached as uv_stdio_t)) == 0 then
    return cached as uv_stdio_t
  end
  if descriptor == 0 then
    cached_parent_stdin = nil
  elseif descriptor == 1 then
    cached_parent_stdout = nil
  else
    cached_parent_stderr = nil
  end

  local guessed = libuv.uv_guess_handle(descriptor as libuv.uv_file)
  local duplicate = duplicate_descriptor(descriptor as libuv.uv_file)
  defer close_descriptor(duplicate)
  local stdio: uv_stdio_t? = nil
  local keep = false
  defer if not keep then discard_unpublished_stdio(stdio) end
  if guessed == libuv.UV_TTY then
    local native = libuv.uv_tty_t.new()
    local owner = new_stdio(StdioNative.tty(native),
                            stream_alloc, stream_read_callback,
                            runtime)
    owner.root_index = root_handle(runtime, owner)
    local readable = 0
    if descriptor == 0 then readable = 1 end
    local status = libuv.uv_tty_init(
        runtime.loop, native, duplicate, readable)
    if status < 0 then
      unroot_handle(runtime, owner.root_index)
      owner.root_index = 0
      raise make_error(status, "stdio.parent.init", nil)
    end
    local native_pointer: *libuv.uv_tty_t = native
    libuv.uv_handle_set_data(native_pointer as *libuv.uv_handle_t,
                             owner as ffi.titan_ffi_void_ptr)
    stdio = owner

    local actual = libuv.uv_os_fd_t.new_array(1)
    status = libuv.uv_fileno(native_pointer as *libuv.uv_handle_t, actual)
    check_status(status, "stdio.parent.fileno", nil)
    if (actual[0] as integer) ~= (duplicate as integer) then
      status = close_descriptor(duplicate)
      check_status(status, "stdio.parent.duplicate.close", nil)
    end
    duplicate = -1 as libuv.uv_file
  else
    local status = 0
    status, stdio = new_pipe_stdio(runtime)
    check_status(status, "stdio.parent.init", nil)
    status = libuv.uv_pipe_open(
        stream_native(stdio as uv_stdio_t) as *libuv.uv_pipe_t, duplicate)
    check_status(status, "stdio.parent.open", nil)
    duplicate = -1 as libuv.uv_file
  end

  local result = stdio as uv_stdio_t
  if descriptor == 0 then
    cached_parent_stdin = result
  elseif descriptor == 1 then
    cached_parent_stdout = result
  else
    cached_parent_stderr = result
  end
  keep = true
  return result
end

local function validate_config(state: uv_spawn_config): integer
  local task = running_task()
  if state.consumed or state.runtime ~= task.runtime then
    return libuv.UV_EINVAL
  end
  return 0
end

local function discard_slot(candidate: SpawnSlot?,
                            keep_a: SpawnSlot?, keep_b: SpawnSlot?)
  if not candidate or candidate == keep_a or candidate == keep_b then return end
  local slot = candidate as SpawnSlot
  if not slot.parent then return end
  discard_unpublished_stdio(slot.child)
  discard_unpublished_stdio(slot.parent)
end

local function bind_slot(state: uv_spawn_config, index: integer,
                         slot: SpawnSlot, flags: integer)
  state.stdio[index].flags = flags as libuv.uv_stdio_flags
  state.stdio[index].data.stream = stream_native(slot.child)
end

local function configure_stdin(state: uv_spawn_config,
                               slot: SpawnSlot, flags: integer)
  local old? = state.stdin
  state.stdin = slot
  bind_slot(state, 0, slot, flags)
  discard_slot(old, slot, nil)
end

local function configure_outputs(state: uv_spawn_config,
                                 stdout: SpawnSlot?, stdout_flags: integer,
                                 stderr: SpawnSlot?, stderr_flags: integer)
  local old_stdout? = state.stdout
  local old_stderr? = state.stderr
  state.stdout = stdout
  state.stderr = stderr
  if stdout then bind_slot(state, 1, stdout as SpawnSlot, stdout_flags) end
  if stderr then bind_slot(state, 2, stderr as SpawnSlot, stderr_flags) end
  discard_slot(old_stdout, stdout, stderr)
  discard_slot(old_stderr, stdout, stderr)
end

local function discard_config_streams(state: uv_spawn_config)
  discard_slot(state.stdin, nil, nil)
  discard_slot(state.stdout, nil, nil)
  discard_slot(state.stderr, nil, nil)
  state.stdin = nil
  state.stdout = nil
  state.stderr = nil
end

local function config_capture(
    state: uv_spawn_config): (integer, SpawnSlot?)
  local status, stream = new_pipe_stdio(state.runtime)
  if status < 0 then return status, nil end
  local captured = stream as uv_stdio_t
  return 0, SpawnSlot.new(captured, captured)
end

local function prepare_inherited_stdio(state: uv_spawn_config,
                                       descriptor: integer):
                                       (integer, SpawnSlot?)
  local prepared: uv_stdio_t? = nil
  do
    prepared = initialize_parent_stdio(state.runtime, descriptor)
  catch
    if error is Error then
      local failure = error as Error
      return failure.code, nil
    end
    raise
  end
  return 0, SpawnSlot.new(prepared as uv_stdio_t, nil)
end

local function config_merged_output(state: uv_spawn_config):
                                    (integer, SpawnSlot?)
  local status, parent? = new_pipe_stdio(state.runtime)
  if status < 0 then return status, nil end
  local parent_stream = parent as uv_stdio_t
  local child: uv_stdio_t? = nil
  status, child = new_pipe_stdio(state.runtime)
  if status < 0 then
    discard_unpublished_stdio(parent_stream)
    return status, nil
  end
  local child_stream = child as uv_stdio_t
  local keep = false
  defer if not keep then
    discard_unpublished_stdio(parent_stream)
    discard_unpublished_stdio(child_stream)
  end

  local descriptors: libuv.uv_file[2]
  descriptors[0] = -1 as libuv.uv_file
  descriptors[1] = -1 as libuv.uv_file
  defer do
    close_descriptor(descriptors[0])
    close_descriptor(descriptors[1])
  end
  status = libuv.uv_pipe(descriptors, libuv.UV_NONBLOCK_PIPE, 0)
  if status < 0 then return status, nil end
  status = libuv.uv_pipe_open(
      stream_native(parent_stream) as *libuv.uv_pipe_t, descriptors[0])
  if status < 0 then return status, nil end
  descriptors[0] = -1 as libuv.uv_file
  status = libuv.uv_pipe_open(
      stream_native(child_stream) as *libuv.uv_pipe_t, descriptors[1])
  if status < 0 then return status, nil end
  descriptors[1] = -1 as libuv.uv_file
  status = libuv.uv_stream_set_blocking(stream_native(child_stream), 1)
  if status < 0 then return status, nil end
  keep = true
  return 0, SpawnSlot.new(child_stream, parent_stream)
end

function _os_spawn_config_new(): uv_spawn_config
  local task = running_task()
  accepting_work(task.runtime, "configure a Process")
  local options = libuv.uv_process_options_t.new()
  local stdio = libuv.uv_stdio_container_t.new_array(3)
  options.exit_cb = shim.titan_uvshim_process_exit_cb
  options.stdio_count = 3 as ffi.titan_ffi_int
  options.stdio = stdio
  return uv_spawn_config.new {
    runtime = task.runtime,
    options = options,
    stdio = stdio,
    stdin = nil,
    stdout = nil,
    stderr = nil,
    consumed = false,
  }
end

function _os_spawn_config_with_stdin(config: uv_spawn_config): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local slot: SpawnSlot? = nil
  status, slot = config_capture(config)
  if status >= 0 then
    configure_stdin(config, slot as SpawnSlot,
                    libuv.UV_CREATE_PIPE | libuv.UV_READABLE_PIPE)
  end
  return status
end

local function configured_output_flags(slot: SpawnSlot): integer
  if slot.parent then
    return libuv.UV_CREATE_PIPE | libuv.UV_WRITABLE_PIPE
  end
  return libuv.UV_INHERIT_STREAM
end

local function replace_output(config: uv_spawn_config, index: integer,
                              slot: SpawnSlot, flags: integer): integer
  local other? = config.stderr
  if index == 2 then
    other = config.stdout
  end
  local other_flags = 0
  if other then
    other_flags = configured_output_flags(other as SpawnSlot)
  end
  if config.stdout ~= nil and config.stdout == config.stderr then
    local status = 0
    status, other = config_capture(config)
    if status < 0 then
      discard_slot(slot, nil, nil)
      return status
    end
    other_flags = libuv.UV_CREATE_PIPE | libuv.UV_WRITABLE_PIPE
  end
  if index == 1 then
    configure_outputs(config, slot, flags,
                      other, other_flags)
  else
    configure_outputs(config, other, other_flags, slot, flags)
  end
  return 0
end

local function configure_captured_output(config: uv_spawn_config,
                                         index: integer): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local captured: SpawnSlot? = nil
  status, captured = config_capture(config)
  if status < 0 then return status end
  return replace_output(
      config, index, captured as SpawnSlot,
      libuv.UV_CREATE_PIPE | libuv.UV_WRITABLE_PIPE)
end

function _os_spawn_config_with_stdout(config: uv_spawn_config): integer
  return configure_captured_output(config, 1)
end

function _os_spawn_config_with_stderr(config: uv_spawn_config): integer
  return configure_captured_output(config, 2)
end

function _os_spawn_config_with_parent_stdin(
    config: uv_spawn_config): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local parent: SpawnSlot? = nil
  status, parent = prepare_inherited_stdio(config, 0)
  if status >= 0 then
    configure_stdin(config, parent as SpawnSlot,
                    libuv.UV_INHERIT_STREAM)
  end
  return status
end

local function configure_parent_output(config: uv_spawn_config,
                                       descriptor: integer): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local parent: SpawnSlot? = nil
  status, parent = prepare_inherited_stdio(config, descriptor)
  if status < 0 then return status end
  return replace_output(config, descriptor, parent as SpawnSlot,
                        libuv.UV_INHERIT_STREAM)
end

function _os_spawn_config_with_parent_stdout(
    config: uv_spawn_config): integer
  return configure_parent_output(config, 1)
end

function _os_spawn_config_with_parent_stderr(
    config: uv_spawn_config): integer
  return configure_parent_output(config, 2)
end

function _os_spawn_config_with_merged_output(
    config: uv_spawn_config): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local merged: SpawnSlot? = nil
  status, merged = config_merged_output(config)
  if status >= 0 then
    local slot = merged as SpawnSlot
    configure_outputs(config, slot, libuv.UV_INHERIT_STREAM,
                      slot, libuv.UV_INHERIT_STREAM)
  end
  return status
end

function _os_spawn_config_close(config: uv_spawn_config)
  if config.consumed then return end
  local task = running_task()
  if config.runtime ~= task.runtime then
    raise "SpawnConfig belongs to a different async Runtime"
  end
  config.consumed = true
  discard_config_streams(config)
end

function _os_spawn_config_error(config: uv_spawn_config, status: integer)
  _os_spawn_config_close(config)
  raise make_error(status, "process.spawn.config", nil)
end

local function new_process(runtime: Runtime): uv_process_t
  local native = libuv.uv_process_t.new()
  return uv_process_t.new {
    handle = native,
    exit_callback = process_exit_callback,
    runtime = runtime,
    stdin = nil,
    stdout = nil,
    stderr = nil,
    waiter = nil,
    result = nil,
    root_index = 0,
  }
end

function _os_process_spawn_with_config(file: string, args: {string},
                                       config: uv_spawn_config): uv_process_t
  local state = config
  local status = validate_config(state)
  if status < 0 then _os_spawn_config_error(config, status) end
  if not state.stdin or not state.stdout or not state.stderr then
    _os_spawn_config_error(config, libuv.UV_EINVAL)
  end
  accepting_work(state.runtime, "spawn a Process")

  if contains_nul(file) then
    raise make_error(libuv.UV_EINVAL, "process.spawn.file", file)
  end
  local index = 1
  while index <= #args do
    if contains_nul(args[index]) then
      raise make_error(
          libuv.UV_EINVAL, "process.spawn.argument", args[index])
    end
    index = index + 1
  end
  local stdin? = (state.stdin as SpawnSlot).parent
  local stdout? = (state.stdout as SpawnSlot).parent
  local stderr? = (state.stderr as SpawnSlot).parent
  local merged_child: uv_stdio_t? = nil
  if state.stdout == state.stderr then
    local slot = state.stdout as SpawnSlot
    if slot.parent and slot.child ~= slot.parent then
      merged_child = slot.child
    end
  end
  local process = new_process(state.runtime)
  local process_handle: *libuv.uv_process_t = process.handle
  local argument_count = #args + 1
  local argv = shim.titan_uvshim_char_ptr.new_array(argument_count + 1)
  argv[0] = file
  index = 1
  while index <= #args do
    argv[index] = args[index]
    index = index + 1
  end
  argv[argument_count] = nil
  state.options.file = file
  state.options.args = argv
  state.consumed = true
  process.root_index = root_handle(state.runtime, process)
  libuv.uv_handle_set_data(process_handle as *libuv.uv_handle_t,
                           process as ffi.titan_ffi_void_ptr)
  local spawn_status = libuv.uv_spawn(
      state.runtime.loop, process_handle, state.options)

  if spawn_status < 0 then
    do
      local handle = process_handle as *libuv.uv_handle_t
      if loop_owns_handle(state.runtime, handle) then
        local old_root_index = process.root_index
        process.root_index = 0
        await(Call.raw_close(
            RawCloseCall.new(handle, process, old_root_index)))
      else
        unroot_handle(state.runtime, process.root_index)
        process.root_index = 0
      end
    finally
      discard_config_streams(state)
    end
    raise make_error(spawn_status, "process.spawn", file)
  end

  process.stdin = stdin
  process.stdout = stdout
  process.stderr = stderr
  discard_unpublished_stdio(merged_child)

  if stdout then
    local output = stdout as uv_stdio_t
    start_captured_read(output, "process.stdout.read.start", file)
  end
  if stderr and stderr ~= stdout then
    local error_output = stderr as uv_stdio_t
    start_captured_read(error_output,
                        "process.stderr.read.start", file)
  end
  return process
end

local function validate_process(process: uv_process_t)
  if process.runtime ~= running_task().runtime then
    raise "Process belongs to a different async Runtime"
  end
end

function _os_process_stdin(process: uv_process_t): uv_stdio_t?
  validate_process(process)
  return process.stdin
end

function _os_process_stdout(process: uv_process_t): uv_stdio_t?
  validate_process(process)
  return process.stdout
end

function _os_process_stderr(process: uv_process_t): uv_stdio_t?
  validate_process(process)
  return process.stderr
end

function _os_process_wait(process: uv_process_t): (integer, integer)
  validate_process(process)
  local result = await(Call.process_wait(
      ProcessWaitCall.new(process))) as ProcessExitResult
  return result.code, result.signal_number
end

function _os_process_kill(process: uv_process_t, signal: string)
  validate_process(process)
  local signum = signal_number(signal)
  if signum <= 0 then
    raise "unsupported process signal name '" .. signal .. "'"
  end
  if process.result then raise "cannot signal an exited Process" end
  local status = libuv.uv_process_kill(process.handle, signum)
  if status < 0 and status ~= libuv.UV_ESRCH then
    raise make_error(status, "process.kill", signal)
  end
end

function _os_process_is_running(process: uv_process_t): boolean
  validate_process(process)
  return process.result == nil
end

function _os_parent_stdin(): uv_stdio_t
  return initialize_parent_stdio(running_task().runtime, 0)
end

function _os_parent_stdout(): uv_stdio_t
  return initialize_parent_stdio(running_task().runtime, 1)
end

function _os_parent_stderr(): uv_stdio_t
  return initialize_parent_stdio(running_task().runtime, 2)
end

function _os_stdio_is_tty(stdio: uv_stdio_t): boolean
  validate_stdio(stdio)
  local tty = false
  case stdio.native
  when pipe then tty = false
  when tty then tty = true
  end
  return tty
end

function _os_stdio_read(stdio: uv_stdio_t): string?
  validate_stdio(stdio)
  return await(Call.stream_read(StreamReadCall.new(stdio)))
end

function _os_stdio_write(stdio: uv_stdio_t, data: string)
  validate_stdio(stdio)
  await(Call.stream_write(StreamWriteCall.new(stdio, data)))
end

function _os_stdio_close(stdio: uv_stdio_t)
  validate_stdio(stdio)
  await(Call.stream_close(StreamCloseCall.new(stdio)))
end
