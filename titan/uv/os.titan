local OS_BUFFER_INITIAL = 256

local record SignalWaitCall
  local signum: integer
end

local record uv_signal_t
  local handle: owned *ffi.uv_signal_t
  local callback: (uv_signal_t, integer) -> ()
  local root_index: integer
end

foreign function uv_signal_cb(signal: *ffi.uv_signal_t,
                              signum: int)
  local handle = signal as *ffi.uv_handle_t
  local owner = ffi.uv_handle_get_data(handle) as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[1].uv)
  local loop = ffi.uv_handle_get_loop(handle)
  local L = ffi.uv_loop_get_data(loop) as *ffi.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvIntegerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner, signum as ffi.lua_Integer)
  ffi.lua_settop(L, top)
end

local function signal_number(name: string): int
  if name == "hup" then return ffi.SIGHUP end
  if name == "int" then return ffi.SIGINT end
  if name == "quit" then return ffi.SIGQUIT end
  if name == "kill" then return ffi.SIGKILL end
  if name == "term" then return ffi.SIGTERM end
  if name == "usr1" then return ffi.SIGUSR1 end
  if name == "usr2" then return ffi.SIGUSR2 end
  return 0 as int
end

local function signal_name(signum: integer): string?
  if signum == ffi.SIGHUP then return "hup" end
  if signum == ffi.SIGINT then return "int" end
  if signum == ffi.SIGQUIT then return "quit" end
  if signum == ffi.SIGKILL then return "kill" end
  if signum == ffi.SIGTERM then return "term" end
  if signum == ffi.SIGUSR1 then return "usr1" end
  if signum == ffi.SIGUSR2 then return "usr2" end
  return nil
end

local function os_sized_buffer(
    uv_buffer_func: (*char, *ffi.size_t) ->
                    int,
    capacity: ffi.size_t,
    operation: string): string?
  local actual_capacity = capacity
  while true do
    local sizes = ffi.size_t.new_array(1)
    local bytes = char.new_array(actual_capacity as integer)
    sizes[0] = actual_capacity
    local status = uv_buffer_func(bytes, sizes)
    if status >= 0 then
      return bytes_string(bytes, sizes[0] as integer)
    elseif status == ffi.UV_ENOBUFS then
      actual_capacity = sizes[0]
    elseif status == ffi.UV_ENOENT then
      return nil
    else
      raise make_error(status, operation)
    end
  end
  return nil
end

local function os_cwd_buffer(bytes: *char,
                             sizes: *ffi.size_t): int
  return ffi.uv_cwd(bytes, sizes)
end

local function os_homedir_buffer(bytes: *char,
                                 sizes: *ffi.size_t): int
  return ffi.uv_os_homedir(bytes, sizes)
end

local function os_tmpdir_buffer(bytes: *char,
                                sizes: *ffi.size_t): int
  return ffi.uv_os_tmpdir(bytes, sizes)
end

local function os_hostname_buffer(bytes: *char,
                                  sizes: *ffi.size_t): int
  return ffi.uv_os_gethostname(bytes, sizes)
end

local function os_exepath_buffer(bytes: *char,
                                 sizes: *ffi.size_t): int
  local capacity = sizes[0]
  local status = ffi.uv_exepath(bytes, sizes)
  local supplied = capacity as integer
  if status >= 0 and (sizes[0] as integer) == supplied - 1 then
    sizes[0] = (supplied * 2) as ffi.size_t
    return ffi.UV_ENOBUFS as int
  end
  return status
end

local function current_directory(operation: string): string
  return os_sized_buffer(os_cwd_buffer,
      OS_BUFFER_INITIAL as ffi.size_t,
      operation) as string
end

local function change_directory(path: string, operation: string)
  checked_text(path, operation)
  local status = ffi.uv_chdir(path)
  check_status(status, operation)
end

local function fs_tmpname_template(): string
  return (os_sized_buffer(os_tmpdir_buffer,
      OS_BUFFER_INITIAL as ffi.size_t,
      "fs.tmpname") as string) ..
      "/titan-fs-XXXXXX"
end

local function os_getenv(name: string): string?
  checked_text(name, "os.getenv")
  local operation = function (bytes: *char,
                              sizes: *ffi.size_t): int
    return ffi.uv_os_getenv(name, bytes, sizes)
  end
  return os_sized_buffer(operation,
      OS_BUFFER_INITIAL as ffi.size_t,
      "os.getenv")
end

local function os_setenv(name: string, contents: string)
  checked_text(name, "os.setenv")
  checked_text(contents, "os.setenv")
  check_status(ffi.uv_os_setenv(name, contents),
               "os.setenv")
end

local function os_unsetenv(name: string)
  checked_text(name, "os.unsetenv")
  check_status(ffi.uv_os_unsetenv(name), "os.unsetenv")
end

local function os_homedir(): string
  return os_sized_buffer(os_homedir_buffer,
      OS_BUFFER_INITIAL as ffi.size_t,
      "os.homedir") as string
end

local function os_tmpdir(): string
  return os_sized_buffer(os_tmpdir_buffer,
      OS_BUFFER_INITIAL as ffi.size_t,
      "os.tmpdir") as string
end

local function os_hostname(): string
  return os_sized_buffer(os_hostname_buffer,
      OS_BUFFER_INITIAL as ffi.size_t,
      "os.hostname") as string
end

local function os_exepath(): string
  if not program_args_ready then
    raise "os.exepath is only available in a compiled Titan program"
  end
  return os_sized_buffer(os_exepath_buffer,
      OS_BUFFER_INITIAL as ffi.size_t,
      "os.exepath") as string
end

local function os_pid(): integer
  return ffi.uv_os_getpid()
end

local function os_ppid(): integer
  return ffi.uv_os_getppid()
end

local function os_clock(): float
  local usage = ffi.uv_rusage_t.new()
  local status = ffi.uv_getrusage(usage)
  check_status(status, "os.clock")
  return ((usage.ru_utime.tv_sec as integer) as float) +
         ((usage.ru_utime.tv_usec as integer) as float) / 1000000.0 +
         ((usage.ru_stime.tv_sec as integer) as float) +
         ((usage.ru_stime.tv_usec as integer) as float) / 1000000.0
end

local function os_time(): integer
  local current = ffi.uv_timeval64_t.new()
  local status = ffi.uv_gettimeofday(current)
  check_status(status, "os.current_time")
  return current.tv_sec as integer
end

local function SignalWaitCall:dispatch(task: Task): Immediate?
  local runtime = task.runtime
  accepting_work(runtime, "wait for a signal")
  local native: owned *ffi.uv_signal_t = ffi.uv_signal_t.new()
  local callback = function (owner: uv_signal_t, result: integer)
    local signal_handle: *ffi.uv_signal_t = owner.handle
    close_handle(runtime,
                 signal_handle as *ffi.uv_handle_t,
                 owner, owner.root_index,
                 task, signal_name(result) as string)
    owner.root_index = 0
  catch
    fail_task_at_callback_boundary(task, error, traceback)
  end
  local owner = uv_signal_t.new(native, callback, 0)
  owner.root_index = root_handle(runtime, owner)
  local status = ffi.uv_signal_init(runtime.loop, native)
  if status < 0 then
    unroot_handle(runtime, owner.root_index)
    owner.root_index = 0
    return immediate_error(status, "signal.init")
  end
  local signal_handle: *ffi.uv_signal_t = native
  ffi.uv_handle_set_data(
      signal_handle as *ffi.uv_handle_t,
      owner as *void)
  local cancel_action: CancelAction = function ()
    close_handle(runtime, signal_handle as *ffi.uv_handle_t,
                 owner, owner.root_index,
                 task, nil)
    owner.root_index = 0
  end
  status = ffi.uv_signal_start_oneshot(
      native, uv_signal_cb,
      self.signum as int)
  if status < 0 then
    close_handle(runtime, signal_handle as *ffi.uv_handle_t,
                 owner, owner.root_index, nil, nil)
    owner.root_index = 0
    return immediate_error(status, "signal.start")
  end
  task.cancel_action = cancel_action
  return nil
end

local function os_wait_signal(name: string): string
  local signum = signal_number(name)
  if signum <= 0 or name == "kill" then
    raise "unsupported waitable signal name '" .. name .. "'"
  end
  return await(Call.signal_wait(
      SignalWaitCall.new(signum as integer))) as string
end
