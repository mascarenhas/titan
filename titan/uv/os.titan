local OS_BUFFER_INITIAL = 256

local record SignalWaitCall
  local signum: integer
end

local record uv_signal_t
  local handle: owned *libuv.uv_signal_t
  local callback: (uv_signal_t, integer) -> ()
  local root_index: integer
end

local function signal_number(name: string): ffi.titan_ffi_int
  if name == "hup" then return csignal.SIGHUP end
  if name == "int" then return csignal.SIGINT end
  if name == "quit" then return csignal.SIGQUIT end
  if name == "kill" then return csignal.SIGKILL end
  if name == "term" then return csignal.SIGTERM end
  if name == "usr1" then return csignal.SIGUSR1 end
  if name == "usr2" then return csignal.SIGUSR2 end
  return 0 as ffi.titan_ffi_int
end

local function signal_name(signum: integer): string?
  if signum == csignal.SIGHUP then return "hup" end
  if signum == csignal.SIGINT then return "int" end
  if signum == csignal.SIGQUIT then return "quit" end
  if signum == csignal.SIGKILL then return "kill" end
  if signum == csignal.SIGTERM then return "term" end
  if signum == csignal.SIGUSR1 then return "usr1" end
  if signum == csignal.SIGUSR2 then return "usr2" end
  return nil
end

local function os_sized_buffer(
    uv_buffer_func: (*ffi.titan_ffi_char, *libuv.size_t) ->
                    ffi.titan_ffi_int,
    capacity: libuv.size_t,
    operation: string, subject: string?): string?
  local sizes = libuv.size_t.new_array(1)
  local bytes = ffi.titan_ffi_char.new_array(capacity as integer)
  sizes[0] = capacity
  local status = uv_buffer_func(bytes, sizes)
  if status >= 0 then
    return bytes_string(bytes, sizes[0] as integer)
  elseif status == libuv.UV_ENOBUFS then
    return os_sized_buffer(uv_buffer_func, sizes[0], operation, subject)
  elseif status == libuv.UV_ENOENT then
    return nil
  else
    raise make_error(status, operation, subject)
  end
end

local function os_cwd_buffer(bytes: *ffi.titan_ffi_char,
                             sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_cwd(bytes, sizes)
end

local function os_homedir_buffer(bytes: *ffi.titan_ffi_char,
                                 sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_os_homedir(bytes, sizes)
end

local function os_tmpdir_buffer(bytes: *ffi.titan_ffi_char,
                                sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_os_tmpdir(bytes, sizes)
end

local function os_hostname_buffer(bytes: *ffi.titan_ffi_char,
                                  sizes: *libuv.size_t): ffi.titan_ffi_int
  return libuv.uv_os_gethostname(bytes, sizes)
end

local function os_exepath_buffer(bytes: *ffi.titan_ffi_char,
                                 sizes: *libuv.size_t): ffi.titan_ffi_int
  local capacity = sizes[0]
  local status = libuv.uv_exepath(bytes, sizes)
  local supplied = capacity as integer
  if status >= 0 and (sizes[0] as integer) == supplied - 1 then
    sizes[0] = (supplied * 2) as libuv.size_t
    return libuv.UV_ENOBUFS as ffi.titan_ffi_int
  end
  return status
end

local function current_directory(operation: string): string
  return os_sized_buffer(os_cwd_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      operation, nil) as string
end

local function change_directory(path: string, operation: string)
  checked_text(path, operation, path)
  local status = libuv.uv_chdir(path)
  check_status(status, operation, path)
end

local function fs_tmpname_template(): string
  return (os_sized_buffer(os_tmpdir_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      "fs.tmpname", nil) as string) ..
      "/titan-fs-XXXXXX"
end

function _os_getenv(name: string): string?
  checked_text(name, "os.getenv", name)
  local operation = function (bytes: *ffi.titan_ffi_char,
                              sizes: *libuv.size_t): ffi.titan_ffi_int
    return libuv.uv_os_getenv(name, bytes, sizes)
  end
  return os_sized_buffer(operation,
      OS_BUFFER_INITIAL as libuv.size_t,
      "os.getenv", name)
end

function _os_setenv(name: string, contents: string)
  checked_text(name, "os.setenv", name)
  checked_text(contents, "os.setenv", name)
  check_status(libuv.uv_os_setenv(name, contents),
               "os.setenv", name)
end

function _os_unsetenv(name: string)
  checked_text(name, "os.unsetenv", name)
  check_status(libuv.uv_os_unsetenv(name), "os.unsetenv", name)
end

function _os_cwd(): string
  return current_directory("os.cwd")
end

function _os_chdir(path: string)
  change_directory(path, "os.chdir")
end

function _fs_pwd(): string
  return current_directory("fs.pwd")
end

function _fs_chdir(path: string)
  change_directory(path, "fs.chdir")
end

function _os_homedir(): string
  return os_sized_buffer(os_homedir_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      "os.homedir", nil) as string
end

function _os_tmpdir(): string
  return os_sized_buffer(os_tmpdir_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      "os.tmpdir", nil) as string
end

function _os_hostname(): string
  return os_sized_buffer(os_hostname_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      "os.hostname", nil) as string
end

function _os_exepath(): string
  if not program_args_ready then
    raise "os.exepath is only available in a compiled Titan program"
  end
  return os_sized_buffer(os_exepath_buffer,
      OS_BUFFER_INITIAL as libuv.size_t,
      "os.exepath", nil) as string
end

function _os_pid(): integer
  return libuv.uv_os_getpid()
end

function _os_ppid(): integer
  return libuv.uv_os_getppid()
end

function _os_clock(): float
  local usage: libuv.uv_rusage_t
  local status = libuv.uv_getrusage(usage)
  check_status(status, "os.clock", nil)
  return ((usage.ru_utime.tv_sec as integer) as float) +
         ((usage.ru_utime.tv_usec as integer) as float) / 1000000.0 +
         ((usage.ru_stime.tv_sec as integer) as float) +
         ((usage.ru_stime.tv_usec as integer) as float) / 1000000.0
end

function _os_time(): integer
  local current: libuv.uv_timeval64_t
  local status = libuv.uv_gettimeofday(current)
  check_status(status, "os.current_time", nil)
  return current.tv_sec as integer
end

local function SignalWaitCall:dispatch(task: Task): Immediate?
  local runtime = task.runtime
  accepting_work(runtime, "wait for a signal")
  local native = libuv.uv_signal_t.new()
  local callback = function (owner: uv_signal_t, result: integer)
    local signal_handle: *libuv.uv_signal_t = owner.handle
    close_handle(runtime,
                 signal_handle as *libuv.uv_handle_t,
                 owner, owner.root_index,
                 task, false, signal_name(result) as string)
    owner.root_index = 0
  catch
    fail_task_at_callback_boundary(task, error, traceback)
  end
  local owner = uv_signal_t.new(native, callback, 0)
  owner.root_index = root_handle(runtime, owner)
  local status = libuv.uv_signal_init(runtime.loop, native)
  if status < 0 then
    unroot_handle(runtime, owner.root_index)
    owner.root_index = 0
    return immediate_error(status, "signal.init", nil)
  end
  local signal_handle: *libuv.uv_signal_t = native
  libuv.uv_handle_set_data(
      signal_handle as *libuv.uv_handle_t,
      owner as ffi.titan_ffi_void_ptr)
  local cancel_action: CancelAction = function ()
    close_handle(runtime, signal_handle as *libuv.uv_handle_t,
                 owner, owner.root_index,
                 task, false, nil)
    owner.root_index = 0
  end
  status = libuv.uv_signal_start_oneshot(
      native, shim.titan_uvshim_signal_cb,
      self.signum as ffi.titan_ffi_int)
  if status < 0 then
    close_handle(runtime, signal_handle as *libuv.uv_handle_t,
                 owner, owner.root_index, nil, false, nil)
    return immediate_error(status, "signal.start", nil)
  end
  task.cancel_action = cancel_action
  return nil
end

function _os_wait_signal(name: string): string
  local signum = signal_number(name)
  if signum <= 0 or name == "kill" then
    raise "unsupported waitable signal name '" .. name .. "'"
  end
  return await(Call.signal_wait(
      SignalWaitCall.new(signum as integer))) as string
end

function _os_signal_name(signal_number: integer): string?
  if signal_number <= 0 then return nil end
  return signal_name(signal_number)
end
