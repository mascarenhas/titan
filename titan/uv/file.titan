foreign import "sys/stat.h"

local record FsStatResult
  local size: integer
  local kind: string
  local mode: integer
  local device: integer
  local inode: integer
  local modified_seconds: integer
  local modified_nanoseconds: integer
end

-- A uv_file is a process descriptor, not a Runtime-owned uv_handle_t.


local record FsOpenCall
  local path: string
  local flags: integer
end

local record FsReadCall
  local file: foreign uv_file
  local maximum: integer
end

local record FsWriteCall
  local file: foreign uv_file
  local data: string
  local offset: integer
end

local record FsFlushCall
  local file: foreign uv_file
end

local record FsCloseCall
  local file: foreign uv_file
  local accepted: boolean
end

local record FsStatCall
  local path: string
end

local record FsLstatCall
  local path: string
end

local record FsTmpnameCall
  local path: string
end

local record FsMkdirCall
  local path: string
end

local record FsUnlinkCall
  local path: string
end

local record FsRmdirCall
  local path: string
end

local record FsRenameCall
  local from: string
  local to: string
end

local record FsListCall
  local path: string
end

-- One owner exists for exactly one accepted uv_fs_* submission. Its native
-- request and read buffer share that allocation. Libuv copies path and uv_buf_t
-- arguments before returning; the closure retains the Task and write string.
local record uv_fs_t
  local handle: foreign uv_fs_t
  local const buffer: foreign char[]
  local callback: function (uv_fs_t): ()
end

foreign function uv_fs_cb(req: *uv_fs_t)
  local owner = ffi.uv_req_get_data(
      req as foreign *uv_req_t) as foreign *Udata
  local callback = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "uv_fs_t", "callback"))
  local L = ffi.uv_loop_get_data(req.loop) as foreign *lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as foreign UvNoargCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner)
  ffi.lua_settop(L, top)
end

local type FsResult = function (Task, uv_fs_t, integer, value): (value)

local function fs_open_flags(mode: string): integer
  if mode == "r" or mode == "rb" then return ffi.UV_FS_O_RDONLY end
  if mode == "w" or mode == "wb" then
    return ffi.UV_FS_O_WRONLY | ffi.UV_FS_O_CREAT |
           ffi.UV_FS_O_TRUNC
  end
  if mode == "a" or mode == "ab" then
    return ffi.UV_FS_O_WRONLY | ffi.UV_FS_O_CREAT |
           ffi.UV_FS_O_APPEND
  end
  if mode == "r+" or mode == "r+b" or mode == "rb+" then
    return ffi.UV_FS_O_RDWR
  end
  if mode == "w+" or mode == "w+b" or mode == "wb+" then
    return ffi.UV_FS_O_RDWR | ffi.UV_FS_O_CREAT |
           ffi.UV_FS_O_TRUNC
  end
  if mode == "a+" or mode == "a+b" or mode == "ab+" then
    return ffi.UV_FS_O_RDWR | ffi.UV_FS_O_CREAT |
           ffi.UV_FS_O_APPEND
  end
  raise "invalid file mode '" .. mode .. "'"
end

local function validate_file(file: foreign uv_file)
  if file < 0 then raise "File is closed" end
end

-- Process descriptors are not loop-owned handles. A negative value is the
-- local no-descriptor sentinel used by deferred cleanup after ownership moves.
local function close_descriptor(descriptor: foreign uv_file): integer
  if descriptor < 0 then return 0 end
  local request = foreign uv_fs_t.new()
  local status = ffi.uv_fs_close(nil, request, descriptor, nil)
  ffi.uv_fs_req_cleanup(request)
  return status
end

local function new_fs_request(task: Task,
                              operation: string,
                              keepalive: value,
                              success: FsResult,
                              read_size: integer): uv_fs_t
  accepting_work(task.runtime, operation)
  local callback = function (owner: uv_fs_t)
    local result = ffi.uv_fs_get_result(owner.handle) as integer
    complete_fs(task, owner, result, operation, keepalive, success)
  end
  local owner = (function (read_size: integer,
                           callback: function (uv_fs_t): ()): uv_fs_t
    if read_size >= 0 then
      return uv_fs_t(
          foreign uv_fs_t.new(), foreign char.new_array(read_size), callback)
    end
    return uv_fs_t(foreign uv_fs_t.new(), nil, callback)
  end)(read_size, callback)
  local request: foreign *uv_fs_t = owner.handle
  ffi.uv_req_set_data(request as foreign *uv_req_t,
                        owner as foreign *void)
  task.pending = owner
  return owner
end

local function submitted_fs_request(task: Task, owner: uv_fs_t,
                                    status: integer,
                                    operation: string): Immediate?
  if status < 0 then
    ffi.uv_fs_req_cleanup(owner.handle)
    task.pending = nil
    return immediate_error(status, operation)
  end
  -- The one-shot request owns the continuation through its callback. Logical
  -- Task cancellation is delivered by that callback too; cancelling the
  -- native filesystem work could suppress an accepted close or leave a
  -- successful resource-producing operation without an owner.
  return nil
end

local function stat_result(task: Task, owner: uv_fs_t, result: integer,
                           keepalive: value): value
  local statbuf = ffi.uv_fs_get_statbuf(owner.handle)
  local mode = statbuf.st_mode
  local file_type = mode & ffi.S_IFMT
  local kind = (function (file_type: foreign uint64_t): string
    if file_type == ffi.S_IFREG then return "file" end
    if file_type == ffi.S_IFDIR then return "directory" end
    if file_type == ffi.S_IFLNK then return "symlink" end
    return "other"
  end)(file_type)
  return FsStatResult(statbuf.st_size, kind, mode,
                          statbuf.st_dev as foreign lua_Integer,
                          statbuf.st_ino as foreign lua_Integer,
                          statbuf.st_mtim.tv_sec,
                          statbuf.st_mtim.tv_nsec)
end

local function list_result(task: Task, owner: uv_fs_t,
                           result: integer,
                           keepalive: value): value
  local names: {string} = {}
  local entry = foreign uv_dirent_t.new()
  while true do
    local status = ffi.uv_fs_scandir_next(owner.handle, entry)
    if status == ffi.UV_EOF then break end
    if status < 0 then
      raise make_error(status, "fs.list")
    end
    names[#names + 1] = entry.name as string
  end
  return names
end

local function unit_result(task: Task, owner: uv_fs_t, result: integer,
                           keepalive: value): value
  return nil
end

local function open_result(task: Task, owner: uv_fs_t, result: integer,
                           keepalive: value): value
  local descriptor = result as foreign uv_file
  local transferred = false
  defer if not transferred then
    check_status(close_descriptor(descriptor),
                 "fs.open.abandon.close")
  end
  if task.cancel_value then
    return nil
  end
  transferred = true
  return descriptor
end

local function read_result(task: Task, owner: uv_fs_t, result: integer,
                           keepalive: value): value
  if result == 0 then return nil end
  return bytes_string(owner.buffer, result)
end

local function write_result(task: Task, owner: uv_fs_t, result: integer,
                            keepalive: value): value
  return result
end

local function tmpname_result(task: Task, owner: uv_fs_t, result: integer,
                              keepalive: value): value
  local descriptor = result as foreign uv_file
  defer check_status(close_descriptor(descriptor),
                     "fs.tmpname.close")
  if task.cancel_value then
    return nil
  end
  return ffi.uv_fs_get_path(owner.handle) as string
end

local function complete_fs(task: Task, owner: uv_fs_t, result: integer,
                           operation: string, keepalive: value,
                           success: FsResult)
  local failed, payload = (function (
      task: Task, owner: uv_fs_t, result: integer, operation: string,
      keepalive: value, success: FsResult): (boolean, value)
    defer ffi.uv_fs_req_cleanup(owner.handle)
    if result < 0 then raise make_error(result, operation) end
    return false, success(task, owner, result, keepalive)
  catch
    return true, error
  end)(task, owner, result, operation, keepalive, success)
  resume_task_from_callback(task, failed, payload)
catch
  fail_task_at_callback_boundary(task, error, traceback)
end

local function FsOpenCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.open", nil, open_result, -1)
  local status = ffi.uv_fs_open {
    loop = task.runtime.loop,
    req = owner.handle,
    path = self.path,
    flags = self.flags as foreign int,
    mode = 438 as foreign int,
    cb = uv_fs_cb,
  }
  return submitted_fs_request(task, owner, status, "fs.open")
end

local function FsReadCall:dispatch(task: Task): Immediate?
  local descriptor = foreign uv_buf_t.new()
  -- Check the target's buffer length before allocating or rooting a request.
  descriptor.len = self.maximum
  local owner = new_fs_request(
      task, "fs.read", nil, read_result, self.maximum)
  descriptor.base = owner.buffer
  local status = ffi.uv_fs_read {
    loop = task.runtime.loop,
    req = owner.handle,
    file = self.file,
    bufs = descriptor,
    nbufs = 1,
    offset = -1,
    cb = uv_fs_cb,
  }
  return submitted_fs_request(task, owner, status, "fs.read")
end

local function FsWriteCall:dispatch(task: Task): Immediate?
  local descriptor = foreign uv_buf_t.new()
  local base: foreign *char = self.data
  descriptor.base = base + self.offset
  descriptor.len = #self.data - self.offset
  local owner = new_fs_request(
      task, "fs.write", self.data, write_result, -1)
  local status = ffi.uv_fs_write {
    loop = task.runtime.loop,
    req = owner.handle,
    file = self.file,
    bufs = descriptor,
    nbufs = 1,
    offset = -1,
    cb = uv_fs_cb,
  }
  return submitted_fs_request(task, owner, status, "fs.write")
end

local function FsFlushCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.flush", nil, unit_result, -1)
  local status = ffi.uv_fs_fsync(task.runtime.loop, owner.handle,
                                  self.file,
                                  uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.flush")
end

local function FsCloseCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.close", nil, unit_result, -1)
  local status = ffi.uv_fs_close(task.runtime.loop, owner.handle,
                                  self.file,
                                  uv_fs_cb)
  local immediate? = submitted_fs_request(
      task, owner, status, "fs.close")
  if not immediate then self.accepted = true end
  return immediate
end

local function FsStatCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.stat", nil, stat_result, -1)
  local status = ffi.uv_fs_stat(task.runtime.loop, owner.handle,
                                 self.path,
                                 uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.stat")
end

local function FsLstatCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.lstat", nil, stat_result, -1)
  local status = ffi.uv_fs_lstat(task.runtime.loop, owner.handle,
                                  self.path,
                                  uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.lstat")
end

local function FsTmpnameCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(
      task, "fs.tmpname", nil, tmpname_result, -1)
  local status = ffi.uv_fs_mkstemp(task.runtime.loop, owner.handle,
                                    self.path,
                                    uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.tmpname")
end

local function FsMkdirCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.mkdir", nil, unit_result, -1)
  local status = ffi.uv_fs_mkdir {
    loop = task.runtime.loop,
    req = owner.handle,
    path = self.path,
    mode = 511 as foreign int,
    cb = uv_fs_cb,
  }
  return submitted_fs_request(task, owner, status, "fs.mkdir")
end

local function FsUnlinkCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.unlink", nil, unit_result, -1)
  local status = ffi.uv_fs_unlink(task.runtime.loop, owner.handle,
                                   self.path,
                                   uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.unlink")
end

local function FsRmdirCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.rmdir", nil, unit_result, -1)
  local status = ffi.uv_fs_rmdir(task.runtime.loop, owner.handle,
                                  self.path,
                                  uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.rmdir")
end

local function FsRenameCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.rename", nil, unit_result, -1)
  local status = ffi.uv_fs_rename(task.runtime.loop, owner.handle,
                                   self.from, self.to,
                                   uv_fs_cb)
  return submitted_fs_request(task, owner, status, "fs.rename")
end

local function FsListCall:dispatch(task: Task): Immediate?
  local owner = new_fs_request(task, "fs.list", nil, list_result, -1)
  local status = ffi.uv_fs_scandir {
    loop = task.runtime.loop,
    req = owner.handle,
    path = self.path,
    flags = 0,
    cb = uv_fs_cb,
  }
  return submitted_fs_request(task, owner, status, "fs.list")
end

local function fs_open(path: string, mode: string): foreign uv_file
  return await(Call.fs_open(FsOpenCall(
      checked_text(path, "fs.open"), fs_open_flags(mode)))) as foreign uv_file
end

local function fs_read(file: foreign uv_file, max_bytes: integer): string?
  validate_file(file)
  return await(Call.fs_read(FsReadCall(file, max_bytes)))
end

local function fs_write(file: foreign uv_file, data: string,
                        offset: integer): integer
  validate_file(file)
  if #data == 0 then return 0 end
  return await(
      Call.fs_write(FsWriteCall(file, data, offset))) as integer
end

local function fs_flush(file: foreign uv_file)
  validate_file(file)
  await(Call.fs_flush(FsFlushCall(file)))
end

local function fs_close(operation: FsCloseCall)
  validate_file(operation.file)
  await(Call.fs_close(operation))
end

local function fs_stat(path: string):
    (integer, string, integer, integer, integer, integer, integer)
  local result = await(Call.fs_stat(FsStatCall(
      checked_text(path, "fs.stat")))) as FsStatResult
  return result.size, result.kind, result.mode, result.device, result.inode,
         result.modified_seconds, result.modified_nanoseconds
end

local function fs_lstat(path: string):
    (integer, string, integer, integer, integer, integer, integer)
  local result = await(Call.fs_lstat(FsLstatCall(
      checked_text(path, "fs.lstat")))) as FsStatResult
  return result.size, result.kind, result.mode, result.device, result.inode,
         result.modified_seconds, result.modified_nanoseconds
end

local function fs_tmpname(): string
  local template = fs_tmpname_template()
  return await(Call.fs_tmpname(FsTmpnameCall(
      checked_text(template, "fs.tmpname")))) as string
end

local function fs_mkdir(path: string)
  await(Call.fs_mkdir(FsMkdirCall(
      checked_text(path, "fs.mkdir"))))
end

local function fs_unlink(path: string)
  await(Call.fs_unlink(FsUnlinkCall(
      checked_text(path, "fs.unlink"))))
end

local function fs_rmdir(path: string)
  await(Call.fs_rmdir(FsRmdirCall(
      checked_text(path, "fs.rmdir"))))
end

local function fs_rename(from: string, to: string)
  checked_text(from, "fs.rename")
  checked_text(to, "fs.rename")
  await(Call.fs_rename(FsRenameCall(from, to)))
end

local function fs_list(path: string): {string}
  return await(Call.fs_list(FsListCall(
      checked_text(path, "fs.list")))) as {string}
end
