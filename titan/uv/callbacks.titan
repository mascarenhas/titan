-- Ordinary loop callbacks use standard Titan callable adaptation, including Lua.
--- Ordinary loop-thread callback for after work delivery.
-- @usage uv/types.md#after_work_cb
type after_work_cb = function (work_t, integer): ()
--- Ordinary loop-thread callback for async delivery.
