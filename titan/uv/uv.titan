function fs_chmod(loop: loop_t?, request: fs_t, path: string, mode: integer,
    callback: (function (fs_t): ())?): integer
  local native_mode = mode as foreign int
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
