local iteration = import "iteration"
foreign import "uv.h"
foreign import "lua.h"
foreign import "titan/ffi.h"
foreign import "callback.h"
foreign type CallbackEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata): void

local main_thread: foreign *lua_State = nil
local driving: loop_t? = nil
local inline_dispatch_depth: integer = 0
local walking_depth: integer = 0
local loops: {loop_t: boolean} = {}
local const HANDLE_FRESH = 0
local const HANDLE_LIVE = 1
local const HANDLE_RETIRED = 2

record loop_t
  local walk_callback: (function (handle_t, value): ())?
  local walk_argument: value
  local inline_depth: integer
  local walk_depth: integer
  local walk_handler: function (loop_t, foreign *uv_handle_t): ()
  local native: foreign uv_loop_t
  local state: foreign *lua_State
  local initialized: boolean
  local handles: {value: boolean}
  local requests: {value: boolean}
  local failure_count: integer
  local failure_error: value
  local failure_trace: string
  local secondary_errors: integer
  local userdata: value
end

record timer_t
  local native: foreign uv_timer_t
  local phase: integer
  local loop: loop_t?
  local callback: (function (timer_t): ())?
  local close_callback: (function (handle_t): ())?
  local handler: function (timer_t, loop_t): ()
  local close_handler: function (timer_t, loop_t): ()
  local userdata: value
end

union handle_t
  process(owner: process_t)
  tcp(owner: tcp_t)
  pipe(owner: pipe_t)
  tty(owner: tty_t)
  udp(owner: udp_t)
  fs_event(owner: fs_event_t)
  fs_poll(owner: fs_poll_t)
  timer(owner: timer_t)
  idle(owner: idle_t)
  prepare(owner: prepare_t)
  check(owner: check_t)
  async(owner: async_t)
  signal(owner: signal_t)
  poll(owner: poll_t)
end

local function current_main(): foreign *lua_State
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then raise "cannot reserve main lookup" end
  ffi.lua_rawgeti(L, ffi.LUA_REGISTRYINDEX,
                 ffi.LUA_RIDX_MAINTHREAD as foreign lua_Integer)
  return ffi.lua_tothread(L, -1)
end

function loop_t.new(): loop_t
  local native = foreign uv_loop_t.new()
  local owner: loop_t = {
    native = native,
    inline_depth = 0,
    walk_callback = nil, walk_argument = nil, walk_depth = 0, walk_handler = walk_deliver,
    state = main_thread,
    initialized = false,
    handles = {}, requests = {},
    failure_count = 0, failure_error = nil, failure_trace = "", secondary_errors = 0,
    userdata = nil,
  }
  return owner
end

function loop_init(loop: loop_t): integer
  if loop.initialized then return ffi.UV_EBUSY end
  loops[loop] = true
  local status = ffi.uv_loop_init(loop.native) as integer
  if status < 0 then loops[loop] = nil; return status end
  loop.initialized = true
  ffi.uv_loop_set_data(loop.native, loop as foreign *void)
  return status
end

function loop_close(loop: loop_t): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  if driving == loop or loop.walk_depth > 0 or loop.inline_depth > 0 then return ffi.UV_EBUSY end
  if iteration.next(loop.handles, nil) ~= nil or iteration.next(loop.requests, nil) ~= nil then
    return ffi.UV_EBUSY
  end
  local status = ffi.uv_loop_close(loop.native) as integer
  if status == 0 then loop.initialized = false; loops[loop] = nil end
  return status
end

function loop_alive(loop: loop_t): boolean
  if not loop.initialized then return false end
  return ffi.uv_loop_alive(loop.native) ~= 0
end

local function rethrow(loop: loop_t)
  if loop.failure_count == 0 then return end
  local err = loop.failure_error
  local trace = loop.failure_trace
  loop.secondary_errors = loop.failure_count - 1
  loop.failure_count = 0
  loop.failure_error = false
  loop.failure_trace = ""
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 2) == 0 then raise "cannot reserve error handoff" end
  ffi.lua_pushtvalue(L, trace)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
  ffi.lua_pushboolean(L, 1)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
  raise err
end

function run(loop: loop_t, mode: run_mode?): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  if L ~= main_thread then raise "uv.run requires the owning main Lua thread" end
  if driving or walking_depth > 0 or inline_dispatch_depth > 0 then raise "uv.run cannot reenter the event loop" end
  if ffi.lua_checkstack(L, ffi.LUA_MINSTACK) == 0 then
    raise "cannot reserve native callback stack"
  end
  local native_mode = ffi.UV_RUN_DEFAULT
  case mode or RUN_DEFAULT
  when default() then native_mode = ffi.UV_RUN_DEFAULT
  when once() then native_mode = ffi.UV_RUN_ONCE
  when nowait() then native_mode = ffi.UV_RUN_NOWAIT
  end
  driving = loop
  defer do driving = nil end
  loop.secondary_errors = 0
  local result = ffi.uv_run(loop.native, native_mode) as integer
  rethrow(loop)
  return result
end


function loop_t:secondary_error_count(): integer
  return self.secondary_errors
end

local function timer_deliver(owner: timer_t, loop: loop_t)
  local callback? = owner.callback
  if callback ~= nil then callback(owner) end
catch
  -- No allocating Titan helper entry may run outside this catch boundary.
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function timer_closed(owner: timer_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  local callback? = owner.close_callback
  owner.callback = nil
  owner.close_callback = nil
  if callback ~= nil then callback(handle_t.timer(owner)) end
catch
  -- No allocating Titan helper entry may run outside this catch boundary.
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign function timer_callback(native: *uv_timer_t)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "timer_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

foreign function timer_close_callback(base: *uv_handle_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "timer_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  -- Exact Udata conversion is rooted before the handler retires its old map key.
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

function timer_t.new(): timer_t
  local native = foreign uv_timer_t.new()
  return {
    native = native,
    phase = HANDLE_FRESH, loop = nil,
    callback = nil, close_callback = nil,
    handler = timer_deliver, close_handler = timer_closed, userdata = nil,
  }
end

function timer_t:as_handle_t(): handle_t
  return handle_t.timer(self)
end

function timer_init(loop: loop_t, timer: timer_t): integer
  if not loop.initialized or timer.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  loop.handles[timer] = true
  timer.loop = loop
  local status = ffi.uv_timer_init(loop.native, timer.native) as integer
  if status < 0 then loop.handles[timer] = nil; timer.loop = nil; return status end
  timer.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(timer.native as foreign *uv_handle_t, timer as foreign *void)
  return status
end

function timer_start(timer: timer_t, callback: function (timer_t): (),
                     timeout: integer, repeat_ms: integer): integer
  if timer.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(timer.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  if timeout < 0 or repeat_ms < 0 then return ffi.UV_EINVAL end
  timer.callback = callback
  return ffi.uv_timer_start(timer.native, timer_callback,
                           timeout as foreign uint64_t,
                           repeat_ms as foreign uint64_t)
end

function timer_stop(timer: timer_t): integer
  if timer.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  return ffi.uv_timer_stop(timer.native)
end

function close(handle: handle_t, callback: (function (handle_t): ())?)
  case handle
  when timer(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, timer_close_callback)
  when process(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, process_close_callback)
  when tcp(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, tcp_close_callback)
  when pipe(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, pipe_close_callback)
  when tty(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, tty_close_callback)
  when udp(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, udp_close_callback)
  when fs_event(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, fs_event_close_callback)
  when fs_poll(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, fs_poll_close_callback)
  when idle(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, idle_close_callback)
  when prepare(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, prepare_close_callback)
  when check(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, check_close_callback)
  when async(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, async_close_callback)
  when signal(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, signal_close_callback)
  when poll(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    local native = owner.native as foreign *uv_handle_t
    if ffi.uv_is_closing(native) ~= 0 then raise "handle is closing" end
    owner.close_callback = callback
    ffi.uv_close(native, poll_close_callback)
  end
end

function unref(handle: handle_t)
  case handle
  when timer(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when process(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when tcp(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when pipe(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when tty(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when udp(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when fs_event(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when fs_poll(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when idle(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when prepare(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when check(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when async(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when signal(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  when poll(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    ffi.uv_unref(owner.native as foreign *uv_handle_t)
  end
end

record fs_t
  local native: foreign uv_fs_t
  local loop: loop_t?
  local pending: boolean
  local dirty: boolean
  local path: string?
  local new_path: string?
  local directory: dir_t?
  local native_dirents: (owned uv_dirent_t[])?
  local buffers: {buf_t}?
  local native_buffers: (owned uv_buf_t[])?
  local callback: (function (fs_t): ())?
  local handler: function (fs_t, loop_t): ()
  local userdata: value
end

union req_t
  connect(owner: connect_t)
  write(owner: write_t)
  shutdown(owner: shutdown_t)
  udp_send(owner: udp_send_t)
  getaddrinfo(owner: getaddrinfo_t)
  getnameinfo(owner: getnameinfo_t)
  fs(owner: fs_t)
  work(owner: work_t)
  random(owner: random_t)
end

record timespec_t
  tv_sec: integer
  tv_nsec: integer
end

record stat_t
  st_dev: integer
  st_mode: integer
  st_nlink: integer
  st_uid: integer
  st_gid: integer
  st_rdev: integer
  st_ino: integer
  st_size: integer
  st_blksize: integer
  st_blocks: integer
  st_flags: integer
  st_gen: integer
  st_atim: timespec_t
  st_mtim: timespec_t
  st_ctim: timespec_t
  st_birthtim: timespec_t
end

local function fs_deliver(owner: fs_t, loop: loop_t)
  local directory? = owner.directory
  if directory ~= nil then
    local kind = ffi.uv_fs_get_type(owner.native)
    if kind == ffi.UV_FS_OPENDIR then
      if ffi.uv_fs_get_result(owner.native) >= 0 then
        directory.native = ffi.uv_fs_get_ptr(owner.native) as foreign *uv_dir_t
      end
    elseif kind == ffi.UV_FS_CLOSEDIR then
      if ffi.uv_fs_get_result(owner.native) >= 0 then directory.native = nil end
      directory.busy = false
    end
  end
  loop.requests[owner] = nil
  owner.pending = false
  local callback? = owner.callback
  owner.callback = nil
  if callback ~= nil then callback(owner) end
catch
  -- No allocating Titan helper entry may run outside this catch boundary.
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign function fs_callback(native: *uv_fs_t)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(native.loop) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "fs_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

function fs_t.new(): fs_t
  local native = foreign uv_fs_t.new()
  native.fs_type = ffi.UV_FS_UNKNOWN
  return {
    native = native, loop = nil, pending = false, dirty = false, path = nil, new_path = nil, directory = nil, native_dirents = nil, buffers = nil, native_buffers = nil,
    callback = nil, handler = fs_deliver, userdata = nil,
  }
end

function fs_t:as_req_t(): req_t
  return req_t.fs(self)
end

function req_t:get_data(): value
  case self
  when connect(owner) then return owner.userdata
  when write(owner) then return owner.userdata
  when shutdown(owner) then return owner.userdata
  when udp_send(owner) then return owner.userdata
  when getaddrinfo(owner) then return owner.userdata
  when getnameinfo(owner) then return owner.userdata
  when fs(owner) then return owner.userdata
  when work(owner) then return owner.userdata
  when random(owner) then return owner.userdata
  end
end

function req_t:set_data(data: value)
  case self
  when connect(owner) then owner.userdata = data
  when write(owner) then owner.userdata = data
  when shutdown(owner) then owner.userdata = data
  when udp_send(owner) then owner.userdata = data
  when getaddrinfo(owner) then owner.userdata = data
  when getnameinfo(owner) then owner.userdata = data
  when fs(owner) then owner.userdata = data
  when work(owner) then owner.userdata = data
  when random(owner) then owner.userdata = data
  end
end

function cancel(request: req_t): integer
  case request
  when connect() then return ffi.UV_EINVAL
  when write() then return ffi.UV_EINVAL
  when shutdown() then return ffi.UV_EINVAL
  when udp_send() then return ffi.UV_EINVAL
  when getaddrinfo(owner) then
    if not owner.pending then return ffi.UV_EINVAL end
    return ffi.uv_cancel(owner.native as foreign *uv_req_t)
  when getnameinfo(owner) then
    if not owner.pending then return ffi.UV_EINVAL end
    return ffi.uv_cancel(owner.native as foreign *uv_req_t)
  when fs(owner) then
    if not owner.pending then return ffi.UV_EINVAL end
    return ffi.uv_cancel(owner.native as foreign *uv_req_t)
  when work(owner) then
    if not owner.pending then return ffi.UV_EINVAL end
    local native = owner.native as foreign *uv_work_t
    return ffi.uv_cancel(native as foreign *uv_req_t)
  when random(owner) then
    if not owner.pending then return ffi.UV_EINVAL end
    return ffi.uv_cancel(owner.native as foreign *uv_req_t)
  end
end

local function fs_prepare(loop: loop_t?, request: fs_t,
                           callback: (function (fs_t): ())?, path: string?):
    (integer, foreign *uv_loop_t, foreign uv_fs_cb)
  if request.pending or request.dirty then return ffi.UV_EBUSY, nil, nil end
  local native_loop: foreign *uv_loop_t = nil
  local native_callback: foreign uv_fs_cb = nil
  if loop then native_loop = loop.native end
  if callback ~= nil then
    if not loop or not loop.initialized then return ffi.UV_EINVAL, nil, nil end
    native_callback = fs_callback
    -- All potentially allocating setup precedes native acceptance.
    loop.requests[request] = true
    request.pending = true
  end
  request.loop = loop
  request.path = path
  request.callback = callback
  request.dirty = true
  ffi.uv_req_set_data(request.native as foreign *uv_req_t,
                      request as foreign *void)
  return 0, native_loop, native_callback
end

function fs_stat(loop: loop_t?, request: fs_t, path: string,
                  callback: (function (fs_t): ())?): integer
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  local result = ffi.uv_fs_stat(
      native_loop, request.native, path, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

function fs_open(loop: loop_t?, request: fs_t, path: string,
                  flags: integer, mode: integer,
                  callback: (function (fs_t): ())?): integer
  local native_flags = flags as foreign int
  local native_mode = mode as foreign int
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  local result = ffi.uv_fs_open(
      native_loop, request.native, path, native_flags,
      native_mode, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

function fs_close(loop: loop_t?, request: fs_t, file: integer,
                   callback: (function (fs_t): ())?): integer
  local native_file = file as foreign uv_file
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  local result = ffi.uv_fs_close(
      native_loop, request.native, native_file,
      native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

function fs_get_result(request: fs_t): integer
  if request.pending then raise "FS request is pending" end
  return ffi.uv_fs_get_result(request.native)
end

function fs_get_statbuf(request: fs_t): stat_t
  if request.pending or not request.dirty then raise "FS result is unavailable" end
  if ffi.uv_fs_get_result(request.native) < 0 then raise "FS stat request failed" end
  local kind = ffi.uv_fs_get_type(request.native)
  if kind ~= ffi.UV_FS_STAT and kind ~= ffi.UV_FS_FSTAT and kind ~= ffi.UV_FS_LSTAT then
    raise "FS request has no stat result"
  end
  local native = ffi.uv_fs_get_statbuf(request.native)
  return stat_copy(native)
end

function fs_get_path(request: fs_t): string?
  if request.pending then raise "FS request is pending" end
  if not request.dirty then return nil end
  local path = ffi.uv_fs_get_path(request.native)
  if not path then return nil end
  return path as string
end

function fs_req_cleanup(request: fs_t)
  if request.pending then raise "FS request is pending" end
  if not request.dirty then return end
  local kind = ffi.uv_fs_get_type(request.native)
  local directory? = request.directory
  -- Cancelled CLOSEDIR never consumed the separately owned directory. Unix
  -- cleanup otherwise frees req.ptr blindly; detach it before request cleanup.
  if kind == ffi.UV_FS_CLOSEDIR then request.native.ptr = nil end
  ffi.uv_fs_req_cleanup(request.native)
  if directory ~= nil and kind == ffi.UV_FS_READDIR then
    directory.native.dirents = nil
    directory.native.nentries = 0
    directory.busy = false
  end
  request.directory = nil
  request.native_dirents = nil
  request.new_path = nil
  request.dirty = false
  request.path = nil
  request.buffers = nil
  request.native_buffers = nil
end

const FS_O_RDONLY: integer?
const FS_O_RDWR: integer?
const FS_O_WRONLY: integer?
const FS_O_CREAT: integer?
const FS_O_TRUNC: integer?

foreign import "work-native-proposal.h"
foreign type WorkFunction = function (*void): void
foreign type WorkCallbackEntry = function (
    *lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer): void

record work_t
  local native: foreign titan_issue194_work_storage
  local loop: loop_t?
  local pending: boolean
  local argument_owner: value
  local callback: (function (work_t, integer): ())?
  local handler: function (work_t, loop_t, integer): ()
  local userdata: value
end


local function work_deliver(owner: work_t, loop: loop_t, status: integer)
  -- Native work has completed. Retire exactly the old registration before
  -- user code can resubmit this owner, possibly on a different loop.
  loop.requests[owner] = nil
  owner.pending = false
  local _argument_owner = owner.argument_owner
  owner.argument_owner = nil
  local callback? = owner.callback
  owner.callback = nil
  owner.native.worker = nil
  owner.native.arg = nil
  -- The old argument graph stays in this handler frame through user delivery;
  -- request reuse may independently install a new graph.
  if callback ~= nil then callback(owner, status) end
catch
  -- This is the originating loop, even if the callback requeued owner.
  -- No allocating Titan helper entry may run outside this catch boundary.
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign function work_worker_callback(request: *uv_work_t)
  -- request is the first member of the final embedded native storage.
  -- Only native fields are read; no Lua/Titan/GC or req.data access occurs.
  local storage = request as foreign *titan_issue194_work_storage
  local worker = storage.worker
  worker(storage.arg)
end

foreign function work_after_callback(request: *uv_work_t, status: int)
  local owner = ffi.uv_req_get_data(
      request as foreign *uv_req_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(request.loop) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "work_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign WorkCallbackEntry
  local top = ffi.lua_gettop(L)
  -- Root the exact concrete userdata before work_deliver removes its map key.
  -- Never leave a trailing root deletion or field clear after user delivery.
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

function work_t.new(): work_t
  -- Construct final packed owner before libuv receives any address. No
  -- initialized uv_work_t is copied or moved between Titan owners.
  local native = foreign titan_issue194_work_storage.new()
  return {
    native = native,
    loop = nil, pending = false, callback = nil, argument_owner = nil,
    handler = work_deliver, userdata = nil,
  }
end

function work_t:as_req_t(): req_t
  return req_t.work(self)
end

function work_t:get_loop(): loop_t?
  return self.loop
end

function queue_work(loop: loop_t, req: work_t, worker: foreign function (*void): void,
                    arg: foreign *void,
                    after_work: (function (work_t, integer): ())?,
                    argument_owner: value): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  if req.pending then return ffi.UV_EBUSY end
  -- The internal callback is always nonnull, so reject a null public worker
  -- here to retain libuv's invalid-worker contract.
  if not worker then return ffi.UV_EINVAL end

  -- All allocations and callable adjustments precede acceptance. The map
  -- insertion is first: allocation failure leaves this request unmodified.
  local previous_loop? = req.loop
  loop.requests[req] = true
  req.loop = loop
  req.pending = true
  req.callback = after_work
  req.argument_owner = argument_owner
  req.native.worker = worker
  req.native.arg = arg
  local native = req.native as foreign *uv_work_t
  ffi.uv_req_set_data(native as foreign *uv_req_t, req as foreign *void)
  local status = ffi.uv_queue_work(
      loop.native, native, work_worker_callback, work_after_callback) as integer
  if status ~= 0 then
    -- Rejection promises no native callback. There is no concurrently accepted
    -- worker touching this storage on this branch.
    loop.requests[req] = nil
    req.pending = false
    req.loop = previous_loop
    req.callback = nil
    req.argument_owner = nil
    req.native.worker = nil
    req.native.arg = nil
  end
  return status
end


function req_get_data(req: req_t): value
  return req:get_data()
end

function req_set_data(req: req_t, data: value)
  req:set_data(data)
end

foreign import "limits.h"

record buf_t
  local native: foreign uv_buf_t
  local const storage: foreign char[]
  local keepalive: value
  local writable: boolean
end

function buf_t.allocate(capacity: integer): buf_t
  if capacity < 0 or capacity > ffi.UINT_MAX as integer then
    raise "buffer capacity is outside native range"
  end
  local owner = buf_t(foreign uv_buf_t.new(),
                      foreign char.new_array(capacity), nil, true)
  owner.native = ffi.uv_buf_init(owner.storage, capacity as foreign unsigned int)
  return owner
end

function buf_init(base: string, length: integer): buf_t
  if length < 0 or length > #base or length > ffi.UINT_MAX as integer then
    raise "buffer length is outside string/native range"
  end
  local owner = buf_t(foreign uv_buf_t.new(), nil, base, false)
  owner.native = ffi.uv_buf_init(base as foreign *char,
                                length as foreign unsigned int)
  return owner
end

function buf_t.from_string(base: string): buf_t
  return buf_init(base, #base)
end

function buf_t:length(): integer
  return self.native.len as integer
end

function buf_t:is_writable(): boolean
  return self.writable
end

-- Indices are one-based like ordinary Titan byte/Array APIs. A slice retains
-- its original allocation/string transitively; it never rewrites that owner.
function buf_t:slice(first: integer, length: integer): buf_t
  local capacity = self.native.len as integer
  if first < 1 or length < 0 or first - 1 > capacity - length then
    raise "buffer slice is out of bounds"
  end
  local owner = buf_t(foreign uv_buf_t.new(), nil, self, self.writable)
  owner.native = ffi.uv_buf_init(
      self.native.base + (first - 1) as foreign ptrdiff_t,
      length as foreign unsigned int)
  return owner
end

function buf_t:get(index: integer): integer
  if index < 1 or index > self.native.len as integer then
    raise "buffer index is out of bounds"
  end
  local bytes = self.native.base as foreign *unsigned char
  return bytes[index - 1] as integer
end

function buf_t:set(index: integer, byte: integer)
  if not self.writable then raise "buffer is read-only" end
  if index < 1 or index > self.native.len as integer or byte < 0 or byte > 255 then
    raise "buffer byte/index is out of bounds"
  end
  local bytes = self.native.base as foreign *unsigned char
  bytes[index - 1] = byte as foreign unsigned char
end

function buf_t:to_string(length: integer): string
  if length < 0 or length > self.native.len as integer then
    raise "buffer string length is out of bounds"
  end
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then raise "cannot reserve buffer copy stack" end
  ffi.lua_pushlstring(L, self.native.base, length as foreign size_t)
  local result: value = ffi.lua_totvalue(L, -1)
  return result as string
end

local function fs_buffer_snapshot(buffers: {buf_t}, writable: boolean):
    (integer, (owned uv_buf_t[])?, {buf_t}?)
  local count = #buffers
  if count > ffi.UINT_MAX as integer then return ffi.UV_EINVAL, nil, nil end
  local native = foreign uv_buf_t.new_array(count)
  local retained: {buf_t} = {}
  for i = 1, count do
    local buffer = buffers[i]
    if writable and not buffer.writable then return ffi.UV_EINVAL, nil, nil end
    native[i - 1] = buffer.native[0]
    retained[i] = buffer
  end
  return 0, native, retained
end

function fs_read(loop: loop_t?, request: fs_t, file: integer,
                  buffers: {buf_t}, offset: integer,
                  callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty then return ffi.UV_EBUSY end
  local prepared, native?, retained? = fs_buffer_snapshot(buffers, true)
  if prepared < 0 then return prepared end
  local native_data = (native as owned uv_buf_t[]) as foreign *uv_buf_t
  local count = #(retained as {buf_t})
  local native_file = file as foreign uv_file
  local native_offset = offset as foreign int64_t
  local native_count = count as foreign unsigned int
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  request.buffers = retained
  request.native_buffers = native
  local result = ffi.uv_fs_read(native_loop, request.native,
      native_file, native_data,
      native_count, native_offset,
      native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

function fs_write(loop: loop_t?, request: fs_t, file: integer,
                   buffers: {buf_t}, offset: integer,
                   callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty then return ffi.UV_EBUSY end
  local prepared, native?, retained? = fs_buffer_snapshot(buffers, false)
  if prepared < 0 then return prepared end
  local native_data = (native as owned uv_buf_t[]) as foreign *uv_buf_t
  local count = #(retained as {buf_t})
  local native_file = file as foreign uv_file
  local native_offset = offset as foreign int64_t
  local native_count = count as foreign unsigned int
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  request.buffers = retained
  request.native_buffers = native
  local result = ffi.uv_fs_write(native_loop, request.native,
      native_file, native_data,
      native_count, native_offset,
      native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

union run_mode
  default()
  once()
  nowait()
end
const RUN_DEFAULT = run_mode.default()
const RUN_ONCE = run_mode.once()
const RUN_NOWAIT = run_mode.nowait()

union loop_option
  block_signal()
  metrics_idle_time()
  use_io_uring_sqpoll()
end

record metrics_t
  loop_count: integer
  events: integer
  events_waiting: integer
end

local function loop_require(loop: loop_t)
  if not loop.initialized then raise "loop is not initialized" end
end

function loop_size(): integer
  return ffi.uv_loop_size() as foreign lua_Integer
end

function loop_configure(loop: loop_t, option: loop_option, signum: integer?): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  case option
  when block_signal() then
    if signum == nil then return ffi.UV_EINVAL end
    return ffi.uv_loop_configure(loop.native, ffi.UV_LOOP_BLOCK_SIGNAL,
                                 signum as foreign int)
  when metrics_idle_time() then
    return ffi.uv_loop_configure(loop.native, ffi.UV_METRICS_IDLE_TIME)
  when use_io_uring_sqpoll() then
    return ffi.uv_loop_configure(loop.native, ffi.UV_LOOP_USE_IO_URING_SQPOLL as foreign uv_loop_option)
  end
end

function loop_fork(loop: loop_t): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  return ffi.uv_loop_fork(loop.native)
end

function stop(loop: loop_t)
  loop_require(loop)
  ffi.uv_stop(loop.native)
end

function update_time(loop: loop_t)
  loop_require(loop)
  ffi.uv_update_time(loop.native)
end

function now(loop: loop_t): integer
  loop_require(loop)
  return ffi.uv_now(loop.native) as foreign lua_Integer
end

function backend_fd(loop: loop_t): integer
  loop_require(loop)
  return ffi.uv_backend_fd(loop.native)
end

function backend_timeout(loop: loop_t): integer
  loop_require(loop)
  return ffi.uv_backend_timeout(loop.native)
end

function loop_get_data(loop: loop_t): value
  return loop.userdata
end

function loop_set_data(loop: loop_t, data: value)
  loop.userdata = data
end

function metrics_idle_time(loop: loop_t): integer
  loop_require(loop)
  return ffi.uv_metrics_idle_time(loop.native) as foreign lua_Integer
end

function metrics_info(loop: loop_t): (integer, metrics_t?)
  if not loop.initialized then return ffi.UV_EINVAL, nil end
  local native = foreign uv_metrics_t.new()
  local status: integer = ffi.uv_metrics_info(loop.native, native)
  if status < 0 then return status, nil end
  return status, metrics_t(native.loop_count as foreign lua_Integer,
                            native.events as foreign lua_Integer,
                            native.events_waiting as foreign lua_Integer)
end

local function handle_native(handle: handle_t): foreign *uv_handle_t
  case handle
  when timer(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when process(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when tcp(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when pipe(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when tty(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when udp(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when fs_event(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when fs_poll(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when idle(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when prepare(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when check(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when async(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when signal(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  when poll(owner) then
    if owner.phase ~= HANDLE_LIVE then raise "handle is not initialized" end
    return owner.native as foreign *uv_handle_t
  end
end

local function handle_t:pointer(): foreign *uv_handle_t
  case self
  when timer(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when process(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when tcp(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when pipe(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when tty(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when udp(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when fs_event(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when fs_poll(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when idle(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when prepare(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when check(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when async(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when signal(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  when poll(owner) then
    if owner.phase ~= HANDLE_LIVE then return nil end
    return owner.native as foreign *uv_handle_t
  end
end

function handle_t:is_initialized(): boolean
  -- Native initialization can establish a close obligation even when an
  -- operation reports failure. Closing remains initialized until its callback.
  return self:pointer() ~= nil
end

function handle_get_data(handle: handle_t): value
  case handle
  when timer(owner) then return owner.userdata
  when process(owner) then return owner.userdata
  when tcp(owner) then return owner.userdata
  when pipe(owner) then return owner.userdata
  when tty(owner) then return owner.userdata
  when udp(owner) then return owner.userdata
  when fs_event(owner) then return owner.userdata
  when fs_poll(owner) then return owner.userdata
  when idle(owner) then return owner.userdata
  when prepare(owner) then return owner.userdata
  when check(owner) then return owner.userdata
  when async(owner) then return owner.userdata
  when signal(owner) then return owner.userdata
  when poll(owner) then return owner.userdata
  end
end

function handle_set_data(handle: handle_t, data: value)
  case handle
  when timer(owner) then owner.userdata = data
  when process(owner) then owner.userdata = data
  when tcp(owner) then owner.userdata = data
  when pipe(owner) then owner.userdata = data
  when tty(owner) then owner.userdata = data
  when udp(owner) then owner.userdata = data
  when fs_event(owner) then owner.userdata = data
  when fs_poll(owner) then owner.userdata = data
  when idle(owner) then owner.userdata = data
  when prepare(owner) then owner.userdata = data
  when check(owner) then owner.userdata = data
  when async(owner) then owner.userdata = data
  when signal(owner) then owner.userdata = data
  when poll(owner) then owner.userdata = data
  end
end

function handle_get_loop(handle: handle_t): loop_t
  case handle
  when timer(owner) then return owner.loop as loop_t
  when process(owner) then return owner.loop as loop_t
  when tcp(owner) then return owner.loop as loop_t
  when pipe(owner) then return owner.loop as loop_t
  when tty(owner) then return owner.loop as loop_t
  when udp(owner) then return owner.loop as loop_t
  when fs_event(owner) then return owner.loop as loop_t
  when fs_poll(owner) then return owner.loop as loop_t
  when idle(owner) then return owner.loop as loop_t
  when prepare(owner) then return owner.loop as loop_t
  when check(owner) then return owner.loop as loop_t
  when async(owner) then return owner.loop as loop_t
  when signal(owner) then return owner.loop as loop_t
  when poll(owner) then return owner.loop as loop_t
  end
end

function ref(handle: handle_t)
  ffi.uv_ref(handle_native(handle))
end

function has_ref(handle: handle_t): boolean
  return ffi.uv_has_ref(handle_native(handle)) ~= 0
end

function is_active(handle: handle_t): boolean
  return ffi.uv_is_active(handle_native(handle)) ~= 0
end

function is_closing(handle: handle_t): boolean
  return ffi.uv_is_closing(handle_native(handle)) ~= 0
end

function send_buffer_size(handle: handle_t, size: integer): (integer, integer)
  local native_size = size as foreign int
  local status: integer = ffi.uv_send_buffer_size(handle_native(handle), native_size)
  return status, native_size
end

function recv_buffer_size(handle: handle_t, size: integer): (integer, integer)
  local native_size = size as foreign int
  local status: integer = ffi.uv_recv_buffer_size(handle_native(handle), native_size)
  return status, native_size
end

function timer_again(timer: timer_t): integer
  if timer.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(timer.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  return ffi.uv_timer_again(timer.native)
end

function timer_set_repeat(timer: timer_t, repeat_ms: integer)
  if timer.phase ~= HANDLE_LIVE then raise "timer is not initialized" end
  ffi.uv_timer_set_repeat(timer.native, repeat_ms as foreign uint64_t)
end

function timer_get_repeat(timer: timer_t): integer
  if timer.phase ~= HANDLE_LIVE then raise "timer is not initialized" end
  return ffi.uv_timer_get_repeat(timer.native) as foreign lua_Integer
end

function timer_get_due_in(timer: timer_t): integer
  if timer.phase ~= HANDLE_LIVE then raise "timer is not initialized" end
  return ffi.uv_timer_get_due_in(timer.native) as foreign lua_Integer
end

local function handle_from_native(native: foreign *uv_handle_t): handle_t
  local owner = ffi.uv_handle_get_data(native) as foreign *Udata
  local boxed: value = owner
  if ffi.uv_handle_get_type(native) == ffi.UV_TIMER then
    return handle_t.timer(boxed as timer_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_IDLE then
    return handle_t.idle(boxed as idle_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_PREPARE then
    return handle_t.prepare(boxed as prepare_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_CHECK then
    return handle_t.check(boxed as check_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_ASYNC then
    return handle_t.async(boxed as async_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_SIGNAL then
    return handle_t.signal(boxed as signal_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_POLL then
    return handle_t.poll(boxed as poll_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_FS_EVENT then
    return handle_t.fs_event(boxed as fs_event_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_FS_POLL then
    return handle_t.fs_poll(boxed as fs_poll_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_TCP then
    return handle_t.tcp(boxed as tcp_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_NAMED_PIPE then
    return handle_t.pipe(boxed as pipe_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_TTY then
    return handle_t.tty(boxed as tty_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_UDP then
    return handle_t.udp(boxed as udp_t)
  end
  if ffi.uv_handle_get_type(native) == ffi.UV_PROCESS then return handle_t.process(boxed as process_t) end
  raise "unsupported native handle type"
end

local function walk_deliver(loop: loop_t, native: foreign *uv_handle_t)
  local callback = loop.walk_callback as function (handle_t, value): ()
  callback(handle_from_native(native), loop.walk_argument)
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign type WalkEntry = function (*lua_State, *Udata, *CClosure, *Udata, *uv_handle_t): void
foreign function walk_callback(native: *uv_handle_t, arg: *void)
  local loop = arg as foreign *Udata
  local owner = ffi.uv_handle_get_data(native) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(loop, "loop_t", "walk_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign WalkEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, loop, native)
  ffi.lua_settop(L, top)
end

function walk(loop: loop_t, callback: function (handle_t, value): (), arg: value)
  loop_require(loop)
  if L ~= main_thread then raise "uv.walk requires the owning main Lua thread" end
  if ffi.lua_checkstack(L, ffi.LUA_MINSTACK) == 0 then raise "cannot reserve native callback stack" end
  local saved_callback? = loop.walk_callback
  local saved_argument = loop.walk_argument
  local saved_count = loop.failure_count
  local saved_error = loop.failure_error
  local saved_trace = loop.failure_trace
  defer do
    loop.walk_depth = loop.walk_depth - 1
    walking_depth = walking_depth - 1
    loop.walk_callback = saved_callback
    loop.walk_argument = saved_argument
    loop.failure_count = saved_count
    loop.failure_error = saved_error
    loop.failure_trace = saved_trace
  end
  loop.walk_callback = callback
  loop.walk_argument = arg
  loop.failure_count = 0
  loop.failure_error = nil
  loop.failure_trace = ""
  loop.walk_depth = loop.walk_depth + 1
  walking_depth = walking_depth + 1
  ffi.uv_walk(loop.native, walk_callback, loop as foreign *void)
  rethrow(loop)
end

