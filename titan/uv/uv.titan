  else native_uid = uid as foreign uv_uid_t end
  local native_gid: foreign uv_gid_t = 0
  if gid == -1 then native_gid = (-1 as foreign int) as foreign uv_gid_t
  else native_gid = gid as foreign uv_gid_t end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  local result = ffi.uv_fs_fchown(native_loop, request.native, native_file, native_uid, native_gid, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
