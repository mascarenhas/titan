--- Change owner/group IDs on the named path, following symbolic links.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; FS submissions also require prior cleanup; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param path Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param uid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param gid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/fs.md#fs_chown
function fs_chown(loop: loop_t?, request: fs_t, path: string, uid: integer, gid: integer,
    callback: (function (fs_t): ())?): integer
  local native_uid: foreign uv_uid_t = 0
  if uid == -1 then native_uid = (-1 as foreign int) as foreign uv_uid_t
  else native_uid = uid as foreign uv_uid_t end
  local native_gid: foreign uv_gid_t = 0
  if gid == -1 then native_gid = (-1 as foreign int) as foreign uv_gid_t
  else native_gid = gid as foreign uv_gid_t end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  local result = ffi.uv_fs_chown(native_loop, request.native, path, native_uid, native_gid, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

--- Change owner/group IDs on the symbolic link itself rather than its target.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; FS submissions also require prior cleanup; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param path Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param uid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param gid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/fs.md#fs_lchown
function fs_lchown(loop: loop_t?, request: fs_t, path: string, uid: integer, gid: integer,
    callback: (function (fs_t): ())?): integer
  local native_uid: foreign uv_uid_t = 0
  if uid == -1 then native_uid = (-1 as foreign int) as foreign uv_uid_t
  else native_uid = uid as foreign uv_uid_t end
  local native_gid: foreign uv_gid_t = 0
  if gid == -1 then native_gid = (-1 as foreign int) as foreign uv_gid_t
  else native_gid = gid as foreign uv_gid_t end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  local result = ffi.uv_fs_lchown(native_loop, request.native, path, native_uid, native_gid, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

--- Change owner/group IDs through an open descriptor.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; FS submissions also require prior cleanup; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param file Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param uid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param gid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/fs.md#fs_fchown
function fs_fchown(loop: loop_t?, request: fs_t, file: integer, uid: integer, gid: integer,
    callback: (function (fs_t): ())?): integer
  local native_file = file as foreign uv_file
  local native_uid: foreign uv_uid_t = 0
  if uid == -1 then native_uid = (-1 as foreign int) as foreign uv_uid_t
  else native_uid = uid as foreign uv_uid_t end
  local native_gid: foreign uv_gid_t = 0
  if gid == -1 then native_gid = (-1 as foreign int) as foreign uv_gid_t
  else native_gid = gid as foreign uv_gid_t end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  local result = ffi.uv_fs_fchown(native_loop, request.native, native_file, native_uid, native_gid, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

--- Open a directory and return it through the completed request's typed directory result.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; FS submissions also require prior cleanup; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param path Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/fs.md#fs_opendir
function fs_opendir(loop: loop_t?, request: fs_t, path: string,
    callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty then return ffi.UV_EBUSY end
  -- Preallocate the public owner before native code can allocate a directory.
  local directory = dir_t.new()
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  request.directory = directory
  local result = ffi.uv_fs_opendir(native_loop, request.native, path, native_callback) as integer
  if callback == nil and result >= 0 then
    directory.native = ffi.uv_fs_get_ptr(request.native) as foreign *uv_dir_t
  end
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

--- Read up to capacity entries from an open directory.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; FS submissions also require prior cleanup; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param directory Mutable open directory owner from fs_opendir; readdir borrows it through fs_req_cleanup, closedir separately disposes it on success.
-- @param capacity Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/fs.md#fs_readdir
function fs_readdir(loop: loop_t?, request: fs_t, directory: dir_t, capacity: integer,
    callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty or directory.busy then return ffi.UV_EBUSY end
  if not directory.native or capacity < 0 or capacity > ffi.UINT_MAX as integer then
    return ffi.UV_EINVAL
  end
  local native_capacity = capacity as foreign size_t
  local entries = foreign uv_dirent_t.new_array(capacity)
  local native_entries = entries as foreign *uv_dirent_t
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  request.directory = directory
  request.native_dirents = entries
  directory.native.dirents = native_entries
  directory.native.nentries = native_capacity
  directory.busy = true
  local result = ffi.uv_fs_readdir(native_loop, request.native, directory.native, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  -- READDIR owns its entry allocation through cleanup even after completion
  -- or immediate rejection. Another read or close must wait for that cleanup.
  return result
end

--- Close an explicitly owned directory returned by fs_opendir.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; FS submissions also require prior cleanup; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param directory Mutable open directory owner from fs_opendir; readdir borrows it through fs_req_cleanup, closedir separately disposes it on success.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/fs.md#fs_closedir
function fs_closedir(loop: loop_t?, request: fs_t, directory: dir_t,
    callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty or directory.busy then return ffi.UV_EBUSY end
  if not directory.native then return ffi.UV_EINVAL end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  request.directory = directory
  directory.busy = true
  local result = ffi.uv_fs_closedir(native_loop, request.native, directory.native, native_callback) as integer
  if callback == nil or result < 0 then
    if result >= 0 then directory.native = nil end
    directory.busy = false
  end
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

