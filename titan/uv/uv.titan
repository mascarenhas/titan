  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "signal_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

function signal_t.new(): signal_t
  local native = foreign uv_signal_t.new()
  return {native = native, phase = HANDLE_FRESH, loop = nil,
          callback = nil, close_callback = nil,
          handler = signal_deliver, close_handler = signal_closed, userdata = nil}
end

function signal_t:as_handle_t(): handle_t
  return handle_t.signal(self)
end

function signal_t:get_signum(): integer
  if self.phase ~= HANDLE_LIVE then raise "signal handle is not initialized" end
  return self.native.signum as integer
end

function signal_init(loop: loop_t, handle: signal_t): integer
  if not loop.initialized or handle.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  loop.handles[handle] = true
  handle.loop = loop
  local status: integer = ffi.uv_signal_init(loop.native, handle.native)
  if status < 0 then loop.handles[handle] = nil; handle.loop = nil; return status end
  handle.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(handle.native as foreign *uv_handle_t, handle as foreign *void)

  return status
end

function signal_start(handle: signal_t, callback: function (signal_t, integer): (), signum: integer): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  local native_signum = signum as foreign int
  local old_callback? = handle.callback
  handle.callback = callback
  local status: integer = ffi.uv_signal_start(handle.native, signal_callback, native_signum)
  if status < 0 then handle.callback = old_callback end
  return status
end

function signal_start_oneshot(handle: signal_t, callback: function (signal_t, integer): (), signum: integer): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  local native_signum = signum as foreign int
  local old_callback? = handle.callback
  handle.callback = callback
  local status: integer = ffi.uv_signal_start_oneshot(handle.native, signal_callback, native_signum)
  if status < 0 then handle.callback = old_callback end
  return status
end

function signal_stop(handle: signal_t): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  return ffi.uv_signal_stop(handle.native)
end

record poll_t
  local ready: boolean
  local native: foreign uv_poll_t
  local phase: integer
  local loop: loop_t?
  local callback: (function (poll_t, integer, integer): ())?
  local close_callback: (function (handle_t): ())?
  local handler: function (poll_t, loop_t, integer, integer): ()
  local close_handler: function (poll_t, loop_t): ()
  local userdata: value
end

local function poll_deliver(owner: poll_t, loop: loop_t, status: integer, events: integer)
  local callback? = owner.callback
  if callback ~= nil then callback(owner, status, events) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function poll_closed(owner: poll_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  owner.ready = false
  local callback? = owner.close_callback
  owner.callback = nil
  owner.close_callback = nil
  if callback ~= nil then callback(handle_t.poll(owner)) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign type PollEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, lua_Integer): void

foreign function poll_callback(native: *uv_poll_t, status: int, events: int)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "poll_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign PollEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer, events as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

foreign function poll_close_callback(base: *uv_handle_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "poll_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

function poll_t.new(): poll_t
  local native = foreign uv_poll_t.new()
  return {ready = false, native = native, phase = HANDLE_FRESH, loop = nil,
          callback = nil, close_callback = nil,
          handler = poll_deliver, close_handler = poll_closed, userdata = nil}
end

function poll_t:as_handle_t(): handle_t
  return handle_t.poll(self)
end

function poll_init(loop: loop_t, handle: poll_t, file: integer): integer
  if not loop.initialized or handle.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  local native_file = file as foreign int
  ffi.memset(handle.native, 0, foreign uv_poll_t.sizeof)
  handle.ready = false
  loop.handles[handle] = true
  handle.loop = loop
  local status: integer = ffi.uv_poll_init(loop.native, handle.native, native_file)
  if ffi.uv_handle_get_type(handle.native as foreign *uv_handle_t) ~= ffi.UV_POLL then
    loop.handles[handle] = nil; handle.loop = nil; return status
  end
  -- Windows can fail after native registration. Such owners remain closeable
  -- and rooted, but starting their incompletely initialized requests is invalid.
  handle.ready = status == 0
  handle.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(handle.native as foreign *uv_handle_t, handle as foreign *void)

  return status
end

function poll_start(handle: poll_t, callback: function (poll_t, integer, integer): (), events: integer): integer
  if handle.phase ~= HANDLE_LIVE or not handle.ready then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  local allowed = (ffi.UV_READABLE as integer) | (ffi.UV_WRITABLE as integer) |
                  (ffi.UV_DISCONNECT as integer) | (ffi.UV_PRIORITIZED as integer)
  if (events & ~allowed) ~= 0 then return ffi.UV_EINVAL end
  local native_events = events as foreign int
  local old_callback? = handle.callback
  handle.callback = callback
  local status: integer = ffi.uv_poll_start(handle.native, native_events, poll_callback)
  if status < 0 then handle.callback = old_callback end
  return status
end

function poll_stop(handle: poll_t): integer
  if handle.phase ~= HANDLE_LIVE or not handle.ready then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  return ffi.uv_poll_stop(handle.native)
end

union handle_type
  unknown()
  async()
  check()
  fs_event()
  fs_poll()
  handle()
  idle()
  named_pipe()
  poll()
  prepare()
  process()
  stream()
  tcp()
  timer()
  tty()
  udp()
  signal()
  file()
end

const UNKNOWN_HANDLE = handle_type.unknown()
const ASYNC = handle_type.async()
const CHECK = handle_type.check()
const FS_EVENT = handle_type.fs_event()
const FS_POLL = handle_type.fs_poll()
const HANDLE = handle_type.handle()
const IDLE = handle_type.idle()
const NAMED_PIPE = handle_type.named_pipe()
const POLL = handle_type.poll()
const PREPARE = handle_type.prepare()
const PROCESS = handle_type.process()
const STREAM = handle_type.stream()
const TCP = handle_type.tcp()
const TIMER = handle_type.timer()
const TTY = handle_type.tty()
const UDP = handle_type.udp()
const SIGNAL = handle_type.signal()
const FILE = handle_type.file()

local function handle_type_native(kind: handle_type): foreign uv_handle_type
  case kind
  when unknown() then return ffi.UV_UNKNOWN_HANDLE
  when async() then return ffi.UV_ASYNC
  when check() then return ffi.UV_CHECK
  when fs_event() then return ffi.UV_FS_EVENT
  when fs_poll() then return ffi.UV_FS_POLL
  when handle() then return ffi.UV_HANDLE
  when idle() then return ffi.UV_IDLE
  when named_pipe() then return ffi.UV_NAMED_PIPE
  when poll() then return ffi.UV_POLL
  when prepare() then return ffi.UV_PREPARE
  when process() then return ffi.UV_PROCESS
  when stream() then return ffi.UV_STREAM
  when tcp() then return ffi.UV_TCP
  when timer() then return ffi.UV_TIMER
  when tty() then return ffi.UV_TTY
  when udp() then return ffi.UV_UDP
  when signal() then return ffi.UV_SIGNAL
  when file() then return ffi.UV_FILE
  end
end

local function handle_type_from_native(kind: foreign uv_handle_type): handle_type
  if kind == ffi.UV_UNKNOWN_HANDLE then return handle_type.unknown() end
  if kind == ffi.UV_ASYNC then return handle_type.async() end
  if kind == ffi.UV_CHECK then return handle_type.check() end
  if kind == ffi.UV_FS_EVENT then return handle_type.fs_event() end
  if kind == ffi.UV_FS_POLL then return handle_type.fs_poll() end
  if kind == ffi.UV_HANDLE then return handle_type.handle() end
  if kind == ffi.UV_IDLE then return handle_type.idle() end
  if kind == ffi.UV_NAMED_PIPE then return handle_type.named_pipe() end
  if kind == ffi.UV_POLL then return handle_type.poll() end
  if kind == ffi.UV_PREPARE then return handle_type.prepare() end
  if kind == ffi.UV_PROCESS then return handle_type.process() end
  if kind == ffi.UV_STREAM then return handle_type.stream() end
  if kind == ffi.UV_TCP then return handle_type.tcp() end
  if kind == ffi.UV_TIMER then return handle_type.timer() end
  if kind == ffi.UV_TTY then return handle_type.tty() end
  if kind == ffi.UV_UDP then return handle_type.udp() end
  if kind == ffi.UV_SIGNAL then return handle_type.signal() end
  if kind == ffi.UV_FILE then return handle_type.file() end
  raise "unknown native handle_type"
end

function handle_size(kind: handle_type): integer
  return ffi.uv_handle_size(handle_type_native(kind)) as foreign lua_Integer
end

function handle_type_name(kind: handle_type): string?
  local name = ffi.uv_handle_type_name(handle_type_native(kind))
  if not name then return nil end
  return name as string
end

union req_type
  unknown()
  req()
  connect()
  write()
  shutdown()
  udp_send()
  fs()
  work()
  getaddrinfo()
  getnameinfo()
  random()
end

const UNKNOWN_REQ = req_type.unknown()
const REQ = req_type.req()
const CONNECT = req_type.connect()
const WRITE = req_type.write()
const SHUTDOWN = req_type.shutdown()
const UDP_SEND = req_type.udp_send()
const FS = req_type.fs()
const WORK = req_type.work()
const GETADDRINFO = req_type.getaddrinfo()
const GETNAMEINFO = req_type.getnameinfo()
const RANDOM = req_type.random()

local function req_type_native(kind: req_type): foreign uv_req_type
  case kind
  when unknown() then return ffi.UV_UNKNOWN_REQ
  when req() then return ffi.UV_REQ
  when connect() then return ffi.UV_CONNECT
  when write() then return ffi.UV_WRITE
  when shutdown() then return ffi.UV_SHUTDOWN
  when udp_send() then return ffi.UV_UDP_SEND
  when fs() then return ffi.UV_FS
  when work() then return ffi.UV_WORK
  when getaddrinfo() then return ffi.UV_GETADDRINFO
  when getnameinfo() then return ffi.UV_GETNAMEINFO
  when random() then return ffi.UV_RANDOM
  end
end

local function req_type_from_native(kind: foreign uv_req_type): req_type
  if kind == ffi.UV_UNKNOWN_REQ then return req_type.unknown() end
  if kind == ffi.UV_REQ then return req_type.req() end
  if kind == ffi.UV_CONNECT then return req_type.connect() end
  if kind == ffi.UV_WRITE then return req_type.write() end
  if kind == ffi.UV_SHUTDOWN then return req_type.shutdown() end
  if kind == ffi.UV_UDP_SEND then return req_type.udp_send() end
  if kind == ffi.UV_FS then return req_type.fs() end
  if kind == ffi.UV_WORK then return req_type.work() end
  if kind == ffi.UV_GETADDRINFO then return req_type.getaddrinfo() end
  if kind == ffi.UV_GETNAMEINFO then return req_type.getnameinfo() end
  if kind == ffi.UV_RANDOM then return req_type.random() end
  raise "unknown native req_type"
end

function req_size(kind: req_type): integer
  return ffi.uv_req_size(req_type_native(kind)) as foreign lua_Integer
end

function req_type_name(kind: req_type): string?
  local name = ffi.uv_req_type_name(req_type_native(kind))
  if not name then return nil end
  return name as string
end

function handle_get_type(handle: handle_t): handle_type
  return handle_type_from_native(ffi.uv_handle_get_type(handle_native(handle)))
end

function req_get_type(req: req_t): req_type
  case req
  when connect(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when write(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when shutdown(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when udp_send(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when getaddrinfo(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when getnameinfo(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when fs(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when work(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  when random(owner) then return req_type_from_native(ffi.uv_req_get_type(owner.native as foreign *uv_req_t))
  end
end

function guess_handle(file: integer): handle_type
  return handle_type_from_native(ffi.uv_guess_handle(file as foreign uv_file))
end

record random_t
  local native: foreign uv_random_t
  local pending: boolean
  local loop: loop_t?
  local buffer: buf_t?
  local callback: (function (random_t, integer, buf_t, integer): ())?
  local handler: function (random_t, loop_t, integer, integer): ()
  local userdata: value
end

local function random_deliver(owner: random_t, loop: loop_t,
                              status: integer, length: integer)
  loop.requests[owner] = nil
  owner.pending = false
  owner.loop = nil
  local buffer = owner.buffer as buf_t
  local callback? = owner.callback
  owner.callback = nil
  owner.buffer = nil
  if callback ~= nil then callback(owner, status, buffer, length) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign type RandomEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, lua_Integer): void
foreign function random_callback(native: *uv_random_t, status: int, buf: *void, buflen: size_t)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(native.loop) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "random_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign RandomEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop,
        status as foreign lua_Integer, buflen as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

function random_t.new(): random_t
  local native = foreign uv_random_t.new()
  return {native = native, pending = false, loop = nil, buffer = nil,
          callback = nil, handler = random_deliver, userdata = nil}
end

function random_t:as_req_t(): req_t
  return req_t.random(self)
end

function random(loop: loop_t?, request: random_t?, buffer: buf_t,
                 length: integer, flags: integer,
                 callback: (function (random_t, integer, buf_t, integer): ())?): integer
  if not buffer.writable or length < 0 or length > buffer.native.len as integer then
    return ffi.UV_EINVAL
  end
  local native_length = length as foreign size_t
  local native_flags = flags as foreign unsigned int
  if callback == nil then
    return ffi.uv_random(nil, nil, buffer.native.base, native_length, native_flags, nil)
  end
  if not loop or not loop.initialized or not request then return ffi.UV_EINVAL end
  local req = request as random_t
  local owner_loop = loop as loop_t
  if req.pending then return ffi.UV_EBUSY end
  owner_loop.requests[req] = true
  req.pending = true
  req.loop = owner_loop
  req.buffer = buffer
  req.callback = callback
  ffi.uv_req_set_data(req.native as foreign *uv_req_t, req as foreign *void)
  local status: integer = ffi.uv_random(owner_loop.native, req.native,
      buffer.native.base, native_length, native_flags, random_callback)
  if status < 0 then
    owner_loop.requests[req] = nil
    req.pending = false
    req.loop = nil
    req.buffer = nil
    req.callback = nil
  end
  return status
end

local function stat_copy(native: foreign const *uv_stat_t): stat_t
  return stat_t {
    st_dev = (native.st_dev as foreign lua_Integer) as integer, st_mode = (native.st_mode as foreign lua_Integer) as integer,
    st_nlink = (native.st_nlink as foreign lua_Integer) as integer, st_uid = (native.st_uid as foreign lua_Integer) as integer,
    st_gid = (native.st_gid as foreign lua_Integer) as integer, st_rdev = (native.st_rdev as foreign lua_Integer) as integer,
    st_ino = (native.st_ino as foreign lua_Integer) as integer, st_size = (native.st_size as foreign lua_Integer) as integer,
    st_blksize = (native.st_blksize as foreign lua_Integer) as integer, st_blocks = (native.st_blocks as foreign lua_Integer) as integer,
    st_flags = (native.st_flags as foreign lua_Integer) as integer, st_gen = (native.st_gen as foreign lua_Integer) as integer,
    st_atim = timespec_t(native.st_atim.tv_sec as integer, native.st_atim.tv_nsec as integer),
    st_mtim = timespec_t(native.st_mtim.tv_sec as integer, native.st_mtim.tv_nsec as integer),
    st_ctim = timespec_t(native.st_ctim.tv_sec as integer, native.st_ctim.tv_nsec as integer),
    st_birthtim = timespec_t(native.st_birthtim.tv_sec as integer, native.st_birthtim.tv_nsec as integer),
  }
end

record fs_event_t
  local native: foreign uv_fs_event_t
  local phase: integer
  local loop: loop_t?
  local callback: (function (fs_event_t, string?, integer, integer): ())?
  local close_callback: (function (handle_t): ())?
  local handler: function (fs_event_t, loop_t, foreign const *char, integer, integer): ()
  local close_handler: function (fs_event_t, loop_t): ()
  local path: string?
  local userdata: value
end

local function fs_event_deliver(owner: fs_event_t, loop: loop_t, filename: foreign const *char, events: integer, status: integer)
  local callback? = owner.callback
  local name: string? = nil
  if filename then name = filename as string end
  if callback ~= nil then callback(owner, name, events, status) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function fs_event_closed(owner: fs_event_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  local callback? = owner.close_callback
  owner.callback = nil
  owner.close_callback = nil
  owner.path = nil
  if callback ~= nil then callback(handle_t.fs_event(owner)) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign type FsEventEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, const *char, lua_Integer, lua_Integer): void

foreign function fs_event_callback(native: *uv_fs_event_t, filename: const *char, events: int, status: int)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "fs_event_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign FsEventEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, filename, events as foreign lua_Integer, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

foreign function fs_event_close_callback(base: *uv_handle_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "fs_event_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

function fs_event_t.new(): fs_event_t
  local native = foreign uv_fs_event_t.new()
  return {native = native, phase = HANDLE_FRESH, loop = nil,
          callback = nil, close_callback = nil,
          handler = fs_event_deliver, close_handler = fs_event_closed, path = nil, userdata = nil}
end

function fs_event_t:as_handle_t(): handle_t
  return handle_t.fs_event(self)
end

function fs_event_init(loop: loop_t, handle: fs_event_t): integer
  if not loop.initialized or handle.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  loop.handles[handle] = true
  handle.loop = loop
  local status: integer = ffi.uv_fs_event_init(loop.native, handle.native)
  if status < 0 then loop.handles[handle] = nil; handle.loop = nil; return status end
  handle.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(handle.native as foreign *uv_handle_t, handle as foreign *void)
  return status
end

function fs_event_start(handle: fs_event_t, callback: function (fs_event_t, string?, integer, integer): (),
                      path: string, flags: integer): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  local native_option = flags as foreign unsigned int
  local old_callback? = handle.callback
  local old_path? = handle.path
  handle.callback = callback
  handle.path = path
  local status: integer = ffi.uv_fs_event_start(handle.native, fs_event_callback, path, native_option)
  if status < 0 then handle.callback = old_callback; handle.path = old_path end
  return status
end

function fs_event_stop(handle: fs_event_t): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  return ffi.uv_fs_event_stop(handle.native)
end

function fs_event_getpath(handle: fs_event_t, capacity: integer): (integer, string?, integer)
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL, nil, capacity end
  local native_size = capacity as foreign size_t
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_fs_event_getpath(handle.native, buffer, native_size)
  if status < 0 then return status, nil, native_size end
  return status, (buffer as foreign *char) as string, native_size
end

record fs_poll_t
  local native: foreign uv_fs_poll_t
  local phase: integer
  local loop: loop_t?
  local callback: (function (fs_poll_t, integer, stat_t?, stat_t?): ())?
  local close_callback: (function (handle_t): ())?
  local handler: function (fs_poll_t, loop_t, integer, foreign const *uv_stat_t, foreign const *uv_stat_t): ()
  local close_handler: function (fs_poll_t, loop_t): ()
  local path: string?
  local userdata: value
end

local function fs_poll_deliver(owner: fs_poll_t, loop: loop_t, status: integer, prev: foreign const *uv_stat_t, curr: foreign const *uv_stat_t)
  local callback? = owner.callback
  local previous: stat_t? = nil
  local current: stat_t? = nil
  if status == 0 then previous = stat_copy(prev); current = stat_copy(curr) end
  if callback ~= nil then callback(owner, status, previous, current) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function fs_poll_closed(owner: fs_poll_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  local callback? = owner.close_callback
  owner.callback = nil
  owner.close_callback = nil
  owner.path = nil
  if callback ~= nil then callback(handle_t.fs_poll(owner)) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

foreign type FsPollEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, const *uv_stat_t, const *uv_stat_t): void

foreign function fs_poll_callback(native: *uv_fs_poll_t, status: int, prev: const *uv_stat_t, curr: const *uv_stat_t)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "fs_poll_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign FsPollEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer, prev, curr)
  ffi.lua_settop(L, top)
end

foreign function fs_poll_close_callback(base: *uv_handle_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "fs_poll_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

function fs_poll_t.new(): fs_poll_t
  local native = foreign uv_fs_poll_t.new()
  return {native = native, phase = HANDLE_FRESH, loop = nil,
          callback = nil, close_callback = nil,
          handler = fs_poll_deliver, close_handler = fs_poll_closed, path = nil, userdata = nil}
end

function fs_poll_t:as_handle_t(): handle_t
  return handle_t.fs_poll(self)
end

function fs_poll_init(loop: loop_t, handle: fs_poll_t): integer
  if not loop.initialized or handle.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  loop.handles[handle] = true
  handle.loop = loop
  local status: integer = ffi.uv_fs_poll_init(loop.native, handle.native)
  if status < 0 then loop.handles[handle] = nil; handle.loop = nil; return status end
  handle.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(handle.native as foreign *uv_handle_t, handle as foreign *void)
  return status
end

function fs_poll_start(handle: fs_poll_t, callback: function (fs_poll_t, integer, stat_t?, stat_t?): (),
                      path: string, interval: integer): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  if ffi.uv_is_active(handle.native as foreign *uv_handle_t) ~= 0 then return 0 end
  local native_option = interval as foreign unsigned int
  local old_callback? = handle.callback
  local old_path? = handle.path
  handle.callback = callback
  handle.path = path
  local status: integer = ffi.uv_fs_poll_start(handle.native, fs_poll_callback, path, native_option)
  if status < 0 then handle.callback = old_callback; handle.path = old_path end
  return status
end

function fs_poll_stop(handle: fs_poll_t): integer
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL end
  if ffi.uv_is_closing(handle.native as foreign *uv_handle_t) ~= 0 then return ffi.UV_EINVAL end
  return ffi.uv_fs_poll_stop(handle.native)
end

function fs_poll_getpath(handle: fs_poll_t, capacity: integer): (integer, string?, integer)
  if handle.phase ~= HANDLE_LIVE then return ffi.UV_EINVAL, nil, capacity end
  local native_size = capacity as foreign size_t
  local buffer = foreign char.new_array(capacity)
  local status: integer = ffi.uv_fs_poll_getpath(handle.native, buffer, native_size)
  if status < 0 then return status, nil, native_size end
  return status, (buffer as foreign *char) as string, native_size
end

-- Every dir_t is one explicit native directory owner. Request cleanup releases
-- request results only. An open dir_t requires a separate successful closedir.
record dir_t
  local native: foreign *uv_dir_t
  local busy: boolean
end

function dir_t.new(): dir_t
  return { native = nil, busy = false }
end

record dirent_t
  name: string
  type: dirent_type_t
end

union dirent_type_t
  unknown()
  file()
  directory()
  link()
  fifo()
  socket()
  character()
  block()
end

record statfs_t
  f_type: integer
  f_bsize: integer
  f_blocks: integer
  f_bfree: integer
  f_bavail: integer
  f_files: integer
  f_ffree: integer
  f_frsize: integer
  f_spare: {integer}
end

union fs_ptr_t
  stat(result: stat_t)
  directory(result: dir_t)
  entries(result: {dirent_t})
  statfs(result: statfs_t)
  path(result: string)
  scandir(request: fs_t)
end

union fs_type_t
  unknown()
  custom()
  open()
  close()
  read()
  write()
  sendfile()
  stat()
  lstat()
  fstat()
  ftruncate()
  utime()
  futime()
  access()
  chmod()
  fchmod()
  fsync()
  fdatasync()
  unlink()
  rmdir()
  mkdir()
  mkdtemp()
  rename()
  scandir()
  link()
  symlink()
  readlink()
  chown()
  fchown()
  realpath()
  copyfile()
  lchown()
  opendir()
  readdir()
  closedir()
  statfs()
  mkstemp()
  lutime()
end

function fs_get_type(request: fs_t): fs_type_t
  if request.pending then raise "FS request is pending" end
  local kind = ffi.uv_fs_get_type(request.native)
  if kind == ffi.UV_FS_UNKNOWN then return fs_type_t.unknown() end
  if kind == ffi.UV_FS_CUSTOM then return fs_type_t.custom() end
  if kind == ffi.UV_FS_OPEN then return fs_type_t.open() end
  if kind == ffi.UV_FS_CLOSE then return fs_type_t.close() end
  if kind == ffi.UV_FS_READ then return fs_type_t.read() end
  if kind == ffi.UV_FS_WRITE then return fs_type_t.write() end
  if kind == ffi.UV_FS_SENDFILE then return fs_type_t.sendfile() end
  if kind == ffi.UV_FS_STAT then return fs_type_t.stat() end
  if kind == ffi.UV_FS_LSTAT then return fs_type_t.lstat() end
  if kind == ffi.UV_FS_FSTAT then return fs_type_t.fstat() end
  if kind == ffi.UV_FS_FTRUNCATE then return fs_type_t.ftruncate() end
  if kind == ffi.UV_FS_UTIME then return fs_type_t.utime() end
  if kind == ffi.UV_FS_FUTIME then return fs_type_t.futime() end
  if kind == ffi.UV_FS_ACCESS then return fs_type_t.access() end
  if kind == ffi.UV_FS_CHMOD then return fs_type_t.chmod() end
  if kind == ffi.UV_FS_FCHMOD then return fs_type_t.fchmod() end
  if kind == ffi.UV_FS_FSYNC then return fs_type_t.fsync() end
  if kind == ffi.UV_FS_FDATASYNC then return fs_type_t.fdatasync() end
  if kind == ffi.UV_FS_UNLINK then return fs_type_t.unlink() end
  if kind == ffi.UV_FS_RMDIR then return fs_type_t.rmdir() end
  if kind == ffi.UV_FS_MKDIR then return fs_type_t.mkdir() end
  if kind == ffi.UV_FS_MKDTEMP then return fs_type_t.mkdtemp() end
  if kind == ffi.UV_FS_RENAME then return fs_type_t.rename() end
  if kind == ffi.UV_FS_SCANDIR then return fs_type_t.scandir() end
  if kind == ffi.UV_FS_LINK then return fs_type_t.link() end
  if kind == ffi.UV_FS_SYMLINK then return fs_type_t.symlink() end
  if kind == ffi.UV_FS_READLINK then return fs_type_t.readlink() end
  if kind == ffi.UV_FS_CHOWN then return fs_type_t.chown() end
  if kind == ffi.UV_FS_FCHOWN then return fs_type_t.fchown() end
  if kind == ffi.UV_FS_REALPATH then return fs_type_t.realpath() end
  if kind == ffi.UV_FS_COPYFILE then return fs_type_t.copyfile() end
  if kind == ffi.UV_FS_LCHOWN then return fs_type_t.lchown() end
  if kind == ffi.UV_FS_OPENDIR then return fs_type_t.opendir() end
  if kind == ffi.UV_FS_READDIR then return fs_type_t.readdir() end
  if kind == ffi.UV_FS_CLOSEDIR then return fs_type_t.closedir() end
  if kind == ffi.UV_FS_STATFS then return fs_type_t.statfs() end
  if kind == ffi.UV_FS_MKSTEMP then return fs_type_t.mkstemp() end
  if kind == ffi.UV_FS_LUTIME then return fs_type_t.lutime() end
  return fs_type_t.unknown()
end

function fs_get_loop(request: fs_t): loop_t?
  return request.loop
end

function fs_get_system_error(request: fs_t): integer
  if request.pending then raise "FS request is pending" end
  return ffi.uv_fs_get_system_error(request.native) as integer
end

local function fs_dirent_type(kind: foreign uv_dirent_type_t): dirent_type_t
  if kind == ffi.UV_DIRENT_UNKNOWN then return dirent_type_t.unknown() end
  if kind == ffi.UV_DIRENT_FILE then return dirent_type_t.file() end
  if kind == ffi.UV_DIRENT_DIR then return dirent_type_t.directory() end
  if kind == ffi.UV_DIRENT_LINK then return dirent_type_t.link() end
  if kind == ffi.UV_DIRENT_FIFO then return dirent_type_t.fifo() end
  if kind == ffi.UV_DIRENT_SOCKET then return dirent_type_t.socket() end
  if kind == ffi.UV_DIRENT_CHAR then return dirent_type_t.character() end
  if kind == ffi.UV_DIRENT_BLOCK then return dirent_type_t.block() end
  return dirent_type_t.unknown()
end

function fs_get_dir(request: fs_t): dir_t
  if request.pending or not request.dirty then raise "FS result is unavailable" end
  if ffi.uv_fs_get_type(request.native) ~= ffi.UV_FS_OPENDIR or
      ffi.uv_fs_get_result(request.native) < 0 then raise "FS request has no directory result" end
  return request.directory as dir_t
end

function fs_get_entries(request: fs_t): {dirent_t}
  if request.pending or not request.dirty then raise "FS result is unavailable" end
  if ffi.uv_fs_get_type(request.native) ~= ffi.UV_FS_READDIR or
      ffi.uv_fs_get_result(request.native) < 0 then raise "FS request has no directory entries" end
  local entries = request.native_dirents as owned uv_dirent_t[]
  local count = ffi.uv_fs_get_result(request.native) as integer
  local result: {dirent_t} = {}
  for i = 1, count do
    result[i] = dirent_t(entries[i - 1].name as string,
                        fs_dirent_type(entries[i - 1].type))
  end
  return result
end

function fs_get_string(request: fs_t): string
  if request.pending or not request.dirty then raise "FS result is unavailable" end
  local kind = ffi.uv_fs_get_type(request.native)
  if (kind ~= ffi.UV_FS_READLINK and kind ~= ffi.UV_FS_REALPATH) or
      ffi.uv_fs_get_result(request.native) < 0 then raise "FS request has no string result" end
  return (ffi.uv_fs_get_ptr(request.native) as foreign *char) as string
end

function fs_get_statfs(request: fs_t): statfs_t
  if request.pending or not request.dirty then raise "FS result is unavailable" end
  if ffi.uv_fs_get_type(request.native) ~= ffi.UV_FS_STATFS or
      ffi.uv_fs_get_result(request.native) < 0 then raise "FS request has no statfs result" end
  local native = ffi.uv_fs_get_ptr(request.native) as foreign *uv_statfs_t
  return statfs_t {
    f_type = (native.f_type as foreign lua_Integer) as integer,
    f_bsize = (native.f_bsize as foreign lua_Integer) as integer,
    f_blocks = (native.f_blocks as foreign lua_Integer) as integer,
    f_bfree = (native.f_bfree as foreign lua_Integer) as integer,
    f_bavail = (native.f_bavail as foreign lua_Integer) as integer,
    f_files = (native.f_files as foreign lua_Integer) as integer,
    f_ffree = (native.f_ffree as foreign lua_Integer) as integer,
    f_frsize = (native.f_frsize as foreign lua_Integer) as integer,
    f_spare = {(native.f_spare[0] as foreign lua_Integer) as integer,
               (native.f_spare[1] as foreign lua_Integer) as integer,
               (native.f_spare[2] as foreign lua_Integer) as integer},
  }
end

function fs_scandir_next(request: fs_t): (integer, dirent_t?)
  if request.pending or not request.dirty then raise "FS result is unavailable" end
  if ffi.uv_fs_get_type(request.native) ~= ffi.UV_FS_SCANDIR then
    raise "FS request has no scandir result"
  end
  local native = foreign uv_dirent_t.new()
  local status = ffi.uv_fs_scandir_next(request.native, native) as integer
  if status < 0 then return status, nil end
  return status, dirent_t(native.name as string, fs_dirent_type(native.type))
end

function fs_get_ptr(request: fs_t): fs_ptr_t?
  if request.pending then raise "FS request is pending" end
  if not request.dirty or not ffi.uv_fs_get_ptr(request.native) then return nil end
  local kind = ffi.uv_fs_get_type(request.native)
  if kind == ffi.UV_FS_STAT or kind == ffi.UV_FS_LSTAT or kind == ffi.UV_FS_FSTAT then
    return fs_ptr_t.stat(fs_get_statbuf(request))
  elseif kind == ffi.UV_FS_OPENDIR then
    return fs_ptr_t.directory(fs_get_dir(request))
  elseif kind == ffi.UV_FS_READDIR then
    return fs_ptr_t.entries(fs_get_entries(request))
  elseif kind == ffi.UV_FS_STATFS then
    return fs_ptr_t.statfs(fs_get_statfs(request))
  elseif kind == ffi.UV_FS_READLINK or kind == ffi.UV_FS_REALPATH then
    return fs_ptr_t.path(fs_get_string(request))
  elseif kind == ffi.UV_FS_SCANDIR then
    return fs_ptr_t.scandir(request)
  end
  -- Other FS operations expose no documented typed ptr payload. In particular
  -- CLOSEDIR's pending/cancelled borrowed directory is not a result object.
  return nil
end

function fs_unlink(loop: loop_t?, request: fs_t, path: string,
    callback: (function (fs_t): ())?): integer
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  local result = ffi.uv_fs_unlink(native_loop, request.native, path, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

function fs_mkdtemp(loop: loop_t?, request: fs_t, path: string,
    callback: (function (fs_t): ())?): integer
