function fs_chown(loop: loop_t?, request: fs_t, path: string, uid: integer, gid: integer,
    callback: (function (fs_t): ())?): integer
  local native_uid: foreign uv_uid_t = 0
  if uid == -1 then native_uid = (-1 as foreign int) as foreign uv_uid_t
  else native_uid = uid as foreign uv_uid_t end
  local native_gid: foreign uv_gid_t = 0
  if gid == -1 then native_gid = (-1 as foreign int) as foreign uv_gid_t
  else native_gid = gid as foreign uv_gid_t end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  local result = ffi.uv_fs_chown(native_loop, request.native, path, native_uid, native_gid, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

