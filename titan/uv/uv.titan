    request.callback = nil
  end
  return result
end

function fs_opendir(loop: loop_t?, request: fs_t, path: string,
    callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty then return ffi.UV_EBUSY end
  -- Preallocate the public owner before native code can allocate a directory.
  local directory = dir_t.new()
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, path)
  if status < 0 then return status end
  request.directory = directory
  local result = ffi.uv_fs_opendir(native_loop, request.native, path, native_callback) as integer
  if callback == nil and result >= 0 then
    directory.native = ffi.uv_fs_get_ptr(request.native) as foreign *uv_dir_t
  end
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

function fs_readdir(loop: loop_t?, request: fs_t, directory: dir_t, capacity: integer,
    callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty or directory.busy then return ffi.UV_EBUSY end
  if not directory.native or capacity < 0 or capacity > ffi.UINT_MAX as integer then
    return ffi.UV_EINVAL
  end
  local native_capacity = capacity as foreign size_t
  local entries = foreign uv_dirent_t.new_array(capacity)
  local native_entries = entries as foreign *uv_dirent_t
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  request.directory = directory
  request.native_dirents = entries
  directory.native.dirents = native_entries
  directory.native.nentries = native_capacity
  directory.busy = true
  local result = ffi.uv_fs_readdir(native_loop, request.native, directory.native, native_callback) as integer
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  -- READDIR owns its entry allocation through cleanup even after completion
  -- or immediate rejection. Another read or close must wait for that cleanup.
  return result
end

function fs_closedir(loop: loop_t?, request: fs_t, directory: dir_t,
    callback: (function (fs_t): ())?): integer
  if request.pending or request.dirty or directory.busy then return ffi.UV_EBUSY end
  if not directory.native then return ffi.UV_EINVAL end
  local status, native_loop, native_callback = fs_prepare(loop, request, callback, nil)
  if status < 0 then return status end
  request.directory = directory
  directory.busy = true
  local result = ffi.uv_fs_closedir(native_loop, request.native, directory.native, native_callback) as integer
  if callback == nil or result < 0 then
    if result >= 0 then directory.native = nil end
    directory.busy = false
  end
  if result < 0 and request.pending then
    local owner_loop = request.loop as loop_t
    owner_loop.requests[request] = nil
    request.pending = false
    request.callback = nil
  end
  return result
end

