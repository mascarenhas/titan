local libuv = foreign import "uv.h"
local lua = foreign import "lua.h"
local lual = foreign import "lauxlib.h"
local ffi = foreign import "titan/ffi.h"
local cstring = foreign import "string.h"
local cunistd = foreign import "unistd.h"
local csignal = foreign import "signal.h"
local cerrno = foreign import "errno.h"
local type Sigaction = csignal.sigaction
local coroutine = import "coroutine"

-- Exact native entries carried by the Titan closures stored in callback-owner
-- record slots. The foreign libuv callbacks below recover and invoke these
-- entries without changing the closure protocol.
local type UvNoargCallbackEntry =
  foreign (*lua.lua_State, *ffi.Udata, *ffi.CClosure, *ffi.Udata) -> ()
local type UvIntegerCallbackEntry =
  foreign (*lua.lua_State, *ffi.Udata, *ffi.CClosure, *ffi.Udata,
           lua.lua_Integer) -> ()
local type UvTwoIntegerCallbackEntry =
  foreign (*lua.lua_State, *ffi.Udata, *ffi.CClosure, *ffi.Udata,
           lua.lua_Integer, lua.lua_Integer) -> ()
local type UvSizePointerCallbackEntry =
  foreign (*lua.lua_State, *ffi.Udata, *ffi.CClosure, *ffi.Udata,
           libuv.size_t, *void) -> ()
local type UvIntegerPointerCallbackEntry =
  foreign (*lua.lua_State, *ffi.Udata, *ffi.CClosure, *ffi.Udata,
           lua.lua_Integer, *void) -> ()
local type UvPointerCallbackEntry =
  foreign (*lua.lua_State, *ffi.Udata, *ffi.CClosure, *ffi.Udata,
           *void) -> ()

-- titan.uv is deliberately a thin callback/continuation adapter. There is one
-- tag identity per module instance and one outer uv_run driver per Runtime.
-- A callback may buffer persistent state or resume a Task. A resumed Task can
-- consume immediate outcomes until its next callback-bearing operation is
-- accepted, then returns to the non-reentrant event loop.
local UV_TAG: value = {}
local main_thread: *lua.lua_State = nil
local active_runtime: Runtime? = nil
local program_args_ready = false

record Error
  error: value
  traceback: string
end

record OperationError
  code: integer
  name: string
  message: string
  operation: string
end

local function bootstrap(main_callable: ({string}) -> integer,
                         args: {string}): integer
  local result = 1
  local task = run_internal(function (): ()
    result = main_callable(args)
  end)
  loop()
  local exit_code? = task.runtime.exit_code
  if exit_code then return exit_code as integer end
  local succeeded = task:status():has_succeeded()
  if succeeded then return result end
  -- An uncaught Task error has already been reported with its traceback. The
  -- standalone bootstrap still needs a conventional unsuccessful exit code.
  return 1
end

-- A generated entrypoint publishes its original argc/argv before loading any
-- module. uv_setup_args may replace argv, so publish the configured pointer
-- back to the entrypoint exactly once.
local function setup_program_args(): boolean
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_ARGC_KEY)
  if lua.lua_type(L, -1) == lua.LUA_TNIL then return false end
  local argc = lua.lua_tointegerx(L, -1, nil) as int
  lua.lua_getfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_ARGV_KEY)
  local argv = lua.lua_touserdata(L, -1) as **char
  local configured = libuv.uv_setup_args(argc, argv)
  lua.lua_pushlightuserdata(L, configured as *void)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_ARGV_KEY)
  return true
end

-- libuv reports closed-stream writes as errors only when SIGPIPE does not
-- terminate the process first. Preserve inherited application policy and
-- change only the default Unix disposition.
local function ignore_sigpipe_if_default(): integer
  local current = Sigaction.new()
  if csignal.sigaction(csignal.SIGPIPE, nil, current) ~= 0 then
    return libuv.uv_translate_sys_error(cerrno.errno)
  end
  if current.sa_handler ~= csignal.SIG_DFL then return 0 end

  current.sa_handler = csignal.SIG_IGN
  if csignal.sigaction(csignal.SIGPIPE, current, nil) ~= 0 then
    return libuv.uv_translate_sys_error(cerrno.errno)
  end
  return 0
end

do
  local sigpipe_status = ignore_sigpipe_if_default()
  if sigpipe_status < 0 then
    raise make_error(sigpipe_status, "runtime.sigpipe")
  end
  main_thread = main_thread_state()
  program_args_ready = setup_program_args()
  ffi.lua_pushtvalue(L, bootstrap)
  lua.lua_setfield(L, lua.LUA_REGISTRYINDEX, ffi.TITAN_MAIN_BOOTSTRAP_KEY)
end
