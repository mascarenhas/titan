local libuv = foreign import "uv.h"
local lua = foreign import "lua.h"
local ffi = foreign import "titan/ffi.h"
local shim = foreign import "titan/uv.h"
local coroutine = import "coroutine"

-- Portable libuv error values are macros hidden behind the private C shim.
-- Resolve them once when this module image initializes; callback and error
-- paths should not repeatedly cross the FFI boundary for constants.
local UV_EIO = 0
local UV_EOF = 0
local UV_ECANCELED = 0
local UV_EADDRNOTAVAIL = 0
local UV_EINVAL = 0
local UV_ENOBUFS = 0
local UV_ENOENT = 0
local UV_ESRCH = 0
local UV_BUF_MAX = 0

-- Private continuation runtime. Native pointers stay in exact local fields;
-- every callback is a direct call to timer_dispatch's native Titan entry.

local OWNER_ALLOCATED = 0
local OWNER_ACTIVE = 1
local OWNER_CLOSING = 2
local OWNER_CLOSED = 3

local EVENT_TIMER = 0
local EVENT_HANDLE_CLOSE = 0
local EVENT_STREAM_ALLOC = 0
local EVENT_STREAM_READ = 0
local EVENT_CONNECTION = 0
local EVENT_PROCESS_EXIT = 0

local TASK_NEW = 0
local TASK_READY = 1
local TASK_RUNNING = 2
local TASK_WAITING = 3
local TASK_SUCCEEDED = 4
local TASK_FAILED = 5
local TASK_CANCELLED = 6

local OWNER_START = 1
local OWNER_SLEEP = 2
local OWNER_CANCEL = 3
local OWNER_JOIN_WAKE = 4
local OWNER_OBSERVE = 5
local OWNER_TICKER = 6
local OWNER_TICKER_CLOSE_WAKE = 7
local OWNER_TASK_DRIVE = 8

local REQUEST_SLEEP = 1
local REQUEST_JOIN = 2
local REQUEST_TICK = 3
local REQUEST_FS = 4
local REQUEST_NET = 5
local REQUEST_SIGNAL = 6
local REQUEST_PROCESS = 7
local REQUEST_HELPER = 8

local NET_CONNECT = 1
local NET_LISTEN = 2
local NET_READ = 3
local NET_WRITE = 4
local NET_SHUTDOWN = 5
local NET_ACCEPT = 6
local NET_CLOSE = 7
local NET_CLOSE_WAIT = 8

local NET_OWNER_DNS = 1
local NET_OWNER_CONNECT = 2
local NET_OWNER_WRITE = 3
local NET_OWNER_SHUTDOWN = 4

local NET_OWNER_ALLOCATED = 0
local NET_OWNER_SUBMITTED = 1
local NET_OWNER_CALLBACK = 2
local NET_OWNER_RETIRED = 3

local OS_BUFFER_INITIAL = 256

local TCP_ALLOCATED = 0
local TCP_INITIALIZED = 1
local TCP_CONNECTION = 2
local TCP_SERVER = 3
local TCP_CLOSING = 4
local TCP_CLOSED = 5

local TCP_READ_OPEN = 0
local TCP_READ_EOF = 1
local TCP_READ_ERROR = 2

local PROCESS_ALLOCATED = 0
local PROCESS_SPAWNED = 1
local PROCESS_EXITED = 2
local PROCESS_CLOSING = 3
local PROCESS_CLOSED = 4

local PIPE_ALLOCATED = 0
local PIPE_INITIALIZED = 1
local PIPE_OPEN = 2
local PIPE_CLOSING = 3
local PIPE_CLOSED = 4

local PIPE_STDIN = 1
local PIPE_STDOUT = 2
local PIPE_STDERR = 3

local PROCESS_SPAWN = 1
local PROCESS_WAIT = 2
local PROCESS_WRITE_STDIN = 3
local PROCESS_CLOSE_STDIN = 4
local PROCESS_READ_STDOUT = 5
local PROCESS_READ_STDERR = 6
local PROCESS_DISPOSE = 7

local PROCESS_OWNER_ALLOCATED = 0
local PROCESS_OWNER_SUBMITTED = 1
local PROCESS_OWNER_CALLBACK = 2
local PROCESS_OWNER_RETIRED = 3

local PROCESS_GRACE_MILLISECONDS = 5000

local HELPER_STDOUT = 1
local HELPER_STDERR = 2
local HELPER_STDIN = 3
local HELPER_WAIT = 4

local record FsConstants
  local stat: integer
  local open: integer
  local read: integer
  local write: integer
  local flush: integer
  local close: integer
  local mkdir: integer
  local unlink: integer
  local rmdir: integer
  local rename: integer
  local list: integer
  local internal_close: integer
  local close_wait: integer
  local file_open: integer
  local file_closing: integer
  local file_closed: integer
end

local FS = FsConstants.new {
  stat = 1,
  open = 2,
  read = 3,
  write = 4,
  flush = 5,
  close = 6,
  mkdir = 7,
  unlink = 8,
  rmdir = 9,
  rename = 10,
  list = 11,
  internal_close = 12,
  close_wait = 13,
  file_open = 1,
  file_closing = 2,
  file_closed = 3,
}

local FS_OWNER_ALLOCATED = 0
local FS_OWNER_SUBMITTED = 1
local FS_OWNER_CALLBACK = 2
local FS_OWNER_CLEANED = 3

local DRIVE_RESUME = 1
local DRIVE_ERROR = 2



local record Loop
  local handle: *libuv.uv_loop_t
  local storage: value
end

-- Values are used only for opaque Lua roots and genuinely heterogeneous
-- payload/owner links.  Homogeneous recursive links retain their nominal
-- record types, and no native pointer is ever converted through value.
local record Runtime
  local loop: Loop
  local generation: integer
  local timer_owner_head: uv_timer_t?
  local fs_pending_head: uv_fs_t?
  local file_head: uv_file?
  local net_pending_head: NetRequestControl?
  local tcp_head: TcpControl?
  local signal_owner_head: uv_signal_t?
  local process_head: ProcessControl?
  local process_request_head: ProcessRequestControl?
  local task_head: Task?
  local running_task: Task?
  local in_loop: boolean
  local closing: boolean
  local fatal: boolean
  local fatal_error: value
  local fatal_traceback: string
  local pending_observations: integer
end

local record TimerControl
  local runtime: Runtime
  local lifecycle: integer
  local kind: integer
  local task: Task?
  local peer: value
  local epoch: integer
  local next_owner: uv_timer_t?
  local previous_owner: uv_timer_t?
end

local record DriveControl
  local mode: integer
  local payload: value
  local trace: string
  local cleanup_request: Request?
end

local record SignalSpec
  local name: string
  local signum: integer
end

local record SignalControl
  local runtime: Runtime
  local lifecycle: integer
  local task: Task?
  local epoch: integer
  local name: string
  local next_owner: uv_signal_t?
  local previous_owner: uv_signal_t?
end

-- Process, pipe, and request controls are deliberately separate from their
-- TCP counterparts.  They share callback shapes, not resource semantics.
local record ProcessControl
  local runtime: Runtime
  local generation: integer
  local lifecycle: integer
  local owner: uv_process_t?
  local linked: boolean
  local next_control: ProcessControl?
  local previous_control: ProcessControl?
  local stdin_pipe: uv_pipe_t?
  local stdout_pipe: uv_pipe_t?
  local stderr_pipe: uv_pipe_t?
  local spawn_operation: ProcessOperation?
  local pending_failure: Error?
  local wait_task: Task?
  local wait_epoch: integer
  local dispose_task: Task?
  local dispose_epoch: integer
  local exit_seen: boolean
  local exit_status: integer
  local term_signal: integer
  local callback_aborted: boolean
  local shutdown_started: boolean
  local kill_sent: boolean
  local grace_owner: uv_process_grace_t?
  local grace_fired: boolean
  local grace_callback_aborted: boolean
end

local record PipeControl
  local runtime: Runtime
  local lifecycle: integer
  local kind: integer
  local owner: uv_pipe_t?
  local process: ProcessControl
  local callback_aborted: boolean
  local read_active: boolean
  local read_terminal: integer
  local read_error: Error?
  local read_waiter: Task?
  local read_epoch: integer
  local read_bytes: Bytes?
  local read_queue: {Bytes}
  local output_head: ProcessOperation?
  local output_tail: ProcessOperation?
  local output_current: ProcessOperation?
  local close_waiter: ProcessOperation?
  local shutdown_requested: boolean
  local write_shutdown: boolean
end

local record ProcessOperation
  local kind: integer
  local task: Task?
  local request: Request?
  local process: uv_process_t?
  local pipe: uv_pipe_t?
  local file: Text?
  local arguments: {Text}?
  local copied_bytes: Bytes?
  local prepared_buffer: Buffer?
  local owner: uv_pipe_write_t?
  local next_operation: ProcessOperation?
  local previous_operation: ProcessOperation?
  local linked: boolean
end

local record ProcessRequestControl
  local runtime: Runtime
  local lifecycle: integer
  local owner: uv_pipe_write_t?
  local operation: ProcessOperation
  local next_control: ProcessRequestControl?
  local previous_control: ProcessRequestControl?
end

local record ProcessExitResult
  local code: integer
  local signal_number: integer
end

local record HelperGroup
  local runtime: Runtime
  local generation: integer
  local process: uv_process_t
  local input: string?
  local helpers: {Task}
  local completed: {boolean}
  local pending: integer
  local waiter: Task?
  local waiter_epoch: integer
  local waiter_all: boolean
  local wake_scheduled: boolean
  local first_error: value
  local first_traceback: string
  local stdout: string
  local stderr: string
  local exit_result: ProcessExitResult?
  local canceling: boolean
end


-- One-shot signal watchers are private fixed-layout native callback owners.
-- They remain rooted in their Runtime list through stop + close callback.
local record uv_signal_t
  local handle: *libuv.uv_signal_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_signal_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: SignalControl
  local buffer: nil
end


local record uv_pipe_t
  local handle: *libuv.uv_pipe_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_pipe_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: PipeControl
  local buffer: nil
end

local record uv_pipe_write_t
  local handle: *libuv.uv_write_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_pipe_write_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: ProcessRequestControl
  local buffer: Buffer?
end

-- The process grace timer is intentionally not a generic Runtime timer.  It
-- is owned by one ProcessControl and is drained only by process shutdown.
local record uv_process_grace_t
  local handle: *libuv.uv_timer_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_process_grace_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: ProcessControl
  local buffer: nil
end

local record Request
  local kind: integer
  local generation: integer
  local task: Task
  local subject: value
  local milliseconds: integer
  local cleanup: boolean
end

local record Bytes
  local data: *ffi.titan_ffi_char
  local storage: value
  local length: integer
end

-- Synchronous libuv helpers report lengths as size_t. Keep that type until
-- lua_pushlstring consumes it instead of narrowing through Titan integer.
local record SizedBytes
  local data: *ffi.titan_ffi_char
  local storage: value
end

local record AddressList
  local data: *shim.titan_uvshim_address
  local storage: value
  local count: integer
end

local record Text
  local bytes: Bytes
  local source: string
end

local record Buffer
  local handle: *libuv.uv_buf_t
  local storage: value
  local bytes: Bytes
end

local record Dirent
  local handle: *libuv.uv_dirent_t
  local storage: value
end

local record FsStatResult
  local size: integer
  local kind: string
  local mode: integer
  local modified_seconds: integer
  local modified_nanoseconds: integer
end

local record FsOperation
  local kind: integer
  local task: Task?
  local request: Request?
  local path: Text?
  local second_path: Text?
  local file: uv_file?
  local data: string
  local maximum: integer
  local write_offset: integer
  local write_bytes: Bytes?
  local prepared_buffer: Buffer?
  local owner: uv_fs_t?
  local next_operation: FsOperation?
  local previous_operation: FsOperation?
  local linked: boolean
  local close_waiter: boolean
end

local record FsControl
  local runtime: Runtime
  local lifecycle: integer
  local callback_aborted: boolean
  local operation: FsOperation
  local next_owner: uv_fs_t?
  local previous_owner: uv_fs_t?
  local acquired_file: libuv.uv_file
end

-- Filesystem requests stay private to uv.  The fixed six fields have the
-- same native callback layout as uv_timer_t while retaining their exact Titan
-- types and GC roots.
local record uv_fs_t
  local handle: *libuv.uv_fs_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_fs_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: FsControl
  local buffer: Buffer?
end

local record NetOperation
  local kind: integer
  local task: Task?
  local request: Request?
  local host: Text?
  local port: integer
  local backlog: integer
  local tcp: uv_tcp_t?
  local data: string
  local addresses: AddressList?
  local address_index: integer
  local prepared_buffer: Buffer?
  local owner: value
  local next_operation: NetOperation?
  local previous_operation: NetOperation?
  local linked: boolean
  local close_waiter: boolean
  local last_error: Error?
end

local record NetRequestControl
  local runtime: Runtime
  local lifecycle: integer
  local kind: integer
  local owner: value
  local operation: NetOperation
  local next_control: NetRequestControl?
  local previous_control: NetRequestControl?
  local result_pointer: ffi.titan_ffi_void_ptr
end

local record TcpControl
  local runtime: Runtime
  local generation: integer
  local lifecycle: integer
  local server: boolean
  local owner: uv_tcp_t?
  local next_control: TcpControl?
  local previous_control: TcpControl?
  local connect_pending: boolean
  local close_requested: boolean
  local shutdown_requested: boolean
  local write_shutdown: boolean
  local read_active: boolean
  local read_terminal: integer
  local read_error: Error?
  local read_waiter: Task?
  local read_epoch: integer
  local read_bytes: Bytes?
  local read_queue: {Bytes}
  local output_head: NetOperation?
  local output_tail: NetOperation?
  local output_current: NetOperation?
  local close_waiter_head: NetOperation?
  local close_waiter_tail: NetOperation?
  local accept_waiter: Task?
  local accept_epoch: integer
  local accept_queue: {uv_tcp_t}
  local accept_head: integer
  local accept_tail: integer
  local accept_count: integer
  local accept_capacity: integer
  local accept_error: Error?
  local setup_operation: NetOperation?
end

-- DNS and stream request owners share the native trampoline's fixed six
-- slots, but retain exact request-pointer and dispatcher types.
local record uv_getaddrinfo_t
  local handle: *libuv.uv_getaddrinfo_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_getaddrinfo_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: nil
end

local record uv_connect_t
  local handle: *libuv.uv_connect_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_connect_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: nil
end

local record uv_write_t
  local handle: *libuv.uv_write_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_write_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: Buffer?
end

local record uv_shutdown_t
  local handle: *libuv.uv_shutdown_t
