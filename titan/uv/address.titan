-- Candidate contributor; same logical module as the foundation.
foreign import "string.h"
foreign import "address-native.h"

--- A copied typed socket address preserving family, port, bytes, and IPv6 scope.
-- @usage uv/types.md#sockaddr_t
record sockaddr_t
  local native: foreign sockaddr_storage
  local native_length: integer
end

local function sockaddr_t:pointer(): foreign *sockaddr
  if self.native_length == 0 then raise "socket address is incomplete" end
  return self.native as foreign *sockaddr
end

local function sockaddr_copy_sized(native: foreign const *sockaddr,
                                    length: integer): sockaddr_t?
  if native == nil then return nil end
  if length < ffi.titan_sockaddr_family_size() as integer or
      length > foreign sockaddr_storage.sizeof then
    return nil
  end
  local storage = foreign sockaddr_storage.new()
  local result = sockaddr_t(storage, length)
  ffi.memcpy(result.native, native, length as foreign size_t)
  return result
end

local function sockaddr_copy(native: foreign const *sockaddr): sockaddr_t?
  if native == nil then return nil end
  local length = 0
  if native.sa_family == ffi.AF_INET then
    length = foreign sockaddr_in.sizeof as integer
  elseif native.sa_family == ffi.AF_INET6 then
    length = foreign sockaddr_in6.sizeof as integer
  else
    -- Native UDP callbacks carry no address length. recvmmsg provides only
    -- sockaddr_in6 backing, even for other datagram families; guessing a
    -- sockaddr_un/storage length here would overread. Preserve nonnull address
    -- presence and the family without pretending the remaining bytes exist.
    local storage = foreign sockaddr_storage.new()
    local result = sockaddr_t(storage, 0)
    local address = result.native as foreign *sockaddr
    address.sa_family = native.sa_family
    return result
  end
  return sockaddr_copy_sized(native, length)
end

--- Parse numeric IPv4 text and port 0..65535 into a copied typed sockaddr_t.
-- @param ip Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param port Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained sockaddr_t result, or nil on failure or absence.
-- @usage uv/functions/misc.md#ip4_addr
function ip4_addr(ip: string, port: integer): (integer, sockaddr_t?)
  local native_port = port as foreign int
  local native = foreign sockaddr_storage.new()
  local owner = sockaddr_t(native, foreign sockaddr_in.sizeof as integer)
  local status = ffi.uv_ip4_addr(ip, native_port,
      owner.native as foreign *sockaddr_in) as integer
  if status < 0 then return status, nil end
  return status, owner
end

--- Parse numeric IPv6 text and port 0..65535 into a copied typed sockaddr_t, retaining supported scope information.
-- @param ip Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param port Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained sockaddr_t result, or nil on failure or absence.
-- @usage uv/functions/misc.md#ip6_addr
function ip6_addr(ip: string, port: integer): (integer, sockaddr_t?)
  local native_port = port as foreign int
  local native = foreign sockaddr_storage.new()
  local owner = sockaddr_t(native, foreign sockaddr_in6.sizeof as integer)
  local status = ffi.uv_ip6_addr(ip, native_port,
      owner.native as foreign *sockaddr_in6) as integer
  if status < 0 then return status, nil end
  return status, owner
end

--- Return status and numeric IPv4 text for a compatible typed address.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/functions/misc.md#ip4_name
function ip4_name(address: sockaddr_t): (integer, string?)
  if address.native.ss_family ~= ffi.AF_INET then return ffi.UV_EAFNOSUPPORT, nil end
  local text = foreign char.new_array(16)
  local status = ffi.uv_ip4_name(address.native as foreign *sockaddr_in,
                                text, 16) as integer
  if status < 0 then return status, nil end
  return status, (text as foreign *char) as string
end

--- Return status and numeric IPv6 text for a compatible typed address.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/functions/misc.md#ip6_name
function ip6_name(address: sockaddr_t): (integer, string?)
  if address.native.ss_family ~= ffi.AF_INET6 then return ffi.UV_EAFNOSUPPORT, nil end
  local text = foreign char.new_array(46)
  local status = ffi.uv_ip6_name(address.native as foreign *sockaddr_in6,
                                text, 46) as integer
  if status < 0 then return status, nil end
  return status, (text as foreign *char) as string
end

--- Return status and numeric IPv4/IPv6 text according to the typed address family.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/functions/misc.md#ip_name
function ip_name(address: sockaddr_t): (integer, string?)
  local text = foreign char.new_array(46)
  local status = ffi.uv_ip_name(address:pointer(), text, 46) as integer
  if status < 0 then return status, nil end
  return status, (text as foreign *char) as string
end

--- Return the native address-family integer, including on an incomplete family-only result.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_tfamily
function sockaddr_t:family(): integer
  return (self.native as foreign *sockaddr).sa_family as integer
end

--- Report whether complete native address bytes are available.
-- @return Native boolean result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_tis_complete
function sockaddr_t:is_complete(): boolean
  return self.native_length ~= 0
end

--- Return the known native sockaddr byte length.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_tbyte_length
function sockaddr_t:byte_length(): integer
  return self.native_length
end

--- Copy all known native sockaddr bytes, including native layout/padding; return nil for an incomplete address.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/supplemental.md#sockaddr_traw_bytes
function sockaddr_t:raw_bytes(): string?
  if self.native_length == 0 then return nil end
  local bytes: owned unsigned char[] = foreign unsigned char.new_array(self.native_length)
  ffi.memcpy(bytes, self.native, self.native_length as foreign size_t)
  return bytes as string
end

--- Return an IPv4/IPv6 port in host numeric order.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_tport
function sockaddr_t:port(): integer
  if self.native.ss_family == ffi.AF_INET then
    local address = self.native as foreign *sockaddr_in
    return ffi.titan_sockaddr_ntohs(address.sin_port) as integer
  end
  if self.native.ss_family ~= ffi.AF_INET6 then raise "IP address required" end
  local address = self.native as foreign *sockaddr_in6
  return ffi.titan_sockaddr_ntohs(address.sin6_port) as integer
end

-- Flowinfo uses the native field's numeric representation; no bits are dropped.
--- Return the IPv6 flow-info field in its native numeric representation; non-IPv6 addresses return zero.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_tflowinfo
function sockaddr_t:flowinfo(): integer
  if self.native.ss_family ~= ffi.AF_INET6 then return 0 end
  return (self.native as foreign *sockaddr_in6).sin6_flowinfo as integer
end

--- Return the IPv6 scope identifier; non-IPv6 addresses return zero.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_tscope_id
function sockaddr_t:scope_id(): integer
  if self.native.ss_family ~= ffi.AF_INET6 then return 0 end
  return (self.native as foreign *sockaddr_in6).sin6_scope_id as integer
end

--- Set the native uint32 IPv6 flow-info field with checked conversion.
-- @param value Caller-supplied data retained or borrowed for the documented native interval.
-- @usage uv/supplemental.md#sockaddr_tset_flowinfo
function sockaddr_t:set_flowinfo(value: integer)
  if self.native.ss_family ~= ffi.AF_INET6 then raise "IPv6 address required" end
  (self.native as foreign *sockaddr_in6).sin6_flowinfo = value
end

--- Set the native uint32 IPv6 scope identifier with checked conversion.
-- @param value Caller-supplied data retained or borrowed for the documented native interval.
-- @usage uv/supplemental.md#sockaddr_tset_scope_id
function sockaddr_t:set_scope_id(value: integer)
  if self.native.ss_family ~= ffi.AF_INET6 then raise "IPv6 address required" end
  (self.native as foreign *sockaddr_in6).sin6_scope_id = value
end

--- Copy the 4 IPv4 or 16 IPv6 address bytes, excluding port and other sockaddr fields.
-- @return Native string result with the documented lifetime and units.
-- @usage uv/supplemental.md#sockaddr_taddress_bytes
function sockaddr_t:address_bytes(): string
  if self.native.ss_family == ffi.AF_INET then
    local bytes: owned unsigned char[] = foreign unsigned char.new_array(4)
    local address = self.native as foreign *sockaddr_in
    ffi.memcpy(bytes, address.sin_addr, 4)
    return bytes as string
  end
  if self.native.ss_family ~= ffi.AF_INET6 then raise "IP address required" end
  local bytes: owned unsigned char[] = foreign unsigned char.new_array(16)
  local address = self.native as foreign *sockaddr_in6
  ffi.memcpy(bytes, address.sin6_addr, 16)
  return bytes as string
end

-- inet_pton/ntop operate on address bytes, not sockaddr storage.
--- Parse presentation text into copied binary IPv4/IPv6 bytes for address family af.
-- @param af Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param source Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/functions/misc.md#inet_pton
function inet_pton(af: integer, source: string): (integer, string?)
  local native_af = af as foreign int
  local length = 0
  if native_af == ffi.AF_INET then length = 4
  elseif native_af == ffi.AF_INET6 then length = 16
  else return ffi.UV_EAFNOSUPPORT, nil end
  local bytes: owned unsigned char[] = foreign unsigned char.new_array(length)
  local status = ffi.uv_inet_pton(native_af, source, bytes) as integer
  if status < 0 then return status, nil end
  return status, bytes as string
end

--- Convert copied binary IPv4/IPv6 address bytes into presentation text for address family af.
-- @param af Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param source Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/functions/misc.md#inet_ntop
function inet_ntop(af: integer, source: string): (integer, string?)
  local native_af = af as foreign int
  if native_af == ffi.AF_INET then
    if #source ~= 4 then return ffi.UV_EINVAL, nil end
  elseif native_af == ffi.AF_INET6 then
    if #source ~= 16 then return ffi.UV_EINVAL, nil end
  else return ffi.UV_EAFNOSUPPORT, nil end
  local text = foreign char.new_array(46)
  local status = ffi.uv_inet_ntop(native_af, source, text, 46) as integer
  if status < 0 then return status, nil end
  return status, (text as foreign *char) as string
end

-- BSD's native sa_len field; absent on systems without that field.
--- Return the platform sockaddr length field when present, otherwise nil.
-- @return Copied or retained integer result, or nil on failure or absence.
-- @usage uv/supplemental.md#sockaddr_tsa_len
function sockaddr_t:sa_len(): integer?
  local length = ffi.titan_sockaddr_length_field(self.native as foreign *sockaddr) as integer
  if length < 0 then return nil end
  return length
end
