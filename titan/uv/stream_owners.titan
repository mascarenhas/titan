foreign import "network-native.h"
-- Candidate stream concrete owners and exact callbacks. Common foundation
-- modifications are confined to network.titan and recorded in INTEGRATION.md.
foreign type NetworkStatusEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer): void
foreign type NetworkAllocEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, *uv_buf_t): void
foreign type NetworkReadEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, const *uv_buf_t): void

--- Ordinary loop-thread callback for alloc delivery.
-- @usage uv/types.md#alloc_cb
type alloc_cb = function (handle_t, integer): (buf_t)
--- Ordinary loop-thread callback for read delivery.
-- @usage uv/types.md#read_cb
type read_cb = function (stream_t, integer, buf_t?): ()
--- Ordinary loop-thread callback for connection delivery.
-- @usage uv/types.md#connection_cb
type connection_cb = function (stream_t, integer): ()
--- Ordinary loop-thread callback for connect delivery.
-- @usage uv/types.md#connect_cb
type connect_cb = function (connect_t, integer): ()
--- Ordinary loop-thread callback for write delivery.
-- @usage uv/types.md#write_cb
type write_cb = function (write_t, integer): ()
--- Ordinary loop-thread callback for shutdown delivery.
-- @usage uv/types.md#shutdown_cb
type shutdown_cb = function (shutdown_t, integer): ()

--- A tagged view retaining a TCP, pipe, or TTY stream owner.
-- @field tcp Tcp variant.
-- @field pipe Pipe variant.
-- @field tty Tty variant.
-- @usage uv/types.md#stream_t
union stream_t
  tcp(owner: tcp_t)
  pipe(owner: pipe_t)
  tty(owner: tty_t)
end

--- Concrete tcp handle owner; initialize before use and close explicitly.
-- @usage uv/types.md#tcp_t
record tcp_t
  local native: foreign uv_tcp_t
  local phase: integer
  local loop: loop_t?
  local connection_callback: connection_cb?
  local alloc_callback: alloc_cb?
  local read_callback: read_cb?
  local read_buffer: buf_t?
  local close_callback: (function (handle_t): ())?
  local connection_handler: function (tcp_t, loop_t, integer): ()
  local alloc_handler: function (tcp_t, loop_t, integer, foreign *uv_buf_t): ()
  local read_handler: function (tcp_t, loop_t, integer, foreign const *uv_buf_t): ()
  local close_handler: function (tcp_t, loop_t): ()
  local userdata: value
end

--- Allocate a concrete handle owner without initializing its native lifetime.
-- @return Native tcp_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#tcp_tnew
function tcp_t.new(): tcp_t
  local native = foreign uv_tcp_t.new()
  return {native = native, phase = HANDLE_FRESH, loop = nil,
    connection_callback = nil, alloc_callback = nil, read_callback = nil,
    read_buffer = nil, close_callback = nil, userdata = nil,
    connection_handler = tcp_connection_deliver, alloc_handler = tcp_alloc_deliver,
    read_handler = tcp_read_deliver, close_handler = tcp_closed}
end

--- Return a tagged view of the same concrete owner.
-- @return Native handle_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#tcp_tas_handle_t
function tcp_t:as_handle_t(): handle_t
  return handle_t.tcp(self)
end

--- Return a tagged view of the same concrete owner.
-- @return Native stream_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#tcp_tas_stream_t
function tcp_t:as_stream_t(): stream_t
  return stream_t.tcp(self)
end

local function tcp_t:valid(): boolean
  return self.phase == HANDLE_LIVE and ffi.uv_is_closing(self.native as foreign *uv_handle_t) == 0
end

local function tcp_connection_deliver(owner: tcp_t, loop: loop_t, status: integer)
  local callback? = owner.connection_callback
  if callback ~= nil then callback(stream_t.tcp(owner), status) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function tcp_alloc_deliver(owner: tcp_t, loop: loop_t,
                                    suggested_size: integer, output: foreign *uv_buf_t)
  output.base = nil
  output.len = 0
  local callback? = owner.alloc_callback
  if callback == nil then return end
  local buffer = callback(handle_t.tcp(owner), suggested_size)
  if not buffer.writable then raise "read allocation must be writable" end
  owner.read_buffer = buffer
  output[0] = buffer.native[0]
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function tcp_read_deliver(owner: tcp_t, loop: loop_t,
                                   nread: integer, native: foreign const *uv_buf_t)
  -- Detach the allocation before user code can stop and restart reading.
  local buffer? = owner.read_buffer
  owner.read_buffer = nil
  local callback? = owner.read_callback
  if native == nil or native.base == nil then buffer = nil end
  if callback ~= nil then callback(stream_t.tcp(owner), nread, buffer) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function tcp_closed(owner: tcp_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  -- Keep the original loop observable through close; init replaces it.
  local callback? = owner.close_callback
  owner.connection_callback = nil
  owner.alloc_callback = nil
  owner.read_callback = nil
  owner.read_buffer = nil
  owner.close_callback = nil
  if callback ~= nil then callback(handle_t.tcp(owner)) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function tcp_connection_callback(native: *uv_stream_t, status: int)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "tcp_t", "connection_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign NetworkStatusEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

local foreign function tcp_alloc_callback(native: *uv_handle_t, suggested_size: size_t, output: *uv_buf_t)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "tcp_t", "alloc_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign NetworkAllocEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, suggested_size as foreign lua_Integer, output)
  ffi.lua_settop(L, top)
end

local foreign function tcp_read_callback(native: *uv_stream_t, nread: ssize_t, buffer: const *uv_buf_t)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "tcp_t", "read_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign NetworkReadEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, nread as foreign lua_Integer, buffer)
  ffi.lua_settop(L, top)
end

local foreign function tcp_close_callback(native: *uv_handle_t)
  local base = native as foreign *uv_handle_t
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "tcp_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

--- Concrete pipe handle owner; initialize before use and close explicitly.
-- @usage uv/types.md#pipe_t
record pipe_t
  local native: foreign uv_pipe_t
  local phase: integer
  local eligibility: foreign titan_uv_pipe_eligibility
  local loop: loop_t?
  local connection_callback: connection_cb?
  local alloc_callback: alloc_cb?
  local read_callback: read_cb?
  local read_buffer: buf_t?
  local close_callback: (function (handle_t): ())?
  local connection_handler: function (pipe_t, loop_t, integer): ()
  local alloc_handler: function (pipe_t, loop_t, integer, foreign *uv_buf_t): ()
  local read_handler: function (pipe_t, loop_t, integer, foreign const *uv_buf_t): ()
  local close_handler: function (pipe_t, loop_t): ()
  local userdata: value
end

--- Allocate a concrete handle owner without initializing its native lifetime.
-- @return Native pipe_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#pipe_tnew
function pipe_t.new(): pipe_t
  local native = foreign uv_pipe_t.new()
  local eligibility = foreign titan_uv_pipe_eligibility.new()
  return {native = native, phase = HANDLE_FRESH, eligibility = eligibility, loop = nil,
    connection_callback = nil, alloc_callback = nil, read_callback = nil,
    read_buffer = nil, close_callback = nil, userdata = nil,
    connection_handler = pipe_connection_deliver, alloc_handler = pipe_alloc_deliver,
    read_handler = pipe_read_deliver, close_handler = pipe_closed}
end

--- Return a tagged view of the same concrete owner.
-- @return Native handle_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#pipe_tas_handle_t
function pipe_t:as_handle_t(): handle_t
