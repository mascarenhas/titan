local function stream_t:pointer(): foreign *uv_stream_t
  case self

  when tcp(owner) then
    if not owner:valid() then return nil end
    return owner.native as foreign *uv_stream_t

  when pipe(owner) then
    if not owner:valid() then return nil end
    return owner.native as foreign *uv_stream_t

  when tty(owner) then
    if not owner:valid() then return nil end
    return owner.native as foreign *uv_stream_t

  end
end

local function stream_t:owner_loop(): loop_t?
  case self

  when tcp(owner) then
    if not owner:valid() then return nil end
    return owner.loop

  when pipe(owner) then
    if not owner:valid() then return nil end
    return owner.loop

  when tty(owner) then
    if not owner:valid() then return nil end
    return owner.loop

  end
end

--- Return a tagged view of the same concrete owner.
-- @return Native handle_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#stream_tas_handle_t
function stream_t:as_handle_t(): handle_t
  case self

  when tcp(owner) then return handle_t.tcp(owner)

  when pipe(owner) then return handle_t.pipe(owner)

  when tty(owner) then return handle_t.tty(owner)

  end
end

--- Reusable native connect request owner retained through accepted completion.
-- @usage uv/types.md#connect_t
record connect_t
  local native: foreign uv_connect_t
  local loop: loop_t?
  local pending: boolean
  local stream: stream_t?
  local callback: connect_cb?
  local handler: function (connect_t, loop_t, integer): ()
  local userdata: value
end

--- Allocate a fresh request owner without submitting work.
-- @return Native connect_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#connect_tnew
function connect_t.new(): connect_t
  local native = foreign uv_connect_t.new()
  return {native = native, loop = nil, pending = false, stream = nil,
    callback = nil, handler = connect_deliver, userdata = nil}
end

--- Return a tagged view of the same concrete owner.
-- @return Native req_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#connect_tas_req_t
function connect_t:as_req_t(): req_t
  return req_t.connect(self)
end

--- Read the same traced public data as the generic request accessor without allocating a request view.
-- @return Native value result with the documented lifetime and units.
-- @usage uv/supplemental.md#connect_tget_data
function connect_t:get_data(): value
  return self.userdata
end

--- Replace the existing traced public data slot; nil clears it.
-- @param data Caller-supplied data retained or borrowed for the documented native interval.
-- @usage uv/supplemental.md#connect_tset_data
function connect_t:set_data(data: value)
  self.userdata = data
end

--- Return the retained stream/handle association for this request, or nil when none is recorded.
-- @return Copied or retained stream_t result, or nil on failure or absence.
-- @usage uv/supplemental.md#connect_thandle
function connect_t:handle(): stream_t?
  return self.stream
end

local function connect_deliver(owner: connect_t, loop: loop_t, status: integer)
  loop.requests[owner] = nil
  owner.pending = false
  owner.loop = nil
  local callback? = owner.callback
  owner.callback = nil
  if callback ~= nil then callback(owner, status) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function network_connect_callback(native: *uv_connect_t, status: int)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local base = native.handle as foreign *uv_handle_t
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "connect_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign NetworkStatusEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

--- Reusable native write request owner retained through accepted completion.
-- @usage uv/types.md#write_t
record write_t
  local native: foreign uv_write_t
  local loop: loop_t?
  local pending: boolean
  local stream: stream_t?
  local buffers: {buf_t}?
  local native_buffers: (owned uv_buf_t[])?
  local string_buffer: foreign uv_buf_t
  local string_data: string?
  local send_stream: handle_t?
  local callback: write_cb?
  local handler: function (write_t, loop_t, integer): ()
  local userdata: value
end

--- Allocate a fresh request owner without submitting work.
-- @return Native write_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#write_tnew
function write_t.new(): write_t
  local native = foreign uv_write_t.new()
  local string_buffer = foreign uv_buf_t.new()
  return {native = native, loop = nil, pending = false, stream = nil,
    buffers = nil, native_buffers = nil,
    string_buffer = string_buffer, string_data = nil, send_stream = nil,
    callback = nil, handler = write_deliver, userdata = nil}
end

--- Return a tagged view of the same concrete owner.
-- @return Native req_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#write_tas_req_t
function write_t:as_req_t(): req_t
  return req_t.write(self)
end

--- Return the retained stream/handle association for this request, or nil when none is recorded.
-- @return Copied or retained stream_t result, or nil on failure or absence.
-- @usage uv/supplemental.md#write_thandle
function write_t:handle(): stream_t?
  return self.stream
end

--- Read the same traced public data as the generic request accessor without allocating a request view.
-- @return Native value result with the documented lifetime and units.
-- @usage uv/supplemental.md#write_tget_data
function write_t:get_data(): value
  return self.userdata
end

--- Replace the traced public data slot without allocating a request view.
-- @param data Caller-supplied data retained or borrowed for the documented native interval.
-- @usage uv/supplemental.md#write_tset_data
function write_t:set_data(data: value)
  self.userdata = data
end

local function write_deliver(owner: write_t, loop: loop_t, status: integer)
  loop.requests[owner] = nil
  owner.pending = false
  owner.loop = nil
  -- Keep the old buffers, descriptors, and string through actual callback
  -- return, independent of the new fields installed if user code resubmits
  -- this same request.
  local buffers? = owner.buffers
  local native_buffers? = owner.native_buffers
  local string_data? = owner.string_data
  local callback? = owner.callback
  owner.callback = nil
  owner.buffers = nil
  owner.native_buffers = nil
  owner.string_data = nil
  if callback ~= nil then callback(owner, status) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function network_write_callback(native: *uv_write_t, status: int)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local base = native.handle as foreign *uv_handle_t
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "write_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign NetworkStatusEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

