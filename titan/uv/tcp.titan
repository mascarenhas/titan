    handle = memory as *libuv.uv_shutdown_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = shutdown_dispatch,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
