local type AddressList = owned shim.titan_uvshim_address[]

-- Each record below is the ordinary argument bundle for one callback-taking
-- libuv call. A Task yields one Call, its dispatcher submits that operation,
-- and the native callback resumes exactly that Task.
local record GetaddrinfoCall
  local node: string
  local service: string
end

local record TcpConnectCall
  local tcp: uv_tcp_t
  local addresses: AddressList
  local address_index: integer
end

local record TcpReadCall
  local tcp: uv_tcp_t
end

local record TcpWriteCall
  local tcp: uv_tcp_t
  local data: string
end

local record TcpShutdownCall
  local tcp: uv_tcp_t
end

local record TcpCloseCall
  local tcp: uv_tcp_t
end

local record TcpAcceptCall
  local tcp: uv_tcp_t
end

-- The native bridge reads the callback from field 2. Everything after it
-- is the exact state owned by that callback-taking libuv operation.
local record uv_getaddrinfo_t
  local native: owned *libuv.uv_getaddrinfo_t
  local callback: (uv_getaddrinfo_t, integer,
                   ffi.titan_ffi_void_ptr) -> ()
end

local record uv_connect_t
  local native: owned *libuv.uv_connect_t
  local callback: (uv_connect_t, integer) -> ()
end

local record uv_write_t
  local native: owned *libuv.uv_write_t
  local callback: (uv_write_t, integer) -> ()
  local data: string
  local buffer: owned *libuv.uv_buf_t
end

local record uv_shutdown_t
  local native: owned *libuv.uv_shutdown_t
  local callback: (uv_shutdown_t, integer) -> ()
end

local record TcpConnectionState
  local reader: Task?
  local chunks: {string}
  local chunk_head: integer
  local chunk_tail: integer
  local eof: boolean
  local read_error: value
  local buffer: Bytes?
end

local record TcpServerState
  local accepted: {uv_tcp_t}
  local accepted_head: integer
  local accepted_tail: integer
  local waiter: Task?
  local error: value
end

local union TcpRole
  connection: TcpConnectionState
  server: TcpServerState
end

-- Persistent TCP handles own their exact long-lived stream state directly.
-- The bridge reads alloc, read, and connection callbacks from fields 2, 3,
-- and 4. Libuv, not Titan, tracks and orders concurrent write requests.
record uv_tcp_t
  local native: owned *libuv.uv_tcp_t
  local alloc_callback: (uv_tcp_t, libuv.size_t,
                         ffi.titan_ffi_void_ptr) -> ()
  local read_callback: (uv_tcp_t, integer) -> ()
  local connection_callback: (uv_tcp_t, integer) -> ()
  local runtime: Runtime
  local role: TcpRole
  local root_index: integer
end

local function tcp_stream(tcp: uv_tcp_t): *libuv.uv_stream_t
  local native: *libuv.uv_tcp_t = tcp.native
  return native as *libuv.uv_stream_t
end

local function tcp_handle(tcp: uv_tcp_t): *libuv.uv_handle_t
  local native: *libuv.uv_tcp_t = tcp.native
  return native as *libuv.uv_handle_t
end

local function connection_state(tcp: uv_tcp_t): TcpConnectionState
  case tcp.role
  when connection: state then return state
  else raise "TCP resource is not a Connection"
  end
end

local function server_state(tcp: uv_tcp_t): TcpServerState
  case tcp.role
  when server: state then return state
  else raise "TCP resource is not a Server"
  end
end

local function is_server(tcp: uv_tcp_t): boolean
  case tcp.role
  when server then return true
  else return false
  end
end

local function service_text(port: integer): string
  local bytes = ffi.titan_ffi_char.new_array(5)
  local digits = "0123456789" as const *ffi.titan_ffi_char
  local divisor = 1
  while port // divisor >= 10 do divisor = divisor * 10 end

  local remaining = port
  local length = 0
  repeat
    bytes[length] = digits[remaining // divisor]
    remaining = remaining % divisor
    divisor = divisor // 10
    length = length + 1
  until divisor == 0
  return bytes_string(bytes, length)
end

local function usable_address(entry: *libuv.addrinfo): boolean
  return entry.ai_addr ~= nil and
      (entry.ai_family == libuv.AF_INET or
       entry.ai_family == libuv.AF_INET6) and
      entry.ai_addrlen <= shim.titan_uvshim_address.sizeof
end

-- The addrinfo chain belongs to libuv only until the getaddrinfo callback
-- returns. Copy each usable sockaddr into normalized GC-owned storage before
-- uv_freeaddrinfo releases that chain.
local function copy_addresses(first: *libuv.addrinfo): AddressList
  local count = 0
  local entry = first
  while entry ~= nil do
    if usable_address(entry) then count = count + 1 end
    entry = entry.ai_next
  end

  local addresses = shim.titan_uvshim_address.new_array(count)
  local destination: *shim.titan_uvshim_address = addresses
  local index = 0
  entry = first
  while entry ~= nil do
    if usable_address(entry) then
      cstring.memcpy((destination + index).bytes, entry.ai_addr,
                     entry.ai_addrlen as cstring.size_t)
      index = index + 1
    end
    entry = entry.ai_next
  end
  return addresses
end

local function address_at(addresses: AddressList,
                          index: integer): const *libuv.sockaddr
  local data: *shim.titan_uvshim_address = addresses
  return (data + index - 1).bytes as const *libuv.sockaddr
end

local function take_chunk(tcp: uv_tcp_t): string
  local state = connection_state(tcp)
  local chunk = state.chunks[state.chunk_head]
  state.chunks[state.chunk_head] = nil
  state.chunk_head = state.chunk_head + 1
  if state.chunk_head > state.chunk_tail then
    state.chunks = {}
    state.chunk_head = 1
    state.chunk_tail = 0
  end
  return chunk
end

local function take_accepted(tcp: uv_tcp_t): uv_tcp_t
  local state = server_state(tcp)
  local client = state.accepted[state.accepted_head]
  state.accepted[state.accepted_head] = nil
  state.accepted_head = state.accepted_head + 1
  if state.accepted_head > state.accepted_tail then
    state.accepted = {}
    state.accepted_head = 1
    state.accepted_tail = 0
  end
  return client
end

local function current_waiter(tcp: uv_tcp_t): Task?
  local waiter: Task? = nil
  case tcp.role
  when connection: state then
    waiter = state.reader
  when server: state then
    waiter = state.waiter
  end
  return waiter
end

local function take_waiter(tcp: uv_tcp_t): Task?
  local waiter: Task? = current_waiter(tcp)
  case tcp.role
  when connection: state then
    state.reader = nil
  when server: state then
    state.waiter = nil
  end
  return waiter
end

local function resume_waiter(tcp: uv_tcp_t, failed: boolean,
                             payload: value): boolean
  local waiter? = take_waiter(tcp)
  if not waiter then return false end
  resume_task_from_callback(waiter as Task, failed, payload)
  return true
end

local function validate_tcp(tcp: uv_tcp_t, operation: string,
                            require_server: boolean)
  local task = running_task()
  if tcp.runtime ~= task.runtime then
    raise "TCP resource belongs to a different async Runtime"
  end
  if is_server(tcp) ~= require_server then
    if require_server then
      raise operation .. " requires a Server"
    else
      raise operation .. " requires a Connection"
    end
  end
  if require_server then
    local failure = server_state(tcp).error
    if failure ~= nil then raise failure end
  end
  if libuv.uv_is_closing(tcp_handle(tcp)) ~= 0 then
    raise "cannot " .. operation .. " a closed TCP resource"
  end
end

local function new_connection_role(): TcpRole
  return TcpRole.connection(TcpConnectionState.new(
      nil, {}, 1, 0, false, nil, nil))
end

local function new_server_role(): TcpRole
  return TcpRole.server(TcpServerState.new({}, 1, 0, nil, nil))
end

local function new_tcp(runtime: Runtime, role: TcpRole): uv_tcp_t
  local native = libuv.uv_tcp_t.new()
  local tcp: uv_tcp_t = {
    native = native,
    alloc_callback = tcp_alloc_dispatch,
    read_callback = tcp_read_dispatch,
    connection_callback = tcp_connection_dispatch,
    runtime = runtime,
    role = role,
    root_index = 0,
  }
  local exact_native: *libuv.uv_tcp_t = native
  tcp.root_index = root_handle(runtime, tcp)
  local status = libuv.uv_tcp_init(runtime.loop, exact_native)
  if status < 0 then
    unroot_handle(runtime, tcp.root_index)
    tcp.root_index = 0
    raise make_error(status, "net.tcp.init", nil)
  end
  libuv.uv_handle_set_data(exact_native as *libuv.uv_handle_t,
                           tcp as ffi.titan_ffi_void_ptr)
  return tcp
end

local function start_tcp_read(tcp: uv_tcp_t): integer
  return libuv.uv_read_start(
      tcp_stream(tcp), shim.titan_uvshim_alloc_cb,
      shim.titan_uvshim_read_cb)
end

local function begin_tcp_close(tcp: uv_tcp_t, closer: Task?): boolean
  if libuv.uv_is_closing(tcp_handle(tcp)) ~= 0 then return false end

  if closer then
    local waiter? = current_waiter(tcp)
    if waiter then
      if is_server(tcp) then
        wake_task_next_turn(
            waiter as Task, true,
            make_error(libuv.UV_ECANCELED, "net.accept", nil))
      else
        wake_task_next_turn(waiter as Task, false, nil)
      end
      take_waiter(tcp)
    end
  end

  case tcp.role
  when connection: state then
    state.chunks = {}
  when server: state then
    while state.accepted_head <= state.accepted_tail do
      begin_tcp_close(take_accepted(tcp), nil)
    end
  end

  close_handle(tcp.runtime, tcp_handle(tcp), tcp,
               tcp.root_index, closer, false, nil)
  return true
end

local function complete_status(task: Task, status: integer,
                               operation: string)
  if status < 0 then
    resume_task_from_callback(
        task, true, make_error(status, operation, nil))
  else
    resume_task_from_callback(task, false, nil)
  end
catch
  fail_task_at_callback_boundary(task, error, traceback)
end

local function fail_server(server: uv_tcp_t, failure: value)
  server_state(server).error = failure
  resume_waiter(server, true, failure)
  begin_tcp_close(server, nil)
end

local function complete_getaddrinfo(task: Task, status: integer,
                                    pointer: ffi.titan_ffi_void_ptr)
  local result = pointer as *libuv.addrinfo
  local addresses: AddressList? = nil
  local failure: value = nil
  do
    if status < 0 then
      failure = make_error(status, "net.resolve", nil)
    else
      addresses = copy_addresses(result)
      if #(addresses as AddressList) == 0 then
        failure = make_error(libuv.UV_EADDRNOTAVAIL,
                             "net.resolve", nil)
      end
    end
  catch
    failure = error
  finally
    if result ~= nil then libuv.uv_freeaddrinfo(result) end
  end

  if failure ~= nil then
    resume_task_from_callback(task, true, failure)
  else
    resume_task_from_callback(task, false, addresses)
  end
catch
  fail_task_at_callback_boundary(task, error, traceback)
end

local function tcp_alloc_dispatch(tcp: uv_tcp_t, size: libuv.size_t,
                                  pointer: ffi.titan_ffi_void_ptr)
  local state = connection_state(tcp)
  local descriptor = pointer as *libuv.uv_buf_t
  do
    local bytes = ffi.titan_ffi_char.new_array(size as integer)
    state.buffer = bytes
    descriptor.base = bytes
    descriptor.len = size
  catch
    -- A direct native callback cannot unwind through libuv. Return the zero
    -- buffer that makes libuv invoke the paired read_cb, preserving the exact
    -- allocation error for that Task boundary rather than inventing a status
    -- or a recovery path.
    state.buffer = nil
    state.read_error = error
    descriptor.base = nil
    descriptor.len = 0
  end
end

local function tcp_read_dispatch(tcp: uv_tcp_t, result: integer)
  local state = connection_state(tcp)
  local buffer? = state.buffer
  state.buffer = nil

  if not buffer and state.read_error ~= nil then
    libuv.uv_read_stop(tcp_stream(tcp))
    local failure = state.read_error
    if not resume_waiter(tcp, true, failure) then
      report_task_error(failure, "")
    end
    return
  end
  local bytes = buffer as Bytes

  if result == 0 then return end
  if result < 0 then
    libuv.uv_read_stop(tcp_stream(tcp))
    if result == libuv.UV_EOF then
      state.eof = true
      resume_waiter(tcp, false, nil)
    else
      local failure = make_error(result, "net.read", nil)
      state.read_error = failure
      resume_waiter(tcp, true, failure)
    end
    return
  end

  local chunk = bytes_string(bytes, result)
  if not resume_waiter(tcp, false, chunk) then
    state.chunk_tail = state.chunk_tail + 1
    state.chunks[state.chunk_tail] = chunk
  end
catch
  libuv.uv_read_stop(tcp_stream(tcp))
  connection_state(tcp).read_error = error
  if not resume_waiter(tcp, true, error) then
    report_task_error(error, traceback)
  end
end

local function tcp_connection_dispatch(server: uv_tcp_t, status: integer)
  if server.runtime.closing then return end
  local client: uv_tcp_t? = nil
  local retained = false
  do
    check_status(status, "net.accept", nil)
    client = new_tcp(server.runtime, new_connection_role())
    local accepted = client as uv_tcp_t
    check_status(libuv.uv_accept(tcp_stream(server), tcp_stream(accepted)),
                 "net.accept", nil)
    if not resume_waiter(server, false, accepted) then
      local state = server_state(server)
      state.accepted_tail = state.accepted_tail + 1
      state.accepted[state.accepted_tail] = accepted
    end
    retained = true
  catch
    fail_server(server, error)
  finally
    if client and not retained then
      begin_tcp_close(client as uv_tcp_t, nil)
    end
  end
catch
  local failure = error
  server_state(server).error = failure
  if not resume_waiter(server, true, failure) then
    report_task_error(failure, traceback)
  end
end

local function submitted(task: Task, status: integer,
                         operation: string): Immediate?
  if status >= 0 then return nil end
  task.pending = nil
  return immediate_error(status, operation, nil)
end

local function GetaddrinfoCall:dispatch(task: Task): Immediate?
  local native = libuv.uv_getaddrinfo_t.new()
  local request: *libuv.uv_getaddrinfo_t = native
  local hints = libuv.addrinfo.new()
  hints.ai_family = libuv.AF_UNSPEC
  hints.ai_socktype = libuv.SOCK_STREAM
  hints.ai_protocol = libuv.IPPROTO_TCP
  hints.ai_flags = libuv.AI_NUMERICSERV
  local callback = function (_owner: uv_getaddrinfo_t, status: integer,
                             pointer: ffi.titan_ffi_void_ptr)
    complete_getaddrinfo(task, status, pointer)
  end
  local owner = uv_getaddrinfo_t.new(native, callback)
  task.pending = owner
  libuv.uv_req_set_data(request as *libuv.uv_req_t,
                        owner as ffi.titan_ffi_void_ptr)
  local node = self.node as const *ffi.titan_ffi_char
  local service = self.service as const *ffi.titan_ffi_char
  local status = libuv.uv_getaddrinfo {
    loop = task.runtime.loop,
    req = request,
    getaddrinfo_cb = shim.titan_uvshim_getaddrinfo_cb,
    node = node,
    service = service,
    hints = hints,
  }
  return submitted(task, status, "net.resolve")
end

local function TcpConnectCall:dispatch(task: Task): Immediate?
  local native = libuv.uv_connect_t.new()
  local request: *libuv.uv_connect_t = native
  local callback = function (_owner: uv_connect_t, status: integer)
    complete_status(task, status, "net.connect")
  end
  local owner = uv_connect_t.new(native, callback)
  task.pending = owner
  libuv.uv_req_set_data(request as *libuv.uv_req_t,
                        owner as ffi.titan_ffi_void_ptr)
  local handle: *libuv.uv_tcp_t = self.tcp.native
  local status = libuv.uv_tcp_connect {
    req = request,
    handle = handle,
    addr = address_at(self.addresses, self.address_index),
    cb = shim.titan_uvshim_connect_cb,
  }
  return submitted(task, status, "net.connect")
end

local function TcpReadCall:dispatch(task: Task): Immediate?
  local tcp = self.tcp
  local state = connection_state(tcp)
  if state.chunk_head <= state.chunk_tail then
    return immediate_ok(take_chunk(tcp))
  end
  if state.read_error ~= nil then
    return Immediate.new(true, state.read_error)
  end
  if state.eof then return immediate_ok(nil) end
  if state.reader then
    return Immediate.new(true, "Connection already has a waiting reader")
  end
  local cancel_action: CancelAction = function ()
    if state.reader == task then
      wake_task_next_turn(task, false, nil)
      state.reader = nil
    end
  end
  if libuv.uv_is_active(tcp_handle(tcp)) == 0 then
    local status = start_tcp_read(tcp)
    if status < 0 then
      return immediate_error(status, "net.read.start", nil)
    end
  end

  state.reader = task
  task.cancel_action = cancel_action
  return nil
end

local function TcpWriteCall:dispatch(task: Task): Immediate?
  local descriptor = libuv.uv_buf_t.new()
  local bytes = self.data as const *ffi.titan_ffi_char
  shim.titan_uvshim_buf_init_const(
      descriptor, bytes, #self.data as libuv.size_t)
  local native = libuv.uv_write_t.new()
  local request: *libuv.uv_write_t = native
  local callback = function (_owner: uv_write_t, status: integer)
    complete_status(task, status, "net.write")
  end
  local owner = uv_write_t.new(
      native, callback, self.data, descriptor)
  task.pending = owner
  libuv.uv_req_set_data(request as *libuv.uv_req_t,
                        owner as ffi.titan_ffi_void_ptr)
  local status = libuv.uv_write {
    req = request,
    handle = tcp_stream(self.tcp),
    bufs = owner.buffer,
    nbufs = 1,
    cb = shim.titan_uvshim_write_cb,
  }
  return submitted(task, status, "net.write")
end

local function TcpShutdownCall:dispatch(task: Task): Immediate?
  local native = libuv.uv_shutdown_t.new()
  local request: *libuv.uv_shutdown_t = native
  local callback = function (_owner: uv_shutdown_t, status: integer)
    complete_status(task, status, "net.shutdown")
  end
  local owner = uv_shutdown_t.new(native, callback)
  task.pending = owner
  libuv.uv_req_set_data(request as *libuv.uv_req_t,
                        owner as ffi.titan_ffi_void_ptr)
  local status = libuv.uv_shutdown(
      request, tcp_stream(self.tcp), shim.titan_uvshim_shutdown_cb)
  return submitted(task, status, "net.shutdown")
end

local function TcpCloseCall:dispatch(task: Task): Immediate?
  local tcp = self.tcp
  if not begin_tcp_close(tcp, task) then return immediate_ok(nil) end
  return nil
end

local function TcpAcceptCall:dispatch(task: Task): Immediate?
  local tcp = self.tcp
  local state = server_state(tcp)
  if state.error ~= nil then
    return Immediate.new(true, state.error)
  end
  if state.accepted_head <= state.accepted_tail then
    return immediate_ok(take_accepted(tcp))
  end
  if state.waiter then
    return Immediate.new(true, "Server already has a waiting accept Task")
  end

  local cancel_action: CancelAction = function ()
    if state.waiter == task then
      wake_task_next_turn(task, false, nil)
      state.waiter = nil
    end
  end
  state.waiter = task
  task.cancel_action = cancel_action
  return nil
end

local function resolve_addresses(host: string,
                                 port: integer): AddressList
  if contains_nul(host) then
    raise make_error(libuv.UV_EINVAL, "net.resolve", nil)
  end
  return await(Call.getaddrinfo(
      GetaddrinfoCall.new(host, service_text(port)))) as AddressList
end

local function validate_port(port: integer)
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
end

function _net_connect(host: string, port: integer): uv_tcp_t
  validate_port(port)
  local task = running_task()
  accepting_work(task.runtime, "connect TCP")
  local addresses = resolve_addresses(host, port)
  local last_failure: value = nil

  local address_index = 1
  while address_index <= #addresses do
    local tcp = new_tcp(task.runtime, new_connection_role())
    local connected = false
    do
      await(Call.tcp_connect(
          TcpConnectCall.new(tcp, addresses, address_index)))
      connected = true
    catch
      last_failure = error
    finally
      if not connected then begin_tcp_close(tcp, nil) end
    end
    if connected then return tcp end
    address_index = address_index + 1
  end

  if last_failure ~= nil then raise last_failure end
  raise make_error(libuv.UV_EADDRNOTAVAIL, "net.connect", nil)
end

function _net_listen(host: string, port: integer,
                     backlog: integer): uv_tcp_t
  validate_port(port)
  if backlog <= 0 then raise "TCP listen backlog must be positive" end
  if backlog > 2147483647 then
    raise "TCP listen backlog is not representable by libuv"
  end
  local task = running_task()
  accepting_work(task.runtime, "listen on TCP")
  local addresses = resolve_addresses(host, port)
  local last_failure: value = nil

  local address_index = 1
  while address_index <= #addresses do
    local tcp = new_tcp(task.runtime, new_server_role())
    local listening = false
    do
      local native: *libuv.uv_tcp_t = tcp.native
      local status = libuv.uv_tcp_bind(
          native, address_at(addresses, address_index), 0)
      if status >= 0 then
        status = libuv.uv_listen(
            tcp_stream(tcp), backlog as ffi.titan_ffi_int,
            shim.titan_uvshim_connection_cb)
      end
      if status < 0 then
        raise make_error(status, "net.listen", nil)
      end
      listening = true
    catch
      last_failure = error
    finally
      if not listening then begin_tcp_close(tcp, nil) end
    end
    if listening then return tcp end
    address_index = address_index + 1
  end

  if last_failure ~= nil then raise last_failure end
  raise make_error(libuv.UV_EADDRNOTAVAIL, "net.listen", nil)
end

function _net_read(tcp: uv_tcp_t): string?
  if is_server(tcp) then raise "read from requires a Connection" end
  if libuv.uv_is_closing(tcp_handle(tcp)) ~= 0 then return nil end
  validate_tcp(tcp, "read from", false)
  return await(Call.tcp_read(TcpReadCall.new(tcp))) as string?
end

function _net_write(tcp: uv_tcp_t, data: string)
  validate_tcp(tcp, "write to", false)
  if libuv.uv_is_writable(tcp_stream(tcp)) == 0 then
    raise "cannot write after Connection shutdown"
  end
  if #data == 0 then return end
  await(Call.tcp_write(
      TcpWriteCall.new(tcp, data)))
end

function _net_shutdown(tcp: uv_tcp_t)
  validate_tcp(tcp, "shut down", false)
  if libuv.uv_is_writable(tcp_stream(tcp)) == 0 then return end
  await(Call.tcp_shutdown(TcpShutdownCall.new(tcp)))
end

function _net_accept(server: uv_tcp_t): uv_tcp_t
  validate_tcp(server, "accept on", true)
  return await(Call.tcp_accept(TcpAcceptCall.new(server))) as uv_tcp_t
end

function _net_close(tcp: uv_tcp_t)
  if libuv.uv_is_closing(tcp_handle(tcp)) ~= 0 then return end
  validate_tcp(tcp, "close", is_server(tcp))
  await(Call.tcp_close(TcpCloseCall.new(tcp)))
end

function _net_is_closed(tcp: uv_tcp_t): boolean
  return libuv.uv_is_closing(tcp_handle(tcp)) ~= 0
end
