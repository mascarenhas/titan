const TCP_IPV6ONLY: integer?
const TCP_REUSEPORT: integer?



function tcp_init_ex(loop: loop_t, handle: tcp_t, flags: integer): integer
  local native_flags = flags as foreign unsigned int
  if not loop.initialized or handle.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  loop.handles[handle] = true
  handle.loop = loop
  local status = ffi.uv_tcp_init_ex(loop.native, handle.native, native_flags) as integer
  if status < 0 then loop.handles[handle] = nil; handle.loop = nil; return status end
  handle.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(handle.native as foreign *uv_handle_t, handle as foreign *void)
  return status
end

function tcp_init(loop: loop_t, handle: tcp_t): integer
  return tcp_init_ex(loop, handle, ffi.AF_UNSPEC as integer)
end

function tcp_open(handle: tcp_t, socket: os_sock_t): integer
  local native_socket = socket.native
  if not handle:valid() then return ffi.UV_EINVAL end
  return ffi.uv_tcp_open(handle.native, native_socket)
end

function tcp_nodelay(handle: tcp_t, enable: integer): integer
  local native_enable = enable as foreign int
  if not handle:valid() then return ffi.UV_EINVAL end
  return ffi.uv_tcp_nodelay(handle.native, native_enable)
end

function tcp_keepalive(handle: tcp_t, enable: integer, delay: integer): integer
  local native_enable = enable as foreign int
  local native_delay = delay as foreign unsigned int
  if not handle:valid() then return ffi.UV_EINVAL end
  return ffi.uv_tcp_keepalive(handle.native, native_enable, native_delay)
end

function tcp_keepalive_ex(handle: tcp_t, on: integer, idle: integer,
                          intvl: integer, count: integer): integer
  local native_on = on as foreign int
  local native_idle = idle as foreign unsigned int
  local native_interval = intvl as foreign unsigned int
  local native_count = count as foreign unsigned int
  if not handle:valid() then return ffi.UV_EINVAL end
  return ffi.uv_tcp_keepalive_ex(handle.native, native_on, native_idle,
                                 native_interval, native_count)
end

function tcp_simultaneous_accepts(handle: tcp_t, enable: integer): integer
  local native_enable = enable as foreign int
  if not handle:valid() then return ffi.UV_EINVAL end
  return ffi.uv_tcp_simultaneous_accepts(handle.native, native_enable)
end

function tcp_bind(handle: tcp_t, addr: sockaddr_t, flags: integer): integer
  local native_flags = flags as foreign unsigned int
  local native_addr = addr:pointer()
  if not handle:valid() then return ffi.UV_EINVAL end
  return ffi.uv_tcp_bind(handle.native, native_addr, native_flags)
end

function tcp_getsockname(handle: tcp_t): (integer, sockaddr_t?, integer)
  if not handle:valid() then return ffi.UV_EINVAL, nil, 0 end
  local native = foreign sockaddr_storage.new()
  local size = foreign int.new_array(1)
  size[0] = foreign sockaddr_storage.sizeof as foreign int
  local status = ffi.uv_tcp_getsockname(handle.native, native as foreign *sockaddr, size) as integer
  if status < 0 then return status, nil, size[0] as integer end
  return status, sockaddr_copy_sized(native as foreign const *sockaddr, size[0] as integer), size[0] as integer
end

function tcp_getpeername(handle: tcp_t): (integer, sockaddr_t?, integer)
  if not handle:valid() then return ffi.UV_EINVAL, nil, 0 end
  local native = foreign sockaddr_storage.new()
  local size = foreign int.new_array(1)
  size[0] = foreign sockaddr_storage.sizeof as foreign int
  local status = ffi.uv_tcp_getpeername(handle.native, native as foreign *sockaddr, size) as integer
  if status < 0 then return status, nil, size[0] as integer end
  return status, sockaddr_copy_sized(native as foreign const *sockaddr, size[0] as integer), size[0] as integer
end

function tcp_close_reset(handle: tcp_t, callback: (function (handle_t): ())?): integer
  if not handle:valid() then return ffi.UV_EINVAL end
  local old_callback? = handle.close_callback
  handle.close_callback = callback
  local status = ffi.uv_tcp_close_reset(handle.native, tcp_close_callback) as integer
  if status < 0 then handle.close_callback = old_callback end
  return status
end

function tcp_connect(req: connect_t, handle: tcp_t, addr: sockaddr_t,
                       callback: connect_cb): integer
  if req.pending then return ffi.UV_EBUSY end
  if not handle:valid() then return ffi.UV_EINVAL end
  local native_addr = addr:pointer()
  local stream = handle:as_stream_t()
  local loop = handle.loop
  loop.requests[req] = true
  req.loop = loop
  req.pending = true
  req.stream = stream
  req.callback = callback
  ffi.uv_req_set_data(req.native as foreign *uv_req_t, req as foreign *void)
  local status = ffi.uv_tcp_connect(req.native, handle.native, native_addr,
                                     network_connect_callback) as integer
  if status < 0 then
    loop.requests[req] = nil
    req.pending = false
    req.loop = nil
    req.stream = nil
    req.callback = nil
  end
  return status
end

function pipe_connect2(req: connect_t, handle: pipe_t, name: string,
                        namelen: integer, flags: integer, callback: connect_cb): integer
  if req.pending then return ffi.UV_EBUSY end
  if not handle:valid() then return ffi.UV_EINVAL end
  if namelen < 0 or namelen > #name then return ffi.UV_EINVAL end
  local native_length = namelen as foreign size_t
  local native_flags = flags as foreign unsigned int
  local stream = handle:as_stream_t()
  local loop = handle.loop
  loop.requests[req] = true
  req.loop = loop
  req.pending = true
  req.stream = stream
  req.callback = callback
  ffi.uv_req_set_data(req.native as foreign *uv_req_t, req as foreign *void)
  handle.eligibility.available = 0
  local status = ffi.uv_pipe_connect2(req.native, handle.native, name,
      native_length, native_flags, network_connect_callback) as integer
  if status < 0 then
    loop.requests[req] = nil
    req.pending = false
    req.loop = nil
    req.stream = nil
    req.callback = nil
  end
  return status
end

function pipe_connect(req: connect_t, handle: pipe_t, name: string, callback: connect_cb)
  if req.pending then raise "connect request is pending" end
  if not handle:valid() then raise "pipe is not initialized" end
  local stream = handle:as_stream_t()
  local loop = handle.loop
  loop.requests[req] = true
  req.loop = loop
  req.pending = true
  req.stream = stream
  req.callback = callback
  ffi.uv_req_set_data(req.native as foreign *uv_req_t, req as foreign *void)
  -- The void legacy native API promises deferred delivery even for bad names.
  handle.eligibility.available = 0
  ffi.uv_pipe_connect(req.native, handle.native, name, network_connect_callback)
end
