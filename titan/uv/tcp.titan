local record AddressList
  local data: *shim.titan_uvshim_address
  local storage: value
  local count: integer
end

local record NetOperation
  local kind: integer
  local task: Task?
  local request: Request?
  local host: Text?
  local port: integer
  local backlog: integer
  local tcp: uv_tcp_t?
  local data: string
  local addresses: AddressList?
  local address_index: integer
  local prepared_buffer: Buffer?
  local owner: value
  local next_operation: NetOperation?
  local previous_operation: NetOperation?
  local linked: boolean
  local close_waiter: boolean
  local last_error: Error?
end

local record NetRequestControl
  local runtime: Runtime
  local lifecycle: integer
  local kind: integer
  local owner: value
  local operation: NetOperation
  local next_control: NetRequestControl?
  local previous_control: NetRequestControl?
  local result_pointer: *libuv.addrinfo
end

local record TcpControl
  local runtime: Runtime
  local generation: integer
  local lifecycle: integer
  local server: boolean
  local owner: uv_tcp_t?
  local next_control: TcpControl?
  local previous_control: TcpControl?
  local connect_pending: boolean
  local close_requested: boolean
  local shutdown_requested: boolean
  local write_shutdown: boolean
  local read_active: boolean
  local read_terminal: integer
  local read_error: Error?
  local read_waiter: Task?
  local read_epoch: integer
  local read_bytes: Bytes?
  local read_queue: {Bytes}
  local output_head: NetOperation?
  local output_tail: NetOperation?
  local output_current: NetOperation?
  local close_waiter_head: NetOperation?
  local close_waiter_tail: NetOperation?
  local accept_waiter: Task?
  local accept_epoch: integer
  local accept_queue: {uv_tcp_t}
  local accept_head: integer
  local accept_tail: integer
  local accept_count: integer
  local accept_capacity: integer
  local accept_error: Error?
  local setup_operation: NetOperation?
end

-- DNS and stream request owners share the native trampoline's fixed six
-- slots, but retain exact request-pointer and dispatcher types.
local record uv_getaddrinfo_t
  local handle: *libuv.uv_getaddrinfo_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_getaddrinfo_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: nil
end

local record uv_connect_t
  local handle: *libuv.uv_connect_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_connect_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: nil
end

local record uv_write_t
  local handle: *libuv.uv_write_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_write_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: Buffer?
end

local record uv_shutdown_t
  local handle: *libuv.uv_shutdown_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_shutdown_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: NetRequestControl
  local buffer: nil
end

-- Persistent TCP handles cross into net through this exact nominal wrapper.
-- Native callbacks recover this record directly; the pointer never travels
-- through value and repeated middle-layer calls allocate no pointer box.
record uv_tcp_t
  local handle: *libuv.uv_tcp_t
  local storage: value
  local main_thread: value
  local dispatcher: (uv_tcp_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local metadata: TcpControl
  local buffer: nil
end

function _net_connect(host: string, port: integer): uv_tcp_t
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
  local request = new_net_request {
    kind = NET_CONNECT,
    host = host,
    port = port,
    backlog = 0,
    tcp = nil,
    data = "",
    cleanup = false,
  }
  return coroutine.yield(request, UV_TAG)
end

function _net_listen(host: string, port: integer,
                     backlog: integer): uv_tcp_t
  if port < 0 or port > 65535 then
    raise "TCP port must be between 0 and 65535"
  end
  if backlog <= 0 then raise "TCP listen backlog must be positive" end
  if backlog > 2147483647 then
    raise "TCP listen backlog is not representable by libuv"
  end
  local request = new_net_request {
    kind = NET_LISTEN,
    host = host,
    port = port,
    backlog = backlog,
    tcp = nil,
    data = "",
    cleanup = false,
  }
  return coroutine.yield(request, UV_TAG)
end

function _net_read(tcp: uv_tcp_t): string?
  local task = ordinary_task()
  local control = tcp.metadata
  if control.runtime ~= task.runtime or
      control.generation ~= task.runtime.generation then
    raise "TCP resource belongs to a stale libuv Runtime"
  end
  if control.server then raise "read from requires a Connection" end
  if #control.read_queue > 0 then
    local payload = queued_bytes_string(control.read_queue)
    control.read_queue = {}
    return payload
  end
  if control.read_terminal == TCP_READ_EOF then return nil end
  if control.read_terminal == TCP_READ_ERROR then raise control.read_error end
  if control.close_requested or control.lifecycle == TCP_CLOSING or
      control.lifecycle == TCP_CLOSED then
    raise "cannot read from a closed Connection"
  end
  if control.read_waiter then
    raise "Connection already has a waiting reader"
  end
  local request = new_net_request {
    kind = NET_READ,
    host = nil,
    port = 0,
    backlog = 0,
    tcp = tcp,
    data = "",
    cleanup = false,
  }
  return coroutine.yield(request, UV_TAG)
end

function _net_read_error_is(tcp: uv_tcp_t, candidate: value): boolean
  local control = tcp.metadata
  if control.read_terminal ~= TCP_READ_ERROR or not control.read_error then
    return false
  end
  return candidate == control.read_error
end

function _net_write(tcp: uv_tcp_t, data: string)
  ordinary_task()
  validate_tcp(tcp, "write to", false, false)
  if tcp.metadata.shutdown_requested then
    raise "cannot write after Connection shutdown"
  end
  if #data == 0 then return end
  if #data > climits.UINT_MAX then
    raise "TCP write data exceeds the portable libuv buffer limit"
  end
  local request = new_net_request {
    kind = NET_WRITE,
    host = nil,
    port = 0,
    backlog = 0,
    tcp = tcp,
    data = data,
    cleanup = false,
  }
  coroutine.yield(request, UV_TAG)
end

function _net_shutdown(tcp: uv_tcp_t)
  ordinary_task()
  validate_tcp(tcp, "shut down", false, false)
  if tcp.metadata.shutdown_requested then return end
  cleanup_begin()
  do
    -- Construct the complete shielded Request before publishing the monotonic
    -- shutdown flag. Once visible, cancellation cannot detach the physical
    -- FIFO work and is delivered only after uv_shutdown completes.
    local request = new_net_request {
      kind = NET_SHUTDOWN,
      host = nil,
      port = 0,
      backlog = 0,
      tcp = tcp,
      data = "",
      cleanup = true,
    }
    tcp.metadata.shutdown_requested = true
    coroutine.yield(request, UV_TAG)
  finally
    cleanup_end()
  end
end

function _net_accept(server: uv_tcp_t): uv_tcp_t
  ordinary_task()
  local control = validate_tcp_identity(server, "accept on", true)
  if control.accept_error then raise control.accept_error end
  validate_tcp_lifecycle(control, "accept on", false)
  if control.accept_count > 0 then
    local client = dequeue_accepted(server)
    return client
  end
  if control.accept_waiter then
    raise "Server already has a waiting accept Task"
  end
  local request = new_net_request {
    kind = NET_ACCEPT,
    host = nil,
    port = 0,
    backlog = 0,
    tcp = server,
    data = "",
    cleanup = false,
  }
  return coroutine.yield(request, UV_TAG)
end

function _net_close(tcp: uv_tcp_t)
  if tcp.metadata.lifecycle == TCP_CLOSED then return end
  validate_tcp(tcp, "close", tcp.metadata.server, true)
  cleanup_begin()
  do
    local kind = NET_CLOSE
    if tcp.metadata.close_requested then kind = NET_CLOSE_WAIT end
    local request = new_net_request {
      kind = kind,
      host = nil,
      port = 0,
      backlog = 0,
      tcp = tcp,
      data = "",
      cleanup = true,
    }
    coroutine.yield(request, UV_TAG)
  finally
    cleanup_end()
  end
end

function _net_is_closed(tcp: uv_tcp_t): boolean
  return tcp.metadata.lifecycle == TCP_CLOSED
end

function _net_eof_error(operation: string, message: string,
                        subject: string): Error
  local code = libuv.UV_EOF as integer
  return Error.new(code,
      libuv.uv_err_name(code as ffi.titan_ffi_int) as string,
      message, operation, subject)
end

local function usable_address(entry: *libuv.addrinfo): boolean
  return entry.ai_addr ~= nil and
      (entry.ai_family == libuv.AF_INET or
       entry.ai_family == libuv.AF_INET6) and
      entry.ai_addrlen <= libuv.sockaddr_storage.sizeof
end

local function copy_addresses(pointer: *libuv.addrinfo,
                              subject: string): AddressList
  local count = 0
  local entry = pointer
  while entry ~= nil do
    if usable_address(entry) then count = count + 1 end
    entry = entry.ai_next
  end

  local owned = shim.titan_uvshim_address.new_array(count)
  local storage: value = owned
  local data = owned as *shim.titan_uvshim_address
  local copied = 0
  entry = pointer
  while entry ~= nil do
    if usable_address(entry) then
      local copy_length = entry.ai_addrlen as cstring.size_t
      local destination = data + copied
      cstring.memcpy(destination.bytes, entry.ai_addr, copy_length)
      copied = copied + 1
    end
    entry = entry.ai_next
  end
  return AddressList.new(data, storage, count)
end

local function validate_tcp_identity(tcp: uv_tcp_t, operation: string,
                                     require_server: boolean): TcpControl
  local runtime = current_runtime()
  local control = tcp.metadata
  if control.runtime ~= runtime or
      control.generation ~= runtime.generation then
    raise "TCP resource belongs to a stale libuv Runtime"
  end
  if require_server ~= control.server then
    if require_server then
      raise operation .. " requires a Server"
    else
      raise operation .. " requires a Connection"
    end
  end
  return control
end

local function validate_tcp_lifecycle(control: TcpControl,
                                      operation: string,
                                      allow_closing: boolean)
  if control.lifecycle == TCP_CLOSED then
    raise "cannot " .. operation .. " a closed TCP resource"
  end
  if control.lifecycle == TCP_CLOSING and not allow_closing then
    raise "cannot " .. operation .. " a closing TCP resource"
  end
  if control.close_requested and not allow_closing then
    raise "cannot " .. operation .. " a closing TCP resource"
  end
end

local function validate_tcp(tcp: uv_tcp_t, operation: string,
                            require_server: boolean,
                            allow_closing: boolean)
  local control = validate_tcp_identity(tcp, operation, require_server)
  validate_tcp_lifecycle(control, operation, allow_closing)
end

local function enqueue_output(tcp: uv_tcp_t, operation: NetOperation)
  local control = tcp.metadata
  local previous? = control.output_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    previous.next_operation = operation
  else
    control.output_head = operation
  end
  control.output_tail = operation
  operation.linked = true
  operation.close_waiter = false
end

local function remove_output(tcp: uv_tcp_t, operation: NetOperation)
  if not operation.linked or operation.close_waiter then return end
  local control = tcp.metadata
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    previous.next_operation = next
  else
    control.output_head = next
  end
  if next then
    next.previous_operation = previous
  else
    control.output_tail = previous
  end
  if control.output_current == operation then
    control.output_current = nil
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.owner = nil
  operation.prepared_buffer = nil
  operation.linked = false
end

local function enqueue_tcp_close_waiter(tcp: uv_tcp_t,
                                        operation: NetOperation)
  local control = tcp.metadata
  local previous? = control.close_waiter_tail
  operation.previous_operation = previous
  operation.next_operation = nil
  if previous then
    previous.next_operation = operation
  else
    control.close_waiter_head = operation
  end
  control.close_waiter_tail = operation
  operation.linked = true
  operation.close_waiter = true
end

local function remove_tcp_close_waiter(tcp: uv_tcp_t,
                                       operation: NetOperation)
  if not operation.linked or not operation.close_waiter then return end
  local control = tcp.metadata
  local previous? = operation.previous_operation
  local next? = operation.next_operation
  if previous then
    previous.next_operation = next
  else
    control.close_waiter_head = next
  end
  if next then
    next.previous_operation = previous
  else
    control.close_waiter_tail = previous
  end
  operation.previous_operation = nil
  operation.next_operation = nil
  operation.linked = false
  operation.close_waiter = false
end

local function enqueue_accepted(server: uv_tcp_t, client: uv_tcp_t): boolean
  local control = server.metadata
  if control.accept_count >= control.accept_capacity then return false end
  control.accept_tail = control.accept_tail % control.accept_capacity + 1
  control.accept_queue[control.accept_tail] = client
  control.accept_count = control.accept_count + 1
  return true
end

local function dequeue_accepted(server: uv_tcp_t): uv_tcp_t
  local control = server.metadata
  if control.accept_count == 0 then
    raise "cannot dequeue from an empty Server accept queue"
  end
  local raw? = control.accept_queue[control.accept_head]
  control.accept_queue[control.accept_head] = nil
  control.accept_head = control.accept_head % control.accept_capacity + 1
  control.accept_count = control.accept_count - 1
  return raw
end

local function new_net_control(runtime: Runtime, kind: integer,
                               operation: NetOperation): NetRequestControl
  local control: NetRequestControl = {
    runtime = runtime,
    lifecycle = NET_OWNER_ALLOCATED,
    kind = kind,
    owner = nil,
    operation = operation,
    next_control = nil,
    previous_control = nil,
    result_pointer = nil,
  }
  return control
end

local function allocate_dns_owner(runtime: Runtime,
                                  operation: NetOperation):
                                  (uv_getaddrinfo_t,
                                   ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_getaddrinfo_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_DNS, operation)
  local owner: uv_getaddrinfo_t = {
    handle = memory as *libuv.uv_getaddrinfo_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = dns_dispatch,
    metadata = control,
    buffer = nil,
  }
  -- Root and derive the raw callback navigation pointer before publishing the
  -- request control.  No allocating Titan helper runs between publication and
  -- the one libuv submit call.
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_net_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_connect_owner(runtime: Runtime,
                                      operation: NetOperation):
                                      (uv_connect_t,
                                       ffi.titan_ffi_void_ptr)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_connect_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local control = new_net_control(runtime, NET_OWNER_CONNECT, operation)
  local owner: uv_connect_t = {
    handle = memory as *libuv.uv_connect_t,
    storage = storage,
    main_thread = main_thread,
    dispatcher = connect_dispatch,
    metadata = control,
    buffer = nil,
  }
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  control.owner = owner
  link_net_control(runtime, control)
  lua.lua_settop(L, top)
  return owner, pointer
end

local function allocate_write_owner(runtime: Runtime,
                                    operation: NetOperation):
                                    (uv_write_t,
                                     ffi.titan_ffi_void_ptr)
