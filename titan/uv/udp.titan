-- UDP contributor. Shared foundation changes are in integration.patch only.
foreign type UDPAllocEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, size_t, *uv_buf_t): void
foreign type UDPRecvEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, ssize_t, const *uv_buf_t, const *sockaddr, unsigned int): void
foreign type UDPSendEntry = function (*lua_State, *Udata, *CClosure, *Udata, *Udata, int): void

--- Tagged membership values for native operations.
-- @field LEAVE_GROUP Leave group variant.
-- @field JOIN_GROUP Join group variant.
-- @usage uv/types.md#membership
union membership
  LEAVE_GROUP()
  JOIN_GROUP()
end

local function membership_native(member: membership): foreign uv_membership
  case member
  when LEAVE_GROUP() then return ffi.UV_LEAVE_GROUP
  when JOIN_GROUP() then return ffi.UV_JOIN_GROUP
  end
end

--- Immutable native libuv UDP_IPV6ONLY flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_IPV6ONLY: integer?
--- Immutable native libuv UDP_PARTIAL flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_PARTIAL: integer?
--- Immutable native libuv UDP_REUSEADDR flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_REUSEADDR: integer?
--- Immutable native libuv UDP_MMSG_CHUNK flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_MMSG_CHUNK: integer?
--- Immutable native libuv UDP_MMSG_FREE flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_MMSG_FREE: integer?
--- Immutable native libuv UDP_LINUX_RECVERR flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_LINUX_RECVERR: integer?
--- Immutable native libuv UDP_REUSEPORT flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_REUSEPORT: integer?
--- Immutable native libuv UDP_RECVMMSG flag or numeric constant.
-- @usage uv/types.md#public-constants
const UDP_RECVMMSG: integer?

--- Concrete udp handle owner; initialize before use and close explicitly.
-- @usage uv/types.md#udp_t
record udp_t
  local native: foreign uv_udp_t
  local phase: integer
  local loop: loop_t?
  local alloc_callback: (function (handle_t, integer): (buf_t))?
  local recv_callback: (function (udp_t, integer, buf_t?, sockaddr_t?, integer): ())?
  local close_callback: (function (handle_t): ())?
  local recv_buffer: buf_t?
  local alloc_handler: function (udp_t, loop_t, foreign size_t, foreign *uv_buf_t): ()
  local recv_handler: function (udp_t, loop_t, foreign ssize_t, foreign const *uv_buf_t, foreign const *sockaddr, foreign unsigned int): ()
  local close_handler: function (udp_t, loop_t): ()
  local userdata: value
end

--- Reusable native udp send request owner retained through accepted completion.
-- @usage uv/types.md#udp_send_t
record udp_send_t
  local native: foreign uv_udp_send_t
  local loop: loop_t?
  local pending: boolean
  local handle: udp_t?
  local buffers: {buf_t}?
  local native_buffers: (owned uv_buf_t[])?
  local callback: (function (udp_send_t, integer): ())?
  local handler: function (udp_send_t, loop_t, foreign int): ()
  local userdata: value
end

local function udp_allocate(owner: udp_t, loop: loop_t, suggested: foreign size_t,
                            output: foreign *uv_buf_t)
  -- Native output starts empty, including every allocation/conversion failure.
  output.base = nil
  output.len = 0
  owner.recv_buffer = nil
  local callback = owner.alloc_callback
  local buffer = callback(handle_t.udp(owner), suggested as integer)
  if not buffer.writable then raise "UDP receive buffer must be writable" end
  owner.recv_buffer = buffer
  output[0] = buffer.native[0]
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function udp_receive(owner: udp_t, loop: loop_t, nread: foreign ssize_t,
                           native: foreign const *uv_buf_t,
                           address: foreign const *sockaddr,
                           flags: foreign unsigned int)
  local retained? = owner.recv_buffer
  -- CHUNK borrows part of the original allocation; the terminal FREE/error
  -- retires that borrow before user delivery. A stopped recvmmsg batch may omit
  -- FREE; recv_stop retains the allocation until the next alloc or close.
  if (flags as integer & UDP_MMSG_CHUNK) == 0 then owner.recv_buffer = nil end
  local buffer: buf_t? = nil
  if native ~= nil and native.base ~= nil and retained ~= nil then
    local offset = (native.base - retained.native.base) as integer
    buffer = retained:slice(offset + 1, native.len as integer)
  end
  local copied? = sockaddr_copy(address)
  local callback? = owner.recv_callback
  if callback ~= nil then callback(owner, nread as integer, buffer, copied, flags as integer) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function udp_closed(owner: udp_t, loop: loop_t)
  loop.handles[owner] = nil
  owner.phase = HANDLE_RETIRED
  -- Keep the original loop observable through close; init replaces it.
  local callback? = owner.close_callback
  owner.alloc_callback = nil
  owner.recv_callback = nil
  owner.close_callback = nil
  owner.recv_buffer = nil
  if callback ~= nil then callback(handle_t.udp(owner)) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local function udp_sent(owner: udp_send_t, loop: loop_t, status: foreign int)
  loop.requests[owner] = nil
  owner.pending = false
  owner.loop = nil
  -- Keep the old buffer closure through actual callback return, independent
  -- of the new fields installed if user code resubmits this same request.
  local retained? = owner.buffers
  local native? = owner.native_buffers
  local callback? = owner.callback
  owner.buffers = nil
  owner.native_buffers = nil
  owner.callback = nil
  if callback ~= nil then callback(owner, status as integer) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function udp_alloc_callback(base: *uv_handle_t, suggested: size_t, output: *uv_buf_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "udp_t", "alloc_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign UDPAllocEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, suggested, output)
  ffi.lua_settop(L, top)
end

local foreign function udp_recv_callback(native: *uv_udp_t, nread: ssize_t, buffer: const *uv_buf_t, address: const *sockaddr, flags: unsigned int)
  local owner = ffi.uv_handle_get_data(native as foreign *uv_handle_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(native as foreign *uv_handle_t)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "udp_t", "recv_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign UDPRecvEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, nread, buffer, address, flags)
  ffi.lua_settop(L, top)
end

local foreign function udp_close_callback(base: *uv_handle_t)
  local owner = ffi.uv_handle_get_data(base) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(base)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "udp_t", "close_handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign CallbackEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop)
  ffi.lua_settop(L, top)
end

local foreign function udp_send_callback(native: *uv_udp_send_t, status: int)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(ffi.uv_handle_get_loop(native.handle as foreign *uv_handle_t)) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(ffi.titan_record_field(owner, "udp_send_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign UDPSendEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status)
  ffi.lua_settop(L, top)
end

--- Allocate a concrete handle owner without initializing its native lifetime.
-- @return Native udp_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#udp_tnew
function udp_t.new(): udp_t
  local native = foreign uv_udp_t.new()
  return {native = native, phase = HANDLE_FRESH, loop = nil,
          alloc_callback = nil, recv_callback = nil, close_callback = nil,
          recv_buffer = nil, alloc_handler = udp_allocate,
          recv_handler = udp_receive, close_handler = udp_closed, userdata = nil}
end

--- Return a tagged view of the same concrete owner.
-- @return Native handle_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#udp_tas_handle_t
function udp_t:as_handle_t(): handle_t
  return handle_t.udp(self)
end

local function udp_t:usable(): boolean
  return self.phase == HANDLE_LIVE and ffi.uv_is_closing(self.native as foreign *uv_handle_t) == 0
end

--- Initialize UDP with native family/receive-mode flags, including recvmmsg where supported.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param handle Mutable final udp_t owner in fresh or retired state, before this native initialization; successful initialization establishes a close obligation.
-- @param flags Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_init_ex
function udp_init_ex(loop: loop_t, handle: udp_t, flags: integer): integer
  if not loop.initialized or handle.phase == HANDLE_LIVE then return ffi.UV_EINVAL end
  local native_flags = flags as foreign unsigned int
  loop.handles[handle] = true
  handle.loop = loop
  local status = ffi.uv_udp_init_ex(loop.native, handle.native, native_flags) as integer
  if status < 0 then loop.handles[handle] = nil; handle.loop = nil; return status end
  handle.phase = HANDLE_LIVE
  ffi.uv_handle_set_data(handle.native as foreign *uv_handle_t, handle as foreign *void)
  return status
end

--- Initialize a UDP handle; bind/connect/send can later create or select its socket.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param handle Mutable final udp_t owner in fresh or retired state, before this native initialization; successful initialization establishes a close obligation.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_init
function udp_init(loop: loop_t, handle: udp_t): integer
  return udp_init_ex(loop, handle, 0)
end

--- Adopt an existing socket into a UDP handle.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param socket Input exact-width borrowed native identifier token; collecting the token never closes/adopts its resource; see this operation's transfer rule.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_open
function udp_open(handle: udp_t, socket: os_sock_t): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_socket = socket.native
  return ffi.uv_udp_open(handle.native, native_socket)
end

--- Adopt an existing UDP socket with the explicit native adoption flags.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param socket Input exact-width borrowed native identifier token; collecting the token never closes/adopts its resource; see this operation's transfer rule.
-- @param flags Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_open_ex
function udp_open_ex(handle: udp_t, socket: os_sock_t, flags: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_socket = socket.native
  local native_flags = flags as foreign unsigned int
  return ffi.uv_udp_open_ex(handle.native, native_socket, native_flags)
end

--- Bind a UDP handle to a typed local address with the requested binding flags.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @param flags Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_bind
function udp_bind(handle: udp_t, address: sockaddr_t, flags: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_flags = flags as foreign unsigned int
  local native_address = address:pointer()
  return ffi.uv_udp_bind(handle.native, native_address, native_flags)
end

--- Set a default UDP peer; nil disconnects that peer according to native semantics.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_connect
function udp_connect(handle: udp_t, address: sockaddr_t?): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_address: foreign *sockaddr = nil
  if address ~= nil then native_address = address:pointer() end
  return ffi.uv_udp_connect(handle.native, native_address)
end

--- Return `(status, copied_peer_address?, native_length)` for the connected peer.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained sockaddr_t result, or nil on failure or absence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/udp.md#udp_getpeername
function udp_getpeername(handle: udp_t): (integer, sockaddr_t?, integer)
  if not handle:usable() then return ffi.UV_EINVAL, nil, 0 end
  local native = foreign sockaddr_storage.new()
  local length = foreign int.new_array(1)
  length[0] = foreign sockaddr_storage.sizeof as foreign int
  local status = ffi.uv_udp_getpeername(handle.native, native as foreign *sockaddr, length) as integer
  if status < 0 then return status, nil, length[0] as integer end
  return status, sockaddr_copy_sized(native as foreign const *sockaddr, length[0] as integer), length[0] as integer
end

--- Return `(status, copied_local_address?, native_length)` for the socket's bound endpoint.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained sockaddr_t result, or nil on failure or absence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/udp.md#udp_getsockname
function udp_getsockname(handle: udp_t): (integer, sockaddr_t?, integer)
  if not handle:usable() then return ffi.UV_EINVAL, nil, 0 end
  local native = foreign sockaddr_storage.new()
  local length = foreign int.new_array(1)
  length[0] = foreign sockaddr_storage.sizeof as foreign int
  local status = ffi.uv_udp_getsockname(handle.native, native as foreign *sockaddr, length) as integer
  if status < 0 then return status, nil, length[0] as integer end
  return status, sockaddr_copy_sized(native as foreign const *sockaddr, length[0] as integer), length[0] as integer
end

--- Join or leave a multicast group using the typed membership value and an optional interface address.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param multicast_addr Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param interface_addr Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param member Input membership value.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_membership
function udp_set_membership(handle: udp_t, multicast_addr: string,
                            interface_addr: string?, member: membership): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_member = membership_native(member)
  local native_interface: foreign const *char = nil
  if interface_addr ~= nil then native_interface = interface_addr as foreign const *char end
  return ffi.uv_udp_set_membership(handle.native, multicast_addr, native_interface, native_member)
end

--- Join or leave a source-specific multicast group; group, interface and source strings identify the membership.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param multicast_addr Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param interface_addr Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param source_addr Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param member Input membership value.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_source_membership
function udp_set_source_membership(handle: udp_t, multicast_addr: string,
                                   interface_addr: string?, source_addr: string,
                                   member: membership): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_member = membership_native(member)
  local native_interface: foreign const *char = nil
  if interface_addr ~= nil then native_interface = interface_addr as foreign const *char end
  return ffi.uv_udp_set_source_membership(handle.native, multicast_addr, native_interface, source_addr, native_member)
end

--- Select the interface used for outbound multicast; nil selects native default behavior.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param interface_addr Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_multicast_interface
function udp_set_multicast_interface(handle: udp_t, interface_addr: string?): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_interface: foreign const *char = nil
  if interface_addr ~= nil then native_interface = interface_addr as foreign const *char end
  return ffi.uv_udp_set_multicast_interface(handle.native, native_interface)
end

--- Enable or disable loopback of outbound multicast datagrams to local receivers.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param on Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_multicast_loop
function udp_set_multicast_loop(handle: udp_t, on: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_value = on as foreign int
  return ffi.uv_udp_set_multicast_loop(handle.native, native_value)
end

--- Set the multicast hop limit/TTL using the native accepted range.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param ttl Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_multicast_ttl
function udp_set_multicast_ttl(handle: udp_t, ttl: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_value = ttl as foreign int
  return ffi.uv_udp_set_multicast_ttl(handle.native, native_value)
end

--- Enable or disable broadcast transmission.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param on Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_broadcast
function udp_set_broadcast(handle: udp_t, on: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_value = on as foreign int
  return ffi.uv_udp_set_broadcast(handle.native, native_value)
end

--- Set the unicast datagram hop limit/TTL using the native accepted range.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param ttl Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_set_ttl
function udp_set_ttl(handle: udp_t, ttl: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local native_value = ttl as foreign int
  return ffi.uv_udp_set_ttl(handle.native, native_value)
end

--- Allocate a fresh request owner without submitting work.
-- @return Native udp_send_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#udp_send_tnew
function udp_send_t.new(): udp_send_t
  local native = foreign uv_udp_send_t.new()
  return {native = native, loop = nil, pending = false, handle = nil,
          buffers = nil, native_buffers = nil, callback = nil,
          handler = udp_sent, userdata = nil}
end

--- Return a tagged view of the same concrete owner.
-- @return Native req_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#udp_send_tas_req_t
function udp_send_t:as_req_t(): req_t
  return req_t.udp_send(self)
end

--- Return the retained stream/handle association for this request, or nil when none is recorded.
-- @return Copied or retained udp_t result, or nil on failure or absence.
-- @usage uv/supplemental.md#udp_send_tget_handle
function udp_send_t:get_handle(): udp_t?
  return self.handle
end

--- Submit one datagram from a nonempty buffer vector.
-- @param request Mutable allocated nonpending request owner; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param buffers Input byte owner or vector; immutable strings are valid only for input; async submission snapshots descriptors and retains owners, so Array edits cannot alter accepted I/O; do not mutate borrowed byte contents before completion.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_send
function udp_send(request: udp_send_t, handle: udp_t, buffers: {buf_t},
                  address: sockaddr_t?, callback: (function (udp_send_t, integer): ())?): integer
  if request.pending then return ffi.UV_EBUSY end
  if not handle:usable() then return ffi.UV_EINVAL end
  -- Unix libuv asserts on zero vectors in assertion-enabled builds. A single
  -- zero-length buffer is a valid empty datagram and remains accepted.
  if #buffers == 0 then return ffi.UV_EINVAL end
  local status, native?, retained? = fs_buffer_snapshot(buffers, false)
  if status < 0 then return status end
  local native_data = (native as owned uv_buf_t[]) as foreign *uv_buf_t
  local native_count = #(retained as {buf_t}) as foreign unsigned int
  local native_address: foreign *sockaddr = nil
  if address ~= nil then native_address = address:pointer() end
  local loop = handle.loop
  loop.requests[request] = true
  request.pending = true
  request.loop = loop
  request.handle = handle
  request.buffers = retained
  request.native_buffers = native
  request.callback = callback
  ffi.uv_req_set_data(request.native as foreign *uv_req_t, request as foreign *void)
  local result = ffi.uv_udp_send(request.native, handle.native, native_data,
      native_count, native_address, udp_send_callback) as integer
  if result < 0 then
    loop.requests[request] = nil
    request.pending = false
    request.loop = nil
    request.handle = nil
    request.buffers = nil
    request.native_buffers = nil
    request.callback = nil
  end
  return result
end

--- Send one datagram immediately without queuing a request.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param buffers Input byte owner or vector; immutable strings are valid only for input; async submission snapshots descriptors and retains owners, so Array edits cannot alter accepted I/O; do not mutate borrowed byte contents before completion.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_try_send
function udp_try_send(handle: udp_t, buffers: {buf_t}, address: sockaddr_t?): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local status, native?, retained? = fs_buffer_snapshot(buffers, false)
  if status < 0 then return status end
  local native_data = (native as owned uv_buf_t[]) as foreign *uv_buf_t
  local native_count = #(retained as {buf_t}) as foreign unsigned int
  local native_address: foreign *sockaddr = nil
  if address ~= nil then native_address = address:pointer() end
  return ffi.uv_udp_try_send(handle.native, native_data, native_count, native_address)
end

--- Immediately send a nonempty batch of datagrams using parallel buffer/address Arrays.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param buffers Input byte owner or vector; immutable strings are valid only for input; async submission snapshots descriptors and retains owners, so Array edits cannot alter accepted I/O; do not mutate borrowed byte contents before completion.
-- @param addresses Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @param flags Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_try_send2
function udp_try_send2(handle: udp_t, buffers: {{buf_t}}, addresses: {sockaddr_t?}, flags: integer): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local count = #buffers
  if count > ffi.UINT_MAX as integer or #addresses > count then return ffi.UV_EINVAL end
  local native_count = count as foreign unsigned int
  local native_flags = flags as foreign unsigned int
  local vectors = foreign (*uv_buf_t).new_array(count)
  local lengths = foreign unsigned int.new_array(count)
  local destinations = foreign (*sockaddr).new_array(count)
  local native_buffers: {owned uv_buf_t[]} = {}
  local retained: {{buf_t}} = {}
  local retained_addresses: {sockaddr_t?} = {}
  for i = 1, count do
    local status, native?, roots? = fs_buffer_snapshot(buffers[i], false)
    if status < 0 then return status end
    local exact_native = native as owned uv_buf_t[]
    local exact_roots = roots as {buf_t}
    native_buffers[i] = exact_native
    retained[i] = exact_roots
    vectors[i - 1] = exact_native as foreign *uv_buf_t
    lengths[i - 1] = #exact_roots as foreign unsigned int
    local address? = addresses[i]
    retained_addresses[i] = address
    destinations[i - 1] = nil
    if address ~= nil then destinations[i - 1] = address:pointer() end
  end
  return ffi.uv_udp_try_send2(handle.native, native_count, vectors, lengths, destinations, native_flags)
end

--- Start datagram reception with writable allocation and receive callbacks.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @param alloc_callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @param recv_callback Input ordinary callable, retained until the promised callback interval ends; callback argument owners are borrowed views retained through callback return.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_recv_start
function udp_recv_start(handle: udp_t, alloc_callback: function (handle_t, integer): (buf_t),
                        recv_callback: function (udp_t, integer, buf_t?, sockaddr_t?, integer): ()): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local status = ffi.uv_udp_recv_start(handle.native, udp_alloc_callback, udp_recv_callback) as integer
  if status == 0 then
    handle.alloc_callback = alloc_callback
    handle.recv_callback = recv_callback
  end
  return status
end

--- Stop native reception without closing the socket.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_recv_stop
function udp_recv_stop(handle: udp_t): integer
  if not handle:usable() then return ffi.UV_EINVAL end
  local status = ffi.uv_udp_recv_stop(handle.native) as integer
  if status == 0 then handle.alloc_callback = nil; handle.recv_callback = nil end
  return status
end

--- Report whether this handle actually uses native recvmmsg reception, independent of requested flags.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native boolean result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_using_recvmmsg
function udp_using_recvmmsg(handle: udp_t): boolean
  if not handle:usable() then return false end
  return ffi.uv_udp_using_recvmmsg(handle.native) ~= 0
end

--- Return bytes currently queued for UDP sending.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_get_send_queue_size
function udp_get_send_queue_size(handle: udp_t): integer
  if not handle:usable() then raise "UDP handle is not initialized or closing" end
  return (ffi.uv_udp_get_send_queue_size(handle.native) as foreign lua_Integer) as integer
end

--- Return requests currently queued for UDP sending.
-- @param handle Mutable initialized udp_t owner/view; mutations preserve its single owner and reserved native data slot; close completion ends native handle lifetime.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/udp.md#udp_get_send_queue_count
function udp_get_send_queue_count(handle: udp_t): integer
  if not handle:usable() then raise "UDP handle is not initialized or closing" end
  return (ffi.uv_udp_get_send_queue_count(handle.native) as foreign lua_Integer) as integer
end

