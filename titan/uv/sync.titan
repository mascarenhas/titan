-- Candidate only: ordinary calls belong to the owning Lua thread.
-- Borrowed C helpers operate solely on native storage; retain each owner
-- through all worker uses and join before destroy/delete. No finalizers.
foreign import "sync_storage.h"

local const SYNC_FRESH = 0
local const SYNC_LIVE = 1
local const SYNC_RETIRED = 2

--- Owned native mutex storage with explicit initialization and destruction.
-- @usage uv/types.md#mutex_t
record mutex_t
    local const storage: foreign titan_issue194_mutex_storage
    local state: integer
end

--- Allocate stable native storage without initializing it.
-- @return Native mutex_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#mutex_tnew
function mutex_t.new(): mutex_t
    local storage = foreign titan_issue194_mutex_storage.new()
    return { storage = storage, state = SYNC_FRESH }
end

local function mutex_t:require_live()
    if self.state ~= SYNC_LIVE then raise "uv.mutex: not initialized or already destroyed" end
end

local function mutex_t:require_fresh()
    if self.state ~= SYNC_FRESH then raise "uv.mutex: initialization requires fresh owner" end
end

--- Borrow an opaque pointer to stable native storage for a C-only carrier.
-- @return Native foreign *void result with the documented lifetime and units.
-- @usage uv/supplemental.md#mutex_tborrow
function mutex_t:borrow(): foreign *void
    self:require_live()
    return self.storage
end

--- Convenience method for [`mutex_init`](functions/threading.md#mutex_init) on this owner.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#mutex_tinit
function mutex_t:init(): integer
    self:require_fresh()
    local status: integer = ffi.uv_mutex_init(self.storage as foreign *uv_mutex_t)
    if status == 0 then self.state = SYNC_LIVE end
    return status
end

--- Convenience method for [`mutex_init_recursive`](functions/threading.md#mutex_init_recursive) on this owner.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#mutex_tinit_recursive
function mutex_t:init_recursive(): integer
    self:require_fresh()
    local status: integer = ffi.uv_mutex_init_recursive(self.storage as foreign *uv_mutex_t)
    if status == 0 then self.state = SYNC_LIVE end
    return status
end

--- Convenience method for [`mutex_destroy`](functions/threading.md#mutex_destroy) on this owner.
-- @usage uv/supplemental.md#mutex_tdestroy
function mutex_t:destroy()
    self:require_live()
    ffi.uv_mutex_destroy(self.storage as foreign *uv_mutex_t)
    self.state = SYNC_RETIRED
end

--- Convenience method for [`mutex_lock`](functions/threading.md#mutex_lock) on this owner.
-- @usage uv/supplemental.md#mutex_tlock
function mutex_t:lock()
    self:require_live()
    ffi.uv_mutex_lock(self.storage as foreign *uv_mutex_t)
end

foreign function native_mutex_lock(native: *void): void
    ffi.uv_mutex_lock(native as foreign *uv_mutex_t)
end

--- Return the exact C-only native entry for this operation.
-- @return Native foreign function(*void): void result with the documented lifetime and units.
-- @usage uv/supplemental.md#mutex_tlock_function
function mutex_t.lock_function(): foreign function(*void): void
    return native_mutex_lock
end

--- Convenience method for [`mutex_trylock`](functions/threading.md#mutex_trylock) on this owner.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/supplemental.md#mutex_ttrylock
function mutex_t:trylock(): integer
    self:require_live()
    return ffi.uv_mutex_trylock(self.storage as foreign *uv_mutex_t)
end

