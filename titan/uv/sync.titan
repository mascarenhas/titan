function key_t:set(value: foreign *void)
    self:require_live()
    ffi.uv_key_set(self.storage as foreign *uv_key_t, value)
end

foreign function native_key_get(key: *void): *void
    return ffi.uv_key_get(key as foreign *uv_key_t)
end

foreign function native_key_set(key: *void, value: *void): void
    ffi.uv_key_set(key as foreign *uv_key_t, value)
end

--- Return the exact C-only native entry for this operation.
-- @return Native foreign function(*void): *void result with the documented lifetime and units.
-- @usage uv/supplemental.md#key_tget_function
function key_t.get_function(): foreign function(*void): *void
    return native_key_get
end

--- Return the exact C-only native entry for this operation.
-- @return Native foreign function(*void, *void): void result with the documented lifetime and units.
-- @usage uv/supplemental.md#key_tset_function
function key_t.set_function(): foreign function(*void, *void): void
    return native_key_set
end

-- Canonical native-prefix-drop module functions.
--- Initialize a nonrecursive mutex.
-- @param owner Mutable fresh final mutex_t() storage; explicit destroy/delete after native users retire.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/threading.md#mutex_init
function mutex_init(owner: mutex_t): integer
    return owner:init()
end

--- Initialize a mutex permitting repeated lock by its current native-thread owner.
-- @param owner Mutable fresh final mutex_t() storage; explicit destroy/delete after native users retire.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/threading.md#mutex_init_recursive
function mutex_init_recursive(owner: mutex_t): integer
    return owner:init_recursive()
end

--- Destroy the initialized mutex after every native user is quiescent.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#mutex_destroy
function mutex_destroy(owner: mutex_t)
    owner:destroy()
end

--- Block the OS thread until the mutex can be acquired.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#mutex_lock
function mutex_lock(owner: mutex_t)
    owner:lock()
end

--- Attempt immediate mutex acquisition; zero acquires it and a native busy/error result leaves it unacquired.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/threading.md#mutex_trylock
function mutex_trylock(owner: mutex_t): integer
    return owner:trylock()
end

--- Release one matching mutex acquisition by the owning native thread.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#mutex_unlock
function mutex_unlock(owner: mutex_t)
    owner:unlock()
end

--- Initialize a native reader/writer lock.
-- @param owner Mutable fresh final rwlock_t() storage; explicit destroy/delete after native users retire.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/threading.md#rwlock_init
function rwlock_init(owner: rwlock_t): integer
    return owner:init()
end

--- Destroy the initialized rwlock after every native user is quiescent.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#rwlock_destroy
function rwlock_destroy(owner: rwlock_t)
    owner:destroy()
end

--- Block until a read-side lock is acquired.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#rwlock_rdlock
function rwlock_rdlock(owner: rwlock_t)
    owner:rdlock()
end

--- Attempt immediate read-side acquisition and return native success/busy status.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/threading.md#rwlock_tryrdlock
function rwlock_tryrdlock(owner: rwlock_t): integer
    return owner:tryrdlock()
end

--- Release a matching read-side acquisition.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#rwlock_rdunlock
function rwlock_rdunlock(owner: rwlock_t)
    owner:rdunlock()
end

--- Block until the exclusive write-side lock is acquired.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#rwlock_wrlock
function rwlock_wrlock(owner: rwlock_t)
    owner:wrlock()
end

--- Attempt immediate exclusive write-side acquisition and return native success/busy status.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/threading.md#rwlock_trywrlock
function rwlock_trywrlock(owner: rwlock_t): integer
    return owner:trywrlock()
end

--- Release a matching write-side acquisition.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @usage uv/functions/threading.md#rwlock_wrunlock
function rwlock_wrunlock(owner: rwlock_t)
    owner:wrunlock()
