--- Return the raw value associated with this key on the calling native thread; nil is the null pointer.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @return Native foreign *void result with the documented lifetime and units.
-- @usage uv/functions/threading.md#key_get
function key_get(owner: key_t): foreign *void
    return owner:get()
end

--- Store a raw pointer for this key on the calling native thread.
-- @param owner Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @param value Input borrowed native address for explicit C-only/TLS interop; no automatic GC ownership.
-- @usage uv/functions/threading.md#key_set
function key_set(owner: key_t, value: foreign *void)
    owner:set(value)
end

-- The guard is initialized in final packed storage using UV_ONCE_INIT. It has
-- no destroy operation and cannot be reset; allocate a new owner for a new guard.
--- Native once-initialization storage retaining its explicit guard owner.
-- @usage uv/types.md#once_t
record once_t
    local const storage: foreign titan_issue194_once_storage
end

--- Allocate stable native once storage with its initial once state.
-- @return Native once_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#once_tnew
function once_t.new(): once_t
    local storage = foreign titan_issue194_once_storage.new()
    local owner: once_t = { storage = storage }
    ffi.titan_issue194_once_init(owner.storage)
    return owner
end

--- Borrow an opaque pointer to stable native storage for a C-only carrier.
-- @return Native foreign *void result with the documented lifetime and units.
-- @usage uv/supplemental.md#once_tborrow
function once_t:borrow(): foreign *void
    return self.storage
end

--- Invoke one C-only callback exactly once for the once_t guard, with native cross-thread synchronization.
-- @param guard Mutable initialized native synchronization owner; caller coordinates external native users and lifetime; destroy/delete only after quiescence.
-- @param callback Input C-only entry; no calling-state Lua/Titan execution from a native worker/once callback.
-- @usage uv/functions/threading.md#once
function once(guard: once_t, callback: foreign function(): void)
    if not callback then raise "uv.once: callback is null" end
    ffi.uv_once(guard.storage as foreign *uv_once_t, callback)
end

foreign function native_once(guard: *void, callback: function(): void): void
    ffi.uv_once(guard as foreign *uv_once_t, callback)
end

--- Return the C-only native once entry.
-- @return Native foreign function(*void, function(): void): void result with the documented lifetime and units.
-- @usage uv/supplemental.md#once_function
function once_function(): foreign function(*void, function(): void): void
    return native_once
end
