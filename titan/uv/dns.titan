foreign type GetaddrinfoEntry = function (
    *lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer, *addrinfo): void
foreign type GetnameinfoEntry = function (
    *lua_State, *Udata, *CClosure, *Udata, *Udata, lua_Integer,
    const *char, const *char): void

-- These external socket domains are integer-valued system macros, not libuv
-- enums. Flags remain combinable integers. Initializers merge into root do.
--- Immutable native libuv AF_UNSPEC flag or numeric constant.
-- @usage uv/types.md#public-constants
const AF_UNSPEC: integer?
