--- Flags, family, socket type, and protocol constraining address resolution.
-- @field ai_flags Ai flags in the copied native result.
-- @field ai_family Ai family in the copied native result.
-- @field ai_socktype Ai socktype in the copied native result.
-- @field ai_protocol Ai protocol in the copied native result.
-- @usage uv/types.md#addrinfo_hints_t
record addrinfo_hints_t
  ai_flags: integer
  ai_family: integer
  ai_socktype: integer
  ai_protocol: integer
end

-- Each entry is an independent copied value. Array ordering replaces ai_next.
-- ai_addr_bytes/ai_addrlen preserve even unknown native address families.
--- A copied resolver entry retaining address bytes and canonical-name data.
-- @field ai_flags entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @field ai_family entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @field ai_socktype entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @field ai_protocol entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @field ai_addrlen entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @field ai_addr entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @field ai_addr_bytes Ai addr bytes in the copied native result.
-- @field ai_canonname entries() copies scalar fields, the optional name, sockaddr value and exact address bytes into independent public records. These survive freeaddrinfo of the separate native result owner.
-- @usage uv/types.md#addrinfo_t
record addrinfo_t
  ai_flags: integer
  ai_family: integer
  ai_socktype: integer
  ai_protocol: integer
  ai_addrlen: integer
  ai_addr: sockaddr_t?
  ai_addr_bytes: string?
  ai_canonname: string?
end

--- An owned resolver result requiring explicit freeaddrinfo cleanup.
-- @usage uv/types.md#addrinfo_result_t
record addrinfo_result_t
  local native: foreign *addrinfo
  local copied: {addrinfo_t}?
  local released: boolean
end

--- Return the cached or newly copied address entries in native resolver order.
-- @return Native {addrinfo_t} result with the documented lifetime and units.
-- @usage uv/supplemental.md#addrinfo_result_tentries
function addrinfo_result_t:entries(): {addrinfo_t}
  if self.released then raise "addrinfo result was released" end
  if self.copied ~= nil then return self.copied as {addrinfo_t} end
  local entries: {addrinfo_t} = {}
  local node = self.native
  while node ~= nil do
    local address: sockaddr_t? = nil
    local bytes: string? = nil
    local canonical: string? = nil
    local size = node.ai_addrlen as integer
    if node.ai_addr ~= nil then
      -- Do not infer all addresses are IPv4/IPv6 or truncate opaque outputs.
      local raw: owned unsigned char[] = foreign unsigned char.new_array(size)
      ffi.memcpy(raw, node.ai_addr, size as foreign size_t)
      bytes = raw as string
      address = sockaddr_copy_sized(node.ai_addr, size)
    end
    if node.ai_canonname ~= nil then canonical = node.ai_canonname as string end
    entries[#entries + 1] = addrinfo_t {
      ai_flags = node.ai_flags as integer,
      ai_family = node.ai_family as integer,
      ai_socktype = node.ai_socktype as integer,
      ai_protocol = node.ai_protocol as integer,
      ai_addrlen = size, ai_addr = address, ai_addr_bytes = bytes,
      ai_canonname = canonical,
    }
    node = node.ai_next
  end
  self.copied = entries
  return entries
end

--- Free the native address-list result; nil is allowed.
-- @param result Mutable separately owned native DNS result; freeaddrinfo releases native list explicitly; copied entries remain ordinary values.
-- @usage uv/functions/dns.md#freeaddrinfo
function freeaddrinfo(result: addrinfo_result_t?)
  if result == nil then return end
  local owner = result as addrinfo_result_t
  if owner.released then return end
  ffi.uv_freeaddrinfo(owner.native)
  owner.native = nil
  owner.released = true
end

--- Reusable native getaddrinfo request owner retained through accepted completion.
-- @usage uv/types.md#getaddrinfo_t
record getaddrinfo_t
  local native: foreign uv_getaddrinfo_t
  local loop: loop_t?
  local pending: boolean
  local result: addrinfo_result_t?
  local result_status: integer
  local callback: (function (getaddrinfo_t, integer, addrinfo_result_t?): ())?
  local handler: function (getaddrinfo_t, loop_t, integer, foreign *addrinfo): ()
  local userdata: value
end

local function getaddrinfo_deliver(owner: getaddrinfo_t, loop: loop_t,
                                   status: integer, native: foreign *addrinfo)
  -- Commit the independently owned native allocation before anything can raise.
  -- It remains reachable from request:addrinfo() even if copying fails.
  local result = owner.result as addrinfo_result_t
  result.native = native
  owner.result_status = status
  loop.requests[owner] = nil
  owner.pending = false
  local callback? = owner.callback
  owner.callback = nil
  local output: addrinfo_result_t? = nil
  if status == 0 then
    output = result
    result:entries()
  end
  if callback ~= nil then callback(owner, status, output) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function getaddrinfo_callback(native: *uv_getaddrinfo_t,
                                       status: int, result: *addrinfo)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(native.loop) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "getaddrinfo_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign GetaddrinfoEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer, result)
  ffi.lua_settop(L, top)
end

--- Allocate a fresh request owner without submitting work.
-- @return Native getaddrinfo_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#getaddrinfo_tnew
function getaddrinfo_t.new(): getaddrinfo_t
  local native = foreign uv_getaddrinfo_t.new()
  return { native = native, loop = nil, pending = false, result = nil,
           result_status = 0, callback = nil, handler = getaddrinfo_deliver,
           userdata = nil }
end

--- Return a tagged view of the same concrete owner.
-- @return Native req_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#getaddrinfo_tas_req_t
function getaddrinfo_t:as_req_t(): req_t
  return req_t.getaddrinfo(self)
end

--- Read the same traced public data as the generic request accessor without allocating a request view.
-- @return Native value result with the documented lifetime and units.
-- @usage uv/supplemental.md#getaddrinfo_tget_data
function getaddrinfo_t:get_data(): value
  return self.userdata
end

--- Replace the existing traced public data slot; nil clears it.
-- @param data Caller-supplied data retained or borrowed for the documented native interval.
-- @usage uv/supplemental.md#getaddrinfo_tset_data
function getaddrinfo_t:set_data(data: value)
  self.userdata = data
end

--- Return the request's recorded loop association, or nil when none is recorded.
-- @return Copied or retained loop_t result, or nil on failure or absence.
-- @usage uv/supplemental.md#getaddrinfo_tget_loop
function getaddrinfo_t:get_loop(): loop_t?
  return self.loop
end

--- Return the retained native completion status and optional address-result owner.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained addrinfo_result_t result, or nil on failure or absence.
-- @usage uv/supplemental.md#getaddrinfo_taddrinfo
function getaddrinfo_t:addrinfo(): (integer, addrinfo_result_t?)
  if self.pending then return ffi.UV_EBUSY, nil end
  if self.result_status ~= 0 then return self.result_status, nil end
  return self.result_status, self.result
end

--- Resolve optional node/service with optional hints.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; the request view remains rooted through callback return; a successful addrinfo_result_t is a separate native list with explicit freeaddrinfo lifetime.
-- @param node Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param service Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param hints Input addrinfo_hints_t? value.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/dns.md#getaddrinfo
function getaddrinfo(loop: loop_t, request: getaddrinfo_t,
    callback: (function (getaddrinfo_t, integer, addrinfo_result_t?): ())?,
    node: string?, service: string?, hints: addrinfo_hints_t?): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  if request.pending then return ffi.UV_EBUSY end
  local native_node: foreign const *char = nil
  local native_service: foreign const *char = nil
  if node ~= nil then native_node = node as string end
  if service ~= nil then native_service = service as string end
  local native_hints = foreign addrinfo.new()
  local hints_pointer: foreign const *addrinfo = nil
  if hints ~= nil then
    native_hints.ai_flags = hints.ai_flags as foreign int
    native_hints.ai_family = hints.ai_family as foreign int
    native_hints.ai_socktype = hints.ai_socktype as foreign int
    native_hints.ai_protocol = hints.ai_protocol as foreign int
    hints_pointer = native_hints
  end
  local result = addrinfo_result_t(nil, nil, false)
  local native_callback: foreign uv_getaddrinfo_cb = nil
  if callback ~= nil then
    native_callback = getaddrinfo_callback
    loop.requests[request] = true
  end
  request.result = result
  request.result_status = 0
  local previous_loop? = request.loop
  request.loop = loop
  request.callback = callback
  request.pending = callback ~= nil
  ffi.uv_req_set_data(request.native as foreign *uv_req_t,
                      request as foreign *void)
  local status = ffi.uv_getaddrinfo(loop.native, request.native,
      native_callback, native_node, native_service, hints_pointer) as integer
  -- No allocating helper/callable adaptation after native acceptance.
  if callback == nil then
    request.result_status = status
    -- A synchronous lookup failure may still initialize the native request;
    -- validation/allocation rejection may leave its previous loop untouched.
    if request.native.loop ~= loop.native then request.loop = previous_loop end
    if status == 0 then result.native = request.native.addrinfo end
  elseif status < 0 then
    loop.requests[request] = nil
    request.pending = false
    request.loop = previous_loop
    request.callback = nil
    request.result_status = status
  end
  return status
end

--- Reusable native getnameinfo request owner retained through accepted completion.
-- @usage uv/types.md#getnameinfo_t
record getnameinfo_t
  local native: foreign uv_getnameinfo_t
  local loop: loop_t?
  local pending: boolean
  local result_status: integer
  local completed: boolean
  local callback: (function (getnameinfo_t, integer, string?, string?): ())?
  local handler: function (getnameinfo_t, loop_t, integer,
                           foreign const *char, foreign const *char): ()
  local userdata: value
end

local function getnameinfo_deliver(owner: getnameinfo_t, loop: loop_t,
    status: integer, hostname: foreign const *char, service: foreign const *char)
  loop.requests[owner] = nil
  owner.pending = false
  owner.completed = true
  owner.result_status = status
  local callback? = owner.callback
  owner.callback = nil
  -- Copy both request-borrowed strings before user code may reuse request.
  local copied_host: string? = nil
  local copied_service: string? = nil
  if hostname ~= nil then copied_host = hostname as string end
  if service ~= nil then copied_service = service as string end
  if callback ~= nil then callback(owner, status, copied_host, copied_service) end
catch
  if loop.failure_count == 0 then
    loop.failure_error = error
    loop.failure_trace = traceback
  end
  loop.failure_count = loop.failure_count + 1
  ffi.uv_stop(loop.native)
end

local foreign function getnameinfo_callback(native: *uv_getnameinfo_t, status: int,
    hostname: const *char, service: const *char)
  local owner = ffi.uv_req_get_data(native as foreign *uv_req_t) as foreign *Udata
  local loop = ffi.uv_loop_get_data(native.loop) as foreign *Udata
  local L = ffi.titan_record_field(loop, "loop_t", "state")
  local handler = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "getnameinfo_t", "handler"))
  local module = ffi.lmacro_uvalue(handler.upvalue[0])
  local entry = ffi.lmacro_pvalue(handler.upvalue[2]) as foreign GetnameinfoEntry
  local top = ffi.lua_gettop(L)
  ffi.titan_uv_push_owner(L, owner)
  entry(L, module, handler, owner, loop, status as foreign lua_Integer,
        hostname, service)
  ffi.lua_settop(L, top)
end

--- Allocate a fresh request owner without submitting work.
-- @return Native getnameinfo_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#getnameinfo_tnew
function getnameinfo_t.new(): getnameinfo_t
  local native = foreign uv_getnameinfo_t.new()
  return { native = native, loop = nil, pending = false, result_status = 0,
           completed = false, callback = nil, handler = getnameinfo_deliver,
           userdata = nil }
end

--- Return a tagged view of the same concrete owner.
-- @return Native req_t result with the documented lifetime and units.
-- @usage uv/supplemental.md#getnameinfo_tas_req_t
function getnameinfo_t:as_req_t(): req_t
  return req_t.getnameinfo(self)
end

--- Return the request's recorded loop association, or nil when none is recorded.
-- @return Copied or retained loop_t result, or nil on failure or absence.
-- @usage uv/supplemental.md#getnameinfo_tget_loop
function getnameinfo_t:get_loop(): loop_t?
  return self.loop
end

--- Return the saved status and copied hostname/service results.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @return Copied or retained string result, or nil on failure or absence.
-- @usage uv/supplemental.md#getnameinfo_tresult
function getnameinfo_t:result(): (integer, string?, string?)
  if self.pending then return ffi.UV_EBUSY, nil, nil end
  if not self.completed then return ffi.UV_EINVAL, nil, nil end
  if self.result_status < 0 then return self.result_status, nil, nil end
  return self.result_status,
      (self.native.host as foreign *char) as string,
      (self.native.service as foreign *char) as string
end

--- Resolve the typed address to host/service strings under the supplied NI_* flags.
-- @param loop Input initialized owning loop; accepted handles/requests retain it through retirement.
-- @param request Mutable allocated nonpending request owner; accepted submission retains owner until its terminal callback returns; rejection owes no async callback.
-- @param callback Input ordinary callable, retained until the promised callback interval ends; the request view remains rooted through callback return; host/service arguments are copied strings.
-- @param address Input complete typed address owner; no sockaddr pointer/header required; constructor/accessors encode family/port/bytes.
-- @param flags Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/dns.md#getnameinfo
function getnameinfo(loop: loop_t, request: getnameinfo_t,
    callback: (function (getnameinfo_t, integer, string?, string?): ())?,
    address: sockaddr_t, flags: integer): integer
  if not loop.initialized then return ffi.UV_EINVAL end
  if request.pending then return ffi.UV_EBUSY end
  local native_flags = flags as foreign int
  local native_address = address:pointer()
  local native_callback: foreign uv_getnameinfo_cb = nil
  if callback ~= nil then
    native_callback = getnameinfo_callback
    loop.requests[request] = true
  end
  local previous_loop? = request.loop
  request.loop = loop
  request.callback = callback
  request.pending = callback ~= nil
  request.completed = false
  ffi.uv_req_set_data(request.native as foreign *uv_req_t,
                      request as foreign *void)
  local status = ffi.uv_getnameinfo(loop.native, request.native,
      native_callback, native_address, native_flags) as integer
  if callback == nil then
    request.result_status = status
    request.completed = true
    if request.native.loop ~= loop.native then request.loop = previous_loop end
  elseif status < 0 then
    loop.requests[request] = nil
    request.pending = false
    request.loop = previous_loop
    request.callback = nil
    request.result_status = status
  end
  return status
end
