-- Authored isolated misc-data contributor candidate for titan.uv.
foreign import "uv.h"
foreign import "data_native.h"

--- Copied native cpu times data exposed without C-header types.
-- @field user Independent copied counter in milliseconds; native cpu_info storage is freed internally before return.
-- @field nice Independent copied counter in milliseconds; native cpu_info storage is freed internally before return.
-- @field sys Independent copied counter in milliseconds; native cpu_info storage is freed internally before return.
-- @field idle Independent copied counter in milliseconds; native cpu_info storage is freed internally before return.
-- @field irq Independent copied counter in milliseconds; native cpu_info storage is freed internally before return.
-- @usage uv/types.md#cpu_times_t
record cpu_times_t
  user: integer
  nice: integer
  sys: integer
  idle: integer
  irq: integer
end

--- Copied native cpu info data exposed without C-header types.
-- @field model Independent copied record; nullable model string and nested cpu_times survive internal native cleanup. speed is MHz.
-- @field speed Independent copied record; nullable model string and nested cpu_times survive internal native cleanup. speed is MHz.
-- @field cpu_times Independent copied record; nullable model string and nested cpu_times survive internal native cleanup. speed is MHz.
-- @usage uv/types.md#cpu_info_t
record cpu_info_t
  model: string?
  speed: integer
  cpu_times: cpu_times_t
end

--- Copied native interface address data exposed without C-header types.
-- @field name Independent copied name, six physical-address bytes, scalar flag and typed address/netmask values. Internal native cleanup occurs before return.
-- @field phys_addr Independent copied name, six physical-address bytes, scalar flag and typed address/netmask values. Internal native cleanup occurs before return.
-- @field is_internal Independent copied name, six physical-address bytes, scalar flag and typed address/netmask values. Internal native cleanup occurs before return.
-- @field address Address in the copied native result.
-- @field netmask Netmask in the copied native result.
-- @usage uv/types.md#interface_address_t
record interface_address_t
  name: string
  phys_addr: string
  is_internal: boolean
  address: sockaddr_t
  netmask: sockaddr_t?
end

--- Copied native env item data exposed without C-header types.
-- @field name Copied name/value strings independent of native environment allocation and later environment changes; no public free is required.
-- @field value Copied name/value strings independent of native environment allocation and later environment changes; no public free is required.
-- @usage uv/types.md#env_item_t
record env_item_t
  name: string
  value: string
end

--- Copied native passwd data exposed without C-header types.
-- @field username Independent copied strings and numeric IDs; internal native cleanup occurs before return. shell may be nil on Windows.
-- @field uid Independent copied strings and numeric IDs; internal native cleanup occurs before return. shell may be nil on Windows.
-- @field gid Independent copied strings and numeric IDs; internal native cleanup occurs before return. shell may be nil on Windows.
-- @field shell Independent copied strings and numeric IDs; internal native cleanup occurs before return. shell may be nil on Windows.
-- @field homedir Independent copied strings and numeric IDs; internal native cleanup occurs before return. shell may be nil on Windows.
-- @usage uv/types.md#passwd_t
record passwd_t
  username: string
  uid: integer
  gid: integer
  shell: string?
  homedir: string
end

--- Copied native group data exposed without C-header types.
-- @field groupname Independent copied group name, ID and Array of member strings. Internal native cleanup occurs before return.
-- @field gid Independent copied group name, ID and Array of member strings. Internal native cleanup occurs before return.
-- @field members Independent copied group name, ID and Array of member strings. Internal native cleanup occurs before return.
-- @usage uv/types.md#group_t
record group_t
  groupname: string
  gid: integer
  members: {string}
end

local function data_u64(value: foreign uint64_t): integer
  return value as foreign lua_Integer
end

local function data_nullable_string(pointer: foreign const *char): string?
  if not pointer then return nil end
  return pointer as string
end

local function data_copy_bytes(pointer: foreign const *char, length: integer): string
  local bytes = foreign char.new_array(length)
  if length > 0 then ffi.memcpy(bytes, pointer, length) end
  return bytes as string
end

--- Return status, a copied CPU-info Array, and native count.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained {cpu_info_t} result, or nil on failure or absence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/misc.md#cpu_info
function cpu_info(): (integer, {cpu_info_t}?, integer)
  local native: foreign *uv_cpu_info_t = nil
  local count: foreign int = 0
  local status: integer = ffi.uv_cpu_info(native, count)
  if status ~= 0 then return status, nil, count end
  defer ffi.uv_free_cpu_info(native, count)
  local result: {cpu_info_t} = {}
  local length: integer = count
  for index = 1, length do
    local entry = native[index - 1]
    result[index] = cpu_info_t {
      model = data_nullable_string(entry.model),
      speed = entry.speed,
      cpu_times = cpu_times_t {
        user = data_u64(entry.cpu_times.user),
        nice = data_u64(entry.cpu_times.nice),
        sys = data_u64(entry.cpu_times.sys),
        idle = data_u64(entry.cpu_times.idle),
        irq = data_u64(entry.cpu_times.irq),
      },
    }
  end
  return status, result, count
end

local function data_copy_address(entry: foreign *uv_interface_address_t,
                                  netmask: boolean): sockaddr_t?
  local select: foreign int = 0
  if netmask then select = 1 end
  local native = ffi.titan_uv_data_address(entry, select)
  if native.sa_family == ffi.AF_UNSPEC then return nil end
  return sockaddr_copy(native)
end

--- Return status, a copied interface-address Array, and native count.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained {interface_address_t} result, or nil on failure or absence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/misc.md#interface_addresses
function interface_addresses(): (integer, {interface_address_t}?, integer)
  local native: foreign *uv_interface_address_t = nil
  local count: foreign int = 0
  local status: integer = ffi.uv_interface_addresses(native, count)
  if status ~= 0 then return status, nil, count end
  defer ffi.uv_free_interface_addresses(native, count)
  local result: {interface_address_t} = {}
  local length: integer = count
  for index = 1, length do
    local entry = native + (index - 1)
    result[index] = interface_address_t {
      name = entry.name as string,
      phys_addr = data_copy_bytes(entry.phys_addr, 6),
      is_internal = entry.is_internal ~= 0,
      address = data_copy_address(entry, false),
      netmask = data_copy_address(entry, true),
    }
  end
  return status, result, count
end

--- Copy all native environment entries into a Titan Array and return status/Array/count.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained {env_item_t} result, or nil on failure or absence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/misc.md#os_environ
function os_environ(): (integer, {env_item_t}?, integer)
  local native: foreign *uv_env_item_t = nil
  local count: foreign int = 0
  local status: integer = ffi.uv_os_environ(native, count)
  if status ~= 0 then return status, nil, count end
  defer ffi.uv_os_free_environ(native, count)
  local result: {env_item_t} = {}
  local length: integer = count
  for index = 1, length do
    local entry = native[index - 1]
    result[index] = env_item_t(entry.name as string, entry.value as string)
  end
  return status, result, count
end

local function data_copy_passwd(native: foreign const *uv_passwd_t): passwd_t
  return passwd_t {
    username = native.username as string,
    uid = data_u64(native.uid as foreign uint64_t),
    gid = data_u64(native.gid as foreign uint64_t),
    shell = data_nullable_string(native.shell),
    homedir = native.homedir as string,
  }
end

--- Look up the current effective user and return a copied passwd record; native strings are freed internally.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained passwd_t result, or nil on failure or absence.
-- @usage uv/functions/misc.md#os_get_passwd
function os_get_passwd(): (integer, passwd_t?)
  local native = foreign uv_passwd_t.new()
  local status: integer = ffi.uv_os_get_passwd(native)
  if status ~= 0 then return status, nil end
  defer ffi.uv_os_free_passwd(native)
  return status, data_copy_passwd(native)
end

--- Look up uid and return a copied passwd record; native strings are freed internally.
-- @param uid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained passwd_t result, or nil on failure or absence.
-- @usage uv/functions/misc.md#os_get_passwd2
function os_get_passwd2(uid: integer): (integer, passwd_t?)
  local native = foreign uv_passwd_t.new()
  local status: integer = ffi.uv_os_get_passwd2(native, uid)
  if status ~= 0 then return status, nil end
  defer ffi.uv_os_free_passwd(native)
  return status, data_copy_passwd(native)
end

--- Look up gid and return a copied group record including members; native snapshot storage is freed internally.
-- @param gid Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained group_t result, or nil on failure or absence.
-- @usage uv/functions/misc.md#os_get_group
function os_get_group(gid: integer): (integer, group_t?)
  local native = foreign uv_group_t.new()
  local status: integer = ffi.uv_os_get_group(native, gid)
  if status ~= 0 then return status, nil end
  defer ffi.uv_os_free_group(native)
  local members: {string} = {}
  local index = 0
  while native.members[index] do
    members[index + 1] = native.members[index] as string
    index = index + 1
  end
  return status, group_t {
    groupname = native.groupname as string,
    gid = data_u64(native.gid as foreign uint64_t),
    members = members,
  }
end

local function data_utf16_input(units: {integer}, length: integer): owned uint16_t[]
  if length < -1 or length > #units then raise "UTF-16 input length is out of range" end
  local count = #units
  if length >= 0 then count = length end
  local native: owned uint16_t[] = foreign uint16_t.new_array(count + 1)
  for index = 1, count do
    native[index - 1] = units[index]
    if length == -1 and units[index] == 0 then break end
  end
  -- Zero-initialized extra unit makes the -1 form safely NUL terminated.
  return native
end

--- Measure WTF-8 bytes required for the UTF-16 input units.
-- @param units Input {integer} value; checked native narrowing occurs before native ownership is accepted.
-- @param length Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/misc.md#utf16_length_as_wtf8
function utf16_length_as_wtf8(units: {integer}, length: integer): integer
  local native = data_utf16_input(units, length)
  return ffi.uv_utf16_length_as_wtf8(native, length)
end

--- Convert UTF-16 input units into copied WTF-8 bytes, with an optional explicit output capacity; return status, optional output, and native output length.
-- @param units Input {integer} value; checked native narrowing occurs before native ownership is accepted.
-- @param length Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @param capacity Input integer? value; checked native narrowing occurs before native ownership is accepted.
-- @return Native status: zero on success, a negative libuv error on failure.
-- @return Copied or retained string result, or nil on failure or absence.
-- @return Native operation result or submission status; negative values report libuv errors.
-- @usage uv/functions/misc.md#utf16_to_wtf8
function utf16_to_wtf8(units: {integer}, length: integer,
                        capacity: integer?): (integer, string?, integer)
  local native = data_utf16_input(units, length)
  local size: foreign size_t = 0
  if capacity == nil then
    local status: integer = ffi.uv_utf16_to_wtf8(native, length, nil, size)
    return status, nil, size
  end
  local count: integer = capacity
  if count < 0 or count == 9223372036854775807 then
    raise "WTF-8 output capacity is out of range"
  end
  size = count
  local output = foreign char.new_array(count + 1)
  local pointer: foreign *char = output
  local status: integer = ffi.uv_utf16_to_wtf8(native, length, pointer, size)
  local written: integer = size
  if status == ffi.UV_ENOBUFS then written = count end
  if status ~= 0 and status ~= ffi.UV_ENOBUFS then return status, nil, size end
  return status, data_copy_bytes(pointer, written), size
end

--- Measure the UTF-16 code units needed for WTF-8 text using native conversion semantics.
-- @param text Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @return Native integer result with the documented lifetime and units.
-- @usage uv/functions/misc.md#wtf8_length_as_utf16
function wtf8_length_as_utf16(text: string): integer
  return ffi.uv_wtf8_length_as_utf16(text)
end

--- Convert exactly length bytes of WTF-8 text to copied UTF-16 code units.
-- @param text Input immutable text/byte owner; native C-string conventions apply where the operation takes text.
-- @param length Input integer value; checked native narrowing occurs before native ownership is accepted.
-- @return Native {integer} result with the documented lifetime and units.
-- @usage uv/functions/misc.md#wtf8_to_utf16
function wtf8_to_utf16(text: string, length: integer): {integer}
  local required: integer = ffi.uv_wtf8_length_as_utf16(text)
  if required < 0 then raise "invalid WTF-8 input" end
  if length ~= required then raise "UTF-16 output length must match the native required length" end
  local native = foreign uint16_t.new_array(length)
  ffi.uv_wtf8_to_utf16(text, native, length)
  local result: {integer} = {}
  for index = 1, length do result[index] = native[index - 1] as integer end
  return result
end
