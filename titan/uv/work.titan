-- The libuv worker thread may inspect only this raw C carrier. Slot zero is
-- reserved for the loop-thread callback; the worker reads only the function
-- and argument in slots one and two.
local type WorkPointer = *void
local type WorkFunction = foreign (*void) -> ()

local record WorkCall
  local carrier: owned WorkPointer[]
end

-- Task.pending roots this complete owner from accepted submission through the
-- after-work callback. The raw carrier separately gives the worker a C-only
-- view that contains no TValue fields.
local record WorkOwner
  local request: owned *libuv.uv_work_t
  local carrier: owned WorkPointer[]
  local callback: (WorkOwner, integer) -> ()
end

foreign function uv_work_cb(req: *libuv.uv_work_t)
  local carrier = libuv.uv_req_get_data(
      req as *libuv.uv_req_t) as *WorkPointer
  local f = carrier[1] as WorkFunction
  local arg = carrier[2]
  f(arg)
end

foreign function uv_after_work_cb(req: *libuv.uv_work_t, status: int)
  local carrier = libuv.uv_req_get_data(
      req as *libuv.uv_req_t) as *WorkPointer
  local owner = carrier[0] as *ffi.Udata
  local callback = ffi.lmacro_clCvalue(owner.uv[2].uv)
  local L = libuv.uv_loop_get_data(req.loop) as *lua.lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as UvIntegerCallbackEntry
  local top = lua.lua_gettop(L)
  entry(L, module, callback, owner, status as lua.lua_Integer)
  lua.lua_settop(L, top)
end

local function complete_work(task: Task, status: integer)
  if status == 0 then
    resume_task_from_callback(task, false, nil)
  else
    resume_task_from_callback(
        task, true, make_error(status, "async.run_foreign"))
  end
catch
  fail_task_at_callback_boundary(task, error, traceback)
end

local function WorkCall:dispatch(task: Task): Immediate?
  accepting_work(task.runtime, "async.run_foreign")
  local native: owned *libuv.uv_work_t = libuv.uv_work_t.new()
  local callback = function (_owner: WorkOwner, status: integer)
    complete_work(task, status)
  end
  local owner = WorkOwner.new(native, self.carrier, callback)
  local request: *libuv.uv_work_t = native

  self.carrier[0] = owner as WorkPointer
  libuv.uv_req_set_data(
      request as *libuv.uv_req_t, self.carrier as WorkPointer)
  task.pending = owner

  local status = libuv.uv_queue_work(
      task.runtime.loop, request, uv_work_cb, uv_after_work_cb)
  if status == 0 then return nil end
  task.pending = nil
  return immediate_error(status, "async.run_foreign")
end

local function WorkCall.from_callback(f: WorkFunction,
                                      arg: WorkPointer): WorkCall
  if not f then raise "async.run_foreign callback must not be NULL" end

  local carrier: owned WorkPointer[] = WorkPointer.new_array(3)
  carrier[0] = nil
  carrier[1] = f as WorkPointer
  carrier[2] = arg
  return WorkCall.new(carrier)
end

local function run_foreign(f: WorkFunction, arg: WorkPointer)
  await(Call.run_foreign(WorkCall.from_callback(f, arg)))
end

-- Source collaborators use this only to retire native ownership: close,
-- finalize, reset, or dispose an unpublished result. Like the existing close
-- Calls, both submission and ordinary completion survive pending cancellation.
-- It is deliberately absent from the public async surface.
local function run_foreign_cleanup(f: WorkFunction, arg: WorkPointer)
  await(Call.run_foreign_cleanup(WorkCall.from_callback(f, arg)))
end
