-- The libuv worker thread may inspect only this raw C carrier. Slot zero is
-- reserved for the loop-thread callback; the worker reads only the function
-- and argument in slots one and two.
foreign type WorkPointer = *void
foreign type WorkFunction = function (*void): void

local record WorkCall
  local f: foreign WorkFunction
  local arg: foreign WorkPointer
end

-- Task.pending roots this complete owner from accepted submission through the
-- after-work callback. The embedded request and trailing carrier share this
-- allocation; the worker receives only a C-only view of the carrier bytes.
local record WorkOwner
  local request: foreign uv_work_t
  local const carrier: foreign WorkPointer[]
  local callback: function (WorkOwner, integer): ()
end

foreign function uv_work_cb(req: *uv_work_t)
  local carrier = ffi.uv_req_get_data(
      req as foreign *uv_req_t) as foreign *WorkPointer
  local f = carrier[1] as foreign WorkFunction
  local arg = carrier[2]
  f(arg)
end

foreign function uv_after_work_cb(req: *uv_work_t, status: int)
  local carrier = ffi.uv_req_get_data(
      req as foreign *uv_req_t) as foreign *WorkPointer
  local owner = carrier[0] as foreign *Udata
  local callback = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "WorkOwner", "callback"))
  local L = ffi.uv_loop_get_data(req.loop) as foreign *lua_State
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry = ffi.lmacro_pvalue(
      callback.upvalue[2]) as foreign UvIntegerCallbackEntry
  local top = ffi.lua_gettop(L)
  entry(L, module, callback, owner, status as foreign lua_Integer)
  ffi.lua_settop(L, top)
end

local function complete_work(task: Task, status: integer)
  if status == 0 then
    resume_task_from_callback(task, false, nil)
  else
    resume_task_from_callback(
        task, true, make_error(status, "async.run_foreign"))
  end
catch
  fail_task_at_callback_boundary(task, error, traceback)
end

local function WorkCall:dispatch(task: Task): Immediate?
  accepting_work(task.runtime, "async.run_foreign")
  local callback = function (owner: WorkOwner, status: integer)
    -- Resumption clears Task.pending before it can collect. Libuv still owns
    -- the request until this callback returns, so retain its complete owner.
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    ffi.lua_pushtvalue(L, owner)
    complete_work(task, status)
  end
  local owner = WorkOwner(
      foreign uv_work_t.new(), foreign WorkPointer.new_array(3), callback)
  local request: foreign *uv_work_t = owner.request

  owner.carrier[0] = owner as foreign WorkPointer
  owner.carrier[1] = self.f as foreign WorkPointer
  owner.carrier[2] = self.arg
  ffi.uv_req_set_data(
      request as foreign *uv_req_t, owner.carrier as foreign WorkPointer)
  task.pending = owner

  local status = ffi.uv_queue_work(
      task.runtime.loop, request, uv_work_cb, uv_after_work_cb)
  if status == 0 then return nil end
  task.pending = nil
  return immediate_error(status, "async.run_foreign")
end

local function WorkCall.from_callback(f: foreign WorkFunction,
                                      arg: foreign WorkPointer): WorkCall
  if not f then raise "async.run_foreign callback must not be NULL" end

  return WorkCall(f, arg)
end

local function run_foreign(f: foreign WorkFunction, arg: foreign WorkPointer)
  await(Call.run_foreign(WorkCall.from_callback(f, arg)))
end

-- Source collaborators use this only to retire native ownership: close,
-- finalize, reset, or dispose an unpublished result. Like the existing close
-- Calls, both submission and ordinary completion survive pending cancellation.
-- It is deliberately absent from the public async surface.
local function run_foreign_cleanup(f: foreign WorkFunction, arg: foreign WorkPointer)
  await(Call.run_foreign_cleanup(WorkCall.from_callback(f, arg)))
end
