foreign import "string.h"
foreign import "llhttp.h"
foreign import "lua.h"

foreign type LlhttpDataCallbackEntry = function (*lua_State, *Udata, *CClosure, *Udata, const *char, size_t): int
foreign type LlhttpCallbackEntry = function (*lua_State, *Udata, *CClosure, *Udata): int

local EVENT_URL = 1
local EVENT_STATUS = 2
local EVENT_HEADER_FIELD = 3
local EVENT_HEADER_VALUE = 4
local EVENT_HEADER_VALUE_COMPLETE = 5
local EVENT_HEADERS_COMPLETE = 6
local EVENT_BODY = 7
local EVENT_MESSAGE_COMPLETE = 8

local record Event
  local kind: integer
  local text: string
  local method: integer
  local status: integer
  local major: integer
  local minor: integer
  local keep_alive: boolean
  local upgrade: boolean
end

-- The Parser owns stable inline llhttp storage and the exact traced closures
-- used by its synchronous native callbacks.
local record Parser
  local native: foreign llhttp_t
  local settings: foreign llhttp_settings_t
  local callback_state: foreign *lua_State
  local url_callback: function (Parser, foreign const *char, foreign size_t): (foreign int)
  local status_callback: function (Parser, foreign const *char, foreign size_t): (foreign int)
  local header_field_callback: function (Parser, foreign const *char, foreign size_t): (foreign int)
  local header_value_callback: function (Parser, foreign const *char, foreign size_t): (foreign int)
  local header_value_complete_callback: function (Parser): (foreign int)
  local headers_complete_callback: function (Parser): (foreign int)
  local body_callback: function (Parser, foreign const *char, foreign size_t): (foreign int)
  local message_complete_callback: function (Parser): (foreign int)
  local connection: io.ReaderWriterCloser
  local response_to_head: boolean
  local allow_upgrade: boolean
  local upgrade: boolean
  local header_limit: integer
  local header_bytes: integer
  local events: {Event}
  local callback_failed: boolean
  local callback_error: value
  local last_error: integer
  local input_excess: string
  local body_excess: string
  local body_chunks: {string}
  local body_index: integer
  local body_consumed: integer
  local parsed_headers: Headers
  local target_text: string
  local reason_text: string
  local header_name_text: string
  local header_contents_text: string
  local method_text: string
  local status_number: integer
  local major: integer
  local minor: integer
  local keep_alive: boolean
  local headers_complete: boolean
  local message_complete: boolean
  local transport_eof: boolean
  local input_seen: boolean
  local input_received: boolean
  local paused: boolean
  local closed: boolean
end

-- The compiler resolves field names to each native or traced storage location.
-- The Parser owner remains traced throughout each synchronous Titan entry call;
-- each callback restores the pre-callback Lua stack before returning its exact
-- C result.
foreign function llhttp_url_cb(
    parser: *llhttp_t, data: const *char,
    length: size_t): int
  local owner = parser.data as foreign *Udata
  local callback = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "Parser", "url_callback"))
  local L = ffi.titan_record_field(owner, "Parser", "callback_state")
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry =
    ffi.lmacro_pvalue(callback.upvalue[2]) as foreign LlhttpDataCallbackEntry
  local top = ffi.lua_gettop(L)
  local result = entry(L, module, callback, owner, data, length)
  ffi.lua_settop(L, top)
  return result
end

foreign function llhttp_status_cb(
    parser: *llhttp_t, data: const *char,
    length: size_t): int
  local owner = parser.data as foreign *Udata
  local callback = ffi.lmacro_clCvalue(
      ffi.titan_record_field(owner, "Parser", "status_callback"))
  local L = ffi.titan_record_field(owner, "Parser", "callback_state")
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry =
    ffi.lmacro_pvalue(callback.upvalue[2]) as foreign LlhttpDataCallbackEntry
  local top = ffi.lua_gettop(L)
  local result = entry(L, module, callback, owner, data, length)
  ffi.lua_settop(L, top)
  return result
end

