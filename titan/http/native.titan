      ffi.titan_record_field(owner, "Parser", "message_complete_callback"))
  local L = ffi.titan_record_field(owner, "Parser", "callback_state")
  local module = ffi.lmacro_uvalue(callback.upvalue[0])
  local entry =
    ffi.lmacro_pvalue(callback.upvalue[2]) as foreign LlhttpCallbackEntry
  local top = ffi.lua_gettop(L)
  local result = entry(L, module, callback, owner)
  ffi.lua_settop(L, top)
  return result
end

local function native_bytes(pointer: foreign const *char,
                            length: integer): string
  if length == 0 then return "" end
  local storage = foreign char.new_array(length)
  ffi.memcpy(storage as foreign *char, pointer,
                 length as foreign size_t)
  return storage as string
end

local function native_string(pointer: foreign const *char): string
  if pointer == nil then return "" end
  return native_bytes(pointer, ffi.strlen(pointer) as integer)
end

local function event(kind: integer, text: string): Event
  return Event {
    kind = kind,
    text = text,
    method = 0,
    status = 0,
    major = 0,
    minor = 0,
    keep_alive = false,
    upgrade = false,
  }
end

local function callback_failure(parser: Parser,
                                failure: value): foreign int
  parser.callback_failed = true
  parser.callback_error = failure
  return ffi.HPE_USER as foreign int
end

local function append_text_event(parser: Parser, kind: integer,
                                 pointer: foreign const *char,
                                 length: foreign size_t): foreign int
  do
    parser.events[#parser.events + 1] =
      event(kind, native_bytes(pointer, length as integer))
    return ffi.HPE_OK as foreign int
  catch
    return callback_failure(parser, error)
  end
end

local function url_callback(parser: Parser,
                            pointer: foreign const *char,
                            length: foreign size_t): foreign int
  return append_text_event(parser, EVENT_URL, pointer, length)
end

local function status_callback(parser: Parser,
                               pointer: foreign const *char,
                               length: foreign size_t): foreign int
  return append_text_event(parser, EVENT_STATUS, pointer, length)
end

local function header_field_callback(
    parser: Parser, pointer: foreign const *char,
    length: foreign size_t): foreign int
  return append_text_event(parser, EVENT_HEADER_FIELD, pointer, length)
end

local function header_value_callback(
    parser: Parser, pointer: foreign const *char,
    length: foreign size_t): foreign int
  return append_text_event(parser, EVENT_HEADER_VALUE, pointer, length)
end

local function header_value_complete_callback(
    parser: Parser): foreign int
  do
    parser.events[#parser.events + 1] =
      event(EVENT_HEADER_VALUE_COMPLETE, "")
    return ffi.HPE_OK as foreign int
  catch
    return callback_failure(parser, error)
  end
end

local function headers_complete_callback(
    parser: Parser): foreign int
  do
    parser.events[#parser.events + 1] = Event {
      kind = EVENT_HEADERS_COMPLETE,
      text = "",
      method = ffi.llhttp_get_method(parser.native) as integer,
      status = ffi.llhttp_get_status_code(parser.native) as integer,
      major = ffi.llhttp_get_http_major(parser.native) as integer,
      minor = ffi.llhttp_get_http_minor(parser.native) as integer,
      keep_alive = ffi.llhttp_should_keep_alive(parser.native) ~= 0,
      upgrade = ffi.llhttp_get_upgrade(parser.native) ~= 0,
    }
    -- llhttp's documented return 1 makes a response to HEAD bodyless. Its
    -- message-complete callback is still the synchronous pause boundary.
    if parser.response_to_head then return 1 as foreign int end
    return ffi.HPE_PAUSED as foreign int
  catch
    return callback_failure(parser, error)
  end
end

local function body_callback(parser: Parser,
                             pointer: foreign const *char,
                             length: foreign size_t): foreign int
  return append_text_event(parser, EVENT_BODY, pointer, length)
end

local function message_complete_callback(
    parser: Parser): foreign int
  do
    parser.events[#parser.events + 1] = Event {
      kind = EVENT_MESSAGE_COMPLETE,
      text = "",
      method = 0,
      status = 0,
      major = 0,
      minor = 0,
      keep_alive = ffi.llhttp_should_keep_alive(parser.native) ~= 0,
      upgrade = false,
    }
    return ffi.HPE_PAUSED as foreign int
  catch
    return callback_failure(parser, error)
  end
end

local function new_parser(connection: io.ReaderWriterCloser,
                          parser_type: foreign llhttp_type_t,
                          response_to_head: boolean): Parser
  local parser = Parser {
    native = foreign llhttp_t.new(),
    settings = foreign llhttp_settings_t.new(),
    callback_state = L,
    url_callback = url_callback,
    status_callback = status_callback,
    header_field_callback = header_field_callback,
    header_value_callback = header_value_callback,
    header_value_complete_callback = header_value_complete_callback,
    headers_complete_callback = headers_complete_callback,
    body_callback = body_callback,
    message_complete_callback = message_complete_callback,
    connection = connection,
    response_to_head = response_to_head,
    allow_upgrade = false,
    upgrade = false,
    header_limit = math.maxinteger,
    header_bytes = 0,
    events = {},
    callback_failed = false,
    callback_error = nil,
    last_error = ffi.HPE_OK,
    input_excess = "",
    body_excess = "",
    body_chunks = {},
    body_index = 1,
    body_consumed = 0,
    parsed_headers = headers(nil),
    target_text = "",
    reason_text = "",
    header_name_text = "",
    header_contents_text = "",
    method_text = "",
    status_number = 0,
    major = 0,
    minor = 0,
    keep_alive = false,
    headers_complete = false,
    message_complete = false,
    transport_eof = false,
    input_seen = false,
    input_received = false,
    paused = false,
    closed = false,
  }
  local settings = parser.settings
  ffi.llhttp_settings_init(settings)
  settings.on_url = llhttp_url_cb
  settings.on_status = llhttp_status_cb
  settings.on_header_field = llhttp_header_field_cb
  settings.on_header_value = llhttp_header_value_cb
  settings.on_header_value_complete = llhttp_header_value_complete_cb
  settings.on_headers_complete = llhttp_headers_complete_cb
  settings.on_body = llhttp_body_cb
  settings.on_message_complete = llhttp_message_complete_cb
  ffi.llhttp_init(parser.native, parser_type, settings)
  parser.native.data = parser as foreign *void
  return parser
end

local function new_request_parser(
    connection: io.ReaderWriterCloser): Parser
  local parser = new_parser(connection, ffi.HTTP_REQUEST, false)
  parser.allow_upgrade = true
  parser.header_limit = 65536
  return parser
end

local function new_response_parser(connection: io.ReaderWriterCloser,
                                   response_to_head: boolean): Parser
  return new_parser(connection, ffi.HTTP_RESPONSE, response_to_head)
end

local function parser_error(parser: Parser): string
  local code = parser.last_error as foreign llhttp_errno_t
  local name = native_string(ffi.llhttp_errno_name(code))
  local reason = native_string(
    ffi.llhttp_get_error_reason(parser.native))
  if #name == 0 then name = "HPE_UNKNOWN" end
  if #reason == 0 then return "HTTP parse error " .. name end
  return "HTTP parse error " .. name .. ": " .. reason
end

local function drain_events(parser: Parser)
  local events = parser.events
  parser.events = {}
  local index = 1
  while index <= #events do
    local queued = events[index]
    if queued.kind == EVENT_URL then
      parser.target_text = parser.target_text .. queued.text
    elseif queued.kind == EVENT_STATUS then
      parser.reason_text = parser.reason_text .. queued.text
    elseif queued.kind == EVENT_HEADER_FIELD then
      parser.header_name_text = parser.header_name_text .. queued.text
    elseif queued.kind == EVENT_HEADER_VALUE then
      parser.header_contents_text =
        parser.header_contents_text .. queued.text
    elseif queued.kind == EVENT_HEADER_VALUE_COMPLETE then
      parser.parsed_headers:add(
        parser.header_name_text,
        trim_header_value(parser.header_contents_text))
      parser.header_name_text = ""
      parser.header_contents_text = ""
    elseif queued.kind == EVENT_HEADERS_COMPLETE then
      parser.status_number = queued.status
      parser.major = queued.major
      parser.minor = queued.minor
      parser.keep_alive = queued.keep_alive
      parser.upgrade = queued.upgrade
      if queued.upgrade and not parser.allow_upgrade then
        raise "HTTP protocol upgrades are unsupported"
      end
      parser.method_text = native_string(
        ffi.llhttp_method_name(
          queued.method as foreign llhttp_method_t))
      parser.headers_complete = true
    elseif queued.kind == EVENT_BODY then
      parser.body_chunks[#parser.body_chunks + 1] = queued.text
    elseif queued.kind == EVENT_MESSAGE_COMPLETE then
      parser.keep_alive = queued.keep_alive
      parser.message_complete = true
    end
    index = index + 1
  end
end

local function raise_callback_failure(parser: Parser)
  if not parser.callback_failed then return end
  local failure = parser.callback_error
  parser.events = {}
  raise failure
end

local function execute_input(parser: Parser, input: string)
  -- Empty calls advance llhttp epsilon transitions and are not transport
  -- input. Every nonempty input means EOF while still awaiting headers is not
  -- idle, even when llhttp ignored it as a leading empty request line.
  if #input > 0 then
    parser.input_seen = true
    parser.input_received = true
  end
  parser.callback_state = L
  parser.callback_failed = false
  parser.callback_error = nil
  if ffi.lua_checkstack(L, ffi.LUA_MINSTACK) == 0 then
    raise "cannot reserve stack for HTTP parser callbacks"
  end
  local top = ffi.lua_gettop(L)
  -- llhttp borrows the input pointer while callbacks may allocate. Keep the
  -- immutable Titan string explicitly stack-rooted until execute, callback
  -- event construction, and consumed-suffix copying have all finished.
  ffi.lua_pushtvalue(L, input)
  defer ffi.lua_settop(L, top)
  local bytes = input as foreign const *char
  -- Limit the native span before callbacks copy attacker-controlled text.
  -- Count punctuation and leading lines as well as callback text. A headers
  -- pause stops counting before any coalesced upgraded-protocol suffix.
  local span = #input
  local opening = not parser.headers_complete
  if opening and span > parser.header_limit - parser.header_bytes then
    span = parser.header_limit - parser.header_bytes
  end
  local status = ffi.llhttp_execute(
    parser.native, bytes, span as foreign size_t)
  parser.last_error = status as integer
  local consumed = (function (
      parser: Parser, input: string, bytes: foreign const *char,
      status: foreign llhttp_errno_t, span: integer): integer
    if status == ffi.HPE_OK then return span end
    local position = ffi.llhttp_get_error_pos(parser.native)
    if position == nil then return 0 end
    if position < bytes or position > bytes + span then
      raise "HTTP parser reported an invalid consumed offset"
    end
    return (position - bytes) as integer
  end)(parser, input, bytes, status, span)
  if consumed < #input then
    parser.input_excess = string.sub(input, consumed + 1)
  end
  raise_callback_failure(parser)
  drain_events(parser)
  if opening then
    parser.header_bytes = parser.header_bytes + consumed
    if not parser.headers_complete and
        parser.header_bytes >= parser.header_limit then
      raise "HTTP start line and headers exceed the configured limit"
    end
  end
  if status == ffi.HPE_PAUSED_UPGRADE or
      status == ffi.HPE_PAUSED_H2_UPGRADE then
    raise "HTTP protocol upgrades are unsupported"
  elseif status == ffi.HPE_PAUSED then
    parser.paused = true
  elseif status ~= ffi.HPE_OK then
    raise parser_error(parser)
  end
end

local function finish_input(parser: Parser)
  parser.callback_state = L
  parser.callback_failed = false
  parser.callback_error = nil
  if ffi.lua_checkstack(L, ffi.LUA_MINSTACK) == 0 then
    raise "cannot reserve stack for HTTP parser callbacks"
  end
  local status = ffi.llhttp_finish(parser.native)
  parser.last_error = status as integer
  parser.transport_eof = true
  raise_callback_failure(parser)
  drain_events(parser)
  if status == ffi.HPE_PAUSED_UPGRADE or
      status == ffi.HPE_PAUSED_H2_UPGRADE then
    raise "HTTP protocol upgrades are unsupported"
  elseif status == ffi.HPE_PAUSED then
    parser.paused = true
  elseif status ~= ffi.HPE_OK then
    raise parser_error(parser)
  end
end

local function advance_parser(parser: Parser)
  if parser.closed then raise "HTTP parser is closed" end
  if parser.paused then
    ffi.llhttp_resume(parser.native)
    parser.paused = false
    -- A headers-complete pause can leave llhttp on an epsilon transition to
    -- message-complete (for example, a GET without a body).  When the header
    -- terminator was the final byte in the transport chunk, resume the parser
    -- with an empty input before waiting for another network read.  Otherwise
    -- both peers can wait forever: the application waits for a body that is
    -- already complete while the client waits for its response.
    if #parser.input_excess == 0 then
      execute_input(parser, "")
      if parser.paused or parser.message_complete then return end
    end
  end
  if #parser.input_excess > 0 then
    local input = parser.input_excess
    parser.input_excess = ""
    execute_input(parser, input)
    return
  end
  if parser.transport_eof then
    if not parser.message_complete then
      raise "HTTP message ended before it was complete"
    end
    return
  end
  local input? = parser.connection:read()
  if not input then
    finish_input(parser)
  else
    execute_input(parser, input as string)
  end
end

local function acquire_parser_headers(parser: Parser): boolean
  while not parser.headers_complete do
    -- Only EOF before any bytes of this message is an idle disconnect. Any
    -- input falls through to the existing incomplete-message error.
    if parser.transport_eof and not parser.input_seen then
      return false
    end
    advance_parser(parser)
  end
  return true
end

local function ensure_parser_headers(parser: Parser): boolean
  if not acquire_parser_headers(parser) then return false end
  if parser.major ~= 1 or parser.minor ~= 1 then
    raise "only HTTP/1.1 messages are supported"
  end
  return true
end

local function parser_read(parser: Parser): string?
  if #parser.body_excess > 0 then
    local result = parser.body_excess
    parser.body_excess = ""
    parser.body_consumed = parser.body_consumed + #result
    return result
  end
  while parser.body_index > #parser.body_chunks do
    if parser.message_complete then return nil end
    advance_parser(parser)
  end
  local result = parser.body_chunks[parser.body_index]
  parser.body_consumed = parser.body_consumed + #result
  parser.body_index = parser.body_index + 1
  if parser.body_index > #parser.body_chunks then
    parser.body_chunks = {}
    parser.body_index = 1
  end
  return result
end

local function parser_read_until(parser: Parser, delimiter: string,
                                  chop: boolean?): string?
  if #delimiter == 0 then raise "read delimiter must not be empty" end
  local builder = string.writer()
  local tail = ""
  while true do
    local chunk? = parser_read(parser)
    if not chunk then
      if #tail > 0 then builder:write(tail) end
      local result = builder:drain()
      if #result == 0 then return nil end
      return result
    end
    local boundary = tail .. (chunk as string)
    local match? = string.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(string.sub(boundary, 1, result_end))
      end
      parser.body_excess = string.sub(boundary, match_end + 1)
      parser.body_consumed = parser.body_consumed - #parser.body_excess
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      builder:write(string.sub(boundary, 1, committed))
    end
    tail = string.sub(boundary, committed + 1)
  end
  return nil
end

local function parser_reset_message(parser: Parser)
  if not parser.message_complete then
    raise "cannot reset an incomplete HTTP message"
  end
  ffi.llhttp_reset(parser.native)
  parser.events = {}
  parser.callback_failed = false
  parser.callback_error = nil
  parser.last_error = ffi.HPE_OK
  parser.body_excess = ""
  parser.body_chunks = {}
  parser.body_index = 1
  parser.body_consumed = 0
  parser.parsed_headers = headers(nil)
  parser.target_text = ""
  parser.reason_text = ""
  parser.header_name_text = ""
  parser.header_contents_text = ""
  parser.method_text = ""
  parser.status_number = 0
  parser.major = 0
  parser.minor = 0
  parser.keep_alive = false
  parser.upgrade = false
  parser.header_bytes = 0
  parser.headers_complete = false
  parser.message_complete = false
  parser.input_seen = false
  parser.paused = false
end

local function close_parser(parser: Parser)
  if parser.closed then return end
  parser.closed = true
  parser.events = {}
