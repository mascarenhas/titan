foreign import "errno.h"

--- Received response headers and an owned streaming response body.
-- @field status HTTP status number.
-- @field reason HTTP reason phrase.
-- @field headers Received headers, preserving duplicates and insertion order.
-- @field url Normalized URL of the final exchange, or nil when unavailable.
-- @field redirected Whether at least one redirect was followed.
-- @usage standard-library-http.md#client-requests
record ClientResponse
  status: integer
  reason: string
  headers: Headers
  url: string?
  redirected: boolean
  local const parser: Parser
  local const connection: io.ReaderWriterCloser
  local const abort: function (): ()
  local const client: Client?
  local const lease: ClientConnection?
  local const request_keep_alive: boolean
  local const body_length: integer?
  local upgrade_pending: boolean
  local closed: boolean
  local connection_closed: boolean
  local reading: boolean
end

local function client_connection(parsed_url: url.Url, ca_file: string?,
                                   key: string): ClientConnection
  if parsed_url.scheme == "https" then
    const secure = ssl.connect(parsed_url.host, parsed_url.port, ca_file)
    local adopted = false
    defer if not adopted then secure:abort() end
    const lease = ClientConnection(Transport(secure, secure:abort),
      secure:has_pending_input, secure:add_input_listener, nil, true, key, 0)
    adopted = true
    return lease
  end
  const plain = net.connect(parsed_url.host, parsed_url.port)
  local adopted = false
  defer if not adopted then plain:close() end
  const lease = ClientConnection(Transport(plain, plain:close),
    plain:has_pending_input, plain:add_input_listener, nil, false, key, 0)
  adopted = true
  return lease
end

local function client_request_headers(parsed_url: url.Url,
                                      supplied: Headers?,
                                      body: string?): Headers
  const result = copy_headers(supplied)
  const hosts = result:values("Host")
  if #hosts > 1 then raise "HTTP request has more than one Host header" end
  if #hosts == 0 then
    result:add("Host", parsed_url:host_header())
  else
    parse_request_url_or_raise(parsed_url.scheme, hosts[1], "/")
  end

  if #result:values("Transfer-Encoding") > 0 then
    raise "HTTP client requests do not support Transfer-Encoding"
  end
  if #result:values("Expect") > 0 then
    raise "HTTP client requests do not support Expect"
  end
  local body_length = 0
  if body then body_length = #body end
  const lengths = result:values("Content-Length")
  if #lengths > 1 then
    raise "HTTP request has more than one Content-Length header"
  elseif #lengths == 1 then
    if decimal_header(lengths[1], "HTTP Content-Length") ~= body_length then
      raise "HTTP Content-Length does not match the request body"
    end
  elseif body then
    result:add("Content-Length", string.tostring(body_length))
  end
  return result
end

local function final_response_headers(parser: Parser)
  while true do
    if not ensure_parser_headers(parser) then
      raise "HTTP message ended before it was complete"
    end
    if parser.status_number >= 200 then
      validate_reason(parser.reason_text)
      return
    end
    if parser.status_number < 100 then
      raise "HTTP server returned an invalid status code"
    end
    if parser.status_number == 101 then
      raise "HTTP protocol upgrades require request_upgrade_on"
    end
    validate_reason(parser.reason_text)
    while parser_read(parser) do end
    parser_reset_message(parser)
  end
end

local function response_body_length(parser: Parser): integer?
  if parser.response_to_head or parser.status_number == 204 or
      parser.status_number == 205 or parser.status_number == 304 then
    return 0
  end
  const length? = parser.parsed_headers:get("Content-Length")
  if length == nil then return nil end
  return decimal_header(length, "HTTP Content-Length")
catch
  -- llhttp admits unsigned lengths larger than Titan's signed integer range.
  -- Such a body can stream normally, but must never receive automatic drain.
  return math.maxinteger
end

local function stale_client_failure(failure: value): boolean
  if failure == "HTTP message ended before it was complete" then return true end
  if failure is async.OperationError then
    const problem: async.OperationError = failure
    return problem.name == "EPIPE" or problem.name == "ECONNRESET" or
      problem.name == "ENOTCONN" or problem.name == "ECONNABORTED"
  end
  if failure is ssl.Error then
    const problem: ssl.Error = failure
    return problem.name == "TLS_TRUNCATED_EOF"
  end
  return false
end

local function normalized_http_url(parsed: url.Url): string
  return parsed.scheme .. "://" .. parsed.authority .. parsed.target
end

local function request_policy_error(message: string): async.OperationError
  return async.OperationError(-ffi.EIO, "EIO", message, "http.request")
end

-- RFC 3986 section 5.2.4. Each output entry is one path segment, including
-- its leading slash, so removing a parent never reparses a growing string.
local function remove_dot_segments(path: string): string
  const segments: {string} = {}
  local index = 1
  while index <= #path do
    const remaining = #path - index + 1
    if string.sub(path, index, index + 2) == "../" then
      index = index + 3
    elseif string.sub(path, index, index + 1) == "./" then
      index = index + 2
    elseif string.sub(path, index, index + 2) == "/./" then
      index = index + 2
    elseif remaining == 2 and string.sub(path, index) == "/." then
      segments[#segments + 1] = "/"
      break
    elseif string.sub(path, index, index + 3) == "/../" or
        (remaining == 3 and string.sub(path, index) == "/..") then
      if #segments > 0 then segments[#segments] = nil end
      if remaining == 3 then
        segments[#segments + 1] = "/"
        break
      end
      index = index + 3
    elseif (remaining == 1 and string.sub(path, index) == ".") or
        (remaining == 2 and string.sub(path, index) == "..") then
      break
    else
      local start = index
      if string.byte(path, index) == 47 then start = start + 1 end
      const slash? = string.find(path, "/", start)
      const last = (slash or (#path + 1)) - 1
      segments[#segments + 1] = string.sub(path, index, last)
      index = last + 1
    end
  end
  const builder = string.writer()
  for index = 1, #segments do builder:write(segments[index]) end
  return builder:drain()
end

local function resolve_redirect(base: url.Url, location: string): url.Url
  local reference = trim_header_value(location)
  const fragment? = string.find(reference, "#", 1)
  if fragment then reference = string.sub(reference, 1, fragment - 1) end
  local query: string? = nil
  const question? = string.find(reference, "?", 1)
  if question then
    query = string.sub(reference, question + 1)
    reference = string.sub(reference, 1, question - 1)
  end
  local scheme: string? = nil
  const scheme_match? = string.match(reference, "^[A-Za-z][A-Za-z0-9+.-]*:")
  if scheme_match then
    const prefix = scheme_match:whole()
    scheme = string.sub(prefix, 1, #prefix - 1)
    reference = string.sub(reference, #prefix + 1)
  end
  local authority = base.authority
  local path = reference
  if string.sub(reference, 1, 2) == "//" then
    const slash? = string.find(reference, "/", 3)
    authority = string.sub(reference, 3, (slash or (#reference + 1)) - 1)
    path = ""
    if slash then path = string.sub(reference, slash) end
  elseif scheme then
    raise request_policy_error("HTTP redirect Location requires an HTTP authority")
  elseif #path == 0 then
    path = base.path
    if query == nil then query = base.query end
  elseif string.sub(path, 1, 1) ~= "/" then
    -- A relative reference's first segment cannot contain a colon.
    const slash? = string.find(path, "/", 1)
    const first = string.sub(path, 1, (slash or (#path + 1)) - 1)
    if string.find(first, ":", 1) then
      raise request_policy_error("HTTP redirect Location is malformed")
    end
    const directory = string.match(base.path, "^.*/"):whole()
    path = directory .. path
  end
  local target = path
  if query ~= nil then target = target .. "?" .. query end
  -- Validate the entire reference before removing segments: an invalid byte
  -- in a removed segment is still an invalid Location.
  local parsed?, problem? = url.parse((scheme or base.scheme) .. "://" .. authority .. target)
  if problem or (parsed.scheme ~= "http" and parsed.scheme ~= "https") then
    raise request_policy_error("HTTP redirect Location is malformed or disallowed")
  end
  parsed.path = remove_dot_segments(parsed.path)
  parsed.target = parsed.path
  if parsed.query ~= nil then parsed.target = parsed.target .. "?" .. parsed.query end
  return parsed
end

local function same_http_origin(left: url.Url, right: url.Url): boolean
  return left.scheme == right.scheme and left.host == right.host and left.port == right.port
end

local function Client:exchange(method: string, parsed_url: url.Url,
                               supplied_headers: Headers?, body: string?,
                               ca_file: string?): ClientResponse
  const request_headers = client_request_headers(parsed_url, supplied_headers, body)
  const keep_alive = not header_has_token(request_headers, "Connection", "close")
  const builder = string.writer()
  builder:write(method .. " " .. parsed_url.target .. " HTTP/1.1\r\n")
  builder:write(render_headers(request_headers))
  builder:write("\r\n")
  if body then builder:write(body) end
  const output = builder:drain()
  self:bind()
  const key = client_pool_key(parsed_url, request_headers, ca_file)
  local lease? = self:acquire(key)
  local reused = lease ~= nil
  if lease == nil then lease = client_connection(parsed_url, ca_file, key) end
  for attempt = 1, 2 do
    local exact: Parser? = nil
    local idle_input = false
    do
      exact = new_response_parser(lease.transport.connection, method == "HEAD")
      return supervised_http_io<|ClientResponse|>(lease.transport.abort,
        function (): ClientResponse
          if reused and lease.has_pending_input() then
            idle_input = true
            raise "HTTP idle connection received input"
          end
          lease.transport.connection:write(output)
          final_response_headers(exact)
          if exact.status_number < 200 or exact.status_number > 999 then
            raise "HTTP server returned an invalid final status code"
          end
          return ClientResponse {
            status = exact.status_number,
            reason = exact.reason_text,
            url = normalized_http_url(parsed_url),
            redirected = false,
            headers = exact.parsed_headers,
            parser = exact,
            connection = lease.transport.connection,
            abort = lease.transport.abort,
            client = self,
            lease = lease,
            request_keep_alive = keep_alive,
            body_length = response_body_length(exact),
            upgrade_pending = false,
            closed = false,
            connection_closed = false,
            reading = false,
          }
        end)
    catch
      -- Idle input observed before the write permits a fresh dial for any
      -- method: no request was sent. A failed sent request has stricter rules.
      const retry = attempt == 1 and reused and (idle_input or
        (body == nil and (method == "GET" or method == "HEAD") and
         (exact == nil or not exact.input_received) and
         stale_client_failure(error)))
      if exact ~= nil then close_parser(exact) end
      do lease.transport.abort() catch end
      if not retry then raise end
    end
    -- A cancellation remains authoritative even if its transport failure
    -- looked like a stale idle socket. Replay only these bodyless safe verbs.
    self:bind()
    lease = client_connection(parsed_url, ca_file, key)
    reused = false
  end
  raise "HTTP request attempts exhausted"
end

--- Send an HTTP request using this client's pool and the selected redirect policy.
-- @param method HTTP token selecting the request method.
-- @param source_url Absolute URL text.
-- @param options Optional validated request snapshot.
-- @return Response metadata and streaming body; the caller owns closing it.
-- @usage standard-library-http.md#client-requests
function Client:request(method: string, source_url: string,
                         options: RequestOptions?): ClientResponse
  async.checkpoint()
  validate_http_token(method, "HTTP method")
  local parsed_url = parse_url_or_raise(source_url)
  const policy = options or RequestOptions()
  if is_no_cors(policy.mode) then validate_no_cors_method(method) end
  if is_only_if_cached(policy.cache) then
    raise request_policy_error("HTTP response not in cache (only-if-cached)")
  end
  const working_headers = copy_headers(policy.headers)
  local body? = policy.body
  local hops = 0
  while true do
    const response = self:exchange(method, parsed_url, working_headers, body, policy.ca_file)
    local returned = false
    defer if not returned then response:close() end
    response.redirected = hops > 0
    if not is_redirect_status(response.status) or policy.redirect == nil then
      returned = true
      return response
    end
    case policy.redirect
    when manual() then
      returned = true
      return response
    when error() then
      raise request_policy_error("HTTP redirect disallowed by RedirectMode.error")
    when follow() then
      const locations = response.headers:values("Location")
      if #locations == 0 then
        returned = true
        return response
      end
      if #locations ~= 1 then
        raise request_policy_error("HTTP redirect has more than one Location")
      end
      if hops == 20 then
        raise request_policy_error("HTTP redirect limit (20) exceeded")
      end
      const next_url = resolve_redirect(parsed_url, locations[1])
      if not same_http_origin(parsed_url, next_url) then
        working_headers:remove("Authorization")
        working_headers:remove("Proxy-Authorization")
        working_headers:remove("Cookie")
        working_headers:remove("Cookie2")
        working_headers:remove("Host")
      end
      const normalized_method = lower_header_name(method)
      if ((response.status == 301 or response.status == 302) and normalized_method == "post") or
          (response.status == 303 and normalized_method ~= "get" and normalized_method ~= "head") then
        method = "GET"
        body = nil
        working_headers:remove("Content-Encoding")
        working_headers:remove("Content-Language")
        working_headers:remove("Content-Location")
        working_headers:remove("Content-Type")
        working_headers:remove("Content-Length")
      end
      response:close()
      async.checkpoint()
      parsed_url = next_url
      hops = hops + 1
    end
  end
end

--- Send a bodyless GET using this client's connection pool.
-- @usage standard-library-http.md#client-requests
function Client:get(source_url: string, options: RequestOptions?): ClientResponse
  async.checkpoint()
  if options ~= nil and options.body ~= nil then
    raise "HTTP get does not accept a request body"
  end
  return self:request("GET", source_url, options)
end

--- Send an HTTP request using the current Runtime's shared default client.
-- @param method HTTP token selecting the request method.
-- @param source_url Absolute URL text.
-- @param options Optional validated request snapshot.
-- @return Response metadata and streaming body; the caller owns closing it.
-- @usage standard-library-http.md#client-requests
function request(method: string, source_url: string,
                 options: RequestOptions?): ClientResponse
  return default_http_client():request(method, source_url, options)
end

--- Send a bodyless GET using the current Runtime's shared default client.
-- @usage standard-library-http.md#client-requests
function get(source_url: string, options: RequestOptions?): ClientResponse
  return default_http_client():get(source_url, options)
end

--- Send an upgrade request over an owned supplied stream and await response headers.
-- @param connection Stream whose ownership transfers to this upgrade attempt.
-- @param abort Abort supplied to this operation.
-- @param source_url Absolute URL text.
-- @param protocol Protocol token for the HTTP upgrade.
-- @param supplied_headers Optional headers copied into the outgoing message.
-- @return Opening response owning the supplied transport until transfer or close.
-- @usage standard-library-http.md#protocol-upgrade-and-ownership
function request_upgrade_on(connection: io.ReaderWriterCloser,
                             abort: function (): (), source_url: string,
                             protocol: string,
                             supplied_headers: Headers?): ClientResponse
  validate_upgrade_protocol(protocol)
  const parsed_url = parse_url_or_raise(source_url)
  const request_headers = client_request_headers(
    parsed_url, validate_upgrade_headers(supplied_headers), nil)
  request_headers:set("Connection", "Upgrade")
  request_headers:set("Upgrade", protocol)
  const builder = string.writer()
  builder:write("GET " .. parsed_url.target .. " HTTP/1.1\r\n")
  builder:write(render_headers(request_headers))
  builder:write("\r\n")
  const output = builder:drain()
  -- Argument validation precedes adoption. From this point the supplied
  -- transport is owned by HTTP through failure, rejection or one-shot take.
  local parser: Parser? = nil
  do
    const exact = new_response_parser(connection, false)
    parser = exact
    exact.allow_upgrade = true
    exact.header_limit = 65536
    return supervised_http_io<|ClientResponse|>(abort,
      function (): ClientResponse
        connection:write(output)
        local interim = 0
        while true do
          if not ensure_parser_headers(exact) then
            raise "HTTP message ended before it was complete"
          end
          validate_reason(exact.reason_text)
          if exact.status_number == 101 or exact.status_number >= 200 then break end
          if exact.status_number < 100 then
            raise "HTTP server returned an invalid status code"
          end
          interim = interim + 1
          if interim > 16 then raise "HTTP upgrade received too many interim responses" end
          while parser_read(exact) do end
          parser_reset_message(exact)
        end
        if exact.status_number > 999 then
          raise "HTTP server returned an invalid final status code"
        end
        return ClientResponse {
          status = exact.status_number,
          reason = exact.reason_text,
          url = normalized_http_url(parsed_url),
          redirected = false,
          headers = exact.parsed_headers,
          parser = exact,
          connection = connection,
          abort = abort,
          client = nil,
          lease = nil,
          request_keep_alive = false,
          body_length = nil,
          upgrade_pending = exact.status_number == 101,
          closed = false,
          connection_closed = false,
          reading = false,
        }
      end)
  catch
    if parser then close_parser(parser) end
    do abort() catch end
    raise
  end
end

--- Transfer a validated upgraded stream with any already received prefix bytes.
-- @return Transferred stream preserving already received post-header bytes.
-- @usage standard-library-http.md#protocol-upgrade-and-ownership
function ClientResponse:take_upgrade(): io.ReaderWriterCloser
  if self.closed or not self.upgrade_pending then
    raise "HTTP response has no pending upgrade"
  end
  const stream = new_upgraded_stream(Transport(self.connection, self.abort), self.parser)
  const view: io.ReaderWriterCloser = stream
  self.parser.input_excess = ""
  close_parser(self.parser)
  self.upgrade_pending = false
  self.closed = true
  self.connection_closed = true
  return view
end

local function ClientResponse:retire(graceful: boolean?)
  self.closed = true
  if self.connection_closed then return end
  defer do
    if not self.reading then close_parser(self.parser) end
  end
  if graceful and self.lease ~= nil then
    -- Bounded graceful retirement owns abort fallback, even if interrupted.
    -- Commit before suspension so another close cannot abort this operation.
    self.connection_closed = true
    self.lease:close_idle()
  else
    self.abort()
  end
  self.connection_closed = true
end

--- Read decoded response-body bytes, or nil at the body's end.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-http.md#client-requests
function ClientResponse:read(): string?
  if self.upgrade_pending then raise "HTTP upgraded response has no readable body" end
  if self.closed then return nil end
  async.checkpoint()
  if self.reading then raise "HTTP response already has a reader" end
  self.reading = true
  defer do
    self.reading = false
    if self.closed then close_parser(self.parser) end
  end
  do
    const chunk? = parser_read(self.parser)
    if chunk ~= nil then return chunk end
    self.reading = false
    self:close()
    return nil
  catch
    self.reading = false
    do self:retire() catch end
    raise
  end
end

--- Read response bytes through a delimiter, retaining the unused suffix.
-- @param delimiter Nonempty byte delimiter to include or remove.
-- @param chop Remove the delimiter when true; nil or false retains it.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-http.md#client-requests
function ClientResponse:read_until(delimiter: string,
                                   chop: boolean?): string?
  if self.upgrade_pending then raise "HTTP upgraded response has no readable body" end
  if self.closed then return nil end
  if #delimiter == 0 then raise "read delimiter must not be empty" end
  async.checkpoint()
  if self.reading then raise "HTTP response already has a reader" end
  self.reading = true
  defer do
    self.reading = false
    if self.closed then close_parser(self.parser) end
  end
  do
    const result? = parser_read_until(self.parser, delimiter, chop)
    if result ~= nil then return result end
    self.reading = false
    self:close()
    return nil
  catch
    self.reading = false
    do self:retire() catch end
    raise
  end
end

--- Close the body and asynchronously drain a small unread persistent response.
-- @usage standard-library-http.md#client-requests
function ClientResponse:close()
  if self.closed then
    if not self.connection_closed then self:retire() end
    return
  end
  const started = uv.hrtime()
  self.closed = true
  const client? = self.client
  const lease? = self.lease
  if self.reading or client == nil or lease == nil or client.closed or
      not self.request_keep_alive or not self.parser.keep_alive or
      self.parser.transport_eof or self.upgrade_pending or async.is_closing() then
    const graceful = not self.reading and not self.upgrade_pending and
      self.parser.message_complete and not self.parser.transport_eof and
      #self.parser.input_excess == 0
    self:retire(graceful)
    return
  end
  if self.parser.message_complete then
    if not client_parser_reusable(self.parser) then
      self:retire()
      return
    end
    close_parser(self.parser)
    self.connection_closed = true
    client:release(lease)
    return
  end
  if self.body_length ~= nil and
      self.body_length - self.parser.body_consumed > CLIENT_DRAIN_BYTES then
    self:retire()
    return
  end
  -- Ownership passes before scheduling. Retained responses can no longer
  -- abort a later exchange after the worker returns this lease to the pool.
  self.connection_closed = true
  client:start_drain(lease, self.parser, started)
end
