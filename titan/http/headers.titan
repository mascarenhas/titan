--- One HTTP header name and value preserving their original spelling.
-- @field name Original header-name spelling.
-- @field contents Validated header-value bytes.
-- @usage standard-library-http.md#headers
record Header
  name: string
  contents: string
end

--- Validated headers preserving duplicates and insertion order.
-- @usage standard-library-http.md#headers
record Headers
  local entries: {Header}
end

-- Strict llhttp enforces these grammars on received messages. Headers is also
-- the public outbound container, so values still need validation before they
-- are serialized into a request or response.
local HTTP_TOKEN_PATTERN = "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
local FORBIDDEN_FIELD_BYTE_PATTERN = "[\0-\8\10-\31\127]"
local DECIMAL_PATTERN = "^[0-9]+$"

local function validate_header_name(name: string)
  if #name == 0 then raise "HTTP header name must not be empty" end
  if not string.match(name, HTTP_TOKEN_PATTERN) then
    raise "HTTP header name contains an invalid byte"
  end
end

local function validate_header_value(contents: string)
  -- RFC 9110 field values admit HTAB, SP/VCHAR, and obs-text. Reject the
  -- remaining controls and DEL even though only CR/LF would split a line.
  if string.match(contents, FORBIDDEN_FIELD_BYTE_PATTERN) then
    raise "HTTP header value contains a forbidden byte"
  end
end

local function lower_ascii_letter(upper: string): string
  return string.char(string.byte(upper, 1) + 32)
end

local function lower_header_name(name: string): string
  -- HTTP field names use ASCII case folding. string.lower follows the mutable
  -- process C locale, so it cannot provide that protocol invariant.
  const lowered = string.gsub(name, "[A-Z]", lower_ascii_letter, nil)
  return lowered
end

local function same_header_name(left: string, right: string): boolean
  return lower_header_name(left) == lower_header_name(right)
end

--- Validate and copy initial headers into a new header collection.
-- @param initial Initial headers to validate and copy, or nil for an empty collection.
-- @return New validated header collection.
-- @usage standard-library-http.md#headers
function headers(initial: {Header}?): Headers
  const result = Headers({})
  if initial then
    const supplied = initial as {Header}
    local index = 1
    while index <= #supplied do
      const entry = supplied[index]
      result:add(entry.name, entry.contents)
      index = index + 1
    end
  end
  return result
end

--- Append a validated header, preserving existing entries of the same name.
-- @param name HTTP header name, matched with ASCII case folding.
-- @param contents String bytes supplied to this operation.
-- @usage standard-library-http.md#headers
function Headers:add(name: string, contents: string)
  validate_header_name(name)
  validate_header_value(contents)
  self.entries[#self.entries + 1] = Header(name, contents)
end

--- Remove matching names and append one validated replacement.
-- @param name HTTP header name, matched with ASCII case folding.
-- @param contents String bytes supplied to this operation.
-- @usage standard-library-http.md#headers
function Headers:set(name: string, contents: string)
  self:remove(name)
  self:add(name, contents)
end

--- Return the first case-insensitive match, or nil when absent.
-- @param name HTTP header name, matched with ASCII case folding.
-- @return First matching value, or nil when no header matches.
-- @usage standard-library-http.md#headers
function Headers:get(name: string): string?
  validate_header_name(name)
  local index = 1
  while index <= #self.entries do
    const entry = self.entries[index]
    if same_header_name(entry.name, name) then return entry.contents end
    index = index + 1
  end
  return nil
end

--- Return all values whose header name matches case-insensitively.
-- @param name HTTP header name, matched with ASCII case folding.
-- @return All matching values in insertion order.
-- @usage standard-library-http.md#headers
function Headers:values(name: string): {string}
  validate_header_name(name)
  const result: {string} = {}
  local index = 1
  while index <= #self.entries do
    const entry = self.entries[index]
    if same_header_name(entry.name, name) then
      result[#result + 1] = entry.contents
    end
    index = index + 1
  end
  return result
end

--- Remove every header whose name matches case-insensitively.
-- @param name HTTP header name, matched with ASCII case folding.
-- @usage standard-library-http.md#headers
function Headers:remove(name: string)
  validate_header_name(name)
  const kept: {Header} = {}
  local index = 1
  while index <= #self.entries do
    const entry = self.entries[index]
    if not same_header_name(entry.name, name) then
      kept[#kept + 1] = entry
    end
    index = index + 1
  end
  self.entries = kept
end

--- Return copied header records in insertion order.
-- @return Copied header records in insertion order.
-- @usage standard-library-http.md#headers
function Headers:all(): {Header}
  const result: {Header} = {}
  local index = 1
  while index <= #self.entries do
    const entry = self.entries[index]
    result[#result + 1] = Header(entry.name, entry.contents)
    index = index + 1
  end
  return result
end

local function copy_headers(source: Headers?): Headers
  if not source then return headers(nil) end
  return headers((source as Headers):all())
end

local function trim_header_value(contents: string): string
  local first = 1
  local last = #contents
  while first <= last do
    const byte = string.byte(contents, first)
    if byte ~= 32 and byte ~= 9 then break end
    first = first + 1
  end
  while last >= first do
    const byte = string.byte(contents, last)
    if byte ~= 32 and byte ~= 9 then break end
    last = last - 1
  end
  if first > last then return "" end
  return string.sub(contents, first, last)
end

local function header_has_token(headers_value: Headers, name: string,
                                wanted: string): boolean
  const lower_wanted = lower_header_name(wanted)
  const found = headers_value:values(name)
  local index = 1
  while index <= #found do
    const contents = found[index]
    for item in string.split(contents, ",") do
      if lower_header_name(trim_header_value(item)) == lower_wanted then
        return true
      end
    end
    index = index + 1
  end
  return false
end

local function validate_http_token(token: string, subject: string)
  if #token == 0 then raise subject .. " must not be empty" end
  if not string.match(token, HTTP_TOKEN_PATTERN) then
    raise subject .. " contains an invalid byte"
  end
end

-- Upgrade uses protocol-name ["/" protocol-version], unlike Connection's
-- bare token options. Names are ASCII case-insensitive; versions are exact.
local function upgrade_protocol_parts(protocol: string): (string?, string?)
  const slash? = string.find(protocol, "/", 1)
  if not slash then
    if string.match(protocol, HTTP_TOKEN_PATTERN) then return protocol, nil end
    return nil, nil
  end
  const name = string.sub(protocol, 1, slash - 1)
  const version = string.sub(protocol, slash + 1)
  if not string.match(name, HTTP_TOKEN_PATTERN) or
      not string.match(version, HTTP_TOKEN_PATTERN) then
    return nil, nil
  end
  return name, version
end

local function validate_upgrade_protocol(protocol: string)
  if #protocol == 0 then raise "HTTP upgrade protocol must not be empty" end
  local name?, _? = upgrade_protocol_parts(protocol)
  if not name then raise "HTTP upgrade protocol contains an invalid byte" end
end

local function upgrade_header_has_protocol(headers_value: Headers,
                                           wanted: string): boolean
  local wanted_name?, wanted_version? = upgrade_protocol_parts(wanted)
  if not wanted_name then return false end
  local matched = false
  const fields = headers_value:values("Upgrade")
  for index = 1, #fields do
    for item in string.split(fields[index], ",") do
      const protocol = trim_header_value(item)
      -- HTTP list recipients ignore empty elements; every actual protocol
      -- entry still has to follow the Upgrade grammar.
      if #protocol > 0 then
        local name?, version? = upgrade_protocol_parts(protocol)
        if not name then return false end
        if lower_header_name(name) == lower_header_name(wanted_name) and
            version == wanted_version then
          matched = true
        end
      end
    end
  end
  return matched
end

local function render_headers(headers_value: Headers): string
  const builder = string.writer()
  const entries = headers_value:all()
  local index = 1
  while index <= #entries do
    const entry = entries[index]
    builder:write(entry.name .. ": " .. entry.contents .. "\r\n")
    index = index + 1
  end
  return builder:drain()
end

local function decimal_header(contents: string,
                              subject: string): integer
  -- llhttp owns received Content-Length framing. This path parses a value
  -- supplied through Titan's outbound API and bounds it to Titan's integer.
  if #contents == 0 then raise subject .. " must not be empty" end
  if not string.match(contents, DECIMAL_PATTERN) then
    raise subject .. " must contain only decimal digits"
  end
  const result? = math.tointeger(contents)
  if not result then raise subject .. " is too large" end
  return result as integer
end
