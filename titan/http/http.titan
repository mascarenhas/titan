--- Streaming HTTP clients, validated request options, headers, and native servers.
-- @module titan.http
-- @usage standard-library-http.md

local async = import "async"
local io = import "io"
local math = import "math"
local string = import "string"
local timer = import "timer"
local url = import "url"
foreign import "titan/ffi.h"

-- Target-selected clients share headers, request policy, and URL validation.
-- Native transports and the synchronous llhttp boundary stay in native contributors.

local function parse_url_or_raise(source: string): url.Url
  local parsed?, parse_error? = url.parse(source)
  if parse_error then raise parse_error end
  if parsed.scheme ~= "http" and parsed.scheme ~= "https" then
    raise url.Error(1, "scheme", "HTTP requires an http or https URL")
  end
  return parsed
end

local function parse_request_url_or_raise(
    scheme: string, authority: string, target: string): url.Url
  local parsed?, parse_error? =
    url.parse_request(scheme, authority, target)
  if parse_error then raise parse_error end
  return parsed
end
