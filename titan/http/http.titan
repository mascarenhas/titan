local async = import "async"
local io = import "io"
local math = import "titan.math"
local net = import "net"
local ssl = import "ssl"
local str = import "string"
local url = import "url"
local ffi = foreign import "titan/ffi.h"

-- This folder module is intentionally layered over the public net, ssl, io,
-- and async modules. Its C boundary contains only exact llhttp callback
-- trampolines; synchronous parsing policy and event storage remain in Titan.

local function parse_url_or_raise(source: string): url.Url
  local parsed?, parse_error? = url.parse(source)
  if parse_error then raise parse_error as url.Error end
  return parsed as url.Url
end
