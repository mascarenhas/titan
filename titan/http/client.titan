--- Received response headers and an owned streaming response body.
-- @field status HTTP status number.
-- @field reason HTTP reason phrase.
-- @field version Received HTTP version.
-- @field headers Received headers, preserving duplicates and insertion order.
-- @usage standard-library-http.md#client-requests
record ClientResponse
  status: integer
  reason: string
  version: string
  headers: Headers
  local parser: Parser
  local connection: io.ReaderWriterCloser
  local abort: function (): ()
  local client: Client?
  local lease: ClientConnection?
  local request_keep_alive: boolean
  local body_length: integer?
  local upgrade_pending: boolean
  local closed: boolean
  local connection_closed: boolean
  local reading: boolean
end

local function client_connection(parsed_url: url.Url, ca_file: string?,
                                   key: string): ClientConnection
  if parsed_url.scheme == "https" then
    local secure = ssl.connect(parsed_url.host, parsed_url.port, ca_file)
    local adopted = false
    defer if not adopted then secure:abort() end
    local lease = ClientConnection(Transport(secure, secure:abort),
      secure:has_pending_input, secure:add_input_listener, nil, true, key, 0)
    adopted = true
    return lease
  end
  local plain = net.connect(parsed_url.host, parsed_url.port)
  local adopted = false
  defer if not adopted then plain:close() end
  local lease = ClientConnection(Transport(plain, plain:close),
    plain:has_pending_input, plain:add_input_listener, nil, false, key, 0)
  adopted = true
  return lease
end

local function client_request_headers(parsed_url: url.Url,
                                      supplied: Headers?,
                                      body: string?): Headers
  local result = copy_headers(supplied)
  local hosts = result:values("Host")
  if #hosts > 1 then raise "HTTP request has more than one Host header" end
  if #hosts == 0 then
    result:add("Host", parsed_url:host_header())
  else
    parse_request_url_or_raise(parsed_url.scheme, hosts[1], "/")
  end

  if #result:values("Transfer-Encoding") > 0 then
    raise "HTTP client requests do not support Transfer-Encoding"
  end
  if #result:values("Expect") > 0 then
    raise "HTTP client requests do not support Expect"
  end
  local body_length = 0
  if body then body_length = #body end
  local lengths = result:values("Content-Length")
  if #lengths > 1 then
    raise "HTTP request has more than one Content-Length header"
  elseif #lengths == 1 then
    if decimal_header(lengths[1], "HTTP Content-Length") ~= body_length then
      raise "HTTP Content-Length does not match the request body"
    end
  elseif body then
    result:add("Content-Length", string.tostring(body_length))
  end
  return result
end

local function final_response_headers(parser: Parser)
  while true do
    if not ensure_parser_headers(parser) then
      raise "HTTP message ended before it was complete"
    end
    if parser.status_number >= 200 then
      validate_reason(parser.reason_text)
      return
    end
    if parser.status_number < 100 then
      raise "HTTP server returned an invalid status code"
    end
    if parser.status_number == 101 then
      raise "HTTP protocol upgrades require request_upgrade_on"
    end
    validate_reason(parser.reason_text)
    while parser_read(parser) do end
    parser_reset_message(parser)
  end
end

local function response_body_length(parser: Parser): integer?
  if parser.response_to_head or parser.status_number == 204 or
      parser.status_number == 205 or parser.status_number == 304 then
    return 0
  end
  local length? = parser.parsed_headers:get("Content-Length")
  if length == nil then return nil end
  return decimal_header(length, "HTTP Content-Length")
catch
  -- llhttp admits unsigned lengths larger than Titan's signed integer range.
  -- Such a body can stream normally, but must never receive automatic drain.
  return math.maxinteger
end

local function stale_client_failure(failure: value): boolean
  if failure == "HTTP message ended before it was complete" then return true end
  if failure is async.OperationError then
    local problem: async.OperationError = failure
    return problem.name == "EPIPE" or problem.name == "ECONNRESET" or
      problem.name == "ENOTCONN" or problem.name == "ECONNABORTED"
  end
  if failure is ssl.Error then
    local problem: ssl.Error = failure
    return problem.name == "TLS_TRUNCATED_EOF"
  end
  return false
end

--- Send an HTTP request using this client's pool and return final response headers.
-- @param method Case-sensitive HTTP token selecting the request method.
-- @param source_url Absolute URL text.
-- @param supplied_headers Optional headers copied into the outgoing message.
-- @param body Optional in-memory request-body bytes.
-- @param ca_file Optional PEM trust bundle replacing the default trust roots.
-- @return Response metadata and streaming body; the caller owns closing it.
-- @usage standard-library-http.md#client-requests
function Client:request(method: string, source_url: string,
                         supplied_headers: Headers?, body: string?,
                         ca_file: string?): ClientResponse
  validate_http_token(method, "HTTP method")
  local parsed_url = parse_url_or_raise(source_url)
  local request_headers = client_request_headers(parsed_url, supplied_headers, body)
  local keep_alive = not header_has_token(request_headers, "Connection", "close")
  local builder = string.writer()
  builder:write(method .. " " .. parsed_url.target .. " HTTP/1.1\r\n")
  builder:write(render_headers(request_headers))
  builder:write("\r\n")
  if body then builder:write(body) end
  local output = builder:drain()
  self:bind()
  local key = client_pool_key(parsed_url, request_headers, ca_file)
  local lease? = self:acquire(key)
  local reused = lease ~= nil
  if lease == nil then lease = client_connection(parsed_url, ca_file, key) end
  for attempt = 1, 2 do
    local exact: Parser? = nil
    local idle_input = false
    do
      exact = new_response_parser(lease.transport.connection, method == "HEAD")
      return supervised_http_io<|ClientResponse|>(lease.transport.abort,
        function (): ClientResponse
          if reused and lease.has_pending_input() then
            idle_input = true
            raise "HTTP idle connection received input"
          end
          lease.transport.connection:write(output)
          final_response_headers(exact)
          if exact.status_number < 200 or exact.status_number > 999 then
            raise "HTTP server returned an invalid final status code"
          end
          return ClientResponse {
            status = exact.status_number,
            reason = exact.reason_text,
            version = "HTTP/1.1",
            headers = exact.parsed_headers,
            parser = exact,
            connection = lease.transport.connection,
            abort = lease.transport.abort,
            client = self,
            lease = lease,
            request_keep_alive = keep_alive,
            body_length = response_body_length(exact),
            upgrade_pending = false,
            closed = false,
            connection_closed = false,
            reading = false,
          }
        end)
    catch
      -- Idle input observed before the write permits a fresh dial for any
      -- method: no request was sent. A failed sent request has stricter rules.
      local retry = attempt == 1 and reused and (idle_input or
        (body == nil and (method == "GET" or method == "HEAD") and
         (exact == nil or not exact.input_received) and
         stale_client_failure(error)))
      if exact ~= nil then close_parser(exact) end
      do lease.transport.abort() catch end
      if not retry then raise end
    end
    -- A cancellation remains authoritative even if its transport failure
    -- looked like a stale idle socket. Replay only these bodyless safe verbs.
    self:bind()
    lease = client_connection(parsed_url, ca_file, key)
    reused = false
  end
  raise "HTTP request attempts exhausted"
end

--- Send a GET using this client's connection pool.
-- @usage standard-library-http.md#client-requests
function Client:get(source_url: string, supplied_headers: Headers?,
                     ca_file: string?): ClientResponse
  return self:request("GET", source_url, supplied_headers, nil, ca_file)
end

--- Send an HTTP request using the current Runtime's shared default client.
-- @param method Case-sensitive HTTP token selecting the request method.
-- @param source_url Absolute URL text.
-- @param supplied_headers Optional headers copied into the outgoing message.
-- @param body Optional in-memory request-body bytes.
-- @param ca_file Optional PEM trust bundle replacing the default trust roots.
-- @return Response metadata and streaming body; the caller owns closing it.
-- @usage standard-library-http.md#client-requests
function request(method: string, source_url: string,
                 supplied_headers: Headers?, body: string?,
                 ca_file: string?): ClientResponse
  return default_http_client():request(method, source_url, supplied_headers, body, ca_file)
end

--- Send a GET using the current Runtime's shared default client.
-- @usage standard-library-http.md#client-requests
function get(source_url: string, supplied_headers: Headers?,
             ca_file: string?): ClientResponse
  return default_http_client():get(source_url, supplied_headers, ca_file)
end

--- Send an upgrade request over an owned supplied stream and await response headers.
-- @param connection Stream whose ownership transfers to this upgrade attempt.
-- @param abort Abort supplied to this operation.
-- @param source_url Absolute URL text.
-- @param protocol Protocol token for the HTTP upgrade.
-- @param supplied_headers Optional headers copied into the outgoing message.
-- @return Opening response owning the supplied transport until transfer or close.
-- @usage standard-library-http.md#protocol-upgrade-and-ownership
function request_upgrade_on(connection: io.ReaderWriterCloser,
                             abort: function (): (), source_url: string,
                             protocol: string,
                             supplied_headers: Headers?): ClientResponse
  validate_upgrade_protocol(protocol)
  local parsed_url = parse_url_or_raise(source_url)
  local request_headers = client_request_headers(
    parsed_url, validate_upgrade_headers(supplied_headers), nil)
  request_headers:set("Connection", "Upgrade")
  request_headers:set("Upgrade", protocol)
  local builder = string.writer()
  builder:write("GET " .. parsed_url.target .. " HTTP/1.1\r\n")
  builder:write(render_headers(request_headers))
  builder:write("\r\n")
  local output = builder:drain()
  -- Argument validation precedes adoption. From this point the supplied
  -- transport is owned by HTTP through failure, rejection or one-shot take.
  local parser: Parser? = nil
  do
    local exact = new_response_parser(connection, false)
    parser = exact
    exact.allow_upgrade = true
    exact.header_limit = 65536
    return supervised_http_io<|ClientResponse|>(abort,
      function (): ClientResponse
        connection:write(output)
        local interim = 0
        while true do
          if not ensure_parser_headers(exact) then
            raise "HTTP message ended before it was complete"
          end
          validate_reason(exact.reason_text)
          if exact.status_number == 101 or exact.status_number >= 200 then break end
          if exact.status_number < 100 then
            raise "HTTP server returned an invalid status code"
          end
          interim = interim + 1
          if interim > 16 then raise "HTTP upgrade received too many interim responses" end
          while parser_read(exact) do end
          parser_reset_message(exact)
        end
        if exact.status_number > 999 then
          raise "HTTP server returned an invalid final status code"
        end
        return ClientResponse {
          status = exact.status_number,
          reason = exact.reason_text,
          version = "HTTP/1.1",
          headers = exact.parsed_headers,
          parser = exact,
          connection = connection,
          abort = abort,
          client = nil,
          lease = nil,
          request_keep_alive = false,
          body_length = nil,
          upgrade_pending = exact.status_number == 101,
          closed = false,
          connection_closed = false,
          reading = false,
        }
      end)
  catch
    if parser then close_parser(parser) end
    do abort() catch end
    raise
  end
end

--- Transfer a validated upgraded stream with any already received prefix bytes.
-- @return Transferred stream preserving already received post-header bytes.
-- @usage standard-library-http.md#protocol-upgrade-and-ownership
function ClientResponse:take_upgrade(): io.ReaderWriterCloser
  if self.closed or not self.upgrade_pending then
    raise "HTTP response has no pending upgrade"
  end
  local stream = new_upgraded_stream(Transport(self.connection, self.abort), self.parser)
  local view: io.ReaderWriterCloser = stream
  self.parser.input_excess = ""
  close_parser(self.parser)
  self.upgrade_pending = false
  self.closed = true
  self.connection_closed = true
  return view
end

local function ClientResponse:retire(graceful: boolean?)
  self.closed = true
  if self.connection_closed then return end
  defer do
    if not self.reading then close_parser(self.parser) end
  end
  if graceful and self.lease ~= nil then
    -- Bounded graceful retirement owns abort fallback, even if interrupted.
    -- Commit before suspension so another close cannot abort this operation.
    self.connection_closed = true
    self.lease:close_idle()
  else
    self.abort()
  end
  self.connection_closed = true
end

--- Read decoded response-body bytes, or nil at the body's end.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-http.md#client-requests
function ClientResponse:read(): string?
  if self.upgrade_pending then raise "HTTP upgraded response has no readable body" end
  if self.closed then return nil end
  async.checkpoint()
  if self.reading then raise "HTTP response already has a reader" end
  self.reading = true
  defer do
    self.reading = false
    if self.closed then close_parser(self.parser) end
  end
  do
    local chunk? = parser_read(self.parser)
    if chunk ~= nil then return chunk end
    self.reading = false
    self:close()
    return nil
  catch
    self.reading = false
    do self:retire() catch end
    raise
  end
end

--- Read response bytes through a delimiter, retaining the unused suffix.
-- @param delimiter Nonempty byte delimiter to include or remove.
-- @param chop Remove the delimiter when true; nil or false retains it.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-http.md#client-requests
function ClientResponse:read_until(delimiter: string,
                                   chop: boolean?): string?
  if self.upgrade_pending then raise "HTTP upgraded response has no readable body" end
  if self.closed then return nil end
  if #delimiter == 0 then raise "read delimiter must not be empty" end
  async.checkpoint()
  if self.reading then raise "HTTP response already has a reader" end
  self.reading = true
  defer do
    self.reading = false
    if self.closed then close_parser(self.parser) end
  end
  do
    local result? = parser_read_until(self.parser, delimiter, chop)
    if result ~= nil then return result end
    self.reading = false
    self:close()
    return nil
  catch
    self.reading = false
    do self:retire() catch end
    raise
  end
end

--- Close the body and asynchronously drain a small unread persistent response.
-- @usage standard-library-http.md#client-requests
function ClientResponse:close()
  if self.closed then
    if not self.connection_closed then self:retire() end
    return
  end
  local started = uv.hrtime()
  self.closed = true
  local client? = self.client
  local lease? = self.lease
  if self.reading or client == nil or lease == nil or client.closed or
      not self.request_keep_alive or not self.parser.keep_alive or
      self.parser.transport_eof or self.upgrade_pending or async.is_closing() then
    local graceful = not self.reading and not self.upgrade_pending and
      self.parser.message_complete and not self.parser.transport_eof and
      #self.parser.input_excess == 0
    self:retire(graceful)
    return
  end
  if self.parser.message_complete then
    if not client_parser_reusable(self.parser) then
      self:retire()
      return
    end
    close_parser(self.parser)
    self.connection_closed = true
    client:release(lease)
    return
  end
  if self.body_length ~= nil and
      self.body_length - self.parser.body_consumed > CLIENT_DRAIN_BYTES then
    self:retire()
    return
  end
  -- Ownership passes before scheduling. Retained responses can no longer
  -- abort a later exchange after the worker returns this lease to the pool.
  self.connection_closed = true
  client:start_drain(lease, self.parser, started)
end
