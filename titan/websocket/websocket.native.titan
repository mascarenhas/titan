--- RFC 6455 text and binary messages over HTTP/1.1 and verified TLS.
-- @module titan.websocket
-- @usage standard-library-websocket.md

local async = import "async"
local gc = import "gc"
local io = import "io"
local iteration = import "iteration"
local net = import "net"
local reflect = import "reflect"
local protobuf = import "protobuf"
local ssl = import "ssl"
local timer = import "timer"
local url = import "url"
local uv = import "uv"

local const connection_transfer_fields: const {reflect.Type} = {
  reflect.Type.is_string(), reflect.Type.is_boolean(),
  reflect.Type.is_option(reflect.Type.is_string()),
  reflect.Type.is_integer(), reflect.Type.is_string(),
}

local const FRAME_BYTES = 16 * 1024
local const FRAME_BUDGET = 32

--- Validated copied server-opening, Origin, and subprotocol options.
-- @usage standard-library-websocket.md#public-interface
record AcceptOptions
  local protocols: {string}
  local origins: {string}
  local limit: integer
  local timeout: integer
end

--- Validate and snapshot server protocols, allowed origins, and opening limits.
-- @param subprotocols Ordered case-sensitive subprotocol tokens to snapshot.
-- @param allowed_origins Explicit normalized origins permitted in addition to same-origin policy.
-- @param read_limit Positive incoming message-byte limit; nil defaults to 1 MiB.
-- @param handshake_timeout Positive opening deadline in milliseconds; nil defaults to 10000.
-- @return Validated immutable snapshot of the server options.
-- @usage standard-library-websocket.md#public-interface
function AcceptOptions.new(subprotocols: ({string})?,
                           allowed_origins: ({string})?, read_limit: integer?,
                           handshake_timeout: integer?): AcceptOptions
  return {
    protocols = copy_protocols(subprotocols), origins = copy_origins(allowed_origins),
    limit = positive(read_limit, DEFAULT_LIMIT, "WebSocket read limit"),
    timeout = positive(handshake_timeout, OPEN_TIMEOUT, "WebSocket opening timeout"),
  }
end

do
  gc.ephemeron(openings as {value: value})
end
