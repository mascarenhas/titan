--- Synchronous RFC 8259 JSON encoding and schema-directed decoding with structured errors.
-- @module titan.json
-- @usage standard-library-json.md

local reflect = import "reflect"
local string = import "string"
local math = import "math"
local peg = import "peg"
local iteration = import "iteration"
foreign import "native.h"

--- Structured JSON failure with a stable code, path, and optional source position.
-- @field code Stable failure category or grammar label.
-- @field message Human-readable failure explanation.
-- @field position One-based source byte position, or nil without source input.
-- @field line One-based source line, or nil.
-- @field column One-based byte column, or nil.
-- @field path Semantic path beginning at $.
-- @usage standard-library-json.md
record Error
  const code: string
  const message: string
  const position: integer?
  const line: integer?
  const column: integer?
  const path: string
end

--- Per-call JSON encoding policy; repeated options use their last value.
-- @field tag_field Union discriminator key, default tag.
-- @field null_value Explicit null sentinel; nil selects the default null policy.
-- @field max_depth Positive container depth limit, default 32.
-- @field max_bytes Positive text byte limit, default 16 MiB.
-- @field max_nodes Positive JSON value count limit, default 1000000.
-- @usage standard-library-json.md
union EncodeOption
  tag_field(name: string)
  null_value(value)
  max_depth(integer)
  max_bytes(integer)
  max_nodes(integer)
end

--- Per-call JSON decoding policy; repeated options use their last value.
-- @field tag_field Union discriminator key, default tag.
-- @field null_value Explicit null sentinel; nil selects the default null policy.
-- @field max_depth Positive container depth limit, default 32.
-- @field max_bytes Positive text byte limit, default 16 MiB.
-- @field max_nodes Positive JSON value count limit, default 1000000.
-- @field ignore_unknown_fields Ignore unknown record fields when true; union envelope extras remain errors.
-- @usage standard-library-json.md
union DecodeOption
  tag_field(name: string)
  null_value(value)
  max_depth(integer)
  max_bytes(integer)
  max_nodes(integer)
  ignore_unknown_fields(boolean)
end

local record Settings
  tag_field: string
  null_value: value
  max_depth: integer
  max_bytes: integer
  max_nodes: integer
  ignore_unknown_fields: boolean
end

-- Parse nodes retain nulls, member presence and number spellings until the
-- requested descriptor determines their representation.
local record Node
  const kind: string
  const position: integer
  const scalar: value
  const elements: {Node}?
  const members: {Member}?
end

local record Member
  const name: string
  const position: integer
  const node: Node
end

local record Path
  const parent: Path?
  const name: string?
  const index: integer?
end

local function root_path(): Path
  return Path { parent = nil, name = nil, index = nil }
end

local function path_text(path: Path): string
  if path.parent == nil then return "$" end
  local prefix = path_text(path.parent)
  if path.name ~= nil then
    return prefix .. "[" .. quoted_string(path.name, root_path()) .. "]"
  end
  return prefix .. "[" .. path.index .. "]"
end

local function json_fail(code: string, message: string, path: Path,
                         source: string?, position: integer?)
  local line: integer?
  local column: integer?
  if source ~= nil and position ~= nil then
    line, column = peg.line_column(source, position)
  end
  raise Error {
    code = code,
    message = message,
    position = position,
    line = line,
    column = column,
    path = path_text(path)
  }
end

local function field_path(path: Path, name: string): Path
  return Path { parent = path, name = name, index = nil }
end

local function index_path(path: Path, index: integer): Path
  return Path { parent = path, name = nil, index = index }
end

local function default_settings(): Settings
  return Settings {
    tag_field = "tag",
    null_value = nil,
    max_depth = 32,
    max_bytes = 16 * 1024 * 1024,
    max_nodes = 1000000,
    ignore_unknown_fields = false
  }
end

local function validate_settings(settings: Settings)
  if settings.max_depth < 1 then
    json_fail("invalid_option", "max_depth must be positive", root_path(), nil, nil)
  end
  if settings.max_bytes < 1 or settings.max_nodes < 1 then
    json_fail("invalid_option", "max_bytes and max_nodes must be positive", root_path(), nil, nil)
  end
  if settings.null_value ~= settings.null_value then
    json_fail("invalid_option", "null_value cannot be NaN", root_path(), nil, nil)
  end
end

--- Encode a value using public record fields and named union payloads.
-- @param subject Value to encode; unsupported types, cycles, and nonfinite numbers raise Error.
-- @param ... Encoding options.
-- @return Complete JSON document.
-- @usage standard-library-json.md
function encode(subject: value, ...: EncodeOption): string
  local settings = default_settings()
  for index = 1, #... do
    case ...[index]
    when tag_field(name) then settings.tag_field = name
    when null_value(sentinel) then settings.null_value = sentinel
    when max_depth(limit) then settings.max_depth = limit
    when max_bytes(limit) then settings.max_bytes = limit
    when max_nodes(limit) then settings.max_nodes = limit
    end
  end
  validate_settings(settings)
  return encode_value(subject, settings)
end

--- Decode one complete JSON document into dynamic values or an explicit schema.
-- @param source UTF-8 JSON bytes; malformed input and duplicate keys raise Error.
-- @param target Reflection schema, or nil for dynamic Arrays, Maps, and scalars.
-- @param ... Decoding options; default null is nil and may create holes or absent Map entries.
-- @return Decoded value; nil is a valid successful null result.
-- @usage standard-library-json.md
function decode(source: string, target: reflect.Type?, ...: DecodeOption): value
  local settings = default_settings()
  for index = 1, #... do
    case ...[index]
    when tag_field(name) then settings.tag_field = name
    when null_value(sentinel) then settings.null_value = sentinel
    when max_depth(limit) then settings.max_depth = limit
    when max_bytes(limit) then settings.max_bytes = limit
    when max_nodes(limit) then settings.max_nodes = limit
    when ignore_unknown_fields(ignore) then settings.ignore_unknown_fields = ignore
    end
  end
  validate_settings(settings)
  if #source > settings.max_bytes then
    json_fail("limit_exceeded", "input exceeds max_bytes", root_path(), source, settings.max_bytes + 1)
  end
  local node = parse_document(source, settings)
  return decode_node(node, target, settings, source, root_path())
end

do
  JSON_PATTERN = build_json_pattern()
end
