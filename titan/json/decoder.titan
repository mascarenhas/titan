--- Schema-directed conversion of private parsed JSON nodes.
-- @module titan.json
-- @usage standard-library-json.md

local record Decoder
  const settings: Settings
  const source: string
end

local function Decoder:resolve(target: reflect.Type, position: integer,
                               path: Path): reflect.Type
  case target
  when is_named(named) then
    local found? = reflect.find_nominal(named.name)
    if found == nil then
      json_fail("unknown_type", "nominal type is not registered: " .. named.name,
                path, self.source, position)
    end
    case found
    when is_record(descriptor) then
      return reflect.Type.is_record(descriptor)
    when is_union(descriptor) then
      return reflect.Type.is_union(descriptor)
    when is_interface(descriptor) then
      return reflect.Type.is_interface(descriptor)
    end
  else
    return target
  end
end

local function Decoder:require_kind(node: Node, expected: string, path: Path)
  if node.kind ~= expected then
    json_fail("type_mismatch", "expected JSON " .. expected ..
              ", found " .. node.kind, path, self.source, node.position)
  end
end

local function Decoder:dynamic(node: Node, path: Path): value
  if node.kind == "null" then
    return self.settings.null_value
  elseif node.kind == "boolean" or node.kind == "string" then
    return node.scalar
  elseif node.kind == "number" then
    return number_value(node, false, false, self.source, path)
  elseif node.kind == "array" then
    local elements = node.elements
    local result: {value} = {}
    for index = 1, #elements do
      result[index] = self:dynamic(elements[index], index_path(path, index))
    end
    return result
  else
    local members = node.members
    local result: {string: value} = {}
    for index = 1, #members do
      local member = members[index]
      result[member.name] = self:dynamic(
        member.node, field_path(path, member.name))
    end
    return result
  end
end

-- A nil container slot is absence independently of its nonnil element schema.
-- Only genuinely dynamic elements use the caller's null sentinel.
local function Decoder:slot(node: Node, target: reflect.Type,
                            path: Path): value
  local resolved = self:resolve(target, node.position, path)
  if node.kind == "null" then
    case resolved
    when is_value() then return self.settings.null_value
    else return nil
    end
  end
  return self:decode(node, resolved, path)
end

local function Decoder:decode_array(node: Node, constness: reflect.ArrayTypeConstness,
                             element: reflect.Type, path: Path): value
  self:require_kind(node, "array", path)
  local elements = node.elements
  local result: {value} = {}
  for index = 1, #elements do
    result[index] = self:slot(
      elements[index], element, index_path(path, index))
  end
  case constness
  when is_const() then return result as const {value}
  else return result
  end
end

local function Decoder:decode_map(node: Node, keys: reflect.Type,
                           values: reflect.Type, path: Path): value
  self:require_kind(node, "object", path)
  local key_type = self:resolve(keys, node.position, path)
  local string_keys = false
  case key_type
  when is_string() then string_keys = true
  when is_value() then string_keys = true
  end
  if not string_keys then
    json_fail("unsupported_type", "JSON objects require string or value Map keys",
              path, self.source, node.position)
  end
  local members = node.members
  local result: {string: value} = {}
  for index = 1, #members do
    local member = members[index]
    result[member.name] = self:slot(
      member.node, values, field_path(path, member.name))
  end
  return result
end

local function Decoder:missing(target: reflect.Type, position: integer,
                               path: Path)
  local resolved = self:resolve(target, position, path)
  case resolved
  when is_nil() then return
  when is_option() then return
  when is_value() then return
  end
  json_fail("missing_field", "required field is missing",
            path, self.source, position)
end

-- Implementation notes: doc/implementation/json-library.md#reflection-conversion
local function Decoder:decode_record(node: Node, descriptor: reflect.RecordType,
                              path: Path): value
  self:require_kind(node, "object", path)
  local constructor: reflect.StaticFunctionType? = (function (
      descriptor: reflect.RecordType): reflect.StaticFunctionType?
    for index = 1, #descriptor.statics do
      local candidate = descriptor.statics[index]
      if candidate.name == "new" then return candidate end
    end
    return nil
  end)(descriptor)
  local compatible = false
  if constructor ~= nil and constructor.vararg_descriptor == nil and
      constructor.flexret_descriptor == nil and
      #constructor.return_descriptors == 1 then
    case constructor.return_descriptors[1]
    when is_named(named) then
      compatible = named.name == descriptor.name
    when is_record(record_type) then
      compatible = record_type.name == descriptor.name
    end
  end
  if not compatible then
    json_fail("constructor_unavailable", "record has no compatible public constructor: " ..
              descriptor.name, path, self.source, node.position)
  end

  local arity = #constructor.param_descriptors
  local known: {string: boolean} = {}
  for index = 1, arity do known[constructor.param_names[index]] = true end
  local members = node.members
  local supplied: {string: Node} = {}
  for index = 1, #members do
    local member = members[index]
    if known[member.name] == nil and not self.settings.ignore_unknown_fields then
      json_fail("unknown_field", "unknown record field: " .. member.name,
                field_path(path, member.name), self.source, member.position)
    end
    supplied[member.name] = member.node
  end

  local arguments: {value} = {}
  for index = 1, arity do
    local name = constructor.param_names[index]
    local target = constructor.param_descriptors[index]
    local member? = supplied[name]
    local member_path = field_path(path, name)
    if member == nil then
      self:missing(target, node.position, member_path)
    else
      arguments[index] = self:decode(member, target, member_path)
    end
  end
  return constructor.callable(...arguments[1, arity])
end

local function Decoder:decode_union(node: Node, descriptor: reflect.UnionType,
                             path: Path): value
  self:require_kind(node, "object", path)
  local tag: Node?
  local tag_field = self.settings.tag_field
  local members = node.members
  local supplied: {string: Node} = {}
  for index = 1, #members do
    local member = members[index]
    if member.name == tag_field then tag = member.node
    else supplied[member.name] = member.node
    end
  end
  local tag_path = field_path(path, tag_field)
  if tag == nil then
    json_fail("invalid_union", "union envelope requires a string tag",
              tag_path, self.source, node.position)
  end
  if tag.kind ~= "string" then
    json_fail("invalid_union", "union tag must be a string",
              tag_path, self.source, tag.position)
  end
  local name: string = tag.scalar
  local variant: reflect.VariantType? = (function (
      descriptor: reflect.UnionType, name: string): reflect.VariantType?
    for index = 1, #descriptor.variants do
      local candidate = descriptor.variants[index]
      if candidate.name == name then return candidate end
    end
    return nil
  end)(descriptor, name)
  if variant == nil then
    json_fail("unknown_variant", "unknown public union variant: " .. name,
              tag_path, self.source, tag.position)
  end
  local arity = #variant.parts
  local known: {string: boolean} = {[tag_field] = true}
  for index = 1, arity do
    local part = variant.parts[index]
    if part.name == tag_field then
      json_fail("invalid_union", "union part conflicts with tag field: " .. tag_field,
                tag_path, self.source, tag.position)
    end
    known[part.name] = true
  end
  for index = 1, #members do
    local member = members[index]
    if known[member.name] == nil then
      json_fail("invalid_union", "unknown union envelope member: " .. member.name,
                field_path(path, member.name), self.source, member.position)
    end
  end
  local arguments: {value} = {}
  for index = 1, arity do
    local part = variant.parts[index]
    local member? = supplied[part.name]
    local part_path = field_path(path, part.name)
    if member == nil then
      self:missing(part.type, node.position, part_path)
    else
      arguments[index] = self:decode(member, part.type, part_path)
    end
  end
  return variant.callable(...arguments[1, arity])
end

local function Decoder:decode(node: Node, target: reflect.Type?,
                              path: Path): value
  if target == nil then return self:dynamic(node, path) end
  local resolved = self:resolve(target, node.position, path)
  case resolved
  when is_value() then
    return self:dynamic(node, path)
  when is_option(base) then
    if node.kind == "null" then return nil end
    return self:decode(node, base, path)
  when is_nil() then
    self:require_kind(node, "null", path)
    return nil
  when is_boolean() then
    self:require_kind(node, "boolean", path)
    return node.scalar
  when is_string() then
    self:require_kind(node, "string", path)
    return node.scalar
  when is_integer() then
    self:require_kind(node, "number", path)
    return number_value(node, true, false, self.source, path)
  when is_float() then
    self:require_kind(node, "number", path)
    return number_value(node, false, true, self.source, path)
  when is_array{is_const, elem_descriptor} then
    return self:decode_array(node, is_const, elem_descriptor, path)
  when is_map{key_descriptor, value_descriptor} then
    return self:decode_map(node, key_descriptor, value_descriptor, path)
  when is_record(descriptor) then
    return self:decode_record(node, descriptor, path)
  when is_union(descriptor) then
    return self:decode_union(node, descriptor, path)
  else
    json_fail("unsupported_type", "type has no JSON decoding representation",
              path, self.source, node.position)
    -- The checker does not infer that json_fail always raises.
    return nil
  end
end

local function decode_node(node: Node, target: reflect.Type?, settings: Settings,
                           source: string, path: Path): value
  local decoder = Decoder(settings, source)
  return decoder:decode(node, target, path)
end
