--- Private Relabel grammar and source-budget accounting for JSON documents.
-- @module titan.json
-- @usage standard-library-json.md

-- The grammar owns JSON structure; delayed folds build dense private nodes.
-- Match-time callbacks only count values and container nesting.
local record ParseBudget
  const source: string
  const settings: Settings
  nodes: integer
  depth: integer
end

local record ParseFailure
  const code: string
  const message: string
  const position: integer
end

local record ObjectParseState
  const names: {string: boolean}
  pending_key: Node?
end

local JSON_PATTERN: peg.Pattern? = nil

local function ParseBudget:count_value(position: integer)
  if self.nodes >= self.settings.max_nodes then
    raise ParseFailure {
      code = "limit_exceeded",
      message = "JSON value count exceeds max_nodes",
      position = position
    }
  end
  self.nodes = self.nodes + 1
end

local function ParseBudget:enter_container(position: integer)
  if self.depth >= self.settings.max_depth then
    raise ParseFailure {
      code = "limit_exceeded",
      message = "JSON container nesting exceeds max_depth",
      position = position
    }
  end
  self.depth = self.depth + 1
end

local function ParseBudget:leave_container()
  self.depth = self.depth - 1
end

-- These return only the match control value. Retaining a runtime result for
-- every child would impose the native match-time-result limit on wide lists.
local function json_parse_count(
    _source: string, position: integer, budget_value: value): boolean
  local budget: ParseBudget = budget_value
  budget:count_value(position)
  return true
end

local function json_parse_enter(
    _source: string, position: integer, budget_value: value): boolean
  local budget: ParseBudget = budget_value
  budget:enter_container(position - 1)
  return true
end

local function json_parse_leave(
    _source: string, _position: integer, budget_value: value): boolean
  local budget: ParseBudget = budget_value
  budget:leave_container()
  return true
end

local function json_parse_array_seed(position_value: value): value
  local position: integer = position_value
  local elements: {Node} = {}
  return Node {
    kind = "array",
    position = position,
    scalar = nil,
    elements = elements,
    members = nil
  }
end

local function json_parse_object_seed(position_value: value): value
  local position: integer = position_value
  local members: {Member} = {}
  local names: {string: boolean} = {}
  local state = ObjectParseState(names, nil)
  return Node {
    kind = "object",
    position = position,
    scalar = state,
    elements = nil,
    members = members
  }
end

local function Node:append_parse_element(child: Node)
  local elements: {Node} = self.elements
  -- Private nodes are nonnil, including null nodes, so this dense Array
  -- retains every source position before the public nil/sentinel conversion.
  elements[#elements + 1] = child
end

local function Node:append_parse_object_node(child: Node)
  local state: ObjectParseState = self.scalar
  local key: Node? = state.pending_key
  if key == nil then
    state.pending_key = child
    return
  end
  local name: string = key.scalar
  if state.names[name] ~= nil then
    raise ParseFailure {
      code = "duplicate_key",
      message = "duplicate JSON object member",
      position = key.position
    }
  end
  state.names[name] = true
  local members: {Member} = self.members
  members[#members + 1] = Member(name, key.position, child)
  state.pending_key = nil
end

local function json_parse_array_step(
    accumulator_value: value, child_value: value): value
  local accumulator: Node = accumulator_value
  local child: Node = child_value
  accumulator:append_parse_element(child)
  return accumulator
end

local function json_parse_object_step(
    accumulator_value: value, child_value: value): value
  local accumulator: Node = accumulator_value
  local child: Node = child_value
  -- Member emits separate key and value nodes. Pairing them in this fresh
  -- object state avoids a capture wrapper around every nested member value.
  accumulator:append_parse_object_node(child)
  return accumulator
end

local function json_parse_true(position_value: value): value
  local position: integer = position_value
  return Node {
    kind = "boolean",
    position = position,
    scalar = true,
    elements = nil,
    members = nil
  }
end

local function json_parse_false(position_value: value): value
  local position: integer = position_value
  return Node {
    kind = "boolean",
    position = position,
    scalar = false,
    elements = nil,
    members = nil
  }
end

local function json_parse_null(position_value: value): value
  local position: integer = position_value
  return Node {
    kind = "null",
    position = position,
    scalar = nil,
    elements = nil,
    members = nil
  }
end

local function json_parse_number(
    first_value: value, after_value: value): value
  local first: integer = first_value
  local after: integer = after_value
  -- Defer copying and numeric conversion until the requested type is known.
  return Node {
    kind = "number",
    position = first,
    scalar = after,
    elements = nil,
    members = nil
  }
end

local function json_parse_byte(source: string, position: integer): integer
  return json_byte(source, position)
end

local function json_parse_hex_quad(source: string, first: integer): integer
  local result = 0
  for offset = 0, 3 do
    local octet = json_parse_byte(source, first + offset)
    local digit = 0
    if octet >= 48 and octet <= 57 then
      digit = octet - 48
    elseif octet >= 65 and octet <= 70 then
      digit = octet - 55
    else
      -- The grammar has already accepted exactly four hexadecimal digits.
      digit = octet - 87
    end
    result = result * 16 + digit
  end
  return result
end

local function json_parse_utf8(codepoint: integer): string
  if codepoint < 0x80 then
    return string.char(codepoint)
  elseif codepoint < 0x800 then
    return string.char(0xC0 + (codepoint >> 6),
                        0x80 + (codepoint & 0x3F))
  elseif codepoint < 0x10000 then
    return string.char(0xE0 + (codepoint >> 12),
                        0x80 + ((codepoint >> 6) & 0x3F),
                        0x80 + (codepoint & 0x3F))
  end
  return string.char(0xF0 + (codepoint >> 18),
                      0x80 + ((codepoint >> 12) & 0x3F),
                      0x80 + ((codepoint >> 6) & 0x3F),
                      0x80 + (codepoint & 0x3F))
end

local function json_parse_string(
    first_value: value, after_value: value, budget_value: value): value
  local first: integer = first_value
  local after: integer = after_value
  local budget: ParseBudget = budget_value
  local source = budget.source
  local closing = after - 1
  local output = string.writer()
  defer output:close()
  local cursor = first + 1
  local plain_start = cursor
  while cursor < closing do
    if json_parse_byte(source, cursor) ~= 92 then
      cursor = cursor + 1
    else
      if plain_start < cursor then
        output:write(string.sub(source, plain_start, cursor - 1))
      end
      local escape_position = cursor
      local escaped = json_parse_byte(source, cursor + 1)
      cursor = cursor + 2
      if escaped == 34 then output:write("\"")
      elseif escaped == 92 then output:write("\\")
      elseif escaped == 47 then output:write("/")
      elseif escaped == 98 then output:write("\b")
      elseif escaped == 102 then output:write("\f")
      elseif escaped == 110 then output:write("\n")
      elseif escaped == 114 then output:write("\r")
      elseif escaped == 116 then output:write("\t")
      else
        local codepoint = json_parse_hex_quad(source, cursor)
        cursor = cursor + 4
        if codepoint >= 0xD800 and codepoint <= 0xDBFF then
          if cursor + 5 >= closing or
              json_parse_byte(source, cursor) ~= 92 or
              json_parse_byte(source, cursor + 1) ~= 117 then
            raise ParseFailure {
              code = "invalid_surrogate",
              message = "expected a low surrogate escape",
              position = escape_position
            }
          end
          local low = json_parse_hex_quad(source, cursor + 2)
          if low < 0xDC00 or low > 0xDFFF then
            raise ParseFailure {
              code = "invalid_surrogate",
              message = "expected a low surrogate escape",
              position = cursor
            }
          end
          codepoint = 0x10000 + (codepoint - 0xD800) * 0x400 +
                      low - 0xDC00
          cursor = cursor + 6
        elseif codepoint >= 0xDC00 and codepoint <= 0xDFFF then
          raise ParseFailure {
            code = "invalid_surrogate",
            message = "unexpected low surrogate escape",
            position = escape_position
          }
        end
        output:write(json_parse_utf8(codepoint))
      end
      plain_start = cursor
    end
  end
  if plain_start < closing then
    output:write(string.sub(source, plain_start, closing - 1))
  end
  return Node {
    kind = "string",
    position = first,
    scalar = output:drain(),
    elements = nil,
    members = nil
  }
end

local function json_parse_message(code: string): string
  if code == "expected_value" then return "expected a JSON value"
  elseif code == "expected_object_key" then
    return "expected a quoted object key"
  elseif code == "expected_colon" then
    return "expected ':' after object key"
  elseif code == "expected_array_separator" then
    return "expected ',' or ']' after array element"
  elseif code == "expected_object_separator" then
    return "expected ',' or '}' after object member"
  elseif code == "leading_zero" then
    return "leading zero in JSON number"
  elseif code == "expected_integer_digit" then
    return "expected an integer digit"
  elseif code == "expected_fraction_digit" then
    return "expected a digit after decimal point"
  elseif code == "expected_exponent_digit" then
    return "expected an exponent digit"
  elseif code == "invalid_number_continuation" then
    return "invalid byte after JSON number"
  elseif code == "invalid_literal" then
    return "invalid JSON literal"
  elseif code == "invalid_literal_continuation" then
    return "invalid byte after JSON literal"
  elseif code == "invalid_escape" then
    return "invalid JSON string escape"
  elseif code == "unfinished_escape" then
    return "expected a byte after escape introducer"
  elseif code == "expected_hex_digit" then
    return "expected a hexadecimal digit in Unicode escape"
  elseif code == "unescaped_control" then
    return "control byte must be escaped in JSON string"
  elseif code == "invalid_utf8" then
    return "invalid UTF-8 in JSON string"
  elseif code == "unterminated_string" then
    return "expected closing quote"
  elseif code == "trailing_input" then
    return "unexpected data after JSON value"
  end
  return "invalid JSON"
end

local function build_json_pattern(): peg.Pattern
  local definitions: {peg.Definition} = {
    peg.define("state", peg.argument(1)),
    peg.define("json_ws", peg.set(" \t\r\n")),
    peg.define("json_end", peg.choice(
      peg.set(" \t\r\n,]}"), peg.negative(peg.any()))),
    peg.define("digit", peg.ranges("09")),
    peg.define("unescaped_ascii", peg.ranges(" !", "#[", "]\127")),
    peg.define("unicode_scalar", peg.choice(
      peg.utf_range(0x80, 0xD7FF), peg.utf_range(0xE000, 0x10FFFF))),
    peg.define("control", peg.ranges("\0\31")),
    peg.define("simple_escape", peg.set("\"\\/bfnrt")),
    peg.define_value("count_value", json_parse_count),
    peg.define_value("enter_container", json_parse_enter),
    peg.define_value("leave_container", json_parse_leave),
    peg.define_value("new_array", json_parse_array_seed),
    peg.define_value("new_object", json_parse_object_seed),
    peg.define_value("append_array", json_parse_array_step),
    peg.define_value("append_object", json_parse_object_step),
    peg.define_value("new_true", json_parse_true),
    peg.define_value("new_false", json_parse_false),
    peg.define_value("new_null", json_parse_null),
    peg.define_value("new_number", json_parse_number),
    peg.define_value("new_string", json_parse_string),
  }
  return peg.compile([=[
    Document <- WS Value (!. / %{trailing_input})

    Value <- (&'{' Count Object
              / &'[' Count Array
              / &'"' Count String
              / &[-0-9] Count Number
              / &'t' Count True
              / &'f' Count False
              / &'n' Count Null) WS
           / %{expected_value}
    Count <- %state => count_value
    Enter <- %state => enter_container
    Leave <- %state => leave_container
    WS <- %json_ws*

    Array <- ((ArraySeed WS
               (']' / Value (',' WS Value)*
                      (']' / %{expected_array_separator})))
              ~> append_array) Leave
    ArraySeed <- ({} '[' Enter) -> new_array

    Object <- ((ObjectSeed WS
                ('}' / Member (',' WS Member)*
                       ('}' / %{expected_object_separator})))
               ~> append_object) Leave
    ObjectSeed <- ({} '{' Enter) -> new_object
    Member <- (String / %{expected_object_key}) WS
              (':' / %{expected_colon}) WS Value

    Number <- ({} '-'? Integer Fraction? Exponent?
               (&%json_end / %{invalid_number_continuation}) {})
              -> new_number
    Integer <- '0' (!%digit / %{leading_zero})
             / [1-9] %digit*
             / %{expected_integer_digit}
    Fraction <- '.' (%digit / %{expected_fraction_digit}) %digit*
    Exponent <- [eE] [+-]?
                (%digit / %{expected_exponent_digit}) %digit*

    True <- ({} 't' ('r' / %{invalid_literal})
                    ('u' / %{invalid_literal})
                    ('e' / %{invalid_literal}) LiteralEnd) -> new_true
    False <- ({} 'f' ('a' / %{invalid_literal})
                     ('l' / %{invalid_literal})
                     ('s' / %{invalid_literal})
                     ('e' / %{invalid_literal}) LiteralEnd) -> new_false
    Null <- ({} 'n' ('u' / %{invalid_literal})
                    ('l' / %{invalid_literal})
                    ('l' / %{invalid_literal}) LiteralEnd) -> new_null
    LiteralEnd <- &%json_end / %{invalid_literal_continuation}

    String <- ({} '"' StringChar*
               ('"' / %{unterminated_string}) {} %state) -> new_string
    StringChar <- !'"'
                  (%unescaped_ascii / %unicode_scalar / Escape
                   / &%control %{unescaped_control}
                   / !. %{unterminated_string}
                   / %{invalid_utf8})
    Escape <- '\'
              (%simple_escape / 'u' Hex Hex Hex Hex
               / !. %{unfinished_escape} / %{invalid_escape})
    Hex <- [0-9a-fA-F] / %{expected_hex_digit}
  ]=], definitions)
end

local function parse_document(source: string, settings: Settings): Node
  local budget = ParseBudget { source = source, settings = settings, nodes = 0, depth = 0 }
  local result: value, label: value, position: value =
    JSON_PATTERN:match(source, 1, budget)
  if result == nil then
    local code: string = label
    local failure_position: integer = position
    json_fail(code, json_parse_message(code), root_path(), source,
              failure_position)
  end
  return result
catch
  if error is ParseFailure then
    local failure: ParseFailure = error
    json_fail(failure.code, failure.message, root_path(), source,
              failure.position)
  end
  raise
end
