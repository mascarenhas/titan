--- Byte strings, formatting, binary packing, in-memory streams, and regular expressions.
-- @module titan.string
-- @usage standard-library-string.md

foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "titan/ffi.h"
foreign import "string.h"
foreign import "ctype.h"
local peg = import "peg"
local gc = import "gc"


-- The canonical folder main is the complete public surface. Contributors
-- contain only module-local records, state, and shared helpers.

local MAXIMUM_STRING_BYTES = 0
local INTEGER_LENGTH_MODIFIER = ""
local HOST_IS_LITTLE_ENDIAN = false
local NATIVE_MAXIMUM_ALIGNMENT = 0
local FORMAT_PATTERN: peg.Pattern? = nil
local REGEX_ALL_BYTES = ""
local REGEX_PARSER: peg.Pattern? = nil

--- Inclusive one-based byte positions for a match or capture.
-- @field first Inclusive one-based first byte position.
-- @field last Inclusive last byte position; an empty span has last < first.
-- @usage standard-library-string.md#compiled-regular-expressions
record Span
  first: integer
  last: integer
end

--- An immutable subject and its whole-match and capture spans.
-- @usage standard-library-string.md#compiled-regular-expressions
record RegexMatch
  local subject: string
  local matched_span: Span
  local groups: {Span}
end

--- A compiled byte-oriented regular expression.
-- @usage standard-library-string.md#compiled-regular-expressions
record Regex
  local expression: string
  local capture_count: integer
  local pattern: peg.Pattern
  local anchored_start: boolean
end

--- A synchronous reader over immutable in-memory bytes.
-- @usage standard-library-string.md#in-memory-streams
record StringReader
  local contents: string
  local position: integer
end

--- A synchronous chunk builder with linear-time draining.
-- @usage standard-library-string.md#in-memory-streams
record StringWriter
  local chunks: {string}
  local length: integer
end

--- Return the number of bytes in a string.
-- @param subject Binary byte string to inspect.
-- @return Number of bytes in subject.
-- @usage standard-library-string.md#byte-operations
function len(subject: string): integer
  return #subject
end

--- Return an inclusive byte substring using Lua-style negative positions.
-- @param subject Binary byte string to inspect.
-- @param first One-based first byte position; negative positions count from the end.
-- @param last Inclusive last byte position; nil selects the documented default.
-- @return Selected byte substring.
-- @usage standard-library-string.md#byte-operations
function sub(subject: string, first: integer,
             last: integer?): string
  local length = #subject
  local normalized_first = initial_position(first, length)
  local raw_last = -1
  if last then raw_last = last end
  local normalized_last = ending_position(raw_last, length)
  if normalized_first > normalized_last then return "" end
  return copy_interval(subject, normalized_first,
                       normalized_last - normalized_first + 1)
end

--- Reverse the bytes of a string.
-- @param subject Binary byte string to inspect.
-- @return String with its byte order reversed.
-- @usage standard-library-string.md#byte-operations
function reverse(subject: string): string
  local length = #subject
  if length == 0 then return "" end
  local storage = foreign char.new_array(length)
  local source = subject as foreign const *char
  local index = 0
  while index < length do
    storage[index] = source[length - index - 1]
    index = index + 1
  end
  return storage as string
end

--- Lowercase bytes using the current C locale.
-- @param subject Binary byte string to inspect.
-- @return String with lowercase byte conversion applied.
-- @usage standard-library-string.md#byte-operations
function lower(subject: string): string
  local length = #subject
  if length == 0 then return "" end
  local storage = foreign char.new_array(length)
  local source = subject as foreign const *char
  local index = 0
  while index < length do
    local octet = source[index] as foreign unsigned char
    storage[index] =
      ffi.tolower(octet as foreign int) as foreign char
    index = index + 1
  end
  return storage as string
end

--- Uppercase bytes using the current C locale.
-- @param subject Binary byte string to inspect.
-- @return String with uppercase byte conversion applied.
-- @usage standard-library-string.md#byte-operations
function upper(subject: string): string
  local length = #subject
  if length == 0 then return "" end
  local storage = foreign char.new_array(length)
  local source = subject as foreign const *char
  local index = 0
  while index < length do
    local octet = source[index] as foreign unsigned char
    storage[index] =
      ffi.toupper(octet as foreign int) as foreign char
    index = index + 1
  end
  return storage as string
end

--- Repeat a string with an optional separator between copies.
-- @param subject Binary byte string to inspect.
-- @param count Number of repetitions.
-- @param separator Bytes between repetitions; nil uses no separator.
-- @return Repeated bytes with any supplied separator.
-- @usage standard-library-string.md#byte-operations
function rep(subject: string, count: integer,
             separator: string?): string
  if count <= 0 then return "" end

  local actual_separator = ""
  if separator then actual_separator = separator end
  local subject_length = #subject
  local separator_length = #actual_separator
  if subject_length == 0 and separator_length == 0 then return "" end
  local maximum_length = MAXIMUM_STRING_BYTES

  if subject_length > maximum_length - separator_length then
    raise "resulting string is too large"
  end
  local unit_length = subject_length + separator_length
  if unit_length > maximum_length // count then
    raise "resulting string is too large"
  end
  local total_length = unit_length * count - separator_length
  if total_length == 0 then return "" end

  local storage = foreign char.new_array(total_length)
  local output = storage as foreign *char
  local subject_bytes = subject as foreign const *char
  local separator_bytes =
    actual_separator as foreign const *char
  local occurrence = 1
  local offset = 0
  while occurrence < count do
    if subject_length > 0 then
      ffi.memcpy(output + offset, subject_bytes,
                     subject_length as foreign size_t)
      offset = offset + subject_length
    end
    if separator_length > 0 then
      ffi.memcpy(output + offset, separator_bytes,
                     separator_length as foreign size_t)
      offset = offset + separator_length
    end
    occurrence = occurrence + 1
  end
  if subject_length > 0 then
    ffi.memcpy(output + offset, subject_bytes,
                   subject_length as foreign size_t)
  end
  return storage as string
end

--- Return byte values from an inclusive range as multiple results.
-- @param subject Binary byte string to inspect.
-- @param first One-based first byte position; negative positions count from the end.
-- @param last Inclusive last byte position; nil selects the documented default.
-- @return Byte values in the selected inclusive range.
-- @usage standard-library-string.md#byte-operations
function byte(subject: string, first: integer?,
              last: integer?): (...: integer)
  local length = #subject
  local raw_first = 1
  if first then raw_first = first end
  local normalized_first = initial_position(raw_first, length)
  local raw_last = raw_first
  if last then raw_last = last end
  local normalized_last = ending_position(raw_last, length)
  if normalized_first > normalized_last then return end
  if normalized_last - normalized_first + 1 > 200 then
    raise "too many flexible return values (max 200)"
  end
  local source = subject as foreign const *unsigned char
  local bytes: { integer } = {}
  for i = normalized_first, normalized_last do
    bytes[i - normalized_first + 1] = source[i - 1] as integer
  end
  return ...bytes
end

--- Build a binary string from byte values in 0..255.
-- @param ... Byte values, each in 0..255.
-- @return Binary string containing the supplied byte values.
-- @usage standard-library-string.md#byte-operations
function char(...: integer): string
  local length = #...
  if length == 0 then return "" end
  local storage = foreign char.new_array(length)
  local index = 1
  while index <= length do
    local octet = ...[index]
    if octet < 0 or octet > 255 then
      raise "character value out of range"
    end
    local byte = octet as foreign unsigned char
    storage[index - 1] = byte as foreign char
    index = index + 1
  end
  return storage as string
end

--- Convert a value through Lua's string conversion, including __tostring.
-- @param candidate Value to convert with Lua string conversion.
-- @return Lua string representation of the candidate.
-- @usage standard-library-string.md#value-conversion
function tostring(candidate: value): string
  -- Implementation notes: doc/implementation/string-library.md#raw-lua-conversions-and-fixed-call-adjustment
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  -- Candidate plus the two temporary slots used by luaL_getmetafield/callmeta.
  if ffi.lua_checkstack(L, 3) == 0 then
    raise "cannot reserve Lua stack for string conversion"
  end
  ffi.lua_pushtvalue(L, candidate)
  ffi.luaL_tolstring(L, -1, nil)
  return ffi.lua_totvalue(L, -1) as value
end

--- Create a reader over the supplied binary string.
-- @param contents String bytes supplied to this operation.
-- @return New in-memory reader.
-- @usage standard-library-string.md#in-memory-streams
function reader(contents: string): StringReader
  return StringReader(contents, 1)
end

--- Return all remaining bytes, or nil at EOF.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-string.md#in-memory-streams
function StringReader:read(): string?
  if self.position > #self.contents then return nil end
  local result = sub(self.contents, self.position)
  self.position = #self.contents + 1
  return result
end

--- Read through a delimiter, optionally removing it from the returned bytes.
-- @param delimiter Nonempty byte delimiter to include or remove.
-- @param chop Remove the delimiter when true; nil or false retains it.
-- @return Copied bytes or text, or nil at EOF or when absent.
-- @usage standard-library-string.md#in-memory-streams
function StringReader:read_until(delimiter: string,
                                 chop: boolean?): string?
  if self.position > #self.contents then return nil end
  if #delimiter == 0 then
    raise "read delimiter must not be empty"
  end

  local first: integer?, last: integer? =
    find(self.contents, delimiter, self.position)
  if not first then
    local result = sub(self.contents, self.position)
    self.position = #self.contents + 1
    return result
  end

  local delimiter_first = first as integer
  local delimiter_last = last as integer
  local result_last = delimiter_last
  if chop then result_last = delimiter_first - 1 end
  local result = sub(self.contents, self.position, result_last)
  self.position = delimiter_last + 1
  return result
end

--- Discard remaining bytes and make future reads return nil.
-- @usage standard-library-string.md#in-memory-streams
function StringReader:close()
  self.contents = ""
  self.position = 1
end

--- Create an empty in-memory byte writer.
-- @return New empty in-memory writer.
-- @usage standard-library-string.md#in-memory-streams
function writer(): StringWriter
  return StringWriter()
end

--- Append immutable bytes to this builder.
-- @param data Immutable binary bytes to write or decode.
-- @usage standard-library-string.md#in-memory-streams
function StringWriter:write(data: string)
  builder_append(self, data)
end

--- Return the accumulated bytes and reset this builder to empty.
-- @return Accumulated bytes, leaving this writer empty.
-- @usage standard-library-string.md#in-memory-streams
function StringWriter:drain(): string
  local result = builder_finish(self)
  local chunks: {string} = {}
  self.chunks = chunks
  self.length = 0
  return result
end

--- Discard the accumulated bytes and reset this builder.
-- @usage standard-library-string.md#in-memory-streams
function StringWriter:close()
end

-- Search for a literal byte sequence and return one-based inclusive bounds.
-- This is deliberately length-aware: embedded zero bytes are ordinary data.
--- Search for literal bytes and return inclusive match positions, or nils.
-- @param subject Binary byte string to inspect.
-- @param needle Literal byte sequence to find.
-- @param init Initial one-based byte position; nil starts at the beginning.
-- @return One-based first match position, or nil when absent.
-- @return Inclusive last match position, or nil when absent.
-- @usage standard-library-string.md#byte-operations
function find(subject: string, needle: string,
              init: integer?): (integer?, integer?)
  local raw_init = 1
  if init then raw_init = init end
  local subject_length = #subject
  local needle_length = #needle
  local first = initial_position(raw_init, subject_length)
  if first > subject_length + 1 then return nil, nil end
  if needle_length == 0 then return first, first - 1 end
  if first > subject_length or
      needle_length > subject_length - first + 1 then
    return nil, nil
  end

  local subject_bytes =
    subject as foreign const *char
  local needle_bytes =
    needle as foreign const *char
  local offset = first - 1
  local limit = subject_length - needle_length
  while offset <= limit do
    if subject_bytes[offset] == needle_bytes[0] and
        ffi.memcmp(
          subject_bytes + offset, needle_bytes,
          needle_length as foreign size_t) == 0 then
      return offset + 1, offset + needle_length
    end
    offset = offset + 1
  end
  return nil, nil
end

--- Format checked values using Lua-compatible conversion flags, widths, and precision.
-- @param format_string Lua-compatible formatting or binary-packing specification.
-- @param ... Values consumed by the format specification.
-- @return Formatted string.
-- @usage standard-library-string.md#formatting
function format(format_string: string, ...: value): string
  local captured = FORMAT_PATTERN:match(format_string)
  if captured == nil then raise "invalid conversion to 'format'" end
  local plan = captured as FormatPlan
  local builder = StringWriter()
  local argument = 1
  while argument <= #plan.partials do
    if argument > #... then
      raise "no value for format conversion"
    end
    local partial = plan.partials[argument] as FormatPartial
    builder_append(builder, partial(...[argument]))
    argument = argument + 1
  end
  builder_append(builder, plan.trailer)
  return builder_finish(builder)
end

--- Encode values into binary bytes using a Lua-compatible packing format.
-- @param format_string Lua-compatible formatting or binary-packing specification.
-- @param ... Values consumed by the format specification.
-- @return Encoded binary bytes.
-- @usage standard-library-string.md#binary-packing
function pack(format_string: string, ...: value): string
  local state = new_pack_state(format_string)
  local builder = StringWriter()
  local arguments: {value} = {...}
  local argument = 0

  while not pack_format_at_end(state) do
    local option = read_pack_details(state, builder.length)
    checked_pack_growth(builder.length, option.padding)
    checked_pack_growth(
      builder.length + option.padding, option.size)
    if option.padding > 0 then
      builder_append(builder, zero_bytes(option.padding))
    end

    if option.kind == PACK_INT then
      argument = argument + 1
      local number =
        (next_pack_argument(arguments, argument) as integer)
          as foreign lua_Integer
      check_signed_pack_range(number, option.size)
      builder_append(
        builder,
        pack_integer_bytes(
          number, option.size, state.little_endian, number < 0))
    elseif option.kind == PACK_UINT then
      argument = argument + 1
      local number =
        (next_pack_argument(arguments, argument) as integer)
          as foreign lua_Integer
      check_unsigned_pack_range(number, option.size)
      builder_append(
        builder,
        pack_integer_bytes(
          number, option.size, state.little_endian, false))
    elseif option.kind == PACK_FLOAT then
      argument = argument + 1
      builder_append(
        builder,
        pack_float_bytes(
          (next_pack_argument(arguments, argument) as float)
            as foreign lua_Number,
          state.little_endian, state.native_little_endian))
    elseif option.kind == PACK_NUMBER then
      argument = argument + 1
      builder_append(
        builder,
        pack_number_bytes(
          (next_pack_argument(arguments, argument) as float)
            as foreign lua_Number,
          state.little_endian, state.native_little_endian))
    elseif option.kind == PACK_DOUBLE then
      argument = argument + 1
      builder_append(
        builder,
        pack_double_bytes(
          (next_pack_argument(arguments, argument) as float)
            as foreign lua_Number,
          state.little_endian, state.native_little_endian))
    elseif option.kind == PACK_CHAR then
      argument = argument + 1
      local text =
        next_pack_argument(arguments, argument) as string
      if #text > option.size then
        raise "string longer than given size"
      end
      builder_append(builder, text)
      if #text < option.size then
        builder_append(
          builder, zero_bytes(option.size - #text))
      end
    elseif option.kind == PACK_STRING then
      argument = argument + 1
      local text =
        next_pack_argument(arguments, argument) as string
      check_unsigned_pack_range(
        #text as foreign lua_Integer, option.size)
      builder_append(
        builder,
        pack_integer_bytes(
          #text as foreign lua_Integer, option.size,
          state.little_endian, false))
      checked_pack_growth(builder.length, #text)
      builder_append(builder, text)
    elseif option.kind == PACK_ZSTRING then
      argument = argument + 1
      local text =
        next_pack_argument(arguments, argument) as string
      if contains_byte(text, 0) then
        raise "string contains zeros"
      end
      checked_pack_growth(builder.length, #text)
      builder_append(builder, text)
      checked_pack_growth(builder.length, 1)
      builder_append(builder, zero_bytes(1))
    elseif option.kind == PACK_PADDING then
      builder_append(builder, zero_bytes(1))
    end
  end

  return builder_finish(builder)
end

--- Return the fixed byte size of a packing format, rejecting variable-size fields.
-- @param format_string Lua-compatible formatting or binary-packing specification.
-- @return Fixed format size in bytes.
-- @usage standard-library-string.md#binary-packing
function packsize(format_string: string): integer
  local state = new_pack_state(format_string)
  local total_size = 0
  while not pack_format_at_end(state) do
    local option = read_pack_details(state, total_size)
    if option.kind == PACK_STRING or
        option.kind == PACK_ZSTRING then
      raise "variable-length format"
    end
    checked_pack_growth(total_size, option.padding)
    total_size = total_size + option.padding
    checked_pack_growth(total_size, option.size)
    total_size = total_size + option.size
  end
  return total_size
end

--- Decode values from binary bytes and return the next unread byte position.
-- @param format_string Lua-compatible formatting or binary-packing specification.
-- @param data Immutable binary bytes to write or decode.
-- @param initial Initial headers to validate and copy, or nil for an empty collection.
-- @return Decoded fixed and flexible values, followed by the next unread byte position.
-- @usage standard-library-string.md#binary-packing
function unpack(format_string: string, data: string,
                initial: integer?): (value, ...: value)
  local raw_initial = 1
  if initial then raw_initial = initial end
  local position =
    initial_position(raw_initial, #data) - 1
  if position > #data then
    raise "initial position out of string"
  end

  local state = new_pack_state(format_string)
  local results: {value} = {}
  while not pack_format_at_end(state) do
    local option = read_pack_details(state, position)
    if option.padding > #data - position or
        option.size > #data - position - option.padding then
      raise "data string too short"
    end
    position = position + option.padding

    if option.kind == PACK_INT or option.kind == PACK_UINT then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      results[#results + 1] =
        unpack_integer_bytes(
          data, position, option.size, state.little_endian,
          option.kind == PACK_INT)
    elseif option.kind == PACK_FLOAT then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      results[#results + 1] =
        unpack_float_bytes(
          data, position, state.little_endian,
          state.native_little_endian)
    elseif option.kind == PACK_NUMBER then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      results[#results + 1] =
        unpack_number_bytes(
          data, position, state.little_endian,
          state.native_little_endian)
    elseif option.kind == PACK_DOUBLE then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      results[#results + 1] =
        unpack_double_bytes(
          data, position, state.little_endian,
          state.native_little_endian)
    elseif option.kind == PACK_CHAR then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      if option.size == 0 then
        results[#results + 1] = ""
      else
        results[#results + 1] =
          copy_interval(data, position + 1, option.size)
      end
    elseif option.kind == PACK_STRING then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      local packed_length =
        unpack_integer_bytes(
          data, position, option.size,
          state.little_endian, false) as foreign lua_Unsigned
      if packed_length >
          (MAXIMUM_STRING_BYTES as foreign lua_Unsigned) then
        raise "data string too short"
      end
      local length = packed_length as integer
      if length > #data - position - option.size then
        raise "data string too short"
      end
      if length == 0 then
        results[#results + 1] = ""
      else
        results[#results + 1] =
          copy_interval(
            data, position + option.size + 1, length)
      end
      position = position + length
    elseif option.kind == PACK_ZSTRING then
      if #results >= 199 then
        raise "too many flexible return values (max 200)"
      end
      local bytes =
        data as foreign const *unsigned char
      local ending = position
      while ending < #data and bytes[ending] ~= 0 do
        ending = ending + 1
      end
      if ending >= #data then
        raise "unfinished string for format 'z'"
      end
      results[#results + 1] =
        copy_interval(data, position + 1, ending - position)
      position = ending + 1
    end
    position = position + option.size
  end

  results[#results + 1] = position + 1
  return ...results
end

--- Compile a byte-oriented regular expression, raising on invalid syntax.
-- @param expression Byte-oriented regular-expression source.
-- @return Compiled regular expression.
-- @usage standard-library-string.md#compiled-regular-expressions
function compile_regex(expression: string): Regex
  local parsed = parse_regex(expression)
  local projected, overflow_position =
    regex_projected_size(parsed.root)
  projected = regex_saturating_add(
    projected, parsed.capture_count * 14 + 12)
  if projected > REGEX_PATTERN_LIMIT then
    if overflow_position == 0 then
      overflow_position = parsed.root:position()
    end
    raise_regex_diagnostic(
      "pattern_too_large",
      "compiled regular expression exceeds the pattern-size limit",
      expression, overflow_position)
  end

  local pattern: peg.Pattern? = nil
  do
    pattern = regex_build_pattern(parsed)
  catch
    raise_regex_diagnostic(
      "pattern_too_large",
      "compiled regular expression exceeds the pattern-size limit",
      expression, parsed.root:position())
  end
  return Regex {
    expression = expression,
    capture_count = parsed.capture_count,
    pattern = pattern as peg.Pattern,
    anchored_start = parsed.anchored_start
  }
end

--- Return this regular expression's original source text.
-- @return Original regular-expression source.
-- @usage standard-library-string.md#compiled-regular-expressions
function Regex:source(): string
  return self.expression
end

--- Return the number of capture groups in this expression.
-- @return Number of capture groups.
-- @usage standard-library-string.md#compiled-regular-expressions
function Regex:group_count(): integer
  return self.capture_count
end

--- Search for the leftmost match from an optional byte position.
-- @param subject Binary byte string to inspect.
-- @param init Initial one-based byte position; nil starts at the beginning.
-- @return Typed leftmost match, or nil when absent.
-- @usage standard-library-string.md#compiled-regular-expressions
function Regex:match(subject: string,
                     init: integer?): RegexMatch?
  local position, overshoot = regex_normalized_init(subject, init)
  if overshoot then return nil end
  return regex_find_from(self, subject, position)
end

--- Iterate successive typed matches, making progress after empty matches.
-- @param subject Binary byte string to inspect.
-- @param init Initial one-based byte position; nil starts at the beginning.
-- @return Iterator yielding the documented match or field values until nil.
-- @usage standard-library-string.md#iteration-and-substitution
function Regex:gmatch(subject: string,
                      init: integer?): function (): (RegexMatch?)
  local position, overshoot = regex_normalized_init(subject, init)
  local current = position
  local previous_end = 0
  local finished = overshoot
  local anchored = regex_is_start_anchored(self)

  return function (): RegexMatch?
    while not finished do
      local found: RegexMatch? =
        regex_find_from(self, subject, current)
      if not found then
        finished = true
        return nil
      end
      local actual = found as RegexMatch
      local span = actual.matched_span
      local after = span.last + 1
      if span.last < span.first and after == previous_end then
        if after > #subject then
          finished = true
          return nil
        end
        current = after + 1
        if anchored then
          finished = true
          return nil
        end
      else
        previous_end = after
        current = after
        if anchored then finished = true end
        return actual
      end
    end
    return nil
  end
end

--- Replace whole matches with callback results and return the substitution count.
-- @param subject Binary byte string to inspect.
-- @param replacement Callback receiving the whole match and returning replacement bytes.
-- @param maximum Maximum substitutions; nil selects all matches.
-- @return String after substitutions.
-- @return Number of substitutions performed.
-- @usage standard-library-string.md#iteration-and-substitution
function Regex:gsub(subject: string,
                    replacement: function (string): (string),
                    maximum: integer?): (string, integer)
  local limit = #subject + 1
  if maximum then limit = maximum end

  if limit <= 0 then return subject, 0 end

  local builder = StringWriter()
  local search = 1
  local copied = 1
  local previous_end = 0
  local count = 0
  local anchored = regex_is_start_anchored(self)
  local finished = false
  while not finished and count < limit do
    local found: RegexMatch? =
      regex_find_from(self, subject, search)
    if not found then
      finished = true
    else
      local actual = found as RegexMatch
      local span = actual.matched_span
      local after = span.last + 1
      if span.last < span.first and after == previous_end then
        if after > #subject or anchored then
          finished = true
        else
          search = after + 1
        end
      else
        if span.first > copied then
          builder_append(
            builder,
            copy_interval(subject, copied, span.first - copied))
        end
        builder_append(
          builder, replacement(actual:whole()))
        count = count + 1
        copied = after
        previous_end = after
        search = after
        if anchored then finished = true end
      end
    end
  end
  if copied <= #subject then
    builder_append(
      builder,
      copy_interval(subject, copied, #subject - copied + 1))
  end
  return builder_finish(builder), count
end

--- Return the whole match's inclusive byte span.
-- @return Whole match byte span.
-- @usage standard-library-string.md#compiled-regular-expressions
function RegexMatch:span(): Span
  return Span(self.matched_span.first, self.matched_span.last)
end

--- Return the number of capture groups represented by this match.
-- @return Number of capture groups.
-- @usage standard-library-string.md#compiled-regular-expressions
function RegexMatch:group_count(): integer
  return #self.groups
end

--- Return a capture span, or nil when that capture did not participate.
-- @param index One-based capture-group index.
-- @return Selected capture span, or nil when it did not participate.
-- @usage standard-library-string.md#compiled-regular-expressions
function RegexMatch:group_span(index: integer): Span?
  if index < 1 or index > #self.groups then
    raise "capture group index out of range"
  end
  local span = self.groups[index] as Span
  if span.first == 0 and span.last == -1 then return nil end
  return Span(span.first, span.last)
end

--- Return the complete matched byte string.
-- @return Whole matched byte string.
-- @usage standard-library-string.md#compiled-regular-expressions
function RegexMatch:whole(): string
  return copy_interval(
    self.subject, self.matched_span.first,
    self.matched_span.last - self.matched_span.first + 1)
end

--- Return one captured string, or nil for an unmatched group.
-- @param index One-based capture-group index.
-- @return Captured bytes, or nil when the group did not participate.
-- @usage standard-library-string.md#compiled-regular-expressions
function RegexMatch:group(index: integer): string?
  local span: Span? = self:group_span(index)
  if not span then return nil end
  local actual = span as Span
  return copy_interval(
    self.subject, actual.first, actual.last - actual.first + 1)
end

--- Return the whole match when there are no captures, otherwise all capture values.
-- @return Whole match or capture values, preserving unmatched captures as nil.
-- @usage standard-library-string.md#compiled-regular-expressions
function RegexMatch:values(): (string?, ...: string?)
  if #self.groups == 0 then return self:whole() end
  local results: { string? } = {}
  for i = 1, #self.groups do
    results[i] = self:group(i)
  end
  return ...results
end

--- Search with a cached compiled expression and return a typed match or nil.
-- @param subject Binary byte string to inspect.
-- @param expression Byte-oriented regular-expression source.
-- @param init Initial one-based byte position; nil starts at the beginning.
-- @return Typed leftmost match, or nil when absent.
-- @usage standard-library-string.md#compiled-regular-expressions
function match(subject: string, expression: string,
               init: integer?): RegexMatch?
  return cached_regex(expression):match(subject, init)
end

--- Iterate typed matches using a cached compiled expression.
-- @param subject Binary byte string to inspect.
-- @param expression Byte-oriented regular-expression source.
-- @param init Initial one-based byte position; nil starts at the beginning.
-- @return Iterator yielding the documented match or field values until nil.
-- @usage standard-library-string.md#iteration-and-substitution
function gmatch(subject: string, expression: string,
                init: integer?): function (): (RegexMatch?)
  return cached_regex(expression):gmatch(subject, init)
end

--- Iterate whole-match strings or capture tuples from a cached expression.
-- @param subject Binary byte string to inspect.
-- @param pattern Byte-oriented regular-expression source.
-- @return Iterator yielding the documented match or field values until nil.
-- @usage standard-library-string.md#iteration-and-substitution
function matches(subject: string, pattern: string):
                 function (): (string?, ...: string?)
  local iterator = cached_regex(pattern):gmatch(subject, nil)
  return function (): (string?, ...: string?)
    local found: RegexMatch? = iterator()
    if not found then return nil end
    return found:values()
  end
end

--- Iterate byte fields separated by a regex, or individual bytes when no delimiter is given.
-- @param subject Binary byte string to inspect.
-- @param delimiter Regex delimiter; nil iterates individual bytes.
-- @return Iterator yielding the documented match or field values until nil.
-- @usage standard-library-string.md#compiled-regular-expressions
function split(subject: string, delimiter: string?): function (): (string?)
  if not delimiter then
    local position = 1
    return function (): string?
      if position > #subject then return nil end
      local result = sub(subject, position, position)
      position = position + 1
      return result
    end
  end

  local separator = cached_regex(delimiter)
  local iterator = separator:gmatch(subject, nil)
  local position = 1
  local finished = false
  return function (): string?
    if finished then return nil end
    local found: RegexMatch? = iterator()
    if not found then
      finished = true
      return sub(subject, position)
    end
    local span = found:span()
    local result = sub(subject, position, span.first - 1)
    position = span.last + 1
    return result
  end
end

--- Replace whole matches through a callback using a cached compiled expression.
-- @param subject Binary byte string to inspect.
-- @param expression Byte-oriented regular-expression source.
-- @param replacement Callback receiving the whole match and returning replacement bytes.
-- @param maximum Maximum substitutions; nil selects all matches.
-- @return String after substitutions.
-- @return Number of substitutions performed.
-- @usage standard-library-string.md#iteration-and-substitution
function gsub(subject: string, expression: string,
              replacement: function (string): (string),
              maximum: integer?): (string, integer)
  return cached_regex(expression):gsub(subject, replacement, maximum)
end

do
  MAXIMUM_STRING_BYTES = maximum_string_bytes()
  INTEGER_LENGTH_MODIFIER = integer_length_modifier()
  HOST_IS_LITTLE_ENDIAN = host_is_little_endian()
  NATIVE_MAXIMUM_ALIGNMENT = native_maximum_alignment()
  FORMAT_PATTERN = build_format_pattern()
  REGEX_WORD_BYTE_FLAGS = regex_byte_flags(REGEX_WORD_BYTES)
  REGEX_ALL_BYTES = regex_all_bytes()
  REGEX_PARSER = build_regex_parser()
  gc.weak(_regex_cache as {value: value})
end
