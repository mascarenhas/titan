local record RegexDiagnostic
  const label: string
  const message: string
  const source: string
  const position: integer
  const line: integer
  const column: integer
  const source_line: string
end

local _regex_cache: {string: Regex} = {}
local _regex_group_sentinel: {value: value} = {}

local function cached_regex(expression: string): Regex
  const found: Regex? = _regex_cache[expression]
  if found then return found as Regex end
  const compiled = compile_regex(expression)
  _regex_cache[expression] = compiled
  return compiled
end

-- Implementation notes: doc/implementation/string-library.md#match-records-and-result-projection
local function regex_normalized_init(subject: string,
                                     supplied: integer?):
                                     (integer, boolean)
  if not supplied then return 1, false end
  const position = supplied as integer
  const length = #subject
  if position > 0 then
    if position > length + 1 then return position, true end
    return position, false
  elseif position == 0 or position < -length then
    return 1, false
  end
  return length + position + 1, false
end

local function regex_is_start_anchored(regex: Regex): boolean
  return regex.anchored_start
end

local function regex_attempt(regex: Regex, subject: string,
                             position: integer): RegexMatch?
  const raw: value = regex.pattern:match(subject, position)
  if raw == nil then return nil end
  const captured = raw as {integer: value}
  const first = captured[1] as integer
  const after = captured[2] as integer
  const groups: {Span} = {}
  local index = 1
  while index <= regex.capture_count do
    groups[index] = captured[index + 2] as Span
    index = index + 1
  end
  return RegexMatch(
    subject, Span(first, after - 1), groups)
end

local function regex_find_from(regex: Regex, subject: string,
                               position: integer): RegexMatch?
  if regex_is_start_anchored(regex) then
    return regex_attempt(regex, subject, position)
  end
  local current = position
  while current <= #subject + 1 do
    const found: RegexMatch? =
      regex_attempt(regex, subject, current)
    if found then return found end
    current = current + 1
  end
  return nil
end
