local record GroupSpan
  local span: Span?
end

local record RegexDiagnostic
  label: string
  message: string
  source: string
  position: integer
  line: integer
  column: integer
  source_line: string
end

local _regex_cache: value = nil
local _regex_group_sentinel: value = nil

local function regex_initialize_state()
  if _regex_cache ~= nil then return end
  local top = lua.lua_gettop(L)
  do
    lua.lua_createtable(L, 0, 0)
    local cache_index = lua.lua_gettop(L)
    lua.lua_createtable(L, 0, 1)
    lua.lua_pushstring(L, "v")
    lua.lua_setfield(L, -2, "__mode")
    lua.lua_setmetatable(L, cache_index)
    _regex_cache = ffi.lua_totvalue(L, cache_index)

    lua.lua_createtable(L, 0, 0)
    _regex_group_sentinel = ffi.lua_totvalue(L, -1)
  finally
    lua.lua_settop(L, top)
  end
end

local function regex_cache_get(expression: string): Regex?
  regex_initialize_state()
  local top = lua.lua_gettop(L)
  local raw: value = nil
  do
    ffi.lua_pushtvalue(L, _regex_cache)
    ffi.lua_pushtvalue(L, expression)
    lua.lua_rawget(L, -2)
    raw = ffi.lua_totvalue(L, -1)
  finally
    lua.lua_settop(L, top)
  end
  if raw == nil then return nil end
  return raw as Regex
end

local function regex_cache_put(expression: string, compiled: Regex)
  regex_initialize_state()
  local top = lua.lua_gettop(L)
  do
    ffi.lua_pushtvalue(L, _regex_cache)
    ffi.lua_pushtvalue(L, expression)
    ffi.lua_pushtvalue(L, compiled)
    lua.lua_rawset(L, -3)
  finally
    lua.lua_settop(L, top)
  end
end

local function cached_regex(expression: string): Regex
  local found: Regex? = regex_cache_get(expression)
  if found then return found as Regex end
  local compiled = compile_regex(expression)
  regex_cache_put(expression, compiled)
  return compiled
end

local function regex_normalized_init(subject: string,
                                     supplied: integer?):
                                     (integer, boolean)
  if not supplied then return 1, false end
  local position = supplied as integer
  local length = #subject
  if position > 0 then
    if position > length + 1 then return position, true end
    return position, false
  elseif position == 0 or position < -length then
    return 1, false
  end
  return length + position + 1, false
end

local function regex_is_start_anchored(regex: Regex): boolean
  return #regex.expression > 0 and
         regex_byte(regex.expression, 1) == 94
end

local function regex_raw_table_item(items: value,
                                    index: integer): value
  local top = lua.lua_gettop(L)
  local result: value = nil
  do
    ffi.lua_pushtvalue(L, items)
    lua.lua_rawgeti(L, -1, index)
    result = ffi.lua_totvalue(L, -1)
  finally
    lua.lua_settop(L, top)
  end
  return result
end

local function regex_attempt(regex: Regex, subject: string,
                             position: integer): RegexMatch?
  local captured: value = regex.pattern:match(subject, position)
  if captured == nil then return nil end
  local first = regex_raw_table_item(captured, 1) as integer
  local after = regex_raw_table_item(captured, 2) as integer
  local groups: {GroupSpan} = {}
  local index = 1
  while index <= regex.capture_count do
    groups[index] =
      regex_raw_table_item(captured, index + 2) as GroupSpan
    index = index + 1
  end
  return RegexMatch.new(
    subject, Span.new(first, after - 1), groups)
end

local function regex_find_from(regex: Regex, subject: string,
                               position: integer): RegexMatch?
  if regex_is_start_anchored(regex) then
    return regex_attempt(regex, subject, position)
  end
  local current = position
  while current <= #subject + 1 do
    local found: RegexMatch? =
      regex_attempt(regex, subject, current)
    if found then return found end
    current = current + 1
  end
  return nil
end

local function regex_group_values(found: RegexMatch,
                                  index: integer): (...: string?)
  if index > #found.groups then return end
  if index == #found.groups then return found:group(index) end
  return found:group(index), regex_group_values(found, index + 1)
end

local function regex_table_lookup(table_value: value,
                                   key: value): value
  local top = lua.lua_gettop(L)
  local result: value = nil
  do
    ffi.lua_pushtvalue(L, table_value)
    ffi.lua_pushtvalue(L, key)
    lua.lua_gettable(L, -2)
    result = ffi.lua_totvalue(L, -1)
  finally
    lua.lua_settop(L, top)
  end
  return result
end

local function regex_call_replacement(callback: value,
                                      found: RegexMatch): value
  local top = lua.lua_gettop(L)
  local result: value = nil
  local failure: value = nil
  local failed = false
  do
    ffi.lua_pushtvalue(L, callback)
    local count = #found.groups
    if count == 0 then
      ffi.lua_pushtvalue(L, found:whole())
      count = 1
    else
      local index = 1
      while index <= count do
        local argument: value = found:group(index)
        ffi.lua_pushtvalue(L, argument)
        index = index + 1
      end
    end
    local status = lua.lua_pcallk(
      L, count as ffi.titan_ffi_int, 1, 0, 0, nil)
    if status ~= lua.LUA_OK then
      failed = true
      failure = ffi.lua_totvalue(L, -1)
    else
      result = ffi.lua_totvalue(L, -1)
    end
  finally
    lua.lua_settop(L, top)
  end
  if failed then raise failure end
  return result
end

local function regex_template_replacement(template: string,
                                          found: RegexMatch): string
  local builder = new_string_builder()
  local literal_start = 1
  local position = 1
  while position <= #template do
    if regex_byte(template, position) ~= 37 then
      position = position + 1
    else
      if position > literal_start then
        builder_append(
          builder,
          copy_interval(
            template, literal_start, position - literal_start))
      end
      if position == #template then
        raise "invalid replacement template: trailing '%'"
      end
      local code = regex_byte(template, position + 1)
      if code == 37 then
        builder_append(builder, "%")
      elseif code == 48 then
        builder_append(builder, found:whole())
      elseif code >= 49 and code <= 57 then
        local index = code - 48
        if index > #found.groups then
          raise "invalid replacement capture index"
        end
        local group: string? = found:group(index)
        if group then builder_append(builder, group as string) end
      else
        raise "invalid replacement template escape"
      end
      position = position + 2
      literal_start = position
    end
  end
  if literal_start <= #template then
    builder_append(
      builder,
      copy_interval(
        template, literal_start, #template - literal_start + 1))
  end
  return builder_finish(builder)
end

local function regex_dynamic_replacement(replacement: value,
                                         kind: integer,
                                         found: RegexMatch): string
  if kind == lua.LUA_TSTRING or kind == lua.LUA_TNUMBER then
    return regex_template_replacement(tostring(replacement), found)
  end

  local result: value = nil
  if kind == lua.LUA_TTABLE then
    local key: value = found:whole()
    if #found.groups > 0 then key = found:group(1) end
    result = regex_table_lookup(replacement, key)
  elseif kind == lua.LUA_TFUNCTION then
    result = regex_call_replacement(replacement, found)
  else
    raise "invalid replacement type"
  end

  local result_kind = raw_value_type(result)
  if result_kind == lua.LUA_TNIL or
      (result_kind == lua.LUA_TBOOLEAN and result == false) then
    return found:whole()
  elseif result_kind == lua.LUA_TSTRING or
         result_kind == lua.LUA_TNUMBER then
    return tostring(result)
  end
  raise "invalid replacement value"
  return ""
end
