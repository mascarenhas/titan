-- Format parsing and semantics translated and adapted from src/lstrlib.c in
-- the immutable Lua 5.5.1 release:
-- https://www.lua.org/ftp/lua-5.5.1.tar.gz
-- Copyright (C) 1994-2026 Lua.org, PUC-Rio. MIT terms are reproduced in
-- LICENSES/lua-LICENSE.

local stdio = foreign import "stdio.h"
local clocale = foreign import "locale.h"

local type FormatPartial = (value) -> string
local type FormatFactory = (string, string) -> FormatPartial

local MAXIMUM_FORMAT_SPECIFICATION_BYTES = 22

local function new_string_builder(): StringWriter
  local chunks: {string} = {}
  return StringWriter.new(chunks, 0)
end

local function builder_append(builder: StringWriter, text: string)
  local length = #text
  if length == 0 then return end
  local maximum = MAXIMUM_STRING_BYTES
  if length > maximum - builder.length then
    raise "resulting string is too large"
  end
  builder.chunks[#builder.chunks + 1] = text
  builder.length = builder.length + length
end

local function builder_finish(builder: StringWriter): string
  if builder.length == 0 then return "" end
  local storage = ffi.titan_ffi_char.new_array(builder.length)
  local output = storage as *ffi.titan_ffi_char
  local offset = 0
  local index = 1
  while index <= #builder.chunks do
    local chunk = builder.chunks[index] as string
    local length = #chunk
    local source = chunk as const *ffi.titan_ffi_char
    cstring.memcpy(output + offset, source,
                   length as cstring.size_t)
    offset = offset + length
    index = index + 1
  end
  return storage as string
end

local function zero_bytes(length: integer): string
  if length == 0 then return "" end
  if length < 0 then raise "resulting string is too large" end
  local storage = ffi.titan_ffi_char.new_array(length)
  local output = storage as *ffi.titan_ffi_char
  cstring.memset(output, 0, #storage as cstring.size_t)
  return storage as string
end

local function snprintf_allocation_length(required: integer): integer
  if required < 0 then raise "string formatting failed" end
  if required >= MAXIMUM_STRING_BYTES then
    raise "resulting string is too large"
  end
  return required + 1
end

local function finish_snprintf_prefix(
    scratch: owned ffi.titan_ffi_char[],
    required: integer, actual: integer): string
  if actual ~= required then raise "string formatting failed" end
  local storage = ffi.titan_ffi_char.new_array(required)
  cstring.memcpy(
    storage as *ffi.titan_ffi_char,
    scratch as const *ffi.titan_ffi_char,
    required as cstring.size_t)
  return storage as string
end

local function integer_length_modifier(): string
  if lua.lua_Integer.sizeof <= ffi.titan_ffi_int.sizeof then
    return ""
  elseif lua.lua_Integer.sizeof <= ffi.titan_ffi_long.sizeof then
    return "l"
  else
    return "ll"
  end
end

local function add_integer_length(form: string): string
  return copy_interval(form, 1, #form - 1) ..
         INTEGER_LENGTH_MODIFIER ..
         copy_interval(form, #form, 1)
end

local function render_signed(form: string,
                             number: lua.lua_Integer): string
  if lua.lua_Integer.sizeof <= ffi.titan_ffi_int.sizeof then
    local converted = number as ffi.titan_ffi_int
    local required = stdio.snprintf(nil, 0, form, converted)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  elseif lua.lua_Integer.sizeof <= ffi.titan_ffi_long.sizeof then
    local converted = number as ffi.titan_ffi_long
    local required = stdio.snprintf(nil, 0, form, converted)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  else
    local converted = number as ffi.titan_ffi_long_long
    local required = stdio.snprintf(nil, 0, form, converted)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  end
end

local function render_unsigned(form: string,
                               number: lua.lua_Integer): string
  if lua.lua_Integer.sizeof <= ffi.titan_ffi_int.sizeof then
    local converted = number as ffi.titan_ffi_unsigned_int
    local required = stdio.snprintf(nil, 0, form, converted)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  elseif lua.lua_Integer.sizeof <= ffi.titan_ffi_long.sizeof then
    local converted = number as ffi.titan_ffi_unsigned_long
    local required = stdio.snprintf(nil, 0, form, converted)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  else
    local converted = number as ffi.titan_ffi_unsigned_long_long
    local required = stdio.snprintf(nil, 0, form, converted)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  end
end

local function render_character(form: string,
                                number: lua.lua_Integer): string
  local converted = number as ffi.titan_ffi_int
  local required = stdio.snprintf(nil, 0, form, converted)
  local storage = ffi.titan_ffi_char.new_array(
    snprintf_allocation_length(required))
  local output = storage as *ffi.titan_ffi_char
  local actual = stdio.snprintf(
      output, #storage as cstring.size_t,
      form, converted)
  return finish_snprintf_prefix(storage, required, actual)
end

local function render_number(form: string,
                             number: lua.lua_Number): string
  local converted = number as ffi.titan_ffi_double
  local required = stdio.snprintf(nil, 0, form, converted)
  local storage = ffi.titan_ffi_char.new_array(
    snprintf_allocation_length(required))
  local output = storage as *ffi.titan_ffi_char
  local actual = stdio.snprintf(
      output, #storage as cstring.size_t,
      form, converted)
  return finish_snprintf_prefix(storage, required, actual)
end

local function render_c_string(form: string, text: string): string
  local required = stdio.snprintf(nil, 0, form, text)
  local storage = ffi.titan_ffi_char.new_array(
    snprintf_allocation_length(required))
  local output = storage as *ffi.titan_ffi_char
  local actual = stdio.snprintf(
      output, #storage as cstring.size_t,
      form, text)
  return finish_snprintf_prefix(storage, required, actual)
end

local function render_pointer(form: string, candidate: value): string
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  ffi.lua_pushtvalue(L, candidate)
  local pointer = lua.lua_topointer(L, -1)
  if not pointer then
    local string_form =
      copy_interval(form, 1, #form - 1) .. "s"
    return render_c_string(string_form, "(null)")
  else
    local required = stdio.snprintf(nil, 0, form, pointer)
    local storage = ffi.titan_ffi_char.new_array(
      snprintf_allocation_length(required))
    local output = storage as *ffi.titan_ffi_char
    local actual = stdio.snprintf(
        output, #storage as cstring.size_t,
        form, pointer)
    return finish_snprintf_prefix(storage, required, actual)
  end
end

local function is_ascii_digit(octet: integer): boolean
  return octet >= 48 and octet <= 57
end

local function format_byte(text: string, index: integer): integer
  if index < 1 or index > #text then return 0 end
  local bytes = text as const *ffi.titan_ffi_unsigned_char
  return bytes[index - 1] as integer
end

local function contains_byte(text: string, octet: integer): boolean
  if #text == 0 then return false end
  local bytes = text as const *ffi.titan_ffi_unsigned_char
  local index = 0
  while index < #text do
    if bytes[index] == octet then return true end
    index = index + 1
  end
  return false
end

local function decimal_escape(octet: integer,
                              padded: boolean): string
  local length = 1
  if padded or octet >= 100 then
    length = 3
  elseif octet >= 10 then
    length = 2
  end
  local storage = ffi.titan_ffi_char.new_array(length)
  local remaining = octet
  local index = length - 1
  while index >= 0 do
    storage[index] =
      (48 + remaining % 10) as ffi.titan_ffi_char
    remaining = remaining // 10
    index = index - 1
  end
  return storage as string
end

local function locale_neutral_hex(number: lua.lua_Number): string
  local rendered = render_number("%a", number)
  local locale = clocale.localeconv()
  local decimal = locale.decimal_point[0]
  local decimal_octet =
    (decimal as ffi.titan_ffi_unsigned_char) as integer
  if decimal == (46 as ffi.titan_ffi_char) or
      not contains_byte(rendered, decimal_octet) then
    return rendered
  end
  local storage = ffi.titan_ffi_char.new_array(#rendered)
  local source = rendered as const *ffi.titan_ffi_char
  local index = 0
  while index < #rendered do
    if source[index] == decimal then
      storage[index] = 46 as ffi.titan_ffi_char
    else
      storage[index] = source[index]
    end
    index = index + 1
  end
  return storage as string
end

local function append_quoted(builder: StringWriter, text: string)
  builder_append(builder, "\"")
  local run = 1
  local index = 1
  while index <= #text do
    local octet = format_byte(text, index)
    local special = octet == 34 or octet == 92 or octet == 10
    local control =
      cctype.iscntrl(octet as ffi.titan_ffi_int) ~= 0
    if special or control then
      if index > run then
        builder_append(
            builder, copy_interval(text, run, index - run))
      end
      if special then
        builder_append(builder, "\\")
        builder_append(builder, copy_interval(text, index, 1))
      else
        local next_is_digit = index < #text and
          cctype.isdigit(
            format_byte(text, index + 1)
              as ffi.titan_ffi_int) ~= 0
        builder_append(builder, "\\")
        builder_append(
            builder, decimal_escape(octet, next_is_digit))
      end
      run = index + 1
    end
    index = index + 1
  end
  if run <= #text then
    builder_append(
        builder, copy_interval(text, run, #text - run + 1))
  end
  builder_append(builder, "\"")
end

local function render_literal(candidate: value): string
  local builder = new_string_builder()
  if candidate is string then
    append_quoted(builder, candidate as string)
  elseif candidate == nil then
    builder_append(builder, "nil")
  elseif candidate == true then
    builder_append(builder, "true")
  elseif candidate == false then
    builder_append(builder, "false")
  elseif candidate is float then
    if candidate is integer then
      local number =
        (candidate as integer) as lua.lua_Integer
      if number == lua.LUA_MININTEGER then
        builder_append(builder, "0x")
        builder_append(
            builder,
            render_unsigned(
              add_integer_length("%x"), number))
      else
        builder_append(
            builder,
            render_signed(
              add_integer_length("%d"), number))
      end
    else
      local number =
        (candidate as float) as lua.lua_Number
      if number > 0 and number + number == number then
        builder_append(builder, "1e9999")
      elseif number < 0 and number + number == number then
        builder_append(builder, "-1e9999")
      elseif number ~= number then
        builder_append(builder, "(0/0)")
      else
        builder_append(builder, locale_neutral_hex(number))
      end
    end
  else
    raise "value has no literal form"
  end
  return builder_finish(builder)
end

local function character_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    return prefix ..
      render_character(
        form, (candidate as integer) as lua.lua_Integer)
  end
end

local function signed_format_partial(
    prefix: string, form: string): FormatPartial
  local integer_form = add_integer_length(form)
  return function(candidate: value): string
    return prefix ..
      render_signed(
        integer_form,
        (candidate as integer) as lua.lua_Integer)
  end
end

local function unsigned_format_partial(
    prefix: string, form: string): FormatPartial
  local integer_form = add_integer_length(form)
  return function(candidate: value): string
    return prefix ..
      render_unsigned(
        integer_form,
        (candidate as integer) as lua.lua_Integer)
  end
end

local function number_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    return prefix .. render_number(
      form, (candidate as float) as lua.lua_Number)
  end
end

local function pointer_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    return prefix .. render_pointer(form, candidate)
  end
end

local function literal_format_partial(
    prefix: string, _form: string): FormatPartial
  return function(candidate: value): string
    return prefix .. render_literal(candidate)
  end
end

local function string_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    local converted = tostring(candidate)
    if #form == 2 then return prefix .. converted end
    if contains_byte(converted, 0) then
      raise "string contains zeros"
    end
    if not contains_byte(form, 46) and #converted >= 100 then
      return prefix .. converted
    end
    return prefix .. render_c_string(form, converted)
  end
end

local function invalid_specification_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_candidate: value): string
    raise "invalid conversion specification"
    return ""
  end
end

local function invalid_conversion_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_candidate: value): string
    raise "invalid conversion to 'format'"
    return ""
  end
end

local function invalid_literal_modifiers_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_candidate: value): string
    raise "specifier '%q' cannot have modifiers"
    return ""
  end
end

local function overlong_format_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_candidate: value): string
    raise "invalid format (too long)"
    return ""
  end
end

local function build_format_partial(fields_value: value): FormatPartial
  local fields = fields_value as {integer: value}
  if #fields ~= 4 then
    raise "internal format parser capture is invalid"
  end
  local prefix = fields[1] as string
  local form = fields[2] as string
  local factory = fields[3] as FormatFactory
  local maximum = fields[4] as integer
  if #form > maximum then
    return overlong_format_partial(prefix, form)
  end
  return factory(prefix, form)
end

local record FormatPlan
  local partials: {FormatPartial}
  local trailer: string
end

local function build_format_plan(items_value: value): FormatPlan
  local items = items_value as {integer: value}
  local count = #items
  if count < 1 then
    raise "internal format parser result is empty"
  end
  local partials: {FormatPartial} = {}
  local index = 1
  while index < count do
    partials[index] = items[index] as FormatPartial
    index = index + 1
  end
  return FormatPlan.new(partials, items[count] as string)
end

local function format_specification(
    flags: string, zero_is_flag: boolean,
    precision: boolean,
    specifiers: string): peg.Pattern
  local digits = peg.ranges("09")
  local width = peg.at_most(digits, 2)
  if not zero_is_flag then
    width = peg.optional(peg.sequence(
      peg.ranges("19"), peg.optional(digits)))
  end
  local modifiers = peg.sequence(
    peg.zero_or_more(peg.set(flags)),
    width)
  if precision then
    modifiers = peg.sequence(
      modifiers,
      peg.optional(peg.sequence(
        peg.literal("."), peg.at_most(digits, 2))))
  end
  return peg.capture(peg.sequence(
    peg.literal("%"), modifiers, peg.set(specifiers)))
end

local function format_conversion(
    form: peg.Pattern, factory: FormatFactory,
    maximum: integer): peg.Pattern
  return peg.sequence(
    form, peg.constant(factory), peg.constant(maximum))
end

local function build_format_pattern(): peg.Pattern
  local escaped_percent =
    peg.template_capture(peg.literal("%%"), "%%")
  local ordinary_byte =
    peg.difference(peg.any(), peg.literal("%"))
  local literal_run = peg.substitution(peg.zero_or_more(
    peg.choice(escaped_percent, ordinary_byte)))

  local modifier_bytes = peg.set("-+ #0123456789.")
  local all_modifiers = peg.zero_or_more(modifier_bytes)
  local valid_specifiers = "cdiuoxXaAeEfgGps"
  local conversion = peg.choice(
    format_conversion(
      format_specification("-", false, false, "c"),
      character_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-+0 ", true, true, "di"),
      signed_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-0", true, true, "u"),
      unsigned_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-#0", true, true, "oxX"),
      unsigned_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-+#0 ", true, true, "aAeEfgG"),
      number_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-", false, false, "p"),
      pointer_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.literal("%q")),
      literal_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-", false, true, "s"),
      string_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), peg.one_or_more(modifier_bytes),
        peg.literal("q"))),
      invalid_literal_modifiers_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), all_modifiers,
        peg.set(valid_specifiers))),
      invalid_specification_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), all_modifiers, peg.any())),
      invalid_conversion_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), all_modifiers)),
      invalid_conversion_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES - 1))

  local partial = peg.function_capture(
    peg.table_capture(peg.sequence(literal_run, conversion)),
    build_format_partial)
  return peg.function_capture(
    peg.table_capture(peg.sequence(
      peg.zero_or_more(partial), literal_run,
      peg.negative(peg.any()))),
    build_format_plan)
end
