-- Format parsing and semantics translated and adapted from src/lstrlib.c in
-- the immutable Lua 5.5.1 release:
-- https://www.lua.org/ftp/lua-5.5.1.tar.gz
-- Copyright (C) 1994-2026 Lua.org, PUC-Rio. MIT terms are reproduced in
-- LICENSES/lua-LICENSE.

foreign import "./format_native.h"
foreign import "math.h"
foreign import "locale.h"

local type FormatPartial = function (value): (string)
local type FormatFactory = function (string, string): (FormatPartial)

local MAXIMUM_FORMAT_SPECIFICATION_BYTES = 22

local function StringWriter.new(): StringWriter
  return { chunks = {}, length = 0 }
end

local function builder_append(builder: StringWriter, text: string)
  const length = #text
  if length == 0 then return end
  const maximum = MAXIMUM_STRING_BYTES
  if length > maximum - builder.length then
    raise "resulting string is too large"
  end
  builder.chunks[#builder.chunks + 1] = text
  builder.length = builder.length + length
end

local function builder_finish(builder: StringWriter): string
  if builder.length == 0 then return "" end
  const storage = foreign char.new_array(builder.length)
  const output = storage as foreign *char
  local offset = 0
  local index = 1
  while index <= #builder.chunks do
    const chunk = builder.chunks[index] as string
    const length = #chunk
    const source = chunk as foreign const *char
    ffi.memcpy(output + offset, source,
                   length as foreign size_t)
    offset = offset + length
    index = index + 1
  end
  return storage as string
end

local function zero_bytes(length: integer): string
  if length == 0 then return "" end
  if length < 0 then raise "resulting string is too large" end
  const storage = foreign char.new_array(length)
  const output = storage as foreign *char
  ffi.memset(output, 0, #storage as foreign size_t)
  return storage as string
end

local function snprintf_allocation_length(required: integer): integer
  if required < 0 then raise "string formatting failed" end
  if required >= MAXIMUM_STRING_BYTES then
    raise "resulting string is too large"
  end
  return required + 1
end

local function finish_snprintf_prefix(
    scratch: owned char[],
    required: integer, actual: integer): string
  if actual ~= required then raise "string formatting failed" end
  const storage = foreign char.new_array(required)
  ffi.memcpy(
    storage as foreign *char,
    scratch as foreign const *char,
    required as foreign size_t)
  return storage as string
end

local function integer_length_modifier(): string
  if foreign lua_Integer.sizeof <= foreign int.sizeof then
    return ""
  elseif foreign lua_Integer.sizeof <= foreign long.sizeof then
    return "l"
  else
    return "ll"
  end
end

local function add_integer_length(form: string): string
  return copy_interval(form, 1, #form - 1) ..
         INTEGER_LENGTH_MODIFIER ..
         copy_interval(form, #form, 1)
end

local function render_signed(form: string,
                             number: foreign lua_Integer): string
  if foreign lua_Integer.sizeof <= foreign int.sizeof then
    const converted = number as foreign int
    const required = ffi.titan_string_snprintf(nil, 0, form, converted)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  elseif foreign lua_Integer.sizeof <= foreign long.sizeof then
    const converted = number as foreign long
    const required = ffi.titan_string_snprintf(nil, 0, form, converted)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  else
    const converted = number as foreign long long
    const required = ffi.titan_string_snprintf(nil, 0, form, converted)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  end
end

local function render_unsigned(form: string,
                               number: foreign lua_Integer): string
  if foreign lua_Integer.sizeof <= foreign int.sizeof then
    const converted = number as foreign unsigned int
    const required = ffi.titan_string_snprintf(nil, 0, form, converted)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  elseif foreign lua_Integer.sizeof <= foreign long.sizeof then
    const converted = number as foreign unsigned long
    const required = ffi.titan_string_snprintf(nil, 0, form, converted)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  else
    const converted = number as foreign unsigned long long
    const required = ffi.titan_string_snprintf(nil, 0, form, converted)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, converted)
    return finish_snprintf_prefix(storage, required, actual)
  end
end

local function render_character(form: string,
                                number: foreign lua_Integer): string
  const converted = number as foreign int
  const required = ffi.titan_string_snprintf(nil, 0, form, converted)
  const storage = foreign char.new_array(
    snprintf_allocation_length(required))
  const output = storage as foreign *char
  const actual = ffi.titan_string_snprintf(
      output, #storage as foreign size_t,
      form, converted)
  return finish_snprintf_prefix(storage, required, actual)
end

local function render_native_number(form: string,
                             number: foreign lua_Number): string
  const converted = number as foreign double
  const required = ffi.titan_string_snprintf(nil, 0, form, converted)
  const storage = foreign char.new_array(
    snprintf_allocation_length(required))
  const output = storage as foreign *char
  const actual = ffi.titan_string_snprintf(
      output, #storage as foreign size_t,
      form, converted)
  return finish_snprintf_prefix(storage, required, actual)
end

local function render_c_string(form: string, text: string): string
  const required = ffi.titan_string_snprintf(nil, 0, form, text)
  const storage = foreign char.new_array(
    snprintf_allocation_length(required))
  const output = storage as foreign *char
  const actual = ffi.titan_string_snprintf(
      output, #storage as foreign size_t,
      form, text)
  return finish_snprintf_prefix(storage, required, actual)
end

local function render_pointer(form: string, candidate: value): string
  const top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for pointer formatting"
  end
  ffi.lua_pushtvalue(L, candidate)
  const pointer = ffi.lua_topointer(L, -1)
  if not pointer then
    const string_form =
      copy_interval(form, 1, #form - 1) .. "s"
    return render_c_string(string_form, "(null)")
  else
    const required = ffi.titan_string_snprintf(nil, 0, form, pointer)
    const storage = foreign char.new_array(
      snprintf_allocation_length(required))
    const output = storage as foreign *char
    const actual = ffi.titan_string_snprintf(
        output, #storage as foreign size_t,
        form, pointer)
    return finish_snprintf_prefix(storage, required, actual)
  end
end

-- Lua uses this algorithm when its configured lua_number2strx macro is absent.
-- In particular, that is the normal Windows Lua configuration even on a C99
-- compiler. Keep digit selection and modifier rejection in Titan.
local function render_lua_hex_number(form: string,
                                     number: foreign lua_Number): string
  if #form ~= 2 then
    raise "modifiers for format '%a'/'%A' not implemented"
  end
  local rendered = ""
  if number ~= number or
      (number ~= 0 and number + number == number) then
    rendered = render_native_number(ffi.LUA_NUMBER_FMT as string, number)
  elseif number == 0 then
    rendered = render_native_number(
      (ffi.LUA_NUMBER_FMT as string) .. "x0p+0", number)
  else
    local exponent: foreign int = 0 as foreign int
    local fraction = ffi.frexp(number, exponent) as float
    const builder = StringWriter()
    if fraction < 0 then
      builder_append(builder, "-")
      fraction = -fraction
    end
    builder_append(builder, "0x")
    const leading_bits = ffi.TITAN_STRING_HEX_LEADING_BITS as integer
    fraction = fraction * (1 << leading_bits)
    local digit = (ffi.floor(fraction) as float) as integer
    builder_append(builder, copy_interval("0123456789abcdef", digit + 1, 1))
    fraction = fraction - digit
    if fraction > 0 then
      const locale = ffi.localeconv()
      const decimal = locale.decimal_point[0] as foreign unsigned char
      builder_append(builder, char(decimal as integer))
      repeat
        fraction = fraction * 16
        digit = (ffi.floor(fraction) as float) as integer
        builder_append(builder, copy_interval("0123456789abcdef", digit + 1, 1))
        fraction = fraction - digit
      until fraction == 0
    end
    builder_append(builder, render_signed(add_integer_length("p%+d"),
      ((exponent as integer) - leading_bits) as foreign lua_Integer))
    rendered = builder_finish(builder)
  end
  if form == "%A" then return upper(rendered) end
  return rendered
end

local function render_number(form: string,
                             number: foreign lua_Number): string
  if ffi.TITAN_STRING_LUA_HEX_FALLBACK ~= 0 then
    const conversion = copy_interval(form, #form, 1)
    if conversion == "a" or conversion == "A" then
      return render_lua_hex_number(form, number)
    end
  end
  return render_native_number(form, number)
end

local function is_ascii_digit(octet: integer): boolean
  return octet >= 48 and octet <= 57
end

local function format_byte(text: string, index: integer): integer
  if index < 1 or index > #text then return 0 end
  const bytes = text as foreign const *unsigned char
  return bytes[index - 1] as integer
end

local function contains_byte(text: string, octet: integer): boolean
  if #text == 0 then return false end
  const bytes = text as foreign const *unsigned char
  local index = 0
  while index < #text do
    if bytes[index] == octet then return true end
    index = index + 1
  end
  return false
end

local function decimal_escape(octet: integer,
                              padded: boolean): string
  local length = 1
  if padded or octet >= 100 then
    length = 3
  elseif octet >= 10 then
    length = 2
  end
  const storage = foreign char.new_array(length)
  local remaining = octet
  local index = length - 1
  while index >= 0 do
    storage[index] =
      (48 + remaining % 10) as foreign char
    remaining = remaining // 10
    index = index - 1
  end
  return storage as string
end

local function locale_neutral_hex(number: foreign lua_Number): string
  const rendered = render_number("%a", number)
  const locale = ffi.localeconv()
  const decimal = locale.decimal_point[0]
  const decimal_octet =
    (decimal as foreign unsigned char) as integer
  if decimal == (46 as foreign char) or
      not contains_byte(rendered, decimal_octet) then
    return rendered
  end
  const storage = foreign char.new_array(#rendered)
  const source = rendered as foreign const *char
  local index = 0
  while index < #rendered do
    if source[index] == decimal then
      storage[index] = 46 as foreign char
    else
      storage[index] = source[index]
    end
    index = index + 1
  end
  return storage as string
end

local function append_quoted(builder: StringWriter, text: string)
  builder_append(builder, "\"")
  local run = 1
  local index = 1
  while index <= #text do
    const octet = format_byte(text, index)
    const special = octet == 34 or octet == 92 or octet == 10
    const control =
      ffi.iscntrl(octet as foreign int) ~= 0
    if special or control then
      if index > run then
        builder_append(
            builder, copy_interval(text, run, index - run))
      end
      if special then
        builder_append(builder, "\\")
        builder_append(builder, copy_interval(text, index, 1))
      else
        const next_is_digit = index < #text and
          ffi.isdigit(
            format_byte(text, index + 1)
              as foreign int) ~= 0
        builder_append(builder, "\\")
        builder_append(
            builder, decimal_escape(octet, next_is_digit))
      end
      run = index + 1
    end
    index = index + 1
  end
  if run <= #text then
    builder_append(
        builder, copy_interval(text, run, #text - run + 1))
  end
  builder_append(builder, "\"")
end

local function render_literal(candidate: value): string
  const builder = StringWriter()
  if candidate is string then
    append_quoted(builder, candidate as string)
  elseif candidate == nil then
    builder_append(builder, "nil")
  elseif candidate == true then
    builder_append(builder, "true")
  elseif candidate == false then
    builder_append(builder, "false")
  elseif candidate is float then
    if candidate is integer then
      const number =
        (candidate as integer) as foreign lua_Integer
      if number == ffi.LUA_MININTEGER then
        builder_append(builder, "0x")
        builder_append(
            builder,
            render_unsigned(
              add_integer_length("%x"), number))
      else
        builder_append(
            builder,
            render_signed(
              add_integer_length("%d"), number))
      end
    else
      const number =
        (candidate as float) as foreign lua_Number
      if number > 0 and number + number == number then
        builder_append(builder, "1e9999")
      elseif number < 0 and number + number == number then
        builder_append(builder, "-1e9999")
      elseif number ~= number then
        builder_append(builder, "(0/0)")
      else
        builder_append(builder, locale_neutral_hex(number))
      end
    end
  else
    raise "value has no literal form"
  end
  return builder_finish(builder)
end

local function character_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    return prefix ..
      render_character(
        form, (candidate as integer) as foreign lua_Integer)
  end
end

local function signed_format_partial(
    prefix: string, form: string): FormatPartial
  const integer_form = add_integer_length(form)
  return function(candidate: value): string
    return prefix ..
      render_signed(
        integer_form,
        (candidate as integer) as foreign lua_Integer)
  end
end

local function unsigned_format_partial(
    prefix: string, form: string): FormatPartial
  const integer_form = add_integer_length(form)
  return function(candidate: value): string
    return prefix ..
      render_unsigned(
        integer_form,
        (candidate as integer) as foreign lua_Integer)
  end
end

local function number_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    return prefix .. render_number(
      form, (candidate as float) as foreign lua_Number)
  end
end

local function pointer_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    return prefix .. render_pointer(form, candidate)
  end
end

local function literal_format_partial(
    prefix: string, _: string): FormatPartial
  return function(candidate: value): string
    return prefix .. render_literal(candidate)
  end
end

local function string_format_partial(
    prefix: string, form: string): FormatPartial
  return function(candidate: value): string
    const converted = tostring(candidate)
    if #form == 2 then return prefix .. converted end
    if contains_byte(converted, 0) then
      raise "string contains zeros"
    end
    if not contains_byte(form, 46) and #converted >= 100 then
      return prefix .. converted
    end
    return prefix .. render_c_string(form, converted)
  end
end

local function invalid_specification_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_: value): string
    raise "invalid conversion specification"
    return ""
  end
end

local function invalid_conversion_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_: value): string
    raise "invalid conversion to 'format'"
    return ""
  end
end

local function invalid_literal_modifiers_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_: value): string
    raise "specifier '%q' cannot have modifiers"
    return ""
  end
end

local function overlong_format_partial(
    _prefix: string, _form: string): FormatPartial
  return function(_: value): string
    raise "invalid format (too long)"
    return ""
  end
end

local function build_format_partial(fields_value: value): FormatPartial
  const fields = fields_value as {integer: value}
  if #fields ~= 4 then
    raise "internal format parser capture is invalid"
  end
  const prefix = fields[1] as string
  const form = fields[2] as string
  const factory = fields[3] as FormatFactory
  const maximum = fields[4] as integer
  if #form > maximum then
    return overlong_format_partial(prefix, form)
  end
  return factory(prefix, form)
end

local record FormatPlan
  local const partials: {FormatPartial}
  local const trailer: string
end

local function build_format_plan(items_value: value): FormatPlan
  const items = items_value as {integer: value}
  const count = #items
  if count < 1 then
    raise "internal format parser result is empty"
  end
  const partials: {FormatPartial} = {}
  local index = 1
  while index < count do
    partials[index] = items[index] as FormatPartial
    index = index + 1
  end
  return FormatPlan(partials, items[count] as string)
end

local function format_specification(
    flags: string, zero_is_flag: boolean,
    precision: boolean,
    specifiers: string): peg.Pattern
  const digits = peg.ranges("09")
  const width = (function (digits: peg.Pattern, zero_is_flag: boolean): peg.Pattern
    if zero_is_flag then return peg.at_most(digits, 2) end
    return peg.optional(peg.sequence(
      peg.ranges("19"), peg.optional(digits)))
  end)(digits, zero_is_flag)
  local modifiers = peg.sequence(
    peg.zero_or_more(peg.set(flags)),
    width)
  if precision then
    modifiers = peg.sequence(
      modifiers,
      peg.optional(peg.sequence(
        peg.literal("."), peg.at_most(digits, 2))))
  end
  return peg.capture(peg.sequence(
    peg.literal("%"), modifiers, peg.set(specifiers)))
end

local function format_conversion(
    form: peg.Pattern, factory: FormatFactory,
    maximum: integer): peg.Pattern
  return peg.sequence(
    form, peg.constant(factory), peg.constant(maximum))
end

-- Implementation notes: doc/implementation/string-library.md#format-translation
local function build_format_pattern(): peg.Pattern
  const escaped_percent =
    peg.template_capture(peg.literal("%%"), "%%")
  const ordinary_byte =
    peg.difference(peg.any(), peg.literal("%"))
  const literal_run = peg.substitution(peg.zero_or_more(
    peg.choice(escaped_percent, ordinary_byte)))

  const modifier_bytes = peg.set("-+ #0123456789.")
  const all_modifiers = peg.zero_or_more(modifier_bytes)
  const valid_specifiers = "cdiuoxXaAeEfgGps"
  const conversion = peg.choice(
    format_conversion(
      format_specification("-", false, false, "c"),
      character_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-+0 ", true, true, "di"),
      signed_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-0", true, true, "u"),
      unsigned_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-#0", true, true, "oxX"),
      unsigned_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-+#0 ", true, true, "aAeEfgG"),
      number_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-", false, false, "p"),
      pointer_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.literal("%q")),
      literal_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      format_specification("-", false, true, "s"),
      string_format_partial, MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), peg.one_or_more(modifier_bytes),
        peg.literal("q"))),
      invalid_literal_modifiers_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), all_modifiers,
        peg.set(valid_specifiers))),
      invalid_specification_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), all_modifiers, peg.any())),
      invalid_conversion_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES),
    format_conversion(
      peg.capture(peg.sequence(
        peg.literal("%"), all_modifiers)),
      invalid_conversion_partial,
      MAXIMUM_FORMAT_SPECIFICATION_BYTES - 1))

  const partial = peg.function_capture(
    peg.table_capture(peg.sequence(literal_run, conversion)),
    build_format_partial)
  return peg.function_capture(
    peg.table_capture(peg.sequence(
      peg.zero_or_more(partial), literal_run,
      peg.negative(peg.any()))),
    build_format_plan)
end
