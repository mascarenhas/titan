-- Lua caps string lengths at the smaller of size_t and lua_Integer. Compute
-- that target limit without first converting an unrepresentable SIZE_MAX to
-- a Titan integer.
local function maximum_string_bytes(): integer
  if cstring.size_t.sizeof >= lua.lua_Integer.sizeof then
    return lua.LUA_MAXINTEGER as integer
  end
  local maximum = 0
  local byte = 0
  while byte < cstring.size_t.sizeof do
    maximum = maximum * 256 + 255
    byte = byte + 1
  end
  return maximum
end

local record StringBytes
  local data: *ffi.titan_ffi_char
  local storage: value
  local length: integer
end

local function allocate_string_bytes(length: integer): StringBytes
  if length < 0 then
    raise "resulting string is too large"
  end
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, length, 0)
  local storage = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return StringBytes.new(memory as *ffi.titan_ffi_char, storage, length)
end

local function finish_string(bytes: StringBytes): string
  if bytes.length == 0 then return "" end
  local top = lua.lua_gettop(L)
  lua.lua_pushlstring(L, bytes.data, bytes.length as lua.size_t)
  local result: value = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return result
end

-- Normalize an initial Lua string position. The result is clipped to
-- [1, +inf), matching Lua 5.5's posrelatI without negating a possibly minimal
-- integer.
local function initial_position(position: integer,
                                length: integer): integer
  if position > 0 then
    return position
  elseif position == 0 then
    return 1
  elseif position < -length then
    return 1
  else
    return length + position + 1
  end
end

-- Normalize an ending Lua string position. The result is clipped to
-- [0, length].
local function ending_position(position: integer,
                               length: integer): integer
  if position > length then
    return length
  elseif position >= 0 then
    return position
  elseif position < -length then
    return 0
  else
    return length + position + 1
  end
end

local function copy_interval(subject: string, first: integer,
                             count: integer): string
  if count == 0 then return "" end
  local output = allocate_string_bytes(count)
  local source = subject as const *ffi.titan_ffi_char
  cstring.memcpy(output.data, source + first - 1,
                 count as cstring.size_t)
  return finish_string(output)
end

local function byte_results(subject: string, current: integer,
                            last: integer): (...: integer)
  if current > last then return end
  local source = subject as const *ffi.titan_ffi_unsigned_char
  local octet = source[current - 1] as integer
  if current == last then return octet end
  return octet, byte_results(subject, current + 1, last)
end

function len(subject: string): integer
  return #subject
end

function sub(subject: string, first: integer,
             last: integer?): string
  local length = #subject
  local normalized_first = initial_position(first, length)
  local raw_last = -1
  if last then raw_last = last end
  local normalized_last = ending_position(raw_last, length)
  if normalized_first > normalized_last then return "" end
  return copy_interval(subject, normalized_first,
                       normalized_last - normalized_first + 1)
end

function reverse(subject: string): string
  local length = #subject
  if length == 0 then return "" end
  local output = allocate_string_bytes(length)
  local source = subject as const *ffi.titan_ffi_char
  local index = 0
  while index < length do
    output.data[index] = source[length - index - 1]
    index = index + 1
  end
  return finish_string(output)
end

function lower(subject: string): string
  local length = #subject
  if length == 0 then return "" end
  local output = allocate_string_bytes(length)
  local source = subject as const *ffi.titan_ffi_char
  local index = 0
  while index < length do
    local octet = source[index] as ffi.titan_ffi_unsigned_char
    output.data[index] =
      cctype.tolower(octet as ffi.titan_ffi_int) as ffi.titan_ffi_char
    index = index + 1
  end
  return finish_string(output)
end

function upper(subject: string): string
  local length = #subject
  if length == 0 then return "" end
  local output = allocate_string_bytes(length)
  local source = subject as const *ffi.titan_ffi_char
  local index = 0
  while index < length do
    local octet = source[index] as ffi.titan_ffi_unsigned_char
    output.data[index] =
      cctype.toupper(octet as ffi.titan_ffi_int) as ffi.titan_ffi_char
    index = index + 1
  end
  return finish_string(output)
end

function rep(subject: string, count: integer,
             separator: string?): string
  if count <= 0 then return "" end

  local actual_separator = ""
  if separator then actual_separator = separator end
  local subject_length = #subject
  local separator_length = #actual_separator
  local maximum_length = maximum_string_bytes()

  if subject_length > maximum_length - separator_length then
    raise "resulting string is too large"
  end
  local unit_length = subject_length + separator_length
  if unit_length > maximum_length // count then
    raise "resulting string is too large"
  end
  local total_length = unit_length * count - separator_length
  if total_length == 0 then return "" end

  local output = allocate_string_bytes(total_length)
  local subject_bytes = subject as const *ffi.titan_ffi_char
  local separator_bytes =
    actual_separator as const *ffi.titan_ffi_char
  local occurrence = 1
  local offset = 0
  while occurrence < count do
    if subject_length > 0 then
      cstring.memcpy(output.data + offset, subject_bytes,
                     subject_length as cstring.size_t)
      offset = offset + subject_length
    end
    if separator_length > 0 then
      cstring.memcpy(output.data + offset, separator_bytes,
                     separator_length as cstring.size_t)
      offset = offset + separator_length
    end
    occurrence = occurrence + 1
  end
  if subject_length > 0 then
    cstring.memcpy(output.data + offset, subject_bytes,
                   subject_length as cstring.size_t)
  end
  return finish_string(output)
end

function byte(subject: string, first: integer?,
              last: integer?): (...: integer)
  local length = #subject
  local raw_first = 1
  if first then raw_first = first end
  local normalized_first = initial_position(raw_first, length)
  local raw_last = raw_first
  if last then raw_last = last end
  local normalized_last = ending_position(raw_last, length)
  if normalized_first > normalized_last then return end
  if normalized_last - normalized_first + 1 > 200 then
    raise "too many flexible return values (max 200)"
  end
  return byte_results(subject, normalized_first, normalized_last)
end

function char(...: integer): string
  local length = #...
  if length == 0 then return "" end
  local output = allocate_string_bytes(length)
  local index = 1
  while index <= length do
    local octet = ...[index]
    if octet < 0 or octet > 255 then
      raise "character value out of range"
    end
    local byte = octet as ffi.titan_ffi_unsigned_char
    output.data[index - 1] = byte as ffi.titan_ffi_char
    index = index + 1
  end
  return finish_string(output)
end

function tostring(candidate: value): string
  local top = lua.lua_gettop(L)
  local result: value = nil
  do
    ffi.lua_pushtvalue(L, candidate)
    lual.luaL_tolstring(L, -1, nil)
    result = ffi.lua_totvalue(L, -1)
  finally
    lua.lua_settop(L, top)
  end
  return result
end
