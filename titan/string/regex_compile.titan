-- LICENSES/ta-regex-LICENSE.
--
-- The continuation-based regex-to-PEG translation follows Marcelo Oikawa,
-- Roberto Ierusalimschy, and Ana Lucia de Moura, "Converting regexes to
-- Parsing Expression Grammars" (PUC-Rio, 2010), as adapted by that pinned
-- pegex.lua.

local REGEX_PATTERN_LIMIT = 32757

local record RegexCompileState
  local rules: {peg.Rule}
  local next_rule: integer
end

local function regex_group_key(index: integer): string
  return "\0titan.regex.group." .. index
end

local function regex_group_start_key(index: integer): string
  return "\0titan.regex.group-start." .. index
end

local function regex_saturating_add(first: integer,
                                    second: integer): integer
  if first > REGEX_PATTERN_LIMIT or second > REGEX_PATTERN_LIMIT or
      first > REGEX_PATTERN_LIMIT - second then
    return REGEX_PATTERN_LIMIT + 1
  end
  return first + second
end

local function regex_saturating_multiply(first: integer,
                                         second: integer): integer
  if first == 0 or second == 0 then return 0 end
  if first > REGEX_PATTERN_LIMIT or second > REGEX_PATTERN_LIMIT or
      first > REGEX_PATTERN_LIMIT // second then
    return REGEX_PATTERN_LIMIT + 1
  end
  return first * second
end

local function regex_projected_size(node: RegexNode):
                                    (integer, integer)
  case node
  when empty then
    return 1, 0
  when literal then
    return 3, 0
  when any then
    return 5, 0
  when class then
    return 5, 0
  when sequence: sequence then
    local size = 1
    local index = 1
    while index <= #sequence.children do
      local child = sequence.children[index]
      local child_size, overflow = regex_projected_size(child)
      if overflow ~= 0 then return child_size, overflow end
      size = regex_saturating_add(
        size, regex_saturating_add(child_size, 1))
      if size > REGEX_PATTERN_LIMIT then
        return size, child:position()
      end
      index = index + 1
    end
    return size, 0
  when choice: choice then
    local size = 1
    local index = 1
    while index <= #choice.children do
      local child = choice.children[index]
      local child_size, overflow = regex_projected_size(child)
      if overflow ~= 0 then return child_size, overflow end
      size = regex_saturating_add(
        size, regex_saturating_add(child_size, 1))
      if size > REGEX_PATTERN_LIMIT then
        return size, child:position()
      end
      index = index + 1
    end
    return size, 0
  when group: group then
    local child_size, overflow =
      regex_projected_size(group.child)
    if overflow ~= 0 then return child_size, overflow end
    local size = regex_saturating_add(child_size, 8)
    if size > REGEX_PATTERN_LIMIT then
      return size, group.position
    end
    return size, 0
  when repetition: repetition then
    local child_size, overflow =
      regex_projected_size(repetition.child)
    if overflow ~= 0 then return child_size, overflow end
    local unit = regex_saturating_add(
      child_size, 4)
    local size = 0
    if repetition.maximum < 0 then
      size = regex_saturating_add(
        regex_saturating_multiply(
          unit, regex_saturating_add(repetition.minimum, 1)), 8)
    else
      local optional = repetition.maximum - repetition.minimum
      local optional_overhead = REGEX_PATTERN_LIMIT + 1
      if optional <= REGEX_PATTERN_LIMIT then
        optional_overhead = optional + 1
      end
      size = regex_saturating_add(
        regex_saturating_multiply(unit, repetition.maximum),
        optional_overhead)
    end
    if size > REGEX_PATTERN_LIMIT then
      return size, repetition.position
    end
    return size, 0
  when backreference then
    return 8, 0
  when word_start then
    return 8, 0
  when word_end then
    return 8, 0
  end
end

local function regex_word_start_capture(
    subject: string, position: integer,
    _: string): value
  if position > #subject then return false end
  if not regex_is_word_at(subject, position) then return false end
  if regex_is_word_at(subject, position - 1) then
    return false
  end
  return position
end

local function regex_word_end_capture(
    subject: string, position: integer,
    _: string): value
  if not regex_is_word_at(subject, position - 1) then
    return false
  end
  if regex_is_word_at(subject, position) then
    return false
  end
  return position
end

local function regex_backreference_capture(
    subject: string, position: integer,
    first: value, group_after_value: value): value
  if first == _regex_group_sentinel then return false end
  if group_after_value == nil then return false end
  local group_first = first as integer
  local group_after = group_after_value as integer
  local length = group_after - group_first
  if length < 0 or length > #subject - position + 1 then return false end
  if length > 0 then
    local bytes = subject as const *char
    if ffi.memcmp(
        bytes + position - 1, bytes + group_first - 1,
        length as ffi.size_t) ~= 0 then
      return false
    end
  end
  return position + length
end

local function regex_group_result(
    first: value, group_after_value: value): Span
  if first == _regex_group_sentinel then
    -- Source spans are one-based, including participating empty captures at
    -- (n, n - 1). Only (0, -1) is therefore impossible and can represent an
    -- unmatched capture without making the dense group array sparse.
    return Span.new(0, -1)
  end
  if group_after_value == nil then
    raise "internal regular-expression group capture is invalid"
  end
  local group_first = first as integer
  local group_after = group_after_value as integer
  return Span.new(group_first, group_after - 1)
end

local function regex_compile_node(node: RegexNode,
                                  continuation: peg.Pattern,
                                  state: RegexCompileState?): peg.Pattern
  case node
  when empty then
    return continuation
  when literal: literal then
    return peg.sequence(peg.literal(literal.text), continuation)
  when any then
    return peg.sequence(
      peg.difference(peg.any(), peg.literal("\n")), continuation)
  when class: class then
    return peg.sequence(peg.set(class.text), continuation)
  when sequence: sequence then
    local result = continuation
    local index = #sequence.children
    while index >= 1 do
      result = regex_compile_node(
        sequence.children[index], result, state)
      index = index - 1
    end
    return result
  when choice: choice then
    local result = regex_compile_node(
      choice.children[1], continuation, state)
    local index = 2
    while index <= #choice.children do
      result = peg.choice(
        result,
        regex_compile_node(
          choice.children[index], continuation, state))
      index = index + 1
    end
    return result
  when group: group then
    -- Keep group markers as siblings rather than wrapping the whole child in
    -- one named capture. LPeg scopes captures nested inside a named group;
    -- sibling markers leave nested numbered groups visible to the final Cb
    -- projection and to later backreferences.
    local start = peg.group(
      peg.position(), regex_group_start_key(group.number))
    local finish = peg.group(
      peg.sequence(
        peg.back_capture(regex_group_start_key(group.number)),
        peg.position()),
      regex_group_key(group.number))
    local body = regex_compile_node(
      group.child, peg.sequence(finish, continuation), state)
    return peg.sequence(start, body)
  when repetition: repetition then
    local atom = repetition.child
    local result = continuation
    if repetition.maximum < 0 then
      local active: RegexCompileState? = state
      local owns_scope = false
      if not active then
        local rules: {peg.Rule} = {}
        active = RegexCompileState.new(rules, 0)
        owns_scope = true
      end
      local shared = active as RegexCompileState
      shared.next_rule = shared.next_rule + 1
      local rule_name =
        "\0titan.regex.repeat." .. shared.next_rule
      local recursive = peg.variable(rule_name)
      local body = peg.choice(
        regex_compile_node(atom, recursive, shared), continuation)
      shared.rules[#shared.rules + 1] =
        peg.rule(rule_name, body)
      if owns_scope then
        result = peg.grammar(rule_name, shared.rules)
      else
        result = recursive
      end
    else
      local optional_count = repetition.maximum - repetition.minimum
      local index = 1
      while index <= optional_count do
        result = peg.choice(
          regex_compile_node(atom, result, state), result)
        index = index + 1
      end
    end
    local index = 1
    while index <= repetition.minimum do
      result = regex_compile_node(atom, result, state)
      index = index + 1
    end
    return result
  when backreference: backreference then
    local captured = peg.back_capture(
      regex_group_key(backreference.number))
    return peg.sequence(
      peg.match_time(captured, regex_backreference_capture),
      continuation)
  when word_start then
    return peg.sequence(
      peg.runtime(regex_word_start_capture), continuation)
  when word_end then
    return peg.sequence(
      peg.runtime(regex_word_end_capture), continuation)
  end
end

local function regex_build_pattern(parsed: ParsedRegex): peg.Pattern
  local tail = peg.position()
  local index = 1
  while index <= parsed.capture_count do
    tail = peg.sequence(
      tail,
      peg.function_capture(
        peg.back_capture(regex_group_key(index)),
        regex_group_result))
    index = index + 1
  end
  if parsed.anchored_end then
    tail = peg.sequence(peg.negative(peg.any()), tail)
  end
  local body = regex_compile_node(parsed.root, tail, nil)
  local complete = peg.sequence(peg.position(), body)

  index = parsed.capture_count
  while index >= 1 do
    complete = peg.sequence(
      peg.group(
        peg.constant(_regex_group_sentinel),
        regex_group_key(index)),
      complete)
    index = index - 1
  end
  return peg.table_capture(complete)
end

local function parse_regex(expression: string): ParsedRegex
  local pieces: {RegexNode} = {}
  local alternatives: {RegexNode} = {}
  local root_frame = RegexParseFrame.new(
    0, 0, false, 1, 1, pieces, alternatives)
  local frames: {RegexParseFrame} = {root_frame}
  local closed: {integer: boolean} = {}
  local nullable: {integer: boolean} = {}
  local state = RegexParseState.new(
    expression, frames, 1, 0, closed, nullable, false, false)

  local result, raw_label, failure_position =
    REGEX_PARSER:match(expression, nil, state)
  if result == nil then
    local label = "expected_atom"
    if raw_label ~= nil and raw_label ~= "fail" then
      label = raw_label as string
    end
    raise_regex_diagnostic(
      label, regex_syntax_message(label),
      expression, failure_position as integer)
  end
  return result as ParsedRegex
end
