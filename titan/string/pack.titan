-- Pack/unpack parsing and semantics translated and adapted from src/lstrlib.c
-- in the immutable Lua 5.5.1 release:
-- https://www.lua.org/ftp/lua-5.5.1.tar.gz
-- Copyright (C) 1994-2026 Lua.org, PUC-Rio. MIT terms are reproduced in
-- LICENSES/lua-LICENSE.

foreign type VoidPointer = *void

local PACK_INT = 1
local PACK_UINT = 2
local PACK_FLOAT = 3
local PACK_NUMBER = 4
local PACK_DOUBLE = 5
local PACK_CHAR = 6
local PACK_STRING = 7
local PACK_ZSTRING = 8
local PACK_PADDING = 9
local PACK_ALIGN = 10
local PACK_NONE = 11

local record PackState
  local format_string: string
  local cursor: integer
  local little_endian: boolean
  local native_little_endian: boolean
  local maximum_alignment: integer
end

local record PackOption
  local kind: integer
  local size: integer
  local padding: integer
end

local function host_is_little_endian(): boolean
  local probe: foreign unsigned int =
    1 as foreign unsigned int
  local storage = foreign char.new_array(
    foreign unsigned int.sizeof as integer)
  local bytes = storage as foreign *char
  ffi.memcpy(
    bytes, probe, #storage as foreign size_t)
  local octets = bytes as foreign *unsigned char
  return octets[0] == (1 as foreign unsigned char)
end

local function native_maximum_alignment(): integer
  local alignment = foreign long double.alignof as integer
  if foreign VoidPointer.alignof > alignment then
    alignment = foreign VoidPointer.alignof as integer
  end
  if foreign long long.alignof > alignment then
    alignment = foreign long long.alignof as integer
  end
  return alignment
end

local function new_pack_state(format_string: string): PackState
  local native_little = HOST_IS_LITTLE_ENDIAN
  return PackState {
    format_string = format_string,
    cursor = 1,
    little_endian = native_little,
    native_little_endian = native_little,
    maximum_alignment = 1
  }
end

local function pack_format_at_end(state: PackState): boolean
  return state.cursor > #state.format_string or
         format_byte(state.format_string, state.cursor) == 0
end

local function pack_format_digit(state: PackState): boolean
  if pack_format_at_end(state) then return false end
  return is_ascii_digit(
    format_byte(state.format_string, state.cursor))
end

local function read_pack_number(state: PackState,
                                default: integer): integer
  if not pack_format_digit(state) then return default end
  local result = 0
  local maximum = MAXIMUM_STRING_BYTES
  while pack_format_digit(state) do
    local digit =
      format_byte(state.format_string, state.cursor) - 48
    if result > (maximum - digit) // 10 then
      raise "format size is too large"
    end
    result = result * 10 + digit
    state.cursor = state.cursor + 1
  end
  return result
end

local function checked_pack_integer_size(size: integer): integer
  if size < 1 or size > 16 then
    raise "integral size out of limits [1,16]"
  end
  return size
end

local function read_pack_option(state: PackState): PackOption
  if pack_format_at_end(state) then
    raise "invalid format option"
  end
  local option =
    format_byte(state.format_string, state.cursor)
  state.cursor = state.cursor + 1

  if option == 98 then
    return PackOption { kind = PACK_INT, size = 1, padding = 0 }
  elseif option == 66 then
    return PackOption { kind = PACK_UINT, size = 1, padding = 0 }
  elseif option == 104 then
    return PackOption { kind = PACK_INT, size = foreign short.sizeof as integer, padding = 0 }
  elseif option == 72 then
    return PackOption { kind = PACK_UINT, size = foreign short.sizeof as integer, padding = 0 }
  elseif option == 108 then
    return PackOption { kind = PACK_INT, size = foreign long.sizeof as integer, padding = 0 }
  elseif option == 76 then
    return PackOption { kind = PACK_UINT, size = foreign long.sizeof as integer, padding = 0 }
  elseif option == 106 then
    return PackOption {
      kind = PACK_INT,
      size = foreign lua_Integer.sizeof as integer,
      padding = 0
    }
  elseif option == 74 then
    return PackOption {
      kind = PACK_UINT,
      size = foreign lua_Integer.sizeof as integer,
      padding = 0
    }
  elseif option == 84 then
    return PackOption { kind = PACK_UINT, size = foreign size_t.sizeof as integer, padding = 0 }
  elseif option == 102 then
    return PackOption { kind = PACK_FLOAT, size = foreign float.sizeof as integer, padding = 0 }
  elseif option == 110 then
    return PackOption {
      kind = PACK_NUMBER,
      size = foreign lua_Number.sizeof as integer,
      padding = 0
    }
  elseif option == 100 then
    return PackOption {
      kind = PACK_DOUBLE,
      size = foreign double.sizeof as integer,
      padding = 0
    }
  elseif option == 105 then
    return PackOption {
      kind = PACK_INT,
      size = checked_pack_integer_size(
        read_pack_number(
          state, foreign int.sizeof as integer)),
      padding = 0
    }
  elseif option == 73 then
    return PackOption {
      kind = PACK_UINT,
      size = checked_pack_integer_size(
        read_pack_number(
          state, foreign int.sizeof as integer)),
      padding = 0
    }
  elseif option == 115 then
    return PackOption {
      kind = PACK_STRING,
      size = checked_pack_integer_size(
        read_pack_number(
          state, foreign size_t.sizeof as integer)),
      padding = 0
    }
  elseif option == 99 then
    local size = read_pack_number(state, -1)
    if size < 0 then
      raise "missing size for format option 'c'"
    end
    return PackOption { kind = PACK_CHAR, size = size, padding = 0 }
  elseif option == 122 then
    return PackOption { kind = PACK_ZSTRING, size = 0, padding = 0 }
  elseif option == 120 then
    return PackOption { kind = PACK_PADDING, size = 1, padding = 0 }
  elseif option == 88 then
    return PackOption { kind = PACK_ALIGN, size = 0, padding = 0 }
  elseif option == 32 then
    return PackOption { kind = PACK_NONE, size = 0, padding = 0 }
  elseif option == 60 then
    state.little_endian = true
    return PackOption { kind = PACK_NONE, size = 0, padding = 0 }
  elseif option == 62 then
    state.little_endian = false
    return PackOption { kind = PACK_NONE, size = 0, padding = 0 }
  elseif option == 61 then
    state.little_endian = state.native_little_endian
    return PackOption { kind = PACK_NONE, size = 0, padding = 0 }
  elseif option == 33 then
    state.maximum_alignment =
      checked_pack_integer_size(
        read_pack_number(state, NATIVE_MAXIMUM_ALIGNMENT))
    return PackOption { kind = PACK_NONE, size = 0, padding = 0 }
  else
    raise "invalid format option"
  end
end

local function power_of_two(candidate: integer): boolean
  return candidate > 0 and
         (candidate & (candidate - 1)) == 0
end

local function read_pack_details(state: PackState,
                                 total_size: integer): PackOption
  local option = read_pack_option(state)
  local alignment = option.size
  if option.kind == PACK_ALIGN then
    if pack_format_at_end(state) then
      raise "invalid next option for option 'X'"
    end
    local following = read_pack_option(state)
    alignment = following.size
    if following.kind == PACK_CHAR or alignment == 0 then
      raise "invalid next option for option 'X'"
    end
  end

  if alignment <= 1 or option.kind == PACK_CHAR then
    option.padding = 0
  else
    if alignment > state.maximum_alignment then
      alignment = state.maximum_alignment
    end
    if not power_of_two(alignment) then
      raise "format asks for alignment not power of 2"
    end
    local remainder = total_size % alignment
    option.padding =
      (alignment - remainder) % alignment
  end
  return option
end

local function checked_pack_growth(total_size: integer,
                                   addition: integer)
  local maximum = MAXIMUM_STRING_BYTES
  if addition < 0 or addition > maximum - total_size then
    raise "result too long"
  end
end

local function pack_integer_bytes(number: foreign lua_Integer,
                                  size: integer,
                                  little_endian: boolean,
                                  negative: boolean): string
  local storage = foreign char.new_array(size)
  local remaining = number as foreign lua_Unsigned
  local index = 0
  while index < size do
    local destination = size - index - 1
    if little_endian then destination = index end
    local octet: foreign unsigned char =
      0 as foreign unsigned char
    if index >= foreign lua_Integer.sizeof and negative then
      octet = 255 as foreign unsigned char
    else
      octet =
        (remaining & (255 as foreign lua_Unsigned))
          as foreign unsigned char
      remaining =
        remaining >> (8 as foreign int)
    end
    storage[destination] = octet as foreign char
    index = index + 1
  end
  return storage as string
end

local function check_signed_pack_range(number: foreign lua_Integer,
                                       size: integer)
  if size < foreign lua_Integer.sizeof then
    local shift = size * 8 - 1
    local limit = 1 << shift
    if number < (-limit as foreign lua_Integer) or
        number >= (limit as foreign lua_Integer) then
      raise "integer overflow"
    end
  end
end

local function check_unsigned_pack_range(number: foreign lua_Integer,
                                         size: integer)
  if size < foreign lua_Integer.sizeof then
    local shift = size * 8
    local limit =
      (1 as foreign lua_Unsigned) <<
      (shift as foreign int)
    if (number as foreign lua_Unsigned) >= limit then
      raise "unsigned overflow"
    end
  end
end

local function ordered_native_bytes(bytes: string,
                                    little_endian: boolean,
                                    native_little_endian: boolean): string
  if little_endian == native_little_endian then return bytes end
  return reverse(bytes)
end

local function pack_float_bytes(number: foreign lua_Number,
                                little_endian: boolean,
                                native_little_endian: boolean): string
  local converted = number as foreign float
  local storage = foreign char.new_array(
    foreign float.sizeof as integer)
  local output = storage as foreign *char
  ffi.memcpy(
    output, converted, #storage as foreign size_t)
  return ordered_native_bytes(
    storage as string,
    little_endian, native_little_endian)
end

local function pack_number_bytes(number: foreign lua_Number,
                                 little_endian: boolean,
                                 native_little_endian: boolean): string
  local storage = foreign char.new_array(
    foreign lua_Number.sizeof as integer)
  local output = storage as foreign *char
  ffi.memcpy(
    output, number, #storage as foreign size_t)
  return ordered_native_bytes(
    storage as string,
    little_endian, native_little_endian)
end

local function pack_double_bytes(number: foreign lua_Number,
                                 little_endian: boolean,
                                 native_little_endian: boolean): string
  local converted = number as foreign double
  local storage = foreign char.new_array(
    foreign double.sizeof as integer)
  local output = storage as foreign *char
  ffi.memcpy(
    output, converted, #storage as foreign size_t)
  return ordered_native_bytes(
    storage as string,
    little_endian, native_little_endian)
end

local function next_pack_argument(arguments: {value},
                                  index: integer): value
  if index > #arguments then return nil end
  return arguments[index]
end

local function unpack_integer_bytes(data: string, position: integer,
                                    size: integer,
                                    little_endian: boolean,
                                    signed: boolean): foreign lua_Integer
  local bytes = data as foreign const *unsigned char
  local limit = size
  if limit > foreign lua_Integer.sizeof then
    limit = foreign lua_Integer.sizeof as integer
  end
  local result: foreign lua_Unsigned = 0 as foreign lua_Unsigned
  local index = limit - 1
  while index >= 0 do
    result =
      result << (8 as foreign int)
    local source_index = size - index - 1
    if little_endian then source_index = index end
    result = result |
      (bytes[position + source_index] as foreign lua_Unsigned)
    index = index - 1
  end

  if size < foreign lua_Integer.sizeof and signed then
    local mask =
      (1 as foreign lua_Unsigned) <<
      ((size * 8 - 1) as foreign int)
    result = (result ~ mask) - mask
  elseif size > foreign lua_Integer.sizeof then
    local extension = 0
    if signed and (result as foreign lua_Integer) < 0 then
      extension = 255
    end
    index = limit
    while index < size do
      local source_index = size - index - 1
      if little_endian then source_index = index end
      if (bytes[position + source_index] as integer) ~=
          extension then
        raise "integer does not fit into Lua Integer"
      end
      index = index + 1
    end
  end
  return result as foreign lua_Integer
end

local function native_ordered_slice(data: string, position: integer,
                                    size: integer,
                                    little_endian: boolean,
                                    native_little_endian: boolean): string
  local bytes = copy_interval(data, position + 1, size)
  if little_endian == native_little_endian then return bytes end
  return reverse(bytes)
end

local function unpack_float_bytes(data: string, position: integer,
                                  little_endian: boolean,
                                  native_little_endian: boolean):
                                  foreign lua_Number
  local bytes = native_ordered_slice(
    data, position, foreign float.sizeof as integer,
    little_endian, native_little_endian)
  local source = bytes as foreign const *char
  local converted: foreign float =
    0.0 as foreign float
  ffi.memcpy(
    converted, source,
    foreign float.sizeof as foreign size_t)
  return converted as foreign lua_Number
end

local function unpack_number_bytes(data: string, position: integer,
                                   little_endian: boolean,
                                   native_little_endian: boolean):
                                   foreign lua_Number
  local bytes = native_ordered_slice(
    data, position, foreign lua_Number.sizeof as integer,
    little_endian, native_little_endian)
  local source = bytes as foreign const *char
  local converted: foreign lua_Number = 0.0 as foreign lua_Number
  ffi.memcpy(
    converted, source,
    foreign lua_Number.sizeof as foreign size_t)
  return converted
end

local function unpack_double_bytes(data: string, position: integer,
                                   little_endian: boolean,
                                   native_little_endian: boolean):
                                   foreign lua_Number
  local bytes = native_ordered_slice(
    data, position, foreign double.sizeof as integer,
    little_endian, native_little_endian)
  local source = bytes as foreign const *char
  local converted: foreign double =
    0.0 as foreign double
  ffi.memcpy(
    converted, source,
    foreign double.sizeof as foreign size_t)
  return converted as foreign lua_Number
end
