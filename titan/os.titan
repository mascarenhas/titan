--- Clocks, calendars, environment, process streams, signals, and child-process lifecycle.
-- @module titan.os
-- @usage standard-library-os.md

local uv = import "uv"
local async = import "async"
local iteration = import "iteration"
local protobuf = import "protobuf"
local reflect = import "reflect"
foreign import "os_platform.h"
foreign import "os_environment.h"
foreign type ParentStdioProbe = titan_parent_stdio_probe
local string = import "string"
foreign import "time.h"
foreign import "locale.h"
foreign import "string.h"

local const output_transfer_fields: const {reflect.Type} = {
  reflect.Type.is_integer(), reflect.Type.is_option(reflect.Type.is_string()),
}
local const input_transfer_fields: const {reflect.Type} = {
  reflect.Type.is_integer(), reflect.Type.is_string(), reflect.Type.is_integer(),
  reflect.Type.is_option(reflect.Type.is_named(reflect.NamedType("titan.async.OperationError"))),
  reflect.Type.is_option(reflect.Type.is_string()),
  reflect.Type.is_array(reflect.ArrayTypeConstness.is_mutable(), reflect.Type.is_string()),
}

-- Time/date behavior is translated and adapted from src/loslib.c in the
-- immutable Lua 5.5.1 release:
-- https://www.lua.org/ftp/lua-5.5.1.tar.gz
-- Copyright (C) 1994-2026 Lua.org, PUC-Rio. MIT terms are reproduced in
-- LICENSES/lua-LICENSE.

-- Portable operating-system helpers. The low-level uv module owns native
-- resources plus portable current/CPU clock queries. The ISO C surface above
-- remains only for calendar, difference, formatting, and locale operations
-- that libuv does not provide; this facade exposes ordinary Titan values.

--- Calendar date returned by date with the *t format.
-- @field year Calendar year.
-- @field month Month in 1..12.
-- @field day Day of month in 1..31.
-- @field hour Hour in 0..23.
-- @field min Minute in 0..59.
-- @field sec Second, including a host-reported leap second.
-- @field wday Weekday in 1..7, with Sunday as 1.
-- @field yday Day of year beginning at 1.
-- @field isdst Daylight-saving indication, or nil when unknown.
-- @usage standard-library-os.md
record Date
  year: integer
  month: integer
  day: integer
  hour: integer
  min: integer
  sec: integer
  wday: integer
  yday: integer
  isdst: boolean?
end

--- Terminal child-process exit code and signal information.
-- @field code Process exit code.
-- @field signal Signal name when recognized, otherwise nil.
-- @field signal_number Numeric terminating signal, or zero for an ordinary exit.
-- @usage standard-library-os.md
record ExitStatus
  code: integer
  signal: string?
  signal_number: integer
end

--- Opaque child-process configuration borrowed by SpawnOption callbacks.
-- @usage standard-library-os.md
record SpawnConfig
  local handle: ProcessConfig
end

--- Child-process option callback returning a native status code.
-- @usage standard-library-os.md
type SpawnOption = function (SpawnConfig): (integer)

--- Parent-facing readable process or standard-input stream.
-- @usage standard-library-os.md
record InputStream
  local handle: Stdio?
  local parent_descriptor: integer
  local excess: string
end

--- Parent-facing writable process or standard-output stream.
-- @usage standard-library-os.md
record OutputStream
  local handle: Stdio?
  local parent_descriptor: integer
end

-- These are process-stdio records: the Titan process's stable streams and
-- captured parent-facing endpoints of spawned processes. Their Stdio owner
-- contains the private stream/file backing union; provenance and ownership
-- remain ordinary metadata and never guess the underlying descriptor kind.
--- Spawned process with independently owned optional captured streams.
-- @field stdin Writable child stdin endpoint, or nil when inherited.
-- @field stdout Readable child stdout endpoint, or nil when inherited.
-- @field stderr Readable child stderr endpoint, possibly shared with stdout, or nil.
-- @usage standard-library-os.md
record Process
  local handle: ProcessOwner
  stdin: OutputStream?
  stdout: InputStream?
  stderr: InputStream?
end

--- Stable readable standard-input stream of the Titan process.
-- @usage standard-library-os.md
stdin: InputStream = InputStream { handle = nil, parent_descriptor = 0, excess = "" }
--- Stable writable standard-output stream of the Titan process.
-- @usage standard-library-os.md
stdout: OutputStream = OutputStream { handle = nil, parent_descriptor = 1 }
--- Stable writable standard-error stream of the Titan process.
-- @usage standard-library-os.md
stderr: OutputStream = OutputStream { handle = nil, parent_descriptor = 2 }

local function byte_at(text: string, index: integer): integer
  local bytes = text as foreign const *unsigned char
  return bytes[index - 1] as integer
end

local function reject_embedded_nul(text: string, subject: string)
  local index = 1
  while index <= #text do
    if byte_at(text, index) == 0 then
      raise subject .. " contains an embedded NUL"
    end
    index = index + 1
  end
end

local function contains_conversion(options: string,
                                   conversion: integer): boolean
  local index = 1
  while index <= #options do
    if byte_at(options, index) == conversion then return true end
    index = index + 1
  end
  return false
end

local function validate_date_format(format: string)
  -- This is Lua 5.5's C99 conversion set. Keeping the validation here avoids
  -- silently accepting host extensions that the corresponding Lua build
  -- rejects before calling strftime.
  local ordinary = "aAbBcCdDeFgGhHIjmMnprRStTuUVwWxXyYzZ%"
  local after_e = "cCxXyY"
  local after_o = "deHImMSuUVwWy"
  local index = 1
  while index <= #format do
    if byte_at(format, index) == 37 then
      index = index + 1
      if index > #format then
        raise "invalid conversion specifier '%'"
      end
      local conversion = byte_at(format, index)
      if conversion == 69 or conversion == 79 then
        local modifier = conversion
        index = index + 1
        if index > #format then
          raise "invalid conversion specifier '%" ..
                string.sub(format, index - 1) .. "'"
        end
        conversion = byte_at(format, index)
        local choices = after_e
        if modifier == 79 then choices = after_o end
        if not contains_conversion(choices, conversion) then
          raise "invalid conversion specifier '%" ..
                string.sub(format, index - 1, index) .. "'"
        end
      elseif not contains_conversion(ordinary, conversion) then
        raise "invalid conversion specifier '%" ..
              string.sub(format, index, index) .. "'"
      end
    end
    index = index + 1
  end
end

local function formatted_date(format: string,
                              calendar: foreign *tm): string
  if #format == 0 then return "" end
  validate_date_format(format)

  -- Lua renders each conversion into a 250-byte scratch fragment. A complete
  -- result that every one of those fragments can represent is therefore
  -- bounded by 250 bytes per format byte. Grow up to that compatibility
  -- bound; zero at the bound means the valid format expanded to empty.
  if #format > (9223372036854775807 - 1) // 250 then
    raise "date result is too large"
  end
  local maximum = #format * 250 + 1
  local capacity = 128
  if maximum < capacity then maximum = capacity end

  while true do
    local buffer = foreign char.new_array(capacity)
    local written = ffi.strftime(
      buffer, capacity as foreign size_t, format, calendar)
    if written ~= 0 then
      local length = written as integer
      local result = foreign char.new_array(length)
      ffi.memcpy(
        result as foreign *char,
        buffer as foreign const *char,
        written as foreign size_t)
      return result as string
    end
    if capacity >= maximum then return "" end
    if capacity > maximum // 2 then
      capacity = maximum
    else
      capacity = capacity * 2
    end
  end
  return ""
end

local function checked_time_field(number: integer, delta: integer,
                                  name: string): foreign int
  if number >= 0 then
    if number > 2147483647 + delta then
      raise "time field '" .. name .. "' is out of range"
    end
  elseif number < -2147483648 + delta then
    raise "time field '" .. name .. "' is out of range"
  end
  return (number - delta) as foreign int
end

local function locale_category(name: string): foreign int
  if name == "all" then return ffi.LC_ALL end
  if name == "collate" then return ffi.LC_COLLATE end
  if name == "ctype" then return ffi.LC_CTYPE end
  if name == "monetary" then return ffi.LC_MONETARY end
  if name == "numeric" then return ffi.LC_NUMERIC end
  if name == "time" then return ffi.LC_TIME end
  raise "invalid locale category '" .. name .. "'"
end

local function parent_stdio(descriptor: integer): Stdio
  if descriptor < 0 or descriptor > 2 then
    raise "internal parent stdio descriptor is invalid"
  end
  return os_parent_stdio(descriptor)
end

local function input_handle(stream: InputStream): Stdio
  if stream.parent_descriptor < 0 then
    local captured? = stream.handle
    if not captured then raise "InputStream is closed" end
    return captured as Stdio
  end
  local previous? = stream.handle
  if previous ~= nil then
    async.running()
    -- EOF may retire the native duplicate before the subscription and this
    -- facade have delivered their buffered bytes. Keep that read owner for
    -- this Runtime; a later Runtime gets a fresh wrapper and empty excess.
    if previous.loop == async.current_loop() then return previous end
  end
  local handle = parent_stdio(stream.parent_descriptor)
  if not previous or previous ~= handle then
    stream.excess = ""
  end
  stream.handle = handle
  return handle
end

local function output_handle(stream: OutputStream): Stdio
  if stream.parent_descriptor < 0 then
    local captured? = stream.handle
    if not captured then raise "OutputStream is closed" end
    return captured as Stdio
  end
  local handle = parent_stdio(stream.parent_descriptor)
  stream.handle = handle
  return handle
end

local function captured_input_is_closed(stream: InputStream): boolean
  return stream.parent_descriptor < 0 and not stream.handle
end

local function read_stream(stream: InputStream): string?
  if captured_input_is_closed(stream) then return nil end
  local handle = input_handle(stream)
  if #stream.excess > 0 then
    local result = stream.excess
    stream.excess = ""
    return result
  end
  return os_stdio_read(handle)
end

local function read_input_until(stream: InputStream, delimiter: string,
                                chop: boolean?): string?
  if captured_input_is_closed(stream) then return nil end
  if #delimiter == 0 then raise "read delimiter must not be empty" end

  local builder = string.writer()
  local tail = ""
  while true do
    local chunk? = read_stream(stream)
    if not chunk then
      if captured_input_is_closed(stream) then return nil end
      if #tail > 0 then builder:write(tail) end
      local result = builder:drain()
      if #result == 0 then return nil end
      return result
    end
    local bytes = chunk as string
    local boundary = bytes
    if #tail > 0 then boundary = tail .. bytes end
    local match: integer? = string.find(boundary, delimiter)
    if match then
      local match_first = match as integer
      local match_end = match_first + #delimiter - 1
      local result_end = match_end
      if chop then result_end = match_first - 1 end
      if result_end > 0 then
        builder:write(string.sub(boundary, 1, result_end))
      end
      stream.excess = string.sub(boundary, match_end + 1)
      return builder:drain()
    end
    local keep = #delimiter - 1
    if keep > #boundary then keep = #boundary end
    local committed = #boundary - keep
    if committed > 0 then
      if committed == #boundary then
        builder:write(boundary)
      else
        builder:write(string.sub(boundary, 1, committed))
      end
    end
    tail = string.sub(boundary, committed + 1)
  end
  return nil
end

--- Return consumed process CPU time in seconds.
-- @return CPU seconds, rather than elapsed wall time.
-- @usage standard-library-os.md
function clock(): float
  return os_clock()
end

--- Return the difference between two timestamps in seconds.
-- @param later Later timestamp.
-- @param earlier Earlier timestamp.
-- @return Floating-point second difference.
-- @usage standard-library-os.md
function difftime(later: integer, earlier: integer): float
  return ffi.difftime(
    later as foreign time_t,
    earlier as foreign time_t) as float
end

--- Format a timestamp or return a Date record using the *t format.
-- @param format C-style format; nil selects %c and leading ! selects UTC.
-- @param timestamp Timestamp; nil selects the current time.
-- @return Formatted string or Date record boxed as value.
-- @usage standard-library-os.md
function date(format: string?, timestamp: integer?): value
  local actual_format = "%c"
  if format then actual_format = format as string end
  reject_embedded_nul(actual_format, "date format")

  local utc = false
  if #actual_format > 0 and byte_at(actual_format, 1) == 33 then
    utc = true
    actual_format = string.sub(actual_format, 2)
  end

  local instant = os_time() as foreign time_t
  if timestamp then
    instant = (timestamp as integer) as foreign time_t
  end
  local calendar = ffi.localtime(instant)
  if utc then calendar = ffi.gmtime(instant) end
  if not calendar then
    raise "date result cannot be represented in this installation"
  end

  if actual_format == "*t" then
    local isdst: boolean? = nil
    if calendar.tm_isdst >= 0 then
      isdst = calendar.tm_isdst ~= 0
    end
    return Date {
      year = (calendar.tm_year as integer) + 1900,
      month = (calendar.tm_mon as integer) + 1,
      day = calendar.tm_mday as integer,
      hour = calendar.tm_hour as integer,
      min = calendar.tm_min as integer,
      sec = calendar.tm_sec as integer,
      wday = (calendar.tm_wday as integer) + 1,
      yday = (calendar.tm_yday as integer) + 1,
      isdst = isdst,
    }
  end
  return formatted_date(actual_format, calendar)
end

--- Query or change the process-wide locale category.
-- @param locale Locale name, empty for environment selection, or nil to query.
-- @param category Locale category; nil selects all.
-- @return Selected locale name, or nil if unavailable.
-- @usage standard-library-os.md
function setlocale(locale: string?, category: string?): string?
  local actual_category = "all"
  if category then actual_category = category as string end
  reject_embedded_nul(actual_category, "locale category")
  local category_id = locale_category(actual_category)

  local selected = ffi.setlocale(category_id, nil)
  if locale then
    local requested = locale as string
    reject_embedded_nul(requested, "locale name")
    selected = ffi.setlocale(category_id, requested)
  end
  if not selected then return nil end
  return selected as string
end

--- Return the current timestamp or normalize a supplied local calendar date.
-- @param year Calendar year; omit all calendar fields for the current timestamp.
-- @param month Month number, required with a calendar year.
-- @param day Day of month, required with a calendar year.
-- @param hour Hour; nil defaults to noon.
-- @param min Minute; nil defaults to zero.
-- @param sec Second; nil defaults to zero.
-- @param isdst Daylight-saving hint, or nil to let the host decide.
-- @return Integer timestamp.
-- @usage standard-library-os.md
function time(year: integer?, month: integer?, day: integer?,
              hour: integer?, min: integer?, sec: integer?,
              isdst: boolean?): integer
  if not year and not month and not day then
    if hour then
      raise "time requires year, month, and day together"
    end
    if min then
      raise "time requires year, month, and day together"
    end
    if sec then
      raise "time requires year, month, and day together"
    end
    if isdst == true or isdst == false then
      raise "time requires year, month, and day together"
    end
    return os_time()
  end
  if not year or not month or not day then
    raise "time requires year, month, and day together"
  end

  local actual_hour = 12
  local actual_minute = 0
  local actual_second = 0
  if hour then actual_hour = hour as integer end
  if min then actual_minute = min as integer end
  if sec then actual_second = sec as integer end

  local calendar = foreign tm.new()
  calendar.tm_year = checked_time_field(year as integer, 1900, "year")
  calendar.tm_mon = checked_time_field(month as integer, 1, "month")
  calendar.tm_mday = checked_time_field(day as integer, 0, "day")
  calendar.tm_hour = checked_time_field(actual_hour, 0, "hour")
  calendar.tm_min = checked_time_field(actual_minute, 0, "min")
  calendar.tm_sec = checked_time_field(actual_second, 0, "sec")
  calendar.tm_isdst = -1 as foreign int
  if isdst == false then
    calendar.tm_isdst = 0 as foreign int
  elseif isdst == true then
    calendar.tm_isdst = 1 as foreign int
  end

  local instant = ffi.mktime(calendar)
  if instant == (-1 as foreign time_t) then
    raise "time result cannot be represented in this installation"
  end
  return instant as integer
end

--- Read a process environment variable.
-- @param name Variable name.
-- @return Value, or nil when absent.
-- @usage standard-library-os.md
function getenv(name: string): string?
  return os_getenv(name)
end

--- Set a process-wide environment variable.
-- @param name Variable name.
-- @param contents New value.
-- @usage standard-library-os.md
function setenv(name: string, contents: string)
  os_setenv(name, contents)
end

--- Remove a process-wide environment variable.
-- @param name Variable name.
-- @usage standard-library-os.md
function unsetenv(name: string)
  os_unsetenv(name)
end

--- Return the process current working directory.
-- @usage standard-library-os.md
function cwd(): string
  return current_directory("os.cwd")
end

--- Change the process-wide working directory.
-- @param path New directory; coordinate and restore temporary changes.
-- @usage standard-library-os.md
function chdir(path: string)
  change_directory(path, "os.chdir")
end

--- Return the current user home directory.
-- @usage standard-library-os.md
function homedir(): string
  return os_homedir()
end

--- Return the operating-system temporary directory.
-- @usage standard-library-os.md
function tmpdir(): string
  return os_tmpdir()
end

--- Return the current host name.
-- @usage standard-library-os.md
function hostname(): string
  return os_hostname()
end

--- Return the current executable path.
-- @usage standard-library-os.md
function exepath(): string
  return os_exepath()
end

--- Return the current process identifier.
-- @usage standard-library-os.md
function pid(): integer
  return os_pid()
end

--- Return the parent process identifier.
-- @usage standard-library-os.md
function ppid(): integer
  return os_ppid()
end

--- Capture child stdin as a writable parent endpoint.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_stdin(config: SpawnConfig): integer
  return configure_capture(config.handle, 0)
end

--- Capture child stdout as a readable parent endpoint.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_stdout(config: SpawnConfig): integer
  return configure_capture(config.handle, 1)
end

--- Capture child stderr as a readable parent endpoint.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_stderr(config: SpawnConfig): integer
  return configure_capture(config.handle, 2)
end

--- Let the child inherit the parent standard input.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_parent_stdin(config: SpawnConfig): integer
  return configure_parent(config.handle, 0)
end

--- Let the child inherit the parent standard output.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_parent_stdout(config: SpawnConfig): integer
  return configure_parent(config.handle, 1)
end

--- Let the child inherit the parent standard error.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_parent_stderr(config: SpawnConfig): integer
  return configure_parent(config.handle, 2)
end

--- Capture child stdout and stderr through one shared readable endpoint.
-- @param config Borrowed spawn configuration; pass this function as a SpawnOption.
-- @return Zero on success or a negative native status code.
-- @usage standard-library-os.md
function with_merged_output(config: SpawnConfig): integer
  return os_spawn_config_with_merged_output(config.handle)
end

--- Create a child-only environment override without changing the parent environment.
-- @param name Environment variable name.
-- @param contents Value inherited by the child instead of the parent value.
-- @return SpawnOption applying the override.
-- @usage standard-library-os.md
function with_env(name: string, contents: string): SpawnOption
  return function (config: SpawnConfig): integer
    return os_spawn_config_with_env(config.handle, name, contents)
  end
end

--- Execute a child directly with explicit argv and optional stdio configuration.
-- @param file Executable path or name.
-- @param args Arguments excluding argv[0].
-- @param ... SpawnOption callbacks; by default all three descriptors are captured.
-- @return Process whose captured streams must be drained and closed by their owners.
-- @usage standard-library-os.md
function spawn(file: string, args: {string},
               ...: SpawnOption): Process
  local config = SpawnConfig(os_spawn_config_new())
  defer os_spawn_config_close(config.handle)
  do
    local status = with_stdin(config)
    if status >= 0 then status = with_stdout(config) end
    if status >= 0 then status = with_stderr(config) end
    local index = 1
    while status >= 0 and index <= #... do
      local option = ...[index]
      status = option(config)
      index = index + 1
    end
    if status < 0 then
      os_spawn_config_error(config.handle, status)
    end
    local process_handle, raw_stdin?, raw_stdout?, raw_stderr? =
      os_process_spawn_with_config(file, args, config.handle)

    local input: OutputStream? = nil
    if raw_stdin then
      local stdio = raw_stdin as Stdio
      input = OutputStream { handle = stdio, parent_descriptor = -1 }
    end

    local output: InputStream? = nil
    if raw_stdout then
      local stdio = raw_stdout as Stdio
      output = InputStream { handle = stdio, parent_descriptor = -1, excess = "" }
    end

    local diagnostics: InputStream? =
      (function (stderr: Stdio?, stdout: Stdio?,
                 output: InputStream?): InputStream?
        if not stderr then return nil end
        if stdout and stderr == stdout then return output end
        return InputStream { handle = stderr, parent_descriptor = -1, excess = "" }
      end)(raw_stderr, raw_stdout, output)

    local result = Process {
      handle = process_handle,
      stdin = input,
      stdout = output,
      stderr = diagnostics,
    }
    local empty_slots: {SpawnSlot} = {}
    config.handle.cleanup(true)
    config.handle.slots = empty_slots
    config.handle.cleanup = nil
    config.handle.consumed = true
    return result
  catch
    do os_spawn_config_close(config.handle) catch end
    raise
  end
end

-- Only io.popen selects shell syntax. Ordinary spawn keeps libuv's normal argv
-- quoting; the source-private option is not part of the public SpawnOption API.
local function with_shell_arguments(config: SpawnConfig): integer
  return os_spawn_config_for_shell(config.handle)
end

local function spawn_shell(command: string): Process
  local file, args = os_shell_command(command)
  return spawn(file, args, with_stdin, with_merged_output, with_shell_arguments)
end

--- Wait for child termination without closing captured streams.
-- @return Terminal exit status.
-- @usage standard-library-os.md
function Process:wait(): ExitStatus
  local code, signal_number = os_process_wait(self.handle)
  return ExitStatus {
    code = code,
    signal = signal_name(signal_number),
    signal_number = signal_number,
  }
end

--- Send a signal to the child process.
-- @param signal Supported signal name such as term.
-- @usage standard-library-os.md
function Process:kill(signal: string)
  os_process_kill(self.handle, signal)
end

--- Query whether child termination has been observed.
-- @return True while the process is running.
-- @usage standard-library-os.md
function Process:is_running(): boolean
  return os_process_is_running(self.handle)
end

--- Write all bytes to the process or standard-output stream.
-- @param data Complete binary byte string.
-- @usage standard-library-os.md
function OutputStream:write(data: string)
  os_stdio_write(output_handle(self), data)
end

--- Close the writable stream; accepted cleanup completes despite Task cancellation.
-- @usage standard-library-os.md
function OutputStream:close()
  if self.parent_descriptor >= 0 then return end
  local captured? = self.handle
  if not captured then return end
  self.handle = nil
  os_stdio_close(captured as Stdio)
end

--- Check whether the writable stream is a terminal.
-- @return True for a TTY endpoint.
-- @usage standard-library-os.md
function OutputStream:is_tty(): boolean
  return os_stdio_is_tty(output_handle(self))
end

--- Return the writable stream's descriptor backing kind.
-- @return "tty", "pipe", or "file".
-- @usage standard-library-os.md
function OutputStream:kind(): string
  return os_stdio_kind(output_handle(self))
end

--- Read a binary chunk from the process or standard-input stream.
-- @return Bytes or nil at EOF or after terminal close.
-- @usage standard-library-os.md
function InputStream:read(): string?
  return read_stream(self)
end

--- Read a process stream through a binary delimiter across chunk boundaries.
-- @param delimiter Nonempty delimiter bytes.
-- @param chop True removes the delimiter.
-- @return Delimited bytes or final suffix, or nil at EOF.
-- @usage standard-library-os.md
function InputStream:read_until(delimiter: string,
                                chop: boolean?): string?
  return read_input_until(self, delimiter, chop)
end

--- Close the readable stream and discard its buffered suffix.
-- @usage standard-library-os.md
function InputStream:close()
  -- Main-process stdin is a borrowed stable facade; closing it is a no-op.
  if self.parent_descriptor >= 0 then return end
  local captured? = self.handle
  if not captured then return end
  self.handle = nil
  self.excess = ""
  os_stdio_close(captured as Stdio)
end

--- Check whether the readable stream is a terminal.
-- @return True for a TTY endpoint.
-- @usage standard-library-os.md
function InputStream:is_tty(): boolean
  return os_stdio_is_tty(input_handle(self))
end

--- Return the readable stream's descriptor backing kind.
-- @return "tty", "pipe", or "file".
-- @usage standard-library-os.md
function InputStream:kind(): string
  return os_stdio_kind(input_handle(self))
end

--- Request graceful program exit after Task and native ownership cleanup.
-- @param code Exit code; nil selects zero.
-- @usage standard-library-os.md
function exit(code: integer?)
  local actual_code = 0
  if code then actual_code = code as integer end
  os_exit(actual_code)
end

--- Wait for a named operating-system signal in the current Task.
-- @param name Supported signal name.
-- @return Received signal name.
-- @usage standard-library-os.md
function wait_signal(name: string): string
  return os_wait_signal(name)
end

-- Domain ownership stays here. Public uv owns native callback storage; async
-- owns waits and subscription queues, never process or stdio policy.
local FILE_READ_CHUNK_BYTES = 64 * 1024

local record StreamStdio
  native: uv.stream_t
  handle: uv.handle_t
  alloc_read: uv.alloc_cb?
  deliver_read: uv.read_cb?
end

local record FileStdio
  descriptor: integer
  read_request: uv.fs_t
  read_buffer: uv.buf_t?
  reading: boolean
  deliver_read: (function (uv.fs_t): ())?
  publish_read: (function (string): (boolean))?
  fail_read: (function (async.OperationError): (boolean))?
  finish_read: (function (): (boolean))?
  write_request: uv.fs_t
  writing: boolean
  deliver_write: (function (uv.fs_t): ())?
  write_head: FileWriteOperation?
  write_tail: FileWriteOperation?
end

local union StdioBacking
  stream(StreamStdio)
  file(FileStdio)
end

local record Stdio
  backing: StdioBacking
  loop: uv.loop_t
  reads: async.BufferedSubscription<|string, async.OperationError|>?
  pending_writes: integer
end

local record CloseOperation
  handle: uv.handle_t
  completion: async.Completion<|CloseOperation, nil, async.OperationError|>?
  number: integer
end

local record StreamWriteOperation
  stream: Stdio
  backing: StreamStdio
  data: string
  completion: async.Completion<|StreamWriteOperation, nil, async.OperationError|>?
  number: integer
end

local record FileWriteOperation
  stream: Stdio
  file: FileStdio
  data: string
  buffer: uv.buf_t?
  offset: integer
  completion: async.Completion<|FileWriteOperation, nil, async.OperationError|>?
  number: integer
  next: FileWriteOperation?
end

local union SpawnSlot
  inherit(Stdio)
  capture(Stdio)
  merged(child: Stdio, parent: Stdio)
end

local record SpawnEnvironmentEntry
  name: string
  contents: string
end

local record ProcessConfig
  loop: uv.loop_t
  options: uv.process_options_t
  slots: {SpawnSlot}
  environment: {SpawnEnvironmentEntry}
  consumed: boolean
  cleanup: (function (boolean): ())?
end

local record ProcessOwner
  native: uv.process_t
  loop: uv.loop_t
  result: ExitStatus?
  exits: async.CoalescingSubscription<|ExitStatus, async.OperationError|>?
end

local parent_loop: uv.loop_t? = nil
local cached_parent_stdio: {Stdio} = {}

local function make_error(code: integer, operation: string): async.OperationError
  return async.OperationError(code, uv.err_name(code), uv.strerror(code), operation)
end

local function check_status(code: integer, operation: string)
  if code < 0 then raise make_error(code, operation) end
end

local function platform_status(code: integer): integer
  if code >= 0 then return uv.translate_sys_error(code) end
  if code == ffi.TITAN_OS_ENOBUFS then return uv.ENOBUFS end
  if code == ffi.TITAN_OS_ENOMEM then return uv.ENOMEM end
  if code == ffi.TITAN_OS_EINVAL then return uv.EINVAL end
  if code == ffi.TITAN_OS_ENAMETOOLONG then return uv.ENAMETOOLONG end
  if code == ffi.TITAN_OS_EBADF then return uv.EBADF end
  if code == ffi.TITAN_OS_EMFILE then return uv.EMFILE end
  if code == ffi.TITAN_OS_ENOTSUP then return uv.ENOTSUP end
  if code == ffi.TITAN_OS_ENOSYS then return uv.ENOSYS end
  return uv.UNKNOWN
end

local function signal_number(name: string): integer
  local result: integer? = nil
  if name == "hup" then result = uv.SIGHUP end
  if name == "int" then result = uv.SIGINT end
  if name == "quit" then result = uv.SIGQUIT end
  if name == "kill" then result = uv.SIGKILL end
  if name == "term" then result = uv.SIGTERM end
  if name == "usr1" then result = uv.SIGUSR1 end
  if name == "usr2" then result = uv.SIGUSR2 end
  return result or 0
end

local function signal_name(signum: integer): string?
  if signum == 0 then return nil end
  for _, name in iteration.ipairs({"hup", "int", "quit", "kill", "term", "usr1", "usr2"}) do
    if signal_number(name) == signum then return name end
  end
  return nil
end

local function os_sized_buffer(query: function (integer): (integer, string?, integer), operation: string): string?
  local capacity = 256
  while true do
    local status, result?, needed = query(capacity)
    if status >= 0 then return result end
    if status == uv.ENOENT then return nil end
    if status ~= uv.ENOBUFS then raise make_error(status, operation) end
    capacity = needed
  end
  return nil
end

local function os_clock(): float
  local status, usage? = uv.getrusage()
  check_status(status, "os.clock")
  return usage.ru_utime.tv_sec as float + (usage.ru_utime.tv_usec as float) / 1000000.0 +
    usage.ru_stime.tv_sec as float + (usage.ru_stime.tv_usec as float) / 1000000.0
end

local function os_time(): integer
  local status, current? = uv.gettimeofday()
  check_status(status, "os.current_time")
  return current.tv_sec
end

local function os_getenv(name: string): string?
  checked_text(name, "os.getenv")
  return os_sized_buffer(function (capacity: integer): (integer, string?, integer)
    return uv.os_getenv(name, capacity)
  end, "os.getenv")
end
local function os_setenv(name: string, contents: string)
  checked_text(name, "os.setenv")
  checked_text(contents, "os.setenv")
  check_status(uv.os_setenv(name, contents), "os.setenv")
end
local function os_unsetenv(name: string)
  checked_text(name, "os.unsetenv")
  check_status(uv.os_unsetenv(name), "os.unsetenv")
end
local function current_directory(operation: string): string
  return os_sized_buffer(uv.cwd, operation) as string
end
local function change_directory(path: string, operation: string)
  checked_text(path, operation)
  check_status(uv.chdir(path), operation)
end
local function os_homedir(): string
  return os_sized_buffer(uv.os_homedir, "os.homedir") as string
end
local function os_tmpdir(): string
  return os_sized_buffer(uv.os_tmpdir, "os.tmpdir") as string
end
local function os_hostname(): string
  return os_sized_buffer(uv.os_gethostname, "os.hostname") as string
end
local function os_exepath(): string
  if not uv.setup_process_args() then
    raise "os.exepath is only available in a compiled Titan program"
  end
  return os_sized_buffer(function (capacity: integer): (integer, string?, integer)
    local status, result?, used = uv.exepath(capacity)
    if status >= 0 and used == capacity - 1 then return uv.ENOBUFS, nil, capacity * 2 end
    return status, result, used
  end, "os.exepath") as string
end
local function os_pid(): integer return uv.os_getpid() end
local function os_ppid(): integer return uv.os_getppid() end
local function os_exit(code: integer) async.request_exit(code) end

local function validate_stdio(stream: Stdio)
  async.running()
  if stream.loop ~= async.current_loop() then raise "stdio stream belongs to a different async Runtime" end
end

local function native_closed(handle: uv.handle_t)
  local context = uv.handle_get_data(handle) as CloseOperation
  local completion = context.completion as async.Completion<|CloseOperation, nil, async.OperationError|>
  local number = context.number
  uv.handle_set_data(handle, nil)
  context.completion = nil
  do completion:resolve(number, nil)
  catch completion:fatal(number, error, traceback); raise end
end

local function start_close(
    completion: async.Completion<|CloseOperation, nil, async.OperationError|>,
    number: integer): uv.req_t?
  local context = completion:context(number)
  context.completion = completion
  context.number = number
  uv.handle_set_data(context.handle, context)
  uv.close(context.handle, native_closed)
  return nil
end

local function close_native(handle: uv.handle_t)
  if stream_is_closed(handle) then return end
  case async.await_cleanup_with<|CloseOperation, nil, async.OperationError|>(
    CloseOperation(handle, nil, 0), start_close)
  when success() then
  when error(failure) then raise failure
  end
end

local function StreamStdio:is_closed(): boolean
  return stream_is_closed(self.handle)
end

local function Stdio:is_closed(): boolean
  case self.backing
  when stream(backing) then return backing:is_closed()
  when file() then return false
  end
end

local function discard_unpublished_stdio(stream: Stdio?)
  if stream == nil then return end
  case stream.backing
  when stream(backing) then
    if not backing:is_closed() then uv.close(backing.handle, nil) end
  when file() then
  end
end

local function new_pipe_stdio(loop: uv.loop_t): (integer, Stdio?)
  local pipe = uv.pipe_t.new()
  local backing = StreamStdio(pipe:as_stream_t(), pipe:as_handle_t(), nil, nil)
  local stream = Stdio(StdioBacking.stream(backing), loop, nil, 0)
  local status = uv.pipe_init(loop, pipe, 0)
  if status < 0 then return status, nil end
  return 0, stream
end

local function StreamStdio:resume_read(operation: string)
  check_status(uv.read_start(self.native, self.alloc_read, self.deliver_read), operation)
end

local function StreamStdio:start_read(
    stream: Stdio, operation: string,
    initial: {string}?,
    terminal: async.SubscriptionResult<|string, async.OperationError|>?)
  if stream.reads ~= nil then return end
  local backing = self
  stream.reads = async.BufferedSubscription<|string, async.OperationError|>.new(function (publish, fail, finish)
    local actions = async.SubscriptionActions<|string|>(function ()
      if not backing:is_closed() then uv.read_stop(backing.native) end
    end, function (drain)
      drain()
      close_native(backing.handle)
    end)
    if initial ~= nil then
      for index = 1, #initial do publish(initial[index]) end
    end
    if terminal ~= nil then
      case terminal
      when error(failure) then fail(failure)
      else finish()
      end
      return actions
    end
    if backing:is_closed() then finish(); return actions end
    backing.alloc_read = function (_: uv.handle_t, size: integer): uv.buf_t
      return uv.buf_t.allocate(size)
    end
    backing.deliver_read = function (_: uv.stream_t, count: integer, buffer: uv.buf_t?)
      if count == 0 then return end
      if count > 0 then publish(buffer:to_string(count)); return end
      uv.read_stop(backing.native)
      discard_unpublished_stdio(stream)
      if count == uv.EOF then finish() else fail(make_error(count, "stdio.read")) end
    end
    local status = uv.read_start(backing.native, backing.alloc_read, backing.deliver_read)
    if status < 0 then
      discard_unpublished_stdio(stream)
      fail(make_error(status, operation))
    end
    return actions
  end)
end

local function start_stream_read(stream: Stdio, operation: string,
    initial: {string}?, terminal: async.SubscriptionResult<|string, async.OperationError|>?)
  case stream.backing
  when stream(backing) then
    backing:start_read(stream, operation, initial, terminal)
  when file() then
    raise "expected stream-backed stdio"
  end
end

local function FileStdio:complete_read(request: uv.fs_t)
  self.reading = false
  local count = 0
  local chunk = ""
  do
    count = uv.fs_get_result(request)
    if count > 0 then
      chunk = self.read_buffer:to_string(count)
    end
    uv.fs_req_cleanup(request)
  catch
    uv.fs_req_cleanup(request)
    raise
  end
  if count > 0 then
    self.publish_read(chunk)
    return
  end
  if count == 0 then
    self.finish_read()
    return
  end
  self.fail_read(make_error(count, "stdio.read"))
end

local function FileStdio:ensure_reads(stream: Stdio)
  if stream.reads ~= nil then return end
  local file = self
  self.deliver_read = function (request: uv.fs_t)
    file:complete_read(request)
  end
  stream.reads = async.BufferedSubscription<|string, async.OperationError|>.new(
    function (publish, fail, finish)
      file.publish_read = publish
      file.fail_read = fail
      file.finish_read = finish
      return async.SubscriptionActions<|string|>(
        function () end,
        function (drain) drain() end)
    end)
end

local function FileStdio:demand_read(stream: Stdio)
  local reads = stream.reads
  if self.reading or reads:has_pending() then return end
  local buffer? = self.read_buffer
  if buffer == nil then
    buffer = uv.buf_t.allocate(FILE_READ_CHUNK_BYTES)
    self.read_buffer = buffer
  end
  local status = uv.fs_read(
    stream.loop, self.read_request, self.descriptor,
    {buffer}, -1, self.deliver_read)
  if status < 0 then
    uv.fs_req_cleanup(self.read_request)
    self.fail_read(make_error(status, "stdio.read"))
  else
    self.reading = true
  end
end

local function os_stdio_read(stream: Stdio): string?
  validate_stdio(stream)
  async.checkpoint()
  case stream.backing
  when stream(backing) then
    backing:start_read(stream, "stdio.read.start", nil, nil)
    if stream.reads:has_waiter() then raise "stream already has a waiting reader" end
  when file(backing) then
    backing:ensure_reads(stream)
    if stream.reads:has_waiter() then raise "stream already has a waiting reader" end
    backing:demand_read(stream)
  end
  case stream.reads:next()
  when item(chunk) then return chunk
  when error(failure) then raise failure
  when ended() then return nil
  when closed() then return nil
  end
end

local function stdio_written(request: uv.write_t, status: integer)
  local context = request:get_data() as StreamWriteOperation
  context.stream.pending_writes = context.stream.pending_writes - 1
  local completion = context.completion as async.Completion<|StreamWriteOperation, nil, async.OperationError|>
  local number = context.number
  request:set_data(nil)
  context.completion = nil
  do
    if status < 0 then completion:reject(number, make_error(status, "stdio.write"))
    else completion:resolve(number, nil) end
  catch completion:fatal(number, error, traceback); raise end
end

local function start_stream_write(
    completion: async.Completion<|StreamWriteOperation, nil, async.OperationError|>,
    number: integer): uv.req_t?
  local context = completion:context(number)
  if context.backing:is_closed() then raise "cannot write to a closed stream" end
  if #context.data == 0 then completion:resolve(number, nil); return nil end
  local request = uv.write_t.new()
  context.completion = completion
  context.number = number
  request:set_data(context)
  local status = uv.write_string(request, context.backing.native, context.data, stdio_written)
  if status < 0 then
    request:set_data(nil)
    context.completion = nil
    completion:reject(number, make_error(status, "stdio.write"))
  else
    context.stream.pending_writes = context.stream.pending_writes + 1
  end
  return nil
end

local function FileStdio:pop_write(
    stream: Stdio,
    entry: FileWriteOperation): (
    async.Completion<|FileWriteOperation, nil, async.OperationError|>, integer)
  local next_entry? = entry.next
  entry.next = nil
  self.write_head = next_entry
  if next_entry == nil then self.write_tail = nil end
  stream.pending_writes = stream.pending_writes - 1
  local completion = entry.completion
  local number = entry.number
  entry.completion = nil
  entry.buffer = nil
  return completion, number
end

local function FileStdio:retire_write(
    stream: Stdio, entry: FileWriteOperation, status: integer)
  local completion, number = self:pop_write(stream, entry)
  do
    if status < 0 then
      completion:reject(number, make_error(status, "stdio.write"))
    else
      completion:resolve(number, nil)
    end
  catch
    completion:fatal(number, error, traceback)
    raise
  end
end

local function FileStdio:pump_writes(stream: Stdio)
  local failure: async.Error? = nil
  while not self.writing and self.write_head ~= nil do
    local entry = self.write_head
    local status = 0
    local entry_failed = false
    do
      local buffer = entry.buffer
      local slice = buffer
      if entry.offset > 0 then
        slice = buffer:slice(entry.offset + 1, #entry.data - entry.offset)
      end
      status = uv.fs_write(
        stream.loop, self.write_request, self.descriptor,
        {slice}, -1, self.deliver_write)
      if status < 0 then
        uv.fs_req_cleanup(self.write_request)
      else
        self.writing = true
      end
    catch
      entry_failed = true
      local caught_error = error
      local caught_trace = traceback
      if failure == nil then
        failure = async.Error(caught_error, caught_trace)
      end
      do uv.fs_req_cleanup(self.write_request) catch end
      local completion, number = self:pop_write(stream, entry)
      do completion:fatal(number, caught_error, caught_trace) catch end
    end
    if self.writing then break end
    if not entry_failed then
      do
        self:retire_write(stream, entry, status)
      catch
        if failure == nil then
          failure = async.Error(error, traceback)
        end
      end
    end
  end
  if failure ~= nil then
    failure:raise()
  end
end

local function FileStdio:retire_and_pump(
    stream: Stdio, entry: FileWriteOperation, status: integer)
  local failure: async.Error? = nil
  do
    self:retire_write(stream, entry, status)
  catch
    failure = async.Error(error, traceback)
  end
  do
    self:pump_writes(stream)
  catch
    if failure == nil then failure = async.Error(error, traceback) end
  end
  if failure ~= nil then failure:raise() end
end

local function FileStdio:complete_write(stream: Stdio, request: uv.fs_t)
  self.writing = false
  local entry = self.write_head
  local result = 0
  do
    result = uv.fs_get_result(request)
    uv.fs_req_cleanup(request)
  catch
    local caught_error = error
    local caught_trace = traceback
    local failure = async.Error(caught_error, caught_trace)
    do uv.fs_req_cleanup(request) catch end
    local completion, number = self:pop_write(stream, entry)
    do completion:fatal(number, caught_error, caught_trace) catch end
    do self:pump_writes(stream) catch end
    failure:raise()
  end
  if result > 0 then
    entry.offset = entry.offset + result
    if entry.offset < #entry.data then
      self:pump_writes(stream)
      return
    end
    self:retire_and_pump(stream, entry, 0)
    return
  end
  local status = result
  if status == 0 then status = uv.EIO end
  self:retire_and_pump(stream, entry, status)
end

local function start_file_write(
    completion: async.Completion<|FileWriteOperation, nil, async.OperationError|>,
    number: integer): uv.req_t?
  local context = completion:context(number)
  if #context.data == 0 then
    completion:resolve(number, nil)
    return nil
  end
  local buffer = uv.buf_t.from_string(context.data)
  local file = context.file
  local stream = context.stream
  if file.write_head == nil then
    local status = uv.fs_write(
      stream.loop, file.write_request, file.descriptor,
      {buffer}, -1, file.deliver_write)
    if status < 0 then
      uv.fs_req_cleanup(file.write_request)
      completion:reject(number, make_error(status, "stdio.write"))
      return nil
    end
    context.buffer = buffer
    context.offset = 0
    context.completion = completion
    context.number = number
    context.next = nil
    file.writing = true
    file.write_head = context
    file.write_tail = context
    stream.pending_writes = stream.pending_writes + 1
    return nil
  end
  context.buffer = buffer
  context.offset = 0
  context.completion = completion
  context.number = number
  context.next = nil
  file.write_tail.next = context
  file.write_tail = context
  stream.pending_writes = stream.pending_writes + 1
  return nil
end

local function os_stdio_write(stream: Stdio, data: string)
  validate_stdio(stream)
  case stream.backing
  when stream(backing) then
    case async.await_with<|StreamWriteOperation, nil, async.OperationError|>(
      StreamWriteOperation(stream, backing, data, nil, 0), start_stream_write)
    when success() then
    when error(failure) then raise failure
    end
  when file(backing) then
    case async.await_with<|FileWriteOperation, nil, async.OperationError|>(
      FileWriteOperation(stream, backing, data, nil, 0, nil, 0, nil), start_file_write)
    when success() then
    when error(failure) then raise failure
    end
  end
end

local function os_stdio_close(stream: Stdio)
  validate_stdio(stream)
  if stream.reads ~= nil then
    stream.reads:close()
    return
  end
  case stream.backing
  when stream(backing) then close_native(backing.handle)
  when file() then
  end
end

local function os_stdio_kind(stream: Stdio): string
  validate_stdio(stream)
  case stream.backing
  when stream(backing) then
    case backing.native
    when tty() then return "tty"
    else return "pipe"
    end
  when file() then
    return "file"
  end
end

local function os_stdio_is_tty(stream: Stdio): boolean
  return os_stdio_kind(stream) == "tty"
end

local function new_file_stdio(loop: uv.loop_t, descriptor: integer): Stdio
  local file = FileStdio(
    descriptor,
    uv.fs_t.new(), nil, false, nil, nil, nil, nil,
    uv.fs_t.new(), false, nil, nil, nil)
  local stream = Stdio(StdioBacking.file(file), loop, nil, 0)
  file.deliver_write = function (request: uv.fs_t)
    file:complete_write(stream, request)
  end
  return stream
end

local function os_wait_signal(name: string): string
  local signum = signal_number(name)
  if signum <= 0 or name == "kill" then raise "unsupported waitable signal name '" .. name .. "'" end
  async.checkpoint()
  local signal = uv.signal_t.new()
  local initialized = false
  local published = false
  defer if initialized and not published then close_native(signal:as_handle_t()) end
  local subscription = async.CoalescingSubscription<|string, async.OperationError|>.new(function (publish, fail, finish)
    local actions = async.SubscriptionActions<|string|>(function ()
      if not stream_is_closed(signal:as_handle_t()) then uv.signal_stop(signal) end
    end, function (drain) drain(); close_native(signal:as_handle_t()) end)
    check_status(uv.signal_init(async.current_loop(), signal), "signal.init")
    initialized = true
    check_status(uv.signal_start_oneshot(signal, function (_, result)
      publish(signal_name(result) as string)
      finish()
    end, signum), "signal.start")
    return actions
  end)
  published = true
  defer subscription:close()
  case subscription:next()
  when item(result) then return result
  when error(failure) then raise failure
  else raise "signal subscription ended without a signal"
  end
end

local function slot_child(slot: SpawnSlot): Stdio
  case slot
  when inherit(stream) then return stream
  when capture(stream) then return stream
  when merged{child} then return child
  end
end

local function slot_parent(slot: SpawnSlot): Stdio?
  case slot
  when inherit() then return nil
  when capture(stream) then return stream
  when merged{parent} then return parent
  end
end

local function slot_merged_child(slot: SpawnSlot): Stdio?
  case slot
  when merged{child} then return child
  else return nil
  end
end

local function duplicate_descriptor(
    descriptor: foreign int): foreign int
  local duplicate = foreign int.new_array(1)
  local cloexec_failed = foreign int.new_array(1)
  local status = platform_status(ffi.titan_duplicate_parent_descriptor(
      descriptor, duplicate, cloexec_failed))
  if status < 0 then
    ffi.titan_close_parent_duplicate(duplicate[0])
    local operation = "stdio.parent.duplicate"
    if cloexec_failed[0] ~= 0 then
      operation = "stdio.parent.duplicate.cloexec"
    end
    raise make_error(status, operation)
  end
  return duplicate[0]
end

local function parent_stdio_kind_error(code: integer, descriptor: integer,
                                       probe: string): async.OperationError
  local failure = make_error(code, "stdio.parent.kind")
  failure.message = "fd " .. descriptor .. ": " .. probe .. ": " ..
                    failure.message
  return failure
end

local function parent_stdio_pipe_hint(descriptor: integer): boolean
  local configured? = os_getenv("TITAN_STDIO_PIPE_FDS")
  if not configured then return false end
  local hint = configured as string
  if #hint == 0 or #hint % 2 == 0 then return false end
  local bytes = hint as foreign const *char
  local selected = false
  for index = 0, #hint - 1 do
    local byte = bytes[index] as integer
    if index % 2 == 0 then
      -- Only single ASCII fd digits 0, 1, and 2 are valid tokens. Validate
      -- the whole list before trusting any selected descriptor.
      if byte < 48 or byte > 50 then return false end
      if byte == descriptor + 48 then selected = true end
    elseif byte ~= 44 then
      return false
    end
  end
  return selected
end

local function parent_stdio_kind(descriptor: integer): uv.handle_type
  local fd = descriptor as foreign int
  local guessed = uv.guess_handle(descriptor)
  case guessed
  when tty() then return guessed
  when named_pipe() then return guessed
  when file() then return guessed
  when unknown() then
  else
    raise parent_stdio_kind_error(uv.ENOTSUP, descriptor,
      "uv_guess_handle classified unsupported kind " .. (uv.handle_type_name(guessed) or "unknown"))
  end

  -- uv_guess_handle does not promise errno; its isatty probe can leave an
  -- unrelated value behind. Inspect this UNKNOWN fd explicitly.
  local probe = foreign ParentStdioProbe.new()
  ffi.titan_probe_parent_stdio(fd, probe)
  if probe.status ~= 0 then
    raise parent_stdio_kind_error(platform_status(probe.status), descriptor,
                                   probe.operation as string)
  end
  if probe.is_socket == 0 then
    raise parent_stdio_kind_error(uv.ENOTSUP, descriptor,
                                   "fstat did not identify a socket")
  end
  local name_errno = probe.name_errno as integer
  local type_errno = probe.type_errno as integer

  -- Both probes run even when the first fails: any available contradiction
  -- defeats launcher knowledge about the missing metadata.
  if name_errno == 0 and probe.is_unix == 0 then
    raise parent_stdio_kind_error(uv.ENOTSUP, descriptor,
      "getsockname reported family " .. (probe.family as integer))
  end
  if type_errno == 0 and probe.is_stream == 0 then
    raise parent_stdio_kind_error(uv.ENOTSUP, descriptor,
      "getsockopt(SO_TYPE) did not identify SOCK_STREAM")
  end
  if name_errno ~= 0 and name_errno ~= ffi.EPERM and
     name_errno ~= ffi.EACCES then
    raise parent_stdio_kind_error(uv.translate_sys_error(name_errno),
                                   descriptor, "getsockname")
  end
  if type_errno ~= 0 and type_errno ~= ffi.EPERM and
     type_errno ~= ffi.EACCES then
    raise parent_stdio_kind_error(uv.translate_sys_error(type_errno),
                                   descriptor, "getsockopt(SO_TYPE)")
  end
  if name_errno == 0 and type_errno == 0 then
    raise parent_stdio_kind_error(uv.ENOTSUP, descriptor,
      "uv_guess_handle remained unknown with inspectable socket metadata")
  end
  if parent_stdio_pipe_hint(descriptor) then return uv.NAMED_PIPE end

  local missing_probe = "getsockname"
  local denied_errno = name_errno
  if denied_errno == 0 then
    missing_probe = "getsockopt(SO_TYPE)"
    denied_errno = type_errno
  end
  raise parent_stdio_kind_error(uv.translate_sys_error(denied_errno),
    descriptor, missing_probe ..
      " denied without a valid TITAN_STDIO_PIPE_FDS hint for this fd")
end


local function initialize_parent_stdio(loop: uv.loop_t, descriptor: integer): Stdio
  if parent_loop ~= loop then parent_loop = loop; cached_parent_stdio = {} end
  local cached? = cached_parent_stdio[descriptor + 1]
  if cached ~= nil and not cached:is_closed() then return cached end
  cached_parent_stdio[descriptor + 1] = nil
  local kind = parent_stdio_kind(descriptor)
  case kind
  when file() then
    local file_stream = new_file_stdio(loop, descriptor)
    cached_parent_stdio[descriptor + 1] = file_stream
    return file_stream
  else
  end
  local duplicate = duplicate_descriptor(descriptor as foreign int)
  defer ffi.titan_close_parent_duplicate(duplicate)
  local stream: Stdio? = nil
  local keep = false
  defer if not keep then discard_unpublished_stdio(stream) end
  local tty = false
  case kind
  when tty() then tty = true
  else
  end
  if tty then
    local native = uv.tty_t.new()
    local backing = StreamStdio(native:as_stream_t(), native:as_handle_t(), nil, nil)
    local owner = Stdio(StdioBacking.stream(backing), loop, nil, 0)
    check_status(uv.tty_init(loop, native, duplicate as integer, 0), "stdio.parent.init")
    stream = owner
    local status, actual? = uv.fileno(backing.handle)
    check_status(status, "stdio.parent.fileno")
    if actual:to_integer() ~= uv.get_osfhandle(duplicate as integer):to_integer() then
      check_status(platform_status(ffi.titan_close_parent_duplicate(duplicate)), "stdio.parent.duplicate.close")
    end
    duplicate = -1 as foreign int
  else
    local status = 0
    status, stream = new_pipe_stdio(loop)
    check_status(status, "stdio.parent.init")
    local handle: uv.handle_t? = nil
    case stream.backing
    when stream(backing) then
      handle = backing.handle
      case backing.native
      when pipe(native) then status = uv.pipe_open(native, duplicate as integer)
      else raise "expected pipe stream"
      end
    when file() then raise "expected pipe stream"
    end
    check_status(status, "stdio.parent.open")
    if ffi.TITAN_OS_WINDOWS ~= 0 then
      local actual: uv.os_fd_t? = nil
      status, actual = uv.fileno(handle)
      check_status(status, "stdio.parent.fileno")
      if actual:to_integer() ~= uv.get_osfhandle(duplicate as integer):to_integer() then
        check_status(platform_status(ffi.titan_close_parent_duplicate(duplicate)), "stdio.parent.duplicate.close")
      end
    end
    duplicate = -1 as foreign int
  end
  cached_parent_stdio[descriptor + 1] = stream
  keep = true
  return stream
end

local function os_parent_stdio(descriptor: integer): Stdio
  async.running()
  return initialize_parent_stdio(async.current_loop(), descriptor)
end

local function validate_config(state: ProcessConfig): integer
  async.running()
  local loop = async.current_loop()
  if state.consumed or state.loop ~= loop then
    return uv.EINVAL
  end
  return 0
end

local function discard_slot(candidate: SpawnSlot?,
                            keep_a: SpawnSlot?, keep_b: SpawnSlot?)
  if not candidate or candidate == keep_a or candidate == keep_b then return end
  local slot = candidate as SpawnSlot
  case slot
  when inherit() then
    return
  when capture(stream) then
    discard_unpublished_stdio(stream)
  when merged{child, parent} then
    discard_unpublished_stdio(child)
    discard_unpublished_stdio(parent)
  end
end

local function bind_slot(state: ProcessConfig, index: integer,
                         slot: SpawnSlot, flags: integer)
  case slot_child(slot).backing
  when stream(backing) then
    state.options.stdio[index + 1] = uv.stdio_container_t(flags,
      uv.stdio_data_t.stream(backing.native))
  when file(backing) then
    state.options.stdio[index + 1] = uv.stdio_container_t(flags,
      uv.stdio_data_t.fd(backing.descriptor))
  end
end

local function config_slot(state: ProcessConfig,
                           descriptor: integer): SpawnSlot?
  return state.slots[descriptor + 1]
end

local function configure_slot(state: ProcessConfig,
                              descriptor: integer,
                              slot: SpawnSlot, flags: integer)
  local old? = config_slot(state, descriptor)
  defer if slot ~= config_slot(state, 0) and slot ~= config_slot(state, 1) and
      slot ~= config_slot(state, 2) then discard_slot(slot, nil, nil) end
  bind_slot(state, descriptor, slot, flags)
  state.slots[descriptor + 1] = slot
  if old ~= config_slot(state, 0) and
     old ~= config_slot(state, 1) and
     old ~= config_slot(state, 2) then
    discard_slot(old, nil, nil)
  end
end

local function discard_config_streams(state: ProcessConfig)
  local stdin? = config_slot(state, 0)
  local stdout? = config_slot(state, 1)
  local stderr? = config_slot(state, 2)
  state.slots = {}
  discard_slot(stdin, stdout, stderr)
  discard_slot(stdout, stderr, nil)
  discard_slot(stderr, nil, nil)
end

local function config_capture(
    state: ProcessConfig): (integer, SpawnSlot?)
  local status, stream? = new_pipe_stdio(state.loop)
  if status < 0 then return status, nil end
  local captured = stream as Stdio
  local keep = false
  defer if not keep then discard_unpublished_stdio(captured) end
  local slot = SpawnSlot.capture(captured)
  keep = true
  return 0, slot
end

local function prepare_inherited_stdio(state: ProcessConfig,
                                       descriptor: integer):
                                       (integer, SpawnSlot?)
  local prepared: Stdio? = nil
  do
    prepared = initialize_parent_stdio(state.loop, descriptor)
  catch
    if error is async.OperationError then
      local failure = error as async.OperationError
      return failure.code, nil
    end
    raise
  end
  return 0, SpawnSlot.inherit(prepared as Stdio)
end


local function config_merged_output(state: ProcessConfig): (integer, SpawnSlot?)
  local status, parent? = new_pipe_stdio(state.loop)
  if status < 0 then return status, nil end
  local child: Stdio? = nil
  local keep = false
  defer if not keep then discard_unpublished_stdio(parent); discard_unpublished_stdio(child) end
  status, child = new_pipe_stdio(state.loop)
  if status < 0 then return status, nil end
  local fd0, fd1 = -1, -1
  defer do ffi.titan_close_parent_duplicate(fd0); ffi.titan_close_parent_duplicate(fd1) end
  status, fd0, fd1 = uv.pipe(uv.NONBLOCK_PIPE, 0)
  if status < 0 then return status, nil end
  case parent.backing
  when stream(backing) then
    case backing.native
    when pipe(native) then status = uv.pipe_open(native, fd0)
    else raise "expected pipe stream"
    end
  when file() then raise "expected pipe stream"
  end
  if status < 0 then return status, nil end
  fd0 = -1
  case child.backing
  when stream(backing) then
    case backing.native
    when pipe(native) then status = uv.pipe_open(native, fd1)
    else raise "expected pipe stream"
    end
    if status < 0 then return status, nil end
    fd1 = -1
    status = uv.stream_set_blocking(backing.native, 1)
  when file() then raise "expected pipe stream"
  end
  if status < 0 then return status, nil end
  local slot = SpawnSlot.merged(child, parent)
  keep = true
  return 0, slot
end

local function os_spawn_config_new(): ProcessConfig
  async.running()
  if async.is_closing() then
    raise "cannot configure a Process while async Runtime is shutting down"
  end
  return ProcessConfig(async.current_loop(), uv.process_options_t.new("", {}), {}, {}, false, nil)
end

local function configure_capture(config: ProcessConfig,
                                 descriptor: integer): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local captured: SpawnSlot? = nil
  status, captured = config_capture(config)
  if status < 0 then return status end
  local slot = captured as SpawnSlot
  if descriptor == 0 then
    configure_slot(config, descriptor, slot,
                   uv.CREATE_PIPE | uv.READABLE_PIPE)
    return 0
  end
  configure_slot(config, descriptor, slot,
                 uv.CREATE_PIPE | uv.WRITABLE_PIPE)
  return 0
end

local function configure_parent(config: ProcessConfig,
                                descriptor: integer): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local parent: SpawnSlot? = nil
  status, parent = prepare_inherited_stdio(config, descriptor)
  if status < 0 then return status end
  local slot = parent as SpawnSlot
  local flags = uv.INHERIT_STREAM
  case slot_child(slot).backing
  when stream() then
  when file() then flags = uv.INHERIT_FD
  end
  configure_slot(config, descriptor, slot, flags)
  return 0
end

local function os_spawn_config_with_merged_output(
    config: ProcessConfig): integer
  local status = validate_config(config)
  if status < 0 then return status end
  local merged: SpawnSlot? = nil
  status, merged = config_merged_output(config)
  if status >= 0 then
    local slot = merged as SpawnSlot
    configure_slot(config, 1, slot, uv.INHERIT_STREAM)
    configure_slot(config, 2, slot, uv.INHERIT_STREAM)
  end
  return status
end

local function os_spawn_config_for_shell(config: ProcessConfig): integer
  local status = validate_config(config)
  if status < 0 then return status end
  if ffi.TITAN_OS_WINDOWS ~= 0 then
    config.options.flags = uv.PROCESS_WINDOWS_VERBATIM_ARGUMENTS
  end
  return 0
end

local function os_spawn_config_with_env(config: ProcessConfig,
                                         name: string,
                                         contents: string): integer
  local status = validate_config(config)
  if status < 0 then return status end
  if #name == 0 or contains_nul(name) or contains_nul(contents) then
    return uv.EINVAL
  end
  local bytes = name as foreign const *unsigned char
  local byte_index = 0
  while byte_index < #name do
    if bytes[byte_index] == 61 then return uv.EINVAL end
    byte_index = byte_index + 1
  end
  local entry = SpawnEnvironmentEntry(name, contents)
  local index = 1
  while index <= #config.environment do
    local equal = ffi.titan_process_environment_name_equal(
        config.environment[index].name, name) as integer
    if equal < 0 then return platform_status(equal) end
    if equal == 1 then
      config.environment[index] = entry
      return 0
    end
    index = index + 1
  end
  config.environment[#config.environment + 1] = entry
  return 0
end

local function os_spawn_config_close(config: ProcessConfig)
  if config.consumed then return end
  async.running()
  local loop = async.current_loop()
  if config.loop ~= loop then
    raise "SpawnConfig belongs to a different async Runtime"
  end
  local cleanup? = config.cleanup
  config.consumed = true
  config.cleanup = nil
  if cleanup ~= nil then cleanup(false)
  else discard_config_streams(config) end
end

local function os_spawn_config_error(config: ProcessConfig, status: integer)
  raise make_error(status, "process.spawn.config")
end


local function contains_nul(text: string): boolean
  for index = 1, #text do if byte_at(text, index) == 0 then return true end end
  return false
end

-- Implementation notes: doc/implementation/os-library.md#spawn-transaction-and-exit-delivery
local function os_shell_command(command: string): (string, {string})
  if ffi.TITAN_OS_WINDOWS == 0 then return "/bin/sh", {"-c", command} end
  local capacity = 256
  local directory = ""
  while true do
    local bytes = foreign char.new_array(capacity)
    local sizes = foreign size_t.new_array(1)
    sizes[0] = capacity
    local status = platform_status(ffi.titan_process_system_directory(bytes, sizes))
    if status == uv.ENOBUFS then capacity = sizes[0] as integer
    else
      check_status(status, "process.shell.directory")
      directory = (bytes as foreign *char) as string
      break
    end
  end
  return directory .. "\\cmd.exe", {"/d", "/s", "/c", '"' .. command .. '"'}
end

local function spawn_environment(config: ProcessConfig): {string}?
  if #config.environment == 0 then return nil end
  local status, entries?, count = uv.os_environ()
  check_status(status, "process.spawn.environment")
  local result: {string} = {}
  for index = 1, count do
    local inherited = entries[index]
    local replaced = false
    for _, option in iteration.ipairs(config.environment) do
      local equal = ffi.titan_process_environment_name_equal(inherited.name, option.name) as integer
      if equal < 0 then check_status(platform_status(equal), "process.spawn.environment") end
      if equal == 1 then replaced = true; break end
    end
    if not replaced then result[#result + 1] = inherited.name .. "=" .. inherited.value end
  end
  for _, entry in iteration.ipairs(config.environment) do result[#result + 1] = entry.name .. "=" .. entry.contents end
  return result
end

-- Implementation notes: doc/implementation/os-library.md#spawn-transaction-and-exit-delivery
local function os_process_spawn_with_config(file: string, args: {string}, config: ProcessConfig): (ProcessOwner, Stdio?, Stdio?, Stdio?)
  check_status(validate_config(config), "process.spawn.config")
  local stdin_slot? = config_slot(config, 0)
  local stdout_slot? = config_slot(config, 1)
  local stderr_slot? = config_slot(config, 2)
  if stdin_slot == nil or stdout_slot == nil or stderr_slot == nil then os_spawn_config_error(config, uv.EINVAL) end
  if async.is_closing() then
    raise "cannot spawn a Process while async Runtime is shutting down"
  end
  if contains_nul(file) then raise make_error(uv.EINVAL, "process.spawn.file") end
  for _, arg in iteration.ipairs(args) do if contains_nul(arg) then raise make_error(uv.EINVAL, "process.spawn.argument") end end
  local argument_zero = file
  if ffi.TITAN_OS_WINDOWS ~= 0 and (config.options.flags & uv.PROCESS_WINDOWS_VERBATIM_ARGUMENTS) ~= 0 then
    argument_zero = '"' .. file .. '"'
  end
  local arguments = {argument_zero}
  for _, arg in iteration.ipairs(args) do arguments[#arguments + 1] = arg end
  config.options.file = file
  config.options.args = arguments
  config.options.env = spawn_environment(config)
  local process = ProcessOwner(uv.process_t.new(), config.loop, nil, nil)
  local handle = process.native:as_handle_t()
  local timer = uv.timer_t.new()
  local timer_handle = timer:as_handle_t()
  local rollback = false
  local term = signal_number("term")
  local kill = signal_number("kill")
  local completion: async.Completion<|ProcessOwner, nil, async.OperationError|>? = nil
  local completion_number = 0
  -- Native close callbacks run after root retirement. A callback may precede
  -- wait registration, so registration also checks this exact same condition.
  local retired = function (_: uv.handle_t)
    local done? = completion
    local number = completion_number
    if done ~= nil and not handle:is_initialized() and
        not timer_handle:is_initialized() then
      completion = nil
      do done:resolve(number, nil)
      catch done:fatal(number, error, traceback); raise end
    end
  end
  local escalate = function (_: uv.timer_t)
    if handle:is_initialized() and uv.is_active(handle) then
      uv.process_kill(process.native, kill)
    end
    uv.close(timer_handle, retired)
  end
  local register = function (done: async.Completion<|ProcessOwner, nil, async.OperationError|>,
                            number: integer): uv.req_t?
    completion = done
    completion_number = number
    if handle:is_initialized() and not uv.is_closing(handle) and uv.is_active(handle) then
      -- Native timer_start is allocation-free and cannot reject this live,
      -- non-closing timer, prebuilt callback and fixed nonnegative interval.
      -- Refresh libuv's cached time so the grace period starts with SIGTERM.
      uv.process_kill(process.native, term)
      uv.update_time(config.loop)
      uv.timer_start(timer, escalate, 30000, 0)
    else
      if not stream_is_closed(handle) then uv.close(handle, retired) end
      if not stream_is_closed(timer_handle) then uv.close(timer_handle, retired) end
      retired(handle)
    end
    return nil
  end
  config.cleanup = function (published: boolean)
    if published then
      uv.close(timer_handle, retired)
      return
    end
    rollback = true
    defer do
      case async.await_cleanup_with<|ProcessOwner, nil, async.OperationError|>(process, register)
      when success() then
      when error(failure) then raise failure
      end
    end
    discard_config_streams(config)
  end
  -- Prepare escalation before accepting a child, including the loop root.
  -- The Config capability already owns this timer if subsequent setup fails.
  check_status(uv.timer_init(config.loop, timer), "process.spawn.cleanup.timer.init")
  process.exits = async.CoalescingSubscription<|ExitStatus, async.OperationError|>.new(function (publish, fail, finish)
    -- Cancelling a wait detaches only that waiter. The accepted child remains
    -- owned until its exit callback reaps it and closes the process handle.
    local actions = async.SubscriptionActions<|ExitStatus|>(function () end, function (drain) drain() end)
    config.options.exit_cb = function (_: uv.process_t, code: integer, signum: integer)
      if rollback then
        if not stream_is_closed(timer_handle) then uv.close(timer_handle, retired) end
        uv.close(handle, retired)
        return
      end
      local result = ExitStatus(code, signal_name(signum), signum)
      process.result = result
      uv.close(process.native:as_handle_t(), nil)
      publish(result)
      finish()
    end
    return actions
  end)
  local status = uv.spawn(config.loop, process.native, config.options)
  if status < 0 then raise make_error(status, "process.spawn") end
  local stdin? = slot_parent(stdin_slot)
  local stdout? = slot_parent(stdout_slot)
  local stderr? = slot_parent(stderr_slot)
  discard_unpublished_stdio(slot_merged_child(stdout_slot))
  discard_unpublished_stdio(slot_merged_child(stderr_slot))
  -- Everything is still lexically owned by config until read registration
  -- and the result tuple are ready for publication.
  if stdout ~= nil then start_stream_read(stdout, "process.stdout.read.start") end
  if stderr ~= nil and stderr ~= stdout then start_stream_read(stderr, "process.stderr.read.start") end
  return process, stdin, stdout, stderr
end

local function validate_process(process: ProcessOwner)
  async.running()
  if process.loop ~= async.current_loop() then raise "Process belongs to a different async Runtime" end
end

local function os_process_wait(process: ProcessOwner): (integer, integer)
  validate_process(process)
  async.checkpoint()
  if process.result ~= nil then
    return process.result.code, process.result.signal_number
  end
  if process.exits:has_waiter() then raise "Process already has a waiting Task" end
  case process.exits:next()
  when item(result) then return result.code, result.signal_number
  when error(failure) then raise failure
  else raise "Process exited without a result"
  end
end

local function os_process_is_running(process: ProcessOwner): boolean
  validate_process(process)
  return process.result == nil and uv.is_active(process.native:as_handle_t())
end

local function os_process_kill(process: ProcessOwner, signal: string)
  validate_process(process)
  local signum = signal_number(signal)
  if signum <= 0 then raise "unsupported process signal name '" .. signal .. "'" end
  if not os_process_is_running(process) then raise "cannot signal an exited Process" end
  local status = uv.process_kill(process.native, signum)
  if status < 0 and status ~= uv.ESRCH then raise make_error(status, "process.kill") end
end

local function stream_is_closed(handle: uv.handle_t): boolean
  return not handle:is_initialized() or uv.is_closing(handle)
end

local function checked_text(text: string, operation: string)
  if contains_nul(text) then raise make_error(uv.EINVAL, operation) end
end

-- Validation precedes the native close. Once close is attempted, callers
-- clear their packet before reporting its status; retry must not close twice.
local function discard_output_transfer_payload(payload: string): integer
  local descriptor: integer, native: string? =
    protobuf.deserialize_fields(payload, output_transfer_fields)
  if descriptor == 1 or descriptor == 2 then
    if native ~= nil then raise "invalid standard output transfer payload" end
    return 0
  end
  if descriptor ~= -1 then raise "invalid retained output stream descriptor" end
  if native == nil then return 0 end
  return uv.pipe_t.discard_transfer_payload(native)
end

local function discard_input_transfer_payload(payload: string): integer
  local descriptor: integer, _excess: string, _terminal: integer,
    _failure: async.OperationError?, native: string?, _initial: {string} =
    protobuf.deserialize_fields(payload, input_transfer_fields)
  if descriptor == 0 then
    if native ~= nil then raise "invalid standard input transfer payload" end
    return 0
  end
  if descriptor ~= -1 then raise "invalid retained input stream descriptor" end
  if native == nil then return 0 end
  return uv.pipe_t.discard_transfer_payload(native)
end

-- Implementation notes: doc/implementation/os-library.md#process-stream-transfer
local function stream_transfer_preflight(stream: Stdio, reading: boolean)
  if stream.loop ~= async.current_loop() then
    raise "stdio stream belongs to a different async Runtime"
  end
  if async.is_closing() then raise "cannot transfer a stream while async Runtime is shutting down" end
  if stream.pending_writes ~= 0 then raise "stream has a pending write" end
  if stream.reads ~= nil and stream.reads:has_waiter() then
    raise "stream has a pending read"
  end
  if not stream:is_closed() then
    case stream.backing
    when stream(backing) then
      case backing.native
      when pipe() then
      else raise "only pipe streams support native handoff"
      end
      check_status(uv.stream_transfer_status(backing.native, reading), "stdio.transfer")
    when file() then
      raise "only pipe streams support native handoff"
    end
  end
end

local function stdio_native_payload(stream: Stdio): string
  case stream.backing
  when stream(backing) then
    case backing.native
    when pipe(native) then return native:to_transfer_payload()
    else raise "only pipe streams support native handoff"
    end
  when file() then
    raise "only pipe streams support native handoff"
  end
end

local function restored_stdio(packet: string?): Stdio
  local loop = async.current_loop()
  if async.is_closing() then raise "cannot transfer a stream while async Runtime is shutting down" end
  local native = uv.pipe_t.new()
  local backing = StreamStdio(native:as_stream_t(), native:as_handle_t(), nil, nil)
  local stream = Stdio(StdioBacking.stream(backing), loop, nil, 0)
  if packet == nil then return stream end
  native = uv.pipe_t.from_transfer_payload(packet)
  local adopted = false
  defer if not adopted then uv.close(native:as_handle_t()) end
  backing.native = native:as_stream_t()
  backing.handle = native:as_handle_t()
  adopted = true
  return stream
end

--- Move an idle captured output pipe, or copy a stable stdout/stderr facade.
-- The caller owns exactly-once payload delivery and recovery after detachment.
-- The child Process and its exit watcher remain in the originating Runtime.
-- @usage standard-library-os.md#transferring-process-streams
function OutputStream:to_transfer_payload(): string
  local stream? = self.handle
  if self.parent_descriptor >= 0 then
    if stream ~= nil and stream.pending_writes ~= 0 then
      raise "stream has a pending write"
    end
    return protobuf.serialize_fields(output_transfer_fields, self.parent_descriptor, nil)
  end
  local native_packet: string? = nil
  if stream ~= nil then
    stream_transfer_preflight(stream, false)
    if not stream:is_closed() then native_packet = stdio_native_payload(stream) end
  end
  self.handle = nil
  local exported = false
  defer if not exported and native_packet ~= nil then
    uv.pipe_t.discard_transfer_payload(native_packet)
  end
  local payload = protobuf.serialize_fields(output_transfer_fields, -1, native_packet)
  exported = true
  return payload
end

--- Reconstruct an output facade or adopt its captured pipe on this Runtime.
-- @usage standard-library-os.md#transferring-process-streams
function OutputStream.from_transfer_payload(payload: string): OutputStream
  local descriptor: integer, native: string? =
    protobuf.deserialize_fields(payload, output_transfer_fields)
  if descriptor == 1 or descriptor == 2 then
    if native ~= nil then raise "invalid standard output transfer payload" end
    return OutputStream(nil, descriptor)
  end
  if descriptor ~= -1 then raise "invalid output stream descriptor" end
  local result = OutputStream(nil, -1)
  if native ~= nil then result.handle = restored_stdio(native) end
  return result
end

--- Move an idle captured input pipe together with buffered bytes and outcome.
-- Unused standard-input facades copy descriptor identity. A pending native
-- read, reader reservation, or write is rejected before changing the source.
-- @usage standard-library-os.md#transferring-process-streams
function InputStream:to_transfer_payload(): string
  local stream? = self.handle
  local terminal_kind = 3
  local failure: async.OperationError? = nil
  local initial: {string} = {}
  if self.parent_descriptor >= 0 then
    if #self.excess ~= 0 or (stream ~= nil and stream.reads ~= nil) then
      raise "standard input has active or buffered read state"
    end
    return protobuf.serialize_fields(input_transfer_fields,
      self.parent_descriptor, self.excess, terminal_kind, nil, nil, initial)
  end
  local native_packet: string? = nil
  if stream ~= nil then
    stream_transfer_preflight(stream, true)
    local reads? = stream.reads
    if reads ~= nil then
      local batch, terminal? = reads:snapshot_pending()
      if terminal == nil then terminal_kind = 0
      else
        case terminal
        when error(reason) then
          terminal_kind = 2
          failure = reason
        when ended() then terminal_kind = 1
        when closed() then
        when item() then raise "invalid input stream terminal outcome"
        end
      end
      for index = 1, batch.count do initial[index] = batch:get(index) end
    elseif not stream:is_closed() then terminal_kind = 0 end
    if not stream:is_closed() then
      case stream.backing
      when stream(backing) then
        if reads ~= nil then check_status(uv.read_stop(backing.native), "stdio.transfer.read_stop") end
        do
          native_packet = stdio_native_payload(stream)
        catch
          if reads ~= nil and not backing:is_closed() then
            backing:resume_read("stdio.transfer.read_resume")
          end
          raise
        end
      when file() then
        raise "only pipe streams support native handoff"
      end
    end
  end
  local excess = self.excess
  self.handle = nil
  self.excess = ""
  local exported = false
  defer if not exported and native_packet ~= nil then
    uv.pipe_t.discard_transfer_payload(native_packet)
  end
  local payload = protobuf.serialize_fields(input_transfer_fields,
    -1, excess, terminal_kind, failure, native_packet, initial)
  exported = true
  return payload
end

--- Reconstruct buffered input and adopt its optional pipe on this Runtime.
-- @usage standard-library-os.md#transferring-process-streams
function InputStream.from_transfer_payload(payload: string): InputStream
  local descriptor: integer, excess: string, terminal_kind: integer,
    failure: async.OperationError?, native: string?, initial: {string} =
    protobuf.deserialize_fields(payload, input_transfer_fields)
  if terminal_kind < 0 or terminal_kind > 3 or
      (terminal_kind == 2) ~= (failure ~= nil) then
    raise "invalid input stream terminal payload"
  end
  if descriptor == 0 then
    if #excess ~= 0 or native ~= nil or #initial ~= 0 or terminal_kind ~= 3 then
      raise "invalid standard input transfer payload"
    end
    return InputStream(nil, 0, "")
  end
  if descriptor ~= -1 then raise "invalid input stream descriptor" end
  local terminal: async.SubscriptionResult<|string, async.OperationError|>? = nil
  if terminal_kind == 1 then terminal = async.SubscriptionResult<|string, async.OperationError|>.ended()
  elseif terminal_kind == 2 then terminal = async.SubscriptionResult<|string, async.OperationError|>.error(failure)
  elseif terminal_kind == 3 then terminal = async.SubscriptionResult<|string, async.OperationError|>.closed()
  end
  local result = InputStream(nil, -1, excess)
  local stream = restored_stdio(native)
  local published = false
  defer if not published then discard_unpublished_stdio(stream) end
  if terminal == nil and stream:is_closed() then
    raise "live input stream transfer has no pipe"
  end
  start_stream_read(stream, "stdio.transfer.read_start", initial, terminal)
  result.handle = stream
  published = true
  return result
end
