local uv = import "uv"
local str = import "string"

-- Portable operating-system helpers. The low-level uv module owns every C
-- type and libuv call; this facade exposes only ordinary Titan values.

record ExitStatus
  code: integer
  signal: string?
  signal_number: integer
end

record InputStream
  local handle: uv.uv_process_t
end

record OutputStream
  local handle: uv.uv_process_t
  local stdout: boolean
  local excess: string
  local reading: boolean
end

-- The exact private uv wrapper makes each public process/pipe record
-- unforgeable outside this module without converting its native handle
-- through value on every method call. Pipes retain the handle directly,
-- avoiding a Process/pipe reference cycle.
record Process
  local handle: uv.uv_process_t
  stdin: InputStream
  stdout: OutputStream
  stderr: OutputStream
end

local function join_chunks(chunks: {string}, first: integer,
                           last: integer): string
  if first > last then return "" end
  if first == last then return chunks[first] as string end
  local middle = first + (last - first) // 2
  return join_chunks(chunks, first, middle) ..
         join_chunks(chunks, middle + 1, last)
end

local function begin_read(stream: OutputStream, subject: string)
  if stream.reading then
    raise "Process " .. subject .. " already has a reader"
  end
  stream.reading = true
end

-- This helper runs only while the corresponding stdout/stderr reader lock is
-- held. Each output pipe has independent retained excess and native state.
local function read_unlocked(stream: OutputStream): string?
  if #stream.excess > 0 then
    local result = stream.excess
    stream.excess = ""
    return result
  end
  if stream.stdout then
    return uv._os_process_read_stdout(stream.handle)
  end
  return uv._os_process_read_stderr(stream.handle)
end

local function restore_chunks(stream: OutputStream, chunks: {string},
                              count: integer)
  if count > 0 then
    stream.excess = join_chunks(chunks, 1, count) .. stream.excess
  end
end

local function read_output(stream: OutputStream,
                           subject: string): string?
  begin_read(stream, subject)
  local result: string? = nil
  do
    result = read_unlocked(stream)
  finally
    stream.reading = false
  end
  return result
end

local function read_output_until(stream: OutputStream, subject: string,
                                 delimiter: string,
                                 chop: boolean?): string?
  if #delimiter == 0 then raise "read delimiter must not be empty" end

  begin_read(stream, subject)
  local chunks: {string} = {}
  local count = 0
  local total = 0
  local tail = ""
  local result: string? = nil
  local finished = false
  do
    while not finished do
      local maybe_chunk: string? = nil
      local terminal_error_tail = false
      do
        maybe_chunk = read_unlocked(stream)
      catch
        if total > 0 and
            uv._os_process_read_error_is(
              stream.handle, stream.stdout, error) then
          terminal_error_tail = true
        else
          raise
        end
      end

      if terminal_error_tail then
        result = join_chunks(chunks, 1, count)
        finished = true
      elseif not maybe_chunk then
        if total > 0 then result = join_chunks(chunks, 1, count) end
        finished = true
      else
        local chunk = maybe_chunk as string
        if #chunk == 0 then
          raise "process read returned an empty non-EOF chunk"
        end

        count = count + 1
        chunks[count] = chunk
        local boundary = tail .. chunk
        local match: integer? = str.find(boundary, delimiter)
        total = total + #chunk
        if match then
          local match_end =
            total - #boundary + (match as integer) - 1 + #delimiter
          local result_end = match_end
          if chop then result_end = result_end - #delimiter end
          local all = join_chunks(chunks, 1, count)
          local selected = str.sub(all, 1, result_end)
          local remaining = str.sub(all, match_end + 1)
          result = selected
          stream.excess = remaining .. stream.excess
          finished = true
        else
          local keep = #delimiter - 1
          if keep > #boundary then keep = #boundary end
          tail = str.sub(boundary, #boundary - keep + 1)
        end
      end
    end
  catch
    restore_chunks(stream, chunks, count)
    raise
  finally
    stream.reading = false
  end
  return result
end

function getenv(name: string): string?
  return uv._os_getenv(name)
end

function setenv(name: string, contents: string)
  uv._os_setenv(name, contents)
end

function unsetenv(name: string)
  uv._os_unsetenv(name)
end

function cwd(): string
  return uv._os_cwd()
end

function chdir(path: string)
  uv._os_chdir(path)
end

function homedir(): string
  return uv._os_homedir()
end

function tmpdir(): string
  return uv._os_tmpdir()
end

function hostname(): string
  return uv._os_hostname()
end

function exepath(): string
  return uv._os_exepath()
end

function pid(): integer
  return uv._os_pid()
end

function ppid(): integer
  return uv._os_ppid()
end

function spawn(file: string, args: {string}): Process
  local handle = uv._os_process_spawn(file, args)
  return Process.new(
    handle,
    InputStream.new(handle),
    OutputStream.new(handle, true, "", false),
    OutputStream.new(handle, false, "", false))
end

function Process:wait(): ExitStatus
  local code, signal_number = uv._os_process_wait(self.handle)
  return ExitStatus.new(code, uv._os_signal_name(signal_number),
                        signal_number)
end

function Process:kill(signal: string)
  uv._os_process_kill(self.handle, signal)
end

function InputStream:write(data: string)
  uv._os_process_write_stdin(self.handle, data)
end

function InputStream:close()
  uv._os_process_close_stdin(self.handle)
end

function OutputStream:read(): string?
  local subject = "stderr"
  if self.stdout then subject = "stdout" end
  return read_output(self, subject)
end

function OutputStream:read_until(delimiter: string,
                                 chop: boolean?): string?
  local subject = "stderr"
  if self.stdout then subject = "stdout" end
  return read_output_until(self, subject, delimiter, chop)
end

function communicate(file: string, args: {string},
                     input: string?): (string, string, ExitStatus)
  local stdout, stderr, code, signal_number =
    uv._os_communicate(file, args, input)
  return stdout, stderr,
         ExitStatus.new(code, uv._os_signal_name(signal_number),
                        signal_number)
end

function wait_signal(name: string): string
  return uv._os_wait_signal(name)
end
