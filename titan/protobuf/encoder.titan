--- Optimistic traversal of a single live value graph.
-- @module titan.protobuf

-- `active` holds the reflective frames of this root (shared with every
-- reflective subtree a generated codec hands back to); `path` holds the
-- enclosing generated frames. Together they are the complete active path. A
-- generated root's handoffs reuse one Encoder, setting `path` to the handing
-- frame's path for the duration of each field.
local record Encoder
  const active: {value: boolean}
  const context: value
  path: foreign const *TitanCodecPath
end

local function Encoder:enter(candidate: value)
  if self.active[candidate] or ffi.titan_codec_path_has(self.path, candidate) ~= 0 then
    raise "protobuf: cyclic object graph"
  end
  self.active[candidate] = true
end

-- The structural branch for a nominal with a generated codec: the same nested
-- message, depth, cycle, and handoff rules, with the shared root state. The
-- generated frames below hand their fields back to this same Encoder.
local function Encoder:generated(
    buf: foreign *titan_protobuf_buffer,
    codec: foreign const *TitanTransferCodec,
    number: integer,
    candidate: value,
    depth: integer)
  local resources: foreign TValue = resource_codecs as value
  local context: foreign TValue = self.context
  local active: foreign TValue = self.active as value
  local encoder: foreign TValue = self as value
  local handoff: foreign TValue = codec_handoff_entry
  local raw: foreign TValue = candidate
  if codec_trace ~= nil then codec_trace:enter_generated() end
  ffi.titan_codec_encode_field(L, resources, context, active, encoder, handoff, buf,
      self.path, codec, raw, number, depth)
  if codec_trace ~= nil then codec_trace:leave_generated() end
end

local function Encoder:record_value(
    buf: foreign *titan_protobuf_buffer,
    candidate: reflect.RecordValue,
    depth: integer)
  require_depth(depth)
  if not (self.context is PortableCodec) then require_record(candidate.type) end
  self:enter(candidate.value)
  defer self.active[candidate.value] = nil
  for index = 1, #candidate.type.fields do
    local field = candidate.type.fields[index]
    trace_member(field.name)
    self:field(buf, field_number(index), candidate:project(index),
               field.type, depth + 1)
    trace_leave()
  end
end

local function Encoder:union_value(
    buf: foreign *titan_protobuf_buffer,
    candidate: reflect.UnionValue,
    depth: integer)
  require_depth(depth)
  if not (self.context is PortableCodec) then require_union(candidate.type) end
  self:enter(candidate.value)
  defer self.active[candidate.value] = nil
  for index = 1, #candidate.type.variants do
    local variant = candidate.type.variants[index]
    if variant.tag == candidate.tag then
      local mark = begin_nested(buf, field_number(index))
      for part = 1, #variant.parts do
        local part_type = variant.parts[part]
        trace_member(part_type.name)
        self:field(buf, field_number(part), candidate:project(part),
                   part_type.type, depth + 1)
        trace_leave()
      end
      end_nested(buf, mark)
      return
    end
  end
  raise "protobuf: private union variant"
end

local function Encoder:array(
    buf: foreign *titan_protobuf_buffer,
    candidate: value,
    element: reflect.Type,
    depth: integer)
  require_depth(depth)
  self:enter(candidate)
  defer self.active[candidate] = nil
  local entries: const? {value}, is_const_arr: boolean =
    (function (candidate: value): (const? {value}, boolean)
      case reflect.inspect(candidate)
      when is_array(entries) then return entries, false
      when is_const_array(entries) then return entries, true
      else raise "protobuf: expected a Titan Array"
      end
    end)(candidate)
  for index = 1, #entries do
    trace_index(index)
    local item: value = entries[index]
    local slot_mark = begin_nested(buf, 1)
    -- A missing Array slot is legal independently of its element descriptor.
    if item ~= nil then self:field(buf, 1, item, element, depth + 1) end
    end_nested(buf, slot_mark)
    trace_leave()
  end
  write_key(buf, 2, 0)
  if is_const_arr then write_varint(buf, 1) else write_varint(buf, 0) end
end

local function Encoder:foreign_array(
    buf: foreign *titan_protobuf_buffer,
    candidate: value,
    element: reflect.Type,
    depth: integer)
  require_depth(depth)
  local entries: const {value} = candidate
  for index = 1, #entries do
    trace_index(index)
    local slot_mark = begin_nested(buf, 1)
    self:field(buf, 1, entries[index], element, depth + 1)
    end_nested(buf, slot_mark)
    trace_leave()
  end
end

local function Encoder:foreign_struct(
    buf: foreign *titan_protobuf_buffer,
    candidate: value,
    descriptor: reflect.ForeignStructType,
    depth: integer)
  require_depth(depth)
  require_struct(descriptor)
  local fields: const {value} = candidate
  for index = 1, #descriptor.fields do
    local field = descriptor.fields[index]
    trace_member(field.name)
    if field.is_flexible_array then raise "protobuf: flexible foreign array" end
    self:field(buf, field_number(index), fields[index], field.type, depth + 1)
    trace_leave()
  end
end

local function Encoder:value_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, depth: integer)
  -- Nil is absent; anything else is one nested TitanValue message.
  if candidate ~= nil then
    local mark = begin_nested(buf, number)
    self:dynamic(buf, candidate, depth)
    end_nested(buf, mark)
  end
end

local function Encoder:array_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, element: reflect.Type, depth: integer)
  local mark = begin_nested(buf, number)
  self:array(buf, candidate, element, depth)
  end_nested(buf, mark)
end

local function inspected_record(candidate: value, expected: string): reflect.RecordValue
  case reflect.inspect(candidate)
  when is_record(actual) then
    if actual.type.name ~= expected then raise "protobuf: record type mismatch" end
    return actual
  else raise "protobuf: expected a record"
  end
end

local function Encoder:resource_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, name: string, codec: ResourceCodec)
  if self.context is PortableCodec then
    raise "protobuf: " .. name .. " is a packet resource and is not portable"
  end
  encode_resource_field(buf, codec, number, candidate, self.context)
end

local function Encoder:hook_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    actual: reflect.RecordValue, encode: reflect.MethodType)
  self:enter(actual.value)
  defer self.active[actual.value] = nil
  if codec_trace ~= nil then return end
  local payload = encode_transfer_payload(
      actual.value, encode, "protobuf: cyclic object graph")
  write_bytes(buf, number, payload)
end

local function Encoder:record_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, expected: reflect.RecordType, depth: integer)
  local codec? = find_resource_codec_by_name(expected.name)
  if codec ~= nil then
    self:resource_field(buf, number, candidate, expected.name, codec)
    return
  end
  local generated = find_field_codec(candidate, expected.name, false)
  if generated ~= nil then
    self:generated(buf, generated, number, candidate, depth)
    return
  end
  local actual = inspected_record(candidate, expected.name)
  local encode? = trace_checked_hooks(expected)
  if encode ~= nil then
    self:hook_field(buf, number, actual, encode)
  else
    local mark = begin_nested(buf, number)
    self:record_value(buf, actual, depth)
    end_nested(buf, mark)
  end
end

local function Encoder:union_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, expected: reflect.UnionType, depth: integer)
  local generated = find_field_codec(candidate, expected.name, true)
  if generated ~= nil then
    self:generated(buf, generated, number, candidate, depth)
    return
  end
  case reflect.inspect(candidate)
  when is_union(actual) then
    if actual.type.name ~= expected.name then raise "protobuf: union type mismatch" end
    local mark = begin_nested(buf, number)
    self:union_value(buf, actual, depth)
    end_nested(buf, mark)
  else raise "protobuf: expected a union"
  end
end

-- These arms do not recurse. Keep their conversions and wire temporaries out
-- of the traversal dispatcher, including the foreign scalar cases.
local function encode_scalar_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, descriptor: reflect.Type)
  case descriptor
  when is_nil() then
    if candidate ~= nil then raise "protobuf: expected nil" end
  when is_boolean() then
    local flag: boolean = candidate
    write_key(buf, number, 0)
    if flag then write_varint(buf, 1) else write_varint(buf, 0) end
  when is_integer() then
    local integer_value: integer = candidate
    write_key(buf, number, 0)
    write_varint(buf, zigzag(integer_value))
  when is_float() then
    local number_value: float = candidate
    write_double(buf, number, number_value)
  when is_string() then
    local bytes: string = candidate
    write_bytes(buf, number, bytes)
  when is_foreign_integer{spelling, is_signed, bits} then
    local integer_value: integer = candidate
    check_integer(integer_value, spelling, is_signed, bits)
    write_key(buf, number, 0)
    if is_signed then write_varint(buf, zigzag(integer_value))
    else write_varint(buf, integer_value)
    end
  when is_foreign_float(spelling) then
    if spelling == "long double" then
      local exact: string = candidate
      write_bytes(buf, number, exact)
      return
    end
    local number_value: float = candidate
    if spelling == "float" then
      write_float32(buf, number, number_value)
    elseif spelling == "double" then
      write_double(buf, number, number_value)
    else raise "protobuf: unsupported foreign floating type " .. spelling
    end
  when is_foreign_pointer() then
    local address = candidate as foreign *void
    local bits: integer = ffi.titan_protobuf_pointer_bits(address)
    write_fixed64(buf, number, bits)
  else raise "protobuf: unsupported field type"
  end
end

local function Encoder:struct_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, structure: reflect.ForeignStructType, depth: integer)
  local mark = begin_nested(buf, number)
  self:foreign_struct(buf, candidate, structure, depth)
  end_nested(buf, mark)
end

local function Encoder:foreign_array_field(
    buf: foreign *titan_protobuf_buffer, number: integer,
    candidate: value, element: reflect.Type, length: value, depth: integer)
  require_foreign_array(length)
  local mark = begin_nested(buf, number)
  self:foreign_array(buf, candidate, element, depth)
  end_nested(buf, mark)
end

local function encoding_field_type(candidate: value,
    descriptor: reflect.Type): (reflect.Type, boolean)
  local resolved = resolve_type(descriptor)
  while true do
    case resolved
    when is_option(base) then
      if candidate == nil then return resolved, true end
      resolved = resolve_type(base)
    else return resolved, false
    end
  end
end

-- Keep arm-specific temporaries out of this recursive frame. Options do not
-- consume another field frame at the same traversal depth.
-- Implementation notes: doc/implementation/protobuf-library.md#encoding
local function Encoder:field(
    buf: foreign *titan_protobuf_buffer,
    number: integer,
    candidate: value,
    descriptor: reflect.Type,
    depth: integer)
  require_depth(depth)
  local resolved, absent = encoding_field_type(candidate, descriptor)
  if absent then return end
  case resolved
  when is_value() then self:value_field(buf, number, candidate, depth)
  when is_array{elem_descriptor} then
    self:array_field(buf, number, candidate, elem_descriptor, depth)
  when is_record(expected) then
    self:record_field(buf, number, candidate, expected, depth)
  when is_union(expected) then
    self:union_field(buf, number, candidate, expected, depth)
  when is_foreign_struct(structure) then
    self:struct_field(buf, number, candidate, structure, depth)
  when is_foreign_array{elem_descriptor, len} then
    self:foreign_array_field(buf, number, candidate, elem_descriptor, len, depth)
  else encode_scalar_field(buf, number, candidate, resolved)
  end
end

local function Encoder:dynamic_scalar(
    buf: foreign *titan_protobuf_buffer, candidate: value,
    tag: foreign int, depth: integer)
  if tag == ffi.LUA_TBOOLEAN then
    self:field(buf, 1, candidate, dynamic_boolean, depth)
  elseif tag == ffi.LUA_TNUMBER then
    local raw: foreign TValue = candidate
    if ffi.lmacro_ttypetag(raw) == ffi.LUA_VNUMINT then
      self:field(buf, 2, candidate, dynamic_integer, depth)
    else
      self:field(buf, 3, candidate, dynamic_float, depth)
    end
  elseif tag == ffi.LUA_TSTRING then
    self:field(buf, 4, candidate, dynamic_string, depth)
  else raise "protobuf: unsupported dynamic value"
  end
end

-- One TitanValue arm for a non-nil dynamic value at the field's depth:
-- 1 boolean, 2 integer, 3 float, 4 string, 5 nominal, 6 Titan Array.
local function Encoder:dynamic(
    buf: foreign *titan_protobuf_buffer,
    candidate: value,
    depth: integer)
  local raw: foreign TValue = candidate
  local tag = ffi.lmacro_ttype(raw)
  if tag ~= ffi.LUA_TUSERDATA then
    self:dynamic_scalar(buf, candidate, tag, depth)
  else
    case reflect.inspect(candidate)
    when is_record(record_value) then
      self:dynamic_nominal(buf, candidate, record_value.type.name,
          reflect.Type.is_record(record_value.type), depth)
    when is_union(union_value) then
      self:dynamic_nominal(buf, candidate, union_value.type.name,
          reflect.Type.is_union(union_value.type), depth)
    when is_array() then
      local mark = begin_nested(buf, 6)
      self:array(buf, candidate, dynamic_value, depth)
      end_nested(buf, mark)
    when is_const_array() then
      local mark = begin_nested(buf, 6)
      self:array(buf, candidate, dynamic_value, depth)
      end_nested(buf, mark)
    else raise "protobuf: unsupported dynamic value"
    end
  end
end

-- The header is complete before recursion starts; its metadata and portable
-- membership checks need no retained frame at each nominal level.
local function Encoder:begin_dynamic_nominal(
    buf: foreign *titan_protobuf_buffer, candidate: value, name: string): integer
  if self.context is PortableCodec then
    (self.context as PortableCodec):nominal(name)
  end
  local raw: foreign TValue = candidate
  local module = ffi.titan_codec_nominal_module(raw)
  if module == nil then raise "protobuf: unsupported dynamic value" end
  local mark = begin_nested(buf, 5)
  write_bytes(buf, 1, module as string)
  write_bytes(buf, 2, name)
  return mark
end

-- The declaring module and qualified name, then exactly the bytes a field of
-- that nominal type carries: its message, hook payload, or resource index.
local function Encoder:dynamic_nominal(
    buf: foreign *titan_protobuf_buffer,
    candidate: value,
    name: string,
    descriptor: reflect.Type,
    depth: integer)
  local mark = self:begin_dynamic_nominal(buf, candidate, name)
  self:field(buf, 3, candidate, descriptor, depth)
  end_nested(buf, mark)
end

