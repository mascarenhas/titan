--- Bounded wire parsing and fresh nominal reconstruction.
-- @module titan.protobuf

local record WireReader
  const base: foreign const *uint8_t
  const limit: integer
  position: integer
end

-- Implementation notes: doc/implementation/protobuf-library.md#decoding
local record Message
  const base: foreign const *uint8_t
  const holder: string?
  const context: value
  const first: foreign titan_protobuf_field
  entries: (owned titan_protobuf_field[])?
  count: integer
  index: (owned uint32_t[])?
end

local function WireReader:varint(): integer
  local bits = 0
  for index = 0, 9 do
    if self.position >= self.limit then raise "protobuf: truncated varint" end
    const byte: integer = self.base[self.position]
    self.position = self.position + 1
    if index == 9 and byte > 1 then raise "protobuf: varint overflow" end
    bits = bits | ((byte & 127) << (index * 7))
    if byte < 128 then return bits end
  end
  raise "protobuf: varint overflow"
end

local function WireReader:take(count: integer): integer
  if count < 0 or count > self.limit - self.position then
    raise "protobuf: truncated field"
  end
  const offset = self.position
  self.position = self.position + count
  return offset
end

local function WireReader:key(): (integer, integer)
  const key = self:varint()
  if key < 0 or key > 4294967295 then raise "protobuf: invalid field key" end
  const number = key >> 3
  const wire = key & 7
  if number == 0 then raise "protobuf: field number zero" end
  return number, wire
end

local function WireReader:field(number: integer, wire: integer,
                                 depth: integer): (integer, integer, integer)
  if wire == 0 then return self:varint(), 0, 0 end
  if wire == 1 then return 0, self:take(8), 8 end
  if wire == 2 then
    const count = self:varint()
    if count < 0 or count > 2147483647 then raise "protobuf: invalid byte length" end
    return 0, self:take(count), count
  end
  if wire == 5 then return 0, self:take(4), 4 end
  if wire == 3 then
    require_depth(depth)
    while self.position < self.limit do
      local nested_number, nested_wire = self:key()
      if nested_wire == 4 then
        if nested_number ~= number then raise "protobuf: mismatched end group" end
        return 0, 0, 0
      end
      self:field(nested_number, nested_wire, depth + 1)
    end
    raise "protobuf: unterminated group"
  end
  raise "protobuf: invalid wire type"
end

-- Borrowed entry addresses stay valid after parsing: directory growth finishes
-- before decoding, and every reader keeps the owning Message reachable.
local function Message:entry(index: integer): foreign *titan_protobuf_field
  if index == 1 then return self.first end
  const entries: owned titan_protobuf_field[] = self.entries
  return (entries as foreign *titan_protobuf_field) + (index - 2)
end

local function Message:append(number: integer, wire: integer, bits: integer,
                               offset: integer, length: integer)
  if self.count == 1 then
    const entries: owned titan_protobuf_field[] = foreign titan_protobuf_field.new_array(4)
    self.entries = entries
  elseif self.count > 1 and self.count - 1 == #self.entries then
    const populated: owned titan_protobuf_field[] = self.entries
    const entries: owned titan_protobuf_field[] =
        foreign titan_protobuf_field.new_array((self.count - 1) * 2)
    ffi.memcpy(entries, populated,
        ((self.count - 1) * foreign titan_protobuf_field.sizeof) as foreign size_t)
    self.entries = entries
  end
  self.count = self.count + 1
  const entry = self:entry(self.count)
  entry.number = number
  entry.wire = wire
  entry.bits = bits
  entry.offset = offset
  entry.length = length
end

local function read_message_slice(
    base: foreign const *uint8_t,
    offset: integer,
    length: integer,
    holder: string?, context: value): Message
  const reader = WireReader(base, offset + length, offset)
  const message = Message {
    base = base, holder = holder, context = context,
    first = foreign titan_protobuf_field.new(), entries = nil, count = 0, index = nil,
  }
  while reader.position < reader.limit do
    local number, wire = reader:key()
    local bits, start, count = reader:field(number, wire, 1)
    message:append(number, wire, bits, start, count)
  end
  return message
end

-- A generated decoder hands the reflective field decoder one field's latest
-- occurrence instead of its whole message. decode_field reads only the latest
-- occurrence of its number, so a Message holding just that entry (or none, for
-- an absent field) decodes the field exactly as the parsed message would; a
-- repeated field, which merges, reparses its message instead. One such
-- Message serves every handed-off field of one decoding frame.
local function occurrence_message(base: foreign const *uint8_t, holder: string?,
                                  context: value): Message
  return Message {
    base = base, holder = holder, context = context,
    first = foreign titan_protobuf_field.new(), entries = nil, count = 0, index = nil,
  }
end

local function Message:hold_occurrence(number: integer, count: integer, wire: integer,
                                       bits: integer, offset: integer, length: integer)
  self.count = count
  if count == 0 then return end
  const entry = self:entry(1)
  entry.number = number
  entry.wire = wire
  entry.bits = bits
  entry.offset = offset
  entry.length = length
  entry.previous = 0
  entry.chain = 0
end

-- The sparse index heads one chain per bucket with 1-based entry ordinals,
-- zero being the empty sentinel. A chain links only the latest entry of each
-- distinct field number, so a probe visits only numbers sharing its bucket and
-- adversarial tags cannot build clusters across buckets. Capacity depends on
-- entry count, never numeric tags.
local function index_bucket(number: integer, buckets: owned uint32_t[]): integer
  return ((number ~ (number >> 16)) * 2654435761) & (#buckets - 1)
end

-- Returns the latest ordinal for `number`, or zero, and its chain predecessor,
-- or zero at the bucket head.
local function Message:chained(number: integer, head: integer): (integer, integer)
  local before = 0
  local current = head
  while current ~= 0 do
    const field = self:entry(current)
    if field.number == number then return current, before end
    before = current
    current = field.chain
  end
  return 0, before
end

local function Message:last_index(number: integer): integer
  if self.count == 0 then return 0 end
  if self.count == 1 then
    if self.first.number == number then return 1 end
    return 0
  end
  local buckets? = self.index
  if buckets == nil then
    -- Ordered-only readers need no index; the load factor stays at most 1/2.
    local capacity = 4
    while capacity < self.count * 2 do capacity = capacity * 2 end
    buckets = foreign uint32_t.new_array(capacity)
    for index = 1, self.count do
      const field = self:entry(index)
      const bucket = index_bucket(field.number, buckets)
      local current, before = self:chained(field.number, buckets[bucket])
      field.previous = current
      if current == 0 then
        field.chain = buckets[bucket]
        buckets[bucket] = index
      else
        -- The latest occurrence takes over the earlier one's chain position.
        field.chain = self:entry(current).chain
        if before == 0 then
          buckets[bucket] = index
        else
          const predecessor = self:entry(before)
          predecessor.chain = index
        end
      end
    end
    self.index = buckets
  end
  return (self:chained(number, buckets[index_bucket(number, buckets)]))
end

local function Message:last(number: integer): foreign *titan_protobuf_field
  const index = self:last_index(number)
  if index == 0 then return nil end
  return self:entry(index)
end

local function require_wire(field: foreign const *titan_protobuf_field, expected: integer)
  if field.wire ~= expected then raise "protobuf: unexpected wire type" end
end

-- Wire type 5 carries an IEEE-754 single as four little-endian bytes.
local function read_float32(base: foreign const *uint8_t, offset: integer): float
  const low: integer = base[offset]
  const second: integer = base[offset + 1]
  const third: integer = base[offset + 2]
  const high: integer = base[offset + 3]
  const bits = (low | (second << 8) | (third << 16) | (high << 24)) as foreign uint32_t
  local single: foreign float = 0.0
  ffi.memcpy(single, bits, foreign float.sizeof)
  return single
end

-- Singular embedded messages merge across repeated occurrences. Scalars use
-- the final occurrence, as required by the Protocol Buffers wire contract.
-- The merged bytes of one embedded field: its base, offset, length, and the
-- string owning them, after the same wire checks in the same order.
local function Message:merged_slice(
    number: integer): (foreign const *uint8_t, integer, integer, string?)
  local index = self:last_index(number)
  if index == 0 then return self.base, 0, 0, self.holder end
  local field = self:entry(index)
  require_wire(field, 2)
  if field.previous == 0 then
    return self.base, field.offset, field.length, self.holder
  end
  -- Walk only this field's occurrences, then restore wire encounter order.
  const chunks: {integer} = {}
  while index ~= 0 do
    field = self:entry(index)
    require_wire(field, 2)
    chunks[#chunks + 1] = index
    index = field.previous
  end
  const output = string.writer()
  for part = #chunks, 1, -1 do
    const chunk = self:entry(chunks[part])
    output:write(slice_to_string(self.base, chunk.offset, chunk.length))
  end
  const merged = output:drain()
  return merged, 0, #merged, merged
end

local function Message:merged_message(number: integer): Message
  local base, offset, length, holder? = self:merged_slice(number)
  return read_message_slice(base, offset, length, holder, self.context)
end

-- The structural branch for an embedded nominal with a generated codec.
local function Message:generated_nominal(number: integer,
    codec: foreign const *TitanTransferCodec, metatable: value, depth: integer): value
  local base, offset, length, holder? = self:merged_slice(number)
  return decode_generated(codec, metatable, base + offset, length, self.context,
      holder, depth)
end

-- Each result below is a standalone `local frozen = ... as const {value}` of a
-- fresh builder local, or of decode_array_entries' linear call result, so the
-- checker retags the proxy in place instead of shallow-copying it. A cast nested
-- in a call argument or an implicitly converted return would copy instead.
-- Visibility and constructor lookup finish before either field traversal.
local function Message:record_constructor(descriptor: reflect.RecordType):
    PortableConstructor?
  if self.context is PortableCodec then
    if not descriptor.all_public then
      return (self.context as PortableCodec):record_constructor(descriptor)
    end
  else
    require_record(descriptor)
  end
  return nil
end

local function decode_record_fields(message: Message, descriptor: reflect.RecordType,
    depth: integer): value
  const fields: {value} = {}
  for index = 1, #descriptor.fields do
    const field = descriptor.fields[index]
    trace_member(field.name)
    fields[index] = decode_field(message, field_number(index), field.type, depth + 1)
    trace_leave()
  end
  if trace_incomplete() then return nil end
  const frozen = fields as const {value}
  return descriptor:construct(frozen)
end

-- Bare record roots have no field arm. Recursive fields select their traversal
-- directly, without retaining this root selector alongside the fields loop.
local function decode_record(message: Message, descriptor: reflect.RecordType,
    depth: integer): value
  require_depth(depth)
  const constructor? = message:record_constructor(descriptor)
  if constructor ~= nil then return constructor:decode_record(message, descriptor, depth) end
  return decode_record_fields(message, descriptor, depth)
end

local function Message:union_variant(descriptor: reflect.UnionType):
    (reflect.VariantType, Message)
  local selected = 0
  local selected_field = 0
  local extra_chunks: {integer}? = nil
  for index = 1, self.count do
    const field = self:entry(index)
    const ordinal = field_ordinal(field.number)
    if ordinal >= 1 and ordinal <= #descriptor.variants then
      require_wire(field, 2)
      if selected ~= ordinal then
        selected = ordinal
        selected_field = index
        extra_chunks = nil
      else
        if extra_chunks == nil then
          extra_chunks = {selected_field}
        end
        extra_chunks[#extra_chunks + 1] = index
      end
    end
  end
  if selected == 0 then
    raise "protobuf: union has no recognized variant"
  end
  const variant = descriptor.variants[selected]
  if extra_chunks ~= nil then
    const payload = string.writer()
    for index = 1, #extra_chunks do
      const chunk = self:entry(extra_chunks[index])
      payload:write(slice_to_string(self.base, chunk.offset, chunk.length))
    end
    const merged = payload:drain()
    return variant, read_message_slice(merged, 0, #merged, merged, self.context)
  end
  const field = self:entry(selected_field)
  return variant, read_message_slice(
      self.base, field.offset, field.length, self.holder, self.context)
end

local function decode_union(message: Message, descriptor: reflect.UnionType,
                             depth: integer): value
  require_depth(depth)
  if not (message.context is PortableCodec) then require_union(descriptor) end
  local variant, parts_message = message:union_variant(descriptor)
  const parts: {value} = {}
  for index = 1, #variant.parts do
    const part = variant.parts[index]
    trace_member(part.name)
    parts[index] = decode_field(parts_message, field_number(index), part.type, depth + 1)
    trace_leave()
  end
  if trace_incomplete() then return nil end
  const frozen = parts as const {value}
  return descriptor:construct(variant.tag, frozen)
end

-- Elements decode in wire order, and every constness flag occurrence is
-- validated in that same walk. The linear result lets a const caller freeze it.
local function decode_array_entries(message: Message, element: reflect.Type,
                                    depth: integer): {value}
  const entries: {value} = {}
  local count = 0
  for index = 1, message.count do
    const field = message:entry(index)
    if field.number == 1 then
      trace_index(count + 1)
      require_wire(field, 2)
      count = count + 1
      const slot = read_message_slice(
          message.base, field.offset, field.length, message.holder, message.context)
      if slot:last(1) ~= nil then
        entries[count] = decode_field(slot, 1, element, depth + 1)
      end
      trace_leave()
    elseif field.number == 2 then
      require_wire(field, 0)
      if field.bits ~= 0 and field.bits ~= 1 then raise "protobuf: invalid boolean" end
    end
  end
  return entries
end

-- The final flag occurrence wins. Reading it before the element walk only
-- selects the result shape; decode_array_entries still rejects a malformed
-- occurrence at its wire position before any Array is returned.
local function Message:marks_const_array(): boolean
  for index = self.count, 1, -1 do
    const field = self:entry(index)
    if field.number == 2 then return field.bits == 1 end
  end
  return false
end

local function decode_array(message: Message, constness: reflect.ArrayTypeConstness,
                             element: reflect.Type, depth: integer): value
  require_depth(depth)
  case constness
  when is_mutable() then return decode_array_entries(message, element, depth)
  when is_maybe_const() then
    if not message:marks_const_array() then
      return decode_array_entries(message, element, depth)
    end
  end
  const frozen = decode_array_entries(message, element, depth) as const {value}
  return frozen
end

local function decode_foreign_array(message: Message, element: reflect.Type,
                                     depth: integer): value
  require_depth(depth)
  const entries: {value} = {}
  local count = 0
  for index = 1, message.count do
    const field = message:entry(index)
    if field.number == 1 then
      trace_index(count + 1)
      require_wire(field, 2)
      count = count + 1
      const slot = read_message_slice(
          message.base, field.offset, field.length, message.holder, message.context)
      entries[count] = decode_field(slot, 1, element, depth + 1)
      trace_leave()
    end
  end
  const frozen = entries as const {value}
  return frozen
end

local function decode_foreign_struct(message: Message,
                                      descriptor: reflect.ForeignStructType,
                                      depth: integer): value
  require_depth(depth)
  require_struct(descriptor)
  const fields: {value} = {}
  for index = 1, #descriptor.fields do
    const field = descriptor.fields[index]
    trace_member(field.name)
    fields[index] = decode_field(message, field_number(index), field.type, depth + 1)
    trace_leave()
  end
  const frozen = fields as const {value}
  return frozen
end

local function Message:value_field(number: integer, depth: integer): value
  return decode_dynamic(self:merged_message(number), depth)
end

local function Message:array_field(number: integer,
    constness: reflect.ArrayTypeConstness, element: reflect.Type,
    depth: integer): value
  return decode_array(self:merged_message(number), constness, element, depth)
end

local function Message:resource_field(field: foreign *titan_protobuf_field,
    name: string, codec: ResourceCodec): value
  require_wire(field, 2)
  if self.context is PortableCodec then
    raise "protobuf: " .. name .. " is a packet resource and is not portable"
  end
  if codec_trace ~= nil then
    codec_trace:skip_value()
    return nil
  end
  return codec.decode(self.context,
      (self.base + field.offset) as foreign const *void, field.length)
end

local function Message:hook_field(field: foreign *titan_protobuf_field,
    record_type: reflect.RecordType, decode: reflect.StaticFunctionType): value
  require_wire(field, 2)
  if codec_trace ~= nil then
    codec_trace:skip_value()
    return nil
  end
  const restored: value = decode.callable(
      slice_to_string(self.base, field.offset, field.length))
  case reflect.inspect(restored)
  when is_record(record_value) then
    if record_value.type.name == record_type.name then return restored end
  end
  raise "protobuf: record type mismatch"
end

-- Try codec-backed paths before reflective traversal. If none handles the
-- record, their lookup and invocation temporaries do not survive into a child.
-- The flag distinguishes a skipped callback's nil from an unhandled record.
local function Message:record_codec(number: integer,
    field: foreign *titan_protobuf_field, record_type: reflect.RecordType,
    depth: integer): (boolean, value)
  const codec? = find_resource_codec_by_name(record_type.name)
  if codec ~= nil then
    return true, self:resource_field(field, record_type.name, codec)
  end
  local _?, decode? = trace_checked_hooks(record_type)
  if decode ~= nil then return true, self:hook_field(field, record_type, decode) end
  local generated, metatable = find_named_codec(record_type.name, 0)
  if generated ~= nil then
    return true, self:generated_nominal(number, generated, metatable, depth)
  end
  return false, nil
end

local function Message:record_field(number: integer,
    field: foreign *titan_protobuf_field, record_type: reflect.RecordType,
    depth: integer): value
  local handled, restored = self:record_codec(number, field, record_type, depth)
  if handled then return restored end
  const message = self:merged_message(number)
  require_depth(depth)
  const constructor? = message:record_constructor(record_type)
  if constructor ~= nil then return constructor:decode_record(message, record_type, depth) end
  return decode_record_fields(message, record_type, depth)
end

local function Message:union_field(number: integer,
    union_type: reflect.UnionType, depth: integer): value
  local generated, metatable = find_named_codec(union_type.name, 1)
  if generated ~= nil then
    return self:generated_nominal(number, generated, metatable, depth)
  end
  return decode_union(self:merged_message(number), union_type, depth)
end

-- Foreign composites use a secondary dispatch, leaving only the four common
-- recursive shapes in decode_field. Scalar conversions finish here too.
local function Message:other_field(number: integer,
    field: foreign *titan_protobuf_field, descriptor: reflect.Type,
    depth: integer): value
  case descriptor
  when is_nil() then
    self:merged_message(number)
    return nil
  when is_boolean() then
    require_wire(field, 0)
    if field.bits ~= 0 and field.bits ~= 1 then raise "protobuf: invalid boolean" end
    return field.bits == 1
  when is_integer() then
    require_wire(field, 0)
    return unzigzag(field.bits)
  when is_float() then
    require_wire(field, 1)
    return ffi.titan_protobuf_read_double(self.base, field.offset as foreign size_t)
  when is_string() then
    require_wire(field, 2)
    return slice_to_string(self.base, field.offset, field.length)
  when is_foreign_integer{spelling, is_signed, bits} then
    require_wire(field, 0)
    local result = field.bits
    if is_signed then result = unzigzag(result) end
    check_integer(result, spelling, is_signed, bits)
    return result
  when is_foreign_float(spelling) then
    if spelling == "long double" then
      require_wire(field, 2)
      return slice_to_string(self.base, field.offset, field.length)
    elseif spelling == "float" then
      require_wire(field, 5)
      return read_float32(self.base, field.offset)
    elseif spelling == "double" then
      require_wire(field, 1)
      return ffi.titan_protobuf_read_double(self.base, field.offset as foreign size_t)
    end
    raise "protobuf: unsupported foreign floating type " .. spelling
  when is_foreign_pointer() then
    require_wire(field, 1)
    const bits: integer = ffi.titan_protobuf_read_fixed64(
        self.base, field.offset as foreign size_t)
    const address = ffi.titan_protobuf_bits_pointer(bits)
    const recovered: integer = ffi.titan_protobuf_pointer_bits(address)
    if recovered ~= bits then raise "protobuf: pointer address out of range" end
    return address
  when is_foreign_struct(structure) then
    return decode_foreign_struct(self:merged_message(number), structure, depth)
  when is_foreign_array{elem_descriptor, len} then
    require_foreign_array(len)
    return decode_foreign_array(self:merged_message(number), elem_descriptor, depth)
  else raise "protobuf: unsupported field type"
  end
end

-- Resolve aliases before looking up the wire field, then unwrap Options and
-- handle absence in a frame that returns before the value graph is descended.
local function Message:resolved_field(number: integer, descriptor: reflect.Type):
    (reflect.Type, foreign *titan_protobuf_field, boolean)
  local resolved = resolve_type(descriptor)
  const field = self:last(number)
  while true do
    case resolved
    when is_option(base) then
      if field == nil then return resolved, field, true end
      resolved = resolve_type(base)
    else break
    end
  end
  if field == nil then
    case resolved
    when is_nil() then return resolved, field, true
    when is_value() then return resolved, field, true
    end
    raise "protobuf: missing required field " .. number
  end
  return resolved, field, false
end

-- Options reuse this frame; each arm owns its temporaries in a separate
-- callee so the recursive traversal does not reserve every arm's C locals.
local function decode_field(message: Message, number: integer,
                              descriptor: reflect.Type, depth: integer): value
  require_depth(depth)
  local resolved, field, absent = message:resolved_field(number, descriptor)
  if absent then return nil end
  case resolved
  when is_value() then return message:value_field(number, depth)
  when is_array{is_const, elem_descriptor} then
    return message:array_field(number, is_const, elem_descriptor, depth)
  when is_record(record_type) then
    return message:record_field(number, field, record_type, depth)
  when is_union(union_type) then
    return message:union_field(number, union_type, depth)
  else return message:other_field(number, field, resolved, depth)
  end
end

-- A TitanValue message: its last recognized arm selects the value; with no
-- recognized arm it is nil. Arms decode with the ordinary field rules.
local function Message:dynamic_arm(): integer
  local selected = 0
  for index = 1, self.count do
    const number: integer = self:entry(index).number
    if number >= 1 and number <= 6 then selected = number end
  end
  return selected
end

local function Message:dynamic_scalar(selected: integer, depth: integer): value
  local descriptor = dynamic_boolean
  if selected == 2 then descriptor = dynamic_integer
  elseif selected == 3 then descriptor = dynamic_float
  elseif selected == 4 then descriptor = dynamic_string
  end
  return decode_field(self, selected, descriptor, depth)
end

local function decode_dynamic(message: Message, depth: integer): value
  const selected = message:dynamic_arm()
  if selected == 0 then return nil end
  if selected <= 4 then
    return message:dynamic_scalar(selected, depth)
  elseif selected == 5 then
    return decode_dynamic_nominal(message:merged_message(5), depth)
  end
  return decode_array(message:merged_message(6), dynamic_constness, dynamic_value, depth)
end

-- Identity parsing and lookup finish before the recursive payload call. This
-- includes portable membership checks, without a second forwarding frame.
local function Message:dynamic_descriptor(depth: integer): reflect.Type
  const module: string = decode_field(self, 1, dynamic_string, depth)
  const name: string = decode_field(self, 2, dynamic_string, depth)
  if self.context is PortableCodec then
    return (self.context as PortableCodec):nominal(name).descriptor
  end
  local found? = reflect.find_nominal(name)
  if found == nil and self.context ~= nil and nominal_loader ~= nil and codec_trace == nil then
    nominal_loader(module, name)
    found = reflect.find_nominal(name)
  end
  if found == nil then raise "protobuf: unknown nominal type " .. name end
  case found
  when is_record(record_type) then return reflect.Type.is_record(record_type)
  when is_union(union_type) then return reflect.Type.is_union(union_type)
  end
  raise "protobuf: nominal kind mismatch for " .. name
end

-- Resolve the qualified name, loading its module only inside a packet decode
-- (a transfer-installed loader with a carried context), then decode the
-- payload exactly as a field of that nominal type.
local function decode_dynamic_nominal(message: Message, depth: integer): value
  return decode_field(message, 3, message:dynamic_descriptor(depth), depth)
end
