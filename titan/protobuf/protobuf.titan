--- Schema-directed Protocol Buffers encoding of public Titan record and union graphs.
-- @module titan.protobuf
-- @usage standard-library-protobuf.md

local reflect = import "reflect"
local string = import "string"
foreign import "lua.h"
foreign import "titan/ffi.h"
foreign import "native.h"

local function field_number(ordinal: integer): integer
  if ordinal >= 19000 then return ordinal + 1000 end
  return ordinal
end

local function field_ordinal(number: integer): integer
  if number >= 20000 then return number - 1000 end
  if number >= 19000 then return 0 end
  return number
end

local function require_depth(depth: integer)
  if depth > 128 then raise "protobuf: nesting exceeds 128 levels" end
end

local function resolve_type(descriptor: reflect.Type): reflect.Type
  local current = descriptor
  for index = 1, 128 do
    case current
    when is_named(named) then
      local found? = reflect.find_nominal(named.name)
      if found == nil then raise "protobuf: unknown nominal type " .. named.name end
      current = named:resolve()
    when is_foreign_named(named) then current = named:resolve()
    when is_foreign_typedef{target_descriptor} then current = target_descriptor
    else return current
    end
  end
  raise "protobuf: cyclic type alias"
end

local record HookEntry
  const has_hooks: boolean
  const encode: reflect.MethodType?
  const decode: reflect.StaticFunctionType?
end

local hook_cache: {string: HookEntry} = {}
local active_record_payloads: {value: boolean} = {}

local function is_string_descriptor(descriptor: reflect.Type?): boolean
  if descriptor == nil then return false end
  case descriptor
  when is_string() then return true
  else return false
  end
end

local function is_named_record_descriptor(descriptor: reflect.Type?, name: string): boolean
  if descriptor == nil then return false end
  case descriptor
  when is_named(named) then return named.name == name
  when is_record(record_type) then return record_type.name == name
  when is_union(union_type) then return union_type.name == name
  else return false
  end
end

--- Validate and return optional to_transfer_payload and from_transfer_payload hooks for a record.
-- @param descriptor Reflected record type to inspect.
-- @param prefix Diagnostic prefix ("protobuf" or "transfer") for validation errors.
-- @return Validated encode method and decode static function, or (nil, nil) when absent.
-- @usage standard-library-protobuf.md#custom-record-transfer-hooks
function find_transfer_hooks(
    descriptor: reflect.RecordType,
    prefix: string): (reflect.MethodType?, reflect.StaticFunctionType?)
  local cached? = hook_cache[descriptor.name]
  if cached ~= nil then
    if not cached.has_hooks then return nil, nil end
    return cached.encode, cached.decode
  end
  local encode: reflect.MethodType? = nil
  local decode: reflect.StaticFunctionType? = nil
  for index = 1, #descriptor.methods do
    local method = descriptor.methods[index]
    if method.name == "to_transfer_payload" then
      encode = method
    elseif method.name == "from_transfer_payload" then
      raise prefix .. ": from_transfer_payload must be a static function on " .. descriptor.name
    end
  end
  for index = 1, #descriptor.statics do
    local static = descriptor.statics[index]
    if static.name == "from_transfer_payload" then
      decode = static
    elseif static.name == "to_transfer_payload" then
      raise prefix .. ": to_transfer_payload must be an instance method on " .. descriptor.name
    end
  end
  if encode == nil and decode == nil then
    hook_cache[descriptor.name] = HookEntry(false, nil, nil)
    return nil, nil
  end
  if encode == nil or decode == nil then
    raise prefix .. ": record requires both transfer payload hooks: " .. descriptor.name
  end
  if not descriptor.is_public then
    raise prefix .. ": record payload hooks require a public record: " .. descriptor.name
  end
  if #encode.param_descriptors ~= 0 or encode.vararg_descriptor ~= nil
      or #encode.return_descriptors ~= 1 or encode.flexret_descriptor ~= nil
      or not is_string_descriptor(encode.return_descriptors[1]) then
    raise prefix .. ": invalid to_transfer_payload signature on " .. descriptor.name
  end
  if #decode.param_descriptors ~= 1 or decode.vararg_descriptor ~= nil
      or not is_string_descriptor(decode.param_descriptors[1])
      or #decode.return_descriptors ~= 1 or decode.flexret_descriptor ~= nil
      or not is_named_record_descriptor(decode.return_descriptors[1], descriptor.name) then
    raise prefix .. ": invalid from_transfer_payload signature on " .. descriptor.name
  end
  hook_cache[descriptor.name] = HookEntry(true, encode, decode)
  return encode, decode
end

--- Invoke a record's to_transfer_payload hook under the shared active-record recursion guard.
-- @param candidate Record instance being serialized.
-- @param encode Validated to_transfer_payload method descriptor.
-- @param err_msg Diagnostic message raised if candidate is already active.
-- @return Custom payload bytes returned by the hook.
-- @usage standard-library-protobuf.md#custom-record-transfer-hooks
function encode_transfer_payload(
    candidate: value,
    encode: reflect.MethodType,
    err_msg: string): string
  if active_record_payloads[candidate] then raise err_msg end
  active_record_payloads[candidate] = true
  defer active_record_payloads[candidate] = nil
  local payload: string = encode.callable(candidate)
  return payload
end

local function check_message_size(length: integer)
  if length < 0 or length > 2147483647 then
    raise "protobuf: message exceeds 2 GiB"
  end
end

local function require_record(descriptor: reflect.RecordType)
  if not descriptor.is_public or not descriptor.all_public then
    raise "protobuf: record must be public with only public fields: " .. descriptor.name
  end
end

local function require_union(descriptor: reflect.UnionType)
  if not descriptor.is_public or not descriptor.all_public then
    raise "protobuf: union must be public with only public variants: " .. descriptor.name
  end
end

local function require_struct(descriptor: reflect.ForeignStructType)
  if not descriptor.is_complete or descriptor.has_fam then
    raise "protobuf: foreign struct must be complete without a flexible array"
  end
end

local function require_foreign_array(length: value)
  if length == nil or length == "" then
    raise "protobuf: foreign array requires a fixed extent"
  end
end

local function check_integer(number: integer, spelling: string,
                              signed: boolean, bits: integer)
  if bits < 1 or bits > 64 then raise "protobuf: unsupported foreign integer width" end
  if spelling == "_Bool" or spelling == "bool" then
    if number ~= 0 and number ~= 1 then raise "protobuf: foreign boolean out of range" end
  end
  if bits < 64 then
    if signed then
      local maximum = (1 << (bits - 1)) - 1
      if number < -maximum - 1 or number > maximum then
        raise "protobuf: signed integer out of range"
      end
    elseif number < 0 or number > (1 << bits) - 1 then
      raise "protobuf: unsigned integer out of range"
    end
  end
end

local function make_key(number: integer, wire: integer): integer
  if number < 1 or number > 536870911 then raise "protobuf: too many fields" end
  return (number << 3) | wire
end

local function write_varint(buf: foreign *titan_protobuf_buffer, bits: integer)
  if ffi.titan_protobuf_buf_write_varint(buf, bits) == 0 then
    raise "protobuf: out of memory"
  end
end

local function write_key(buf: foreign *titan_protobuf_buffer, number: integer, wire: integer)
  write_varint(buf, make_key(number, wire))
end

local function write_bytes(buf: foreign *titan_protobuf_buffer, number: integer, bytes: string)
  check_message_size(#bytes)
  if ffi.titan_protobuf_buf_write_bytes(
      buf, make_key(number, 2), bytes, #bytes as foreign size_t) == 0 then
    raise "protobuf: out of memory"
  end
end

local function write_fixed64(buf: foreign *titan_protobuf_buffer, number: integer, bits: integer)
  if ffi.titan_protobuf_buf_write_fixed64(buf, make_key(number, 1), bits) == 0 then
    raise "protobuf: out of memory"
  end
end

local function write_double(buf: foreign *titan_protobuf_buffer, number: integer, number_value: float)
  if ffi.titan_protobuf_buf_write_double(buf, make_key(number, 1), number_value) == 0 then
    raise "protobuf: out of memory"
  end
end

local function write_float32(buf: foreign *titan_protobuf_buffer, number: integer, number_value: float)
  if ffi.titan_protobuf_buf_write_float32(buf, make_key(number, 5), number_value) == 0 then
    raise "protobuf: out of memory"
  end
end

local function begin_nested(buf: foreign *titan_protobuf_buffer, number: integer): integer
  local mark: integer = ffi.titan_protobuf_buf_begin_nested(buf, make_key(number, 2))
  if mark < 0 then
    raise "protobuf: out of memory"
  end
  return mark
end

local function end_nested(buf: foreign *titan_protobuf_buffer, mark: integer)
  local rc: integer = ffi.titan_protobuf_buf_end_nested(buf, mark)
  if rc == 0 then raise "protobuf: out of memory" end
  if rc < 0 then raise "protobuf: message exceeds 2 GiB" end
end

local function slice_to_string(
    base: foreign const *uint8_t,
    offset: integer,
    length: integer): string
  if length <= 0 then return "" end
  local top = ffi.lua_gettop(L)
  if ffi.lua_checkstack(L, 1) == 0 then raise "protobuf: cannot reserve Lua stack" end
  ffi.lua_pushlstring(
      L,
      ffi.titan_protobuf_offset_ptr(base, offset as foreign size_t),
      length as foreign size_t)
  local result: value = ffi.lua_totvalue(L, -1)
  ffi.lua_settop(L, top)
  return result as string
end

local function buffer_to_string(buf: foreign *titan_protobuf_buffer): string
  return slice_to_string(buf.data, 0, buf.length as integer)
end

local function zigzag(number: integer): integer
  if number < 0 then return ~(number << 1) end
  return number << 1
end

local function unzigzag(number: integer): integer
  return (number >> 1) ~ -(number & 1)
end

--- Append the wire encoding of a public record or union instance to an initialized titan_protobuf_buffer.
-- @param buf Pointer to an initialized titan_protobuf_buffer.
-- @param candidate Public record or union instance to traverse.
-- @usage standard-library-protobuf.md#api
function serialize_to_buffer(buf: foreign *void, candidate: value)
  local pbuf = buf as foreign *titan_protobuf_buffer
  local start = pbuf.length as integer
  local encoder = Encoder({})
  case reflect.inspect(candidate)
  when is_record(record_value) then encoder:record_value(pbuf, record_value, 1)
  when is_union(union_value) then encoder:union_value(pbuf, union_value, 1)
  else raise "protobuf: root must be a public record or union"
  end
  check_message_size((pbuf.length as integer) - start)
end

--- Serialize a public record or union instance, rejecting cycles and unsupported encountered values.
-- @param candidate Public record or union instance to traverse.
-- @return Protocol Buffers wire bytes for the root message.
-- @usage standard-library-protobuf.md#api
function serialize(candidate: value): string
  local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
  ffi.titan_protobuf_buf_init_heap(buf, 0)
  defer ffi.titan_protobuf_buf_free_heap(buf)
  serialize_to_buffer(buf as foreign *void, candidate)
  return buffer_to_string(buf)
end

local function deserialize_buffer(
    data: foreign const *void,
    length: integer,
    descriptor: reflect.Type): value
  check_message_size(length)
  local resolved = resolve_type(descriptor)
  local base = data as foreign const *uint8_t
  case resolved
  when is_record(record_type) then
    require_record(record_type)
    local message = read_message_slice(base, 0, length, nil)
    return decode_record(message, record_type, 1)
  when is_union(union_type) then
    require_union(union_type)
    local message = read_message_slice(base, 0, length, nil)
    return decode_union(message, union_type, 1)
  else raise "protobuf: root descriptor must be a public record or union"
  end
end

--- Decode a record or union using its initialized nominal descriptor and raw construction.
-- @param bytes Protocol Buffers wire bytes for the root message.
-- @param descriptor Registered public record or union descriptor.
-- @return Fresh nominal value and recursively copied fields.
-- @usage standard-library-protobuf.md#api
function deserialize(bytes: string, descriptor: reflect.Type): value
  -- bytes remains rooted on the caller stack throughout deserialize_buffer.
  return deserialize_buffer(
      ffi.titan_protobuf_bytes_ptr(bytes) as foreign const *void,
      #bytes,
      descriptor)
end

--- Append the wire encoding of an anonymous root message to an initialized titan_protobuf_buffer.
-- @param buf Pointer to an initialized titan_protobuf_buffer.
-- @param fields One declared type per field, in wire field-number order.
-- @param ... Exactly one value per field, including explicit nil values.
-- @usage standard-library-protobuf.md#anonymous-messages
function serialize_fields_to_buffer(
    buf: foreign *void,
    fields: const {reflect.Type},
    ...: value)
  if #... ~= #fields then raise "protobuf: anonymous field count mismatch" end
  local pbuf = buf as foreign *titan_protobuf_buffer
  local start = pbuf.length as integer
  local encoder = Encoder({})
  for index = 1, #fields do
    encoder:field(pbuf, field_number(index), ...[index], fields[index], 2)
  end
  check_message_size((pbuf.length as integer) - start)
end

--- Encode an anonymous root message using an explicit ordered field schema.
-- The descriptor stays with the caller; only the encoded values enter the packet.
-- Nested nominal values retain the ordinary public-field requirements.
-- @param fields One declared type per field, in wire field-number order.
-- @param ... Exactly one value per field, including explicit nil values.
-- @return Protocol Buffers wire bytes for the anonymous message.
-- @usage standard-library-protobuf.md#anonymous-messages
function serialize_fields(fields: const {reflect.Type}, ...: value): string
  local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
  ffi.titan_protobuf_buf_init_heap(buf, 0)
  defer ffi.titan_protobuf_buf_free_heap(buf)
  serialize_fields_to_buffer(buf as foreign *void, fields, ...)
  return buffer_to_string(buf)
end

--- Decode an anonymous message from a raw byte buffer using an ordered field schema.
-- @param data Pointer to the raw Protocol Buffers wire bytes.
-- @param length Byte length of the wire buffer.
-- @param fields The caller's ordered field types; no nominal lookup is needed for the root.
-- @return Exactly one result per declared field, preserving nil positions.
-- @usage standard-library-protobuf.md#anonymous-messages
function deserialize_fields_buffer(
    data: foreign const *void,
    length: integer,
    fields: const {reflect.Type}): (...: value)
  check_message_size(length)
  local message = read_message_slice(
      data as foreign const *uint8_t, 0, length, nil)
  local values: {value} = {}
  for index = 1, #fields do
    values[index] = decode_field(message, field_number(index), fields[index], 2)
  end
  return ...values[1, #fields]
end

--- Decode an anonymous message using the same ordered schema as its encoder.
-- @param bytes Protocol Buffers wire bytes for the anonymous message.
-- @param fields The caller's ordered field types; no nominal lookup is needed for the root.
-- @return Exactly one result per declared field, preserving nil positions.
-- @usage standard-library-protobuf.md#anonymous-messages
function deserialize_fields(bytes: string, fields: const {reflect.Type}): (...: value)
  -- bytes remains rooted on the caller stack throughout deserialize_fields_buffer.
  return deserialize_fields_buffer(
      ffi.titan_protobuf_bytes_ptr(bytes) as foreign const *void,
      #bytes,
      fields)
end

--- Resolve an initialized nominal type by name and decode it from a raw byte buffer.
-- @param data Pointer to the raw Protocol Buffers wire bytes.
-- @param length Byte length of the wire buffer.
-- @param name Fully qualified nominal name already registered in this state.
-- @param is_union True for a union, false for a record.
-- @return Fresh nominal value of the requested kind.
-- @usage standard-library-protobuf.md#api
function deserialize_nominal_buffer(
    data: foreign const *void,
    length: integer,
    name: string,
    is_union: boolean): value
  local found? = reflect.find_nominal(name)
  if found == nil then raise "protobuf: unknown nominal type " .. name end
  case found
  when is_record(descriptor) then
    if not is_union then
      return deserialize_buffer(data, length, reflect.Type.is_record(descriptor))
    end
  when is_union(descriptor) then
    if is_union then
      return deserialize_buffer(data, length, reflect.Type.is_union(descriptor))
    end
  end
  raise "protobuf: nominal kind mismatch for " .. name
end

--- Resolve an initialized nominal type by name for cross-state transfer decoding.
-- @param bytes Protocol Buffers wire bytes for the root message.
-- @param name Fully qualified nominal name already registered in this state.
-- @param is_union True for a union, false for a record.
-- @return Fresh nominal value of the requested kind.
-- @usage standard-library-protobuf.md#api
function deserialize_nominal(bytes: string, name: string, is_union: boolean): value
  -- bytes remains rooted on the caller stack throughout deserialize_nominal_buffer.
  return deserialize_nominal_buffer(
      ffi.titan_protobuf_bytes_ptr(bytes) as foreign const *void,
      #bytes,
      name,
      is_union)
end

--- Render a complete proto3 schema describing the public record or union wire format.
-- @param descriptor Public root record or union descriptor.
-- @return A complete, pretty-printed proto3 schema with deterministic identifiers.
-- @usage standard-library-protobuf.md#wire-mapping
function schema(descriptor: reflect.Type): string
  local builder = Schema({}, string.writer())
  local resolved = resolve_type(descriptor)
  case resolved
  when is_record() then
  when is_union() then
  else raise "protobuf: root descriptor must be a public record or union"
  end
  builder.output:write("syntax = \"proto3\";\n\n")
  builder:type_name(resolved, "Root", 1)
  return builder.output:drain()
end
