--- Weak Maps, reachability finalizers, and whole-state Lua collector controls.
-- @module titan.gc
-- @usage standard-library-gc.md

foreign import "lua.h"
foreign import "stddef.h"
foreign import "titan/ffi.h"

-- Implementation notes: doc/implementation/gc-library.md#direct-collector-control
local function require_gc_result(result: foreign int): integer
  if result < 0 then
    raise "garbage collector operation is unavailable"
  end
  return result
end

-- Implementation notes: doc/implementation/gc-library.md#weak-mode-stack-ledger
local function set_weak_mode(map: {value: value}, mode: string)
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 4) == 0 then
    raise "cannot reserve Lua stack for weak-map configuration"
  end

  ffi.lua_pushtvalue(L, map)
  if ffi.lua_getmetatable(L, -1) == 0 then
    local metatable: {string: value} = {
      ["__mode"] = mode,
    }
    ffi.lua_pushtvalue(L, metatable)
    ffi.lua_setmetatable(L, -2)
  else
    -- Preserve the exact existing metatable and change only its raw __mode
    -- field. Raw assignment cannot invoke a metatable-of-metatable callback.
    ffi.lua_pushtvalue(L, "__mode")
    ffi.lua_pushtvalue(L, mode)
    ffi.lua_rawset(L, -3)
  end
end

--- Make Map values weak by updating its shared metatable in place.
-- @param map Map whose __mode is set to v.
-- @usage standard-library-gc.md
function weak(map: {value: value})
  set_weak_mode(map, "v")
end

--- Give a Map weak keys with Lua ephemeron semantics.
-- @param map Map whose shared metatable __mode is set to k.
-- @usage standard-library-gc.md
function ephemeron(map: {value: value})
  set_weak_mode(map, "k")
end

--- Attach a nondeterministic reachability finalizer to a table or full userdata.
-- @param v Value to mark for finalization; existing metatable fields are preserved.
-- @param f Callback over the exact value type; it must not yield or collect.
-- @usage standard-library-gc.md
function finalizable<|T|>(v: T, f: function (T): ()): ()
  -- Implementation notes: doc/implementation/gc-library.md#finalizer-stack-ledger
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 4) == 0 then
    raise "cannot reserve Lua stack for finalizer configuration"
  end

  ffi.lua_pushtvalue(L, v)
  local value_type = ffi.lua_type(L, -1)
  if value_type ~= ffi.LUA_TTABLE and
     value_type ~= ffi.LUA_TUSERDATA then
    raise "gc.finalizable expects a table or full userdata"
  end

  if ffi.lua_getmetatable(L, -1) == 0 then
    local metatable: {string: value} = {
      ["__gc"] = f,
    }
    ffi.lua_pushtvalue(L, metatable)
  else
    -- Preserve the exact existing metatable. Raw assignment avoids invoking a
    -- metatable-of-metatable callback, while reinstalling that same metatable
    -- makes Lua mark an already-created value as finalizable.
    ffi.lua_pushtvalue(L, "__gc")
    ffi.lua_pushtvalue(L, f)
    ffi.lua_rawset(L, -3)
  end
  ffi.lua_setmetatable(L, -2)
end

--- Keep a value reachable for the garbage collector through this call point.
-- @param v Value kept live at least until the call; direct calls emit no C call.
-- @usage standard-library-gc.md
function keep_alive<|T|>(v: T)
  -- Implementation notes: doc/implementation/gc-library.md#keep-alive-intrinsic
end

--- Stop automatic garbage collection for the complete Lua state.
-- @usage standard-library-gc.md
function pause()
  require_gc_result(ffi.lua_gc(L, ffi.LUA_GCSTOP))
end

--- Restart automatic garbage collection for the complete Lua state.
-- @usage standard-library-gc.md
function resume()
  require_gc_result(ffi.lua_gc(L, ffi.LUA_GCRESTART))
end

--- Report whether automatic garbage collection is stopped.
-- @return True when the collector is paused.
-- @usage standard-library-gc.md
function paused(): boolean
  return require_gc_result(
    ffi.lua_gc(L, ffi.LUA_GCISRUNNING)) == 0
end

--- Perform a complete garbage-collection cycle.
-- @usage standard-library-gc.md
function collect()
  require_gc_result(ffi.lua_gc(L, ffi.LUA_GCCOLLECT))
end

--- Perform one collector step with a nonnegative size.
-- @param size Step size; nil selects zero.
-- @return True when an incremental cycle or generational major collection finishes.
-- @usage standard-library-gc.md
function step(size: integer?): boolean
  local amount = 0
  if size then amount = size end
  if amount < 0 then
    raise "garbage collector step size must be non-negative"
  end
  return require_gc_result(ffi.lua_gc(
    L, ffi.LUA_GCSTEP, amount as foreign size_t)) ~= 0
end

--- Switch the collector to incremental mode.
-- @return True if it was already incremental.
-- @usage standard-library-gc.md
function incremental(): boolean
  return require_gc_result(
    ffi.lua_gc(L, ffi.LUA_GCINC)) == ffi.LUA_GCINC
end

--- Switch the collector to generational mode.
-- @return True if it was already generational.
-- @usage standard-library-gc.md
function generational(): boolean
  return require_gc_result(
    ffi.lua_gc(L, ffi.LUA_GCGEN)) == ffi.LUA_GCGEN
end

--- Query current Lua-managed memory use in bytes.
-- @return Integer byte count for the complete Lua state.
-- @usage standard-library-gc.md
function count(): integer
  local kilobytes = require_gc_result(
    ffi.lua_gc(L, ffi.LUA_GCCOUNT))
  local remaining_bytes = require_gc_result(
    ffi.lua_gc(L, ffi.LUA_GCCOUNTB))
  return kilobytes * 1024 + remaining_bytes
end

local function parameter(which: foreign int,
                         setting: integer?): integer
  local configured = -1 as foreign int
  if setting then
    local supplied = setting as integer
    if supplied < 0 or supplied > 100000 then
      raise "garbage collector parameter must be between 0 and 100000"
    end
    configured = supplied as foreign int
  end
  return require_gc_result(ffi.lua_gc(
    L, ffi.LUA_GCPARAM, which, configured))
end

--- Query or set the generational minor multiplier.
-- @param setting New value in 0..100000, or nil to query; Lua may compress the value.
-- @return Previous parameter value.
-- @usage standard-library-gc.md
function minormul(setting: integer?): integer
  return parameter(ffi.LUA_GCPMINORMUL, setting)
end

--- Query or set the generational major-to-minor threshold.
-- @param setting New value in 0..100000, or nil to query; Lua may compress the value.
-- @return Previous parameter value.
-- @usage standard-library-gc.md
function majorminor(setting: integer?): integer
  return parameter(ffi.LUA_GCPMAJORMINOR, setting)
end

--- Query or set the generational minor-to-major threshold.
-- @param setting New value in 0..100000, or nil to query; Lua may compress the value.
-- @return Previous parameter value.
-- @usage standard-library-gc.md
function minormajor(setting: integer?): integer
  return parameter(ffi.LUA_GCPMINORMAJOR, setting)
end

--- Query or set the incremental pause percentage.
-- @param setting New value in 0..100000, or nil to query; Lua may compress the value.
-- @return Previous parameter value.
-- @usage standard-library-gc.md
function pause_percent(setting: integer?): integer
  return parameter(ffi.LUA_GCPPAUSE, setting)
end

--- Query or set the incremental step multiplier.
-- @param setting New value in 0..100000, or nil to query; Lua may compress the value.
-- @return Previous parameter value.
-- @usage standard-library-gc.md
function stepmul(setting: integer?): integer
  return parameter(ffi.LUA_GCPSTEPMUL, setting)
end

--- Query or set the incremental step size.
-- @param setting New value in 0..100000, or nil to query; Lua may compress the value.
-- @return Previous parameter value.
-- @usage standard-library-gc.md
function stepsize(setting: integer?): integer
  return parameter(ffi.LUA_GCPSTEPSIZE, setting)
end
