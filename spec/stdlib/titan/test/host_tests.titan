local test = import "test"
local command = import "support.command.titan"
local runtime_test = import "support.runtime.titan"
local common = import "support.common.titan"
local fs = import "fs"
local string = import "string"
local math = import "math"

local function assert_outside_runner_probe(source: string, label: string)
  local output, why, code = command.lua(source)
  test.assert(why == "exit" and code == 0,
              label .. " failed: " .. output)
end

function test_outside_runner_publishes_documented_surface(
    _context: test.Context)
  assert_outside_runner_probe([==[
    local test = require "titan.test"
    assert(type(test) == "userdata")
    assert(type(test.testing) == "function")
    assert(type(test.verbose) == "function")
    assert(type(test.location) == "function")
    assert(type(test.skip) == "function")
    assert(type(test.assert) == "function")
    assert(type(test.Context) == "table")
    assert(type(test.Case) == "table")
    assert(type(test.Case.new) == "function")
    assert(type(test.Skip) == "table")
    assert(type(test.run) == "function")

    local private_names = {
      "Cleanup", "RegisteredTest", "runner_begin", "runner_end",
      "runner_new_context", "runner_take_subtests", "runner_take_cleanup",
      "runner_skip_reason", "runner_error_text", "runner_matches",
      "runner_trace_location",
    }
    for _, name in ipairs(private_names) do
      local ok, failure = pcall(function() return test[name] end)
      assert(not ok, name)
      assert(tostring(failure):find(
        "member '" .. name .. "' does not exist", 1, true),
        tostring(failure))
    end
  ]==], "outside-runner public-surface probe")
end

function test_outside_runner_reports_inactive_state(_context: test.Context)
  assert_outside_runner_probe([==[
    local test = require "titan.test"
    assert(test.testing() == false)
    assert(test.verbose() == false)
  ]==], "outside-runner inactive-state probe")
end

function test_public_runner_rejects_nested_runs_and_resets_state(
    _context: test.Context)
  runtime_test.run(function ()
    const workspace = fs.tmpname()
    fs.unlink(workspace)
    fs.mkdir(workspace)
    defer command.remove_tree(workspace)
    fs.write_file(workspace .. "/test_runner_api_app.titan",
                  fs.read_file("spec/fixtures/stdlib/titan/test_runner_api_app.titan"))
    local output, why, code = command.compile(workspace, "test_runner_api_app")
    test.assert(why == "exit" and code == 0,
                "public runner child compilation failed: " .. output)
    output, why, code = command.capture({
      command.program(workspace, "test_runner_api_app"),
    })
    test.assert(why == "exit" and code == 0,
                "public runner lifecycle probe failed: " .. output)
    test.assert(common.contains(output, "deliberate public runner failure"),
                "public runner omitted its rendered string failure: " .. output)
  end)
end

local function reported_hundredths(output: string, prefix: string,
                                   total: boolean): integer
  local expression = [[^ \(([0-9]+)[.]([0-9][0-9]) ms\)$]]
  if total then
    expression = [[^ \(([0-9]+)[.]([0-9][0-9]) ms total\)$]]
  end
  local found = false
  local duration = 0
  for row in string.gmatch(output, "([^\n]*)\n") do
    local line: string = row:group(1)
    -- Scan only LF-terminated rows of the complete runner report, dropping one
    -- CR immediately before that LF. Embedded or doubled CR stays in the row
    -- and fails the strict pattern; an unterminated final fragment is skipped.
    if string.sub(line, -1) == "\r" then line = string.sub(line, 1, -2) end
    if string.sub(line, 1, #prefix) == prefix then
      const match? = string.match(string.sub(line, #prefix + 1), expression)
      if match then
        test.assert(not found, "duplicate timed line: " .. prefix)
        found = true
        const whole: integer = math.tonumber(match:group(1))
        const fraction: integer = math.tonumber(match:group(2))
        duration = whole * 100 + fraction
      end
    end
  end
  test.assert(found, "missing two-decimal timing: " .. prefix .. "\n" .. output)
  return duration
end

function test_public_runner_reports_wall_times_and_owner_totals(
    context: test.Context)
  local output = ""
  local filtered = ""
  local zero = ""
  local empty = ""
  const boundary_prefix = "[       OK ] timing.fixture.case"
  test.assert(reported_hundredths(boundary_prefix .. " (1.25 ms)\n",
    boundary_prefix, false) == 125)
  test.assert(reported_hundredths(boundary_prefix .. " (1.25 ms)\r\n",
    boundary_prefix, false) == 125)
  for malformed in string.split(" (1.25 ms)\r\r\n| (1.2\r5 ms)\n| (1.25 ms)\r", "[|]") do
    common.assert_raises_contains(function ()
      reported_hundredths(boundary_prefix .. malformed, boundary_prefix, false)
    end, "missing two-decimal timing")
  end
  runtime_test.run(function ()
    const workspace = fs.tmpname()
    fs.unlink(workspace)
    fs.mkdir(workspace)
    defer command.remove_tree(workspace)
    fs.write_file(workspace .. "/test_runner_timing_app.titan",
      fs.read_file("spec/fixtures/stdlib/titan/test_runner_timing_app.titan"))
    local compiled, why, code = command.compile(workspace,
                                               "test_runner_timing_app")
    test.assert(why == "exit" and code == 0,
                "timing child compilation failed: " .. compiled)
    const program = command.program(workspace, "test_runner_timing_app")
    output, why, code = command.capture({program})
    test.assert(why == "exit" and code == 1,
                "timed failures changed the runner status: " .. output)
    filtered, why, code = command.capture({
      program, "--filter=^timing[.]alpha[.]parent$"
    })
    test.assert(why == "exit" and code == 0,
                "timed filtered run failed: " .. filtered)
    zero, why, code = command.capture({program, "--filter=^absent$"})
    test.assert(why == "exit" and code == 0,
                "zero-selection status changed: " .. zero)
    empty, why, code = command.capture({program, "--empty"})
    test.assert(why == "exit" and code == 0,
                "empty runner status changed: " .. empty)
  end)

  context:run("inclusive_body_descendants_and_cleanup", function (_: test.Context)
    const parent = reported_hundredths(output,
      "[       OK ] timing.alpha.parent", false)
    const child = reported_hundredths(output,
      "[       OK ] timing.alpha.parent.child", false)
    const grandchild = reported_hundredths(output,
      "[       OK ] timing.alpha.parent.child.grandchild", false)
    test.assert(grandchild >= 1000, "case clock excluded a wall-clock wait")
    test.assert(child >= grandchild + 3500,
                "child timing excluded its body or cleanup")
    test.assert(parent >= child + 4500,
                "parent timing excluded its body, descendants, or cleanup")
  end)
  context:run("failure_skip_and_uninvoked_children", function (_: test.Context)
    test.assert(reported_hundredths(output,
      "[  FAILED  ] timing.alpha.failed", false) >= 2000,
      "failure timing excluded body or cleanup")
    test.assert(reported_hundredths(output,
      "[  SKIPPED ] timing.beta.skipped (timed skip)", false) >= 2000,
      "skip timing excluded body or cleanup")
    test.assert(reported_hundredths(output,
      "[  FAILED  ] timing.beta.cleanup_failure", false) >= 1000,
      "cleanup failure omitted its wall time")
    test.assert(reported_hundredths(output,
      "[  SKIPPED ] timing.alpha.failed.never (parent failed)", false) == 0,
      "uninvoked failure child did not report zero time")
    test.assert(reported_hundredths(output,
      "[  SKIPPED ] timing.beta.skipped.never (parent skipped: timed skip)",
      false) == 0, "uninvoked skipped child did not report zero time")
    reported_hundredths(output, "[  SKIPPED ] timing.gamma.reasonless", false)
    test.assert(common.contains(output, "[==========] 10 tests ran.") and
                common.contains(output, "[  PASSED  ] 4 tests.") and
                common.contains(output, "[  SKIPPED ] 4 tests.") and
                common.contains(output, "[  FAILED  ] 2 tests."),
                "timing changed outcome accounting")
  end)
  context:run("interleaved_owner_and_independent_run_totals",
    function (_: test.Context)
      const alpha = reported_hundredths(output,
        "[----------] timing.alpha", true)
      const beta = reported_hundredths(output,
        "[----------] timing.beta", true)
      const gamma = reported_hundredths(output,
        "[----------] timing.gamma", true)
      const alpha_cases = reported_hundredths(output,
        "[       OK ] timing.alpha.parent", false) +
        reported_hundredths(output, "[  FAILED  ] timing.alpha.failed", false) +
        reported_hundredths(output, "[       OK ] timing.alpha.later", false)
      const beta_cases = reported_hundredths(output,
        "[  SKIPPED ] timing.beta.skipped (timed skip)", false) +
        reported_hundredths(output, "[  FAILED  ] timing.beta.cleanup_failure",
                            false)
      test.assert(math.abs(alpha - alpha_cases) <= 2 and
                  math.abs(beta - beta_cases) <= 1,
                  "owner total lost interleaved roots or counted children twice")
      const run = reported_hundredths(output, "[==========] 10 tests ran.", true)
      test.assert(run + 3 >= alpha + beta + gamma,
                  "run total did not span top-level intervals")
    end)
  context:run("selection_and_empty_runs", function (_: test.Context)
    const parent = reported_hundredths(filtered,
      "[       OK ] timing.alpha.parent", false)
    test.assert(parent >= 4000, "filtered parent excluded body or cleanup")
    test.assert(reported_hundredths(filtered,
      "[----------] timing.alpha", true) == parent,
      "filtered owner included unselected cases")
    test.assert(not common.contains(filtered, "[ RUN      ] timing.alpha.parent.child") and
                not common.contains(filtered, "[----------] timing.beta"),
                "timing changed independent child/owner selection")
    reported_hundredths(filtered, "[==========] 1 test ran.", true)
    reported_hundredths(zero, "[==========] 0 tests ran.", true)
    reported_hundredths(empty, "[==========] 0 tests ran.", true)
    test.assert(not common.contains(zero, "[----------]") and
                not common.contains(empty, "[----------]"),
                "empty run reported unexecuted owners")
  end)
end

function test_outside_runner_raises_readable_errors(_context: test.Context)
  assert_outside_runner_probe([==[
    local test = require "titan.test"
    local ok, failure = pcall(test.assert, false)
    assert(not ok and tostring(failure):find("assertion failed", 1, true),
           tostring(failure))
    ok, failure = pcall(test.assert, false, "outside assertion")
    assert(not ok and tostring(failure):find("outside assertion", 1, true),
           tostring(failure))
    ok, failure = pcall(test.skip, "outside skip")
    assert(not ok and tostring(failure):find(
      "test skipped: outside skip", 1, true), tostring(failure))
  ]==], "outside-runner error probe")
end

function test_outside_runner_defers_lua_helper_capture(
    _context: test.Context)
  assert_outside_runner_probe([==[
    local original_gmatch = string.gmatch
    string.gmatch = false
    local test = require "titan.test"
    string.gmatch = original_gmatch
    local filename, function_name, line = test.location()
    assert(filename == "<none>" and function_name == "<none>" and line == 0)
  ]==], "outside-runner deferred-helper probe")
end

function test_outside_runner_uses_location_sentinel(_context: test.Context)
  assert_outside_runner_probe([==[
    local test = require "titan.test"
    local filename, function_name, line = test.location()
    assert(filename == "<none>" and function_name == "<none>" and line == 0)
  ]==], "outside-runner location probe")
end

local type RuntimeBody = function (): ()

local function caught_runtime(body: RuntimeBody): (value, string)
  local failure: value = nil
  local failure_traceback = ""
  do
    runtime_test.run(body)
  catch
    failure = error
    failure_traceback = traceback
  end
  return failure, failure_traceback
end

local function cleanup_trace_origin()
  raise "cleanup-trace"
end

local function assert_cleanup_trace(context: test.Context, trace: string)
  test.assert(#trace > 0, "cleanup failure omitted its traceback")
  context:run("symbolic_frame", function (_: test.Context)
    test.assert(common.contains(trace, "cleanup_trace_origin"),
                "cleanup failure omitted its original frame")
  end)
end

function test_runtime_cleanup_failure_replaces_pass(context: test.Context)
  local failure, failure_traceback = caught_runtime(function ()
    runtime_test.cleanup(cleanup_trace_origin)
  end)
  test.assert(failure == "cleanup-trace",
              "cleanup failure did not replace a passing body")
  assert_cleanup_trace(context, failure_traceback)
end

function test_runtime_cleanup_failure_replaces_skip(context: test.Context)
  local failure, failure_traceback = caught_runtime(function ()
    runtime_test.cleanup(cleanup_trace_origin)
    test.skip("body skip")
  end)
  test.assert(failure == "cleanup-trace",
              "cleanup failure did not replace a skipped body")
  assert_cleanup_trace(context, failure_traceback)
end

function test_runtime_body_failure_precedes_cleanup_failure(
    _context: test.Context)
  local failure, _ = caught_runtime(function ()
    runtime_test.cleanup(function ()
      raise "cleanup-loses"
    end)
    raise "body-wins"
  end)
  test.assert(failure == "body-wins",
              "cleanup failure replaced the body failure")
end

function test_runtime_cleanup_rejects_skip(_context: test.Context)
  local failure, _ = caught_runtime(function ()
    runtime_test.cleanup(function ()
      test.skip("cleanup reason")
    end)
  end)
  test.assert(failure ==
              "test.skip cannot be called from async test cleanup: cleanup reason",
              "cleanup skip was not converted to a failure")
end

function test_runtime_cleanup_is_lifo_and_attempts_all(_context: test.Context)
  local order = ""
  local failure, _ = caught_runtime(function ()
    runtime_test.cleanup(function () order = order .. "first;" end)
    runtime_test.cleanup(function ()
      order = order .. "second;"
      raise "middle-cleanup"
    end)
    runtime_test.cleanup(function () order = order .. "third;" end)
  end)
  test.assert(order == "third;second;first;" and failure == "middle-cleanup",
              "Runtime cleanup did not remain LIFO and all-attempted")
end
