local test = import "test"

function test_caught_skip_exposes_structured_reason(_context: test.Context)
  local caught = false
  do
    test.skip("caught skip reason")
  catch
    test.assert(error is test.Skip, "skip omitted its nominal error type")
    local skip: test.Skip = error
    test.assert(skip.reason == "caught skip reason",
                "skip omitted its reason")
    caught = true
  end
  test.assert(caught, "skip did not raise")
end
