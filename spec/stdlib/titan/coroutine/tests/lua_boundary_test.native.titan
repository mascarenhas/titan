local command = import "support.command.titan"

local function assert_coroutine_lua_probe(source: string, label: string)
  local output, why, code = command.lua(source)
  test.assert(why == "exit" and code == 0,
              label .. " failed: " .. output)
end

function test_lua_host_roots_coroutine_payloads_and_tags_across_gc(
    _context: test.Context)
  assert_coroutine_lua_probe([==[
    local coroutine = require "titan.coroutine"
    collectgarbage("generational")

    local tag = {}
    local payload
    local marker
    local co = coroutine.create(function(argument)
      assert(argument == payload)
      collectgarbage("step")
      local received = coroutine.yield(marker, tag)
      assert(received == payload)
      return marker(received)
    end, tag)

    collectgarbage("collect")
    payload = { answer = 41 }
    marker = function(value) return value.answer + 1 end
    assert(co:status() == "suspended")
    assert(co:resume(payload, tag) == marker)
    payload.extra = {}
    for _ = 1, 50 do collectgarbage("step") end
    assert(co:resume(payload, tag) == 42)
    assert(co:status() == "dead")

    local numeric = coroutine.create(function(argument)
      local received = coroutine.yield("numeric", 1.0)
      return received
    end, 1)
    assert(numeric:resume(nil, 1) == "numeric")
    assert(numeric:resume("done", 1.0) == "done")
    collectgarbage("incremental")
  ]==], "Lua-host coroutine GC probe")
end

function test_lua_host_reports_coroutine_api_errors(_context: test.Context)
  assert_coroutine_lua_probe([==[
    local coroutine = require "titan.coroutine"
    local function fails(callback, needle)
      local ok, failure = pcall(callback)
      assert(not ok, "expected API call to fail")
      if needle then
        assert(tostring(failure):find(needle, 1, true), tostring(failure))
      end
    end

    local bad_callback = coroutine.create("not callable", "tag")
    fails(function() bad_callback:resume(nil) end)
    fails(function() coroutine.yield("payload") end,
      "must provide non-nil tag argument to coroutine.yield")
    fails(function() coroutine.yield("payload", "tag") end,
      "Invalid coroutine")
  ]==], "Lua-host coroutine API-error probe")
end
function test_running_lua_host_preserves_identity(_context: test.Context)
  assert_coroutine_lua_probe([==[
    local coroutine = require "titan.coroutine"
    assert(coroutine.running() == nil)
    local co
    co = coroutine.create(function()
      assert(rawequal(coroutine.running(), co))
      collectgarbage("collect")
      assert(rawequal(coroutine.running(), co))
      coroutine.yield("paused", "running")
      assert(rawequal(coroutine.running(), co))
      return coroutine.running()
    end, "running")
    assert(coroutine.running() == nil)
    assert(co:resume(nil) == "paused")
    assert(coroutine.running() == nil)
    assert(rawequal(co:resume(nil), co))
    assert(coroutine.running() == nil)

    -- Keep only the handle returned by running(), without a callback capture.
    co = coroutine.create(function()
      coroutine.yield(coroutine.running(), "running")
      return coroutine.running()
    end, "running")
    local current = co:resume(nil)
    assert(rawequal(current, co))
    co = nil
    collectgarbage("collect")
    assert(current:status() == "suspended")
    assert(rawequal(current:resume(nil), current))
    assert(coroutine.running() == nil)
  ]==], "Lua-host running identity probe")
end
