local function nil_payload_run(): boolean
  const co = coroutine.create(function(arg: value): value
    test.assert(arg == nil, "initial argument was not nil")
    const got = coroutine.yield(nil, "tag")
    test.assert(got == nil, "resume argument was not nil")
    return nil
  end, "tag")
  const first = co:resume(nil)
  const second = co:resume(nil)
  return first == nil and second == nil and co:status() == "dead"
end

function test_round_trips_nil_yield_resume_and_return_payloads(
    _context: test.Context)
  test.assert(nil_payload_run())
end

local function fail(): value
  raise "boom"
  return nil
end

local function fresh_fail(): value
  raise "fresh"
  return nil
end

local function uncaught_body(_: value): value
  return fail()
end

local function uncaught(): value
  const co = coroutine.create(uncaught_body, "tag")
  return co:resume(nil)
end

local injected_trace: string? = nil

local function catcher(_: value): value
  do
    coroutine.yield("ready", "tag")
  catch
    injected_trace = traceback
    return "caught:" .. support.caught_string(error)
  end
  return "missed"
end

local function inject(): string
  const co = coroutine.create(catcher, "tag")
  const first = co:resume(nil)
  const second = co:error("oops")
  return (first as string) .. "," .. (second as string) ..
         "," .. co:status()
end

function test_preserves_callback_traces_and_injects_suspended_error(
    context: test.Context)
  local caught = false
  do
    uncaught()
  catch
    caught = true
    test.assert(error == "boom", "coroutine changed the callback error")
    const trace = traceback
    test.assert(#trace > 0, "coroutine callback omitted its traceback")
    context:run("callback_symbolic_frames", function (_: test.Context)
      test.assert(support.contains(trace, "in coroutine.tests.fail"),
                  "missing coroutine callback frame\n" .. trace)
      test.assert(support.contains(trace, "in coroutine.tests.uncaught"),
                  "missing propagation frame\n" .. trace)
    end)
  end
  test.assert(caught, "uncaught callback error was not raised")

  test.assert(inject() == "ready,caught:oops,dead")
  const injected = injected_trace as string
  test.assert(#injected > 0, "injected error omitted its traceback")
  context:run("injected_symbolic_frames", function (_: test.Context)
    test.assert(support.contains(injected, "in coroutine.tests.catcher"),
                "missing injected yield frame\n" .. injected)
    test.assert(not support.contains(injected, "in coroutine.tests.inject"),
                "yield-side injected error appended caller propagation\n" .. injected)
  end)

  caught = false
  do
    fresh_fail()
  catch
    caught = true
    test.assert(error == "fresh", "fresh raise changed its error")
    const trace = traceback
    test.assert(#trace > 0, "fresh error omitted its traceback")
    context:run("fresh_symbolic_frames", function (_: test.Context)
      test.assert(support.contains(trace, "in coroutine.tests.fresh_fail"),
                  "fresh trace missing fresh raise\n" .. trace)
      test.assert(not support.contains(trace, "in coroutine.tests.fail"),
                  "fresh trace retained dead coroutine frame\n" .. trace)
    end)
  end
  test.assert(caught, "fresh error was not raised")
end

local finally_log = ""

local function finally_body(_: value): value
  do
    defer finally_log = finally_log .. "finally;"
    finally_log = finally_log .. "body;"
    coroutine.yield("pause", "tag")
    finally_log = finally_log .. "after;"
  end
  return finally_log
end

local function finally_run(): string
  finally_log = ""
  const co = coroutine.create(finally_body, "tag")
  const first = co:resume(nil)
  const middle = finally_log
  const second = co:resume(nil)
  return (first as string) .. ":" .. middle .. ":" .. (second as string)
end

function test_preserves_finally_state_across_yield_and_resume(
    _context: test.Context)
  test.assert(finally_run() == "pause:body;:body;after;finally;")
end

local function dead_body(arg: value): value
  return arg
end

local function after_dead(): string
  const co = coroutine.create(dead_body, "tag")
  const got = co:resume("done")
  const status = co:status()
  do
    co:resume("again")
  catch
    const resume_error = support.caught_string(error)
    do
      co:error("oops")
    catch
      return (got as string) .. ":" .. status .. ":" .. resume_error ..
             ":" .. support.caught_string(error)
    end
  end
  return "missed"
end

function test_rejects_resume_and_error_after_coroutine_is_dead(
    _context: test.Context)
  const text = after_dead()
  test.assert(text ==
              "done:dead:Coroutine not suspended:Coroutine not suspended",
              text)
  test.assert(not support.contains(text, "attempt to resume"), text)
end

local function missing_body(arg: value): value
  return arg
end

local function missing(): value
  const co = coroutine.create(missing_body)
  return co:resume(nil)
end

function test_rejects_missing_effective_tags(_context: test.Context)
  local caught = false
  do
    missing()
  catch
    caught = true
    const message = support.caught_string(error)
    test.assert(support.contains(message, "must provide tag argument"), message)
  end
  test.assert(caught, "missing effective tag did not raise")
end

local entry_seen = false

local function before_start_body(arg: value): value
  entry_seen = true
  return arg
end

local function before_start(): value
  const co = coroutine.create(before_start_body, "tag")
  return co:error("pre-start")
end

function test_injects_error_before_first_resume_without_entry_call(
    _context: test.Context)
  entry_seen = false
  local caught = false
  do
    before_start()
  catch
    caught = true
    test.assert(error == "pre-start", "pre-start error value changed")
  end
  test.assert(caught, "pre-start error was not raised")
  test.assert(not entry_seen, "pre-start error called the entry function")
end
