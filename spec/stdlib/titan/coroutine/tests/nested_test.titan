local function nested_yield_run(): string
  local tag_main: value = "main"
  local tag_a: value = "a"
  local b = coroutine.create(function(_: value): value
    coroutine.yield("from-b", tag_main)
    return "b-done"
  end, tag_a)
  local a = coroutine.create(function(_: value): value
    local got = b:resume("to-b")
    return "a:" .. (got as string)
  end, tag_main)
  local first = a:resume("start", tag_main)
  local middle = a:status() .. "/" .. b:status()
  local second = a:resume("again", tag_main)
  return (first as string) .. "," .. middle .. "," ..
         (second as string) .. "," .. a:status() .. "/" .. b:status()
end

function test_routes_nested_tagged_yield_through_suspended_outer_handler(
    _context: test.Context)
  test.assert(nested_yield_run() ==
              "from-b,suspended/stacked,a:b-done,dead/dead")
end

local function nested_error_run(): string
  local tag_main: value = "main"
  local tag_a: value = "a"
  local b = coroutine.create(function(_: value): value
    do
      coroutine.yield("from-b", tag_main)
    catch
      return "b-caught:" .. support.caught_string(error)
    end
    return "b-missed"
  end, tag_a)
  local a = coroutine.create(function(_: value): value
    local got = b:resume("to-b")
    return "a:" .. (got as string)
  end, tag_main)
  local first = a:resume("start", tag_main)
  local second = a:error("oops", tag_main)
  return (first as string) .. "," .. (second as string) ..
         "," .. a:status() .. "/" .. b:status()
end

function test_injects_errors_through_nested_stacked_yield(
    _context: test.Context)
  test.assert(nested_error_run() ==
              "from-b,a:b-caught:oops,dead/dead")
end

local nested_main_tag: value = nil
local nested_a_tag: value = nil

local function nested_fail_body(_: value): value
  coroutine.yield("from-b", nested_main_tag)
  return "missed"
end

local function nested_uncaught(): value
  nested_main_tag = "main"
  nested_a_tag = "a"
  local b = coroutine.create(nested_fail_body, nested_a_tag)
  local a = coroutine.create(function(_: value): value
    local got = b:resume("to-b")
    return "a:" .. (got as string)
  end, nested_main_tag)
  local first = a:resume("start", nested_main_tag)
  test.assert(first == "from-b", "nested coroutine returned a bad first value")
  return a:error("oops", nested_main_tag)
end

function test_preserves_uncaught_trace_through_nested_stacked_yield(
    context: test.Context)
  local caught = false
  do
    nested_uncaught()
  catch
    caught = true
    test.assert(error == "oops", "nested coroutine changed the error value")
    local trace = traceback
    test.assert(#trace > 0, "nested coroutine omitted its traceback")
    context:run("symbolic_frames", function (_context: test.Context)
      if common.is_windows() then
        test.skip("unsupported: native Windows tracebacks retain raw addresses without Titan symbols")
      end
      test.assert(support.contains(trace, "in coroutine.tests.nested_fail_body"),
                  "missing nested coroutine frame\n" .. trace)
      test.assert(support.contains(trace, "in coroutine.tests.nested_uncaught"),
                  "missing propagation frame\n" .. trace)
    end)
  end
  test.assert(caught, "nested coroutine error was not raised")
end

local function stacked_resume_run(): string
  local tag_main: value = "main"
  local tag_a: value = "a"
  local b = coroutine.create(function(_: value): value
    coroutine.yield("from-b", tag_main)
    return "b-done"
  end, tag_a)
  local a = coroutine.create(function(_: value): value
    local got = b:resume("to-b")
    return "a:" .. (got as string)
  end, tag_main)
  local first = a:resume("start", tag_main)
  local stacked = a:status() .. "/" .. b:status()
  local rejected = "missed"
  do
    b:resume("direct", tag_a)
  catch
    rejected = support.caught_string(error)
  end
  local restored = a:resume("again", tag_main)
  return (first as string) .. "," .. stacked .. "," .. rejected ..
         "," .. (restored as string)
end

function test_rejects_direct_resume_of_stacked_coroutine(
    _context: test.Context)
  local text = stacked_resume_run()
  test.assert(text ==
              "from-b,suspended/stacked,Coroutine not suspended,a:b-done",
              text)
end
