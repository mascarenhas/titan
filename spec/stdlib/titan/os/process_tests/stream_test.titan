local option_tail_called = false

local function reject_option(_: system.SpawnConfig): integer
  return -1
end

local function forbidden_tail(_: system.SpawnConfig): integer
  option_tail_called = true
  return 0
end

local function inherit_then_capture(config: system.SpawnConfig): integer
  local status = system.with_parent_stdout(config)
  if status < 0 then return status end
  return system.with_stdout(config)
end

local function check_interfaces(input: system.OutputStream,
                                output: system.InputStream)
  local reader: stream.Reader = output
  local reader_closer: stream.ReaderCloser = output
  local writer: stream.Writer = input
  local closer: stream.Closer = input
  local writer_closer: stream.WriterCloser = input
  if not reader or not reader_closer or not writer or not closer or
      not writer_closer then
    raise "process stream Interface conversion produced nil"
  end
end

local function cleanup_process(process: system.Process)
  do process_support.close_process_streams(process) catch end
  do
    if process:is_running() then process:kill("term") end
  catch
  end
  do process:wait() catch end
end

function test_stream_overlapping_writes_retain_binary_strings_through_cancellation(
    _context: test.Context)
  runtime_test.run(function ()
    local repetitions = 32768
    local process = system.spawn(process_support.child_path(),
      {"echo-count", strings.format("%d", repetitions * 10)})
    runtime_test.cleanup(function () cleanup_process(process) end)
    local input = process_support.required_output(process.stdin, "overlapping stdin")
    local output = process_support.required_input(process.stdout, "overlapping stdout")
    local first_gate: (function (nil): ())? = nil
    local second_gate: (function (nil): ())? = nil
    local first_submitted, second_submitted = false, false
    local first_returned, second_returned = false, false
    local observed: value = nil
    local reason = async.CancellationReason.simple("cancel accepted captured write")
    local first = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        first_gate = resolve
      end)
      local data = strings.rep("A\0x\r\n", repetitions)
      first_submitted = true
      do
        input:write(data)
        first_returned = true
      catch observed = error end
      return nil
    end)
    task_support.cleanup_task(first, "first captured writer cleanup")
    local second = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        second_gate = resolve
      end)
      local data = strings.rep("B\0y\n\r", repetitions)
      second_submitted = true
      input:write(data)
      second_returned = true
      return nil
    end)
    task_support.cleanup_task(second, "second captured writer cleanup")
    runtime_test.cleanup(function ()
      if first_gate ~= nil then
        local release = first_gate
        first_gate = nil
        first:cancel(async.CancellationReason.simple("unused captured write gate"))
        release(nil)
      end
    end)
    runtime_test.cleanup(function ()
      if second_gate ~= nil then
        local release = second_gate
        second_gate = nil
        second:cancel(async.CancellationReason.simple("unused captured write gate"))
        release(nil)
      end
    end)
    -- Cancel before closing; a failed assertion must still retire native
    -- writes even if the child stopped draining stdin. Gate cleanup and joins
    -- run afterward, before process reaping and the other stream cleanup.
    runtime_test.cleanup(function ()
      if task_support.active(first) then first:cancel(reason) end
      if task_support.active(second) then
        second:cancel(async.CancellationReason.simple("captured writer cleanup"))
      end
      input:close()
    end)
    while first_gate == nil or second_gate == nil do async.yield() end
    -- Registration runs outside a Task. Both gates resume through submission,
    -- and no native write callback can interleave before registration returns.
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local release_first, release_second = first_gate, second_gate
      first_gate = nil
      release_first(nil)
      second_gate = nil
      release_second(nil)
      test.assert(first_submitted and second_submitted and
                  first:status():as_string() == "waiting" and
                  second:status():as_string() == "waiting",
                  "captured writers did not suspend after native submission")
      first:cancel(reason)
      gc.collect()
      gc.collect()
      test.assert(first:status():as_string() == "waiting" and
                  second:status():as_string() == "waiting" and
                  not first_returned and not second_returned and observed == nil,
                  "captured writes advanced before terminal callbacks")
      resolve(nil)
    end)
    async.join(first)
    async.join(second)
    input:close()
    local received = process_support.read_all(output)
    gc.collect()
    local expected = strings.rep("A\0x\r\n", repetitions) ..
                     strings.rep("B\0y\n\r", repetitions)
    test.assert(first:status():has_cancelled() and observed == reason and
                not first_returned,
                "accepted captured write lost its sticky cancellation")
    test.assert(second:status():has_succeeded() and second_returned,
                "overlapping captured write did not complete independently")
    test.assert(received == expected,
                "overlapping captured writes lost ordered binary string bytes")
    process_support.assert_normal(process:wait(), "overlapping captured writes")
  end)
end

function test_stream_cancelled_reader_allows_immediate_replacement(
    _context: test.Context)
  runtime_test.run(function ()
    local process = system.spawn(process_support.child_path(), {"echo-count", "1"})
    defer cleanup_process(process)
    local input = process_support.required_output(process.stdin, "gated stdin")
    local output = process_support.required_input(process.stdout, "gated stdout")
    local reason = async.CancellationReason.simple("replace captured reader")
    local observed: value = nil
    local old = async.run<|value, value|>(function (): value
      do output:read() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(old, "old captured reader cleanup")
    process_support.wait_until_waiting(old, "old captured reader")
    expect_cancelled_process_operation(function () output:read() end,
                                       "pending captured reader cancellation")
    test.assert(old:status():as_string() == "waiting",
                "cancelled competitor disturbed the captured reader")

    local release = async.run<|value, value|>(function (): value
      async.join(old)
      input:write("R")
      input:close()
      return nil
    end)
    task_support.cleanup_task(release, "captured read release cleanup")
    old:cancel(reason)
    test.assert(observed == nil, "old captured reader unwound before replacement")
    -- The successor waits before the old reader unwinds and before the byte
    -- is released, detecting either a stale reservation or a stale defer.
    test.assert(output:read() == "R" and not output:read(),
                "replacement captured reader lost its byte or EOF")
    async.join(release)
    test.assert(old:status():has_cancelled() and observed == reason,
                "old captured reader lost its cancellation reason")
    test.assert(release:status():has_succeeded(), "captured read release failed")
    process_support.assert_normal(process:wait(), "replacement captured reader")
  end)
end

function test_stream_facades_capture_merge_inheritance_options_and_interfaces(
    _context: test.Context)
  runtime_test.run(function ()
    option_tail_called = false
    process_support.expect_failure(function ()
      local unexpected = system.spawn(
        process_support.child_path(), {"exit", "0"}, reject_option, forbidden_tail)
      defer cleanup_process(unexpected)
    end, "spawn accepted a rejected option")
    test.assert(not option_tail_called,
                "spawn continued after a failed option")

    do
      local separate = system.spawn(
        process_support.child_path(), {"output", "separate", "diagnostic"})
      defer cleanup_process(separate)
      local input = process_support.required_output(separate.stdin, "default stdin")
      local output = process_support.required_input(separate.stdout, "default stdout")
      local diagnostics = process_support.required_input(separate.stderr, "default stderr")
      check_interfaces(input, output)
      test.assert(not input:is_tty() and not output:is_tty() and
                  not diagnostics:is_tty() and
                  input:kind() == "pipe" and output:kind() == "pipe" and
                  diagnostics:kind() == "pipe",
                  "captured pipe was misclassified")
      input:close()
      input:close()
      common.assert_raises_contains(function () input:kind() end,
                                    "OutputStream is closed")
      test.assert(process_support.read_all(output) == "separate",
                  "default stdout capture changed")
      test.assert(output:kind() == "pipe",
                  "captured stdout lost pipe kind at EOF before facade close")
      test.assert(process_support.read_all(diagnostics) == "diagnostic",
                  "default stderr capture changed")
      output:close()
      common.assert_raises_contains(function () output:kind() end,
                                    "InputStream is closed")
      process_support.assert_normal(separate:wait(), "default capture")
    end

    do
      local merged = system.spawn(
        process_support.child_path(), {"output", "A", "B"},
        system.with_merged_output)
      defer cleanup_process(merged)
      process_support.required_output(merged.stdin, "merged stdin"):close()
      local merged_output = process_support.required_input(merged.stdout, "merged stdout")
      local merged_error = process_support.required_input(merged.stderr, "merged stderr")
      test.assert(merged_output == merged_error,
                  "merged output did not expose one stream facade")
      test.assert(process_support.read_all(merged_output) == "AB",
                  "merged stdout/stderr bytes changed")
      test.assert(not merged_error:read(),
                  "merged stream did not share terminal EOF")
      process_support.assert_normal(merged:wait(), "merged capture")
    end

    do
      local merged = system.spawn(process_support.child_path(), {"dual", "64"},
                                  system.with_merged_output)
      defer cleanup_process(merged)
      process_support.required_output(merged.stdin, "bulk merged stdin"):close()
      local output = process_support.required_input(merged.stdout, "bulk merged output")
      test.assert(output == merged.stderr, "merged streams do not share one facade")
      local bytes = process_support.read_all(output)
      local stdout_count, stderr_count = 0, 0
      for index = 1, #bytes do
        local byte = strings.sub(bytes, index, index)
        if byte == "O" then stdout_count = stdout_count + 1
        elseif byte == "E" then stderr_count = stderr_count + 1
        else test.assert(false, "merged stream gained an unexpected byte") end
      end
      test.assert(stdout_count == 64 and stderr_count == 64, "merged output lost bytes")
      process_support.assert_normal(merged:wait(), "bulk merged output")
    end

    do
      local recaptured = system.spawn(
        process_support.child_path(), {"output", "E", "F"},
        system.with_merged_output, inherit_then_capture,
        system.with_stderr, system.with_stderr)
      defer cleanup_process(recaptured)
      process_support.required_output(recaptured.stdin, "recaptured stdin"):close()
      local recaptured_output = process_support.required_input(
        recaptured.stdout, "recaptured stdout")
      local recaptured_error = process_support.required_input(
        recaptured.stderr, "recaptured stderr")
      test.assert(recaptured_output ~= recaptured_error,
                  "final spawn choices retained stale merged identity")
      test.assert(process_support.read_all(recaptured_output) == "E" and
                  process_support.read_all(recaptured_error) == "F",
                  "final spawn choices returned the wrong streams")
      process_support.assert_normal(recaptured:wait(), "recaptured streams")
    end

    do
      local inherited = system.spawn(
        process_support.child_path(), {"exit", "0"},
        system.with_parent_stdout, system.with_parent_stderr)
      defer cleanup_process(inherited)
      process_support.required_output(inherited.stdin, "inherited stdin"):close()
      test.assert(not inherited.stdout and not inherited.stderr,
                  "inherited descriptors exposed captured endpoints")
      process_support.assert_normal(inherited:wait(), "inherited stdio")
    end
  end)
end

function test_stream_facade_close_wakes_pending_reader(
    context: test.Context)
  runtime_test.run(function ()
    local process = system.spawn(
      process_support.child_path(), {"wait"})
    defer cleanup_process(process)

    local input = process_support.required_output(process.stdin, "pending stdin")
    local output = process_support.required_input(process.stdout, "pending stdout")
    local diagnostics = process_support.required_input(process.stderr, "pending stderr")
    local read_result = "not-resumed"
    local reader = async.run<|value, value|>(function (): value
      local chunk? = output:read()
      if chunk then
        read_result = chunk as string
      else
        read_result = "eof"
      end
      return nil
    end)
    task_support.cleanup_task(reader, "captured stream reader cleanup")
    process_support.wait_until_waiting(reader, "captured read")

    process_support.expect_failure(function ()
      output:read()
    end, "captured input accepted a second waiting reader")
    output:close()
    output:close()
    process_support.wait_until_finished(reader)
    test.assert(reader:status():as_string() == "succeeded" and
                read_result == "eof",
                "closing captured input did not wake its reader with EOF")
    test.assert(not output:read() and not output:read_until("missing"),
                "closed captured input did not keep terminal EOF")

    diagnostics:close()
    input:close()
    process:kill("term")
    local status = process:wait()
    test.assert(status.signal == "term" and status.signal_number > 0,
                "pending-read child was not reaped")
  end)
end

function test_closed_stream_facades_remain_terminal_in_later_runtime(
    _context: test.Context)
  local closed_input: system.InputStream? = nil
  local closed_output: system.OutputStream? = nil
  local stale_input: system.InputStream? = nil

  runtime_test.run(function ()
    local process = system.spawn(process_support.child_path(), {"exit", "0"})
    defer cleanup_process(process)
    local input = process_support.required_output(
      process.stdin, "retained stdin")
    local output = process_support.required_input(
      process.stdout, "retained stdout")
    local diagnostics = process_support.required_input(
      process.stderr, "retained stderr")
    input:close()
    output:close()
    process.stderr = nil
    process_support.assert_normal(process:wait(), "retained streams")
    closed_input = output
    closed_output = input
    stale_input = diagnostics
  end)

  runtime_test.run(function ()
    local input = closed_input as system.InputStream
    test.assert(not input:read() and not input:read_until("missing"),
                "closed input lost terminal EOF in a later Runtime")
    common.assert_raises_contains(function () input:kind() end,
                                  "InputStream is closed")
    input:close()
    local output = closed_output as system.OutputStream
    output:close()
    common.assert_raises_contains(function () output:kind() end,
                                  "OutputStream is closed")
    process_support.expect_failure(function ()
      output:write("late")
    end, "closed output became writable in a later Runtime")
    local stale = stale_input as system.InputStream
    common.assert_raises_contains(function () stale:kind() end,
                                  "stdio stream belongs to a different async Runtime")
  end)
end
