local protobuf = import "protobuf"
local reflect = import "reflect"

local const output_disposal_fields: const {reflect.Type} = {
  reflect.Type.is_integer(), reflect.Type.is_option(reflect.Type.is_string()),
}
local const input_disposal_fields: const {reflect.Type} = {
  reflect.Type.is_integer(), reflect.Type.is_string(), reflect.Type.is_integer(),
  reflect.Type.is_option(reflect.Type.is_named(reflect.NamedType("titan.async.OperationError"))),
  reflect.Type.is_option(reflect.Type.is_string()),
  reflect.Type.is_array(reflect.ArrayTypeConstness.is_mutable(), reflect.Type.is_string()),
}

function test_stream_disposal_parent_identities_need_no_runtime(_context: test.Context)
  const state = transfer_lua.new()
  defer state:close()
  const result = state:run([[
    local os = require('titan.os')
    local async = require('titan.async')
    assert(not pcall(async.current_loop))
    assert(os.InputStream.discard_transfer_payload(os.stdin:to_transfer_payload()) == 0)
    assert(os.OutputStream.discard_transfer_payload(os.stdout:to_transfer_payload()) == 0)
    assert(os.OutputStream.discard_transfer_payload(os.stderr:to_transfer_payload()) == 0)
    assert(not pcall(async.current_loop), 'parent disposal initialized a Runtime')
    -- The identities remain available and uninitialized after disposal.
    assert(os.InputStream.discard_transfer_payload(os.stdin:to_transfer_payload()) == 0)
    assert(os.OutputStream.discard_transfer_payload(os.stdout:to_transfer_payload()) == 0)
    return true
  ]], "=parent-stream-disposal")
  test.assert(result:to_value() == true)
end

function test_stream_disposal_captured_pipes_without_task_or_adoptable_runtime(
    context: test.Context)
  context:run("fresh_state", function (_: test.Context)
    dispose_captured_streams(false)
  end)
  context:run("retired_runtime", function (_: test.Context)
    dispose_captured_streams(true)
  end)
end

local function dispose_captured_streams(retired: boolean)
  runtime_test.run(function ()
    const state = transfer_lua.new()
    defer state:close()
    if retired then
      state:run([[
        local async = require('titan.async')
        async.run(function () async.request_exit(0) end)
        async.loop()
      ]], "=retire-disposal-runtime")
    end
    const process = system.spawn(process_support.child_path(), {"echo"})
    defer cleanup_process(process)
    const input = process_support.required_output(process.stdin, "disposal stdin")
    const output = process_support.required_input(process.stdout, "disposal stdout")
    local output_packet: string? = nil
    -- POSIX permits a stopped idle captured reader. Windows keeps its native
    -- overlapped read pending, so only its terminal/inert payload can move.
    if not common.is_windows() then output_packet = output:to_transfer_payload() end
    const input_packet = input:to_transfer_payload()
    local discarded = state:run([[
      local payload = ...
      local os = require('titan.os')
      local async = require('titan.async')
      assert(not pcall(async.running), 'disposal unexpectedly has a Task')
      assert(not pcall(async.current_loop), 'disposal unexpectedly has a Runtime')
      local status = os.OutputStream.discard_transfer_payload(payload)
      assert(not pcall(async.current_loop), 'disposal initialized a Runtime')
      return status
    ]], "=captured-output-disposal", async.TransferValue.is_string(input_packet))
    test.assert(discarded:to_value() == 0)
    if common.is_windows() then
      test.assert(output:read() == nil, "disposed stdin did not deliver child EOF")
    end
    process_support.assert_normal(process:wait(), "origin reaps disposed stream child")
    if output_packet == nil then output_packet = output:to_transfer_payload() end
    discarded = state:run([[
      local payload = ...
      local os = require('titan.os')
      local async = require('titan.async')
      assert(not pcall(async.current_loop))
      local status = os.InputStream.discard_transfer_payload(payload)
      assert(not pcall(async.current_loop))
      return status
    ]], "=captured-input-disposal", async.TransferValue.is_string(output_packet))
    test.assert(discarded:to_value() == 0)
    process_support.assert_normal(process:wait(), "disposal preserves retained process status")
  end)
end

function test_stream_disposal_inert_captured_payloads(_context: test.Context)
  const initial: {string} = {"buffered\0bytes"}
  const output = protobuf.serialize_fields(output_disposal_fields, -1, nil)
  const input = protobuf.serialize_fields(input_disposal_fields, -1, "excess", 1,
                                           nil, nil, initial)
  test.assert(system.OutputStream.discard_transfer_payload(output) == 0)
  test.assert(system.InputStream.discard_transfer_payload(input) == 0)
end

function test_stream_disposal_rejects_malformed_discriminators(context: test.Context)
  context:run("output", function (_: test.Context)
    common.assert_raises(function () system.OutputStream.discard_transfer_payload("\255") end)
    const invalid = protobuf.serialize_fields(output_disposal_fields, 0, nil)
    common.assert_raises_contains(function ()
      system.OutputStream.discard_transfer_payload(invalid)
    end, "output stream descriptor")
    const parent_native = protobuf.serialize_fields(output_disposal_fields, 1, "invalid native")
    common.assert_raises_contains(function ()
      system.OutputStream.discard_transfer_payload(parent_native)
    end, "invalid standard output transfer payload")
  end)
  context:run("input", function (_: test.Context)
    const initial: {string} = {}
    common.assert_raises(function () system.InputStream.discard_transfer_payload("\255") end)
    const invalid = protobuf.serialize_fields(input_disposal_fields, 1, "", 3, nil, nil, initial)
    common.assert_raises_contains(function ()
      system.InputStream.discard_transfer_payload(invalid)
    end, "input stream descriptor")
    const terminal = protobuf.serialize_fields(input_disposal_fields, -1, "", 4, nil, nil, initial)
    common.assert_raises_contains(function ()
      system.InputStream.discard_transfer_payload(terminal)
    end, "invalid input stream terminal payload")
    const missing_failure = protobuf.serialize_fields(input_disposal_fields, -1, "", 2, nil, nil, initial)
    common.assert_raises_contains(function ()
      system.InputStream.discard_transfer_payload(missing_failure)
    end, "invalid input stream terminal payload")
    const parent_buffered = protobuf.serialize_fields(input_disposal_fields, 0, "unread", 3, nil, nil, initial)
    common.assert_raises_contains(function ()
      system.InputStream.discard_transfer_payload(parent_buffered)
    end, "invalid standard input transfer payload")
  end)
  context:run("live_input_without_pipe", function (_: test.Context)
    const initial: {string} = {}
    const live_without_pipe = protobuf.serialize_fields(
      input_disposal_fields, -1, "", 0, nil, nil, initial)
    common.assert_raises_contains(function ()
      system.InputStream.discard_transfer_payload(live_without_pipe)
    end, "live input stream transfer has no pipe")
    common.assert_raises_contains(function ()
      system.InputStream.from_transfer_payload(live_without_pipe)
    end, "live input stream transfer has no pipe")
  end)
end

local function disposal_descriptor_count(): integer?
  if common.is_windows() then return nil end
  local count: integer? = nil
  runtime_test.run(function ()
    if fs.stat("/dev/fd") ~= nil then count = #fs.list("/dev/fd") end
  end)
  return count
end

local function transfer_terminal_input(adopt: boolean)
  const before? = disposal_descriptor_count()
  runtime_test.run(function ()
    const process = system.spawn(process_support.child_path(), {"echo"})
    defer cleanup_process(process)
    const input = process_support.required_output(process.stdin, "terminal transfer stdin")
    const output = process_support.required_input(process.stdout, "terminal transfer stdout")
    const bytes = "terminal\0transfer\255"
    input:write(bytes)
    input:close()
    test.assert(process_support.read_all(output) == bytes,
                "terminal transfer lost child output before EOF")
    const payload = output:to_transfer_payload()
    if adopt then
      const restored = system.InputStream.from_transfer_payload(payload)
      defer restored:close()
      test.assert(restored:read() == nil and restored:read() == nil,
                  "adopted terminal input did not retain EOF")
    else
      test.assert(system.InputStream.discard_transfer_payload(payload) == 0,
                  "terminal input disposal failed")
    end
    process_support.assert_normal(process:wait(), "terminal transfer child")
    test.assert(not process:is_running(), "terminal transfer left its child running")
    process_support.assert_normal(process:wait(), "terminal transfer retained child status")
  end)
  if before ~= nil then
    test.assert(disposal_descriptor_count() == before,
                "terminal input transfer leaked a descriptor")
  end
end

function test_transfer_terminal_input_preserves_eof_and_process_status(
    context: test.Context)
  context:run("dispose", function (_: test.Context)
    transfer_terminal_input(false)
  end)
  context:run("adopt", function (_: test.Context)
    transfer_terminal_input(true)
  end)
end
