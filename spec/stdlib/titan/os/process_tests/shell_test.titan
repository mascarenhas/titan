-- Quote the controlled native fixture arguments in the shell under test. Only
-- the syntax differs; the byte/stream/status assertions below are shared.
local function popen_quote(argument: string): string
  local output = "'"
  if common.is_windows() then
    output = '"'
    local slashes = 0
    for index = 1, #argument do
      local byte = strings.sub(argument, index, index)
      if byte == "\\" then
        slashes = slashes + 1
      else
        if byte == '"' then
          output = output .. strings.rep("\\", 2 * slashes + 1)
        else
          output = output .. strings.rep("\\", slashes)
        end
        output = output .. byte
        slashes = 0
      end
    end
    return output .. strings.rep("\\", 2 * slashes) .. '"'
  end
  for index = 1, #argument do
    local byte = strings.sub(argument, index, index)
    if byte == "'" then byte = "'\\''" end
    output = output .. byte
  end
  return output .. "'"
end

local function shell_syntax(unix: string, windows: string): string
  if common.is_windows() then return windows end
  return unix
end

local function shell_newline(): string
  return shell_syntax("\n", "\r\n")
end

local function check_stream_interfaces(pipe: system.InputOutputStream)
  local reader: stream.Reader = pipe
  local writer: stream.Writer = pipe
  local closer: stream.Closer = pipe
  local reader_writer: stream.ReaderWriter = pipe
  local reader_closer: stream.ReaderCloser = pipe
  local writer_closer: stream.WriterCloser = pipe
  local all: stream.ReaderWriterCloser = pipe
  if not reader or not writer or not closer or not reader_writer or
      not reader_closer or not writer_closer or not all then
    raise "InputOutputStream Interface conversion produced nil"
  end
end

local function read_process_output(pipe: system.InputOutputStream): string
  local result = ""
  for chunk in pipe:read do result = result .. chunk end
  return result
end

function test_os_shell_transfer_recovers_second_dup_failure(context: test.Context)
  if common.is_windows() then
    test.skip("platform: controlled dup wrapping requires Linux syscall support")
    return
  end
  local host, host_why, host_status = command.capture({"uname", "-s"})
  test.assert(host_why == "exit" and host_status == 0, host)
  if host ~= "Linux\n" then
    test.skip("platform: controlled dup wrapping requires Linux syscall support")
    return
  end
  runtime_test.run(function ()
    local workspace = fs.tmpname()
    fs.unlink(workspace)
    context:cleanup(function () command.remove_tree(workspace) end)
    local sdk? = system.getenv("TITAN_TEST_SDK_ROOT")
    test.assert(sdk ~= nil, "I/O transfer fixture requires the selected test SDK")
    local output, why, status = command.capture({
      "bash", "spec/support/check_io_transfer_failure.sh", sdk, workspace,
    })
    test.assert(why == "exit" and status == 0,
                "I/O transfer fault fixture failed: " .. output)
    test.assert(common.contains(output,
      "PASS: second-pipe failure retained write/retry/close ownership"))
    test.assert(common.contains(output,
      "PASS: exit cleanup discarded retained pipe with adoption still closed"))
    test.assert(common.contains(output, "PASS: staged descriptor retired"))
  end)
end

function test_os_shell_interactive_merged_output_and_status(
    _context: test.Context)
  runtime_test.run(function ()
    local rejected_nul = false
    do
      system.popen("printf forbidden\0suffix")
    catch
      test.assert(error is async.OperationError,
                  "invalid popen command lost its operation error")
      test.assert((error as async.OperationError).name == "EINVAL",
                  "embedded NUL command lost EINVAL")
      rejected_nul = true
    end
    test.assert(rejected_nul, "popen accepted an embedded NUL command")

    local pipe = system.popen(popen_quote(process_support.child_path()) ..
                              " popen-interactive")
    defer pipe:close()
    check_stream_interfaces(pipe)
    pipe:write("hello world\n")
    test.assert(read_process_output(pipe) == "OUT:hello world:ERR",
                "interactive popen changed merged output")

    local first = pipe:wait()
    local second = pipe:wait()
    test.assert(first.code == 7 and not first.signal and
                first.signal_number == 0,
                "popen returned the wrong normal exit status")
    test.assert(first.code == second.code and first.signal == second.signal and
                first.signal_number == second.signal_number,
                "popen did not retain its exit status")

    pipe:close()
    pipe:close()
    test.assert(not pipe:read() and not pipe:read_until("missing"),
                "closed popen stream did not keep terminal EOF")
    local after_close = pipe:wait()
    test.assert(first.code == after_close.code and
                first.signal == after_close.signal and
                first.signal_number == after_close.signal_number,
                "close changed a retained exit status")
  end)
end

function test_os_shell_binary_delimiters(_context: test.Context)
  runtime_test.run(function ()
    local payload = "head\0middle\r\n\26\255trail"
    local pipe = system.popen(popen_quote(process_support.child_path()) ..
        " echo-count " .. #payload .. " " .. popen_quote("|done"))
    defer pipe:close()
    pipe:write(payload)
    test.assert(pipe:read_until("|", true) == payload,
                "popen binary delimiter read changed bytes")
    test.assert(pipe:read() == "done",
                "popen delimiter read lost retained excess")
    test.assert(not pipe:read() and not pipe:read_until("missing"),
                "repeated popen reads did not return EOF")
    local status = pipe:wait()
    test.assert(status.code == 0 and not status.signal,
                "binary popen command did not exit normally")
    pipe:close()
  end)
end

function test_os_shell_close_terminates_and_reaps(
    _context: test.Context)
  runtime_test.run(function ()
    local pipe = system.popen(
        shell_syntax("printf 'READY\\nUNREAD\\n'; while :; do :; done",
                     "echo READY&echo UNREAD&for /l %i in (0,0,1) do @rem hold"))
    defer pipe:close()
    test.assert(pipe:read_until(shell_newline(), true) == "READY",
                "running popen command did not become ready")
    pipe:close()
    pipe:close()
    test.assert(not pipe:read() and not pipe:read_until("missing"),
                "closing popen did not discard unread output")

    local first = pipe:wait()
    local second = pipe:wait()
    test.assert(first.signal == "term" and first.signal_number > 0,
                "popen close did not terminate its running child")
    test.assert(first.code == second.code and first.signal == second.signal and
                first.signal_number == second.signal_number,
                "popen close did not retain the signal exit status")
  end)
end

function test_os_shell_quoted_unicode_arguments(_context: test.Context)
  runtime_test.run(function ()
    local child = process_support.child_path()
    local cwd = system.cwd()
    local name = "TITAN_POPEN_METADATA"
    local value = "space value"
    local arguments: {string} = {"", "space argument", "a&b|<>^", "ação東京😀", "trailing\\"}
    local command = shell_syntax(name .. "=" .. popen_quote(value) .. " ",
                                  'set "' .. name .. '=' .. value .. '"&&') ..
                    popen_quote(child) .. " argv-env-cwd " .. name
    local expected = "cwd:" .. #cwd .. ":" .. cwd .. "\n" ..
        "env:" .. #value .. ":" .. value .. "\n" ..
        "argv0:" .. #child .. ":" .. child .. "\n"
    for index = 1, #arguments do
      local argument = arguments[index]
      command = command .. " " .. popen_quote(argument)
      expected = expected .. "arg:" .. #argument .. ":" .. argument .. "\n"
    end
    local previous? = system.getenv(name)
    local pipe = system.popen(command)
    defer pipe:close()
    test.assert(read_process_output(pipe) == expected,
                "shell quoting changed UTF-8 arguments or metacharacters")
    process_support.assert_normal(pipe:wait(), "quoted shell child")
    test.assert(system.getenv(name) == previous,
                "shell changed its parent's environment")
  end)
end

function test_os_shell_pipeline_and_redirection(_context: test.Context)
  runtime_test.run(function ()
    local temporary = fs.tmpname()
    local path = temporary .. " output ação 東京.bin"
    defer do
      if fs.stat(temporary) ~= nil then fs.unlink(temporary) end
      if fs.stat(path) ~= nil then fs.unlink(path) end
    end
    fs.rename(temporary, path)
    -- cmd's TYPE builtin uses native path separators.
    if common.is_windows() then
      local native = ""
      for index = 1, #path do
        local byte = strings.sub(path, index, index)
        if byte == "/" then byte = "\\" end
        native = native .. byte
      end
      path = native
    end
    local child = popen_quote(process_support.child_path())
    local pipe = system.popen(child .. " dual 64 > " .. popen_quote(path) ..
        " 2>&1 && " .. shell_syntax("cat ", "type ") .. popen_quote(path) ..
        " | " .. child .. " echo")
    defer pipe:close()
    local bytes = read_process_output(pipe)
    local stdout_count, stderr_count = 0, 0
    for index = 1, #bytes do
      local byte = strings.sub(bytes, index, index)
      if byte == "O" then stdout_count = stdout_count + 1
      elseif byte == "E" then stderr_count = stderr_count + 1
      else test.assert(false, "shell pipeline gained unexpected output") end
    end
    test.assert(stdout_count == 64 and stderr_count == 64,
                "shell pipeline lost merged output")
    test.assert(fs.read_file(path) == bytes,
                "redirection did not preserve exact bytes")
    process_support.assert_normal(pipe:wait(), "shell pipeline")
  end)
end

function test_os_shell_nonzero_and_missing_command_status(_context: test.Context)
  runtime_test.run(function ()
    local failed = system.popen(shell_syntax("exit 126", "exit /b 126"))
    defer failed:close()
    test.assert(read_process_output(failed) == "" and failed:wait().code == 126,
                "nonzero shell exit became a spawn error")
    local missing = system.popen(popen_quote(process_support.child_path() .. ".absent"))
    defer missing:close()
    test.assert(#read_process_output(missing) > 0,
                "missing command lost merged diagnostic")
    local expected = 127
    if common.is_windows() then expected = 1 end
    test.assert(missing:wait().code == expected,
                "quoted missing command lost the native shell exit code")
  end)
end

local function popen_cancellation_case(waiting: boolean)
  runtime_test.run(function ()
    local pipe = system.popen(shell_syntax(
        "printf 'READY\\n'; IFS= read -r ignored; printf 'AFTER\\n'",
        "echo READY&set /p ignored=&echo AFTER"))
    defer pipe:close()
    test.assert(pipe:read_until(shell_newline(), true) == "READY",
                "shell did not become ready")
    local task = async.run<|value, value|>(function (): value
      if waiting then pipe:wait() else pipe:read() end
      return nil
    end)
    defer task_support.cancel_and_join_task(task, "popen Task cleanup")
    process_support.wait_until_waiting(task, "popen operation")
    timer.sleep(10)
    test.assert(task:status():as_string() == "waiting",
                "pending popen operation blocked its Runtime")
    task:cancel(async.CancellationReason.simple("popen operation cancelled"))
    async.join(task)
    test.assert(task:status():has_cancelled(), "popen operation ignored cancellation")
    pipe:write("continue" .. shell_newline())
    test.assert(read_process_output(pipe) == "AFTER" .. shell_newline(),
                "cancelling a waiter killed or closed its shell")
    process_support.assert_normal(pipe:wait(), "shell after waiter cancellation")
  end)
end

function test_os_shell_wait_cancellation_preserves_child(_context: test.Context)
  popen_cancellation_case(true)
end

function test_os_shell_read_cancellation_preserves_child(_context: test.Context)
  popen_cancellation_case(false)
end

function test_os_shell_fixed_system_shell(_context: test.Context)
  runtime_test.run(function ()
    local name = shell_syntax("SHELL", "COMSPEC")
    local previous? = system.getenv(name)
    defer do
      if previous then system.setenv(name, previous)
      else system.unsetenv(name) end
    end
    system.setenv(name, process_support.child_path() .. ".absent")
    local pipe = system.popen("echo SYSTEM_SHELL")
    defer pipe:close()
    test.assert(read_process_output(pipe) == "SYSTEM_SHELL" .. shell_newline(),
                "popen did not select its fixed system shell")
    process_support.assert_normal(pipe:wait(), "fixed system shell")
  end)
end

function test_os_shell_transfer_keeps_process_ownership_at_origin(
    _context: test.Context)
  runtime_test.run(function ()
    local source = system.popen(popen_quote(process_support.child_path()) ..
                               " echo-count 4 " .. popen_quote("|done"))
    defer source:close()
    local target = source
    if common.is_windows() then
      local refused = false
      do source:to_transfer_payload()
      catch
        test.assert(error is async.OperationError)
        local failure = error as async.OperationError
        test.assert(failure.name == "EBUSY" and failure.operation == "stdio.transfer")
        refused = true
      end
      test.assert(refused, "pending Windows shell-pipe read was detached")
    else
      -- Registration runs with an active Runtime but outside Task execution.
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        local packet = async.TransferValue.from_value(source)
        target = packet:to_value()
        resolve(nil)
      end)
      test.assert(source:read() == nil and source:read_until("|") == nil)
      common.assert_raises(function () source:write("late") end)
      common.assert_raises(function () source:to_transfer_payload() end)
      common.assert_raises_contains(function () target:wait() end,
                                   "no child process owner")
    end
    defer target:close()
    target:write("A\0B\255")
    test.assert(target:read_until("|", true) == "A\0B\255")
    test.assert(target:read() == "done" and target:read() == nil)
    target:close()
    test.assert(source:wait().code == 0,
                "moving shell pipes lost the originating child status")
    source:close()
  end)
end

function test_os_shell_transfer_rejects_pending_reader_before_detachment(
    _context: test.Context)
  runtime_test.run(function ()
    local source = system.popen(popen_quote(process_support.child_path()) ..
                               " popen-interactive")
    defer source:close()
    local received = ""
    local reader = async.run<|nil, value|>(function (): nil
      received = read_process_output(source)
      return nil
    end)
    task_support.cleanup_task(reader, "shell transfer waiting reader")
    while reader:status():as_string() == "ready" do timer.yield() end
    test.assert(reader:status():as_string() == "waiting")
    common.assert_raises_contains(function () source:to_transfer_payload() end,
                                 "pending operation")
    source:write("still-owned\n")
    async.join(reader)
    test.assert(reader:status():has_succeeded() and received == "OUT:still-owned:ERR",
                "rejected shell transfer damaged a communication pipe")
    test.assert(source:wait().code == 7)
  end)
end

function test_os_shell_transfer_crosses_states_with_origin_reaping(
    _context: test.Context)
  if common.is_windows() then
    test.skip("platform: Windows shell pipes start an eager pending native read")
    return
  end
  runtime_test.run(function ()
    local source = system.popen(popen_quote(process_support.child_path()) ..
                               " echo-count 4 " .. popen_quote("|done"))
    defer source:close()
    local state = transfer_lua.new()
    defer state:close()
    -- Arguments are decoded before the Lua chunk starts. Establish the
    -- destination Runtime before adopting the closure's captured pipes.
    state:run([[
      local async = require('titan.async')
      async.run(function () end)
    ]], "=shell-stream-transfer-runtime")
    local operation = function (): string
      defer source:close()
      common.assert_raises_contains(function () source:wait() end,
                                   "no child process owner")
      source:write("x\0y\255")
      return read_process_output(source)
    end
    local result: async.TransferValue = state:run_async([[
      local operation = ...
      local async = require('titan.async')
      local task = async.run(operation)
      async.loop()
      local success, result = task:status():has_succeeded()
      if not success then
        local failed, failure = task:status():has_failed()
        if failed then failure:raise() end
        error('shell stream transfer worker did not succeed')
      end
      return result
    ]], "=shell-stream-transfer", async.TransferValue.from_value(operation))
    state:close()
    test.assert(result:to_value() as string == "x\0y\255|done")
    test.assert(source:wait().code == 0,
                "source Runtime did not reap the child after worker pipe use")
  end)
end

function test_os_shell_transfer_rejects_malformed_payloads(_context: test.Context)
  common.assert_raises(function () system.InputOutputStream.from_transfer_payload("") end)
  common.assert_raises(function ()
    system.InputOutputStream.from_transfer_payload("\255")
  end)
end
