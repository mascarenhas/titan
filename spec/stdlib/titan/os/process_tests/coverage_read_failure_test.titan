local coverage_read_failure_uv = import "uv"

function test_coverage_parent_stdin_read_start_failure_retires_pipe_and_restores_input(
    _context: test.Context)
  if common.is_windows() then
    test.skip("platform: wrong-direction inherited pipe requires POSIX pipe descriptors")
  end
  runtime_test.run(function ()
    local workspace = fs.tmpname()
    fs.unlink(workspace)
    fs.mkdir(workspace)
    runtime_test.cleanup(function () command.remove_tree(workspace) end)
    fs.write_file(workspace .. "/os_read_failure_app.titan",
      fs.read_file("spec/fixtures/stdlib/titan/os_read_failure_app.titan"))
    local output, why, compiled = command.compile(workspace,
      "os_read_failure_app", {"--no-uv-bootstrap"})
    test.assert(why == "exit" and compiled == 0,
                "could not compile read startup child: " .. output)
    local result_path = workspace .. "/read-start.result"
    local status = command.system({
      command.program(workspace, "os_read_failure_app"), result_path,
    }, workspace, nil, nil, "READ_START_INPUT_MARKER")
    test.assert(status == 0 and
                fs.read_file(result_path) == "READ_START_FAILURE_OK:ENOTCONN",
                "read startup failure did not preserve input ownership and exact cause")
  end)
end

function test_coverage_unknown_signal_exit_keeps_native_number_and_sticky_result(
    _context: test.Context)
  if common.is_windows() or coverage_read_failure_uv.SIGALRM == nil then
    test.skip("platform: unknown terminating signal requires POSIX SIGALRM")
  end
  runtime_test.run(function ()
    local workspace = fs.tmpname()
    fs.unlink(workspace)
    fs.mkdir(workspace)
    runtime_test.cleanup(function () command.remove_tree(workspace) end)
    fs.write_file(workspace .. "/os_read_failure_app.titan",
      fs.read_file("spec/fixtures/stdlib/titan/os_read_failure_app.titan"))
    local output, why, compiled = command.compile(workspace,
      "os_read_failure_app", {"--no-uv-bootstrap"})
    test.assert(why == "exit" and compiled == 0,
                "could not compile unknown-signal child: " .. output)
    local child = system.spawn(command.program(workspace, "os_read_failure_app"),
                               {"unknown-signal"})
    defer cleanup_process(child)
    local first = child:wait()
    local second = child:wait()
    test.assert(first.signal == nil and
                first.signal_number == coverage_read_failure_uv.SIGALRM and
                first.signal_number > 0 and not child:is_running(),
                "unnamed terminating signal lost its native number")
    test.assert(second.code == first.code and second.signal == nil and
                second.signal_number == first.signal_number,
                "unnamed signal exit result was not sticky")
    test.assert(process_support.read_all(process_support.required_input(
                  child.stdout, "unknown-signal stdout")) == "" and
                process_support.read_all(process_support.required_input(
                  child.stderr, "unknown-signal stderr")) == "",
                "unknown-signal child produced unexpected output")
  end)
end

function test_coverage_parent_stdout_write_start_failure_restores_output(
    _context: test.Context)
  if common.is_windows() then
    test.skip("platform: wrong-direction inherited pipe requires POSIX pipe descriptors")
  end
  runtime_test.run(function ()
    local workspace = fs.tmpname()
    fs.unlink(workspace)
    fs.mkdir(workspace)
    runtime_test.cleanup(function () command.remove_tree(workspace) end)
    fs.write_file(workspace .. "/os_read_failure_app.titan",
      fs.read_file("spec/fixtures/stdlib/titan/os_read_failure_app.titan"))
    local output, why, compiled = command.compile(workspace,
      "os_read_failure_app", {"--no-uv-bootstrap"})
    test.assert(why == "exit" and compiled == 0,
                "could not compile write startup child: " .. output)
    local result_path = workspace .. "/write-start.result"
    local result, reason, status = command.capture({
      command.program(workspace, "os_read_failure_app"), "write-start", result_path,
    }, workspace)
    test.assert(reason == "exit" and status == 0 and
                result == "WRITE_START_COMPANION_MARKER" and
                fs.read_file(result_path) == "WRITE_START_FAILURE_OK:EPIPE",
                "write startup failure did not restore exact stdout and cause: " .. result)
  end)
end
