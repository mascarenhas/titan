local type ProcessChildCase = function (string): ()

local function with_process_child(body: ProcessChildCase)
  runtime_test.run(function ()
    body(process_support.child_path())
  end)
end

local function expect_cancelled_process_operation(action: function (): (),
                                                  label: string)
  local reason = async.CancellationReason.simple(label)
  local observed: value = nil
  local competitor = async.run<|value, value|>(function (): value
    async.running():cancel(reason)
    do action() catch observed = error end
    return nil
  end)
  task_support.cleanup_task(competitor, label .. " cleanup")
  async.join(competitor)
  -- Keep the assertion outside the cancelled Task, where it cannot be swallowed.
  test.assert(competitor:status():has_cancelled() and observed == reason,
              label .. " was replaced by a contention diagnostic")
end

function test_process_cancelled_waiter_allows_immediate_replacement(
    _context: test.Context)
  with_process_child(function (child: string)
    local process = system.spawn(child, {"echo"})
    defer cleanup_process(process)
    local input = process_support.required_output(process.stdin, "gated stdin")
    local reason = async.CancellationReason.simple("replace Process waiter")
    local observed: value = nil
    local old = async.run<|value, value|>(function (): value
      do process:wait() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(old, "old Process waiter cleanup")
    process_support.wait_until_waiting(old, "old Process waiter")
    expect_cancelled_process_operation(function () process:wait() end,
                                       "pending Process waiter cancellation")
    test.assert(old:status():as_string() == "waiting" and process:is_running(),
                "cancelled competitor disturbed the Process waiter")

    local release = async.run<|value, value|>(function (): value
      async.join(old)
      input:close()
      return nil
    end)
    task_support.cleanup_task(release, "Process exit release cleanup")
    old:cancel(reason)
    test.assert(observed == nil, "old Process waiter unwound before replacement")
    -- Enter the successor before yielding; the child exits only after the old
    -- waiter's defer has run, and must still deliver to the successor.
    process_support.assert_normal(process:wait(), "replacement Process waiter")
    async.join(release)
    test.assert(old:status():has_cancelled() and observed == reason,
                "old Process waiter lost its cancellation reason")
    test.assert(release:status():has_succeeded(), "Process exit release failed")
  end)
end

local function restore_process_environment(name: string, original: string?)
  if original then
    system.setenv(name, original as string)
  else
    system.unsetenv(name)
  end
end

function test_process_validates_inputs_and_preserves_argv_env_cwd(
    _context: test.Context)
  with_process_child(function (child: string)
    process_support.expect_failure(function ()
      system.spawn("", {})
    end, "spawn accepted an empty executable")
    process_support.expect_failure(function ()
      system.spawn(child .. "\0suffix", {})
    end, "spawn accepted an embedded NUL executable")
    process_support.expect_failure(function ()
      system.spawn(child, {"echo\0suffix"})
    end, "spawn accepted an embedded NUL argument")

    local envname = "TITAN_PROCESS_DIRECT_ENV"
    local original: string? = system.getenv(envname)
    local environment = "direct-continuation-process ação=東京"
    do
      defer restore_process_environment(envname, original)
      system.setenv(envname, environment)
      local previous_directory = system.cwd()
      local directory = fs.tmpname()
      fs.unlink(directory)
      directory = directory .. "-process cwd ação 東京"
      fs.mkdir(directory)
      defer fs.rmdir(directory)
      system.chdir(directory)
      defer system.chdir(previous_directory)
      local cwd = system.cwd()
      local arguments = {"alpha", "", "beta", "space argument", "quote\"value",
                         "trailing\\", "space trailing\\", "slash\\\"quote", "ação東京😀"}
      local command_line = {"argv-env-cwd", envname}
      for index = 1, #arguments do
        command_line[#command_line + 1] = arguments[index]
      end
      local process = system.spawn(child, command_line)
      defer cleanup_process(process)
      process_support.required_output(process.stdin, "metadata stdin"):close()
      local output = process_support.read_all(
        process_support.required_input(process.stdout, "metadata stdout"))
      local diagnostics = process_support.read_all(
        process_support.required_input(process.stderr, "metadata stderr"))
      process_support.assert_normal(process:wait(), "metadata child")
      local expected =
        "cwd:" .. #cwd .. ":" .. cwd .. "\n" ..
        "env:" .. #environment .. ":" .. environment .. "\n" ..
        "argv0:" .. #child .. ":" .. child .. "\n"
      for index = 1, #arguments do
        local argument = arguments[index]
        expected = expected .. "arg:" .. #argument .. ":" .. argument .. "\n"
      end
      test.assert(output == expected,
                  "spawn changed argv, environment, or cwd")
      test.assert(diagnostics == "", "metadata child wrote stderr")
    end
  end)
end

function test_process_preserves_binary_streams_status_and_signals(
    _context: test.Context)
  with_process_child(function (child: string)
    local payload = "head\0middle\r\n\26trail"
    local echoed = system.spawn(child, {"echo"})
    defer cleanup_process(echoed)
    local echo_input = process_support.required_output(
      echoed.stdin, "echo stdin")
    local echo_output = process_support.required_input(
      echoed.stdout, "echo stdout")
    local echo_error = process_support.required_input(
      echoed.stderr, "echo stderr")
    echo_input:write(payload)
    echo_input:close()
    echo_input:close()
    test.assert(process_support.read_all(echo_output) == payload,
                "captured process stream changed binary input")
    test.assert(process_support.read_all(echo_error) == "",
                "echo child wrote stderr")
    process_support.assert_normal(echoed:wait(), "echo child")
    process_support.assert_normal(echoed:wait(), "repeated echo wait")
    test.assert(not echoed:is_running(), "reaped child remained running")
    test.assert(not echo_output:read(), "echo pipe did not retain terminal EOF")

    local split = system.spawn(child, {"dual", "64"})
    defer cleanup_process(split)
    process_support.required_output(split.stdin, "dual stdin"):close()
    local split_stdout = process_support.read_all(
      process_support.required_input(split.stdout, "dual stdout"))
    local split_stderr = process_support.read_all(
      process_support.required_input(split.stderr, "dual stderr"))
    process_support.assert_normal(split:wait(), "dual-output child")
    test.assert(split_stdout == strings.rep("O", 64) and
                split_stderr == strings.rep("E", 64),
                "separate process captures changed")

    local exited = system.spawn(child, {"exit", "37"})
    defer cleanup_process(exited)
    process_support.required_output(exited.stdin, "exit stdin"):close()
    local first = exited:wait()
    local second = exited:wait()
    test.assert(first.code == 37 and not first.signal and
                first.signal_number == 0,
                "normal process exit status changed")
    test.assert(second.code == first.code and second.signal == first.signal and
                second.signal_number == first.signal_number,
                "repeated wait did not retain process status")
    process_support.expect_failure(function ()
      exited:kill("term")
    end, "kill targeted an exited Process")

    local killed = system.spawn(child, {"ready-wait"})
    defer cleanup_process(killed)
    process_support.required_output(killed.stdin, "kill stdin"):close()
    local killed_stdout = process_support.required_input(
      killed.stdout, "kill stdout")
    test.assert(killed_stdout:read_until("\n", true) == "READY",
                "kill child did not become ready")
    test.assert(killed:is_running(), "live child was not running")
    process_support.expect_failure(function ()
      killed:kill("not-a-signal")
    end, "Process accepted an unknown signal name")
    process_support.expect_failure(function ()
      killed:kill("term\0kill")
    end, "Process accepted an embedded-NUL signal name")
    test.assert(killed:is_running(),
                "invalid signal validation changed Process state")
    killed:kill("kill")
    local killed_status = killed:wait()
    test.assert(killed_status.signal == "kill" and
                killed_status.signal_number > 0,
                "signal termination was not preserved")
    test.assert(not killed:is_running(), "killed child remained running")
  end)
end

function test_process_cancellation_waits_for_accepted_callbacks(
    _context: test.Context)
  with_process_child(function (child: string)
    local process = system.spawn(child, {"ready-wait"})
    defer cleanup_process(process)
    process_support.required_output(process.stdin, "detached stdin"):close()
    local output = process_support.required_input(
      process.stdout, "detached stdout")
    test.assert(output:read_until("\n", true) == "READY",
                "detached-wait child did not become ready")

    local waiter = async.run<|value, value|>(function (): value
      process:wait()
      return nil
    end)
    task_support.cleanup_task(waiter, "detached process waiter cleanup")
    local reader = async.run<|value, value|>(function (): value
      output:read()
      return nil
    end)
    task_support.cleanup_task(reader, "detached process reader cleanup")
    process_support.wait_until_waiting(waiter, "process waiter")
    process_support.wait_until_waiting(reader, "process reader")
    waiter:cancel(async.CancellationReason.simple("detach process waiter"))
    reader:cancel(async.CancellationReason.simple("detach process reader"))
    test.assert(waiter:status():as_string() == "waiting" and
                reader:status():as_string() == "waiting",
                "process waiters left accepted operations before callbacks")
    process_support.wait_until_finished(waiter)
    process_support.wait_until_finished(reader)
    test.assert(waiter:status():as_string() == "cancelled" and
                reader:status():as_string() == "cancelled",
                "detached waiters did not receive later callbacks")
    test.assert(process:is_running(),
                "detaching waiters unexpectedly terminated the child")
    process:kill("kill")
    local status = process:wait()
    test.assert(status.signal == "kill" and status.signal_number > 0,
                "replacement wait lost process termination")
  end)
end

local function child_environment(child: string, names: {string},
                                  ...: system.SpawnOption): string
  local arguments: {string} = {"environment"}
  local index = 1
  while index <= #names do
    arguments[#arguments + 1] = names[index]
    index = index + 1
  end
  local process = system.spawn(child, arguments, ...)
  defer cleanup_process(process)
  process_support.required_output(process.stdin, "environment stdin"):close()
  local output = process_support.read_all(
      process_support.required_input(process.stdout, "environment stdout"))
  local diagnostics = process_support.read_all(
      process_support.required_input(process.stderr, "environment stderr"))
  process_support.assert_normal(process:wait(), "environment child")
  test.assert(diagnostics == "", "environment child wrote stderr")
  return output
end

function test_process_environment_overrides_inherit_without_mutating_parent(
    _context: test.Context)
  with_process_child(function (child: string)
    local name = "TITAN_PROCESS_CHILD_ENV"
    local unrelated = "TITAN_PROCESS_CHILD_INHERIT"
    local added = "TITAN_PROCESS_CHILD_NEW"
    local missing = "TITAN_PROCESS_CHILD_ABSENT"
    local original? = system.getenv(name)
    local original_unrelated? = system.getenv(unrelated)
    local original_added? = system.getenv(added)
    local original_missing? = system.getenv(missing)
    defer restore_process_environment(name, original)
    defer restore_process_environment(unrelated, original_unrelated)
    defer restore_process_environment(added, original_added)
    defer restore_process_environment(missing, original_missing)
    system.setenv(name, "parent")
    system.setenv(unrelated, "inherited")
    system.unsetenv(added)
    system.unsetenv(missing)
    local option = system.with_env(name, "child=first")
    local first = child_environment(child, {name, unrelated, added, missing},
        option, system.with_env(added, ""))
    test.assert(first == "env:11:child=first\nenv:9:inherited\nenv:0:\nabsent\n",
                "child environment did not inherit, override, or retain empty")
    test.assert(system.getenv(name) == "parent" and
                system.getenv(unrelated) == "inherited" and
                not system.getenv(added) and not system.getenv(missing),
                "spawn changed the parent's environment")
    local unicode = "ação=東京"
    test.assert(child_environment(child, {name}, system.with_env(name, unicode)) ==
                "env:" .. #unicode .. ":" .. unicode .. "\n",
                "child environment changed Unicode bytes")
    local second = child_environment(child, {name}, option,
        system.with_env(name, "last"))
    test.assert(second == "env:4:last\n", "later environment option did not win")
    test.assert(child_environment(child, {name, added}) ==
                "env:6:parent\nabsent\n", "options leaked into another spawn")
    system.setenv(unrelated, "late")
    test.assert(child_environment(child, {name, unrelated}, option) ==
                "env:11:child=first\nenv:4:late\n",
                "reused option did not inherit the current environment")
  end)
end

function test_process_environment_children_are_isolated(
    _context: test.Context)
  with_process_child(function (child: string)
    local name = "TITAN_PROCESS_CHILD_PARALLEL"
    local original? = system.getenv(name)
    defer restore_process_environment(name, original)
    system.setenv(name, "parent")
    local first = async.run<|string, value|>(function (): string
      return child_environment(child, {name}, system.with_env(name, "first"))
    end)
    task_support.cleanup_task(first, "first environment child cleanup")
    local second = async.run<|string, value|>(function (): string
      return child_environment(child, {name}, system.with_env(name, "second"))
    end)
    task_support.cleanup_task(second, "second environment child cleanup")
    local first_output, second_output = async.all_two(first, second)
    test.assert(first_output == "env:5:first\n" and
                second_output == "env:6:second\n",
                "concurrent children shared an environment override")
    test.assert(system.getenv(name) == "parent",
                "concurrent spawn changed the parent environment")
  end)
end

function test_process_environment_rejects_invalid_options_and_preserves_failure(
    _context: test.Context)
  with_process_child(function (child: string)
    local names: {string} = {"", "BAD=NAME", "BAD\0NAME"}
    local index = 1
    while index <= #names do
      local name = names[index]
      local later_called = false
      process_support.expect_failure(function ()
        system.spawn(child, {"exit", "0"}, system.with_env(name, "value"),
            function (_config: system.SpawnConfig): integer
              later_called = true
              return 0
            end)
      end, "spawn accepted invalid environment name")
      test.assert(not later_called, "spawn continued after invalid environment option")
      index = index + 1
    end
    process_support.expect_failure(function ()
      system.spawn(child, {"exit", "0"}, system.with_env("VALID", "BAD\0VALUE"))
    end, "spawn accepted embedded NUL in environment value")
    local name = "TITAN_PROCESS_CHILD_FAILURE"
    local original? = system.getenv(name)
    defer restore_process_environment(name, original)
    system.setenv(name, "parent")
    local rejected = false
    do
      local unexpected = system.spawn(child .. ".missing", {},
                                      system.with_env(name, "child"))
      cleanup_process(unexpected)
    catch
      test.assert(error is async.OperationError,
                  "missing executable raised a non-operation error")
      local failure = error as async.OperationError
      test.assert(failure.operation == "process.spawn" and failure.name == "ENOENT",
                  "missing executable lost its native spawn diagnostic")
      rejected = true
    end
    test.assert(rejected, "missing executable unexpectedly spawned")
    test.assert(system.getenv(name) == "parent",
                "failed spawn changed the parent environment")
    test.assert(child_environment(child, {name}) == "env:6:parent\n",
                "failed spawn contaminated the next child")
  end)
end

function test_process_environment_names_follow_native_case_rules(
    _context: test.Context)
  with_process_child(function (child: string)
    local upper = "TITAN_PROCESS_CHILD_CASE"
    local lower = "titan_process_child_case"
    local empty = "TITAN_PROCESS_CHILD_CASE_EMPTY"
    local absent = "TITAN_PROCESS_CHILD_CASE_ABSENT"
    local original_upper? = system.getenv(upper)
    local original_lower? = system.getenv(lower)
    local original_empty? = system.getenv(empty)
    local original_absent? = system.getenv(absent)
    defer restore_process_environment(lower, original_lower)
    defer restore_process_environment(upper, original_upper)
    defer restore_process_environment(empty, original_empty)
    defer restore_process_environment(absent, original_absent)
    system.unsetenv(lower)
    system.unsetenv(empty)
    system.unsetenv(absent)
    system.setenv(upper, "parent")
    local case_insensitive = system.getenv(lower) == "parent"
    local value = "last ação=東京"
    local actual = child_environment(child, {upper, lower, empty, absent},
        system.with_env(upper, "first"), system.with_env(lower, value),
        system.with_env(empty, ""))
    local field = "env:" .. #value .. ":" .. value .. "\n"
    local expected = "env:5:first\n" .. field .. "env:0:\nabsent\n"
    if case_insensitive then expected = field .. field .. "env:0:\nabsent\n" end
    test.assert(actual == expected, "child environment used wrong name equality")
    test.assert(system.getenv(upper) == "parent" and system.getenv(empty) == nil and
                system.getenv(absent) == nil, "case merge changed parent")
  end)
end

local function native_exit_case(context: test.Context, name: string, expected: integer)
  context:run(name, function (_child: test.Context)
    if expected > 255 and not common.is_windows() then
      test.skip("platform: POSIX process exit status contains only eight bits")
    end
    with_process_child(function (child: string)
      local process = system.spawn(child, {"exit", "" .. expected})
      defer cleanup_process(process)
      process_support.required_output(process.stdin, "exit stdin"):close()
      local output = process_support.read_all(
          process_support.required_input(process.stdout, "exit stdout"))
      local diagnostic = process_support.read_all(
          process_support.required_input(process.stderr, "exit stderr"))
      local status = process:wait()
      test.assert(status.code == expected and status.signal == nil and
                  status.signal_number == 0,
                  "native child exit was confused with shell failure or a signal")
      test.assert(output == "" and diagnostic == "", "exit child wrote unexpected output")
    end)
  end)
end

function test_native_exit_codes(context: test.Context)
  native_exit_case(context, "one", 1)
  native_exit_case(context, "one_twenty_six", 126)
  native_exit_case(context, "one_twenty_seven", 127)
  native_exit_case(context, "nine_thousand_nine", 9009)
end
