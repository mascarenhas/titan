local test = import "test"
local common = import "support.common.titan"
local async = import "async"
local stream = import "io"
local system = import "os"
local timer = import "timer"
local task_support = import "support.async.titan"

local type CheckedAction = function (): ()

local function child_path(): string
  const supplied? = system.getenv("TITAN_PROCESS_CHILD")
  if supplied and #supplied > 0 then return supplied end
  test.assert(not common.is_windows(),
              "runner did not supply the native Windows process fixture")
  return system.cwd() .. "/.titan-tests/os_process_host_child"
end

local function wait_until_waiting(task: async.Task, subject: string)
  while task:status():as_string() == "ready" or
        task:status():as_string() == "running" do
    async.yield()
  end
  test.assert(task:status():as_string() == "waiting",
              subject .. " did not suspend for its callback")
end

local function wait_until_finished(task: async.Task)
  while task_support.active(task) do async.yield() end
end

local function expect_failure(action: CheckedAction, message: string)
  local failed = false
  do
    action()
  catch
    failed = true
  end
  test.assert(failed, message)
end

local function required_input(candidate: system.InputStream?,
                              label: string): system.InputStream
  if not candidate then raise label .. " was not captured" end
  return candidate as system.InputStream
end

local function required_output(candidate: system.OutputStream?,
                               label: string): system.OutputStream
  if not candidate then raise label .. " was not captured" end
  return candidate as system.OutputStream
end

local function read_all(input: system.InputStream): string
  local result = ""
  for chunk in input:read do result = result .. chunk end
  return result
end

local function assert_normal(status: system.ExitStatus, label: string)
  test.assert(status.code == 0 and not status.signal and
              status.signal_number == 0,
              label .. " did not exit normally")
end

local function close_process_streams(process: system.Process)
  const input? = process.stdin
  if input then (input as system.OutputStream):close() end
  const output? = process.stdout
  if output then (output as system.InputStream):close() end
  const diagnostics? = process.stderr
  if diagnostics and diagnostics ~= output then
    (diagnostics as system.InputStream):close()
  end
end
