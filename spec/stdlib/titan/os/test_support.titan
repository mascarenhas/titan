local test = import "test"
local system = import "os"
local lua_api = foreign import "lua.h"
local lua_aux = foreign import "lauxlib.h"
local ffi = foreign import "titan/ffi.h"
local cstring = foreign import "string.h"
local ctime = foreign import "time.h"

local type CheckedAction = () -> ()

local function error_text(failure: value): string
  local result = "<unprintable error>"
  local top = lua_api.lua_gettop(L)
  defer lua_api.lua_settop(L, top)
  if lua_api.lua_checkstack(L, 2) ~= 0 then
    ffi.lua_pushtvalue(L, failure)
    lua_aux.luaL_tolstring(L, -1, nil)
    local rendered: value = ffi.lua_totvalue(L, -1)
    if rendered is string then result = rendered as string end
  end
  return result
end

local function contains(subject: string, fragment: string): boolean
  return cstring.strstr(subject, fragment) ~= nil
end

local function error_string_field(failure: value,
                                  name: string): string?
  local top = lua_api.lua_gettop(L)
  defer lua_api.lua_settop(L, top)
  if lua_api.lua_checkstack(L, 2) == 0 then return nil end
  ffi.lua_pushtvalue(L, failure)
  local field_type = lua_api.lua_getfield(L, -1, name)
  if field_type ~= lua_api.LUA_TSTRING then return nil end
  local field: value = ffi.lua_totvalue(L, -1)
  if field is string then return field as string end
  return nil
end

local function assert_raises_contains(action: CheckedAction,
                                      fragment: string)
  local caught = false
  do
    action()
  catch
    caught = true
    local message = error_text(error)
    test.assert(contains(message, fragment),
                "expected error containing '" .. fragment ..
                "', got '" .. message .. "'")
  end
  test.assert(caught, "expected an error containing '" .. fragment .. "'")
end

local function assert_operation_error(action: CheckedAction,
                                      operation: string)
  local caught = false
  do
    action()
  catch
    caught = true
    local actual? = error_string_field(error, "operation")
    test.assert(actual == operation,
                "expected operation '" .. operation ..
                "', got '" .. (actual or "<missing>") .. "'")
  end
  test.assert(caught, "expected operation error '" .. operation .. "'")
end

local function long_repeated(seed: string,
                             minimum: integer): string
  local contents = seed
  while #contents < minimum do contents = contents .. contents end
  return contents
end

local function restore_environment(name: string, original: string?)
  if original then
    system.setenv(name, original as string)
  else
    system.unsetenv(name)
  end
end

local function refresh_local_timezone()
  -- POSIX localtime behaves as though tzset had been called. Going through
  -- the public calendar operation keeps this setup portable across the two
  -- supported hosts without a feature-test-macro-only tzset declaration.
  system.date("%Y", 0)
end

local function install_test_timezone(): string?
  local original: string? = system.getenv("TZ")
  system.setenv("TZ", "EST5EDT,M3.2.0/2,M11.1.0/2")
  refresh_local_timezone()
  return original
end

local function restore_test_timezone(original: string?)
  restore_environment("TZ", original)
  refresh_local_timezone()
end

local function as_string(candidate: value,
                         subject: string): string
  test.assert(candidate is string,
              subject .. " did not return a string")
  return candidate as string
end

local function as_date(candidate: value,
                       subject: string): system.Date
  test.assert(candidate is system.Date,
              subject .. " did not return an os.Date")
  return candidate as system.Date
end

local function host_time(): integer
  return ctime.time(nil) as integer
end

local function c_utc_format(format: string): string
  local instant = 0 as ctime.time_t
  local calendar = ctime.gmtime(instant)
  if not calendar then raise "gmtime could not represent the epoch" end
  local storage = char.new_array(256)
  local written = ctime.strftime(
    storage as *char,
    256 as cstring.size_t, format, calendar)
  if written == 0 then raise "strftime did not fit the test buffer" end
  local bytes = storage as *char
  return bytes as string
end
