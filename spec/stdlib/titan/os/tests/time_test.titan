foreign import "time.h"

local function coverage_locale_has_empty_ampm(): boolean
  const instant = 0 as foreign time_t
  const calendar = ffi.gmtime(instant)
  if not calendar then raise "gmtime could not represent the epoch" end
  local storage = foreign char.new_array(256)
  const written = ffi.strftime(storage as foreign *char,
    256 as foreign size_t, "[%p]", calendar)
  return written == 2 and storage[0] == 91 and storage[1] == 93 and
         storage[2] == 0
end

function test_date_growth_and_invalid_inputs(_context: test.Context)
  local format = ""
  local expected = ""
  for _ = 1, 1024 do
    format = format .. "%Y"
    expected = expected .. "1970"
  end
  test.assert(support.as_string(system.date("!" .. format, 0),
                        "long formatted date") == expected,
              "long date output was truncated")
  test.assert(support.as_string(system.date("!", 0),
                        "empty UTC format") == "")

  support.assert_raises_contains(function()
    system.date("%Q", 0)
  end, "invalid conversion specifier '%Q'")
  support.assert_raises_contains(function()
    system.date("%", 0)
  end, "invalid conversion specifier '%'")
  support.assert_raises_contains(function()
    system.date("%Y\0suffix", 0)
  end, "date format contains an embedded NUL")
  support.assert_raises_contains(function()
    system.time(2020)
  end, "time requires year, month, and day together")
  support.assert_raises_contains(function()
    system.time(nil, nil, nil, 12)
  end, "time requires year, month, and day together")
  support.assert_raises_contains(function()
    system.time(9223372036854775807, 1, 1)
  end, "time field 'year' is out of range")
end

function test_locale_query_change_restore_and_validation(
    _context: test.Context)
  const previous: string? = system.setlocale(nil, "time")
  test.assert(previous ~= nil, "could not query LC_TIME")
  const saved = previous as string
  defer do
    const restored: string? = system.setlocale(saved, "time")
    test.assert(restored ~= nil, "could not restore LC_TIME")
  end

  test.assert(system.setlocale("C", "time") == "C")
  test.assert(system.setlocale(nil, "time") == "C")
  test.assert(support.as_string(system.date("!%c", 0), "C-locale date") ==
              support.c_utc_format("%c"),
              "C-locale date differed from ISO C strftime")

  support.assert_raises_contains(function()
    system.setlocale("C", "unknown")
  end, "invalid locale category 'unknown'")
  support.assert_raises_contains(function()
    system.setlocale("C\0suffix", "time")
  end, "locale name contains an embedded NUL")
  support.assert_raises_contains(function()
    system.setlocale("C", "time\0suffix")
  end, "locale category contains an embedded NUL")
end

function test_date_accepts_empty_locale_conversion(_context: test.Context)
  const previous: string? = system.setlocale(nil, "time")
  test.assert(previous ~= nil, "could not query LC_TIME")
  const saved = previous as string
  defer do
    const restored: string? = system.setlocale(saved, "time")
    test.assert(restored ~= nil, "could not restore LC_TIME")
  end

  test.assert(system.setlocale("C", "time") == "C")
  test.assert(support.c_utc_format("%p") == "AM" and
              support.as_string(system.date("!%p", 0), "C-locale AM/PM") == "AM",
              "C-locale control did not render AM")
  const candidates = {
    "fr_FR.UTF-8", "fr_FR.utf8", "fr_FR", "fr-FR", "French_France.1252",
    "en_DK.UTF-8", "en_DK.utf8", "en_DK",
    "da_DK.UTF-8", "da_DK.utf8", "da_DK", "da-DK",
    "de_DE.UTF-8", "de_DE.utf8", "de_DE", "de-DE",
  }
  for index = 1, #candidates do
    if system.setlocale(candidates[index], "time") ~= nil and
        coverage_locale_has_empty_ampm() then
      test.assert(support.as_string(system.date("!%p", 0),
                    "empty locale conversion") == "",
                  "valid empty AM/PM conversion did not return an empty string")
      return
    end
  end
  test.skip("capability: no installed LC_TIME locale has empty AM/PM text")
end

function test_date_constructor_builds_the_utc_epoch_fields(_context: test.Context)
  const built = system.Date { year = 1970, month = 1, day = 1, hour = 0, min = 0, sec = 0,
    wday = 5, yday = 1, isdst = false }
  const epoch: system.Date = system.date("!*t", 0)
  test.assert(built.year == epoch.year and built.month == epoch.month and built.day == epoch.day and
    built.hour == epoch.hour and built.min == epoch.min and built.sec == epoch.sec and
    built.wday == epoch.wday and built.yday == epoch.yday,
    "the Date constructor and the UTC epoch decomposition disagree")
  test.assert(built.isdst == false, "the Date constructor dropped its daylight-saving flag")
end
