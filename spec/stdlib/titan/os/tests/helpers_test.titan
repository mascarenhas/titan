function test_environment_helpers_preserve_real_values(
    _context: test.Context)
  local name = "TITAN_OS_TEST_ENVIRONMENT_VALUE"
  local original: string? = system.getenv(name)
  defer support.restore_environment(name, original)

  system.unsetenv(name)
  test.assert(system.getenv(name) == nil,
              "missing environment variable did not return nil")

  system.setenv(name, "")
  local empty: string? = system.getenv(name)
  test.assert(empty ~= nil and (empty as string) == "",
              "empty environment value was confused with absence")

  local long_value = support.long_repeated("0123456789abcdef", 8192)
  system.setenv(name, long_value)
  local copied: string? = system.getenv(name)
  test.assert(copied ~= nil and (copied as string) == long_value,
              "long environment value was truncated during resize")

  support.restore_environment(name, original)
  local restored: string? = system.getenv(name)
  if original then
    test.assert(restored ~= nil and
                (restored as string) == (original as string),
                "existing environment value was not restored")
  else
    test.assert(restored == nil,
                "previously missing environment variable leaked")
  end
end

function test_text_helpers_reject_embedded_nul(
    _context: test.Context)
  local name = "TITAN_OS_TEST_NUL_VALUE"
  local original: string? = system.getenv(name)
  defer support.restore_environment(name, original)

  support.assert_operation_error(function()
    system.getenv(name .. "\0get")
  end, "os.getenv")
  support.assert_operation_error(function()
    system.setenv(name .. "\0set", "value")
  end, "os.setenv")
  support.assert_operation_error(function()
    system.setenv(name, "value\0suffix")
  end, "os.setenv")
  support.assert_operation_error(function()
    system.unsetenv(name .. "\0unset")
  end, "os.unsetenv")
end

