local function coverage_calendar_rejection(context: test.Context,
                                           name: string, format: string)
  context:run(name, function (_: test.Context)
    support.assert_raises_contains(function () system.date(format, 0) end,
                                  "invalid conversion specifier '" .. format .. "'")
  end)
end

function test_coverage_calendar_modifier_validation(context: test.Context)
  coverage_calendar_rejection(context, "incomplete_E", "%E")
  coverage_calendar_rejection(context, "incomplete_O", "%O")
  coverage_calendar_rejection(context, "invalid_E", "%Ez")
  coverage_calendar_rejection(context, "invalid_O", "%OQ")
end

function test_coverage_calendar_missing_and_out_of_range_fields(
    _context: test.Context)
  support.assert_raises_contains(function () system.time { min = 1 } end,
                                "time requires year, month, and day together")
  support.assert_raises_contains(function () system.time { sec = 1 } end,
                                "time requires year, month, and day together")
  support.assert_raises_contains(function ()
    system.time(-9223372036854775807, 1, 1)
  end, "time field 'year' is out of range")
  support.assert_raises_contains(function ()
    system.date("!*t", 9223372036854775807)
  end, "date result cannot be represented in this installation")
  support.assert_raises_contains(function ()
    system.date("!*t", -9223372036854775807)
  end, "date result cannot be represented in this installation")
end

