local async = import "async"
local runtime_test = import "support.runtime.titan"
foreign import "errno.h"

local type BrowserAction = function (): ()

local function browser_expect_text(action: BrowserAction, expected: string)
  local caught = false
  do
    action()
  catch
    caught = true
    test.assert(error == expected, "browser stream raised a different context error")
  end
  test.assert(caught, "browser operation unexpectedly succeeded")
end

local function browser_expect_operation(action: BrowserAction,
                                         expected: async.OperationError)
  local caught = false
  do
    action()
  catch
    if not (error is async.OperationError) then raise end
    local failure: async.OperationError = error
    caught = true
    test.assert(failure.code == expected.code and failure.name == expected.name and
      failure.message == expected.message and failure.operation == expected.operation,
      "browser operation raised different error fields")
  end
  test.assert(caught, "browser operation unexpectedly succeeded")
end

local function browser_expect_unavailable(action: BrowserAction, member: string)
  browser_expect_operation(action, async.OperationError {
    code = -ffi.ENOSYS, name = "ENOSYS",
    message = member .. " is unavailable on the browser target", operation = member,
  })
end

local function browser_task_case(context: test.Context, name: string, action: BrowserAction)
  context:run(name, function (_child: test.Context)
    browser_expect_text(action, "async Runtime is not active")
    runtime_test.run(function ()
      local outcome = async.await<|nil, nil|>(function (resolve, reject, fatal)
        browser_expect_text(action, "asynchronous operation must be called from an async Task")
        resolve(nil)
      end)
      case outcome
      when success() then
      when error() then raise "context probe unexpectedly failed"
      end
    end)
  end)
end

function test_browser_stdio_requires_a_runtime_and_task(context: test.Context)
  browser_task_case(context, "read", function () system.stdin:read() end)
  browser_task_case(context, "read_until", function () system.stdin:read_until("\n", true) end)
  browser_task_case(context, "input_kind", function () system.stdin:kind() end)
  browser_task_case(context, "input_tty", function () system.stdin:is_tty() end)
  browser_task_case(context, "write", function () system.stdout:write("") end)
  browser_task_case(context, "shutdown", function () system.stdout:shutdown() end)
  browser_task_case(context, "output_kind", function () system.stdout:kind() end)
  browser_task_case(context, "output_tty", function () system.stdout:is_tty() end)
end

function test_browser_read_until_preserves_native_delimiter_validation(_context: test.Context)
  browser_expect_text(function () system.stdin:read_until("", true) end,
    "read delimiter must not be empty")
end

local function browser_output_case(context: test.Context, name: string,
                                    output: system.OutputStream)
  context:run(name, function (_child: test.Context)
    output:close()
    output:close()
    runtime_test.run(function ()
      output:write("")
      output:write("browser " .. name .. " bytes: \0\255\n")
      browser_expect_operation(function () output:shutdown() end,
        async.OperationError { code = -ffi.ENOTSUP, name = "ENOTSUP",
          message = "operation not supported on socket", operation = "stdio.shutdown" })
      output:write("browser " .. name .. " remains open\n")
      local tty = output:is_tty()
      do
        local kind = output:kind()
        test.assert(kind == "tty" or kind == "pipe" or kind == "file" or kind == "tcp",
          "declared output kind is not one of the four backings")
        test.assert(tty == (kind == "tty"), "declared output kind disagrees with is_tty")
      catch
        if not (error is async.OperationError) then raise end
        local failure: async.OperationError = error
        test.assert(failure.name == "ENOSYS" and failure.operation == "os.OutputStream.kind",
          "undeclared output kind raised a different error")
        test.assert(not tty, "undeclared output kind reported a TTY")
      end
    end)
  end)
end

function test_browser_parent_output_uses_the_sdk_sources(context: test.Context)
  browser_output_case(context, "stdout", system.stdout)
  browser_output_case(context, "stderr", system.stderr)
end

function test_browser_parent_input_without_a_source_is_unavailable(_context: test.Context)
  system.stdin:close()
  system.stdin:close()
  runtime_test.run(function ()
    browser_expect_unavailable(function () system.stdin:read() end, "os.InputStream.read")
    browser_expect_unavailable(function () system.stdin:read() end, "os.InputStream.read")
    browser_expect_unavailable(function () system.stdin:read_until("\n", true) end,
      "os.InputStream.read_until")
    browser_expect_unavailable(function () system.stdin:kind() end, "os.InputStream.kind")
    test.assert(not system.stdin:is_tty(), "undeclared input kind reported a TTY")
  end)
end

function test_browser_exit_outside_a_task_keeps_the_instance_usable(_context: test.Context)
  browser_expect_text(function () system.exit(19) end,
    "os.exit is unavailable outside an async Task on the browser target")
  runtime_test.run(function () system.stdout:write("") end)
end

local function browser_output_payload(stream: system.OutputStream): string
  case async.TransferValue.from_value(stream)
  when is_record_payload(module, name, payload) then
    test.assert(module == "titan.os" and name == "titan.os.OutputStream",
      "parent output used a different record payload")
    return payload
  else raise "parent output did not use its transfer payload hook"
  end
end

function test_browser_parent_output_adoption_names_its_descriptor(_context: test.Context)
  local original_stdout = system.stdout
  local original_stderr = system.stderr
  local stdout_bytes = browser_output_payload(original_stdout)
  local stdout_payload = async.TransferValue.from_value(original_stdout)
  local stderr_payload = async.TransferValue.from_value(original_stderr)
  defer do
    system.stdout = original_stdout
    system.stderr = original_stderr
  end
  system.stdout = original_stderr
  system.stderr = original_stdout
  local restored_stdout: system.OutputStream = stdout_payload:to_value()
  local restored_stderr: system.OutputStream = stderr_payload:to_value()
  test.assert(restored_stdout == original_stdout and restored_stderr == original_stderr,
    "parent output adoption followed a reassigned module variable")
  system.stderr = original_stderr
  local unbound: system.OutputStream =
    async.TransferValue.from_value(original_stdout):to_value()
  test.assert(unbound ~= original_stderr and browser_output_payload(unbound) == stdout_bytes,
    "adoption without a bound stdout facade changed its descriptor")
end

function test_browser_environment_starts_empty_and_reports_invalid_names(_context: test.Context)
  test.assert(system.getenv("HOME") == nil and system.getenv("USER") == nil,
    "the runner invented an environment variable")
  local expected = async.OperationError { code = -ffi.EINVAL, name = "EINVAL",
    message = "invalid argument", operation = "os.setenv" }
  browser_expect_operation(function () system.setenv("", "value") end, expected)
  browser_expect_operation(function () system.setenv("BAD=NAME", "value") end, expected)
  expected = async.OperationError { code = -ffi.EINVAL, name = "EINVAL",
    message = "invalid argument", operation = "os.unsetenv" }
  browser_expect_operation(function () system.unsetenv("") end, expected)
  browser_expect_operation(function () system.unsetenv("BAD=NAME") end, expected)
end

function test_browser_calendar_uses_utc_and_the_host_wall_clock(_context: test.Context)
  local epoch: system.Date = system.date("!*t", 0)
  test.assert(epoch.year == 1970 and epoch.month == 1 and epoch.day == 1 and
    epoch.hour == 0 and epoch.min == 0 and epoch.sec == 0 and epoch.wday == 5,
    "UTC epoch decomposition changed")
  local normalized = system.time(2020, 2, 30, 4, 5, 6)
  test.assert(normalized == system.time(2020, 3, 1, 4, 5, 6), "calendar normalization changed")
  local calendar: system.Date = system.date("*t", normalized)
  test.assert(calendar.year == 2020 and calendar.month == 3 and calendar.day == 1 and
    calendar.hour == 4 and calendar.min == 5 and calendar.sec == 6,
    "local decomposition of a normalized time changed")
  local now = system.time()
  local delta = now - support.host_time()
  if delta < 0 then delta = -delta end
  test.assert(delta <= 1, "browser time is not the host wall clock")
  test.assert(system.difftime(27, 9) == 18.0, "difftime is not later minus earlier")
end

function test_browser_locale_retains_unknown_names_with_c_formatting(_context: test.Context)
  local previous: string = system.setlocale(nil, "time")
  defer do
    test.assert(system.setlocale(previous, "time") ~= nil, "could not restore LC_TIME")
  end
  test.assert(system.setlocale("C", "time") == "C", "could not select the C LC_TIME")
  local c_format = support.as_string(system.date("!%c", 0), "C-locale calendar format")
  local const selected = "titan-test"
  test.assert(system.setlocale(selected, "time") == selected,
    "an unknown valid locale name was not selected")
  test.assert(system.setlocale(nil, "time") == selected,
    "the LC_TIME query did not return the selected name")
  test.assert(support.as_string(system.date("!%c", 0), "selected-locale calendar format") ==
    c_format, "selected locale changed C calendar formatting")
end
