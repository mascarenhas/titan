local gclib = import "titan.gc"
local tlua = import "titan.lua"

local lua_api = foreign import "lua.h"
local lua_aux = foreign import "lauxlib.h"
local ffi = foreign import "titan/ffi.h"
local cstring = foreign import "string.h"
