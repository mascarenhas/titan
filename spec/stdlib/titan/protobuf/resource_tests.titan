local test = import "test"
local protobuf = import "protobuf"
local reflect = import "reflect"
local thread = import "thread"
local support = import "protobuf.tests.titan"
foreign import "protobuf_fixture.h"

local function check_nil_context_endpoint_encode_refused(
    tx: thread.Sender<|integer|>)
  local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
  ffi.titan_protobuf_buf_init_heap(buf, 0)
  defer ffi.titan_protobuf_buf_free_heap(buf)

  local rejected = false
  do
    protobuf.serialize_fields_to_buffer_with_context(
      buf as foreign *void, {support.descriptor(tx)}, nil, tx)
  catch
    rejected = true
    test.assert(error == "transfer: resource attachment requires an encode scope",
      "explicit nil encode context raised a different error")
  end
  test.assert(rejected, "explicit nil context authorized endpoint encoding")
end

local function check_nil_context_endpoint_decode_refused()
  local buf: owned *titan_protobuf_buffer = foreign titan_protobuf_buffer.new()
  ffi.titan_protobuf_buf_init_heap(buf, 0)
  defer ffi.titan_protobuf_buf_free_heap(buf)
  -- Copy a synthetic field-1 attachment index into storage owned through decode.
  -- The string argument is borrowed only for this copying C call.
  test.assert(ffi.titan_protobuf_buf_write_bytes(buf, 10, "\0\0\0\0", 4) ~= 0,
    "could not prepare endpoint wire bytes")
  local fields: const {reflect.Type} = {
    reflect.Type.is_named(reflect.NamedType("titan.thread.Sender")),
  }

  local rejected = false
  do
    protobuf.deserialize_fields_buffer_with_context(
      buf.data as foreign const *void, buf.length as integer, fields, nil)
  catch
    rejected = true
    test.assert(error == "transfer: resource claim requires a decode scope",
      "explicit nil decode context raised a different error")
  end
  test.assert(rejected, "explicit nil context authorized endpoint decoding")
end

record NilContextEncodeProbe
  local tx: thread.Sender<|integer|>
end

function NilContextEncodeProbe:to_transfer_payload(): string
  check_nil_context_endpoint_encode_refused(self.tx)
  return protobuf.serialize_fields({support.descriptor(self.tx)}, self.tx)
end

function NilContextEncodeProbe.from_transfer_payload(
    payload: string): NilContextEncodeProbe
  local tx: thread.Sender<|integer|> = protobuf.deserialize_fields(payload, {
    reflect.Type.is_named(reflect.NamedType("titan.thread.Sender")),
  })
  return NilContextEncodeProbe(tx)
end

record NilContextDecodeProbe
  local tx: thread.Sender<|integer|>
end

function NilContextDecodeProbe:to_transfer_payload(): string
  return protobuf.serialize_fields({support.descriptor(self.tx)}, self.tx)
end

function NilContextDecodeProbe.from_transfer_payload(
    payload: string): NilContextDecodeProbe
  check_nil_context_endpoint_decode_refused()
  local tx: thread.Sender<|integer|> = protobuf.deserialize_fields(payload, {
    reflect.Type.is_named(reflect.NamedType("titan.thread.Sender")),
  })
  return NilContextDecodeProbe(tx)
end

function test_anonymous_fields_buffer_nil_context_rejects_standalone_encode(
    _context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  check_nil_context_endpoint_encode_refused(tx)
end

function test_anonymous_fields_buffer_nil_context_rejects_standalone_decode(
    _context: test.Context)
  check_nil_context_endpoint_decode_refused()
end

function test_anonymous_fields_buffer_nil_context_rejects_active_encode_hook(
    _context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  local carrier_tx, carrier_rx = thread.channel<|NilContextEncodeProbe|>(1)
  defer carrier_tx:close()
  defer carrier_rx:close()

  -- Explicit nil refuses authority in the same hook where the public wrapper attaches.
  test.assert(carrier_tx:try_send(NilContextEncodeProbe(tx)))
  local available, decoded? = carrier_rx:try_receive()
  test.assert(available and decoded ~= nil, "ordinary encode hook did not round-trip")
  local destination_tx = decoded.tx
  defer destination_tx:close()
  test.assert(destination_tx ~= tx, "ambient encode reused the source Sender wrapper")
  test.assert(destination_tx:try_send(314), "ambient encode Sender could not send")
  local received, number? = rx:try_receive()
  test.assert(received and number == 314,
    "ambient encode Sender did not deliver to its live peer")
end

function test_anonymous_fields_buffer_nil_context_rejects_active_decode_hook(
    _context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  local carrier_tx, carrier_rx = thread.channel<|NilContextDecodeProbe|>(1)
  defer carrier_tx:close()
  defer carrier_rx:close()

  -- Explicit nil refuses authority in the same hook where the public wrapper claims.
  test.assert(carrier_tx:try_send(NilContextDecodeProbe(tx)))
  local available, decoded? = carrier_rx:try_receive()
  test.assert(available and decoded ~= nil, "ordinary decode hook did not round-trip")
  local destination_tx = decoded.tx
  defer destination_tx:close()
  test.assert(destination_tx ~= tx, "ambient decode reused the source Sender wrapper")
  test.assert(destination_tx:try_send(271), "ambient decode Sender could not send")
  local received, number? = rx:try_receive()
  test.assert(received and number == 271,
    "ambient decode Sender did not deliver to its live peer")
end

record EndpointJob
  id: integer
  body: string
  reply: thread.Sender<|integer|>
  maybe: thread.Sender<|integer|>?
end

function test_generated_codecs_raise_reflective_endpoint_errors(context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  support.check_same_error(context, "endpoint_without_packet_scope", function ()
    protobuf.serialize(EndpointJob(1, "x", tx, nil))
  end, "requires an encode scope")
end

function test_generated_codecs_carry_endpoints_in_packets(_context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  test.assert(protobuf.find_generated_codec(EndpointJob(1, "x", tx, nil)) ~= nil)
  local decoded: EndpointJob = support.backpatch_transfer_roundtrip(EndpointJob(7, "body", tx, tx))
  test.assert(decoded.id == 7 and decoded.body == "body")
  test.assert(decoded.reply ~= tx, "a decoded endpoint is a fresh wrapper")
  decoded.reply:send(21)
  test.assert(rx:receive() == 21, "the decoded endpoint lost its channel")
  -- The inferred local forces the optional endpoint, raising if it is absent.
  local maybe = decoded.maybe
  maybe:send(22)
  test.assert(rx:receive() == 22)
end

function test_value_fields_carry_endpoints_in_packets(_context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  local decoded: support.AnyValue = support.backpatch_transfer_roundtrip(support.AnyValue(tx))
  local reply: thread.Sender<|integer|> = decoded.item
  reply:send(9)
  test.assert(rx:receive() == 9, "a dynamic endpoint lost its channel")
end
