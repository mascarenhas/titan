function test_generated_codecs_bound_wide_union_frames(context: test.Context)
  check_generated_codec(context, "first_variant", WideGeneratedChoice.v1(7))
  check_generated_codec(context, "last_variant", WideGeneratedChoice.v64(73))
  local first = protobuf.serialize(WideGeneratedChoice.v1(7))
  local last = protobuf.serialize(WideGeneratedChoice.v64(73))
  local target = descriptor(WideGeneratedChoice.v64(0))
  check_decode_outcome(context, "replaced_variant", first .. last, target)
  check_decode_outcome(context, "repeated_variant", last .. last, target)
  check_decode_outcome(context, "unknown_variant", backpatch_field(65, "") .. last, target)
  check_decode_outcome(context, "invalid_trailing_field", last .. string.char(0), target)
  check_decode_outcome(context, "missing_variant", "", target)
  check_decode_outcome(context, "nonmessage_variant", string.char(8, 0), target)
end

local function check_decode_outcome(context: test.Context, name: string,
    bytes: string, target: reflect.Type)
  context:run(name, function (_: test.Context)
    local generated = decode_outcome(bytes, target, true)
    local reflective = decode_outcome(bytes, target, false)
    test.assert(generated == reflective, generated .. " ~= " .. reflective)
  end)
end

function test_generated_codecs_decode_every_wire_reflectively(context: test.Context)
  local integer_type = descriptor(IntegerValue(0))
  local node_type = descriptor(Node("", nil))
  local choice_type = descriptor(Choice.empty())
  local holder_type = descriptor(ChoiceHolder(Choice.empty(), nil))
  local nil_type = descriptor(NilValue(nil))
  local boolean_type = descriptor(BooleanValue(false, nil))
  local hooked_type = descriptor(HookedEnvelope(1, HookedToken(1, ""), nil, {}))
  check_decode_outcome(context, "empty", "", integer_type)
  check_decode_outcome(context, "zero_field", string.char(0), integer_type)
  check_decode_outcome(context, "truncated_varint", string.char(8, 128), integer_type)
  check_decode_outcome(context, "varint_overflow",
      string.char(8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 2), integer_type)
  check_decode_outcome(context, "wrong_wire", string.char(10, 0), integer_type)
  check_decode_outcome(context, "invalid_wire", string.char(14), integer_type)
  check_decode_outcome(context, "invalid_key",
      string.char(128, 128, 128, 128, 128, 1), integer_type)
  check_decode_outcome(context, "truncated_field", string.char(10, 5, 1), node_type)
  check_decode_outcome(context, "invalid_length",
      string.char(10, 255, 255, 255, 255, 15), node_type)
  check_decode_outcome(context, "group", string.char(11, 12), integer_type)
  check_decode_outcome(context, "group_then_field", string.char(19, 8, 1, 20, 8, 2), integer_type)
  check_decode_outcome(context, "mismatched_group", string.char(19, 28), integer_type)
  check_decode_outcome(context, "unterminated_group", string.char(19, 8, 1), integer_type)
  check_decode_outcome(context, "repeated_last_wins", string.char(8, 2, 8, 4), integer_type)
  check_decode_outcome(context, "unknown_first", string.char(16, 1, 8, 2), integer_type)
  check_decode_outcome(context, "unknown_bytes", string.char(8, 2, 42, 3) .. "abc", integer_type)
  check_decode_outcome(context, "nonminimal_key", string.char(136, 0, 2), integer_type)
  check_decode_outcome(context, "invalid_boolean", string.char(8, 2), boolean_type)
  check_decode_outcome(context, "present_nil_field", string.char(10, 0), nil_type)
  check_decode_outcome(context, "present_nil_bad_slice", string.char(10, 1, 8), nil_type)
  check_decode_outcome(context, "reordered", backpatch_field(2, backpatch_field(1, "t"))
      .. backpatch_field(1, "h"), node_type)
  check_decode_outcome(context, "merged_next", backpatch_field(1, "h")
      .. backpatch_field(2, backpatch_field(1, "a"))
      .. backpatch_field(2, backpatch_field(1, "b")), node_type)
  check_decode_outcome(context, "union_replaced", string.char(10, 0, 18, 2, 8, 4), choice_type)
  check_decode_outcome(context, "union_merged",
      string.char(18, 2, 8, 4, 18, 3, 18, 1, 120), choice_type)
  check_decode_outcome(context, "union_missing", "", choice_type)
  check_decode_outcome(context, "union_wrong_wire", string.char(8, 0), choice_type)
  check_decode_outcome(context, "union_field_missing", "", holder_type)
  check_decode_outcome(context, "union_field_bad", backpatch_field(1, string.char(8, 0)),
      holder_type)
  check_decode_outcome(context, "hooked_field_failure",
      string.char(8, 2) .. backpatch_field(2, "bad-hook"), hooked_type)
end

record Ring
  name: string
  items: {Ring}
end

-- A handed-off field decodes from its single occurrence; a repeated one merges
-- through its whole message; an absent one is nil or the missing-field error.
-- Construction converts handed-off fields only after every field decoded, as
-- the reflective constructor runs after decode_record.
function test_generated_codecs_hand_off_field_occurrences(context: test.Context)
  local ring_type = descriptor(Ring("", {}))
  -- One Array slot holding the element as its field 1.
  local slot = backpatch_field(1, backpatch_field(1,
      backpatch_field(1, "s") .. backpatch_field(2, "")))
  local single = backpatch_field(1, "r") .. backpatch_field(2, slot)
  check_decode_outcome(context, "single_array", single, ring_type)
  test.assert(string.sub(decode_outcome(single, ring_type, true), 1, 3) == "ok ")
  check_decode_outcome(context, "merged_array", protobuf.serialize(Ring("r", {}))
      .. backpatch_field(2, slot), ring_type)
  check_decode_outcome(context, "missing_array", backpatch_field(1, "r"), ring_type)
  local packet = foreign titan_protobuf_packet.new()
  local row = foreign int.new_array(3)
  local embedded_type = descriptor(Embedded(packet, row))
  -- A second packet occurrence merges a fourth row element, which only
  -- construction rejects.
  local oversized = protobuf.serialize(Embedded(packet, row))
      .. backpatch_field(1, backpatch_field(2, backpatch_field(1, string.char(8, 2))))
  check_decode_outcome(context, "conversion_error", oversized, embedded_type)
  local both = oversized .. string.char(16, 1)
  check_decode_outcome(context, "decode_error_before_conversion", both, embedded_type)
  test.assert(string.find(decode_outcome(both, embedded_type, true),
      "unexpected wire type", 1, true) ~= nil, "a later field must fail first")
end

-- A hook below a generated frame drops the last reference to that frame's
-- record and collects; the frame keeps encoding the record it rooted.
record DroppingToken
  const label: string
end

record DroppingChild
  token: DroppingToken
  label: string
end

record DroppingParent
  child: DroppingChild?
end

local dropping_parent: DroppingParent? = nil

function DroppingToken:to_transfer_payload(): string
  local parent? = dropping_parent
  dropping_parent = nil
  if parent ~= nil then parent.child = nil end
  gc.collect()
  return self.label
end

function DroppingToken.from_transfer_payload(payload: string): DroppingToken
  return DroppingToken(payload)
end

local function dropping_bytes(generated: boolean): string
  local previous = protobuf.use_generated_codecs(generated)
  defer protobuf.use_generated_codecs(previous)
  local parent = DroppingParent(DroppingChild(DroppingToken("token"),
      string.rep("label", 20)))
  dropping_parent = parent
  return protobuf.serialize(parent)
end

function test_generated_encode_frames_root_their_record(_context: test.Context)
  test.assert(protobuf.find_generated_codec(DroppingParent(nil)) ~= nil)
  test.assert(dropping_bytes(true) == dropping_bytes(false),
      "a generated frame lost its record to a collecting hook")
end

record EndpointJob
  id: integer
  body: string
  reply: thread.Sender<|integer|>
  maybe: thread.Sender<|integer|>?
end

function test_generated_codecs_raise_reflective_errors(context: test.Context)
  local cyclic = Node("cycle", nil)
  cyclic.next = cyclic
  check_same_error(context, "cycle", function () protobuf.serialize(cyclic) end,
      "cyclic object graph")
  local ring = Ring("ring", {})
  ring.items[1] = Ring("inner", {ring})
  check_same_error(context, "cycle_through_reflective_array", function ()
    protobuf.serialize(ring)
  end, "cyclic object graph")
  check_same_error(context, "cycle_in_packet", function ()
    backpatch_transfer_roundtrip(ring)
  end, "cyclic object graph")
  check_same_error(context, "depth_128", function ()
    protobuf.serialize(node_chain(128))
  end, "nesting exceeds 128")
  check_same_error(context, "hook_failure_under_generated_parent", function ()
    protobuf.serialize(HookedChoice.single(HookedToken(-1, "neg")))
  end, "hooked token encode rejected negative secret")
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  check_same_error(context, "endpoint_without_packet_scope", function ()
    protobuf.serialize(EndpointJob(1, "x", tx, nil))
  end, "requires an encode scope")
end

function test_generated_codecs_carry_endpoints_in_packets(_context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  test.assert(protobuf.find_generated_codec(EndpointJob(1, "x", tx, nil)) ~= nil)
  local decoded: EndpointJob = backpatch_transfer_roundtrip(EndpointJob(7, "body", tx, tx))
  test.assert(decoded.id == 7 and decoded.body == "body")
  test.assert(decoded.reply ~= tx, "a decoded endpoint is a fresh wrapper")
  decoded.reply:send(21)
  test.assert(rx:receive() == 21, "the decoded endpoint lost its channel")
  -- The inferred local forces the optional endpoint, raising if it is absent.
  local maybe = decoded.maybe
  maybe:send(22)
  test.assert(rx:receive() == 22)
end

record DepthChain
  next: DepthChain?
  choice: Choice?
end

-- Hand-built wire oracles at the depth boundary.
local function node_chain_bytes(count: integer): string
  local bytes = backpatch_field(1, "leaf")
  for index = 2, count do
    bytes = backpatch_field(1, "n" .. index) .. backpatch_field(2, bytes)
  end
  return bytes
end

local function depth_chain_bytes(count: integer): string
  local bytes = backpatch_field(2, string.char(10, 0))
  for _ = 2, count do bytes = backpatch_field(1, bytes) end
  return bytes
end

local function chain_length(chain: Node): integer
  local count = 1
  local current = chain
  while current.next ~= nil do
    current = current.next
    count = count + 1
  end
  return count
end

function test_generated_codecs_depth_boundaries(context: test.Context)
  local node_type = descriptor(Node("", nil))
  context:run("encode_127_accepted", function (_: test.Context)
    test.assert(generated_wire(node_chain(127)) == node_chain_bytes(127))
    test.assert(reflective_serialize(node_chain(127)) == node_chain_bytes(127))
  end)
  context:run("decode_127_accepted", function (_: test.Context)
    local chain: Node = generated_decode(node_chain_bytes(127), node_type)
    test.assert(chain_length(chain) == 127)
    test.assert(generated_wire(chain) == node_chain_bytes(127))
  end)
  context:run("decode_128_rejected_by_both", function (_: test.Context)
    local generated = decode_outcome(node_chain_bytes(128), node_type, true)
    test.assert(generated == decode_outcome(node_chain_bytes(128), node_type, false), generated)
    test.assert(string.find(generated, "nesting exceeds 128", 1, true) ~= nil, generated)
  end)
  context:run("partless_union_at_128", function (_: test.Context)
    -- Valid on both paths: the empty variant at depth 128 has no fields.
    local chain = DepthChain(nil, Choice.empty())
    for _ = 2, 127 do chain = DepthChain(chain, nil) end
    test.assert(generated_wire(chain) == depth_chain_bytes(127))
    test.assert(reflective_serialize(chain) == depth_chain_bytes(127))
    local decoded = generated_decode(depth_chain_bytes(127),
        descriptor(DepthChain(nil, nil)))
    test.assert(reflective_serialize(decoded) == depth_chain_bytes(127))
  end)
end

record Box<|T|>
  item: T
  label: string
end

-- One TitanValue arm per dynamic kind, with a field number per arm.
local function value_wire(arm: string): string
  return backpatch_field(1, arm)
end

function test_value_fields_use_one_dynamic_wire(context: test.Context)
  local frozen = {1, 2} as const {integer}
  local mixed: {value} = {1, "two", Node("n", nil)}
  mixed[5] = true
  check_generated_codec(context, "nil", AnyValue(nil))
  check_generated_codec(context, "boolean", AnyValue(false))
  check_generated_codec(context, "integer", AnyValue(-17))
  check_generated_codec(context, "float", AnyValue(-0.5))
  check_generated_codec(context, "string", AnyValue("text\0bytes"))
  check_generated_codec(context, "generated_record", AnyValue(IntegerValue(4)))
  check_generated_codec(context, "generated_union", AnyValue(Choice.pair(2, "x")))
  check_generated_codec(context, "hooked_record", AnyValue(HookedToken(5, "h")))
  check_generated_codec(context, "cross_module_record", AnyValue(reflect.NamedType("a.B")))
  check_generated_codec(context, "array", AnyValue(mixed))
  check_generated_codec(context, "const_array", AnyValue(frozen))
  check_generated_codec(context, "nested_value", AnyValue(AnyValue(AnyValue(3))))
  check_generated_codec(context, "generic_integer", Box<|integer|>.new(5, "five"))
  check_generated_codec(context, "generic_record", Box<|Node|>.new(Node("x", nil), "node"))
  check_generated_codec(context, "generic_array", Box<|{string}|>.new({"a", "b"}, "array"))
  context:run("golden_arms", function (_: test.Context)
    test.assert(protobuf.serialize(AnyValue(nil)) == "")
    test.assert(protobuf.serialize(AnyValue(true)) == value_wire(string.char(8, 1)))
    test.assert(protobuf.serialize(AnyValue(-1)) == value_wire(string.char(16, 1)))
    test.assert(protobuf.serialize(AnyValue("ab")) == value_wire(string.char(34, 2) .. "ab"))
    test.assert(protobuf.serialize(AnyValue(IntegerValue(1))) ==
        value_wire(backpatch_field(5, backpatch_field(1, "protobuf.tests")
            .. backpatch_field(2, "protobuf.tests.IntegerValue")
            .. backpatch_field(3, string.char(8, 2)))))
  end)
  context:run("schema", function (_: test.Context)
    local output = protobuf.schema(descriptor(AnyValue(nil)))
    test.assert(string.find(output, "message TitanValue {", 1, true) ~= nil, output)
    test.assert(string.find(output, "TitanValue f_item = 1;", 1, true) ~= nil, output)
  end)
end

function test_value_fields_decode_every_wire_reflectively(context: test.Context)
  local any_type = descriptor(AnyValue(nil))
  check_decode_outcome(context, "absent", "", any_type)
  check_decode_outcome(context, "empty_value", value_wire(""), any_type)
  check_decode_outcome(context, "unknown_arm_only", value_wire(string.char(56, 1)), any_type)
  check_decode_outcome(context, "last_arm_wins", value_wire(string.char(8, 1, 16, 4)), any_type)
  check_decode_outcome(context, "repeated_scalar_arm", value_wire(string.char(16, 4, 16, 6)),
      any_type)
  check_decode_outcome(context, "merged_values", value_wire(string.char(16, 4))
      .. value_wire(string.char(8, 0)), any_type)
  check_decode_outcome(context, "wrong_arm_wire", value_wire(string.char(9, 1, 2, 3, 4, 5, 6, 7, 8)),
      any_type)
  check_decode_outcome(context, "invalid_boolean", value_wire(string.char(8, 2)), any_type)
  check_decode_outcome(context, "wrong_field_wire", string.char(8, 1), any_type)
  check_decode_outcome(context, "truncated_value", value_wire(string.char(16)), any_type)
  check_decode_outcome(context, "unknown_nominal", value_wire(backpatch_field(5,
      backpatch_field(1, "nowhere") .. backpatch_field(2, "nowhere.Missing")
      .. backpatch_field(3, ""))), any_type)
  check_decode_outcome(context, "nominal_missing_payload", value_wire(backpatch_field(5,
      backpatch_field(1, "protobuf.tests")
      .. backpatch_field(2, "protobuf.tests.IntegerValue"))), any_type)
end

function test_value_fields_raise_reflective_errors(context: test.Context)
  check_same_error(context, "callable", function ()
    protobuf.serialize(AnyValue(function () end))
  end, "unsupported dynamic value")
  local map: {string: integer} = {}
  map["k"] = 1
  check_same_error(context, "map", function ()
    protobuf.serialize(AnyValue(map))
  end, "unsupported dynamic value")
  local cyclic = AnyValue(nil)
  cyclic.item = cyclic
  check_same_error(context, "cycle", function () protobuf.serialize(cyclic) end,
      "cyclic object graph")
  local deep = AnyValue(1)
  for _ = 1, 130 do deep = AnyValue(deep) end
  check_same_error(context, "depth", function () protobuf.serialize(deep) end,
      "nesting exceeds 128")
end

function test_value_fields_carry_endpoints_and_scalars_in_packets(_context: test.Context)
  local tx, rx = thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  local decoded: AnyValue = backpatch_transfer_roundtrip(AnyValue(tx))
  local reply: thread.Sender<|integer|> = decoded.item
  reply:send(9)
  test.assert(rx:receive() == 9, "a dynamic endpoint lost its channel")
  local scalar: AnyValue = backpatch_transfer_roundtrip(AnyValue("bytes"))
  test.assert(scalar.item == "bytes")
  local boxed: Box<|Choice|> = backpatch_transfer_roundtrip(Box<|Choice|>.new(Choice.empty(), "c"))
  test.assert(boxed.label == "c")
end

record GeneratedResourceProbe
  id: integer
end

local foreign function generated_probe_retain(resource: *void)
end

local foreign function generated_probe_release(resource: *void)
end

function test_registered_resource_codec_precedes_generated_codec(_context: test.Context)
  local probe = GeneratedResourceProbe(5)
  test.assert(protobuf.find_generated_codec(probe) ~= nil, "eligible probe has no codec")
  local before = protobuf.serialize(probe)
  transfer.register_resource(probe,
    function (_: value): (foreign *void) return nil end,
    generated_probe_retain, generated_probe_release,
    function (_: value, _data: foreign const *void, _length: integer): (value)
      return nil
    end)
  test.assert(protobuf.find_generated_codec(probe) == nil,
      "a registered resource codec must precede the generated codec")
  test.assert(protobuf.serialize(probe) == before, "structural root bytes changed")
end
