local test = import "test"
local pattern = import "peg"
local ffi = foreign import "titan/ffi.h"
local clocale = foreign import "locale.h"

local function bytes_contain(subject: string, needle: string): boolean
  if #needle == 0 then return true end
  if #needle > #subject then return false end
  local haystack = subject as const *ffi.titan_ffi_unsigned_char
  local wanted = needle as const *ffi.titan_ffi_unsigned_char
  local first = 0
  while first <= #subject - #needle do
    local equal = true
    local offset = 0
    while offset < #needle do
      if haystack[first + offset] ~= wanted[offset] then
        equal = false
        break
      end
      offset = offset + 1
    end
    if equal then return true end
    first = first + 1
  end
  return false
end

local function caught_string(callback: () -> ()): string?
  do
    callback()
  catch
    if error is string then return error as string end
    return nil
  end
  return nil
end

local function assert_raises(fragment: string, callback: () -> ())
  local message? = caught_string(callback)
  test.assert(message ~= nil,
              "expected a string error containing '" .. fragment .. "'")
  local actual: string = message
  test.assert(bytes_contain(actual, fragment), actual)
end

local function result_count(...: value): integer
  return #...
end

local function digit_text(digit: integer): string
  if digit == 0 then return "0"
  elseif digit == 1 then return "1"
  elseif digit == 2 then return "2"
  elseif digit == 3 then return "3"
  elseif digit == 4 then return "4"
  elseif digit == 5 then return "5"
  elseif digit == 6 then return "6"
  elseif digit == 7 then return "7"
  elseif digit == 8 then return "8"
  else return "9"
  end
end

local function decimal_text(number: integer): string
  if number < 10 then return digit_text(number) end
  return decimal_text(number // 10) .. digit_text(number % 10)
end

local function repeat_text(piece: string, count: integer): string
  local result = ""
  local index = 1
  while index <= count do
    result = result .. piece
    index = index + 1
  end
  return result
end

local function use_c_ctype_locale(): string
  local previous_pointer = clocale.setlocale(clocale.LC_CTYPE, nil)
  test.assert(previous_pointer ~= nil, "failed to query C character locale")
  local previous = previous_pointer as string
  test.assert(clocale.setlocale(clocale.LC_CTYPE, "C") ~= nil,
              "failed to select C character locale")
  return previous
end

local function restore_c_ctype_locale(previous: string)
  test.assert(clocale.setlocale(clocale.LC_CTYPE, previous) ~= nil,
              "failed to restore C character locale")
end


local function require_match(candidate: pattern.Match?): pattern.Match
  test.assert(candidate ~= nil, "expected PEG search to match")
  local found: pattern.Match = candidate
  return found
end

local function compile_error(source: string): string?
  return caught_string(function()
    pattern.compile(source)
  end)
end

local function assert_compile_error_contains(source: string,
                                             fragment: string)
  local message? = compile_error(source)
  test.assert(message ~= nil,
              "expected PEG source to fail: " .. source)
  local actual: string = message
  test.assert(bytes_contain(actual, fragment), actual)
end

local function assert_exact_error(source: string, expected: string)
  local message? = compile_error(source)
  test.assert(message ~= nil,
              "expected PEG source to fail: " .. source)
  local actual: string = message
  test.assert(actual == expected, actual)
end
