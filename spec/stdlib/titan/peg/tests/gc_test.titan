local type CaptureCallback =
  function (value, ...: value): (...: value)

local function build_titan_callback_pattern(
    weak: {value: value}): pattern.Pattern
  local marker: {value: value} = { ["suffix"] = "!" }
  local callback: CaptureCallback =
    function (first: value, ...: value): (...: value)
      return (first as string) .. (marker["suffix"] as string)
    end
  local lookup: {value: value} = { ["b"] = "b?" }
  weak["callback"] = callback
  weak["marker"] = marker
  weak["lookup"] = lookup
  local pattern = pattern.choice(
    pattern.function_capture(pattern.capture(pattern.literal("a")), callback),
    pattern.query_capture(pattern.capture(pattern.literal("b")), lookup))
  weak["pattern"] = pattern
  return pattern
end

local function exercise_live_titan_callback_pattern(
    weak: {value: value})
  local pattern = build_titan_callback_pattern(weak)
  for index = 1, 100 do
    if index % 2 == 0 then
      gc.collect()
    else
      gc.step(0)
    end
    local result: value = pattern:match("a")
    test.assert(result == "a!", "collected PEG callback changed its result")
    result = pattern:match("b")
    test.assert(result == "b?", "collected PEG query table changed its result")
  end
  test.assert(weak["pattern"] ~= nil,
              "live Pattern was not rooted")
  test.assert(weak["callback"] ~= nil,
              "live Pattern did not root its Titan callback")
  test.assert(weak["marker"] ~= nil,
              "live Titan callback did not root its capture")
  test.assert(weak["lookup"] ~= nil,
              "live Pattern did not root its query table")
end

function test_peg_roots_and_releases_titan_callback_patterns(
    _context: test.Context)
  gc.collect()
  local was_generational = gc.generational()
  defer do
    if was_generational then gc.generational() else gc.incremental() end
  end

  local weak: {value: value} = {}
  gc.weak(weak)
  exercise_live_titan_callback_pattern(weak)

  -- Return from the exercising frame before collecting so no compiler local
  -- or native matching temporary can itself be the ownership path under test.
  for _ = 1, 4 do gc.collect() end
  test.assert(weak["pattern"] == nil,
              "released Pattern remained rooted")
  test.assert(weak["callback"] == nil,
              "released Pattern retained its Titan callback")
  test.assert(weak["marker"] == nil,
              "released Titan callback retained its capture")
  test.assert(weak["lookup"] == nil,
              "released Pattern retained its query table")
end
