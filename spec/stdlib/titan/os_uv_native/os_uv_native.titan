-- Native public os/uv resource behavior migrated from the remaining
-- direct legacy standard-library cases. This folder is one logical test
-- module, invoked with:
--   titanc --test --tree spec/stdlib/titan os_uv_native
local test = import "test"
local async = import "async"
local fs = import "fs"
local stream = import "io"
local system = import "os"
local timer = import "timer"

-- These owners deliberately outlive their individual test callback. The
-- shutdown case leaves both for the Runtime/host ownership boundaries.
local retained_shutdown_file: fs.File? = nil
local retained_shutdown_ticker: timer.Ticker? = nil
