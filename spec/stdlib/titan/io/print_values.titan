-- Logged Lua conversion values shared by native and browser IO fixtures.
local test = import "test"
foreign import "titan/ffi.h"
foreign import "lua.h"
foreign import "lauxlib.h"

local type PrintableFactory = function (string, string, boolean): (value)
local type ConversionLog = function (): (string)

local function load_print_helpers(): (PrintableFactory, ConversionLog)
  const top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 3) ~= 0,
              "cannot reserve Lua stack for print fixtures")
  const source = [[
local conversions = {}
return
  function(label, rendered, should_fail)
    return setmetatable({}, {
      __tostring = function()
        conversions[#conversions + 1] = label
        if should_fail then error("conversion failure", 0) end
        return rendered
      end,
    })
  end,
  function()
    return table.concat(conversions, "|")
  end
]]
  local status = ffi.luaL_loadstring(L, source)
  if status ~= ffi.LUA_OK then
    const failure: value = ffi.lua_totvalue(L, -1)
    raise failure
  end
  status = ffi.lua_pcallk(L, 0, 2, 0, 0, nil)
  if status ~= ffi.LUA_OK then
    const failure: value = ffi.lua_totvalue(L, -1)
    raise failure
  end
  const factory_value: value = ffi.lua_totvalue(L, -2)
  const log_value: value = ffi.lua_totvalue(L, -1)
  return factory_value as PrintableFactory, log_value as ConversionLog
end
