-- Native cmd.exe shell semantics; the runner owns the NTFS paths and C child.
local test = import "titan.test"
local stream = import "titan.io"
local system = import "titan.os"
local fs = import "titan.fs"
local strings = import "titan.string"
local async = import "titan.async"
local timer = import "titan.timer"
local runtime_test = import "support.runtime.titan"
local task_support = import "support.async.titan"
local process_support = import "os.process_test_support.titan"

local function child_path(): string
  local child? = system.getenv("TITAN_WINDOWS_PROCESS_CHILD")
  test.assert(child ~= nil and #child > 0, "runner did not supply the process fixture")
  return child
end

local function read_all(pipe: stream.InputOutputStream): string
  local result = ""
  for chunk in pipe:read do result = result .. chunk end
  return result
end

local function cmd_path(path: string): string
  -- Unlike Win32 file APIs, cmd's TYPE builtin rejects forward-slash paths.
  local native = ""
  for index = 1, #path do
    local byte = strings.sub(path, index, index)
    if byte == "/" then byte = "\\" end
    native = native .. byte
  end
  return native
end

function test_binary_duplex_and_status(_context: test.Context)
  runtime_test.run(function ()
    local payload = "head\0middle\r\n\26\255trail"
    local pipe = stream.popen('"' .. child_path() .. '" echo-count ' .. #payload ..
                              ' & exit /b 7')
    defer pipe:close()
    pipe:write(payload)
    test.assert(read_all(pipe) == payload, "popen changed binary pipe bytes")
    local first = pipe:wait()
    local second = pipe:wait()
    test.assert(first.code == 7 and first.signal == nil and first.signal_number == 0,
                "shell exit status was lost")
    test.assert(first.code == second.code and first.signal == second.signal,
                "wait did not retain the shell status")
    pipe:close()
    pipe:close()
    test.assert(not pipe:read() and not pipe:read_until("missing"),
                "closed popen stream did not retain EOF")
    test.assert(pipe:wait().code == 7, "close changed a retained exit status")
  end)
end

function test_quoted_unicode_command(_context: test.Context)
  runtime_test.run(function ()
    local child = child_path()
    local cwd = system.cwd()
    local name = "TITAN_POPEN_METADATA"
    local value = "space value"
    local arguments: {string} = {"", "space argument", "a&b|<>^", "ação東京😀", "trailing\\"}
    local command = 'set "' .. name .. '=' .. value .. '"&&"' .. child ..
                    '" argv-env-cwd ' .. name
    local expected = "cwd:" .. #cwd .. ":" .. cwd .. "\n" ..
        "env:" .. #value .. ":" .. value .. "\n" ..
        "argv0:" .. #child .. ":" .. child .. "\n"
    for index = 1, #arguments do
      local argument = arguments[index]
      -- A trailing backslash must be doubled for the child CRT's closing quote.
      local encoded = argument
      if index == #arguments then encoded = encoded .. "\\" end
      command = command .. ' "' .. encoded .. '"'
      expected = expected .. "arg:" .. #argument .. ":" .. argument .. "\n"
    end
    local previous? = system.getenv(name)
    local pipe = stream.popen(command)
    defer pipe:close()
    test.assert(read_all(pipe) == expected, "cmd quoting changed UTF-8 arguments or metacharacters")
    process_support.assert_normal(pipe:wait(), "quoted shell child")
    test.assert(system.getenv(name) == previous, "shell changed its parent's environment")
  end)
end

function test_shell_operators_pipeline_and_redirection(_context: test.Context)
  runtime_test.run(function ()
    local root? = system.getenv("TITAN_WINDOWS_TEST_ROOT")
    test.assert(root ~= nil, "runner did not supply its owned workspace")
    local path = cmd_path(root .. "/popen output ação 東京.bin")
    defer do if fs.stat(path) ~= nil then fs.unlink(path) end end
    local child = '"' .. child_path() .. '"'
    local pipe = stream.popen(child .. ' dual 64 > "' .. path ..
        '" 2>&1 && type "' .. path .. '" | ' .. child .. ' echo')
    defer pipe:close()
    local bytes = read_all(pipe)
    local stdout_count, stderr_count = 0, 0
    for index = 1, #bytes do
      local byte = strings.sub(bytes, index, index)
      if byte == "O" then stdout_count = stdout_count + 1
      elseif byte == "E" then stderr_count = stderr_count + 1
      else test.assert(false, "shell pipeline gained unexpected output") end
    end
    test.assert(stdout_count == 64 and stderr_count == 64, "shell pipeline lost merged output")
    test.assert(fs.read_file(path) == bytes, "redirection did not preserve exact bytes")
    process_support.assert_normal(pipe:wait(), "shell pipeline")
  end)
end

function test_nonzero_and_missing_command_status(_context: test.Context)
  runtime_test.run(function ()
    local failed = stream.popen("exit /b 126")
    defer failed:close()
    test.assert(read_all(failed) == "" and failed:wait().code == 126,
                "nonzero shell exit became a spawn error")
    local missing = stream.popen('"' .. child_path() .. '.absent"')
    defer missing:close()
    test.assert(#read_all(missing) > 0, "missing command lost merged diagnostic")
    -- An independently invoked cmd /d /s /c returns 1 for this quoted missing
    -- absolute executable (distinct from some unquoted command lookups).
    test.assert(missing:wait().code == 1, "quoted missing command lost cmd's exit code")
  end)
end

function test_close_terminates_running_shell(_context: test.Context)
  runtime_test.run(function ()
    -- Only cmd builtins: no descendant cleanup is required or promised here.
    local pipe = stream.popen("echo READY&echo UNREAD&for /l %i in (0,0,1) do @rem hold")
    defer pipe:close()
    test.assert(pipe:read_until("\r\n", true) == "READY", "shell did not become ready")
    pipe:close()
    pipe:close()
    test.assert(not pipe:read(), "close did not discard unread bytes")
    local first = pipe:wait()
    local second = pipe:wait()
    test.assert(first.signal == "term" and first.signal_number > 0,
                "close did not terminate the running shell")
    test.assert(first.code == second.code and first.signal == second.signal,
                "terminated shell status was not retained")
  end)
end

local function cancellation_case(waiting: boolean)
  runtime_test.run(function ()
    local pipe = stream.popen("echo READY&set /p ignored=&echo AFTER")
    defer pipe:close()
    test.assert(pipe:read_until("\r\n", true) == "READY", "shell did not become ready")
    local task = async.run<|value, value|>(function (): value
      if waiting then pipe:wait() else pipe:read() end
      return nil
    end)
    defer task_support.cancel_and_join_task(task, "popen Task cleanup")
    process_support.wait_until_waiting(task, "popen operation")
    timer.sleep(10)
    test.assert(task:status():as_string() == "waiting", "pending popen operation blocked its Runtime")
    task:cancel(async.CancellationReason.simple("popen operation cancelled"))
    async.join(task)
    test.assert(task:status():has_cancelled(), "popen operation ignored cancellation")
    pipe:write("continue\r\n")
    test.assert(read_all(pipe) == "AFTER\r\n", "cancelling a waiter killed or closed its shell")
    process_support.assert_normal(pipe:wait(), "shell after waiter cancellation")
  end)
end

function test_wait_cancellation_preserves_child(_context: test.Context)
  cancellation_case(true)
end

function test_read_cancellation_preserves_child(_context: test.Context)
  cancellation_case(false)
end

function test_rejects_nul_command(_context: test.Context)
  runtime_test.run(function ()
    local rejected = false
    do
      local pipe = stream.popen("echo forbidden\0suffix")
      pipe:close()
    catch
      test.assert(error is async.OperationError, "invalid command lost its operation error")
      test.assert((error as async.OperationError).name == "EINVAL", "NUL command lost EINVAL")
      rejected = true
    end
    test.assert(rejected, "popen accepted an embedded NUL command")
  end)
end

function test_fixed_system_shell(_context: test.Context)
  runtime_test.run(function ()
    local previous? = system.getenv("COMSPEC")
    defer do
      if previous then system.setenv("COMSPEC", previous)
      else system.unsetenv("COMSPEC") end
    end
    system.setenv("COMSPEC", child_path() .. ".absent")
    local pipe = stream.popen("echo SYSTEM_SHELL")
    defer pipe:close()
    test.assert(read_all(pipe) == "SYSTEM_SHELL\r\n", "popen did not select the system cmd.exe")
    process_support.assert_normal(pipe:wait(), "fixed system shell")
  end)
end
