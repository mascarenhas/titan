-- Exact stdout and Lua conversion probes for io.tests.
local test = import "test"
foreign import "titan/ffi.h"
foreign import "stdio.h"
foreign import "lua.h"
foreign import "lauxlib.h"
foreign import "print_capture.h"

local function begin_stdout_capture(): (integer, integer)
  local read_descriptor = -1
  local write_descriptor = -1
  local saved_stdout = -1
  local redirected = false
  local transferred = false
  defer do
    if not transferred then
      if redirected and saved_stdout >= 0 then ffi.titan_spec_capture_replace(saved_stdout, 1) end
      if saved_stdout >= 0 then ffi.titan_spec_capture_close(saved_stdout) end
      if write_descriptor >= 0 then ffi.titan_spec_capture_close(write_descriptor) end
      if read_descriptor >= 0 then ffi.titan_spec_capture_close(read_descriptor) end
    end
  end

  local descriptors = foreign int.new_array(2)
  local status: integer = ffi.titan_spec_capture_pipe(
      descriptors as foreign *int)
  test.assert(status == 0, "could not create stdout capture pipe")
  read_descriptor = descriptors[0]
  write_descriptor = descriptors[1]
  saved_stdout = ffi.titan_spec_capture_duplicate(1)
  test.assert(saved_stdout >= 0, "could not duplicate stdout")
  test.assert(ffi.fflush(nil) == 0, "could not flush stdout")
  status = ffi.titan_spec_capture_replace(write_descriptor, 1)
  test.assert(status == 1, "could not redirect stdout")
  redirected = true
  local closing = write_descriptor
  write_descriptor = -1
  test.assert(ffi.titan_spec_capture_close(closing) == 0,
              "could not release redirected pipe descriptor")
  transferred = true
  return read_descriptor, saved_stdout
end

local function end_stdout_capture(read_descriptor: integer,
                                   saved_stdout: integer)
  local flushed = ffi.fflush(nil) == 0
  local restored = ffi.titan_spec_capture_replace(saved_stdout, 1) == 1
  local saved_closed = ffi.titan_spec_capture_close(saved_stdout) == 0
  local read_closed = ffi.titan_spec_capture_close(read_descriptor) == 0
  test.assert(flushed, "could not flush redirected stdout")
  test.assert(restored, "could not restore stdout")
  test.assert(saved_closed, "could not release saved stdout descriptor")
  test.assert(read_closed, "could not release capture read descriptor")
end

local function captured_bytes(read_descriptor: integer,
                              capacity: integer): string
  local storage = foreign char.new_array(capacity)
  local count: integer = ffi.titan_spec_capture_read(
      read_descriptor, storage as foreign *char,
      capacity as foreign titan_spec_size)
  test.assert(count >= 0, "stdout capture had no completed write")
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 1) ~= 0,
              "cannot reserve Lua stack for captured stdout")
  ffi.lua_pushlstring(L, storage as foreign *char,
                      count as foreign titan_spec_size)
  local result: value = ffi.lua_totvalue(L, -1)
  return result as string
end
