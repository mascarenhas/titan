-- Native public-behavior tests migrated from spec/stdlib/net_spec.lua and
-- spec/stdlib/ssl_spec.lua. This folder is one logical test module.
local test = import "test"
local async = import "async"
local fs = import "fs"
local stream = import "io"
local net = import "net"
local ssl = import "ssl"
local str = import "string"
local timer = import "timer"

local CERTIFICATE = "spec/fixtures/ssl/server.pem"
local WRONG_CERTIFICATE = "spec/fixtures/ssl/wrong-server.pem"
local PRIVATE_KEY = "spec/fixtures/ssl/server-key.pem"
local TRUST_ROOT = "spec/fixtures/ssl/ca.pem"

local type CheckedAction = () -> ()

local function active(task: async.Task): boolean
  return not task:status():has_finished()
end

local function expect_failure(action: CheckedAction, message: string)
  local failed = false
  do
    action()
  catch
    failed = true
  end
  test.assert(failed, message)
end

local function cancel_and_join_task(task: async.Task, reason: string)
  if active(task) then
    task:cancel(async.CancellationReason.simple(reason))
  end
  async.join(task)
end

local function cleanup_task(context: test.Context, task: async.Task,
                            reason: string)
  context:cleanup(function ()
    cancel_and_join_task(task, reason)
  end)
end

local function cleanup_path(context: test.Context, path: string)
  context:cleanup(function ()
    do
      fs.unlink(path)
    catch
      -- A test may deliberately remove the path before the context unwinds.
      -- Ignore only that absence; every other cleanup failure remains a test
      -- failure through Context cleanup.
      if error is async.OperationError then
        local failure = error as async.OperationError
        if failure.name ~= "ENOENT" then raise error end
      else
        raise error
      end
    end
  end)
end

local function temporary_path(context: test.Context): string
  local path = fs.tmpname()
  cleanup_path(context, path)
  return path
end

local function cleanup_net_server(context: test.Context,
                                  server: net.Server)
  context:cleanup(function ()
    server:close()
  end)
end

local function cleanup_net_connection(context: test.Context,
                                      connection: net.Connection)
  context:cleanup(function ()
    connection:close()
  end)
end

local function cleanup_ssl_server(context: test.Context,
                                  server: ssl.Server)
  context:cleanup(function ()
    server:close()
  end)
end

local function cleanup_ssl_connection(context: test.Context,
                                      connection: ssl.Connection)
  context:cleanup(function ()
    connection:close()
  end)
end

-- Public net and ssl Servers do not expose an ephemeral listener's selected
-- port. Start in a deterministic private range and retry only address-use
-- collisions from concurrent workers.
local function net_listen_available(first_port: integer):
    (net.Server, integer)
  local port = first_port
  for _index = 1, 100 do
    do
      local server = net.listen("127.0.0.1", port)
      return server, port
    catch
      if error is async.OperationError then
        local failure = error as async.OperationError
        if failure.name == "EADDRINUSE" then
          port = port + 1
          if port > 60999 then port = 20000 end
        else
          raise "unexpected listen failure: " .. failure.operation ..
                ":" .. failure.name .. ": " .. failure.message
        end
      else
        raise error
      end
    end
  end
  raise "could not find an available loopback port"
end

local function ssl_listen_available(first_port: integer,
                                    certificate: string,
                                    private_key: string?):
    (ssl.Server, integer)
  local port = first_port
  for _index = 1, 100 do
    do
      if private_key == nil then
        return ssl.listen("127.0.0.1", port, certificate), port
      end
      return ssl.listen("127.0.0.1", port, certificate,
                        private_key as string), port
    catch
      if error is async.OperationError then
        local failure = error as async.OperationError
        if failure.name == "EADDRINUSE" then
          port = port + 1
          if port > 60999 then port = 20000 end
        else
          raise "ssl.listen failed with " .. failure.name .. ": " ..
                failure.message
        end
      else
        raise error
      end
    end
  end
  raise "could not find an available loopback port"
end
