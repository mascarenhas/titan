-- Native public coroutine behavior against the canonical titan.coroutine
-- provider. This folder is one logical test module, invoked with:
--   titanc --test --tree spec/stdlib/titan coroutine_native
local test = import "test"
local coroutine = import "coroutine"

local cstring = foreign import "string.h"

local function contains(subject: string, fragment: string): boolean
  return cstring.strstr(subject, fragment) ~= nil
end

local function caught_string(failure: value): string
  test.assert(failure is string, "coroutine error was not a string")
  return failure as string
end
