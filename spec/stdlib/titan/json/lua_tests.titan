local test = import "test"
local json = import "json"
local reflect = import "reflect"
local lua = import "lua"
local support = import "json.tests.titan"

function test_core_raw_sentinel_and_map_iteration(_context: test.Context)
  local loader = lua.load([[
    return function()
      local mt = {
        __eq = function() error("JSON called equality metamethod") end,
        __pairs = function() error("JSON called pairs metamethod") end,
        __index = function() error("JSON called index metamethod") end,
        __tostring = function() error("JSON called tostring metamethod") end,
      }
      return setmetatable({a = 1}, mt), setmetatable({a = 1}, mt)
    end
  ]], "json-raw-values", nil)
  local factory = loader() as function (): (value, value)
  local first, second = factory()
  test.assert(json.encode(first, json.EncodeOption.null_value(first)) == "null")
  test.assert(json.encode(first, json.EncodeOption.null_value(second)) == [[{"a":1}]])
end

function test_mapping_array_lua_writer_policy_and_const_rejection(_context: test.Context)
  local write = lua.load("local a, i, v = ...; a[i] = v", "=json_array_write")
  local mutable = support.mapping_array(reflect.Type.is_integer(),
                                 reflect.ArrayTypeConstness.is_mutable())
  local array: {integer} = json.decode("[1]", mutable)
  -- This is a genuine Lua write; the decoded Array retains its value writer,
  -- so the float is stored unchanged and the later integer read must reject.
  write(array, 1, 2.0)
  test.assert(support.mapping_raises(function()
    support.mapping_integer_head(array)
  end), "decoded Array unexpectedly acquired an integer Lua writer")
  write(array, 1, 3)
  test.assert(array[1] == 3)

  local immutable = support.mapping_array(reflect.Type.is_integer(),
                                   reflect.ArrayTypeConstness.is_const())
  local frozen: const {integer} = json.decode("[1]", immutable)
  test.assert(support.mapping_raises(function()
    write(frozen, 1, 2)
  end), "decoded const Array accepted a Lua write")
  test.assert(frozen[1] == 1)

  local person: support.MappingPerson = json.decode([[{"name":"Ada","active":false}]],
                                                   support.mapping_target("MappingPerson"))
  local change_name = lua.load("local r = ...; r.name = 'changed'", "=json_const_field")
  test.assert(support.mapping_raises(function()
    change_name(person)
  end), "decoded const record field accepted a Lua write")
  test.assert(person.name == "Ada")
end
