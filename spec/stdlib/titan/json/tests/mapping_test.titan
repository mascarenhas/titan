record MappingPerson
  const name: string
  active: boolean
  age: integer?
  note: string?
  raw: value
end

union MappingEvent
  local hidden(string)
  empty()
  count(integer)
  person(MappingPerson)
  optional(string?)
  dynamic(value)
  people({MappingPerson})
  wire({string: value})
end

function MappingEvent.private_value(): MappingEvent
  return MappingEvent.hidden("private")
end

record MappingEnvelope
  const person: MappingPerson
  events: {MappingEvent}
  frozen: const {integer}
  either: const? {integer}
  by_name: {string: MappingPerson}
end

record MappingPrivate
  local secret: integer
  label: string
end

function MappingPrivate.sample(): MappingPrivate
  return MappingPrivate.new(19, "public")
end

local record MappingLocal
  label: string
end

record MappingLink
  const number: integer
  next: MappingLink?
end

record MappingBox<|T|>
  item: T
end

record MappingNullable
  first: string?
  middle: integer?
  last: value
end

record MappingEmpty
end

record MappingToken
end

record MappingCustom
  const text: string
end

function MappingCustom.new(source: string): MappingCustom
  return { text = string.upper(source) }
end

record MappingScalarConstructor
end

function MappingScalarConstructor.new(): string
  raise "JSON must not invoke an incompatible constructor"
end

record MappingOtherConstructor
end

function MappingOtherConstructor.new(): MappingEmpty
  raise "JSON must not invoke an incompatible constructor"
end

record MappingZeroConstructor
end

function MappingZeroConstructor.new()
  raise "JSON must not invoke an incompatible constructor"
end

record MappingManyConstructor
end

function MappingManyConstructor.new(): (MappingManyConstructor, integer)
  raise "JSON must not invoke an incompatible constructor"
end

record MappingOptionalConstructor
end

function MappingOptionalConstructor.new(): MappingOptionalConstructor?
  raise "JSON must not invoke an incompatible constructor"
end

record MappingFlexibleConstructor
end

function MappingFlexibleConstructor.new(): (...: MappingFlexibleConstructor)
  raise "JSON must not invoke an incompatible constructor"
end

record MappingVariadicConstructor
end

function MappingVariadicConstructor.new(...: value): MappingVariadicConstructor
  raise "JSON must not invoke an incompatible constructor"
end

interface MappingView
  name: string
end

local function mapping_target(name: string): reflect.Type
  return reflect.Type.is_named(reflect.NamedType.new("json.tests." .. name))
end

local function mapping_array(element: reflect.Type,
                              constness: reflect.ArrayTypeConstness): reflect.Type
  return reflect.Type.is_array(constness, element)
end

local function mapping_error(source: string, target: reflect.Type,
                              code: string, path: string): json.Error
  local failure = expect_json_error(function()
    json.decode(source, target)
  end)
  test.assert(failure.code == code, "wrong JSON mapping error code")
  test.assert(failure.path == path, "wrong JSON mapping error path")
  test.assert(failure.position ~= nil and failure.line ~= nil and
              failure.column ~= nil, "mapping failure lost its source location")
  return failure
end

local function mapping_raises(action: function (): ()): boolean
  action()
  return false
catch
  return true
end

local function mapping_integer_head(items: {integer}): integer
  return items[1]
end

function test_mapping_dynamic_nulls_and_sentinel(_context: test.Context)
  local values: {value} = json.decode("[1,null,3,null,null]")
  test.assert(#values == 3 and values[1] == 1 and values[2] == nil and
              values[3] == 3)
  local object: {string: value} = json.decode([[{"missing":null,"flag":false}]])
  test.assert(object["missing"] == nil and object["flag"] == false)
  local token = MappingToken.new()
  local retained: {value} = json.decode(
    "[null,2,null]", nil, json.DecodeOption.null_value(token))
  test.assert(#retained == 3 and retained[1] == token and retained[3] == token)
  test.assert(json.encode(retained, json.EncodeOption.null_value(token)) ==
              "[null,2,null]")
  local false_slots: {value} = json.decode(
    "[null,1,null]", nil, json.DecodeOption.null_value(false))
  test.assert(#false_slots == 3 and false_slots[1] == false and
              false_slots[3] == false)
  local ordinary: {string: value} = json.decode([[{"tag":"empty"}]])
  test.assert(ordinary["tag"] == "empty", "untyped objects must remain Maps")
end

function test_mapping_record_const_fields_and_nullable_tails(_context: test.Context)
  local token = MappingToken.new()
  local person: MappingPerson = json.decode(
    [[{"name":"Ada","active":false,"age":7,"note":null,"raw":null}]],
    mapping_target("MappingPerson"), json.DecodeOption.null_value(token))
  test.assert(person.name == "Ada" and not person.active and person.age == 7)
  test.assert(person.note == nil and person.raw == token)
  local missing: MappingPerson = json.decode(
    [[{"name":"Grace","active":true}]], mapping_target("MappingPerson"),
    json.DecodeOption.null_value(token))
  test.assert(missing.age == nil and missing.note == nil and missing.raw == nil)
  local tails: MappingNullable = json.decode(
    [[{"first":"start","middle":null,"last":null}]],
    mapping_target("MappingNullable"))
  test.assert(tails.first == "start" and tails.middle == nil and tails.last == nil)
  local all_nil: MappingNullable = json.decode("{}", mapping_target("MappingNullable"))
  test.assert(all_nil.first == nil and all_nil.middle == nil and all_nil.last == nil)
  local empty: MappingEmpty = json.decode("{}", mapping_target("MappingEmpty"))
  test.assert(json.encode(empty) == "{}")
end

function test_mapping_record_rejections_and_unknown_policy(_context: test.Context)
  mapping_error([[{"name":"Ada"}]], mapping_target("MappingPerson"),
                "missing_field", "$[\"active\"]")
  mapping_error([[{"name":"Ada","active":null}]], mapping_target("MappingPerson"),
                "type_mismatch", "$[\"active\"]")
  mapping_error([[{"name":"Ada","active":"false"}]], mapping_target("MappingPerson"),
                "type_mismatch", "$[\"active\"]")
  mapping_error([[{"name":"Ada","active":false,"extra":null}]],
                mapping_target("MappingPerson"), "unknown_field", "$[\"extra\"]")
  local allowed: MappingPerson = json.decode(
    [[{"name":"Ada","active":false,"extra":{"ignored":null}}]],
    mapping_target("MappingPerson"), json.DecodeOption.ignore_unknown_fields(true))
  test.assert(allowed.name == "Ada" and not allowed.active)
  local private = MappingPrivate.sample()
  test.assert(json.encode(private) == [[{"label":"public"}]])
  mapping_error([[{"label":"public"}]], mapping_target("MappingPrivate"),
                "constructor_unavailable", "$")
  local local_value = MappingLocal.new("local")
  case reflect.inspect(local_value)
  when is_record(record_value) then
    mapping_error([[{"label":"local"}]], reflect.Type.is_record(record_value.type),
                  "constructor_unavailable", "$")
  else raise "expected local record"
  end
end

function test_mapping_custom_record_constructor(_context: test.Context)
  local constructed: MappingCustom = json.decode(
    [[{"source":"mixed case"}]], mapping_target("MappingCustom"))
  test.assert(constructed.text == "MIXED CASE",
              "JSON bypassed the custom constructor")
  test.assert(json.encode(constructed) == [[{"text":"MIXED CASE"}]])
  mapping_error([[{"text":"raw field"}]], mapping_target("MappingCustom"),
                "unknown_field", "$[\"text\"]")
  mapping_error("{}", mapping_target("MappingCustom"),
                "missing_field", "$[\"source\"]")
end

local function mapping_constructor_rejection(context: test.Context, name: string)
  context:run(name, function(_context: test.Context)
    mapping_error("{}", mapping_target(name), "constructor_unavailable", "$")
  end)
end

function test_mapping_rejects_incompatible_record_constructors(context: test.Context)
  mapping_constructor_rejection(context, "MappingScalarConstructor")
  mapping_constructor_rejection(context, "MappingOtherConstructor")
  mapping_constructor_rejection(context, "MappingZeroConstructor")
  mapping_constructor_rejection(context, "MappingManyConstructor")
  mapping_constructor_rejection(context, "MappingOptionalConstructor")
  mapping_constructor_rejection(context, "MappingFlexibleConstructor")
  mapping_constructor_rejection(context, "MappingVariadicConstructor")
end

function test_mapping_nested_records_unions_and_const_containers(_context: test.Context)
  local source = [[{
    "person":{"name":"Ada","active":false},
    "events":[{"tag":"empty"},{"tag":"person","value":{"name":"Grace","active":true}},
              {"tag":"people","value":[{"name":"Lin","active":true}]}],
    "frozen":[1,null,3],"either":[4,5],
    "by_name":{"one":{"name":"Edsger","active":true}}
  }]]
  local envelope: MappingEnvelope = json.decode(source, mapping_target("MappingEnvelope"))
  test.assert(envelope.person.name == "Ada" and #envelope.events == 3)
  test.assert(#envelope.frozen == 3 and envelope.frozen[2] == nil and
              envelope.frozen[3] == 3 and envelope.either[2] == 5)
  test.assert(envelope.by_name["one"].name == "Edsger")
  case envelope.events[2]
  when person(person) then test.assert(person.name == "Grace")
  else raise "wrong person arm"
  end
  case envelope.events[3]
  when people(people) then test.assert(people[1].name == "Lin")
  else raise "wrong Array payload arm"
  end
  case reflect.inspect(envelope.frozen)
  when is_const_array() then
  else raise "decoded const field has a mutable Array tag"
  end
  case reflect.inspect(envelope.either)
  when is_array() then
  else raise "maybe-const target must decode as a mutable Array"
  end
  local again: MappingEnvelope = json.decode(json.encode(envelope),
                                             mapping_target("MappingEnvelope"))
  test.assert(again.person.name == "Ada" and again.by_name["one"].name == "Edsger")
end

function test_mapping_union_empty_optional_and_dynamic_arms(_context: test.Context)
  local target = mapping_target("MappingEvent")
  local empty: MappingEvent = json.decode([[{"tag":"empty"}]], target)
  test.assert(json.encode(empty) == [[{"tag":"empty"}]])
  local count: MappingEvent = json.decode([[{"tag":"count","value":2.0}]], target)
  case count
  when count(amount) then test.assert(amount == 2)
  else raise "wrong numeric arm"
  end
  local token = MappingToken.new()
  local optional: MappingEvent = json.decode([[{"tag":"optional","value":null}]],
    target, json.DecodeOption.null_value(token))
  case optional
  when optional(payload) then test.assert(payload == nil)
  else raise "wrong optional arm"
  end
  local dynamic: MappingEvent = json.decode([[{"tag":"dynamic","value":null}]],
    target, json.DecodeOption.null_value(token))
  case dynamic
  when dynamic(payload) then test.assert(payload == token)
  else raise "wrong dynamic arm"
  end
  test.assert(json.encode(optional) == [[{"tag":"optional","value":null}]])
  local wire: MappingEvent = json.decode(
    [[{"tag":"wire","value":{"tag":"inner","value":23}}]], target)
  case wire
  when wire(payload) then
    test.assert(payload["tag"] == "inner" and payload["value"] == 23)
  else raise "wrong nested Map arm"
  end
  test.assert(json.encode(wire) ==
              [[{"tag":"wire","value":{"tag":"inner","value":23}}]])
  local private_error = expect_json_error(function()
    json.encode(MappingEvent.private_value())
  end)
  test.assert(private_error.code == "private_variant")
end

function test_mapping_union_envelope_rejections(_context: test.Context)
  local target = mapping_target("MappingEvent")
  mapping_error("{}", target, "invalid_union", "$[\"tag\"]")
  mapping_error([[{"tag":null}]], target, "invalid_union", "$[\"tag\"]")
  mapping_error([[{"tag":"unknown"}]], target, "unknown_variant", "$[\"tag\"]")
  mapping_error([[{"tag":"hidden","value":"x"}]], target,
                "unknown_variant", "$[\"tag\"]")
  mapping_error([[{"tag":"empty","value":null}]], target,
                "invalid_union", "$[\"value\"]")
  local omitted: MappingEvent = json.decode([[{"tag":"optional"}]], target)
  test.assert(json.encode(omitted) == [[{"tag":"optional","value":null}]])
  mapping_error([[{"tag":"count","value":null}]], target,
                "type_mismatch", "$[\"value\"]")
  local extra = expect_json_error(function()
    json.decode([[{"tag":"empty","extra":null}]], target,
                json.DecodeOption.ignore_unknown_fields(true))
  end)
  test.assert(extra.code == "invalid_union" and extra.path == "$[\"extra\"]")
end

function test_mapping_typed_container_holes_and_key_schemas(_context: test.Context)
  local token = MappingToken.new()
  local integers = mapping_array(reflect.Type.is_integer(),
                                  reflect.ArrayTypeConstness.is_mutable())
  local array: {integer} = json.decode("[1,null,3,null]", integers,
                                      json.DecodeOption.null_value(token))
  test.assert(#array == 3 and array[1] == 1 and array[2] == nil and array[3] == 3)
  local values = mapping_array(reflect.Type.is_value(),
                                reflect.ArrayTypeConstness.is_mutable())
  local dynamic: {value} = json.decode("[null,3,null]", values,
                                      json.DecodeOption.null_value(token))
  test.assert(#dynamic == 3 and dynamic[1] == token and dynamic[3] == token)
  local map_target = reflect.Type.is_map(
    reflect.Type.is_string(), reflect.Type.is_integer())
  local map: {string: integer} = json.decode([[{"nil":null,"one":1}]], map_target,
                                            json.DecodeOption.null_value(token))
  test.assert(map["nil"] == nil and map["one"] == 1)
  local wrong_keys = reflect.Type.is_map(
    reflect.Type.is_integer(), reflect.Type.is_value())
  mapping_error("{}", wrong_keys, "unsupported_type", "$")
  mapping_error("[1,false]", integers, "type_mismatch", "$[2]")
  local dynamic_keys = reflect.Type.is_map(
    reflect.Type.is_value(), reflect.Type.is_string())
  local string_values: {string: string} = json.decode([[{"name":"Ada"}]], dynamic_keys)
  test.assert(string_values["name"] == "Ada")
end

function test_mapping_recursive_nominals_and_erased_leaves(_context: test.Context)
  local linked: MappingLink = json.decode(
    [[{"number":1,"next":{"number":2,"next":null}}]], mapping_target("MappingLink"))
  test.assert(linked.number == 1 and linked.next.number == 2 and linked.next.next == nil)
  local erased: MappingBox<|value|> = json.decode(
    [[{"item":{"name":"Ada","active":true}}]], mapping_target("MappingBox"))
  local item: {string: value} = erased.item
  test.assert(item["name"] == "Ada", "erased generic leaves must remain dynamic")
  case reflect.inspect(erased.item)
  when is_map() then
  else raise "erased leaf unexpectedly reconstructed a nominal type"
  end
  mapping_error("{}", mapping_target("DoesNotExist"), "unknown_type", "$")
  mapping_error("null", mapping_target("DoesNotExist"), "unknown_type", "$")
end

function test_mapping_interface_snapshot_and_unsupported_targets(_context: test.Context)
  local person = MappingPerson.new("Ada", false, nil, nil, nil)
  local view: MappingView = person
  test.assert(json.encode(view) == [[{"name":"Ada"}]])
  mapping_error([[{"name":"Ada"}]], mapping_target("MappingView"),
                "unsupported_type", "$")
  local callback = reflect.Type.is_function(reflect.FunctionType.new({}, nil, {}, nil))
  mapping_error("null", callback, "unsupported_type", "$")
  mapping_error("null", reflect.Type.is_boolean(), "type_mismatch", "$")
  mapping_error("false", reflect.Type.is_string(), "type_mismatch", "$")
  local token = MappingToken.new()
  local absent: value = json.decode("null", reflect.Type.is_option(reflect.Type.is_integer()),
                                   json.DecodeOption.null_value(token))
  test.assert(absent == nil)
  local exact_nil: value = json.decode("null", reflect.Type.is_nil(),
                                      json.DecodeOption.null_value(token))
  test.assert(exact_nil == nil)
end

function test_mapping_array_lua_writer_policy_and_const_rejection(_context: test.Context)
  local write = lua.load("local a, i, v = ...; a[i] = v", "=json_array_write")
  local mutable = mapping_array(reflect.Type.is_integer(),
                                 reflect.ArrayTypeConstness.is_mutable())
  local array: {integer} = json.decode("[1]", mutable)
  -- This is a genuine Lua write; the decoded Array retains its value writer,
  -- so the float is stored unchanged and the later integer read must reject.
  write(array, 1, 2.0)
  test.assert(mapping_raises(function()
    mapping_integer_head(array)
  end), "decoded Array unexpectedly acquired an integer Lua writer")
  write(array, 1, 3)
  test.assert(array[1] == 3)

  local immutable = mapping_array(reflect.Type.is_integer(),
                                   reflect.ArrayTypeConstness.is_const())
  local frozen: const {integer} = json.decode("[1]", immutable)
  test.assert(mapping_raises(function()
    write(frozen, 1, 2)
  end), "decoded const Array accepted a Lua write")
  test.assert(frozen[1] == 1)

  local person: MappingPerson = json.decode([[{"name":"Ada","active":false}]],
                                           mapping_target("MappingPerson"))
  local change_name = lua.load("local r = ...; r.name = 'changed'", "=json_const_field")
  test.assert(mapping_raises(function()
    change_name(person)
  end), "decoded const record field accepted a Lua write")
  test.assert(person.name == "Ada")
end

local function mapping_fresh_records(): {MappingPerson}
  local source = string.writer()
  source:write("[")
  for index = 1, 300 do
    if index > 1 then source:write(",") end
    source:write("{\"name\":\"allocated person " .. index ..
                  "\",\"active\":true,\"age\":" .. index .. "}")
  end
  source:write("]")
  local target = mapping_array(mapping_target("MappingPerson"),
                                reflect.ArrayTypeConstness.is_mutable())
  return json.decode(source:drain(), target)
end

function test_mapping_allocated_constructor_arguments_survive_collection(_context: test.Context)
  local records = mapping_fresh_records()
  gc.collect()
  test.assert(#records == 300)
  for index = 1, #records do
    local person = records[index]
    test.assert(person.name == "allocated person " .. index and person.age == index)
  end
  local first = records[1]
  records = {}
  gc.collect()
  test.assert(first.name == "allocated person 1" and first.age == 1)
end

union MappingParts
  pair(first: integer, type: string, note: string?, raw: value)
  nullable(first: string?, last: integer?)
  renamed(message: string)
end

function test_mapping_named_union_parts_roundtrip_and_nil_tails(_context: test.Context)
  local target = mapping_target("MappingParts")
  local original = MappingParts.pair{first = 19, type = "event"}
  local text = json.encode(original)
  test.assert(text == [[{"tag":"pair","first":19,"type":"event","note":null,"raw":null}]])
  local decoded: MappingParts = json.decode(text, target)
  case decoded
  when pair{first, kind = type, note, raw} then
    test.assert(first == 19 and kind == "event" and note == nil and raw == nil)
  else raise "expected named union parts"
  end
  local reordered: MappingParts = json.decode(
    [[{"type":"other","first":7,"tag":"pair"}]], target)
  case reordered
  when pair(first, kind, note, raw) then
    test.assert(first == 7 and kind == "other" and note == nil and raw == nil)
  else raise "expected reordered union parts"
  end
  local absent: MappingParts = json.decode([[{"tag":"nullable"}]], target)
  test.assert(json.encode(absent) == [[{"tag":"nullable","first":null,"last":null}]])
  local token = MappingToken.new()
  local sentinel: MappingParts = json.decode(text, target, json.DecodeOption.null_value(token))
  case sentinel
  when pair{note, raw} then test.assert(note == nil and raw == token)
  else raise "expected sentinel in dynamic part only"
  end
  local omitted: MappingParts = json.decode(
    [[{"tag":"pair","first":3,"type":"missing"}]], target,
    json.DecodeOption.null_value(token))
  case omitted
  when pair{raw} then test.assert(raw == nil)
  else raise "expected omitted dynamic part"
  end
  local renamed: MappingParts = json.decode([[{"message":"hello","tag":"renamed"}]], target)
  case renamed
  when renamed(message) then test.assert(message == "hello")
  else raise "expected explicitly named single part"
  end
  test.assert(json.encode(renamed) == [[{"tag":"renamed","message":"hello"}]])
end

function test_mapping_named_union_parts_rejections_and_limits(_context: test.Context)
  local target = mapping_target("MappingParts")
  mapping_error([[{"tag":"pair","type":"event"}]], target,
                "missing_field", "$[\"first\"]")
  mapping_error([[{"tag":"pair","first":null,"type":"event"}]], target,
                "type_mismatch", "$[\"first\"]")
  mapping_error([[{"tag":"pair","first":1,"type":"event","extra":2}]], target,
                "invalid_union", "$[\"extra\"]")
  local unknown = expect_json_error(function()
    json.decode([[{"tag":"pair","first":1,"type":"event","extra":2}]], target,
      json.DecodeOption.ignore_unknown_fields(true))
  end)
  test.assert(unknown.code == "invalid_union" and unknown.path == "$[\"extra\"]")
  local original = MappingParts.nullable{}
  test.assert(json.encode(original, json.EncodeOption.max_depth(1)) ==
              [[{"tag":"nullable","first":null,"last":null}]])
  local nodes = expect_json_error(function()
    json.encode(original, json.EncodeOption.max_nodes(3))
  end)
  test.assert(nodes.code == "limit_exceeded" and nodes.path == "$[\"last\"]")
end

union MappingTagPart
  tagged(tag: string, value: integer)
end

function test_mapping_union_custom_discriminator_and_collisions(_context: test.Context)
  local original = MappingTagPart.tagged{tag = "payload tag", value = 31}
  local target = mapping_target("MappingTagPart")
  local collision = expect_json_error(function() json.encode(original) end)
  test.assert(collision.code == "invalid_union" and collision.path == "$[\"tag\"]")
  mapping_error([[{"tag":"tagged","value":31}]], target, "invalid_union", "$[\"tag\"]")
  local text = json.encode(original, json.EncodeOption.tag_field("kind"))
  test.assert(text == [[{"kind":"tagged","tag":"payload tag","value":31}]])
  local decoded: MappingTagPart = json.decode(text, target, json.DecodeOption.tag_field("kind"))
  case decoded
  when tagged(tag, number) then test.assert(tag == "payload tag" and number == 31)
  end
  local escaped = "kind\"\n"
  local escaped_text = json.encode(original, json.EncodeOption.tag_field("unused"),
                                   json.EncodeOption.tag_field(escaped))
  test.assert(escaped_text == [[{"kind\"\n":"tagged","tag":"payload tag","value":31}]])
  local escaped_value: MappingTagPart = json.decode(escaped_text, target,
    json.DecodeOption.tag_field("unused"), json.DecodeOption.tag_field(escaped))
  test.assert(json.encode(escaped_value, json.EncodeOption.tag_field("kind")) == text)
  local decode_collision = expect_json_error(function()
    json.decode([[{"value":"tagged","tag":"payload tag"}]], target,
      json.DecodeOption.tag_field("value"))
  end)
  test.assert(decode_collision.code == "invalid_union" and decode_collision.path == "$[\"value\"]")
  local custom_collision = expect_json_error(function()
    json.encode(original, json.EncodeOption.tag_field("value"))
  end)
  test.assert(custom_collision.code == "invalid_union" and custom_collision.path == "$[\"value\"]")
end
