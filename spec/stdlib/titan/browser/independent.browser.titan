local early_close = import "browser.early_close"
local browser = import "browser"
local coroutine = import "coroutine"
local test = import "test"
local gc = import "gc"
foreign import "native.h"

local type Value = browser.BrowserValue

local index = 0
local parked: coroutine.Coroutine?
local success: (function (...: browser.BrowserValue): browser.BrowserValue)?
local failure: (function (...: browser.BrowserValue): browser.BrowserValue)?
local state_close_marker: ({string: integer})?

local record PublicationCapture
  local marker: integer
end
local publication_collected = 0
local function publication_finalize(candidate: value)
  local capture: PublicationCapture = candidate
  publication_collected = publication_collected + capture.marker
end

local function make_captured_callable(weight: integer):
    function (...: browser.BrowserValue): browser.BrowserValue
  local capture = PublicationCapture { marker = weight }
  gc.finalizable<|value|>(capture, publication_finalize)
  return function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_integer(capture.marker)
  end
end

local function failed_publication()
  local target = browser.binding("publish")
  defer target:close()
  local non_callable = browser.binding("false_value")
  defer non_callable:close()
  local bad_request = browser.binding("throw_error")
  defer bad_request:close()

  -- 1. Later argument raises during marshalling (invalid UTF-8 in is_string).
  local caught_marshal = false
  do
    target:call(Value.is_callable(make_captured_callable(1)),
                Value.is_string("\255"))
  catch
    caught_marshal = true
  end

  -- 2. Host call fails before decoding arguments (target is not a function).
  local caught_call = false
  do
    non_callable:call(Value.is_callable(make_captured_callable(2)))
  catch
    caught_call = true
    if error is browser.BrowserError then
      local err: browser.BrowserError = error
      err:close()
    end
  end

  -- 3. Host start fails before exposure (target is not a function), rolling back
  -- completion, failure, and unexposed callable arguments.
  local caught_start_pre = false
  do
    non_callable:start(
        make_captured_callable(4),
        make_captured_callable(8),
        Value.is_callable(make_captured_callable(16)))
  catch
    caught_start_pre = true
    if error is browser.BrowserError then
      local err: browser.BrowserError = error
      err:close()
    end
  end

  -- 4. Host start refuses inside target (binding throws), rolling back the
  -- request's completion and failure holds.
  local caught_start = false
  do
    bad_request:start(
        make_captured_callable(32),
        make_captured_callable(64))
  catch
    caught_start = true
    if error is browser.BrowserError then
      local err: browser.BrowserError = error
      err:close()
    end
  end
  -- 5. Invalid UTF-8 string argument to start and listen rolls back request holds.
  local caught_start_utf8 = false
  do
    bad_request:start(
        make_captured_callable(128),
        make_captured_callable(256),
        Value.is_string("\255"))
  catch
    caught_start_utf8 = true
  end
  local caught_listen_utf8 = false
  do
    bad_request:listen(
        make_captured_callable(512),
        make_captured_callable(1024),
        Value.is_string("\255"))
  catch
    caught_listen_utf8 = true
  end

  test.assert(caught_marshal and caught_call and caught_start_pre and
      caught_start and caught_start_utf8 and caught_listen_utf8,
      "provisional pin rollback cases did not raise as expected")
end

local function try_alloc_wrapper_step(target: browser.BrowserHandle, step: integer): boolean
  local cb = make_captured_callable(1)
  local raised = false
  ffi.titan_bridge_test_arm_alloc_failure(L, step)
  do
    target:call(Value.is_callable(cb), Value.is_string("\255"))
  catch
    raised = true
  end
  local failures = ffi.titan_bridge_test_finish_alloc_failure(L)
  test.assert(raised, "wrapper pin step did not raise")
  return failures > 0
end

local function try_alloc_request_step(bad_request: browser.BrowserHandle, step: integer): boolean
  local c1 = make_captured_callable(1)
  local c2 = make_captured_callable(2)
  local raised = false
  ffi.titan_bridge_test_arm_alloc_failure(L, step)
  do
    bad_request:start(c1, c2)
  catch
    raised = true
    if error is browser.BrowserError then
      local err: browser.BrowserError = error
      err:close()
    end
  end
  local failures = ffi.titan_bridge_test_finish_alloc_failure(L)
  test.assert(raised, "request pin step did not raise")
  return failures > 0
end

local function allocation_failure_publication()
  local target = browser.binding("publish")
  defer target:close()
  local bad_request = browser.binding("throw_error")
  defer bad_request:close()
  local wrapper_oom = 0
  for step = 0, 5 do
    publication_collected = 0
    if try_alloc_wrapper_step(target, step) then wrapper_oom = wrapper_oom + 1 end
    gc.collect()
    gc.collect()
    test.assert(publication_collected == 1,
        "wrapper pin allocation failure leaked capture at step " .. step)
  end
  local request_oom = 0
  for step = 0, 8 do
    publication_collected = 0
    if try_alloc_request_step(bad_request, step) then request_oom = request_oom + 1 end
    gc.collect()
    gc.collect()
    test.assert(publication_collected == 3,
        "request pin allocation failure leaked capture at step " .. step)
  end
  test.assert(wrapper_oom > 0 and request_oom > 0,
      "allocation failure steps did not trigger OOM")
end

function publication(_: integer)
  publication_collected = 0
  failed_publication()
  gc.collect()
  gc.collect()
  test.assert(publication_collected == 2047,
      "unpublished provisional pins retained their discarded captures")
  allocation_failure_publication()
  local target = browser.binding("publish")
  defer target:close()
  target:call(Value.is_string("r1_publication_recovery"),
    Value.is_callable(function(...: browser.BrowserValue): browser.BrowserValue
      return Value.is_integer(42)
    end))
end

function prepare(number: integer)
  index = number
  success = function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_nil()
  end
  failure = function(...: browser.BrowserValue): browser.BrowserValue
    case ...[2]
    when is_handle(thrown) then thrown:close()
    end
    return Value.is_nil()
  end
  local pending: browser.BrowserHandle?
  local source = browser.binding("state_close_request")
  defer source:close()
  local request = source:start(success, failure)
  request:cancel()
  early_close.set_finalizer(function()
    local handle = pending
    handle:close()
    handle:close()
    request:close()
    request:close()
    ffi.titan_bridge_test_earlier_cleanup(index)
    browser.binding("state_close_handle") -- Must raise after record invalidation.
  end)
  local marker: {string: integer} = {}
  gc.finalizable<|value|>(marker, function(_: value)
    local handle = browser.binding("state_close_handle")
    handle:close()
    pending = browser.binding("state_close_handle")
    local observer = browser.binding("state_close_observe")
    defer observer:close()
    observer:call(Value.is_integer(index))
  end)
  state_close_marker = marker
  local target = browser.binding("publish")
  defer target:close()
  target:call(Value.is_string("independent_" .. number),
    Value.is_callable(function(...: browser.BrowserValue): browser.BrowserValue
      case ...[1]
      when is_integer(item) then return Value.is_integer(item + index)
      end
      raise "independent expects an integer"
    end))
  parked = coroutine.create(function(_: value): value
    defer do
      local observer = browser.binding("independent_close")
      local item = browser.binding("close_value")
      local request_target = browser.binding("detachable_request")
      local rejected = false
      do
        request_target:start(success, failure)
      catch
        rejected = true
      end
      test.assert(rejected, "independent close admitted an asynchronous request")
      -- Leave close-phase slots to the state record; Lua suppresses their
      -- reachability finalizers here.
      observer:call(Value.is_integer(index),
                    Value.is_boolean(rejected),
                    Value.is_handle(item))
      do
        local throwing = browser.binding("throw_value")
        throwing:call()
      catch
        local error_value: browser.BrowserError = error
        observer:call(Value.is_integer(index),
                      Value.is_boolean(true),
                      Value.is_handle(error_value.thrown))
      end
    end
    return coroutine.yield(nil, "independent-close")
  end, "independent-close")
  parked:resume(nil)
end

function check()
  test.assert(index > 0 and parked:status() == "suspended")
  local target = browser.binding("echo_integer")
  defer target:close()
  case target:call(Value.is_integer(index))
  when is_integer(actual) then test.assert(actual == index)
  else raise "echo_integer did not return an integer"
  end
  local req_target = browser.binding("r1_close_source")
  defer req_target:close()
  local req = req_target:start(success, failure)
  req:cancel()
  req:close()
  -- A C-created state is never the instance owner and cannot begin a drive.
  test.assert(not browser.is_owner(), "an independent state claimed instance ownership")
  local refused = false
  do
    browser.drive_begin()
  catch
    refused = error == "browser drive requires the instance owner's main thread"
  end
  test.assert(refused, "an independent state began a drive")
end
