local early_close = import "browser.early_close"
local browser = import "browser"
local test = import "test"
local gc = import "gc"
local reflect = import "reflect"
local coroutine = import "coroutine"
local string = import "string"
local _ = import "browser.independent"
foreign import "stdlib.h"
foreign import "native.h"

local type Value = browser.BrowserValue
local type Callable = function (...: browser.BrowserValue): browser.BrowserValue

local function publish(name: string, callback: Callable)
  local target = browser.binding("publish")
  defer target:close()
  target:call(Value.is_string(name), Value.is_callable(callback))
end

local function expect_boolean(item: browser.BrowserValue): boolean
  case item
  when is_boolean(flag) then return flag
  end
  raise "expected BrowserValue.is_boolean"
end

local function expect_integer(item: browser.BrowserValue): integer
  case item
  when is_integer(number) then return number
  end
  raise "expected BrowserValue.is_integer"
end

local function expect_float(item: browser.BrowserValue): float
  case item
  when is_float(number) then return number
  end
  raise "expected BrowserValue.is_float"
end

local function expect_string(item: browser.BrowserValue): string
  case item
  when is_string(text) then return text
  end
  raise "expected BrowserValue.is_string"
end

local function expect_bytes(item: browser.BrowserValue): string
  case item
  when is_bytes(bytes) then return bytes
  end
  raise "expected BrowserValue.is_bytes"
end

local function expect_handle(item: browser.BrowserValue): browser.BrowserHandle
  case item
  when is_handle(handle) then return handle
  end
  raise "expected BrowserValue.is_handle"
end

local function expect_bridge_error(target_name: string, expected: string)
  local target = browser.binding(target_name)
  defer target:close()
  local caught = false
  do
    target:call()
  catch
    caught = true
    test.assert(error is browser.BrowserError, "host failure did not become browser.BrowserError")
    local failure: browser.BrowserError = error
    defer failure:close()
    test.assert(string.find(failure.message, expected) ~= nil, "host diagnostic lost its message")
    local checker = browser.binding("check_thrown")
    defer checker:close()
    test.assert(expect_boolean(checker:call(
        Value.is_string(target_name),
        Value.is_handle(failure.thrown))),
        "thrown JavaScript value lost its original identity")
  end
  test.assert(caught, "host failure unexpectedly returned")
end

function test_boolean_roundtrip(context: test.Context)
  local target = browser.binding("echo_boolean")
  context:cleanup(function() target:close() end)
  context:run("false", function(_: test.Context)
    test.assert(not expect_boolean(target:call(Value.is_boolean(false))))
  end)
  context:run("true", function(_: test.Context)
    test.assert(expect_boolean(target:call(Value.is_boolean(true))))
  end)
end

local function integer_case(context: test.Context, name: string, input: integer)
  context:run(name, function(_: test.Context)
    local target = browser.binding("echo_integer")
    defer target:close()
    test.assert(expect_integer(target:call(Value.is_integer(input))) == input)
  end)
end

function test_i64_exact(context: test.Context)
  integer_case(context, "minimum", 0x8000000000000000)
  integer_case(context, "maximum", 0x7fffffffffffffff)
  integer_case(context, "below_2_53", 9007199254740991)
  integer_case(context, "at_2_53", 9007199254740992)
  integer_case(context, "above_2_53", 9007199254740993)
  integer_case(context, "negative_above_2_53", -9007199254740993)
  context:run("out_of_range_bigint_from_js", function(_: test.Context)
    local target = browser.binding("overflow_bigint")
    defer target:close()
    local rejected = false
    do
      target:call()
    catch
      rejected = true
      test.assert(error is browser.BrowserError)
      local failure: browser.BrowserError = error
      failure:close()
    end
    test.assert(rejected, "out-of-range BigInt result was accepted")
  end)
end

function test_argument_array_exceeds_inline_storage(_: test.Context)
  local arguments: {browser.BrowserValue} = {}
  for index = 1, 10 do arguments[index] = Value.is_integer(index) end
  local target = browser.binding("echo_integer")
  defer target:close()
  test.assert(expect_integer(target:call(...arguments)) == 1,
              "rooted dynamic argument storage did not survive marshaling")
end

function test_float_preserves_kind_and_bits(context: test.Context)
  context:run("integral_float", function(_: test.Context)
    local target = browser.binding("echo_float")
    defer target:close()
    local result = expect_float(target:call(Value.is_float(17.0)))
    case reflect.inspect(result)
    when is_float(item) then test.assert(item == 17.0)
    else raise "integral float changed runtime tag"
    end
  end)
  context:run("negative_zero", function(_: test.Context)
    local target = browser.binding("echo_float")
    defer target:close()
    local result = expect_float(target:call(Value.is_float(-0.0)))
    test.assert(result == 0.0 and 1.0 / result < 0.0)
  end)
  context:run("nan", function(_: test.Context)
    local target = browser.binding("echo_float")
    defer target:close()
    local result = expect_float(target:call(Value.is_float(0.0 / 0.0)))
    test.assert(result ~= result)
  end)
end

function test_strings_and_utf8(context: test.Context)
  context:run("empty", function(_: test.Context)
    local target = browser.binding("echo_string")
    defer target:close()
    test.assert(expect_string(target:call(Value.is_string(""))) == "")
  end)
  context:run("utf8_and_nul", function(_: test.Context)
    local target = browser.binding("echo_string")
    defer target:close()
    local text = "hello \240\159\140\141\0world"
    test.assert(expect_string(target:call(Value.is_string(text))) == text)
  end)
  context:run("leading_bom_and_bom_only", function(_: test.Context)
    local target = browser.binding("echo_string")
    defer target:close()
    local with_bom = "\239\187\191x"
    local bom_only = "\239\187\191"
    test.assert(expect_string(target:call(Value.is_string(with_bom))) == with_bom)
    test.assert(expect_string(target:call(Value.is_string(bom_only))) == bom_only)
  end)
  context:run("invalid_utf8_from_titan_raises", function(_: test.Context)
    local target = browser.binding("echo_string")
    defer target:close()
    local rejected = false
    do
      target:call(Value.is_string("\0\255\195("))
    catch
      rejected = true
    end
    test.assert(rejected, "invalid UTF-8 in BrowserValue.is_string was accepted")
  end)
  context:run("ill_formed_utf16_from_js_raises", function(_: test.Context)
    local target = browser.binding("ill_formed_string")
    defer target:close()
    local rejected = false
    do
      target:call()
    catch
      rejected = true
      test.assert(error is browser.BrowserError)
      local failure: browser.BrowserError = error
      failure:close()
    end
    test.assert(rejected, "ill-formed UTF-16 JS string result was accepted")
  end)
end

function test_bytes_roundtrip(context: test.Context)
  context:run("empty", function(_: test.Context)
    local target = browser.binding("echo_bytes")
    defer target:close()
    test.assert(expect_bytes(target:call(Value.is_bytes(""))) == "")
  end)
  context:run("binary", function(_: test.Context)
    local target = browser.binding("echo_bytes")
    defer target:close()
    local bytes = "\0\255\195("
    test.assert(expect_bytes(target:call(Value.is_bytes(bytes))) == bytes)
  end)
  context:run("memory_growth", function(_: test.Context)
    local target = browser.binding("large_bytes")
    defer target:close()
    local bytes = expect_bytes(target:call())
    test.assert(#bytes == 20 * 1024 * 1024)
    test.assert(string.sub(bytes, 1, 4) == "\0\255\195(")
    test.assert(string.sub(bytes, #bytes - 3) == "\0\255\195(")
  end)
end

function test_nil_bindings(context: test.Context)
  context:run("null_and_undefined_to_is_nil", function(_: test.Context)
    local null_fn = browser.binding("return_null")
    defer null_fn:close()
    local undef_fn = browser.binding("return_undefined")
    defer undef_fn:close()
    case null_fn:call(Value.is_nil())
    when is_nil() then
    else raise "null return was not BrowserValue.is_nil"
    end
    case undef_fn:call()
    when is_nil() then
    else raise "undefined return was not BrowserValue.is_nil"
    end
  end)
end

function test_js_exceptions_are_recoverable(context: test.Context)
  local names = {"throw_error", "throw_string", "throw_value"}
  for index = 1, #names do
    local name = names[index]
    context:run(name, function(_: test.Context)
      expect_bridge_error(name, "bridge failure")
      local target = browser.binding("echo_integer")
      defer target:close()
      test.assert(expect_integer(target:call(Value.is_integer(42))) == 42)
    end)
  end
end

function test_opaque_falsy_values_and_promise(context: test.Context)
  local names = {"false_value", "zero_value", "null_value", "undefined_value"}
  for index = 1, #names do
    local name = names[index]
    context:run(name, function(_: test.Context)
      local item = browser.binding(name)
      defer item:close()
      local target = browser.binding("check_value")
      defer target:close()
      test.assert(expect_boolean(target:call(
          Value.is_string(name),
          Value.is_handle(item))))
      item:close()
      item:close()
    end)
  end
  context:run("promise_handle", function(_: test.Context)
    local target = browser.binding("promise_value")
    defer target:close()
    local promise = expect_handle(target:call())
    defer promise:close()
    local checker = browser.binding("is_promise")
    defer checker:close()
    test.assert(expect_boolean(checker:call(Value.is_handle(promise))))
  end)
  context:run("js_function_handle", function(_: test.Context)
    local maker = browser.binding("make_js_adder")
    defer maker:close()
    local adder = expect_handle(maker:call(Value.is_integer(5)))
    defer adder:close()
    test.assert(expect_integer(adder:call(Value.is_integer(37))) == 42)
  end)
end

local function drop_handles()
  for _ = 1, 64 do browser.binding("false_value") end
end
function test_unreachable_handle_finalizers(_: test.Context)
  local counter = browser.binding("handle_count")
  defer counter:close()
  gc.collect()
  local before = expect_integer(counter:call())
  drop_handles()
  gc.collect()
  gc.collect()
  test.assert(expect_integer(counter:call()) == before, "unreachable BrowserHandle units survived collection")
end

local state_close_marker: ({string: integer})?
function test_user_state_close_finalizer(_: test.Context)
  local pending: browser.BrowserHandle?
  local source = browser.binding("state_close_request")
  defer source:close()
  local notify = function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_nil()
  end
  local request = source:start(notify, notify)
  request:cancel()
  -- Keep the cancelled request's owning slot for the earlier finalizer too.
  early_close.set_finalizer(function()
    local handle = pending
    handle:close()
    handle:close()
    request:close()
    request:close()
    ffi.titan_bridge_test_earlier_cleanup(0)
    browser.binding("state_close_handle") -- Must raise after record invalidation.
  end)
  local marker: {string: integer} = {}
  gc.finalizable<|value|>(marker, function(_: value)
    local handle = browser.binding("state_close_handle")
    handle:close()
    pending = browser.binding("state_close_handle")
    local observer = browser.binding("state_close_observe")
    defer observer:close()
    observer:call(Value.is_integer(0))
  end)
  state_close_marker = marker
end

function test_callable_wrapper_identity_and_roundtrip(_: test.Context)
  local base = 5
  local fn = function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_integer(expect_integer(...[1]) + base)
  end
  local same_checker = browser.binding("check_same_wrapper")
  defer same_checker:close()
  test.assert(expect_boolean(same_checker:call(
      Value.is_callable(fn),
      Value.is_callable(fn))),
      "same Titan callable did not receive one wrapper per state")
  local echo = browser.binding("echo_callable")
  defer echo:close()
  case echo:call(Value.is_callable(fn))
  when is_callable(roundtripped) then
    test.assert(roundtripped == fn, "callable wrapper did not round-trip to original function")
    test.assert(expect_integer(roundtripped(Value.is_integer(10))) == 15)
  else
    raise "echo_callable did not return is_callable"
  end
end

local function export_shared_captures()
  local count = 0
  publish("increment", function(...: browser.BrowserValue): browser.BrowserValue
    count = count + expect_integer(...[1])
    return Value.is_integer(count)
  end)
  publish("read_capture", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_integer(count)
  end)
end
function test_export_original_capture_roots(_: test.Context)
  export_shared_captures()
  gc.collect()
  gc.collect()
end

function test_export_callbacks(_: test.Context)
  publish("one_nil", function(...: browser.BrowserValue): browser.BrowserValue
    if #... > 0 then
      case ...[1]
      when is_nil() then return Value.is_nil()
      else raise "one_nil expects nil or no arguments"
      end
    end
    return Value.is_nil()
  end)
  publish("echo_value", function(...: browser.BrowserValue): browser.BrowserValue
    return ...[1]
  end)
  publish("typed_echo", function(...: browser.BrowserValue): browser.BrowserValue
    if #... ~= 4 then raise "typed_echo expects 4 arguments" end
    local _ = expect_boolean(...[1])
    local _ = expect_integer(...[2])
    local _ = expect_float(...[3])
    local bytes = expect_bytes(...[4])
    return Value.is_bytes(bytes)
  end)
  publish("wide_sum", function(...: browser.BrowserValue): browser.BrowserValue
    local total = 0
    for index = 1, #... do
      total = total + expect_integer(...[index])
    end
    return Value.is_integer(total)
  end)
  publish("bad_utf8_result", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_string("\0\255\195(")
  end)
  publish("handle_echo", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_handle(expect_handle(...[1]))
  end)
  publish("callable_echo", function(...: browser.BrowserValue): browser.BrowserValue
    case ...[1]
    when is_callable(fn) then return Value.is_callable(fn)
    end
    raise "callable_echo expects a callable"
  end)
  publish("titan_failure", function(...: browser.BrowserValue): browser.BrowserValue raise "Titan bridge failure\0\255" end)
  publish("valid_after_failure", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_integer(42)
  end)
  publish("force_gc", function(...: browser.BrowserValue): browser.BrowserValue
    gc.collect()
    gc.collect()
    return Value.is_nil()
  end)
  publish("notification", function(...: browser.BrowserValue): browser.BrowserValue
    local item = expect_integer(...[1])
    local target = browser.binding("notification")
    defer target:close()
    target:call(Value.is_integer(item))
    if item == -1 then raise "notification failure" end
    return Value.is_nil()
  end)
  publish("arm_invoke_oom", function(...: browser.BrowserValue): browser.BrowserValue
    ffi.titan_bridge_test_arm_alloc_failure(L, expect_integer(...[1]))
    return Value.is_nil()
  end)
  publish("arm_invoke_oom_count", function(...: browser.BrowserValue): browser.BrowserValue
    ffi.titan_bridge_test_arm_alloc_failure_count(
        L, expect_integer(...[1]), expect_integer(...[2]))
    return Value.is_nil()
  end)
  publish("finish_invoke_oom", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_integer(ffi.titan_bridge_test_finish_alloc_failure(L))
  end)
  publish("raise_error_kind", function(...: browser.BrowserValue): browser.BrowserValue
    local mode = expect_integer(...[1])
    if mode == 1 then
      raise true
    elseif mode == 2 then
      local tbl: {string: integer} = { ["a"] = 1 }
      raise tbl
    elseif mode == 3 then
      raise ffi.titan_bridge_test_make_error_object(L, 1)
    elseif mode == 4 then
      raise ffi.titan_bridge_test_make_error_object(L, 2)
    elseif mode == 5 then
      raise ffi.titan_bridge_test_make_error_object(L, 3)
    elseif mode == 6 then
      local fail_binding = browser.binding("throw_error")
      defer fail_binding:close()
      fail_binding:call()
    elseif mode == 7 then
      raise ffi.titan_bridge_test_make_error_object(L, 4)
    elseif mode == 8 then
      raise 2.0
    elseif mode == 9 then
      raise -0.0
    elseif mode == 10 then
      raise 42
    elseif mode == 11 then
      raise 2.5
    elseif mode == 12 then
      raise ffi.titan_bridge_test_make_error_object(L, 5)
    end
    return Value.is_nil()
  end)
end

function test_export_cross_entry_resumption(_: test.Context)
  local child = coroutine.create(function(_: value): value
    local first = coroutine.yield("parked", "bridge-single")
    return first
  end, "bridge-single")
  test.assert(child:resume(nil) == "parked")
  publish("resume_single", function(...: browser.BrowserValue): browser.BrowserValue
    local item = expect_integer(...[1])
    local resumed: integer = child:resume(item)
    return Value.is_integer(resumed)
  end)
  local inner = coroutine.create(function(_: value): value
    return coroutine.yield("chain-parked", "bridge-outer")
  end, "bridge-inner")
  local middle = coroutine.create(function(_: value): value return inner:resume(nil) end, "bridge-middle")
  local outer = coroutine.create(function(_: value): value return middle:resume(nil) end, "bridge-outer")
  test.assert(outer:resume(nil) == "chain-parked")
  test.assert(inner:status() == "stacked" and middle:status() == "stacked")
  publish("resume_stacked", function(...: browser.BrowserValue): browser.BrowserValue
    local item = expect_integer(...[1])
    local result: integer = outer:resume(item)
    test.assert(outer:status() == "dead" and inner:status() == "dead" and middle:status() == "dead")
    return Value.is_integer(result)
  end)
end

local function abandon_for_allocation(log: {string})
  local child = coroutine.create(function(_: value): value
    defer do
      log[#log + 1] = "closed"
      local target = browser.binding("allocation_cleanup")
      defer target:close()
      target:call()
    end
    coroutine.yield(nil, "bridge-abandoned")
    raise "abandoned callback resumed normally"
  end, "bridge-abandoned")
  child:resume(nil)
end
function test_export_allocation_cleanup_callback(_: test.Context)
  publish("allocation_gc", function(...: browser.BrowserValue): browser.BrowserValue
    gc.incremental()
    gc.pause_percent(0)
    gc.stepmul(1000)
    gc.pause()
    local log: {string} = {}
    abandon_for_allocation(log)
    local garbage: {value} = {}
    gc.resume()
    for index = 1, 32768 do
      garbage[index] = {index, index + 1, index + 2}
      if #log > 0 then break end
    end
    test.assert(#log == 1)
    return Value.is_integer(42)
  end)
end

local pending: browser.BrowserRequest?

local record PinMarker
  local weight: integer
end
local pin_markers_collected = 0
local function pin_marker_finalize(candidate: value)
  local marker: PinMarker = candidate
  pin_markers_collected = pin_markers_collected + marker.weight
end

function test_export_request_lifetimes(_: test.Context)
  publish("prepare_request_lifetime", function(...: Value): Value
    local name = expect_string(...[1])
    local listener = expect_boolean(...[2])
    pin_markers_collected = 0
    local done_marker = PinMarker { weight = 1 }
    gc.finalizable<|value|>(done_marker, pin_marker_finalize)
    local failed_marker = PinMarker { weight = 2 }
    gc.finalizable<|value|>(failed_marker, pin_marker_finalize)
    local done = function(...: Value): Value
      local observer = browser.binding("request_success")
      defer observer:close()
      observer:call(...[1])
      return Value.is_integer(done_marker.weight)
    end
    local failed = function(...: Value): Value
      local thrown = expect_handle(...[2])
      defer thrown:close()
      local observer = browser.binding("request_failure")
      defer observer:close()
      observer:call(Value.is_string(expect_string(...[1])), Value.is_handle(thrown))
      return Value.is_integer(failed_marker.weight)
    end
    local source = browser.binding(name)
    defer source:close()
    if listener then pending = source:listen(done, failed)
    else pending = source:start(done, failed)
    end
    return Value.is_nil()
  end)
end

function test_export_requests_and_listeners(_: test.Context)
  local stop_after_success: boolean?
  local completion = function(...: browser.BrowserValue): browser.BrowserValue
    local observer = browser.binding("request_success")
    defer observer:close()
    if #... == 1 then
      observer:call(...[1])
    else
      observer:call(Value.is_integer(expect_integer(...[1])),
                    Value.is_bytes(expect_bytes(...[2])))
    end
    if stop_after_success ~= nil then
      if stop_after_success then pending:close() else pending:cancel() end
    end
    return Value.is_nil()
  end
  local failure = function(...: browser.BrowserValue): browser.BrowserValue
    local message = expect_string(...[1])
    local thrown = expect_handle(...[2])
    defer thrown:close()
    local observer = browser.binding("request_failure")
    defer observer:close()
    observer:call(Value.is_string(message), Value.is_handle(thrown))
    return Value.is_nil()
  end
  local bad_failure = function(...: browser.BrowserValue): browser.BrowserValue
    -- Rejects its (is_string, is_handle) arguments at delivery time.
    local _ = expect_integer(...[1])
    return Value.is_nil()
  end
  publish("start_request", function(...: browser.BrowserValue): browser.BrowserValue
    local name = expect_string(...[1])
    local target = browser.binding(name)
    defer target:close()
    pending = target:start(completion, failure)
    return Value.is_nil()
  end)
  publish("start_bad_failure_request", function(...: browser.BrowserValue): browser.BrowserValue
    local name = expect_string(...[1])
    local target = browser.binding(name)
    defer target:close()
    pending = target:start(completion, bad_failure)
    return Value.is_nil()
  end)
  publish("start_listener", function(...: browser.BrowserValue): browser.BrowserValue
    local target = browser.binding("listener")
    defer target:close()
    pending = target:listen(completion, failure)
    return Value.is_nil()
  end)
  publish("stop_listener_on_success", function(...: browser.BrowserValue): browser.BrowserValue
    case ...[1]
    when is_nil() then stop_after_success = nil
    when is_boolean(flag) then stop_after_success = flag
    else raise "stop_listener_on_success expects boolean or nil"
    end
    return Value.is_nil()
  end)
  publish("cancel_request", function(...: browser.BrowserValue): browser.BrowserValue
    if pending ~= nil then pending:cancel() end
    return Value.is_nil()
  end)
  publish("close_request", function(...: browser.BrowserValue): browser.BrowserValue
    if pending ~= nil then pending:close() end
    return Value.is_nil()
  end)

  local hold_request: browser.BrowserRequest?
  local hold_listener: browser.BrowserRequest?
  publish("prepare_pin_holders", function(...: browser.BrowserValue): browser.BrowserValue
    pin_markers_collected = 0
    local marker = PinMarker { weight = 1 }
    gc.finalizable<|value|>(marker, pin_marker_finalize)
    local shared_cb = function(...: browser.BrowserValue): browser.BrowserValue
      local observer = browser.binding("request_success")
      defer observer:close()
      observer:call(Value.is_integer(expect_integer(...[1]) + marker.weight))
      return Value.is_integer(marker.weight)
    end
    local fail_marker = PinMarker { weight = 2 }
    gc.finalizable<|value|>(fail_marker, pin_marker_finalize)
    local shared_fail = function(...: browser.BrowserValue): browser.BrowserValue
      case ...[2]
      when is_handle(thrown) then thrown:close()
      end
      return Value.is_integer(fail_marker.weight)
    end
    local req_target = browser.binding("pin_hold_request")
    defer req_target:close()
    hold_request = req_target:start(shared_cb, shared_fail)
    local list_target = browser.binding("pin_hold_listener")
    defer list_target:close()
    hold_listener = list_target:listen(shared_cb, shared_fail)
    return Value.is_callable(shared_cb)
  end)
  publish("close_pin_holders", function(...: browser.BrowserValue): browser.BrowserValue
    if hold_request ~= nil then hold_request:close(); hold_request = nil end
    if hold_listener ~= nil then hold_listener:close(); hold_listener = nil end
    return Value.is_nil()
  end)
  publish("pin_holders_collected", function(...: browser.BrowserValue): browser.BrowserValue
    gc.collect()
    gc.collect()
    return Value.is_integer(pin_markers_collected)
  end)
  publish("lost_release_regression", function(...: browser.BrowserValue): browser.BrowserValue
    pin_markers_collected = 0
    local marker = PinMarker { weight = 64 }
    gc.finalizable<|value|>(marker, pin_marker_finalize)
    local done = function(...: browser.BrowserValue): browser.BrowserValue
      return Value.is_integer(marker.weight)
    end
    local fail_cb = function(...: browser.BrowserValue): browser.BrowserValue
      case ...[2]
      when is_handle(thrown) then thrown:close()
      end
      return Value.is_nil()
    end
    local list_target = browser.binding("pin_hold_listener")
    defer list_target:close()
    local req = list_target:listen(done, fail_cb)
    req:close()
    local echo = browser.binding("echo_string")
    defer echo:close()
    local caught = false
    do
      echo:call(Value.is_callable(done), Value.is_string("\255"))
    catch
      caught = true
    end
    test.assert(caught, "invalid UTF-8 argument did not raise")
    return Value.is_nil()
  end)
  local run_saved_wrapper_case = function(mode: integer)
    local marker = PinMarker { weight = 100 + mode }
    gc.finalizable<|value|>(marker, pin_marker_finalize)
    local cb = function(...: browser.BrowserValue): browser.BrowserValue
      return Value.is_integer(expect_integer(...[1]) * 2 + (marker.weight - (100 + mode)))
    end
    local caught = false
    if mode == 1 or mode == 2 then
      local name = mode == 1 and "save_and_throw" or "save_and_bad_return"
      local target = browser.binding(name)
      defer target:close()
      do
        target:call(Value.is_callable(cb))
      catch
        caught = true
        if error is browser.BrowserError then
          local err: browser.BrowserError = error
          err:close()
        end
      end
    else
      local done_marker = PinMarker { weight = 10 }
      gc.finalizable<|value|>(done_marker, pin_marker_finalize)
      local done_cb = function(...: browser.BrowserValue): browser.BrowserValue
        return Value.is_integer(done_marker.weight)
      end
      local fail_marker = PinMarker { weight = 20 }
      gc.finalizable<|value|>(fail_marker, pin_marker_finalize)
      local fail_cb = function(...: browser.BrowserValue): browser.BrowserValue
        return Value.is_integer(fail_marker.weight)
      end
      local target = browser.binding("save_and_refuse_start")
      defer target:close()
      do
        target:start(done_cb, fail_cb, Value.is_callable(cb))
      catch
        caught = true
        if error is browser.BrowserError then
          local err: browser.BrowserError = error
          err:close()
        end
      end
    end
    test.assert(caught, "host saved-wrapper failure did not raise BrowserError")
  end
  publish("test_host_saved_wrapper", function(...: browser.BrowserValue): browser.BrowserValue
    local mode = expect_integer(...[1])
    pin_markers_collected = 0
    run_saved_wrapper_case(mode)
    gc.collect()
    gc.collect()
    return Value.is_integer(pin_markers_collected)
  end)
  publish("make_pinned_wrapper", function(...: browser.BrowserValue): browser.BrowserValue
    local weight = expect_integer(...[1])
    pin_markers_collected = 0
    local captured = PinMarker { weight = weight }
    gc.finalizable<|value|>(captured, pin_marker_finalize)
    local fn = function(...: browser.BrowserValue): browser.BrowserValue
      return Value.is_integer(captured.weight)
    end
    return Value.is_callable(fn)
  end)
  publish("exit_for_release", function(...: browser.BrowserValue): browser.BrowserValue
    browser.drive_begin()
    browser.drive_end(0)
    return Value.is_nil()
  end)
  local nested_finalizer_ran = false
  local arm_nested_finalizer = function()
    local finalizer_obj: {string: integer} = {}
    gc.finalizable<|value|>(finalizer_obj, function(_: value)
      local nested = browser.binding("echo_integer")
      defer nested:close()
      if expect_integer(nested:call(Value.is_integer(7))) == 7 then
        nested_finalizer_ran = true
      end
    end)
  end
  publish("nested_finalizer_rollback", function(...: browser.BrowserValue): browser.BrowserValue
    local arm_oom = expect_integer(...[1])
    pin_markers_collected = 0
    nested_finalizer_ran = false
    arm_nested_finalizer()
    local captured = PinMarker { weight = arm_oom ~= 0 and 77 or 88 }
    gc.finalizable<|value|>(captured, pin_marker_finalize)
    local first = function(...: browser.BrowserValue): browser.BrowserValue
      return Value.is_integer(captured.weight)
    end
    ffi.titan_bridge_test_arm_identity_gc_and_fail(L, 1, arm_oom)
    return Value.is_callable(first)
  end)
  publish("nested_finalizer_ran", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_boolean(nested_finalizer_ran)
  end)
end

function test_export_stdio(_: test.Context)
  publish("stdio_append", function(...: browser.BrowserValue): browser.BrowserValue
    local bytes = expect_bytes(...[1])
    local count = ffi.fwrite(bytes as foreign const *char, 1 as foreign size_t,
                             #bytes as foreign size_t, ffi.stdout)
    test.assert(count == #bytes, "C stdio append returned a short count")
    test.assert(ffi.fflush(ffi.stdout) == 0, "C stdio append did not flush")
    return Value.is_nil()
  end)
  publish("cleanup_failure", function(...: browser.BrowserValue): browser.BrowserValue
    local bytes = expect_bytes(...[1])
    local count = ffi.fwrite(bytes as foreign const *char, 1 as foreign size_t,
                             #bytes as foreign size_t, ffi.stdout)
    test.assert(count == #bytes, "primary-failure stdout returned a short count")
    test.assert(ffi.fflush(ffi.stdout) == 0, "primary-failure stdout did not flush")
    count = ffi.fwrite(bytes as foreign const *char, 1 as foreign size_t,
                       #bytes as foreign size_t, ffi.stderr)
    test.assert(count == #bytes, "primary-failure stderr returned a short count")
    test.assert(ffi.fflush(ffi.stderr) == 0, "primary-failure stderr did not flush")
    raise "Titan bridge failure\0\255"
  end)
end

local stored_callable: Callable?
local function arm_release_gc()
  local marker: {string: integer} = {}
  gc.finalizable<|value|>(marker, function(_: value)
    local target = browser.binding("r1_release_result")
    defer target:close()
    target:call(Value.is_callable(stored_callable))
  end)
end
function test_export_callable_reuse(_: test.Context)
  publish("make_callable", function(...: browser.BrowserValue): browser.BrowserValue
    stored_callable = function(...: browser.BrowserValue): browser.BrowserValue
      return Value.is_integer(77)
    end
    return Value.is_callable(stored_callable)
  end)
  publish("reexport_callable", function(...: browser.BrowserValue): browser.BrowserValue
    return Value.is_callable(stored_callable)
  end)
  publish("release_with_gc_due", function(...: browser.BrowserValue): browser.BrowserValue
    local incremental = gc.incremental()
    local stepmul = gc.stepmul(0)
    gc.collect()
    gc.pause()
    arm_release_gc()
    -- No Titan call may poll between making debt due and the raw release import.
    ffi.lua_gc(L, ffi.LUA_GCRESTART)
    local deferred = ffi.titan_bridge_test_release_due_gc() ~= 0
    gc.stepmul(stepmul)
    if not incremental then gc.generational() end
    return Value.is_boolean(deferred)
  end)
  publish("release_with_gc_paused", function(...: browser.BrowserValue): browser.BrowserValue
    gc.pause()
    defer gc.resume()
    ffi.titan_bridge_test_release_due_gc()
    return Value.is_boolean(gc.paused())
  end)
end

local function expect_drive_refusal(action: function (): (), expected: string)
  local caught = false
  do
    action()
  catch
    caught = true
    test.assert(error == expected, "the drive interface raised a different error")
  end
  test.assert(caught, "the drive interface accepted a call outside its drive")
end

-- The drive itself is exercised by the mini-driver fixture under the real
-- loader; outside a drive every member except is_owner and wake refuses.
function test_drive_interface_outside_a_drive(_: test.Context)
  test.assert(browser.is_owner(), "the launcher's state is not the instance owner")
  test.assert(browser.RELINQUISH_RESUMED == 0 and browser.RELINQUISH_IDLE == 1 and
              browser.RELINQUISH_DISPOSING == 2, "relinquish statuses changed")
  local outside = " requires the driving owner's main thread outside delivery"
  expect_drive_refusal(function() browser.relinquish(true) end, "browser relinquish" .. outside)
  expect_drive_refusal(function() browser.deliver() end, "browser delivery" .. outside)
  expect_drive_refusal(function() browser.drive_end(nil) end, "browser drive_end" .. outside)
  browser.wake()
  local refusal = coroutine.create(function(_: value): value
    browser.drive_begin()
    return nil
  end, "drive-refusal")
  expect_drive_refusal(function() refusal:resume(nil) end,
                       "browser drive requires the instance owner's main thread")
end

local function abandon_independent()
  local owner: value = ffi.titan_bridge_test_new_state(L, 2)
  ffi.titan_bridge_test_check_state(L, owner)
end
function test_independent_explicit_and_gc_close(_: test.Context)
