local early_close = import "browser.early_close"
local browser = import "browser"
local gc = import "gc"
local test = import "test"

local type Value = browser.BrowserValue

local held_handle: browser.BrowserHandle?
local held_pin: browser.BrowserPin?
local requests: {browser.BrowserRequest} = {}
local finalizer_anchor: {string: integer}?

local function observe(index: integer, kind: string)
  const target = browser.binding("public_state_entry")
  defer target:close()
  target:call(Value.is_integer(index), Value.is_string(kind))
end

function prepare(index: integer): integer
  const callback = function (...: Value): Value
    observe(index, "wrapper")
    case ...[1]
    when is_integer(number) then return Value.is_integer(number + index)
    end
    raise "public child expects an integer"
  end
  const pin = browser.pin(callback)
  local state, slot, generation = pin:identity()
  test.assert(state > 0 and slot > 0 and generation > 0,
    "a live public pin has a zero state, slot or generation")
  pin:close()
  pin:close()
  local same_state, closed_slot, same_generation = pin:identity()
  test.assert(same_state == state and closed_slot == 0 and same_generation == generation,
    "public pin close was not idempotent while its state was live")
  held_pin = browser.pin(callback)
  held_handle = browser.binding("public_state_handle")
  const source = browser.binding("public_state_request")
  defer source:close()
  const names = {"queued", "late"}
  for position = 1, #names do
    const name = names[position]
    const success = function (...: Value): Value
      observe(index, name)
      return Value.is_nil()
    end
    const failure = function (...: Value): Value
      observe(index, "failure")
      case ...[2]
      when is_handle(thrown) then thrown:close()
      end
      return Value.is_nil()
    end
    requests[#requests + 1] = source:start(success, failure,
      Value.is_integer(index), Value.is_string(name))
  end
  -- This object's finalizer predates the browser record in this Lua state.
  early_close.set_finalizer(function ()
    local inert = false
    do
      const handle = held_handle
      handle:close()
      handle:close()
      const pin = held_pin
      pin:close()
      pin:close()
      for position = 1, #requests do
        requests[position]:close()
        requests[position]:close()
      end
      inert = true
    catch
    end
    test.assert(inert, "public earlier-object closes were not inert")
    -- Reaching this raises the required Lua finalizer warning after inert closes.
    browser.binding("public_state_after_close")
  end)
  -- A plain Map gets a private metatable; Arrays share their finalizer callback.
  const anchor: {string: integer} = {}
  gc.finalizable<|value|>(anchor, function (_: value)
    const target = browser.binding("public_state_finalizer")
    defer target:close()
    target:call(Value.is_integer(index))
  end)
  finalizer_anchor = anchor
  const target = browser.binding("publish")
  defer target:close()
  target:call(Value.is_string("public_child_" .. index), Value.is_callable(callback))
  return state
end
