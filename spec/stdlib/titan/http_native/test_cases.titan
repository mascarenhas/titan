function test_server_idle_timeout_api_validation_and_updates(
    context: test.Context)
  local missing_pem_path = absent_temporary_path(context)
  local start: CaseStart = function (first_port: integer): async.Task
    return start_idle_timeout_api(first_port, missing_pem_path)
  end
  run_case(context, start, 56000, "idle-timeout-api-ok")
end

