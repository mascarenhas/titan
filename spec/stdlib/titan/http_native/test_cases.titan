-- Each legacy case used a fresh child process. The native runner keeps the
-- same complete Task boundary, deterministic port seed, EADDRINUSE retry, and
-- public status/outcome oracle while executing the protocols in one Runtime.
local type CaseStart = (integer) -> async.Task

local function run_case(context: test.Context, start: CaseStart,
                        first_port: integer, expected: string)
  local task = start(first_port)
  context:cleanup(function ()
    cancel_and_join_task(task, "native HTTP test cleanup")
  end)
  local status = async.join(task)
  check(status:has_succeeded(),
        "HTTP case Task ended " .. status:as_string() ..
        " with outcome " .. result())
  check(result() == expected,
        "HTTP case outcome was " .. result() .. ", expected " .. expected)
end

function test_client_parses_fragmented_chunked_response(
    context: test.Context)
  run_case(context, start_client, 50000, "client-ok")
end

function test_client_validates_supplied_host_authority(
