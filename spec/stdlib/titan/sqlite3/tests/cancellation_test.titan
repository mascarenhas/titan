local function assert_cancelled(task: async.Task, expected: string)
  local status = async.join(task)
  case status
  when cancelled: reason then
    case reason
    when simple: message then
      test.assert(message == expected, "SQLite work changed cancellation reason")
    else
      raise "SQLite work replaced simple cancellation with a complex reason"
    end
  else
    raise "SQLite operation did not preserve the cancelled Task status"
  end
end

function test_pending_cancellation_does_not_open_a_database(
    context: test.Context)
  runtime_test.run(function ()
    local path = fs.tmpname()
    fs.unlink(path)
    defer remove_if_present(path)
    local published = false
    local target = async.run<nil, value>(function (): nil
      async.running():cancel(async.CancellationReason.simple(
          "cancel before SQLite open"))
      local connection = sqlite3.connect(path)
      defer connection:close()
      published = true
      return nil
    end)
    task_support.cleanup_task(target, "SQLite unopened Task cleanup")
    assert_cancelled(target, "cancel before SQLite open")
    test.assert(not published and fs.stat(path) == nil,
                "pending cancellation submitted SQLite open or published a handle")
  end)
end

function test_pending_cancellation_does_not_prepare_or_leave_connection_busy(
    context: test.Context)
  runtime_test.run(function ()
    local connection = sqlite3.connect(":memory:")
    defer connection:close()
    local published = false
    local target = async.run<nil, value>(function (): nil
      async.running():cancel(async.CancellationReason.simple(
          "cancel before SQLite prepare"))
      local statement = connection:prepare("SELECT 1")
      defer statement:close()
      published = true
      return nil
    end)
    task_support.cleanup_task(target, "SQLite unprepared Task cleanup")
    assert_cancelled(target, "cancel before SQLite prepare")
    test.assert(not published and
                scalar_integer(connection, "SELECT 23") == 23,
                "cancelled prepare published a Statement or kept its reservation")
  end)
end

function test_pending_cancellation_does_not_execute_and_statement_is_reusable(
    context: test.Context)
  runtime_test.run(function ()
    local connection = sqlite3.connect(":memory:")
    defer connection:close()
    execute_sql(connection, "CREATE TABLE item (value INTEGER)")
    local statement = connection:prepare("INSERT INTO item VALUES (?)")
    defer statement:close()
    local target = async.run<nil, value>(function (): nil
      async.running():cancel(async.CancellationReason.simple(
          "cancel before SQLite execute"))
      statement:execute(7)
      return nil
    end)
    task_support.cleanup_task(target, "SQLite unexecuted Task cleanup")
    assert_cancelled(target, "cancel before SQLite execute")
    test.assert(statement:execute(8) == 1 and
                scalar_integer(connection, "SELECT count(*) FROM item") == 1 and
                scalar_integer(connection, "SELECT value FROM item") == 8,
                "cancelled execute ran SQL or prevented Statement reuse")
  end)
end

function test_cancelled_unwind_completes_cursor_statement_and_connection_closes(
    context: test.Context)
  runtime_test.run(function ()
    local retired = 0
    local target = async.run<nil, value>(function (): nil
      local connection = sqlite3.connect(":memory:")
      defer do
        connection:close()
        retired = retired + 1
      end
      local statement = connection:prepare("SELECT 1 UNION ALL SELECT 2")
      defer do
        statement:close()
        retired = retired + 1
      end
      local cursor = statement:query()
      defer do
        cursor:close()
        retired = retired + 1
      end
      required_row(cursor)
      async.running():cancel(async.CancellationReason.simple(
          "cancel SQLite owners"))
      timer.yield()
      return nil
    end)
    task_support.cleanup_task(target, "SQLite cancelled-owner Task cleanup")
    assert_cancelled(target, "cancel SQLite owners")
    test.assert(retired == 3,
                "cancellation prevented a deferred native owner from retiring")
  end)
end

function test_pending_cancellation_delivers_each_explicit_cleanup_completion(
    context: test.Context)
  runtime_test.run(function ()
    local completed = 0
    local target = async.run<nil, value>(function (): nil
      local connection = sqlite3.connect(":memory:")
      defer connection:close()
      local statement = connection:prepare("SELECT 1 UNION ALL SELECT 2")
      defer statement:close()
      local cursor = statement:query()
      defer cursor:close()
      async.running():cancel(async.CancellationReason.simple(
          "cancel before SQLite cleanup"))
      cursor:close()
      completed = completed + 1
      statement:close()
      completed = completed + 1
      connection:close()
      completed = completed + 1
      return nil
    end)
    task_support.cleanup_task(target, "SQLite explicit-cleanup Task cleanup")
    assert_cancelled(target, "cancel before SQLite cleanup")
    test.assert(completed == 3,
                "pending cancellation replaced an ownership-retiring completion")
  end)
end
