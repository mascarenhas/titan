local transfer_lua = import "lua"
local transfer_gc = import "gc"

function test_connection_transfer_preserves_transactions_and_detaches_source(
    _: test.Context)
  runtime_test.run(function ()
    const source = sqlite3.connect(":memory:")
    defer source:close()
    execute_sql(source, "CREATE TABLE item (value INTEGER)")
    execute_sql(source, "INSERT INTO item VALUES (1)")
    source:set_autocommit(false)
    execute_sql(source, "INSERT INTO item VALUES (2)")
    execute_sql(source, "SAVEPOINT handoff")
    execute_sql(source, "INSERT INTO item VALUES (3)")

    const packet = async.TransferValue.from_value(source)
    const target: sqlite3.Connection = packet:to_value()
    defer target:close()
    source:close()
    const failure = expect_wrapper_error(function () source:get_autocommit() end)
    test.assert(failure.message == "connection is closed")
    expect_wrapper_error(function () source:to_transfer_payload() end)
    test.assert(not target:get_autocommit() and
                scalar_integer(target, "SELECT count(*) FROM item") == 3)
    execute_sql(target, "ROLLBACK TO handoff")
    execute_sql(target, "RELEASE handoff")
    test.assert(scalar_integer(target, "SELECT count(*) FROM item") == 2)
    target:rollback()
    test.assert(target:get_autocommit() and
                scalar_integer(target, "SELECT value FROM item") == 1)
  end)
end

function test_connection_transfer_rejects_statements_and_cursors_before_detach(
    _: test.Context)
  runtime_test.run(function ()
    const source = sqlite3.connect(":memory:")
    defer source:close()
    const statement = source:prepare("SELECT 7 UNION ALL SELECT 9")
    defer statement:close()
    const idle = expect_wrapper_error(function () source:to_transfer_payload() end)
    test.assert(idle.message == "connection owns open statements" and
                idle.operation == "to_transfer_payload")
    const cursor = statement:query()
    defer cursor:close()
    const active = expect_wrapper_error(function () source:to_transfer_payload() end)
    test.assert(active.message == "connection has an active cursor")
    test.assert(required_row(cursor):get(1) as integer == 7,
                "rejected transfer damaged the active cursor")
    cursor:close()
    statement:close()
    const target = sqlite3.Connection.from_transfer_payload(source:to_transfer_payload())
    defer target:close()
    test.assert(scalar_integer(target, "SELECT 11") == 11)
  end)
end

function test_connection_transfer_rejects_invalid_payloads(_: test.Context)
  expect_wrapper_error(function () sqlite3.Connection.from_transfer_payload("") end)
  expect_wrapper_error(function ()
    sqlite3.Connection.from_transfer_payload(string.char(8, 0))
  end)
  expect_wrapper_error(function ()
    sqlite3.Connection.from_transfer_payload(string.char(9) .. string.rep("\0", 8))
  end)
  expect_wrapper_error(function ()
    sqlite3.Connection.from_transfer_payload(string.char(9) .. string.rep("\0", 7))
  end)
end

function test_connection_transfer_hooks_do_not_need_a_running_task(_: test.Context)
  local source: sqlite3.Connection?
  local target: sqlite3.Connection?
  defer runtime_test.run(function ()
    if target then target:close() end
    if source then source:close() end
  end)
  runtime_test.run(function () source = sqlite3.connect(":memory:") end)
  target = sqlite3.Connection.from_transfer_payload(source:to_transfer_payload())
  runtime_test.run(function ()
    test.assert(scalar_integer(target, "SELECT 13") == 13)
  end)
end

-- The child adopts the Connection with its open transaction and savepoint,
-- then hands it back as its result; the transfer hooks are synchronous, so a
-- child needs no Task on any target. Closing the donor child must not retire
-- the Connection it handed off.
function test_connection_transfer_crosses_lua_states_and_survives_donor_close(
    _: test.Context)
  runtime_test.run(function ()
    const source = sqlite3.connect(":memory:")
    defer source:close()
    execute_sql(source, "CREATE TABLE item (value INTEGER)")
    execute_sql(source, "INSERT INTO item VALUES (19)")
    source:set_autocommit(false)
    execute_sql(source, "SAVEPOINT handoff")
    execute_sql(source, "INSERT INTO item VALUES (23)")
    const state = transfer_lua.new()
    defer state:close()
    const packet: async.TransferValue = state:run([[
      local connection = ...
      assert(connection ~= nil, 'the child did not adopt the connection')
      return connection
    ]], "=sqlite-connection-handoff", async.TransferValue.from_value(source))
    const detached = expect_wrapper_error(function () source:get_autocommit() end)
    test.assert(detached.message == "connection is closed",
                "the handed-off Connection's source alias stayed open")
    state:close()
    transfer_gc.collect()
    transfer_gc.collect()
    const target: sqlite3.Connection = packet:to_value()
    defer target:close()
    test.assert(not target:get_autocommit() and
                scalar_integer(target, "SELECT count(*) FROM item") == 2,
                "the Connection lost its transaction crossing Lua states")
    execute_sql(target, "ROLLBACK TO handoff")
    execute_sql(target, "RELEASE handoff")
    target:commit()
    test.assert(target:get_autocommit() and
                scalar_integer(target, "SELECT value FROM item") == 19,
                "the savepoint did not survive the Lua state handoff")
  end)
end
