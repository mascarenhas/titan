function test_transactions_follow_native_autocommit_without_restart(
    context: test.Context)
  runtime_test.run(function ()
    local connection = sqlite3.connect(":memory:")
    defer connection:close()
    execute_sql(connection, "CREATE TABLE item (value INTEGER)")
    test.assert(connection:get_autocommit(),
                "new connection did not start in native autocommit mode")
    connection:commit()
    connection:rollback()
    connection:set_autocommit(true)
    connection:set_autocommit(false)
    connection:set_autocommit(false)
    test.assert(not connection:get_autocommit(),
                "disabling autocommit did not start one transaction")
    execute_sql(connection, "INSERT INTO item VALUES (1)")
    connection:commit()
    test.assert(connection:get_autocommit() and
                scalar_integer(connection, "SELECT count(*) FROM item") == 1,
                "commit lost data or silently started another transaction")
    connection:set_autocommit(false)
    execute_sql(connection, "INSERT INTO item VALUES (2)")
    connection:rollback()
    test.assert(connection:get_autocommit() and
                scalar_integer(connection, "SELECT count(*) FROM item") == 1,
                "rollback retained uncommitted data or restarted a transaction")
  end)
end

function test_enabling_autocommit_commits_and_cursor_close_does_not_rollback(
    context: test.Context)
  runtime_test.run(function ()
    local connection = sqlite3.connect(":memory:")
    defer connection:close()
    execute_sql(connection, "CREATE TABLE item (value INTEGER)")
    connection:set_autocommit(false)
    execute_sql(connection, "INSERT INTO item VALUES (4)")
    local statement = connection:prepare("SELECT value FROM item")
    defer statement:close()
    local cursor = statement:query()
    defer cursor:close()
    cursor:close()
    test.assert(not connection:get_autocommit(),
                "early Cursor close implicitly rolled back its transaction")
    connection:set_autocommit(true)
    test.assert(connection:get_autocommit() and
                scalar_integer(connection, "SELECT value FROM item") == 4,
                "enabling autocommit rolled back instead of committing")
  end)
end

function test_explicit_savepoints_use_sqlites_transaction_state(
    context: test.Context)
  runtime_test.run(function ()
    local connection = sqlite3.connect(":memory:")
    defer connection:close()
    execute_sql(connection, "CREATE TABLE item (value INTEGER)")
    execute_sql(connection, "SAVEPOINT outer_savepoint")
    test.assert(not connection:get_autocommit(),
                "explicit SAVEPOINT was invisible to get_autocommit")
    execute_sql(connection, "INSERT INTO item VALUES (1)")
    execute_sql(connection, "SAVEPOINT inner_savepoint")
    execute_sql(connection, "INSERT INTO item VALUES (2)")
    execute_sql(connection, "ROLLBACK TO inner_savepoint")
    execute_sql(connection, "RELEASE inner_savepoint")
    execute_sql(connection, "RELEASE outer_savepoint")
    test.assert(connection:get_autocommit() and
                scalar_integer(connection, "SELECT count(*) FROM item") == 1,
                "SAVEPOINT rollback or RELEASE state was inferred incorrectly")
  end)
end

function test_constraint_rollback_is_observed_as_native_autocommit(
    context: test.Context)
  runtime_test.run(function ()
    local connection = sqlite3.connect(":memory:")
    defer connection:close()
    execute_sql(connection, "CREATE TABLE item (id INTEGER PRIMARY KEY)")
    connection:set_autocommit(false)
    execute_sql(connection, "INSERT INTO item VALUES (1)")
    local statement = connection:prepare(
        "INSERT OR ROLLBACK INTO item VALUES (1)")
    defer statement:close()
    expect_native_error(function () statement:execute() end, 19)
    test.assert(connection:get_autocommit() and
                scalar_integer(connection, "SELECT count(*) FROM item") == 0,
                "automatic constraint rollback left a stale transaction flag")
  end)
end

function test_failed_commit_preserves_active_transaction_and_native_busy_code(
    context: test.Context)
  runtime_test.run(function ()
    local path = fs.tmpname()
    defer fs.unlink(path)
    local writer = sqlite3.connect(path)
    defer writer:close()
    execute_sql(writer, "CREATE TABLE item (value INTEGER)")
    execute_sql(writer, "INSERT INTO item VALUES (1)")
    local reader = sqlite3.connect(path)
    defer reader:close()
    local statement = reader:prepare("SELECT value FROM item")
    defer statement:close()
    local cursor = statement:query()
    defer cursor:close()
    assert_integer_cell(required_row(cursor), 1, 1)
    -- The reader keeps a real SHARED lock after its first step. A writer can
    -- acquire RESERVED and modify, but COMMIT cannot become EXCLUSIVE yet.
    writer:set_autocommit(false)
    execute_sql(writer, "INSERT INTO item VALUES (2)")
    local failure = expect_native_error(function () writer:commit() end, 5)
    test.assert(failure.operation == "commit",
                "contended COMMIT reported the wrong operation")
    test.assert(not writer:get_autocommit(),
                "failed COMMIT pretended the transaction had ended")
    cursor:close()
    writer:commit()
    test.assert(writer:get_autocommit() and
                scalar_integer(writer, "SELECT count(*) FROM item") == 2,
                "explicit retry after releasing the reader did not commit")
  end)
end
