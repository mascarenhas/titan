-- Native-only Connection transfer cases: a cross-state async.Receiver
-- delivery and a child state that runs SQLite in its own Task on a
-- background worker (Lua:run_async). Neither exists on the browser.

function test_connection_transfer_rejected_delivery_can_be_recovered(_: test.Context)
  runtime_test.run(function ()
    const source = sqlite3.connect(":memory:")
    defer source:close()
    execute_sql(source, "CREATE TABLE item (value INTEGER)")
    execute_sql(source, "INSERT INTO item VALUES (17)")
    const packet = async.TransferValue.from_value(source)
    const inbox = async.receiver()
    defer inbox:close()
    inbox:close()
    local rejected = false
    do
      async.send(inbox:handle(), packet)
    catch
      test.assert(error == "receiver is closed")
      rejected = true
    end
    const recovered: sqlite3.Connection = packet:to_value()
    defer recovered:close()
    test.assert(rejected and scalar_integer(recovered, "SELECT value FROM item") == 17,
                "failed delivery lost the caller-owned native connection")
  end)
end

function test_connection_transfer_crosses_states_and_survives_source_shutdown(
    _: test.Context)
  runtime_test.run(function ()
    const source = sqlite3.connect(":memory:")
    defer source:close()
    execute_sql(source, "CREATE TABLE item (value INTEGER)")
    execute_sql(source, "INSERT INTO item VALUES (19)")
    source:set_autocommit(false)
    execute_sql(source, "SAVEPOINT handoff")
    const state = transfer_lua.new()
    defer state:close()
    const operation = function (): async.TransferValue
      defer source:close()
      test.assert(not source:get_autocommit())
      test.assert(scalar_integer(source, "SELECT value FROM item") == 19)
      execute_sql(source, "INSERT INTO item VALUES (23)")
      return async.TransferValue.from_value(source)
    end
    const packet: async.TransferValue = state:run_async([[
      local operation = ...
      local async = require('titan.async')
      local task = async.run(operation)
      async.loop()
      local success, result = task:status():has_succeeded()
      if not success then
        local failed, failure = task:status():has_failed()
        if failed then failure:raise() end
        error('SQLite transfer worker did not succeed')
      end
      return result
    ]], "=sqlite-connection-transfer", async.TransferValue.from_value(operation))
    source:close()
    state:close()
    transfer_gc.collect()
    transfer_gc.collect()
    const target: sqlite3.Connection = packet:to_value()
    defer target:close()
    test.assert(not target:get_autocommit() and
                scalar_integer(target, "SELECT count(*) FROM item") == 2)
    execute_sql(target, "ROLLBACK TO handoff")
    execute_sql(target, "RELEASE handoff")
    target:commit()
    test.assert(target:get_autocommit() and
                scalar_integer(target, "SELECT value FROM item") == 19)
  end)
end
