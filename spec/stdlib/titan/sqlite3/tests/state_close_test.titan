-- Lua-state close on every target: a Connection that an independent state
-- adopted is retired when that state closes. A browser child state cannot run
-- Tasks, so the child only adopts; the transfer hooks are synchronous.
local sqlite_close_lua = import "lua"

local function sqlite_close_database(): string
  const path = fs.tmpname()
  const setup = sqlite3.connect(path)
  defer setup:close()
  execute_sql(setup, "CREATE TABLE item (value INTEGER)")
  execute_sql(setup, "INSERT INTO item VALUES (1)")
  return path
end

local function sqlite_close_remove(path: string)
  remove_if_present(path .. "-journal")
  remove_if_present(path)
end

-- While the abandoned Connection lives, its write lock excludes other writers.
local function sqlite_close_assert_locked(path: string)
  const contender = sqlite3.connect(path)
  defer contender:close()
  expect_native_error(function () execute_sql(contender, "BEGIN EXCLUSIVE") end, 5)
end

-- After the abandoned Connection is gone, no lock survives and its
-- uncommitted row was rolled back.
local function sqlite_close_assert_released(path: string)
  const db = sqlite3.connect(path)
  defer db:close()
  execute_sql(db, "BEGIN EXCLUSIVE")
  test.assert(scalar_integer(db, "SELECT count(*) FROM item") == 1,
              "Lua state close kept the abandoned connection's uncommitted row")
  db:rollback()
end

-- The child keeps the adopted Connection, with its write transaction, reachable
-- until the state closes; the close must release it.
function test_lua_close_releases_adopted_sqlite_connection(_: test.Context)
  runtime_test.run(function ()
    const path = sqlite_close_database()
    defer sqlite_close_remove(path)
    const source = sqlite3.connect(path)
    defer source:close()
    execute_sql(source, "BEGIN IMMEDIATE")
    execute_sql(source, "INSERT INTO item VALUES (2)")
    const state = sqlite_close_lua.new()
    defer state:close()
    state:run([[
      sqlite_adopted_connection = ...
      assert(sqlite_adopted_connection ~= nil, 'the child did not adopt the connection')
    ]], "=sqlite-state-close-adopted", async.TransferValue.from_value(source))
    const detached = expect_wrapper_error(function () source:get_autocommit() end)
    test.assert(detached.message == "connection is closed",
                "the adopted Connection's source alias stayed open")
    sqlite_close_assert_locked(path)
    state:close()
    sqlite_close_assert_released(path)
  end)
end
