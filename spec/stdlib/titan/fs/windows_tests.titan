-- Focused public filesystem behavior for a runner-owned local NTFS workspace.
local test = import "titan.test"
local fs = import "titan.fs"
local system = import "titan.os"
local strings = import "titan.string"
local async = import "titan.async"
local timer = import "titan.timer"
local runtime_test = import "support.runtime.titan"
local task_support = import "support.async.titan"

local function workspace(name: string): string
  local root? = system.getenv("TITAN_WINDOWS_TEST_ROOT")
  test.assert(root ~= nil and #root > 0,
              "runner must supply its owned TITAN_WINDOWS_TEST_ROOT")
  test.assert(fs.stat(root).kind == "directory",
              "filesystem test root is not a directory")
  local path = root .. "/" .. name
  fs.mkdir(path)
  runtime_test.cleanup(function () fs.rmdir(path) end)
  return path
end

local function cleanup_file(path: string)
  runtime_test.cleanup(function ()
    if fs.stat(path) ~= nil then fs.unlink(path) end
  end)
end

local function cleanup_watcher(watcher: fs.Watcher)
  runtime_test.cleanup(function () watcher:clear() end)
end

local function expect_event(watcher: fs.Watcher, path: string,
                            watch_root: string?, deleted: boolean,
                            mutate: function (): ())
  local observing = async.run<|boolean, value|>(function (): boolean
    while true do
      local events = watcher:poll()
      for index = 1, #events do
        local actual = ""
        local matches = false
        case events[index]
        when created(found) then
          actual = found
          matches = not deleted
        when modified(found) then
          actual = found
          matches = not deleted
        when deleted(found) then
          actual = found
          matches = deleted
        when error(failure) then
          raise failure
        end
        test.assert(actual == path or actual == watch_root,
                    "watcher returned a noncanonical or unexpected path: " .. actual)
        if actual == path and matches then return true end
      end
    end
  end)
  task_support.cleanup_task(observing, "filesystem observation cleanup")
  local deadline = async.run<|nil, value|>(function (): nil
    timer.sleep(5000)
    return nil
  end)
  task_support.cleanup_task(deadline, "filesystem deadline cleanup")

  mutate()
  case async.race_two(observing, deadline)
  when first(status) then
    case status
    when succeeded(found) then
      test.assert(found, "watcher completed without the expected event")
    when failed(failure) then
      raise failure.error
    else
      raise "watcher observation did not succeed"
    end
  when second() then
    raise "local filesystem watcher did not report the change within 5 seconds"
  end
  task_support.cancel_and_join_task(deadline, "filesystem event received")
end

function test_binary_stream_delimiter_and_close(context: test.Context)
  runtime_test.run(function ()
    local root = workspace("fs-bytes")
    local path = root .. "/binary.dat"
    cleanup_file(path)
    local prefix = strings.rep("x", 65535)
    local suffix = "tail\r\n\255"
    local payload = prefix .. "\0Y" .. suffix
    fs.write_file(path, payload)
    test.assert(fs.read_file(path) == payload,
                "whole-file I/O changed binary bytes or line endings")

    local file = fs.open(path, "rb")
    defer file:close()
    test.assert(file:read_until("\0Y", true) == prefix,
                "delimiter spanning native reads changed its prefix")
    test.assert(file:read() == suffix and file:read() == nil,
                "stream read lost buffered bytes or EOF")
    file:close()
    file:close()
    test.assert(file:is_closed() and file:read() == nil,
                "closed File did not retain idempotent close and EOF")

    local append = fs.open(path, "ab")
    defer append:close()
    test.assert(append:write("\0end\r\n") == 6,
                "File.write did not return the complete byte count")
    append:flush()
    append:close()
    test.assert(fs.read_file(path) == payload .. "\0end\r\n",
                "append or flush changed binary contents")
  end)
end

function test_unicode_paths_metadata_and_rename(context: test.Context)
  runtime_test.run(function ()
    local root = workspace("fs paths héllo 世界")
    local original = root .. "/original héllo 世界.dat"
    local renamed = root .. "/renamed héllo 世界.dat"
    cleanup_file(original)
    cleanup_file(renamed)
    local payload = "abc\0def\r\n"
    fs.write_file(original, payload)
    local before = fs.stat(original)
    local link_info = fs.lstat(original)
    test.assert(before.kind == "file" and before.size == #payload and
                link_info.kind == "file" and link_info.size == #payload,
                "stat or lstat changed ordinary-file metadata")
    test.assert(before.modified_nanoseconds >= 0 and
                before.modified_nanoseconds < 1000000000,
                "stat returned an invalid nanosecond component")
    test.assert(before.device == link_info.device and
                before.inode == link_info.inode,
                "stat and lstat disagreed on the same physical file")
    test.assert(fs.realpath(root .. "/./original héllo 世界.dat") ==
                fs.realpath(original),
                "equivalent Unicode paths did not canonicalize together")

    fs.rename(original, renamed)
    test.assert(fs.stat(original) == nil and fs.lstat(original) == nil,
                "rename left the old path present")
    local after = fs.stat(renamed)
    test.assert(after.kind == "file" and after.size == #payload and
                after.device == before.device and after.inode == before.inode,
                "same-directory rename changed file identity or metadata")
    test.assert(fs.read_file(renamed) == payload,
                "rename lost binary file contents")
    local entries = fs.list(root)
    test.assert(#entries == 1 and entries[1] == "renamed héllo 世界.dat",
                "directory listing lost the exact Unicode basename")
    test.assert(fs.stat(root .. "/missing") == nil,
                "missing file did not return nil")
  end)
end

function test_local_file_watcher_change_and_retirement(context: test.Context)
  runtime_test.run(function ()
    local root = workspace("fs-watch-file")
    local path = root .. "/watched héllo 世界.dat"
    cleanup_file(path)
    fs.write_file(path, "before")
    local canonical = fs.realpath(path)
    local watcher = fs.watcher()
    cleanup_watcher(watcher)
    test.assert(#watcher:poll() == 0,
                "unregistered watcher did not return an empty batch")
    watcher:watch(path)
    watcher:watch(root .. "/./watched héllo 世界.dat")
    test.assert(watcher:is_watching(canonical),
                "file watcher did not retain its canonical registration")
    -- Match the existing portable subscription boundary (FSEvents is deferred).
    timer.sleep(100)
    expect_event(watcher, canonical, nil, false, function ()
      fs.write_file(path, "after\0change")
    end)
    expect_event(watcher, canonical, nil, true, function () fs.unlink(path) end)
    test.assert(not watcher:is_watching(path) and #watcher:poll() == 0,
                "deleted file watch did not retire its registration")
    watcher:clear()
    watcher:clear()
  end)
end

function test_local_directory_watcher_canonical_child(context: test.Context)
  runtime_test.run(function ()
    local root = workspace("fs-watch-directory héllo 世界")
    local path = root .. "/child héllo 世界.dat"
    cleanup_file(path)
    -- Preexist so the expected payload is obtained from the public realpath API.
    fs.write_file(path, "before")
    local canonical_root = fs.realpath(root)
    local canonical_child = fs.realpath(path)
    local watcher = fs.watcher()
    cleanup_watcher(watcher)
    watcher:watch(root)
    timer.sleep(100)
    expect_event(watcher, canonical_child, canonical_root, false, function ()
      fs.write_file(path, "after")
    end)
    watcher:stop(root .. "/.")
    test.assert(not watcher:is_watching(root),
                "stopping an equivalent directory path retained its watch")
    watcher:clear()
    watcher:poll()
    test.assert(#watcher:poll() == 0,
                "stopped directory watcher did not become empty")
  end)
end
