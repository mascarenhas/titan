-- Filesystem fixture ownership for fs.tests.
local test = import "test"
local fs = import "fs"
local uv = import "uv"
local strings = import "string"
local system = import "os"
local common = import "support.common.titan"
foreign import "stdlib.h"
foreign import "string.h"
foreign import "fixture_support.h"

local function remove_native(path: string)
  test.assert(ffi.titan_spec_remove_if_present(path) == 0,
              "could not remove native fixture path")
end

local function cleanup_path(context: test.Context, path: string)
  context:cleanup(function ()
    remove_native(path)
  end)
end

local function new_workspace(context: test.Context): string
  const parent = system.getenv("TITAN_TEST_ROOT") or fs.tmpdir()
  const pattern = parent .. "/titan-fs-ação世界-XXXXXX"
  const storage = foreign char.new_array(#pattern + 1)
  ffi.memcpy(storage as foreign *char,
                 pattern as foreign const *char,
                 #pattern as foreign size_t)
  storage[#pattern] = 0
  const status = ffi.titan_spec_mkdtemp(storage as foreign *char)
  test.assert(status == 0, "could not create native workspace")
  const root = (storage as foreign *char) as string
  cleanup_path(context, root)
  return root
end

local function make_symlink(context: test.Context,
                            target: string, link: string)
  cleanup_path(context, link)
  const info? = fs.stat(target)
  const directory = info ~= nil and info.kind == "directory"
  const status: integer = ffi.titan_spec_symlink(target, link, directory and 1 or 0)
  if common.is_windows() and status == 1 then
    test.skip("capability: symbolic links require Windows Developer Mode or symlink privilege")
  end
  if common.is_windows() and status == 2 then
    test.skip("capability: this Windows build does not traverse symbolic links " ..
              "created by this account (ERROR_UNTRUSTED_MOUNT_POINT)")
  end
  test.assert(status == 0, "could not create native symlink fixture")
end

local function set_fixture_environment(context: test.Context,
                                       name: string, contents: string)
  const old_value? = system.getenv(name)
  context:cleanup(function ()
    if old_value then
      system.setenv(name, old_value)
    else
      system.unsetenv(name)
    end
  end)
  system.setenv(name, contents)
end

local function write_file_synchronously(path: string, contents: string)
  const status = ffi.titan_spec_write_file(
      path, contents, #contents as foreign size_t)
  test.assert(status == 0, "could not write native fixture file")
end

local function make_boundary_payload(): string
  const prefix_length = 65535
  const length = prefix_length + 6
  const storage = foreign char.new_array(length)
  ffi.memset(storage as foreign *char, 120,
                 prefix_length as foreign size_t)
  storage[prefix_length] = 0
  storage[prefix_length + 1] = 89
  storage[prefix_length + 2] = 116
  storage[prefix_length + 3] = 97
  storage[prefix_length + 4] = 105
  storage[prefix_length + 5] = 108
  return (storage as string) .. "\r\n\255"
end

local function require_descriptor_inventory()
  const directory? = fs.stat("/dev/fd")
  if not directory or directory.kind ~= "directory" then
    test.skip("capability: process descriptor inventory at /dev/fd is unavailable")
  end
end

local function file_descriptor(path: string): integer
  const wanted = fs.stat(path)
  -- Linux and Darwin both expose /dev/fd. Match physical file identity through
  -- public fstat results rather than relying on platform-specific link text.
  const entries = fs.list("/dev/fd")
  for index = 1, #entries do
    const name = entries[index]
    local descriptor = 0
    for digit = 1, #name do
      const byte = strings.byte(name, digit)
      test.assert(byte >= 48 and byte <= 57,
                  "descriptor inventory contains a nonnumeric entry")
      descriptor = descriptor * 10 + byte - 48
    end
    const request = uv.fs_t()
    defer uv.fs_req_cleanup(request)
    if uv.fs_fstat(nil, request, descriptor) >= 0 then
      const found = uv.fs_get_statbuf(request)
      if found.st_dev == wanted.device and found.st_ino == wanted.inode then
        return descriptor
      end
    end
  end
  return -1
end

local function close_descriptor(descriptor: integer)
  const request = uv.fs_t()
  defer uv.fs_req_cleanup(request)
  test.assert(uv.fs_close(nil, request, descriptor) == 0,
              "could not close the native fixture descriptor")
end
