local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local fs = import "fs"
local stream = import "io"
local timer = import "timer"
local support = import "fs.test_support.titan"
local task_support = import "support.async.titan"

local function contains_entry(entries: {string}, wanted: string): boolean
  for index = 1, #entries do
    if entries[index] == wanted then return true end
  end
  return false
end

local function expect_failure(action: () -> (), message: string)
  local failed = false
  do
    action()
  catch
    failed = true
  end
  test.assert(failed, message)
end

local function watcher_event_matches(event: fs.WatcherEvent,
                                      kind: string,
                                      path: string,
                                      forbidden: string?): boolean
  local actual = ""
  local matches = false
  case event
  when created: found then
    actual = found
    matches = kind == "created" and found == path
  when deleted: found then
    actual = found
    matches = kind == "deleted" and found == path
  when modified: found then
    actual = found
    matches = kind == "modified" and found == path
  when error: failure then raise failure
  end
  test.assert(forbidden == nil or actual ~= forbidden,
              "watcher reported an out-of-scope path")
  return matches
end

local function wait_for_watcher_event(watcher: fs.Watcher,
                                      kind: string,
                                      path: string,
                                      forbidden: string?)
  while true do
    local events = watcher:poll()
    for index = 1, #events do
      if watcher_event_matches(events[index], kind, path, forbidden) then
        return
      end
    end
  end
end

local function cleanup_watcher(watcher: fs.Watcher)
  runtime_test.cleanup(function ()
    watcher:clear()
    watcher:poll()
  end)
end

local function wait_for_watcher_subscription()
  -- Darwin creates its FSEvents stream on a separate CF thread after
  -- uv_fs_event_start returns. Match libuv's own portable test boundary before
  -- performing the mutation whose notification a case is meant to observe.
  timer.sleep(100)
end

function test_fs_binary_delimiters_and_close(context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local binary_path = root .. "/binary.dat"
    support.cleanup_path(context, binary_path)
    local boundary = support.make_boundary_payload()

    fs.write_file(binary_path, boundary)
    test.assert(fs.read_file(binary_path) == boundary,
                "whole-file helpers changed binary data")

    local file = fs.open(binary_path, "rb")
    defer file:close()
    expect_failure(function ()
      file:read_until("")
    end, "File accepted an empty delimiter")
    local selected: string? = file:read_until("\0Y", true)
    test.assert(selected ~= nil and #selected == 65535,
                "delimiter spanning native reads returned the wrong prefix")
    test.assert(file:read() == "tail",
                "delimiter read lost retained excess")
    test.assert(not file:read(1) and not file:read_until("missing"),
                "repeated File reads did not return EOF")

    file:close()
    file:close()
    test.assert(file:is_closed(), "File close was not idempotent")
    test.assert(not file:read() and not file:read_until("missing"),
                "closed File did not behave as Reader EOF")
    expect_failure(function ()
      file:write("late")
    end, "closed File accepted a write")
    expect_failure(function ()
      file:write("")
    end, "closed File accepted an empty write")
    expect_failure(function ()
      file:flush()
    end, "closed File accepted a flush")

    fs.unlink(binary_path)
  end)
end

function test_fs_modes_interfaces_and_validation(context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local modes_path = root .. "/modes.dat"
    support.cleanup_path(context, modes_path)

    do
      local file = fs.open(modes_path, "w")
      defer file:close()
      test.assert(file:write("abc") == 3,
                  "write returned the wrong length")
      file:flush()
    end
    do
      local file = fs.open(modes_path, "a")
      defer file:close()
      test.assert(file:write("d") == 1,
                  "append returned the wrong length")
    end
    test.assert(fs.read_file(modes_path) == "abcd",
                "append changed file data")

    do
      local file = fs.open(modes_path, "r+")
      defer file:close()
      test.assert(file:read(2) == "ab",
                  "read/update mode returned wrong bytes")
      test.assert(file:write("XY") == 2,
                  "read/update write failed")
      file:flush()
    end
    test.assert(fs.read_file(modes_path) == "abXY",
                "read/update mode used the wrong file position")

    local valid_modes = {
      "r", "rb", "r+", "r+b", "rb+", "a", "ab", "a+", "a+b", "ab+"
    }
    for index = 1, #valid_modes do
      local opened = fs.open(modes_path, valid_modes[index])
      opened:close()
    end
    local truncating_modes = {"w", "wb", "w+", "w+b", "wb+"}
    for index = 1, #truncating_modes do
      local opened = fs.open(modes_path, truncating_modes[index])
      opened:close()
    end

    local invalid_modes = {"", "x", "rr", "br", "r++"}
    for index = 1, #invalid_modes do
      local mode = invalid_modes[index]
      expect_failure(function ()
        fs.open(modes_path, mode)
      end, "invalid mode was accepted: " .. mode)
    end
    expect_failure(function ()
      fs.open(root .. "/bad\0path", "r")
    end, "embedded-NUL path was accepted")

    do
      local file = fs.open(modes_path, "r")
      defer file:close()
      expect_failure(function ()
        file:read(0)
      end, "zero-sized read was accepted")
    end

    local interface_path = root .. "/interface.dat"
    support.cleanup_path(context, interface_path)
    fs.write_file(interface_path, "line\nrest")
    do
      local file = fs.open(interface_path, "r+")
      defer file:close()
      local concrete: stream.ReaderWriterCloser = file
      test.assert(concrete:read_until("\n", true) == "line",
                  "ReaderWriterCloser delimiter dispatch failed")
      concrete:write("X")
      test.assert(concrete:read() == "rest",
                  "ReaderWriterCloser retained read failed")
      concrete:close()
    end
    test.assert(fs.read_file(interface_path) == "line\nrestX",
                "ReaderWriterCloser write changed position")

    fs.unlink(modes_path)
    fs.unlink(interface_path)
  end)
end

function test_fs_paths_metadata_locations_and_errors(context: test.Context)
  runtime_test.run(function ()
    local actual_root = support.new_workspace(context)
    local root = actual_root .. "-alias"
    support.make_symlink(context, actual_root, root)
    support.set_fixture_environment(context, "HOME", root)
    support.set_fixture_environment(context, "TMPDIR", root)

    local canonical_root = fs.realpath(actual_root)
    test.assert(fs.realpath(root .. "/.") == canonical_root,
                "realpath did not resolve a symlink and dot component")
    local realpath_missing = false
    do
      fs.realpath(root .. "/missing-realpath")
    catch
      local failure = error as async.OperationError
      test.assert(failure.operation == "fs.realpath",
                  "missing realpath reported the wrong operation")
      realpath_missing = true
    end
    test.assert(realpath_missing, "realpath accepted a missing path")
    expect_failure(function ()
      fs.realpath(root .. "/bad\0path")
    end, "realpath accepted an embedded-NUL path")

    local target = root .. "/target.dat"
    local link = root .. "/target-link"
    support.cleanup_path(context, target)
    fs.write_file(target, "target")
    support.make_symlink(context, target, link)

    local tree = root .. "/tree"
    local sub = tree .. "/sub"
    local first = tree .. "/first.dat"
    local renamed = tree .. "/renamed.dat"
    local cwd = root .. "/cwd"
    local marker = cwd .. "/marker"
    support.cleanup_path(context, tree)
    support.cleanup_path(context, sub)
    support.cleanup_path(context, first)
    support.cleanup_path(context, renamed)
    support.cleanup_path(context, cwd)
    support.cleanup_path(context, marker)

    fs.mkdir(tree)
    fs.mkdir(sub)
    fs.mkdir(cwd)
    fs.write_file(marker, "cwd")
    fs.write_file(first, "abc\0def")

    local info = fs.stat(first)
    test.assert(info.kind == "file" and info.size == 7,
                "stat returned wrong regular-file metadata")
    test.assert(info.mode >= 0 and info.modified_nanoseconds >= 0 and
                info.modified_nanoseconds < 1000000000,
                "stat returned invalid portable metadata")
    test.assert(fs.stat(sub).kind == "directory",
                "stat did not classify a directory")
    test.assert(fs.stat(link).kind == "file",
                "stat did not follow a symbolic link")
    local target_info = fs.stat(target)
    local link_info = fs.stat(link)
    test.assert(link_info.device == target_info.device and
                link_info.inode == target_info.inode,
                "stat did not preserve physical identity through a symlink")
    test.assert(fs.lstat(link).kind == "symlink",
                "lstat did not classify the symbolic link")

    local entries = fs.list(tree)
    test.assert(#entries == 2 and contains_entry(entries, "first.dat") and
                contains_entry(entries, "sub"),
                "list returned wrong entries")
    test.assert(not contains_entry(entries, ".") and
                not contains_entry(entries, ".."),
                "list exposed dot entries")

    fs.rename(first, renamed)
    test.assert(fs.read_file(renamed) == "abc\0def",
                "rename lost file data")
    expect_failure(function ()
      fs.rmdir(tree)
    end, "rmdir removed a nonempty directory")
    expect_failure(function ()
      fs.unlink(sub)
    end, "unlink removed a directory")

    local missing = root .. "/missing"
    test.assert(fs.stat(missing) == nil and fs.lstat(missing) == nil,
                "missing metadata did not return nil")
    test.assert(fs.stat(missing .. "/child") == nil and
                fs.lstat(missing .. "/child") == nil,
                "missing metadata parent did not return nil")

    local dangling = root .. "/dangling-link"
    support.make_symlink(context, missing, dangling)
    test.assert(fs.stat(dangling) == nil,
                "stat did not treat a dangling symlink as missing")
    local dangling_info? = fs.lstat(dangling)
    test.assert(dangling_info ~= nil and
                dangling_info.kind == "symlink",
                "lstat did not preserve a dangling symlink")

    local expect_metadata_error: (() -> (), string) -> () =
      function (action: () -> (), operation: string)
        local failed = false
        do
          action()
        catch
          local failure = error as async.OperationError
          test.assert(failure.operation == operation,
                      "metadata failure reported the wrong operation")
          failed = true
        end
        test.assert(failed, "metadata swallowed a non-ENOENT failure")
      end
    expect_metadata_error(function ()
      fs.stat(target .. "/child")
    end, "fs.stat")
    expect_metadata_error(function ()
      fs.lstat(target .. "/child")
    end, "fs.lstat")
    expect_failure(function ()
      fs.list(missing)
    end, "list accepted a missing path")

    test.assert(fs.tmpdir() == root and fs.homedir() == root,
                "portable directory helpers returned wrong paths")
    local temporary = fs.tmpname()
    support.cleanup_path(context, temporary)
    test.assert(fs.lstat(temporary).kind == "file",
                "tmpname did not leave a closed regular file")
    fs.unlink(temporary)

    local original = fs.pwd()
    do
      defer fs.chdir(original)
      fs.chdir(cwd)
      local changed = fs.pwd()
      test.assert(changed ~= original and fs.read_file("marker") == "cwd",
                  "chdir did not select the requested directory")
      test.assert(fs.read_file(changed .. "/marker") == "cwd",
                  "pwd did not identify the current directory")
    end
    test.assert(fs.pwd() == original, "chdir did not restore pwd")

    fs.unlink(link)
    fs.unlink(target)
    fs.unlink(renamed)
    fs.unlink(marker)
    fs.rmdir(sub)
    fs.rmdir(tree)
    fs.rmdir(cwd)
  end)
end

function test_fs_independent_continuations(context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local first_path = root .. "/parallel-first.dat"
    local second_path = root .. "/parallel-second.dat"
    support.cleanup_path(context, first_path)
    support.cleanup_path(context, second_path)

    local first_realpath: string? = nil
    local second_realpath: string? = nil
    local first = async.run<value, value>(function (): value
      fs.write_file(first_path, "first")
      first_realpath = fs.realpath(first_path)
      return nil
    end)
    task_support.cleanup_task(first, "first filesystem Task cleanup")
    local second = async.run<value, value>(function (): value
      fs.write_file(second_path, "second")
      second_realpath = fs.realpath(second_path)
      return nil
    end)
    task_support.cleanup_task(second, "second filesystem Task cleanup")

    while not first:status():has_finished() or
          not second:status():has_finished() do
      timer.yield()
    end
    test.assert(first:status():as_string() == "succeeded" and
                second:status():as_string() == "succeeded",
                "independent filesystem Tasks did not succeed")
    test.assert(fs.read_file(first_path) == "first" and
                fs.read_file(second_path) == "second" and
                first_realpath == fs.realpath(first_path) and
                second_realpath == fs.realpath(second_path),
                "independent filesystem results changed")

    local cancellation_started = false
    local cancelled_realpath: string? = nil
    local cancelled = async.run<value, value>(function (): value
      local held = fs.open(first_path, "r")
      defer held:close()
      cancellation_started = true
      cancelled_realpath = fs.realpath(first_path)
      return nil
    end)
    task_support.cleanup_task(cancelled,
                              "cancelled realpath Task cleanup")
    while not cancellation_started do timer.yield() end

    local realpath_resume_error = ""
    do
      cancelled:resume(async.ResumeToken.new("realpath outsider"))
    catch
      realpath_resume_error = error as string
    end
    test.assert(realpath_resume_error ==
                "Task resume token mismatch (expected source: fs.realpath)" and
                cancelled:status():as_string() == "waiting" and
                cancelled_realpath == nil,
                "an unrelated token changed the one-shot realpath wait")

    cancelled:cancel(async.CancellationReason.simple(
        "cancel pending realpath"))
    async.join(cancelled)
    test.assert(cancelled:status():has_cancelled() and
                cancelled_realpath == nil,
                "realpath delivered a result after Task cancellation")
    timer.yield()
    test.assert(fs.realpath(first_path) == first_realpath,
                "realpath cancellation damaged later requests")

    fs.unlink(first_path)
    fs.unlink(second_path)
  end)
end

function test_fs_condition_waiter_tokens_and_callback_progress(
    context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local watcher_path = root .. "/watcher.dat"
    support.cleanup_path(context, watcher_path)
    -- Use a direct-file watch for this suspension protocol oracle. Darwin
    -- routes it through kqueue, avoiding FSEvents startup notifications that
    -- can otherwise wake the poll before the stale-token assertion.
    support.write_file_synchronously(watcher_path, "")
    local canonical = fs.realpath(watcher_path)
    local watcher = fs.watcher()
    cleanup_watcher(watcher)
    watcher:watch(watcher_path)
    wait_for_watcher_subscription()

    local watcher_phase = 0
    local watcher_events: {fs.WatcherEvent}? = nil
    local gate_token = async.ResumeToken.new("filesystem test gate")
    local watcher_task = async.run<value, value>(function (): value
      watcher_phase = 1
      async.suspend(gate_token)
      watcher_phase = 2
      watcher_events = watcher:poll()
      return nil
    end)
    task_support.cleanup_task(
        watcher_task, "token-guarded watcher Task cleanup")
    while watcher_phase == 0 do timer.yield() end
    watcher_task:resume(gate_token)
    while watcher_phase < 2 do timer.yield() end
    test.assert(watcher_events == nil,
                "watcher poll did not remain pending for the race")

    local stale_error = ""
    do
      watcher_task:resume(gate_token)
    catch
      stale_error = error as string
    end
    test.assert(stale_error ==
                "Task resume token mismatch (expected source: fs.watcher)" and
                watcher_task:status():as_string() == "waiting",
                "stale gate token changed the watcher poll")

    support.write_file_synchronously(watcher_path, "watcher")
    async.join(watcher_task)
    test.assert(watcher_task:status():has_succeeded() and
                watcher_events ~= nil,
                "watcher callback did not complete token-guarded poll")

    local found = false
    local events = watcher_events as {fs.WatcherEvent}
    for index = 1, #events do
      if watcher_event_matches(events[index], "modified", canonical, nil) then
        found = true
      end
    end
    test.assert(found, "watcher callback lost its event")
    fs.unlink(watcher_path)
  end)
end

function test_fs_watcher_directory_events_and_canonical_paths(context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local modify_path = root .. "/modify.dat"
    local delete_path = root .. "/delete.dat"
    local create_path = root .. "/create.dat"
    local nested_dir = root .. "/nested"
    local nested_path = nested_dir .. "/nested.dat"
    local sentinel_path = root .. "/sentinel.dat"
    support.cleanup_path(context, modify_path)
    support.cleanup_path(context, delete_path)
    support.cleanup_path(context, create_path)
    support.cleanup_path(context, nested_dir)
    support.cleanup_path(context, nested_path)
    support.cleanup_path(context, sentinel_path)
    fs.write_file(modify_path, "before")
    fs.write_file(delete_path, "delete")
    fs.mkdir(nested_dir)
    fs.write_file(nested_path, "nested-before")

    local canonical_root = fs.realpath(root)
    local canonical_modify = fs.realpath(modify_path)
    local canonical_delete = fs.realpath(delete_path)
    local canonical_nested = fs.realpath(nested_path)
    local watcher = fs.watcher()
    cleanup_watcher(watcher)
    test.assert(#watcher:poll() == 0,
                "empty watcher poll did not return immediately")

    watcher:watch(root)
    watcher:watch(root .. "/.")
    wait_for_watcher_subscription()
    test.assert(watcher:is_watching(root) and
                watcher:is_watching(root .. "/."),
                "watcher did not recognize an equivalent canonical path")

    fs.write_file(modify_path, "after")
    wait_for_watcher_event(
        watcher, "modified", canonical_modify, canonical_nested)

    fs.write_file(create_path, "created")
    local canonical_create = fs.realpath(create_path)
    wait_for_watcher_event(
        watcher, "created", canonical_create, canonical_nested)

    fs.unlink(delete_path)
    wait_for_watcher_event(
        watcher, "deleted", canonical_delete, canonical_nested)

    fs.write_file(nested_path, "nested-after")
    -- Darwin's FSEvents can coalesce back-to-back mutations. Match libuv's
    -- portable test boundary so the out-of-scope nested event and the
    -- in-scope sentinel event are delivered in separate batches.
    timer.sleep(100)
    fs.write_file(sentinel_path, "sentinel")
    local canonical_sentinel = fs.realpath(sentinel_path)
    wait_for_watcher_event(
        watcher, "created", canonical_sentinel, canonical_nested)

    watcher:stop(root .. "/.")
    test.assert(not watcher:is_watching(root),
                "stopping an equivalent path left its canonical watch active")
    watcher:stop(root)
    watcher:clear()
    watcher:clear()
    watcher:poll()
    test.assert(#watcher:poll() == 0,
                "stopped watcher did not become empty")

    watcher:watch(root)
    test.assert(watcher:is_watching(canonical_root),
                "watcher could not rewatch a stopped path")
    watcher:clear()

    local removed_directory = root .. "/removed-directory"
    support.cleanup_path(context, removed_directory)
    fs.mkdir(removed_directory)
    local canonical_removed = fs.realpath(removed_directory)
    watcher:watch(removed_directory)
    wait_for_watcher_subscription()
    fs.rmdir(removed_directory)
    wait_for_watcher_event(
        watcher, "deleted", canonical_removed, canonical_nested)
    test.assert(not watcher:is_watching(removed_directory) and
                #watcher:poll() == 0,
                "deleted directory watch did not retire its registration")

    fs.unlink(modify_path)
    fs.unlink(create_path)
    fs.unlink(nested_path)
    fs.unlink(sentinel_path)
    fs.rmdir(nested_dir)
  end)
end

function test_fs_watcher_file_scope(context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local watched_path = root .. "/watched.dat"
    local sibling_path = root .. "/watched.dat.other"
    support.cleanup_path(context, watched_path)
    support.cleanup_path(context, sibling_path)
    fs.write_file(watched_path, "before")
    fs.write_file(sibling_path, "sibling-before")

    local canonical_watched = fs.realpath(watched_path)
    local canonical_sibling = fs.realpath(sibling_path)
    local watcher = fs.watcher()
    cleanup_watcher(watcher)
    watcher:watch(watched_path)
    wait_for_watcher_subscription()

    fs.write_file(sibling_path, "sibling-after")
    fs.write_file(watched_path, "after")
    wait_for_watcher_event(
        watcher, "modified", canonical_watched, canonical_sibling)

    fs.unlink(watched_path)
    wait_for_watcher_event(
        watcher, "deleted", canonical_watched, canonical_sibling)
    test.assert(not watcher:is_watching(watched_path),
                "deleted file watch remained active")
    watcher:stop(watched_path)
    test.assert(#watcher:poll() == 0,
                "deleted file watch did not retire its registration")

    -- Linux may publish several inotify hints for one direct-file deletion.
    -- Repeat the public boundary enough times to exercise callbacks queued
    -- while poll is classifying and retiring the registration.
    for attempt = 2, 32 do
      fs.write_file(watched_path, "retirement " .. attempt)
      watcher:watch(watched_path)
      wait_for_watcher_subscription()
      fs.unlink(watched_path)
      wait_for_watcher_event(
          watcher, "deleted", canonical_watched, canonical_sibling)
      test.assert(not watcher:is_watching(watched_path),
                  "repeated deleted file watch remained active")
      test.assert(#watcher:poll() == 0,
                  "retired file watch leaked a later notification batch")
    end

    fs.write_file(watched_path, "rewatched")
    watcher:watch(watched_path)
    watcher:watch(sibling_path)
    wait_for_watcher_subscription()
    watcher:stop(watched_path)
    test.assert(not watcher:is_watching(watched_path) and
                watcher:is_watching(sibling_path),
                "stopping one file watch changed another registration")
    fs.write_file(sibling_path, "sibling-final")
    wait_for_watcher_event(
        watcher, "modified", canonical_sibling, canonical_watched)
    watcher:clear()

    fs.unlink(watched_path)
    fs.unlink(sibling_path)
  end)
end

function test_fs_watcher_poll_waiter_protocol(context: test.Context)
  runtime_test.run(function ()
    local root = support.new_workspace(context)
    local path = root .. "/wake.dat"
    support.cleanup_path(context, path)
    local watcher = fs.watcher()
    cleanup_watcher(watcher)
    watcher:watch(root)
    wait_for_watcher_subscription()

    local entered = false
    local first_result: {fs.WatcherEvent}? = nil
    local first = async.run<value, value>(function (): value
      entered = true
      first_result = watcher:poll()
      return nil
    end)
    task_support.cleanup_task(first, "filesystem watcher first poll cleanup")
    while not entered do timer.yield() end
    timer.yield()

    local resume_error = ""
    do
      first:resume(async.ResumeToken.new("filesystem poll outsider"))
    catch
      resume_error = error as string
    end
    test.assert(resume_error ==
                "Task resume token mismatch (expected source: fs.watcher)" and
                first:status():as_string() == "waiting" and
                first_result == nil and watcher:is_watching(root),
                "an unrelated token changed a blocked poll")

    expect_failure(function ()
      watcher:poll()
    end, "watcher accepted a second concurrent poll")

    first:cancel(async.CancellationReason.simple("cancel blocked poll"))
    fs.write_file(path, "wake")
    local canonical = fs.realpath(path)
    async.join(first)
    test.assert(first:status():as_string() == "cancelled" and
                first_result == nil and watcher:is_watching(root),
                "poll cancellation changed watcher ownership")

    wait_for_watcher_event(watcher, "created", canonical, nil)

    local stop_poll_entered = false
    local stopped_result: {fs.WatcherEvent}? = nil
    local stopped = async.run<value, value>(function (): value
      stop_poll_entered = true
      stopped_result = watcher:poll()
      return nil
    end)
    task_support.cleanup_task(stopped,
                              "filesystem watcher stop poll cleanup")
    while not stop_poll_entered do timer.yield() end
    timer.yield()
    watcher:stop(root)
    async.join(stopped)
    test.assert(stopped:status():has_succeeded() and
                stopped_result ~= nil and #stopped_result == 0 and
                not watcher:is_watching(root),
                "stop did not wake an empty blocked poll")
    test.assert(#watcher:poll() == 0,
                "poll after stopping the final registration was not empty")

    watcher:watch(root)
    local clear_poll_entered = false
    local cleared_result: {fs.WatcherEvent}? = nil
    local cleared = async.run<value, value>(function (): value
      clear_poll_entered = true
      cleared_result = watcher:poll()
      return nil
    end)
    task_support.cleanup_task(cleared,
                              "filesystem watcher clear poll cleanup")
    while not clear_poll_entered do timer.yield() end

    local repeated_resume_error = ""
    do
      cleared:resume(async.ResumeToken.new("repeated poll outsider"))
    catch
      repeated_resume_error = error as string
    end
    test.assert(repeated_resume_error ==
                "Task resume token mismatch (expected source: fs.watcher)" and
                cleared:status():as_string() == "waiting" and
                cleared_result == nil,
                "a repeated blocked poll did not establish its token guard")

    watcher:clear()
    async.join(cleared)
    test.assert(cleared:status():has_succeeded() and
                cleared_result ~= nil and
                #cleared_result == 0,
                "clear did not wake an empty blocked poll")

    watcher:watch(root)
    watcher:watch(path)
    local clear_entered = false
    local concurrent_clear = async.run<value, value>(function (): value
      clear_entered = true
      watcher:clear()
      return nil
    end)
    task_support.cleanup_task(concurrent_clear,
                              "filesystem watcher concurrent clear cleanup")
    while not clear_entered do timer.yield() end
    expect_failure(function ()
      watcher:poll()
    end, "watcher accepted a poll during clear")
    expect_failure(function ()
      watcher:clear()
    end, "watcher accepted a second concurrent clear")
    async.join(concurrent_clear)
    test.assert(concurrent_clear:status():has_succeeded() and
                #watcher:poll() == 0,
                "watcher did not leave clear state after completion")

    fs.unlink(path)
  end)
end

function test_fs_watcher_runtime_ownership(context: test.Context)
  local root = support.new_workspace(context)
  local stale: fs.Watcher? = nil
  runtime_test.run(function ()
    stale = fs.watcher()
    stale:watch(root)
  end)

  runtime_test.run(function ()
    expect_failure(function ()
      stale:poll()
    end, "watcher remained usable after its Runtime stopped")
  end)
end
