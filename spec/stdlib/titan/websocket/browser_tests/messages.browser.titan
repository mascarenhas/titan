function test_live_subprotocol_negotiation(_context: test.Context)
  runtime_test.run(function ()
    const connection = websocket.connect(live("echo"), websocket.DialOptions { subprotocols = {"chat", "other"} })
    defer connection:close()
    test.assert(connection:subprotocol() == "chat", "native peer did not select the offered subprotocol")
    echo(connection, websocket.TEXT, "negotiated")
    const plain = websocket.connect(live("echo"))
    defer plain:close()
    test.assert(plain:subprotocol() == nil, "unoffered protocol appeared on the connection")
  end)
end

function test_live_text_round_trips(_context: test.Context)
  runtime_test.run(function ()
    const connection = websocket.connect(live("echo"))
    defer connection:close()
    for _, data in iteration.ipairs({"", "plain ASCII", "aé€𠀀z"}) do echo(connection, websocket.TEXT, data) end
    echo(connection, websocket.MessageType.text(), "fresh-text")
  end)
end

function test_live_binary_round_trips(_context: test.Context)
  runtime_test.run(function ()
    const connection = websocket.connect(live("echo"))
    defer connection:close()
    for _, data in iteration.ipairs({"", "\0\xff", string.rep("\0\xff", 32768)}) do echo(connection, websocket.BINARY, data) end
    echo(connection, websocket.MessageType.binary(), "\0fresh")
  end)
end

function test_live_invalid_text_is_rejected_without_sending_or_retiring(_context: test.Context)
  runtime_test.run(function ()
    const source = live("echo")
    const connection = websocket.connect(source)
    defer connection:close()
    const before = metric("send", source)
    websocket_error(function () connection:write(websocket.TEXT, "\255\254") end, "utf8", "websocket.write", nil)
    test.assert(metric("send", source) == before, "invalid TEXT reached WebSocket.send")
    echo(connection, websocket.TEXT, "healthy after validation")
    test.assert(metric("send", source) == before + 1, "validation failure retired the usable connection")
  end)
end

function test_live_verified_tls_and_both_certificate_rejections(_context: test.Context)
  runtime_test.run(function ()
    if environment("TITAN_TEST_VERIFIED_TLS") == "1" then
      const connection = websocket.connect(live("echo", environment("TITAN_TEST_WSS_VALID_URL")))
      defer connection:close()
      echo(connection, websocket.TEXT, "verified certificate and hostname")
      connection:shutdown(1000, "verified")
      closed(connection, 1000, "verified")
    end
    for _, name in iteration.ipairs({"TITAN_TEST_WSS_WRONG_HOST_URL", "TITAN_TEST_WSS_UNTRUSTED_URL"}) do
      handshake_error(function () websocket.connect(live("echo", environment(name))) end)
    end
  end)
end

function test_live_browser_origin_acceptance_and_denial(_context: test.Context)
  runtime_test.run(function ()
    const connection = websocket.connect(live("origin"))
    defer connection:close()
    local kind?, origin? = connection:read()
    if not same_message_kind(kind, websocket.TEXT) or origin == nil then raise "native Origin fixture did not publish the header" end
    if environment("TITAN_TEST_BROWSER") == "1" then
      test.assert(string.sub(origin, 1, 17) == "http://127.0.0.1:", "browser Origin did not reach the native peer")
      handshake_error(function () websocket.connect(live("deny-origin")) end)
    end
  end)
end

-- Asks the burst peer for `count` numbered messages, and waits until the
-- client holds all of them unread.
local function queue_burst(connection: websocket.Connection, source: string, count: integer)
  const before = metric("holders", source)
  connection:write(websocket.TEXT, "" .. count)
  wait_for(function (): boolean return metric("holders", source) >= before + count end,
    "the burst peer's messages did not arrive")
  -- Deliveries queued before this turn reach the connection before it resumes.
  async.yield()
end

local function read_numbered(connection: websocket.Connection, first: integer, last: integer)
  for number = first, last do
    local kind?, data? = connection:read()
    test.assert(same_message_kind(kind, websocket.TEXT) and data == "message " .. number,
      "burst message " .. number .. " arrived as " .. (data or "nil"))
  end
end

-- Reading most of a queued burst moves the unread suffix into fresh storage;
-- the messages keep their order and bytes, and each holder retires with its
-- message.
function test_live_unread_suffix_survives_queue_compaction(_context: test.Context)
  runtime_test.run(function ()
    const source = live("burst")
    const connection = websocket.connect(source)
    defer connection:close()
    const holders = metric("holders", source)
    const takes = metric("takes", source)
    queue_burst(connection, source, 100)
    read_numbered(connection, 1, 60)
    test.assert(metric("holders", source) == holders + 40, "consumed holders were not released")
    read_numbered(connection, 61, 100)
    test.assert(metric("holders", source) == holders, "a holder outlived its message")
    test.assert(metric("takes", source) == takes + 100, "a read message did not take its bytes once")
  end)
end

-- Closing with an unread backlog releases every queued holder without
-- copying its bytes.
function test_live_close_releases_unread_holders(_context: test.Context)
  runtime_test.run(function ()
    const source = live("burst")
    const connection = websocket.connect(source)
    defer connection:close()
    const holders = metric("holders", source)
    const takes = metric("takes", source)
    queue_burst(connection, source, 100)
    read_numbered(connection, 1, 60)
    connection:close()
    test.assert(metric("holders", source) == holders, "close kept unread holders")
    test.assert(metric("takes", source) == takes + 60, "close took the bytes of unread messages")
  end)
end

-- Bursts read while one message always stays queued never empty the queue,
-- so only compaction drops the consumed prefix: the queue's storage stays
-- bounded instead of growing with every message ever read.
function test_live_queue_storage_stays_bounded_while_never_empty(_context: test.Context)
  runtime_test.run(function ()
    const source = live("burst")
    const connection = websocket.connect(source)
    defer connection:close()
    queue_burst(connection, source, 150)
    read_numbered(connection, 1, 149)
    gc.collect()
    gc.collect()
    const baseline = gc.count()
    for _ = 1, 40 do
      queue_burst(connection, source, 150)
      read_numbered(connection, 150, 150)
      read_numbered(connection, 1, 149)
    end
    gc.collect()
    gc.collect()
    const growth = gc.count() - baseline
    test.assert(growth < 16384, "40 bursts read past an unread message grew memory by " .. growth .. " bytes")
    read_numbered(connection, 150, 150)
  end)
end
