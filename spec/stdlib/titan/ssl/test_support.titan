-- TLS fixture ownership for ssl.tests.
local test = import "test"
local runtime_test = import "support.runtime"
local async = import "async"
local fs = import "fs"
local ssl = import "ssl"

local CERTIFICATE = "spec/fixtures/ssl/server.pem"
local WRONG_CERTIFICATE = "spec/fixtures/ssl/wrong-server.pem"
local PRIVATE_KEY = "spec/fixtures/ssl/server-key.pem"
local TRUST_ROOT = "spec/fixtures/ssl/ca.pem"

local function cleanup_path(context: test.Context, path: string)
  runtime_test.cleanup(function ()
    do
      fs.unlink(path)
    catch
      if error is async.OperationError then
        local failure = error as async.OperationError
        if failure.name ~= "ENOENT" then raise error end
      else
        raise error
      end
    end
  end)
end

local function temporary_path(context: test.Context): string
  local path = fs.tmpname()
  cleanup_path(context, path)
  return path
end

local function cleanup_server(context: test.Context, server: ssl.Server)
  runtime_test.cleanup(function () server:close() end)
end

local function cleanup_connection(context: test.Context,
                                  connection: ssl.Connection)
  runtime_test.cleanup(function () connection:close() end)
end

local function listen_available(first_port: integer,
                                certificate: string,
                                private_key: string?):
    (ssl.Server, integer)
  local port = first_port
  for _index = 1, 100 do
    do
      if private_key == nil then
        return ssl.listen("127.0.0.1", port, certificate), port
      end
      return ssl.listen("127.0.0.1", port, certificate,
                        private_key as string), port
    catch
      if error is async.OperationError then
        local failure = error as async.OperationError
        if failure.name == "EADDRINUSE" then
          port = port + 1
          if port > 60999 then port = 20000 end
        else
          raise "ssl.listen failed with " .. failure.name .. ": " ..
                failure.message
        end
      else
        raise error
      end
    end
  end
  raise "could not find an available loopback port"
end
