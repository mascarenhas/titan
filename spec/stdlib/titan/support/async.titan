-- Shared Task ownership protocol for native standard-library tests.
local async = import "async"
local uv = import "uv"
local runtime_test = import "support.runtime.titan"

local function active(task: async.Task): boolean
  return not task:status():has_finished()
end

local function cancel_and_join_task(task: async.Task, reason: string)
  if active(task) then
    task:cancel(async.CancellationReason.simple(reason))
  end
  async.join(task)
end

local function cleanup_task(task: async.Task, reason: string)
  runtime_test.cleanup(function ()
    cancel_and_join_task(task, reason)
  end)
end

-- Lua-state close fixtures: drive the current Runtime's loop without
-- retiring it until `ready` holds, so the state can then close with `task`
-- still parked. RUN_NOWAIT never waits for the work the Task just submitted.
-- Raises the Task's failure if it finishes first.
local function drive_until(task: async.Task, ready: function (): boolean)
  while not ready() do
    case task:status()
    when failed(failure) then failure:raise()
    when succeeded() then raise "the state-close fixture Task returned early"
    when cancelled() then raise "the state-close fixture Task was cancelled"
    else
    end
    uv.run(async.current_loop(), uv.RUN_NOWAIT)
    if not ready() then uv.sleep(1) end
  end
end
