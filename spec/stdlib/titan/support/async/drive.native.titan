-- Native-only part of support.async: Lua-state close fixtures drive the
-- libuv loop directly.
local uv = import "uv"

-- Lua-state close fixtures: drive the current Runtime's loop without
-- retiring it until `ready` holds, so the state can then close with `task`
-- still parked. RUN_NOWAIT never waits for the work the Task just submitted.
-- Raises the Task's failure if it finishes first.
local function drive_until(task: async.Task, ready: function (): boolean)
  while not ready() do
    case task:status()
    when failed(failure) then failure:raise()
    when succeeded() then raise "the state-close fixture Task returned early"
    when cancelled() then raise "the state-close fixture Task was cancelled"
    else
    end
    uv.run(async.current_loop(), uv.RUN_NOWAIT)
    if not ready() then uv.sleep(1) end
  end
end
