-- Native public API cases corresponding to spec/support/path_cases.lua.
-- Both expected spellings are explicit; every case runs on every platform.
local test = import "test"
local path = import "path"

local function expect(actual: string, posix: string, windows: string)
  local expected = posix
  if path.separator == "\\" then expected = windows end
  test.assert(actual == expected, "expected '" .. expected .. "', got '" .. actual .. "'")
end

local function expect_absolute(actual: boolean, posix: boolean, windows: boolean)
  local expected = posix
  if path.separator == "\\" then expected = windows end
  test.assert(actual == expected, "absolute-path classification differed")
end

function test_separator(context: test.Context)
  test.assert(path.separator == "/" or path.separator == "\\")
end

function test_normalize(context: test.Context)
  context:run("edge_1", function(child: test.Context)
    local actual = path.normalize("")
    expect(actual, ".", ".")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_2", function(child: test.Context)
    local actual = path.normalize(".")
    expect(actual, ".", ".")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_3", function(child: test.Context)
    local actual = path.normalize("..")
    expect(actual, "..", "..")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_4", function(child: test.Context)
    local actual = path.normalize("a/b/c")
    expect(actual, "a/b/c", "a\\b\\c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_5", function(child: test.Context)
    local actual = path.normalize("a//b/./c/")
    expect(actual, "a/b/c", "a\\b\\c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_6", function(child: test.Context)
    local actual = path.normalize("a/b/../../c")
    expect(actual, "c", "c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_7", function(child: test.Context)
    local actual = path.normalize("a/b/../../../c")
    expect(actual, "../c", "..\\c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_8", function(child: test.Context)
    local actual = path.normalize("../../a")
    expect(actual, "../../a", "..\\..\\a")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_9", function(child: test.Context)
    local actual = path.normalize("/a/../../b")
    expect(actual, "/b", "\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_10", function(child: test.Context)
    local actual = path.normalize("/")
    expect(actual, "/", "\\")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_11", function(child: test.Context)
    local actual = path.normalize("./")
    expect(actual, ".", ".")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_12", function(child: test.Context)
    local actual = path.normalize("abc/def/..")
    expect(actual, "abc", "abc")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_13", function(child: test.Context)
    local actual = path.normalize("abc/def/../..")
    expect(actual, ".", ".")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_14", function(child: test.Context)
    local actual = path.normalize("a/../b:/../../c")
    expect(actual, "../c", "..\\c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_15", function(child: test.Context)
    local actual = path.normalize("a\\b\\..\\c")
    expect(actual, "a\\b\\..\\c", "a\\c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_16", function(child: test.Context)
    local actual = path.normalize("C:")
    expect(actual, "C:", "C:.")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_17", function(child: test.Context)
    local actual = path.normalize("C:\\")
    expect(actual, "C:\\", "C:\\")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_18", function(child: test.Context)
    local actual = path.normalize("C:foo\\..\\..\\bar")
    expect(actual, "C:foo\\..\\..\\bar", "C:..\\bar")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_19", function(child: test.Context)
    local actual = path.normalize("C:\\foo\\..\\..\\bar")
    expect(actual, "C:\\foo\\..\\..\\bar", "C:\\bar")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_20", function(child: test.Context)
    local actual = path.normalize("C:/foo//./bar/..")
    expect(actual, "C:/foo", "C:\\foo")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_21", function(child: test.Context)
    local actual = path.normalize("\\\\host\\share\\a\\..\\..\\..\\b")
    expect(actual, "\\\\host\\share\\a\\..\\..\\..\\b", "\\\\host\\share\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_22", function(child: test.Context)
    local actual = path.normalize("//host/share/foo/../bar")
    expect(actual, "/host/share/bar", "\\\\host\\share\\bar")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_23", function(child: test.Context)
    local actual = path.normalize("//host/share")
    expect(actual, "/host/share", "\\\\host\\share")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_24", function(child: test.Context)
    local actual = path.normalize("//abc")
    expect(actual, "/abc", "\\\\abc")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_25", function(child: test.Context)
    local actual = path.normalize("///abc")
    expect(actual, "/abc", "\\\\\\abc")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_26", function(child: test.Context)
    local actual = path.normalize("//abc//")
    expect(actual, "/abc", "\\\\abc\\\\")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_27", function(child: test.Context)
    local actual = path.normalize("\\\\i\\..\\c$")
    expect(actual, "\\\\i\\..\\c$", "\\c$")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_28", function(child: test.Context)
    local actual = path.normalize("//../../a")
    expect(actual, "/a", "\\a")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_29", function(child: test.Context)
    local actual = path.normalize("\\\\?\\C:\\")
    expect(actual, "\\\\?\\C:\\", "\\\\?\\C:\\")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_30", function(child: test.Context)
    local actual = path.normalize("\\\\?\\C:\\a\\..\\b")
    expect(actual, "\\\\?\\C:\\a\\..\\b", "\\\\?\\C:\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_31", function(child: test.Context)
    local actual = path.normalize("\\\\?\\UNC\\host\\share\\a\\..\\..\\b")
    expect(actual, "\\\\?\\UNC\\host\\share\\a\\..\\..\\b", "\\\\?\\UNC\\host\\share\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_32", function(child: test.Context)
    local actual = path.normalize("\\??\\UNC\\host\\share\\a\\..\\..\\b")
    expect(actual, "\\??\\UNC\\host\\share\\a\\..\\..\\b", "\\??\\UNC\\host\\share\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_33", function(child: test.Context)
    local actual = path.normalize("\\\\.\\C:\\a\\..\\..\\b")
    expect(actual, "\\\\.\\C:\\a\\..\\..\\b", "\\\\.\\C:\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_34", function(child: test.Context)
    local actual = path.normalize("a/../C:foo")
    expect(actual, "C:foo", ".\\C:foo")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_35", function(child: test.Context)
    local actual = path.normalize("a/../C:/foo")
    expect(actual, "C:/foo", ".\\C:\\foo")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_36", function(child: test.Context)
    local actual = path.normalize("a/../../C:foo")
    expect(actual, "../C:foo", "..\\C:foo")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_37", function(child: test.Context)
    local actual = path.normalize("foo:bar")
    expect(actual, "foo:bar", "foo:bar")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_38", function(child: test.Context)
    local actual = path.normalize("foo:bar/")
    expect(actual, "foo:bar", "foo:bar")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_39", function(child: test.Context)
    local actual = path.normalize("./foo:bar")
    expect(actual, "foo:bar", ".\\foo:bar")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_40", function(child: test.Context)
    local actual = path.normalize(":\\a/a//..")
    expect(actual, ":\\a", ".\\:\\a")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_41", function(child: test.Context)
    local actual = path.normalize("/a/../??/b")
    expect(actual, "/??/b", "\\.\\??\\b")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_42", function(child: test.Context)
    local actual = path.normalize("/??/../../.")
    expect(actual, "/", "\\")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_43", function(child: test.Context)
    local actual = path.normalize("./foo:bar/..")
    expect(actual, ".", ".")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_44", function(child: test.Context)
    local actual = path.normalize("./foo:bar/../")
    expect(actual, ".", ".")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
  context:run("edge_45", function(child: test.Context)
    local actual = path.normalize("a\0/b/../c")
    expect(actual, "a\0/c", "a\0\\c")
    test.assert(path.normalize(actual) == actual, "normalization changed on repetition")
  end)
end

function test_basename(context: test.Context)
  context:run("edge_46", function(child: test.Context)
    expect(path.basename(""), ".", ".")
  end)
  context:run("edge_47", function(child: test.Context)
    expect(path.basename("."), ".", ".")
  end)
  context:run("edge_48", function(child: test.Context)
    expect(path.basename(".."), "..", "..")
  end)
  context:run("edge_49", function(child: test.Context)
    expect(path.basename("/"), "/", "\\")
  end)
  context:run("edge_50", function(child: test.Context)
    expect(path.basename("////"), "/", "\\")
  end)
  context:run("edge_51", function(child: test.Context)
    expect(path.basename("a/b/"), "b", "b")
  end)
  context:run("edge_52", function(child: test.Context)
    expect(path.basename("a/b/.."), "..", "..")
  end)
  context:run("edge_53", function(child: test.Context)
    expect(path.basename("a/.profile"), ".profile", ".profile")
  end)
  context:run("edge_54", function(child: test.Context)
    expect(path.basename("a\\b\\"), "a\\b\\", "b")
  end)
  context:run("edge_55", function(child: test.Context)
    expect(path.basename("C:"), "C:", "\\")
  end)
  context:run("edge_56", function(child: test.Context)
    expect(path.basename("C:foo"), "C:foo", "foo")
  end)
  context:run("edge_57", function(child: test.Context)
    expect(path.basename("C:\\"), "C:\\", "\\")
  end)
  context:run("edge_58", function(child: test.Context)
    expect(path.basename("\\\\host\\share\\"), "\\\\host\\share\\", "\\")
  end)
  context:run("edge_59", function(child: test.Context)
    expect(path.basename("//host/share"), "share", "\\")
  end)
  context:run("edge_60", function(child: test.Context)
    expect(path.basename("\\\\?\\C:\\a"), "\\\\?\\C:\\a", "a")
  end)
end

function test_dirname(context: test.Context)
  context:run("edge_61", function(child: test.Context)
    expect(path.dirname(""), ".", ".")
  end)
  context:run("edge_62", function(child: test.Context)
    expect(path.dirname("a"), ".", ".")
  end)
  context:run("edge_63", function(child: test.Context)
    expect(path.dirname("a/b"), "a", "a")
  end)
  context:run("edge_64", function(child: test.Context)
    expect(path.dirname("a/b/"), "a/b", "a\\b")
  end)
  context:run("edge_65", function(child: test.Context)
    expect(path.dirname("a/b/../c"), "a", "a")
  end)
  context:run("edge_66", function(child: test.Context)
    expect(path.dirname("/a"), "/", "\\")
  end)
  context:run("edge_67", function(child: test.Context)
    expect(path.dirname("/"), "/", "\\")
  end)
  context:run("edge_68", function(child: test.Context)
    expect(path.dirname("a\\b"), ".", "a")
  end)
  context:run("edge_69", function(child: test.Context)
    expect(path.dirname("C:foo"), ".", "C:.")
  end)
  context:run("edge_70", function(child: test.Context)
    expect(path.dirname("C:\\foo"), ".", "C:\\")
  end)
  context:run("edge_71", function(child: test.Context)
    expect(path.dirname("C:foo\\bar"), ".", "C:foo")
  end)
  context:run("edge_72", function(child: test.Context)
    expect(path.dirname("//host/share"), "/host", "\\\\host\\share")
  end)
  context:run("edge_73", function(child: test.Context)
    expect(path.dirname("\\\\host\\share\\a"), ".", "\\\\host\\share\\")
  end)
  context:run("edge_74", function(child: test.Context)
    expect(path.dirname("\\\\host\\share\\a\\b"), ".", "\\\\host\\share\\a")
  end)
  context:run("edge_75", function(child: test.Context)
    expect(path.dirname("\\\\?\\C:\\a\\b"), ".", "\\\\?\\C:\\a")
  end)
  context:run("edge_76", function(child: test.Context)
    expect(path.dirname("/??/../../."), "/", "\\")
  end)
  context:run("edge_77", function(child: test.Context)
    expect(path.dirname("./foo:bar/../"), ".", ".")
  end)
end

function test_extension(context: test.Context)
  context:run("edge_78", function(child: test.Context)
    expect(path.extension(""), "", "")
  end)
  context:run("edge_79", function(child: test.Context)
    expect(path.extension("name"), "", "")
  end)
  context:run("edge_80", function(child: test.Context)
    expect(path.extension("a.b/name"), "", "")
  end)
  context:run("edge_81", function(child: test.Context)
    expect(path.extension("name.tar.gz"), ".gz", ".gz")
  end)
  context:run("edge_82", function(child: test.Context)
    expect(path.extension(".profile"), ".profile", ".profile")
  end)
  context:run("edge_83", function(child: test.Context)
    expect(path.extension("name."), ".", ".")
  end)
  context:run("edge_84", function(child: test.Context)
    expect(path.extension("."), ".", ".")
  end)
  context:run("edge_85", function(child: test.Context)
    expect(path.extension(".."), ".", ".")
  end)
  context:run("edge_86", function(child: test.Context)
    expect(path.extension("name.ext/"), "", "")
  end)
  context:run("edge_87", function(child: test.Context)
    expect(path.extension("a.b\\name"), ".b\\name", "")
  end)
  context:run("edge_88", function(child: test.Context)
    expect(path.extension("C:\\dir\\name.ext"), ".ext", ".ext")
  end)
end

function test_is_absolute(context: test.Context)
  context:run("edge_89", function(child: test.Context)
    expect_absolute(path.is_absolute(""), false, false)
  end)
  context:run("edge_90", function(child: test.Context)
    expect_absolute(path.is_absolute("a"), false, false)
  end)
  context:run("edge_91", function(child: test.Context)
    expect_absolute(path.is_absolute("/"), true, false)
  end)
  context:run("edge_92", function(child: test.Context)
    expect_absolute(path.is_absolute("/a"), true, false)
  end)
  context:run("edge_93", function(child: test.Context)
    expect_absolute(path.is_absolute("\\a"), false, false)
  end)
  context:run("edge_94", function(child: test.Context)
    expect_absolute(path.is_absolute("C:"), false, false)
  end)
  context:run("edge_95", function(child: test.Context)
    expect_absolute(path.is_absolute("C:a"), false, false)
  end)
  context:run("edge_96", function(child: test.Context)
    expect_absolute(path.is_absolute("C:\\a"), false, true)
  end)
  context:run("edge_97", function(child: test.Context)
    expect_absolute(path.is_absolute("C:/a"), false, true)
  end)
  context:run("edge_98", function(child: test.Context)
    expect_absolute(path.is_absolute("//host/share"), true, true)
  end)
  context:run("edge_99", function(child: test.Context)
    expect_absolute(path.is_absolute("\\\\host\\share"), false, true)
  end)
  context:run("edge_100", function(child: test.Context)
    expect_absolute(path.is_absolute("\\\\?\\C:\\a"), false, true)
  end)
  context:run("edge_101", function(child: test.Context)
    expect_absolute(path.is_absolute("\\??\\C:\\a"), false, true)
  end)
  context:run("edge_102", function(child: test.Context)
    expect_absolute(path.is_absolute("//../../a"), true, false)
  end)
  context:run("edge_103", function(child: test.Context)
    expect_absolute(path.is_absolute("//?/../a"), true, false)
  end)
  context:run("edge_104", function(child: test.Context)
    expect_absolute(path.is_absolute("\\\\i\\..\\c$"), false, false)
  end)
end

function test_split(context: test.Context)
  context:run("edge_105", function(child: test.Context)
    local directory, leaf = path.split("")
    expect(directory, "", "")
    expect(leaf, "", "")
    test.assert(directory .. leaf == "")
  end)
  context:run("edge_106", function(child: test.Context)
    local directory, leaf = path.split("a")
    expect(directory, "", "")
    expect(leaf, "a", "a")
    test.assert(directory .. leaf == "a")
  end)
  context:run("edge_107", function(child: test.Context)
    local directory, leaf = path.split("/")
    expect(directory, "/", "/")
    expect(leaf, "", "")
    test.assert(directory .. leaf == "/")
  end)
  context:run("edge_108", function(child: test.Context)
    local directory, leaf = path.split("a//b")
    expect(directory, "a//", "a//")
    expect(leaf, "b", "b")
    test.assert(directory .. leaf == "a//b")
  end)
  context:run("edge_109", function(child: test.Context)
    local directory, leaf = path.split("a/b/")
    expect(directory, "a/b/", "a/b/")
    expect(leaf, "", "")
    test.assert(directory .. leaf == "a/b/")
  end)
  context:run("edge_110", function(child: test.Context)
    local directory, leaf = path.split("a/../b")
    expect(directory, "a/../", "a/../")
    expect(leaf, "b", "b")
    test.assert(directory .. leaf == "a/../b")
  end)
  context:run("edge_111", function(child: test.Context)
    local directory, leaf = path.split("a\\b")
    expect(directory, "", "a\\")
    expect(leaf, "a\\b", "b")
    test.assert(directory .. leaf == "a\\b")
  end)
  context:run("edge_112", function(child: test.Context)
    local directory, leaf = path.split("C:")
    expect(directory, "", "C:")
    expect(leaf, "C:", "")
    test.assert(directory .. leaf == "C:")
  end)
  context:run("edge_113", function(child: test.Context)
    local directory, leaf = path.split("C:foo")
    expect(directory, "", "C:")
    expect(leaf, "C:foo", "foo")
    test.assert(directory .. leaf == "C:foo")
  end)
  context:run("edge_114", function(child: test.Context)
    local directory, leaf = path.split("C:/foo")
    expect(directory, "C:/", "C:/")
    expect(leaf, "foo", "foo")
    test.assert(directory .. leaf == "C:/foo")
  end)
  context:run("edge_115", function(child: test.Context)
    local directory, leaf = path.split("//host/share")
    expect(directory, "//host/", "//host/share")
    expect(leaf, "share", "")
    test.assert(directory .. leaf == "//host/share")
  end)
  context:run("edge_116", function(child: test.Context)
    local directory, leaf = path.split("\\\\host\\share\\foo")
    expect(directory, "", "\\\\host\\share\\")
    expect(leaf, "\\\\host\\share\\foo", "foo")
    test.assert(directory .. leaf == "\\\\host\\share\\foo")
  end)
  context:run("edge_117", function(child: test.Context)
    local directory, leaf = path.split("\\\\?\\C:\\foo")
    expect(directory, "", "\\\\?\\C:\\")
    expect(leaf, "\\\\?\\C:\\foo", "foo")
    test.assert(directory .. leaf == "\\\\?\\C:\\foo")
  end)
end

function test_volume(context: test.Context)
  context:run("edge_118", function(child: test.Context)
    expect(path.volume(""), "", "")
  end)
  context:run("edge_119", function(child: test.Context)
    expect(path.volume("/a"), "", "")
  end)
  context:run("edge_120", function(child: test.Context)
    expect(path.volume("C:/a"), "", "C:")
  end)
  context:run("edge_121", function(child: test.Context)
    expect(path.volume("2:"), "", "2:")
  end)
  context:run("edge_122", function(child: test.Context)
    expect(path.volume("//host/share/a"), "", "\\\\host\\share")
  end)
  context:run("edge_123", function(child: test.Context)
    expect(path.volume("//host"), "", "\\\\host")
  end)
  context:run("edge_124", function(child: test.Context)
    expect(path.volume("//host/"), "", "\\\\host\\")
  end)
  context:run("edge_125", function(child: test.Context)
    expect(path.volume("//../../a"), "", "")
  end)
  context:run("edge_126", function(child: test.Context)
    expect(path.volume("//?/../a"), "", "")
  end)
  context:run("edge_127", function(child: test.Context)
    expect(path.volume("//.../share"), "", "\\\\...\\share")
  end)
  context:run("edge_128", function(child: test.Context)
    expect(path.volume("//./C:/a"), "", "\\\\.\\C:")
  end)
  context:run("edge_129", function(child: test.Context)
    expect(path.volume("//?/C:/a"), "", "\\\\?\\C:")
  end)
  context:run("edge_130", function(child: test.Context)
    expect(path.volume("/??/C:/a"), "", "\\??\\C:")
  end)
  context:run("edge_131", function(child: test.Context)
    expect(path.volume("//?/UNC/host/share/a"), "", "\\\\?\\UNC\\host\\share")
  end)
  context:run("edge_132", function(child: test.Context)
    expect(path.volume("//?/unc/host/share/a"), "", "\\\\?\\unc\\host\\share")
  end)
  context:run("edge_133", function(child: test.Context)
    expect(path.volume("//./UNC/../share"), "", "")
  end)
  context:run("edge_134", function(child: test.Context)
    expect(path.volume("//?"), "", "\\\\?")
  end)
  context:run("edge_135", function(child: test.Context)
    expect(path.volume("\\\\?\\Volume{123}\\a"), "", "\\\\?\\Volume{123}")
  end)
end

function test_to_slash(context: test.Context)
  context:run("edge_136", function(child: test.Context)
    expect(path.to_slash("a\\b/c"), "a\\b/c", "a/b/c")
  end)
  context:run("edge_137", function(child: test.Context)
    expect(path.to_slash("\\\\?\\C:\\a"), "\\\\?\\C:\\a", "//?/C:/a")
  end)
end

function test_from_slash(context: test.Context)
  context:run("edge_138", function(child: test.Context)
    expect(path.from_slash("a\\b/c"), "a\\b/c", "a\\b\\c")
  end)
  context:run("edge_139", function(child: test.Context)
    expect(path.from_slash("//host/share/a"), "//host/share/a", "\\\\host\\share\\a")
  end)
  context:run("edge_140", function(child: test.Context)
    expect(path.from_slash("a//./b/../c"), "a//./b/../c", "a\\\\.\\b\\..\\c")
  end)
end

function test_join(context: test.Context)
  context:run("edge_141", function(child: test.Context)
    expect(path.join(), "", "")
  end)
  context:run("edge_142", function(child: test.Context)
    expect(path.join("", ""), "", "")
  end)
  context:run("edge_143", function(child: test.Context)
    expect(path.join("a", "", "b"), "a/b", "a\\b")
  end)
  context:run("edge_144", function(child: test.Context)
    expect(path.join("a", "/b"), "a/b", "a\\b")
  end)
  context:run("edge_145", function(child: test.Context)
    expect(path.join("/a", "/b"), "/a/b", "\\a\\b")
  end)
  context:run("edge_146", function(child: test.Context)
    expect(path.join("a/b", "../c"), "a/c", "a\\c")
  end)
  context:run("edge_147", function(child: test.Context)
    expect(path.join("/", "a", "b"), "/a/b", "\\a\\b")
  end)
  context:run("edge_148", function(child: test.Context)
    expect(path.join("C:", "a"), "C:/a", "C:a")
  end)
  context:run("edge_149", function(child: test.Context)
    expect(path.join("C:", "", "b"), "C:/b", "C:b")
  end)
  context:run("edge_150", function(child: test.Context)
    expect(path.join("C:", ""), "C:", "C:.")
  end)
  context:run("edge_151", function(child: test.Context)
    expect(path.join("C:", "\\a"), "C:/\\a", "C:\\a")
  end)
  context:run("edge_152", function(child: test.Context)
    expect(path.join("C:.", "a"), "C:./a", "C:a")
  end)
  context:run("edge_153", function(child: test.Context)
    expect(path.join("C:\\", "a"), "C:\\/a", "C:\\a")
  end)
  context:run("edge_154", function(child: test.Context)
    expect(path.join("//host/share", "foo/bar"), "/host/share/foo/bar", "\\\\host\\share\\foo\\bar")
  end)
  context:run("edge_155", function(child: test.Context)
    expect(path.join("\\", "a", "b"), "\\/a/b", "\\a\\b")
  end)
  context:run("edge_156", function(child: test.Context)
    expect(path.join("\\\\", "a", "b"), "\\\\/a/b", "\\\\a\\b")
  end)
  context:run("edge_157", function(child: test.Context)
    expect(path.join("\\", "\\\\a\\b", "c"), "\\/\\\\a\\b/c", "\\a\\b\\c")
  end)
  context:run("edge_158", function(child: test.Context)
    expect(path.join("//", "a"), "/a", "\\\\a")
  end)
  context:run("edge_159", function(child: test.Context)
    expect(path.join("\\", "??\\a"), "\\/??\\a", "\\.\\??\\a")
  end)
  context:run("edge_160", function(child: test.Context)
    expect(path.join("a", "..", "C:foo"), "C:foo", ".\\C:foo")
  end)
  context:run("edge_161", function(child: test.Context)
    expect(path.join("\\\\?\\C:\\", "a", "..", "b"), "\\\\?\\C:\\/b", "\\\\?\\C:\\b")
  end)
end
