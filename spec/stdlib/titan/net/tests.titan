local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local gc = import "gc"
local stream = import "io"
local net = import "net"
local strings = import "string"
local timer = import "timer"
local support = import "net.test_support.titan"
local task_support = import "support.async.titan"

local function expect_cancelled_net_operation(action: function (): (),
                                              label: string)
  local reason = async.CancellationReason.simple(label)
  local observed: value = nil
  local competitor = async.run<|value, value|>(function (): value
    async.running():cancel(reason)
    do action() catch observed = error end
    return nil
  end)
  task_support.cleanup_task(competitor, label .. " cleanup")
  async.join(competitor)
  -- A cancelled Task can swallow assertions raised in its own body.
  test.assert(competitor:status():has_cancelled() and observed == reason,
              label .. " was replaced by a contention diagnostic")
end

function test_net_cancelled_reader_allows_immediate_replacement(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28100)
    support.cleanup_server(context, server)
    local connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    local peer = server:accept()
    support.cleanup_connection(context, peer)
    local reason = async.CancellationReason.simple("replace TCP reader")
    local observed: value = nil
    local old = async.run<|value, value|>(function (): value
      do connection:read() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(old, "old TCP reader cleanup")
    while old:status():as_string() == "ready" do timer.yield() end
    test.assert(old:status():as_string() == "waiting", "TCP reader did not wait")
    expect_cancelled_net_operation(function () connection:read() end,
                                   "pending TCP reader cancellation")
    test.assert(old:status():as_string() == "waiting",
                "cancelled competitor disturbed the TCP reader")

    local sender = async.run<|value, value|>(function (): value
      async.join(old)
      peer:write("replacement\0")
      peer:shutdown()
      return nil
    end)
    task_support.cleanup_task(sender, "replacement TCP sender cleanup")
    old:cancel(reason)
    test.assert(observed == nil, "old TCP reader unwound before replacement")
    -- Register the successor before yielding. Data arrives only after the old
    -- reader unwinds, so its defer must preserve the successor's reservation.
    test.assert(connection:read_until("\0", true) == "replacement" and
                not connection:read(), "replacement TCP reader lost data or EOF")
    async.join(sender)
    test.assert(old:status():has_cancelled() and observed == reason,
                "old TCP reader lost its cancellation reason")
    test.assert(sender:status():has_succeeded(), "replacement TCP sender failed")
  end)
end

function test_net_cancelled_acceptor_allows_immediate_replacement(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28200)
    support.cleanup_server(context, server)
    local reason = async.CancellationReason.simple("replace TCP acceptor")
    local observed: value = nil
    local old = async.run<|value, value|>(function (): value
      do server:accept() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(old, "old TCP acceptor cleanup")
    while old:status():as_string() == "ready" do timer.yield() end
    test.assert(old:status():as_string() == "waiting", "TCP acceptor did not wait")
    expect_cancelled_net_operation(function () server:accept() end,
                                   "pending TCP acceptor cancellation")
    test.assert(old:status():as_string() == "waiting",
                "cancelled competitor disturbed the TCP acceptor")

    local connector = async.run<|value, value|>(function (): value
      async.join(old)
      local connection = net.connect("127.0.0.1", port)
      defer connection:close()
      connection:write("replacement\0")
      return nil
    end)
    task_support.cleanup_task(connector, "replacement TCP connector cleanup")
    old:cancel(reason)
    test.assert(observed == nil, "old TCP acceptor unwound before replacement")
    -- No join or yield may separate cancellation from this new accept.
    local connection = server:accept()
    support.cleanup_connection(context, connection)
    test.assert(connection:read_until("\0", true) == "replacement",
                "replacement TCP acceptor lost its connection")
    async.join(connector)
    test.assert(old:status():has_cancelled() and observed == reason,
                "old TCP acceptor lost its cancellation reason")
    test.assert(connector:status():has_succeeded(), "replacement connector failed")
  end)
end

function test_net_exchanges_binary_streams_through_tcp(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(26000)
    support.cleanup_server(context, server)
    local peer = async.run<|value, value|>(function (): value
      local connection = server:accept()
      defer connection:close()
      test.assert(connection:read_until("\0END", true) == "alpha",
                  "binary delimiter read returned wrong prefix")
      test.assert(connection:read() == "tail",
                  "delimiter read did not retain excess")
      test.assert(not connection:read(),
                  "peer did not observe client write shutdown")

      connection:write("reply\0\nrest")
      connection:shutdown()
      connection:shutdown()
      support.expect_failure(function ()
        connection:write("late")
      end, "Connection accepted a write after shutdown")
      connection:close()
      connection:close()
      return nil
    end)
    task_support.cleanup_task(peer, "net exchange cleanup")

    local connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    local concrete: stream.ReaderWriterCloser = connection
    concrete:write("alpha\0ENDtail")
    connection:shutdown()
    test.assert(concrete:read_until("\n", true) == "reply\0",
                "binary response delimiter changed")
    test.assert(concrete:read() == "rest",
                "response delimiter excess was lost")
    test.assert(not concrete:read() and not concrete:read_until("missing"),
                "repeated Connection reads did not return EOF")
    concrete:close()
    concrete:close()
    test.assert(not concrete:read() and not concrete:read_until("missing"),
                "closed Connection did not behave as Reader EOF")
    support.expect_failure(function ()
      concrete:write("after-close")
    end, "closed Connection accepted a write")

    while task_support.active(peer) do timer.yield() end
    test.assert(peer:status():as_string() == "succeeded",
                "TCP peer Task failed")
    local closer: stream.Closer = server
    closer:close()
    closer:close()
  end)
end

function test_net_received_chunks_remain_immutable_through_gc_and_cancellation(
    _context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28300)
    support.cleanup_server(_context, server)
    local connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(_context, connection)
    local peer = server:accept()
    support.cleanup_connection(_context, peer)
    local first_payload = strings.rep("first\0\255", 20000)
    local second_payload = strings.rep("second\0\128", 20000)
    local sender = async.run<|value, value|>(function (): value
      peer:write(first_payload)
      test.assert(peer:read_until("\n", true) == "next",
                  "TCP receive phases lost their acknowledgement")
      peer:write(second_payload)
      peer:shutdown()
      return nil
    end)
    runtime_test.cleanup(function ()
      sender:cancel(async.CancellationReason.simple("TCP receive sender cleanup"))
      -- Closing retires an accepted write even if an assertion prevented the
      -- receiver from draining the peer's output. Cancellation alone cannot.
      peer:close()
      connection:close()
      async.join(sender)
    end)

    local first_chunks: {string} = {}
    local first_length = 0
    while first_length < #first_payload do
      local chunk? = connection:read()
      if not chunk then raise "TCP first receive phase ended early" end
      first_chunks[#first_chunks + 1] = chunk
      first_length = first_length + #chunk
      gc.collect()
    end
    test.assert(first_length == #first_payload,
                "TCP second receive phase preceded its acknowledgement")

    local reason = async.CancellationReason.simple("cancel between TCP receive phases")
    local observed: value = nil
    local blocked = async.run<|value, value|>(function (): value
      do connection:read() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(blocked, "TCP receive waiter cleanup")
    -- All first-phase bytes were consumed and the sender requires our explicit
    -- acknowledgement before producing more, so this wait cannot finish early.
    while blocked:status():as_string() == "ready" do timer.yield() end
    test.assert(blocked:status():as_string() == "waiting",
                "TCP receive waiter did not suspend between phases")
    blocked:cancel(reason)
    gc.collect()
    gc.collect()
    async.join(blocked)
    local cancelled, actual? = blocked:status():has_cancelled()
    test.assert(cancelled and actual == reason and observed == reason,
                "TCP receive waiter lost its cancellation reason")

    connection:write("next\n")
    local second_chunks: {string} = {}
    while true do
      local chunk? = connection:read()
      if not chunk then break end
      second_chunks[#second_chunks + 1] = chunk
      gc.collect()
    end
    async.join(sender)
    test.assert(sender:status():has_succeeded(), "TCP receive sender failed")
    test.assert(not connection:read(), "TCP receive EOF was not sticky")
    gc.collect()
    gc.collect()

    -- Keep each original chunk until later native receives and EOF have reused
    -- and retired the receive storage. TCP chunk boundaries remain unspecified.
    local first_result, second_result = "", ""
    for index = 1, #first_chunks do first_result = first_result .. first_chunks[index] end
    for index = 1, #second_chunks do second_result = second_result .. second_chunks[index] end
    test.assert(first_result == first_payload and second_result == second_payload,
                "later TCP receives, cancellation, or EOF changed retained binary chunks")
  end)
end

function test_net_overlapping_writes_preserve_bytes_through_gc_and_cancellation(
    _context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28400)
    support.cleanup_server(_context, server)
    local connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(_context, connection)
    local peer = server:accept()
    support.cleanup_connection(_context, peer)
    local start_first: (function (nil): ())? = nil
    local start_second: (function (nil): ())? = nil
    local first_piece, second_piece = "first\0\255", "second\0\128"
    local repetitions = 32768
    local first_submitted, second_submitted = false, false
    local first_returned, second_returned = false, false
    local second: async.Task<|value, value|>? = nil
    local first = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        start_first = resolve
      end)
      first_submitted = true
      connection:write(strings.rep(first_piece, repetitions))
      first_returned = true
      return nil
    end)
    runtime_test.cleanup(function ()
      first:cancel(async.CancellationReason.simple("first TCP writer cleanup"))
      if second ~= nil then
        second:cancel(async.CancellationReason.simple("second TCP writer cleanup"))
      end
      -- Cancel before releasing unused gates, so cleanup cannot start a write.
      if start_first ~= nil then
        local release = start_first
        start_first = nil
        release(nil)
      end
      if start_second ~= nil then
        local release = start_second
        start_second = nil
        release(nil)
      end
      -- Retire accepted writes before joining, including when the peer has not
      -- drained enough bytes to let native write callbacks complete normally.
      connection:close()
      peer:close()
      async.join(first)
      if second ~= nil then async.join(second) end
    end)
    second = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        start_second = resolve
      end)
      second_submitted = true
      connection:write(strings.rep(second_piece, repetitions))
      second_returned = true
      return nil
    end)
    while start_first == nil or start_second == nil do timer.yield() end

    local reason = async.CancellationReason.simple("cancel accepted TCP write")
    -- Registration runs outside a Task: settling each gate synchronously
    -- reaches its real write submission before any UV completion can interleave.
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local release_first, release_second = start_first, start_second
      start_first = nil
      release_first(nil)
      start_second = nil
      release_second(nil)
      test.assert(first_submitted and second_submitted and
                  first:status():as_string() == "waiting" and
                  second:status():as_string() == "waiting",
                  "overlapping TCP writes did not both await their callbacks")
      first:cancel(reason)
      gc.collect()
      gc.collect()
      test.assert(first:status():as_string() == "waiting" and
                  second:status():as_string() == "waiting" and
                  not first_returned and not second_returned,
                  "TCP writes advanced before their completion callbacks")
      resolve(nil)
    end)

    -- Drain while the writes are pending; joining before reading could fill
    -- the socket buffers. Each writer constructed its own temporary payload.
    local received = ""
    while #received < (#first_piece + #second_piece) * repetitions do
      local chunk? = peer:read()
      if not chunk then raise "overlapping TCP writes ended early" end
      received = received .. chunk
      gc.collect()
    end
    async.join(first)
    async.join(second)
    local cancelled, actual? = first:status():has_cancelled()
    test.assert(cancelled and actual == reason and not first_returned,
                "accepted TCP write lost cancellation or returned normally")
    test.assert(second:status():has_succeeded() and second_returned,
                "cancelling one TCP write disturbed the overlapping writer")
    test.assert(received == strings.rep(first_piece, repetitions) ..
                            strings.rep(second_piece, repetitions),
                "overlapping TCP writes changed binary bytes or submission order")
    connection:shutdown()
    test.assert(not peer:read(), "TCP shutdown did not follow the accepted writes")
  end)
end

function test_net_validates_endpoints_and_wakes_pending_accept(
    context: test.Context)
  runtime_test.run(function ()
    support.expect_failure(function ()
      net.connect("", 1)
    end, "connect accepted an empty host")
    support.expect_failure(function ()
      net.connect("127.0.0.1", 0)
    end, "connect accepted port zero")
    support.expect_failure(function ()
      net.connect("127.0.0.1", 65536)
    end, "connect accepted an oversized port")
    support.expect_failure(function ()
      net.listen("", 1, 8)
    end, "listen accepted an empty host")
    support.expect_failure(function ()
      net.listen("127.0.0.1", -1, 8)
    end, "listen accepted a negative port")
    support.expect_failure(function ()
      net.listen("127.0.0.1", 1, 0)
    end, "listen accepted a nonpositive backlog")
    support.expect_failure(function ()
      net.listen("127.0.0.1", 1, 2147483648)
    end, "listen accepted a backlog outside libuv's C-int range")
    support.expect_failure(function ()
      net.listen("127.0.0.1\0ignored", 1, 8)
    end, "listen accepted an embedded-NUL host")

    local server, _ = support.listen_available(27000)
    support.cleanup_server(context, server)
    local accept_failed = false
    local waiter = async.run<|value, value|>(function (): value
      do
        server:accept()
      catch
        local failure = error as async.OperationError
        test.assert(failure.operation == "net.accept",
                    "closed accept reported the wrong operation")
        accept_failed = true
      end
      return nil
    end)
    task_support.cleanup_task(waiter, "pending accept cleanup")
    while waiter:status():as_string() == "ready" do timer.yield() end
    test.assert(waiter:status():as_string() == "waiting",
                "accept Task did not reach its callback wait")
    local competing_accept_rejected = false
    do
      server:accept()
    catch
      competing_accept_rejected = true
    end
    test.assert(competing_accept_rejected,
                "Server accepted a second waiting Task")
    server:close()
    server:close()
    while task_support.active(waiter) do timer.yield() end
    test.assert(waiter:status():as_string() == "succeeded" and accept_failed,
                "Server close did not fail its accept continuation")

    -- Connecting and writing first lets the listener retain one accepted client
    -- until the owning Task asks for it. This is buffered multi-shot state, not
    -- a Titan-side operation queue. The hostname also exercises address
    -- resolution and candidate fallback without assuming address order.
    local buffered_server, buffered_port = support.listen_available(28000)
    support.cleanup_server(context, buffered_server)
    local buffered_client = net.connect("localhost", buffered_port)
    support.cleanup_connection(context, buffered_client)
    buffered_client:write("buffered-client")
    buffered_client:shutdown()
    local buffered_peer = buffered_server:accept()
    support.cleanup_connection(context, buffered_peer)
    test.assert(buffered_peer:read() == "buffered-client" and
                not buffered_peer:read(),
                "Server did not retain its unwaited accepted client")
    buffered_peer:close()
    buffered_client:close()
    buffered_server:close()
  end)
end
