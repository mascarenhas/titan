local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local gc = import "gc"
local stream = import "io"
local net = import "net"
local uv = import "uv"
local strings = import "string"
local timer = import "timer"
local support = import "net.test_support.titan"
local task_support = import "support.async.titan"
local common = import "support.common.titan"
local transfer_lua = import "lua"
local thread = import "thread"
local owned_tcp = import "support.owned_tcp.titan"

local function expect_cancelled_net_operation(action: function (): (),
                                              label: string)
  const reason = async.CancellationReason.simple(label)
  local observed: value = nil
  const competitor = async.run<|value, value|>(function (): value
    async.running():cancel(reason)
    do action() catch observed = error end
    return nil
  end)
  task_support.cleanup_task(competitor, label .. " cleanup")
  async.join(competitor)
  -- A cancelled Task can swallow assertions raised in its own body.
  test.assert(competitor:status():has_cancelled() and observed == reason,
              label .. " was replaced by a contention diagnostic")
end

function test_net_cancelled_reader_allows_immediate_replacement(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28100)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    const reason = async.CancellationReason.simple("replace TCP reader")
    local observed: value = nil
    const old = async.run<|value, value|>(function (): value
      do connection:read() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(old, "old TCP reader cleanup")
    while old:status():as_string() == "ready" do timer.yield() end
    test.assert(old:status():as_string() == "waiting", "TCP reader did not wait")
    expect_cancelled_net_operation(function () connection:read() end,
                                   "pending TCP reader cancellation")
    test.assert(old:status():as_string() == "waiting",
                "cancelled competitor disturbed the TCP reader")

    const sender = async.run<|value, value|>(function (): value
      async.join(old)
      peer:write("replacement\0")
      peer:shutdown()
      return nil
    end)
    task_support.cleanup_task(sender, "replacement TCP sender cleanup")
    old:cancel(reason)
    test.assert(observed == nil, "old TCP reader unwound before replacement")
    -- Register the successor before yielding. Data arrives only after the old
    -- reader unwinds, so its defer must preserve the successor's reservation.
    test.assert(connection:read_until("\0", true) == "replacement" and
                not connection:read(), "replacement TCP reader lost data or EOF")
    async.join(sender)
    test.assert(old:status():has_cancelled() and observed == reason,
                "old TCP reader lost its cancellation reason")
    test.assert(sender:status():has_succeeded(), "replacement TCP sender failed")
  end)
end

function test_net_cancelled_acceptor_allows_immediate_replacement(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28200)
    support.cleanup_server(context, server)
    const reason = async.CancellationReason.simple("replace TCP acceptor")
    local observed: value = nil
    const old = async.run<|value, value|>(function (): value
      do server:accept() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(old, "old TCP acceptor cleanup")
    while old:status():as_string() == "ready" do timer.yield() end
    test.assert(old:status():as_string() == "waiting", "TCP acceptor did not wait")
    expect_cancelled_net_operation(function () server:accept() end,
                                   "pending TCP acceptor cancellation")
    test.assert(old:status():as_string() == "waiting",
                "cancelled competitor disturbed the TCP acceptor")

    const connector = async.run<|value, value|>(function (): value
      async.join(old)
      const connection = net.connect("127.0.0.1", port)
      defer connection:close()
      connection:write("replacement\0")
      return nil
    end)
    task_support.cleanup_task(connector, "replacement TCP connector cleanup")
    old:cancel(reason)
    test.assert(observed == nil, "old TCP acceptor unwound before replacement")
    -- No join or yield may separate cancellation from this new accept.
    const connection = server:accept()
    support.cleanup_connection(context, connection)
    test.assert(connection:read_until("\0", true) == "replacement",
                "replacement TCP acceptor lost its connection")
    async.join(connector)
    test.assert(old:status():has_cancelled() and observed == reason,
                "old TCP acceptor lost its cancellation reason")
    test.assert(connector:status():has_succeeded(), "replacement connector failed")
  end)
end

function test_net_exchanges_binary_streams_through_tcp(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(26000)
    support.cleanup_server(context, server)
    const peer = async.run<|value, value|>(function (): value
      const connection = server:accept()
      defer connection:close()
      test.assert(connection:read_until("\0END", true) == "alpha",
                  "binary delimiter read returned wrong prefix")
      test.assert(connection:read() == "tail",
                  "delimiter read did not retain excess")
      test.assert(not connection:read(),
                  "peer did not observe client write shutdown")

      connection:write("reply\0\nrest")
      connection:shutdown()
      connection:shutdown()
      support.expect_failure(function ()
        connection:write("late")
      end, "Connection accepted a write after shutdown")
      connection:close()
      connection:close()
      return nil
    end)
    task_support.cleanup_task(peer, "net exchange cleanup")

    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const concrete: stream.ReaderWriterCloser = connection
    concrete:write("alpha\0ENDtail")
    connection:shutdown()
    test.assert(concrete:read_until("\n", true) == "reply\0",
                "binary response delimiter changed")
    test.assert(concrete:read() == "rest",
                "response delimiter excess was lost")
    test.assert(not concrete:read() and not concrete:read_until("missing"),
                "repeated Connection reads did not return EOF")
    concrete:close()
    concrete:close()
    test.assert(not concrete:read() and not concrete:read_until("missing"),
                "closed Connection did not behave as Reader EOF")
    support.expect_failure(function ()
      concrete:write("after-close")
    end, "closed Connection accepted a write")

    while task_support.active(peer) do timer.yield() end
    test.assert(peer:status():as_string() == "succeeded",
                "TCP peer Task failed")
    const closer: stream.Closer = server
    closer:close()
    closer:close()
  end)
end

function test_net_received_chunks_remain_immutable_through_gc_and_cancellation(
    _context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28300)
    support.cleanup_server(_context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(_context, connection)
    const peer = server:accept()
    support.cleanup_connection(_context, peer)
    const first_payload = strings.rep("first\0\255", 20000)
    const second_payload = strings.rep("second\0\128", 20000)
    const sender = async.run<|value, value|>(function (): value
      peer:write(first_payload)
      test.assert(peer:read_until("\n", true) == "next",
                  "TCP receive phases lost their acknowledgement")
      peer:write(second_payload)
      peer:shutdown()
      return nil
    end)
    runtime_test.cleanup(function ()
      sender:cancel(async.CancellationReason.simple("TCP receive sender cleanup"))
      -- Closing retires an accepted write even if an assertion prevented the
      -- receiver from draining the peer's output. Cancellation alone cannot.
      peer:close()
      connection:close()
      async.join(sender)
    end)

    const first_chunks: {string} = {}
    local first_length = 0
    while first_length < #first_payload do
      const chunk? = connection:read()
      if not chunk then raise "TCP first receive phase ended early" end
      first_chunks[#first_chunks + 1] = chunk
      first_length = first_length + #chunk
      gc.collect()
    end
    test.assert(first_length == #first_payload,
                "TCP second receive phase preceded its acknowledgement")

    const reason = async.CancellationReason.simple("cancel between TCP receive phases")
    local observed: value = nil
    const blocked = async.run<|value, value|>(function (): value
      do connection:read() catch observed = error end
      return nil
    end)
    task_support.cleanup_task(blocked, "TCP receive waiter cleanup")
    -- All first-phase bytes were consumed and the sender requires our explicit
    -- acknowledgement before producing more, so this wait cannot finish early.
    while blocked:status():as_string() == "ready" do timer.yield() end
    test.assert(blocked:status():as_string() == "waiting",
                "TCP receive waiter did not suspend between phases")
    blocked:cancel(reason)
    gc.collect()
    gc.collect()
    async.join(blocked)
    local cancelled, actual? = blocked:status():has_cancelled()
    test.assert(cancelled and actual == reason and observed == reason,
                "TCP receive waiter lost its cancellation reason")

    connection:write("next\n")
    const second_chunks: {string} = {}
    while true do
      const chunk? = connection:read()
      if not chunk then break end
      second_chunks[#second_chunks + 1] = chunk
      gc.collect()
    end
    async.join(sender)
    test.assert(sender:status():has_succeeded(), "TCP receive sender failed")
    test.assert(not connection:read(), "TCP receive EOF was not sticky")
    gc.collect()
    gc.collect()

    -- Keep each original chunk until later native receives and EOF have reused
    -- and retired the receive storage. TCP chunk boundaries remain unspecified.
    local first_result, second_result = "", ""
    for index = 1, #first_chunks do first_result = first_result .. first_chunks[index] end
    for index = 1, #second_chunks do second_result = second_result .. second_chunks[index] end
    test.assert(first_result == first_payload and second_result == second_payload,
                "later TCP receives, cancellation, or EOF changed retained binary chunks")
  end)
end

function test_net_overlapping_writes_preserve_bytes_through_gc_and_cancellation(
    _context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28400)
    support.cleanup_server(_context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(_context, connection)
    const peer = server:accept()
    support.cleanup_connection(_context, peer)
    local start_first: (function (nil): ())? = nil
    local start_second: (function (nil): ())? = nil
    local first_piece, second_piece = "first\0\255", "second\0\128"
    const repetitions = 32768
    local first_submitted, second_submitted = false, false
    local first_returned, second_returned = false, false
    local second: async.Task<|value, value|>? = nil
    const first = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        start_first = resolve
      end)
      first_submitted = true
      connection:write(strings.rep(first_piece, repetitions))
      first_returned = true
      return nil
    end)
    runtime_test.cleanup(function ()
      first:cancel(async.CancellationReason.simple("first TCP writer cleanup"))
      if second ~= nil then
        second:cancel(async.CancellationReason.simple("second TCP writer cleanup"))
      end
      -- Cancel before releasing unused gates, so cleanup cannot start a write.
      if start_first ~= nil then
        const release = start_first
        start_first = nil
        release(nil)
      end
      if start_second ~= nil then
        const release = start_second
        start_second = nil
        release(nil)
      end
      -- Retire accepted writes before joining, including when the peer has not
      -- drained enough bytes to let native write callbacks complete normally.
      connection:close()
      peer:close()
      async.join(first)
      if second ~= nil then async.join(second) end
    end)
    second = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        start_second = resolve
      end)
      second_submitted = true
      connection:write(strings.rep(second_piece, repetitions))
      second_returned = true
      return nil
    end)
    while start_first == nil or start_second == nil do timer.yield() end

    const reason = async.CancellationReason.simple("cancel accepted TCP write")
    -- Registration runs outside a Task: settling each gate synchronously
    -- reaches its real write submission before any UV completion can interleave.
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local release_first, release_second = start_first, start_second
      start_first = nil
      release_first(nil)
      start_second = nil
      release_second(nil)
      test.assert(first_submitted and second_submitted and
                  first:status():as_string() == "waiting" and
                  second:status():as_string() == "waiting",
                  "overlapping TCP writes did not both await their callbacks")
      common.assert_raises_contains(function () connection:to_transfer_payload() end,
        "pending operation")
      first:cancel(reason)
      gc.collect()
      gc.collect()
      test.assert(first:status():as_string() == "waiting" and
                  second:status():as_string() == "waiting" and
                  not first_returned and not second_returned,
                  "TCP writes advanced before their completion callbacks")
      resolve(nil)
    end)

    -- Drain while the writes are pending; joining before reading could fill
    -- the socket buffers. Each writer constructed its own temporary payload.
    local received = ""
    while #received < (#first_piece + #second_piece) * repetitions do
      const chunk? = peer:read()
      if not chunk then raise "overlapping TCP writes ended early" end
      received = received .. chunk
      gc.collect()
    end
    async.join(first)
    async.join(second)
    local cancelled, actual? = first:status():has_cancelled()
    test.assert(cancelled and actual == reason and not first_returned,
                "accepted TCP write lost cancellation or returned normally")
    test.assert(second:status():has_succeeded() and second_returned,
                "cancelling one TCP write disturbed the overlapping writer")
    test.assert(received == strings.rep(first_piece, repetitions) ..
                            strings.rep(second_piece, repetitions),
                "overlapping TCP writes changed binary bytes or submission order")
    connection:shutdown()
    test.assert(not peer:read(), "TCP shutdown did not follow the accepted writes")
  end)
end

function test_net_validates_endpoints_and_wakes_pending_accept(
    context: test.Context)
  runtime_test.run(function ()
    support.expect_failure(function ()
      net.connect("", 1)
    end, "connect accepted an empty host")
    support.expect_failure(function ()
      net.connect("127.0.0.1", 0)
    end, "connect accepted port zero")
    support.expect_failure(function ()
      net.connect("127.0.0.1", 65536)
    end, "connect accepted an oversized port")
    support.expect_failure(function ()
      net.listen("", 1, 8)
    end, "listen accepted an empty host")
    support.expect_failure(function ()
      net.listen("127.0.0.1", -1, 8)
    end, "listen accepted a negative port")
    support.expect_failure(function ()
      net.listen("127.0.0.1", 1, 0)
    end, "listen accepted a nonpositive backlog")
    support.expect_failure(function ()
      net.listen("127.0.0.1", 1, 2147483648)
    end, "listen accepted a backlog outside libuv's C-int range")
    support.expect_failure(function ()
      net.listen("127.0.0.1\0ignored", 1, 8)
    end, "listen accepted an embedded-NUL host")

    local server, _ = support.listen_available(27000)
    support.cleanup_server(context, server)
    local accept_failed = false
    const waiter = async.run<|value, value|>(function (): value
      do
        server:accept()
      catch
        const failure = error as async.OperationError
        test.assert(failure.operation == "net.accept",
                    "closed accept reported the wrong operation")
        accept_failed = true
      end
      return nil
    end)
    task_support.cleanup_task(waiter, "pending accept cleanup")
    while waiter:status():as_string() == "ready" do timer.yield() end
    test.assert(waiter:status():as_string() == "waiting",
                "accept Task did not reach its callback wait")
    local competing_accept_rejected = false
    do
      server:accept()
    catch
      competing_accept_rejected = true
    end
    test.assert(competing_accept_rejected,
                "Server accepted a second waiting Task")
    server:close()
    server:close()
    while task_support.active(waiter) do timer.yield() end
    test.assert(waiter:status():as_string() == "succeeded" and accept_failed,
                "Server close did not fail its accept continuation")

    -- Connecting and writing first lets the listener retain one accepted client
    -- until the owning Task asks for it. This is buffered multi-shot state, not
    -- a Titan-side operation queue. The hostname also exercises address
    -- resolution and candidate fallback without assuming address order.
    local buffered_server, buffered_port = support.listen_available(28000)
    support.cleanup_server(context, buffered_server)
    const buffered_client = net.connect("localhost", buffered_port)
    support.cleanup_connection(context, buffered_client)
    buffered_client:write("buffered-client")
    buffered_client:shutdown()
    const buffered_peer = buffered_server:accept()
    support.cleanup_connection(context, buffered_peer)
    test.assert(buffered_peer:read() == "buffered-client" and
                not buffered_peer:read(),
                "Server did not retain its unwaited accepted client")
    buffered_peer:close()
    buffered_client:close()
    buffered_server:close()
  end)
end

function test_net_resolved_address_dialing(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28600)
    support.cleanup_server(context, server)
    const addresses = net.resolve("127.0.0.1", port)
    test.assert(#addresses > 0, "resolver returned no TCP address")
    const address = addresses[1]
    test.assert(address:is_complete() and address:family() == uv.AF_INET and
                address:port() == port and #address:address_bytes() == 4,
                "resolver did not retain an owned address")
    gc.collect()
    const connection = net.Connection()
    support.cleanup_connection(context, connection)
    support.expect_failure(function () connection:read() end,
                           "unconnected endpoint admitted reading")
    support.expect_failure(function () connection:write("") end,
                           "unconnected endpoint admitted writing")
    support.expect_failure(function () connection:shutdown() end,
                           "unconnected endpoint admitted shutdown")
    connection:connect_address(address)
    support.expect_failure(function () connection:connect_address(address) end,
                           "connected endpoint admitted a second connect")
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    peer:write("resolved\0")
    test.assert(connection:read_until("\0", true) == "resolved",
                "address-aware transport lost binary data")
    const fresh = net.Connection()
    fresh:close()
    fresh:close()
    test.assert(fresh:read() == nil, "closed fresh endpoint did not return EOF")
    support.expect_failure(function () fresh:connect_address(address) end,
                           "closed endpoint admitted connect")
  end)
end

function test_net_preowned_connect_close_and_contention(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28700)
    support.cleanup_server(context, server)
    const addresses = net.resolve("127.0.0.1", port)
    const connection = net.Connection()
    support.cleanup_connection(context, connection)
    local observed: value = nil
    local begin_dial: (function (nil): ())? = nil
    const dialer = async.run<|value, value|>(function (): value
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        begin_dial = resolve
      end)
      do connection:connect_address(addresses[1]) catch observed = error end
      return nil
    end)
    task_support.cleanup_task(dialer, "preowned TCP connect cleanup")
    while begin_dial == nil do timer.yield() end
    -- Settling the gate synchronously reaches the native connect wait before
    -- any UV completion can interleave. Resume this owner in the same turn so
    -- a fast loopback connect cannot finish before contention and close.
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      const release = begin_dial
      begin_dial = nil
      release(nil)
      test.assert(dialer:status():as_string() == "waiting" and observed == nil,
                  "TCP dial did not reach its native wait")
      resolve(nil)
    end)
    support.expect_failure(function () connection:connect_address(addresses[1]) end,
                           "endpoint admitted concurrent connect")
    connection:close()
    async.join(dialer)
    test.assert(observed is async.OperationError,
                "closing pending connect did not report a transport error")
  end)
end

function test_net_pending_input_query_preserves_delimiter_suffix(context: test.Context)
  runtime_test.run(function ()
    const unconnected = net.Connection()
    defer unconnected:close()
    test.assert(unconnected:has_pending_input(), "unconnected endpoint appeared reusable")
    local server, port = support.listen_available(28400)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    test.assert(not connection:has_pending_input(), "fresh TCP connection had pending input")
    peer:write("prefix\nsuffix")
    test.assert(connection:read_until("\n", true) == "prefix", "prefix read changed bytes")
    while not connection:has_pending_input() do timer.yield() end
    test.assert(connection:has_pending_input(), "query consumed pending input")
    test.assert(connection:read_until("suffix", true) == "", "query changed pending suffix")
    test.assert(not connection:has_pending_input(), "consumed suffix stayed pending")
    peer:shutdown()
    test.assert(connection:read() == nil, "peer shutdown did not reach EOF")
    test.assert(connection:has_pending_input(), "EOF connection appeared reusable")
    connection:close()
    test.assert(connection:has_pending_input(), "closed connection appeared reusable")
  end)
end

function test_net_input_listeners_observe_without_consuming_or_reserving(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28400)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    local first = 0
    local skipped = 0
    local last = 0
    local outside_task = false
    local remove_second: function (): () = function () end
    const remove_first = connection:add_input_listener(function ()
      first = first + 1
      test.assert(connection:has_pending_input(), "observer ran before buffering input")
      do async.running() catch outside_task = true end
      remove_second()
    end)
    remove_second = connection:add_input_listener(function () skipped = skipped + 1 end)
    const remove_last = connection:add_input_listener(function () last = last + 1 end)
    test.assert(first == 0 and last == 0, "input listener fired during registration")
    peer:write("head\n")
    test.assert(connection:read_until("\n", true) == "head", "observer consumed the reader's bytes")
    test.assert(first > 0 and skipped == 0 and last == first and outside_task,
      "input observer order, removal, or callback context changed")
    const delivered = first
    remove_first()
    remove_first()
    remove_last()
    peer:write("old")
    while not connection:has_pending_input() do timer.yield() end
    local no_replay = 0
    const remove_replay = connection:add_input_listener(function () no_replay = no_replay + 1 end)
    test.assert(no_replay == 0, "registration replayed previously buffered input")
    remove_replay()
    test.assert(connection:read_until("old", false) == "old",
      "registration consumed previously buffered input")
    peer:write("next")
    test.assert(connection:read_until("next", false) == "next" and
        first == delivered and last == delivered and no_replay == 0,
      "removed input listener ran again")
    local terminal = 0
    const remove_terminal = connection:add_input_listener(function () terminal = terminal + 1 end)
    peer:shutdown()
    test.assert(connection:read() == nil and terminal == 1,
      "input listener missed the terminal receive event")
    connection:close()
    remove_terminal()
    test.assert(terminal == 1, "explicit close duplicated an input event")
  end)
end

function test_net_transfer_moves_fresh_connection_across_states(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28500)
    support.cleanup_server(context, server)
    const state = transfer_lua.new()
    defer state:close()
    const operation = function (): async.TransferValue
      const connection = net.connect("127.0.0.1", port)
      defer connection:close()
      -- The native connect callback must retire before moving its endpoint.
      async.yield()
      const packet = async.TransferValue.from_value(connection)
      test.assert(connection:read() == nil, "detached source retained its endpoint")
      return packet
    end
    const packet: async.TransferValue = state:run_async([[
      local operation = ...
      local async = require('titan.async')
      local task = async.run(operation)
      async.loop()
      local success, result = task:status():has_succeeded()
      if not success then
        local failed, failure = task:status():has_failed()
        if failed then failure:raise() end
        error('TCP transfer worker did not succeed')
      end
      return result
    ]], "=net-connection-transfer", async.TransferValue.from_value(operation))
    state:close()
    gc.collect()
    gc.collect()
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    const connection: net.Connection = packet:to_value()
    support.cleanup_connection(context, connection)
    connection:write("new-state\0")
    test.assert(peer:read_until("\0", true) == "new-state")
    peer:write("reply\0")
    test.assert(connection:read_until("\0", true) == "reply")
  end)
end

function test_net_transfer_preserves_input_and_rejects_native_pending_reads(
    context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28600)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    peer:write("prefix\nsuffix\0")
    test.assert(connection:read_until("\n", true) == "prefix")
    peer:write("queued\0")
    timer.sleep(20)
    if common.is_windows() then
      local refused = false
      do connection:to_transfer_payload()
      catch
        test.assert(error is async.OperationError)
        const failure = error as async.OperationError
        test.assert(failure.name == "EBUSY" and failure.operation == "net.transfer")
        refused = true
      end
      test.assert(refused, "pending Windows read was detached")
      test.assert(connection:read_until("\0", true) == "suffix")
      test.assert(connection:read_until("\0", true) == "queued")
      peer:write("still-live\0")
      test.assert(connection:read_until("\0", true) == "still-live")
    else
      const packet = async.TransferValue.from_value(connection)
      const target: net.Connection = packet:to_value()
      support.cleanup_connection(context, target)
      connection:close()
      test.assert(target:has_pending_input())
      test.assert(target:read_until("\0", true) == "suffix")
      test.assert(target:read_until("\0", true) == "queued")
      peer:write("after-transfer\0")
      test.assert(target:read_until("\0", true) == "after-transfer")
    end
  end)
end

function test_net_transfer_rejects_waiters_and_observers_before_detach(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28700)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    const remove = connection:add_input_listener(function () end)
    common.assert_raises_contains(function () connection:to_transfer_payload() end,
      "input observers")
    remove()
    local received = ""
    const reader = async.run<|nil, value|>(function (): nil
      received = connection:read_until("\0", true)
      return nil
    end)
    task_support.cleanup_task(reader, "TCP transfer reader")
    while reader:status():as_string() == "ready" do timer.yield() end
    test.assert(reader:status():as_string() == "waiting")
    common.assert_raises_contains(function () connection:to_transfer_payload() end,
      "pending operation")
    peer:write("original-reader\0")
    async.join(reader)
    test.assert(reader:status():has_succeeded() and received == "original-reader")
  end)
end

function test_net_transfer_rejected_delivery_can_be_recovered(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28800)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    async.yield()
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    const packet = async.TransferValue.from_value(connection)
    const inbox = async.receiver()
    defer inbox:close()
    inbox:close()
    common.assert_raises_contains(function () async.send(inbox:handle(), packet) end,
      "receiver is closed")
    const recovered: net.Connection = packet:to_value()
    support.cleanup_connection(context, recovered)
    recovered:write("recovered\0")
    test.assert(peer:read_until("\0", true) == "recovered")
  end)
end

function test_net_transfer_rejects_malformed_payloads(_context: test.Context)
  common.assert_raises(function () net.Connection.from_transfer_payload("") end)
  common.assert_raises(function ()
    net.Connection.from_transfer_payload("\255")
  end)
end

function test_net_reuse_port_is_opt_in(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28700)
    support.cleanup_server(context, server)
    local observed: value = nil
    do
      const duplicate = net.listen("127.0.0.1", port, nil, false)
      defer duplicate:close()
    catch
      observed = error
    end
    test.assert(observed is async.OperationError,
                "default listener allowed another listener without reuse_port")
    const failure = observed as async.OperationError
    test.assert(failure.name == "EADDRINUSE" and
                failure.operation == "net.listen",
                "exclusive bind lost its native address-in-use error")
  end)
end

function test_net_reuse_port_shares_address(context: test.Context)
  runtime_test.run(function ()
    local first: net.Server? = nil
    local port = 0
    do
      first, port = support.listen_available(28800, true)
    catch
      test.assert(error is async.OperationError,
                  "reuse_port did not preserve its native operation error")
      const failure = error as async.OperationError
      test.assert(failure.name == "ENOTSUP" and failure.code == uv.ENOTSUP and
                  failure.operation == "net.listen",
                  "reuse_port failed with an unexpected native error")
      return
    end
    support.cleanup_server(context, first)
    const second = net.listen("127.0.0.1", port, nil, true)
    support.cleanup_server(context, second)
    first:close()
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = second:accept()
    support.cleanup_connection(context, peer)
    connection:write("survivor\0")
    test.assert(peer:read_until("\0", true) == "survivor",
                "closing one reused listener stopped the other listener")
  end)
end

function test_net_transfer_hooks_run_without_a_current_task(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28900)
    support.cleanup_server(context, server)
    const source = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, source)
    async.yield()
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    local target: net.Connection? = nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local outside_task = false
      do async.running() catch outside_task = true end
      test.assert(outside_task, "transfer fixture still ran in a Task")
      const packet = async.TransferValue.from_value(source)
      target = packet:to_value()
      resolve(nil)
    end)
    support.cleanup_connection(context, target)
    source:close()
    target:write("callback-handoff\0")
    test.assert(peer:read_until("\0", true) == "callback-handoff")
  end)
end

function test_net_demand_read_policy_survives_handoff(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(28900)
    support.cleanup_server(context, server)
    const source = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, source)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    test.assert(source:read_ahead(), "TCP read-ahead did not default to enabled")
    test.assert(source:read_ahead(false), "TCP read-ahead setter lost the previous policy")
    test.assert(not source:read_ahead() and not source:read_ahead(false))
    peer:write("prefix\nsuffix\0")
    test.assert(source:read_until("\n", true) == "prefix")
    common.assert_raises_contains(function () source:read_ahead(true) end,
      "reading has started")
    -- Move only after the read callback's native request has retired.
    async.yield()
    const payload = source:to_transfer_payload()
    const target = net.Connection.from_transfer_payload(payload)
    support.cleanup_connection(context, target)
    test.assert(not target:read_ahead(), "TCP handoff lost demand-read policy")
    common.assert_raises_contains(function () target:read_ahead(true) end,
      "reading has started")
    test.assert(target:read_until("\0", true) == "suffix", "handoff lost delimiter excess")
    -- Consuming transferred excess must not restart an idle native reader.
    async.yield()
    const worker_payload = target:to_transfer_payload()
    const worker = thread.spawn_one(function (bytes: string): string
      const connection = net.Connection.from_transfer_payload(bytes)
      defer connection:close()
      test.assert(not connection:read_ahead(), "thread handoff enabled read-ahead")
      test.assert(connection:read_until("\0", true) == "worker")
      connection:write("reply\0")
      return "finished"
    end, worker_payload)
    runtime_test.cleanup(function () worker:cancel(); worker:join() end)
    peer:write("worker\0")
    test.assert(peer:read_until("\0", true) == "reply", "thread handoff lost its live socket")
    case worker:join()
    when succeeded(result) then test.assert(result == "finished")
    when failed(failure) then failure:raise()
    else raise "demand-read TCP worker did not succeed"
    end
  end)
end

function test_net_demand_reader_cancellation_allows_replacement(context: test.Context)
  runtime_test.run(function ()
    local server, port = support.listen_available(29000)
    support.cleanup_server(context, server)
    const connection = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, connection)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    connection:read_ahead(false)
    const reader = async.run<|nil, value|>(function (): nil
      connection:read()
      return nil
    end)
    task_support.cleanup_task(reader, "demand TCP cancelled reader")
    while reader:status():as_string() == "ready" do timer.yield() end
    test.assert(reader:status():as_string() == "waiting")
    reader:cancel()
    const writer = async.run<|nil, value|>(function (): nil
      async.join(reader)
      peer:write("replacement\0tail")
      peer:shutdown()
      return nil
    end)
    task_support.cleanup_task(writer, "demand TCP replacement writer")
    test.assert(connection:read_until("\0", true) == "replacement")
    test.assert(connection:read() == "tail")
    test.assert(connection:read() == nil, "demand TCP reader did not observe EOF")
    test.assert(connection:read() == nil, "demand TCP reader restarted after EOF")
    async.join(writer)
    test.assert(reader:status():has_cancelled() and writer:status():has_succeeded())
  end)
end

-- An unavailable IPv6 loopback is an environment limitation, not a failure.
local function listen_ipv6_loopback(): net.Server
  return net.listen("::1", 0)
catch
  if error is async.OperationError then
    const name = (error as async.OperationError).name
    if name == "EADDRNOTAVAIL" or name == "EAFNOSUPPORT" then
      test.skip("capability: IPv6 loopback is unavailable (" .. name .. ")")
    end
  end
  raise
end

local function expect_endpoint(address: net.Address, ip: string, ipv6: boolean, label: string)
  test.assert(address.ip == ip and address.ipv6 == ipv6 and address.scope_id == 0,
              label .. " reported " .. address.ip)
  test.assert(address.port > 0 and address.port <= 65535,
              label .. " reported port " .. address.port)
end

-- An OS-assigned listener port is discoverable, and each endpoint is queried
-- once and then cached on its live owner.
local function check_loopback_addresses(context: test.Context, server: net.Server,
                                        ip: string, ipv6: boolean)
  support.cleanup_server(context, server)
  const bound = server:local_address()
  expect_endpoint(bound, ip, ipv6, "listener")
  test.assert(server:local_address() == bound, "listener address was not cached")
  const client = net.connect(ip, bound.port)
  support.cleanup_connection(context, client)
  const peer = server:accept()
  support.cleanup_connection(context, peer)
  const client_local = client:local_address()
  const client_peer = client:peer_address()
  expect_endpoint(client_local, ip, ipv6, "client local endpoint")
  expect_endpoint(client_peer, ip, ipv6, "client peer endpoint")
  test.assert(client_peer.port == bound.port, "client peer is not the listener port")
  test.assert(client:local_address() == client_local and client:peer_address() == client_peer,
              "connection addresses were not cached")
  test.assert(peer:local_address().port == bound.port, "accepted local port differs from listener")
  test.assert(peer:peer_address().port == client_local.port and peer:peer_address().ip == ip,
              "accepted peer is not the client endpoint")
  client:close()
  server:close()
  test.assert(client_local.ip == ip and client_local.port > 0 and bound.port > 0,
              "an address snapshot changed after close")
  common.assert_raises_contains(function () client:local_address() end,
    "cannot query local address of a closed TCP resource")
  common.assert_raises_contains(function () client:peer_address() end,
    "cannot query peer address of a closed TCP resource")
  common.assert_raises_contains(function () server:local_address() end,
    "cannot query local address of a closed TCP resource")
end

function test_net_socket_addresses(context: test.Context)
  context:run("ipv4", function (child: test.Context)
    runtime_test.run(function ()
      check_loopback_addresses(child, net.listen("127.0.0.1", 0), "127.0.0.1", false)
    end)
  end)
  context:run("ipv6", function (child: test.Context)
    runtime_test.run(function ()
      check_loopback_addresses(child, listen_ipv6_loopback(), "::1", true)
    end)
  end)
end

function test_net_socket_address_rejections(context: test.Context)
  local earlier: net.Server? = nil
  runtime_test.run(function ()
    const fresh = net.Connection()
    support.cleanup_connection(context, fresh)
    common.assert_raises_contains(function () fresh:local_address() end,
      "cannot query local address of an unconnected TCP Connection")
    common.assert_raises_contains(function () fresh:peer_address() end,
      "cannot query peer address of an unconnected TCP Connection")

    const server = net.listen("127.0.0.1", 0)
    support.cleanup_server(context, server)
    earlier = server
    const port = server:local_address().port
    const source = net.connect("127.0.0.1", port)
    support.cleanup_connection(context, source)
    const peer = server:accept()
    support.cleanup_connection(context, peer)
    const source_local = source:local_address()
    -- The native connect callback must retire before moving its endpoint.
    async.yield()
    const packet = async.TransferValue.from_value(source)
    common.assert_raises_contains(function () source:local_address() end,
      "cannot query local address of a closed TCP resource")
    common.assert_raises_contains(function () source:peer_address() end,
      "cannot query peer address of a closed TCP resource")
    const target: net.Connection = packet:to_value()
    support.cleanup_connection(context, target)
    const target_local = target:local_address()
    test.assert(target_local ~= source_local and target_local.port == source_local.port,
                "adopted connection did not query its own live socket")
    test.assert(target:peer_address().port == port, "adopted connection lost its peer")
    target:write("adopted\0")
    test.assert(peer:read_until("\0", true) == "adopted")
  end)
  runtime_test.run(function ()
    common.assert_raises_contains(function () earlier:local_address() end,
      "TCP resource belongs to a different async Runtime")
  end)
end

-- The kernel option of a connection's own live socket.
local function no_delay_of(connection: net.Connection): integer
  return owned_tcp.kernel_no_delay(connection:local_address().port,
                                   connection:peer_address().port)
end

local function connected_pair(context: test.Context, server: net.Server): (net.Connection, net.Connection)
  const client = net.connect("127.0.0.1", server:local_address().port)
  support.cleanup_connection(context, client)
  const peer = server:accept()
  support.cleanup_connection(context, peer)
  return client, peer
end

-- The adopted socket keeps the source's kernel option across a thread
-- handoff and still accepts toggling there.
local function check_thread_preserves_no_delay(context: test.Context, server: net.Server,
                                               enabled: boolean)
  local source, peer = connected_pair(context, server)
  source:set_no_delay(enabled)
  local expected = 0
  if enabled then expected = 1 end
  test.assert(no_delay_of(source) == expected)
  async.yield()
  const payload = source:to_transfer_payload()
  const worker = thread.spawn_one(function (bytes: string): string
    const connection = net.Connection.from_transfer_payload(bytes)
    defer connection:close()
    const local_port = connection:local_address().port
    const peer_port = connection:peer_address().port
    const adopted = owned_tcp.kernel_no_delay(local_port, peer_port)
    connection:set_no_delay(not enabled)
    const toggled = owned_tcp.kernel_no_delay(local_port, peer_port)
    connection:write("moved\0")
    return strings.tostring(adopted) .. "," .. strings.tostring(toggled)
  end, payload)
  runtime_test.cleanup(function () worker:cancel(); worker:join() end)
  test.assert(peer:read_until("\0", true) == "moved", "thread handoff lost its live socket")
  const wanted = strings.tostring(expected) .. "," .. strings.tostring(1 - expected)
  case worker:join()
  when succeeded(result) then
    test.assert(result == wanted, "thread handoff observed TCP_NODELAY " .. result ..
                ", expected " .. wanted)
  when failed(failure) then failure:raise()
  else raise "TCP_NODELAY transfer worker did not succeed"
  end
end

function test_net_no_delay_kernel_option(context: test.Context)
  context:run("dialed_and_accepted_default_on", function (child: test.Context)
    runtime_test.run(function ()
      const server = net.listen("127.0.0.1", 0)
      support.cleanup_server(child, server)
      local client, peer = connected_pair(child, server)
      test.assert(no_delay_of(client) == 1, "dialed connection lacked TCP_NODELAY")
      test.assert(no_delay_of(peer) == 1, "accepted connection lacked TCP_NODELAY")
    end)
  end)
  context:run("pre_dial_opt_out", function (child: test.Context)
    runtime_test.run(function ()
      const server = net.listen("127.0.0.1", 0)
      support.cleanup_server(child, server)
      const address = net.resolve("127.0.0.1", server:local_address().port)[1]
      const client = net.Connection()
      support.cleanup_connection(child, client)
      client:set_no_delay(false)
      client:connect_address(address)
      const peer = server:accept()
      support.cleanup_connection(child, peer)
      test.assert(no_delay_of(client) == 0, "pre-dial opt-out did not reach the socket")
      test.assert(no_delay_of(peer) == 1, "accepted connection lacked TCP_NODELAY")
    end)
  end)
  context:run("post_connect_toggles", function (child: test.Context)
    runtime_test.run(function ()
      const server = net.listen("127.0.0.1", 0)
      support.cleanup_server(child, server)
      local client, peer = connected_pair(child, server)
      client:set_no_delay(false)
      peer:set_no_delay(false)
      test.assert(no_delay_of(client) == 0 and no_delay_of(peer) == 0)
      client:set_no_delay(true)
      peer:set_no_delay(true)
      test.assert(no_delay_of(client) == 1 and no_delay_of(peer) == 1)
      client:write("still-live\0")
      test.assert(peer:read_until("\0", true) == "still-live")
    end)
  end)
  context:run("thread_preserves_off", function (child: test.Context)
    runtime_test.run(function ()
      const server = net.listen("127.0.0.1", 0)
      support.cleanup_server(child, server)
      check_thread_preserves_no_delay(child, server, false)
    end)
  end)
  context:run("thread_preserves_on", function (child: test.Context)
    runtime_test.run(function ()
      const server = net.listen("127.0.0.1", 0)
      support.cleanup_server(child, server)
      check_thread_preserves_no_delay(child, server, true)
    end)
  end)
end

function test_net_no_delay_rejections(context: test.Context)
  local earlier: net.Connection? = nil
  runtime_test.run(function ()
    const server = net.listen("127.0.0.1", 0)
    support.cleanup_server(context, server)
    const port = server:local_address().port
    const address = net.resolve("127.0.0.1", port)[1]

    const dialing = net.Connection()
    support.cleanup_connection(context, dialing)
    const connector = async.run<|nil, value|>(function (): nil
      dialing:connect_address(address)
      return nil
    end)
    task_support.cleanup_task(connector, "TCP_NODELAY dialing connector")
    -- The connector submits its dial and waits before this Task resumes.
    async.yield()
    test.assert(connector:status():as_string() == "waiting", "dial did not wait for its callback")
    common.assert_raises_contains(function () dialing:set_no_delay(false) end,
      "cannot configure no-delay while TCP connect is in progress")
    async.join(connector)
    const accepted = server:accept()
    support.cleanup_connection(context, accepted)
    earlier = dialing

    const closed_port = net.listen("127.0.0.1", 0)
    const refused_port = closed_port:local_address().port
    closed_port:close()
    const failed = net.Connection()
    support.cleanup_connection(context, failed)
    support.expect_failure(function ()
      failed:connect_address(net.resolve("127.0.0.1", refused_port)[1])
    end, "dial to a closed loopback port succeeded")
    common.assert_raises_contains(function () failed:set_no_delay(true) end,
      "cannot configure no-delay on a failed TCP Connection")

    local source, _ = connected_pair(context, server)
    async.yield()
    const payload = source:to_transfer_payload()
    const target = net.Connection.from_transfer_payload(payload)
    support.cleanup_connection(context, target)
    common.assert_raises_contains(function () source:set_no_delay(true) end,
      "cannot configure no-delay on a closed TCP resource")
    target:close()
    common.assert_raises_contains(function () target:set_no_delay(true) end,
      "cannot configure no-delay on a closed TCP resource")
  end)
  runtime_test.run(function ()
    common.assert_raises_contains(function () earlier:set_no_delay(true) end,
      "TCP resource belongs to a different async Runtime")
  end)
end
