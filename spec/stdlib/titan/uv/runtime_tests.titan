function test_parent_tcp_stdio_classification_shutdown_and_inheritance(
    _context: test.Context)
  if ffi.titan_uv_test_stdio_mode_supported(ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL as integer) == 0 then
    test.skip("platform: connected TCP parent stdio is supported on Linux and macOS")
  end
  with_stdio_fixture(function (workspace: string)
    assert_stdio_fixture(
      workspace, "tcp", "parent-tcp-ok",
      ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL, 7,
      "tcp-stdout", "tcp-stderr")
    assert_stdio_fixture(
      workspace, "inherit", "parent-inheritance-ok",
      ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL, 0,
      "", "")
  end)
end

function test_parent_socket_stdio_rejection_does_not_leak(
    _context: test.Context)
  if ffi.titan_uv_test_stdio_mode_supported(ffi.TITAN_UV_TEST_STDIO_SOCKET_STDOUT as integer) == 0 then
    test.skip("platform: Windows standard handles do not represent Unix socket descriptors")
  end
  with_stdio_fixture(function (workspace: string)
    assert_stdio_fixture(
      workspace, "tcp-unconnected", "parent-tcp-unconnected-rejected",
      ffi.TITAN_UV_TEST_STDIO_SOCKET_STDOUT, 0, "", "")
    assert_stdio_fixture(
      workspace, "tcp-listener", "parent-tcp-listener-rejected",
      ffi.TITAN_UV_TEST_STDIO_TCP_LISTENER_STDOUT, 0, "", "")
    assert_stdio_fixture(
      workspace, "udp-unconnected", "parent-udp-unconnected-rejected",
      ffi.TITAN_UV_TEST_STDIO_INET_DATAGRAM_STDOUT, 0, "", "")
    assert_stdio_fixture(
      workspace, "udp-connected", "parent-udp-connected-rejected",
      ffi.TITAN_UV_TEST_STDIO_INET_CONNECTED_DATAGRAM_STDOUT, 0, "", "")
  end)
end

function test_parent_windows_socket_stdio_rejection_preserves_pipes(
    _context: test.Context)
  if ffi.titan_uv_test_stdio_windows_child_sockets_supported() == 0 then
