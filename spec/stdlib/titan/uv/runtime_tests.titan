function test_parent_stdio_hints_preserve_known_descriptor_kinds(
    context: test.Context)
  context:run("pipe", function (_context: test.Context)
    with_stdio_fixture(function (workspace: string)
      assert_stdio_fixture(workspace, "pipes", "parent-pipes-ok",
        ffi.TITAN_UV_TEST_STDIO_PIPE_ALL, 7,
        "pipe-stdout", "pipe-stderr", "invalid")
    end)
  end)
  context:run("tty", function (_context: test.Context)
    with_stdio_fixture(function (workspace: string)
      assert_stdio_fixture(workspace, "tty", "parent-tty-ok",
        ffi.TITAN_UV_TEST_STDIO_TTY_SLAVE, 0, "tty-output", "", "1")
    end)
  end)
  context:run("regular_file", function (_context: test.Context)
    with_stdio_fixture(function (workspace: string)
      assert_stdio_fixture(workspace, "file", "parent-file-ok",
        ffi.TITAN_UV_TEST_STDIO_FILE_STDOUT, 0, "file-output", "", "1")
    end)
  end)
  context:run("connected_tcp", function (_context: test.Context)
    if ffi.titan_uv_test_stdio_mode_supported(ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL as integer) == 0 then
      test.skip("platform: connected TCP parent stdio is supported on Linux and macOS")
    end
    with_stdio_fixture(function (workspace: string)
      assert_stdio_fixture(workspace, "tcp", "parent-tcp-ok",
        ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL, 7,
        "tcp-stdout", "tcp-stderr", "invalid")
    end)
  end)
  local modes: {integer} = {
    ffi.TITAN_UV_TEST_STDIO_SOCKET_STDOUT,
    ffi.TITAN_UV_TEST_STDIO_TCP_LISTENER_STDOUT,
    ffi.TITAN_UV_TEST_STDIO_INET_DATAGRAM_STDOUT,
    ffi.TITAN_UV_TEST_STDIO_INET_CONNECTED_DATAGRAM_STDOUT,
    ffi.TITAN_UV_TEST_STDIO_UNIX_DATAGRAM_STDOUT,
  }
  local names = {
    "inet_stream", "inet_listener", "inet_datagram",
    "inet_connected_datagram", "unix_datagram",
  }
  for index = 1, #modes do
    local mode = modes[index]
    context:run(names[index], function (_context: test.Context)
      if ffi.titan_uv_test_stdio_mode_supported(mode) == 0 then
        test.skip("platform: Windows standard handles do not represent Unix socket descriptors")
      end
      with_stdio_fixture(function (workspace: string)
        assert_stdio_fixture(workspace, "socket", "parent-socket-rejected",
          mode, 0, "", "", "1")
      end)
    end)
  end
end

function test_parent_closed_stdio_reports_ebadf_without_leaking(
    _context: test.Context)
  with_stdio_fixture(function (workspace: string)
    assert_stdio_fixture(workspace, "closed", "parent-closed-rejected",
      ffi.TITAN_UV_TEST_STDIO_PIPE_ALL, 0, "", "", "1")
  end)
end

function test_parent_denied_unix_stdio_uses_only_valid_per_fd_pipe_hints(
    _context: test.Context)
  if ffi.titan_uv_test_stdio_metadata_denial_supported() == 0 then
    test.skip("platform: stdio metadata denial requires the Linux x86_64 or aarch64 seccomp fixture")
  end
  with_stdio_fixture(function (workspace: string)
    local sockets = ffi.TITAN_UV_TEST_STDIO_UNIX_STREAM_ALL
    assert_stdio_fixture(workspace, "denied-pipes", "parent-pipes-ok",
      sockets, 7, "pipe-stdout", "pipe-stderr", "0,1,2")
    assert_stdio_fixture(workspace, "denied-pipes-access", "parent-pipes-ok",
      sockets, 7, "pipe-stdout", "pipe-stderr", "0,1,2")
    assert_stdio_fixture(workspace, "denied-stdin", "parent-stdin-ok",
      sockets, 1, "", "", "0")
    assert_stdio_fixture(workspace, "denied-stdout", "parent-stdout-ok",
      sockets, 2, "pipe-stdout", "", "1")
    assert_stdio_fixture(workspace, "denied-stderr", "parent-stderr-ok",
      sockets, 4, "", "pipe-stderr", "2")
    assert_stdio_fixture(workspace, "denied-reject", "parent-denied-rejected",
      sockets, 0, "", "")
    local invalid_hints = {"0,2", "", "01", "1 ", "1,9", "1,,2", "1,", "10"}
    for index = 1, #invalid_hints do
      assert_stdio_fixture(workspace, "denied-reject", "parent-denied-rejected",
        sockets, 0, "", "", invalid_hints[index])
    end
  end)
end

function test_parent_partial_metadata_denial_preserves_socket_contradictions(
    _context: test.Context)
  if ffi.titan_uv_test_stdio_metadata_denial_supported() == 0 then
    test.skip("platform: stdio metadata denial requires the Linux x86_64 or aarch64 seccomp fixture")
  end
  with_stdio_fixture(function (workspace: string)
    local sockets = ffi.TITAN_UV_TEST_STDIO_UNIX_STREAM_ALL
    assert_stdio_fixture(workspace, "deny-name-stdout", "parent-stdout-ok",
      sockets, 2, "pipe-stdout", "", "1")
    assert_stdio_fixture(workspace, "deny-type-stdout", "parent-stdout-ok",
      sockets, 2, "pipe-stdout", "", "1")
    assert_stdio_fixture(workspace, "deny-name-reject", "parent-contradiction-rejected",
      ffi.TITAN_UV_TEST_STDIO_UNIX_DATAGRAM_STDOUT, 0, "", "", "1")
    assert_stdio_fixture(workspace, "deny-type-reject", "parent-contradiction-rejected",
      ffi.TITAN_UV_TEST_STDIO_SOCKET_STDOUT, 0, "", "", "1")
    assert_stdio_fixture(workspace, "deny-type-reject", "parent-contradiction-rejected",
      ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL, 0, "", "", "1")
    assert_stdio_fixture(workspace, "deny-peer-reject", "parent-peer-denied-rejected",
      ffi.TITAN_UV_TEST_STDIO_TCP_CONNECTED_ALL, 0, "", "", "1")
  end)
end

function test_parent_stdio_denial_renders_operation_error_fields(
    _context: test.Context)
  if ffi.titan_uv_test_stdio_metadata_denial_supported() == 0 then
    test.skip("platform: stdio metadata denial requires the Linux x86_64 or aarch64 seccomp fixture")
  end
  with_stdio_fixture(function (workspace: string)
    assert_stdio_fixture(workspace, "denied-diagnostic", "parent-denied-diagnostic",
      ffi.TITAN_UV_TEST_STDIO_UNIX_STREAM_ALL, 0, "",
      "uncaught error in async Task: stdio.parent.kind: EPERM (-1): fd 1: getsockname",
      nil, true)
  end)
end
