function test_caught_cancellation_remains_authoritative(
    context: test.Context)
  runtime_test.run(function ()
    local returned = async.run<|value, value|>(function (): value
      do
        timer.sleep(60000)
      catch
        return "caught cancellation"
      end
      return "unexpected return"
    end)
    task_support.cleanup_task(returned, "caught-return Task cleanup")
    local replaced = async.run<|value, value|>(function (): value
      do
        timer.sleep(60000)
      catch
        raise "replacement failure"
      end
      return "unexpected return"
    end)
    task_support.cleanup_task(replaced, "caught-raise Task cleanup")

    while returned:status():as_string() == "ready" or
          replaced:status():as_string() == "ready" do
      timer.yield()
    end
    returned:cancel(async.CancellationReason.simple(
      "return path cancellation"))
    replaced:cancel(async.CancellationReason.simple(
      "raise path cancellation"))
    support.wait_finished(returned)
    support.wait_finished(replaced)

    test.assert(returned:status():as_string() == "cancelled",
                "caught return replaced pending cancellation")
    test.assert(replaced:status():as_string() == "cancelled",
                "caught raise replaced pending cancellation")
    test.assert(support.simple_cancellation_reason(returned) ==
                "return path cancellation",
                "caught return changed the cancellation reason")
    test.assert(support.simple_cancellation_reason(replaced) ==
                "raise path cancellation",
                "caught raise changed the cancellation reason")
  end)
end

function test_cancellation_shields_file_cleanup_calls(
    context: test.Context)
  runtime_test.run(function ()
    local first_path = support.temporary_file(context)
    local second_path = support.temporary_file(context)
    local first_file: fs.File? = nil
    local second_file: fs.File? = nil
    local cleanup_progress = 0
    local task: async.Task? = nil

    task = async.run<|value, value|>(function (): value
      local first = fs.open(first_path, "w")
      local second = fs.open(second_path, "w")
      first_file = first
      second_file = second
      defer do
        first:close()
        cleanup_progress = 1
        second:close()
        cleanup_progress = 2
      end

      (task as async.Task):cancel(
        async.CancellationReason.simple("cleanup cancellation"))
      -- This cancellation-sensitive Call must not be submitted. Unwinding still
      -- dispatches both cancellation-insensitive closes above.
      first:write("cancelled write was submitted")
      return nil
    end)
    task_support.cleanup_task(task as async.Task, "file cleanup Task cleanup")

    support.wait_finished(task as async.Task)
    test.assert((task as async.Task):status():as_string() == "cancelled",
                "cleanup Task did not retain pending cancellation")
    test.assert(support.simple_cancellation_reason(task as async.Task) ==
                "cleanup cancellation",
                "cleanup Task changed its cancellation reason")
    test.assert(cleanup_progress == 2,
                "cancellation did not complete both deferred closes")
    test.assert(first_file ~= nil and second_file ~= nil and
                (first_file as fs.File):is_closed() and
                (second_file as fs.File):is_closed(),
                "deferred cleanup left a File open")
    test.assert(fs.read_file(first_path) == "" and
                fs.read_file(second_path) == "",
                "pending cancellation submitted the protected write")
  end)
end

function test_cancellation_crosses_close_callback(
    context: test.Context)
  runtime_test.run(function ()
    local close_started = false
    local close_finished = false
    local target = async.run<|value, value|>(function (): value
      local ticker = timer.ticker(60000)
      close_started = true
      ticker:close()
      close_finished = true
      return nil
    end)
    task_support.cleanup_task(target, "close target cleanup")
    local canceller = async.run<|value, value|>(function (): value
      while not close_started do timer.yield() end
      target:cancel(async.CancellationReason.simple(
        "close callback cancellation"))
      return nil
    end)
    task_support.cleanup_task(canceller, "close canceller cleanup")

    support.wait_finished(canceller)
    support.wait_finished(target)
    test.assert(canceller:status():as_string() == "succeeded",
                "close cancellation controller failed")
    test.assert(target:status():as_string() == "cancelled",
                "close callback lost pending cancellation")
    test.assert(support.simple_cancellation_reason(target) ==
                "close callback cancellation",
                "close callback changed the cancellation reason")
    test.assert(close_finished,
                "cancellation interrupted ownership-retiring close completion")
  end)
end

function test_suspend_cancellation_action_is_synchronous_and_specific(
    context: test.Context)
  runtime_test.run(function ()
    local cancel_entered = false
    local cancel_actions = 0
    local cancel_token =
      async.ResumeToken.new("suspend cancellation test")
    local cancelled = async.run<|value, value|>(function (): value
      cancel_entered = true
      async.suspend(cancel_token, function ()
        cancel_actions = cancel_actions + 1
      end)
      return nil
    end)
    task_support.cleanup_task(cancelled,
                              "suspend cancellation-action cleanup")
    while not cancel_entered do timer.yield() end
    cancelled:cancel(async.CancellationReason.simple(
        "cancel explicit suspend"))
    test.assert(cancel_actions == 1,
                "suspend cancellation action was not synchronous")
    async.join(cancelled)
    test.assert(cancelled:status():has_cancelled() and
                cancel_actions == 1,
                "suspend cancellation action ran more than once")

    local resume_entered = false
    local resume_actions = 0
    local resume_token =
      async.ResumeToken.new("ordinary resume cancellation test")
    local resumed = async.run<|value, value|>(function (): value
      resume_entered = true
      async.suspend(resume_token, function ()
        resume_actions = resume_actions + 1
      end)
      return nil
    end)
    task_support.cleanup_task(resumed, "suspend resume cleanup")
    while not resume_entered do timer.yield() end
    resumed:resume(resume_token)
    async.join(resumed)
    test.assert(resumed:status():has_succeeded() and
                resume_actions == 0,
                "ordinary resume ran the suspend cancellation action")
  end)
end
