foreign import "abandon_process_probe.h"

local function assert_abandoned(loop: uv.loop_t, calls: integer)
  test.assert(calls == 0, "abandonment delivered a user callback")
  test.assert(uv.loop_close(loop) == uv.EINVAL and not uv.loop_alive(loop),
    "abandonment left the native loop initialized")
end

function test_loop_abandon_retires_streams_and_connect_write_requests(_: test.Context)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  local reader, writer = open_pipe_pair(loop)
  success(uv.read_start(reader:as_stream_t(),
    function (_handle: uv.handle_t, _suggested: integer): uv.buf_t
      calls = calls + 1
      return uv.buf_t.allocate(64)
    end,
    function (_stream: uv.stream_t, _count: integer, _buffer: uv.buf_t?) calls = calls + 1 end))
  const written = uv.write_t()
  success(uv.write_string(written, writer:as_stream_t(), strings.rep("abandon\0", 32768),
    function (_request: uv.write_t, _status: integer) calls = calls + 1 end))
  test.assert(written:handle() ~= nil)

  local listener, client = uv.tcp_t(), uv.tcp_t()
  success(uv.tcp_init(loop, listener))
  success(uv.tcp_init(loop, client))
  local address_status, address? = uv.ip4_addr("127.0.0.1", 0)
  success(address_status)
  success(uv.tcp_bind(listener, address, 0))
  success(uv.listen(listener:as_stream_t(), 1,
    function (_stream: uv.stream_t, _status: integer) calls = calls + 1 end))
  local name_status, actual? = uv.tcp_getsockname(listener)
  success(name_status)
  const connected = uv.connect_t()
  success(uv.tcp_connect(connected, client, actual,
    function (_request: uv.connect_t, _status: integer) calls = calls + 1 end))
  test.assert(connected:handle() ~= nil)
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not reader:as_handle_t():is_initialized() and
    not writer:as_handle_t():is_initialized() and
    not listener:as_handle_t():is_initialized() and
    not client:as_handle_t():is_initialized(), "abandonment retained stream owners")
end

function test_loop_abandon_retires_udp_receive_and_send(_: test.Context)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  local received = 0
  local receiver, address = bound(loop, 0)
  const sender = uv.udp_t()
  success(uv.udp_init(loop, sender))
  success(uv.udp_recv_start(receiver,
    function (_handle: uv.handle_t, _suggested: integer): uv.buf_t
      calls = calls + 1
      return uv.buf_t.allocate(64)
    end,
    function (_handle: uv.udp_t, _count: integer, _buffer: uv.buf_t?,
              peer: uv.sockaddr_t?, _flags: integer)
      calls = calls + 1
      if peer ~= nil then received = received + 1 end
    end))
  const sent = uv.udp_send_t()
  success(uv.udp_send(sent, sender, {uv.buf_t.from_string("abandon\0")}, address,
    function (_request: uv.udp_send_t, _status: integer) calls = calls + 1 end))
  coverage_mc_deadline(loop)
  while received == 0 do uv.run(loop, uv.RUN_ONCE) end
  test.assert(received == 1, "the UDP handle never delivered before abandonment")
  const before = calls
  uv.close(receiver:as_handle_t(), function (_: uv.handle_t) calls = calls + 1 end)
  success(uv.udp_send(uv.udp_send_t(), sender, {uv.buf_t.from_string("retire")}, address,
    function (_request: uv.udp_send_t, _status: integer) calls = calls + 1 end))
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls - before)
  test.assert(not receiver:as_handle_t():is_initialized() and
    not sender:as_handle_t():is_initialized(), "abandonment retained UDP owners")
end

function test_loop_abandon_retires_signal_watcher(_: test.Context)
  if uv.SIGINT == nil then test.skip("capability: SIGINT is unavailable") end
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  const signal = uv.signal_t()
  success(uv.signal_init(loop, signal))
  success(uv.signal_start(signal,
    function (_handle: uv.signal_t, _signum: integer) calls = calls + 1 end, uv.SIGINT))
  test.assert(uv.is_active(signal:as_handle_t()))
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not signal:as_handle_t():is_initialized(),
    "abandonment retained the signal watcher")
end

function test_loop_abandon_retires_process_without_exit_delivery(_: test.Context)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  const output = fresh_pipe(loop)
  const process = uv.process_t()
  const options = exit_options(output, nil)
  options.exit_cb = function (_owner: uv.process_t, _status: integer, _signal: integer)
    calls = calls + 1
  end
  success(uv.spawn(loop, process, options))
  const pid = uv.process_get_pid(process)
  -- Native watcher close does not kill or reap an application-owned child.
  defer do
    success(uv.loop_abandon(loop))
    success(ffi.titan_uv_abandon_reap(pid))
  end
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not process:as_handle_t():is_initialized() and
    not output:as_handle_t():is_initialized(), "abandonment retained process owners")
end

function test_loop_abandon_retires_filesystem_event_watcher(_: test.Context)
  const directory = coverage_fs_directory()
  defer coverage_fs_remove(directory, true)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  const watcher = uv.fs_event_t()
  success(uv.fs_event_init(loop, watcher))
  const status = uv.fs_event_start(watcher,
    function (_owner: uv.fs_event_t, _path: string?, _events: integer, _status: integer)
      calls = calls + 1
    end, directory, 0)
  if status == uv.ENOSYS or status == uv.ENOTSUP then
    test.skip("capability: filesystem events are unavailable")
  end
  success(status)
  test.assert(uv.is_active(watcher:as_handle_t()))
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not watcher:as_handle_t():is_initialized())
end

function test_loop_abandon_retires_filesystem_poll_and_pending_stat(_: test.Context)
  const path = fixture_file()
  defer remove_file(path)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  const watcher = uv.fs_poll_t()
  success(uv.fs_poll_init(loop, watcher))
  success(uv.fs_poll_start(watcher,
    function (_owner: uv.fs_poll_t, _status: integer, _previous: uv.stat_t?, _current: uv.stat_t?)
      calls = calls + 1
    end, path, 1))
  test.assert(uv.is_active(watcher:as_handle_t()))
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not watcher:as_handle_t():is_initialized())
end

function test_loop_abandon_retires_socket_poll(_: test.Context)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local status, left?, right? = uv.socketpair(uv.SOCK_STREAM, 0,
    uv.NONBLOCK_PIPE, uv.NONBLOCK_PIPE)
  success(status)
  local writer, reader = uv.tcp_t(), uv.tcp_t()
  success(uv.tcp_init(loop, writer))
  success(uv.tcp_init(loop, reader))
  success(uv.tcp_open(writer, left))
  success(uv.tcp_open(reader, right))
  const poll = uv.poll_t()
  success(uv.poll_init_socket(loop, poll, right))
  local calls = 0
  success(uv.poll_start(poll,
    function (_owner: uv.poll_t, _status: integer, _events: integer)
      calls = calls + 1
    end, uv.READABLE))
  test.assert(uv.try_write(writer:as_stream_t(), {uv.buf_t.from_string("pending")}) == 7)
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not poll:as_handle_t():is_initialized() and
    not reader:as_handle_t():is_initialized() and not writer:as_handle_t():is_initialized())
end

function test_loop_abandon_retires_reverse_dns_random_and_shutdown(_: test.Context)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  local calls = 0
  local status, address? = uv.ip4_addr("127.0.0.1", 1234)
  success(status)
  const reverse = uv.getnameinfo_t()
  success(uv.getnameinfo(loop, reverse,
    function (_request: uv.getnameinfo_t, _status: integer, _host: string?, _service: string?)
      calls = calls + 1
    end, address, uv.NI_NUMERICHOST | uv.NI_NUMERICSERV))
  const random = uv.random_t()
  const buffer = uv.buf_t.allocate(32)
  success(uv.random(loop, random, buffer, 32, 0,
    function (_request: uv.random_t, _status: integer, _buffer: uv.buf_t, _length: integer)
      calls = calls + 1
    end))
  local reader, writer = open_pipe_pair(loop)
  success(uv.shutdown(uv.shutdown_t(), writer:as_stream_t(),
    function (_request: uv.shutdown_t, _status: integer) calls = calls + 1 end))
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, calls)
  test.assert(not reader:as_handle_t():is_initialized() and
    not writer:as_handle_t():is_initialized())
  const reverse_status = reverse:result()
  test.assert(reverse_status ~= uv.EBUSY, "abandonment left reverse DNS pending")
end

function test_loop_abandon_rejects_non_main_lua_thread_without_mutation(_: test.Context)
  const loop = new_loop()
  defer success(uv.loop_abandon(loop))
  const timer = uv.timer_t()
  success(uv.timer_init(loop, timer))
  const run_on_thread = lua.load([[
    local check = ...
    local thread = coroutine.create(check)
    assert(coroutine.resume(thread))
    assert(coroutine.status(thread) == 'dead')
  ]])
  run_on_thread(function ()
    expect_error(function () uv.loop_abandon(loop) end,
      "uv.loop_abandon requires the owning main Lua thread")
  end)
  test.assert(timer:as_handle_t():is_initialized(),
    "wrong-thread rejection mutated the native loop")
  success(uv.loop_abandon(loop))
  assert_abandoned(loop, 0)
end
