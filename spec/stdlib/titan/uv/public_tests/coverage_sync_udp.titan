local su_fault_fs = import "fs"
local su_fault_os = import "os"
local su_fault_command = import "support.command.titan"
local su_fault_common = import "support.common.titan"
local su_fault_runtime = import "support.runtime.titan"

foreign import "uv_coverage_threads.h"

local function coverage_su_deadline(loop: uv.loop_t): uv.timer_t
  local timer = uv.timer_t()
  success(uv.timer_init(loop, timer))
  success(uv.timer_start(timer, function (_timer: uv.timer_t)
    raise "UV coverage behavior exceeded its five-second deadline"
  end, 5000, 0))
  return timer
end

local function coverage_su_probe_rwlock(lock: uv.rwlock_t,
                                        mode: integer?): (integer, integer, integer)
  local state: owned *titan_cov_su_rwlock = foreign titan_cov_su_rwlock.new()
  state.lock = lock:borrow()
  state.read_lock = uv.native_rwlock_rdlock
  state.try_read = uv.native_rwlock_tryrdlock
  state.read_unlock = uv.native_rwlock_rdunlock
  state.write_lock = uv.native_rwlock_wrlock
  state.try_write = uv.native_rwlock_trywrlock
  state.write_unlock = uv.native_rwlock_wrunlock
  state.mode = mode or 0
  local thread = uv.thread_t()
  local accepted, joined = false, false
  defer if accepted and not joined then success(uv.thread_join(thread)) end
  local owners: {value} = {state, lock}
  local status = uv.thread_create(thread, ffi.titan_cov_su_probe_lock, state, owners)
  accepted = status == 0
  success(status)
  success(uv.thread_join(thread))
  joined = true
  return state.read_status, state.write_status, state.blocking_value
end

function test_coverage_su_recursive_mutex_allows_same_thread_reentry(_context: test.Context)
  local mutex = uv.mutex_t()
  success(uv.mutex_init_recursive(mutex))
  defer uv.mutex_destroy(mutex)
  uv.mutex_lock(mutex)
  defer uv.mutex_unlock(mutex)
  uv.mutex_lock(mutex)
  defer uv.mutex_unlock(mutex)
  success(uv.mutex_trylock(mutex))
  uv.mutex_unlock(mutex)
end

function test_coverage_su_rwlock_distinguishes_readers_and_writers(_context: test.Context)
  local lock = uv.rwlock_t()
  success(uv.rwlock_init(lock))
  defer uv.rwlock_destroy(lock)
  uv.rwlock_rdlock(lock)
  do
    defer uv.rwlock_rdunlock(lock)
    local read_status, write_status = coverage_su_probe_rwlock(lock)
    success(read_status)
    test.assert(write_status == uv.EBUSY, "writer entered while another thread held a read lock")
  end
  uv.rwlock_wrlock(lock)
  do
    defer uv.rwlock_wrunlock(lock)
    local read_status, write_status = coverage_su_probe_rwlock(lock)
    test.assert(read_status == uv.EBUSY and write_status == uv.EBUSY,
                "exclusive writer did not exclude another thread")
  end
  success(uv.rwlock_tryrdlock(lock))
  uv.rwlock_rdunlock(lock)
  success(uv.rwlock_trywrlock(lock))
  uv.rwlock_wrunlock(lock)
  local _, _, blocking_value = coverage_su_probe_rwlock(lock, 1)
  test.assert(blocking_value == 42,
              "native rwlock worker rdlock/wrlock did not publish writes")
end

function test_coverage_su_condition_signal_and_broadcast_publish_permits(_context: test.Context)
  local mutex = uv.mutex_t()
  success(uv.mutex_init(mutex))
  defer uv.mutex_destroy(mutex)
  local condition = uv.cond_t()
  success(uv.cond_init(condition))
  defer uv.cond_destroy(condition)
  local ready = uv.sem_t()
  success(uv.sem_init(ready, 0))
  defer uv.sem_destroy(ready)
  local done = uv.sem_t()
  success(uv.sem_init(done, 0))
  defer uv.sem_destroy(done)
  local state: owned *titan_cov_su_condition = foreign titan_cov_su_condition.new()
  state.mutex = mutex:borrow()
  state.condition = condition:borrow()
  state.ready = ready:borrow()
  state.done = done:borrow()
  state.lock = uv.native_mutex_lock
  state.unlock = uv.native_mutex_unlock
  state.wait = uv.native_cond_timedwait
  state.post = uv.native_sem_post
  local owners: {value} = {state, mutex, condition, ready, done}
  local threads: {uv.thread_t} = {}
  local joined = false
  defer if not joined then
    uv.mutex_lock(mutex)
    state.permits = 3
    uv.cond_broadcast(condition)
    uv.mutex_unlock(mutex)
    for i = 1, #threads do success(uv.thread_join(threads[i])) end
  end
  for i = 1, 3 do
    local thread = uv.thread_t()
    local status = uv.thread_create(thread, ffi.titan_cov_su_wait_for_permit,
                                   state, owners)
    if status == 0 then threads[i] = thread end
    success(status)
  end
  uv.sem_wait(ready)
  uv.sem_wait(ready)
  uv.sem_wait(ready)
  uv.mutex_lock(mutex)
  state.permits = 1
  uv.cond_signal(condition)
  uv.mutex_unlock(mutex)
  uv.sem_wait(done)
  uv.mutex_lock(mutex)
  local first_completed: integer = state.completed
  state.permits = 2
  uv.cond_broadcast(condition)
  uv.mutex_unlock(mutex)
  uv.sem_wait(done)
  uv.sem_wait(done)
  for i = 1, #threads do success(uv.thread_join(threads[i])) end
  joined = true
  test.assert(first_completed == 1 and state.completed == 3 and state.failed == 0,
              "condition notification did not release exactly the permitted workers")
  uv.mutex_lock(mutex)
  defer uv.mutex_unlock(mutex)
  local expired = false
  for _attempt = 1, 5 do
    local status = uv.cond_timedwait(condition, mutex, 1000000)
    test.assert(status == 0 or status == uv.ETIMEDOUT)
    if status == uv.ETIMEDOUT then expired = true; break end
  end
  test.assert(expired, "condition without a producer never reported its timeout")
end

function test_coverage_su_tls_and_joined_thread_identity(_context: test.Context)
  local key = uv.key_t()
  success(uv.key_create(key))
  defer uv.key_delete(key)
  local parent_cell: owned int[] = foreign int.new_array(1)
  parent_cell[0] = 17
  test.assert(uv.key_get(key) == nil)
  uv.key_set(key, parent_cell)
  defer uv.key_set(key, nil)
  local ready = uv.sem_t()
  success(uv.sem_init(ready, 0))
  defer uv.sem_destroy(ready)
  local release = uv.sem_t()
  success(uv.sem_init(release, 0))
  defer uv.sem_destroy(release)
  local state: owned *titan_cov_su_tls = foreign titan_cov_su_tls.new()
  state.key = key:borrow()
  state.ready = ready:borrow()
  state.release = release:borrow()
  state.get = uv.native_key_get
  state.set = uv.native_key_set
  state.post = uv.native_sem_post
  state.wait = uv.native_sem_wait
  state.set_name = uv.thread_setname_function()
  state.get_cpu = uv.thread_getcpu_function()
  local thread = uv.thread_t()
  local accepted, joined = false, false
  defer if accepted and not joined then
    uv.sem_post(release)
    success(uv.thread_join(thread))
  end
  local owners: {value} = {state, key, ready, release}
  local status = uv.thread_create_ex(thread, uv.thread_options_t(uv.THREAD_NO_FLAGS, 0),
                                   ffi.titan_cov_su_use_tls, state, owners)
  accepted = status == 0
  success(status)
  uv.sem_wait(ready)
  success(state.name_status)
  test.assert(uv.key_get(key) == (parent_cell as foreign *void) and parent_cell[0] == 17,
              "worker TLS pointer replaced its parent's value")
  test.assert(uv.thread_equal(thread, thread) and not uv.thread_equal(thread, uv.thread_self()))
  test.assert(uv.thread_equal(uv.thread_self(), uv.thread_self()))
  test.assert(uv.thread_detach(thread) == uv.EBUSY, "detach discarded the retained worker graph")
  local named, name? = uv.thread_getname(thread, 64)
  success(named)
  test.assert(name == "titan-cov-su")
  local prioritized, priority? = uv.thread_getpriority(thread)
  success(prioritized)
  test.assert(priority ~= nil)
  -- Linux and Windows expose CPU/affinity queries; macOS deliberately returns
  -- ENOTSUP. Exercise that status contract without skipping the behavior case.
  local cpu = uv.thread_getcpu()
  local worker_cpu: integer = state.cpu
  test.assert(cpu >= 0 or cpu == uv.ENOTSUP)
  test.assert(worker_cpu >= 0 or worker_cpu == uv.ENOTSUP)
  local mask_size = uv.cpumask_size()
  if mask_size >= 0 then
    test.assert(mask_size > 0)
    local mask: owned char[] = foreign char.new_array(mask_size)
    local previous: owned char[] = foreign char.new_array(mask_size)
    success(uv.thread_getaffinity(thread, mask))
    success(uv.thread_setaffinity(thread, mask, previous))
    for i = 0, mask_size - 1 do
      test.assert(mask[i] == previous[i], "same-mask update changed worker affinity")
    end
    success(uv.thread_setaffinity(thread, previous, nil))
  else
    test.assert(mask_size == uv.ENOTSUP, "unexpected native CPU-mask failure")
  end
  collect()
  uv.sem_post(release)
  success(uv.thread_join(thread))
  joined = true
  test.assert(state.isolated == 1 and state.cell == 42 and name == "titan-cov-su")
  test.assert(uv.key_get(key) == (parent_cell as foreign *void))
  local retired, absent? = uv.thread_getname(thread, 64)
  test.assert(retired == uv.EINVAL and absent == nil)
end

function test_coverage_su_once_initialization_is_shared_across_native_threads(_context: test.Context)
  ffi.titan_cov_su_reset_once()
  local guard = uv.once_t()
  local start = uv.sem_t()
  success(uv.sem_init(start, 0))
  defer uv.sem_destroy(start)
  local state: owned *titan_cov_su_once = foreign titan_cov_su_once.new()
  state.guard = guard:borrow()
  state.start = start:borrow()
  state.once = uv.native_once
  state.wait = uv.native_sem_wait
  local owners: {value} = {state, guard, start}
  local threads: {uv.thread_t} = {}
  local joined = false
  defer if not joined then
    for _i = 1, #threads do uv.sem_post(start) end
    for i = 1, #threads do success(uv.thread_join(threads[i])) end
  end
  for i = 1, 3 do
    local thread = uv.thread_t()
    local status = uv.thread_create(thread, ffi.titan_cov_su_race_once,
                                   state, owners)
    if status == 0 then threads[i] = thread end
    success(status)
  end
  for _i = 1, #threads do uv.sem_post(start) end
  uv.once(guard, ffi.titan_cov_su_initialize_once)
  for i = 1, #threads do success(uv.thread_join(threads[i])) end
  joined = true
  uv.once(guard, ffi.titan_cov_su_initialize_once)
  test.assert(ffi.titan_cov_su_count_once() == 1, "one guard ran its initializer more than once")
  uv.once(uv.once_t(), ffi.titan_cov_su_initialize_once)
  test.assert(ffi.titan_cov_su_count_once() == 2, "distinct guards incorrectly shared native state")
end

function test_coverage_su_direct_foreign_sync_entries_and_worker_matrix(
    context: test.Context)
  context:run("exact_pointer_assignment_and_direct_calls", function (_child: test.Context)
    local mutex_lock: foreign function(*void): void = uv.native_mutex_lock
    local mutex_trylock: foreign function(*void): int = uv.native_mutex_trylock
    local mutex_unlock: foreign function(*void): void = uv.native_mutex_unlock
    local mutex_destroy: foreign function(*void): void = uv.native_mutex_destroy
    local rwlock_rdlock: foreign function(*void): void = uv.native_rwlock_rdlock
    local rwlock_tryrdlock: foreign function(*void): int = uv.native_rwlock_tryrdlock
    local rwlock_rdunlock: foreign function(*void): void = uv.native_rwlock_rdunlock
    local rwlock_wrlock: foreign function(*void): void = uv.native_rwlock_wrlock
    local rwlock_trywrlock: foreign function(*void): int = uv.native_rwlock_trywrlock
    local rwlock_wrunlock: foreign function(*void): void = uv.native_rwlock_wrunlock
    local sem_post: foreign function(*void): void = uv.native_sem_post
    local sem_wait: foreign function(*void): void = uv.native_sem_wait
    local sem_trywait: foreign function(*void): int = uv.native_sem_trywait
    local cond_signal: foreign function(*void): void = uv.native_cond_signal
    local cond_broadcast: foreign function(*void): void = uv.native_cond_broadcast
    local cond_wait: foreign function(*void, *void): void = uv.native_cond_wait
    local cond_timedwait: foreign function(*void, *void, unsigned long long): int =
      uv.native_cond_timedwait
    local barrier_wait: foreign function(*void): int = uv.native_barrier_wait
    local key_get: foreign function(*void): *void = uv.native_key_get
    local key_set: foreign function(*void, *void): void = uv.native_key_set
    local once_call: foreign function(*void, function(): void): void = uv.native_once
    test.assert(cond_wait ~= nil and mutex_destroy ~= nil)

    local mutex = uv.mutex_t()
    success(uv.mutex_init(mutex))
    defer uv.mutex_destroy(mutex)
    local raw_mutex = mutex:borrow()
    mutex_lock(raw_mutex)
    mutex_unlock(raw_mutex)
    test.assert(mutex_trylock(raw_mutex) == 0)
    mutex_unlock(raw_mutex)

    local rwlock = uv.rwlock_t()
    success(uv.rwlock_init(rwlock))
    defer uv.rwlock_destroy(rwlock)
    local raw_rwlock = rwlock:borrow()
    rwlock_rdlock(raw_rwlock)
    test.assert(rwlock_tryrdlock(raw_rwlock) == 0)
    rwlock_rdunlock(raw_rwlock)
    rwlock_rdunlock(raw_rwlock)
    rwlock_wrlock(raw_rwlock)
    rwlock_wrunlock(raw_rwlock)
    test.assert(rwlock_trywrlock(raw_rwlock) == 0)
    rwlock_wrunlock(raw_rwlock)

    local sem = uv.sem_t()
    success(uv.sem_init(sem, 0))
    defer uv.sem_destroy(sem)
    local raw_sem = sem:borrow()
    test.assert((sem_trywait(raw_sem) as integer) == uv.EAGAIN)
    sem_post(raw_sem)
    test.assert(sem_trywait(raw_sem) == 0)
    sem_post(raw_sem)
    sem_wait(raw_sem)
    test.assert((sem_trywait(raw_sem) as integer) == uv.EAGAIN)

    local cond = uv.cond_t()
    success(uv.cond_init(cond))
    defer uv.cond_destroy(cond)
    local raw_cond = cond:borrow()
    cond_signal(raw_cond)
    cond_broadcast(raw_cond)
    mutex_lock(raw_mutex)
    local mutex_locked = true
    defer if mutex_locked then mutex_unlock(raw_mutex) end
    local timed_out = false
    for _attempt = 1, 5 do
      local rc: integer = cond_timedwait(raw_cond, raw_mutex, 1000000)
      test.assert(rc == 0 or rc == uv.ETIMEDOUT)
      if rc == uv.ETIMEDOUT then timed_out = true; break end
    end
    mutex_unlock(raw_mutex)
    mutex_locked = false
    test.assert(timed_out, "direct foreign cond_timedwait did not report timeout")

    local barrier = uv.barrier_t()
    success(uv.barrier_init(barrier, 1))
    defer uv.barrier_destroy(barrier)
    test.assert(barrier_wait(barrier:borrow()) > 0)

    local key = uv.key_t()
    success(uv.key_create(key))
    defer uv.key_delete(key)
    local raw_key = key:borrow()
    local cell: owned int[] = foreign int.new_array(1)
    cell[0] = 99
    test.assert(key_get(raw_key) == nil)
    key_set(raw_key, cell)
    test.assert(key_get(raw_key) == (cell as foreign *void))
    key_set(raw_key, nil)
    test.assert(key_get(raw_key) == nil)

    ffi.titan_cov_su_reset_once()
    local guard = uv.once_t()
    once_call(guard:borrow(), ffi.titan_cov_su_initialize_once)
    once_call(guard:borrow(), ffi.titan_cov_su_initialize_once)
    test.assert(ffi.titan_cov_su_count_once() == 1)
  end)

  context:run("barrier_participation_and_serial_winner", function (_child: test.Context)
    local mutex = uv.mutex_t()
    success(uv.mutex_init(mutex))
    defer uv.mutex_destroy(mutex)
    local barrier = uv.barrier_t()
    success(uv.barrier_init(barrier, 3))
    defer uv.barrier_destroy(barrier)
    local start = uv.sem_t()
    success(uv.sem_init(start, 0))
    defer uv.sem_destroy(start)
    local state: owned *titan_cov_su_sync_matrix =
      foreign titan_cov_su_sync_matrix.new()
    state.mutex = mutex:borrow()
    state.barrier = barrier:borrow()
    state.start = start:borrow()
    state.sem_wait = uv.native_sem_wait
    state.mutex_lock = uv.native_mutex_lock
    state.mutex_unlock = uv.native_mutex_unlock
    state.barrier_wait = uv.native_barrier_wait
    state.all_arrived_before_release = 1
    local owners: {value} = {state, mutex, barrier, start}
    local threads: {uv.thread_t} = {}
    local started = 0
    local released = false
    local joined = false
    defer if not joined then
      if not released then
        state.abort_barrier = 1
        for _i = 1, started do uv.sem_post(start) end
      end
      for i = 1, started do success(uv.thread_join(threads[i])) end
    end
    for i = 1, 3 do
      local thread = uv.thread_t()
      threads[i] = thread
      local status = uv.thread_create(
        thread, ffi.titan_cov_su_barrier_participant, state, owners)
      if status == 0 then started = started + 1 end
      success(status)
    end
    released = true
    for _i = 1, started do uv.sem_post(start) end
    for i = 1, #threads do success(uv.thread_join(threads[i])) end
    joined = true
    test.assert(state.arrived == 3 and state.all_arrived_before_release == 1,
                "barrier released a participant before all threads arrived")
    test.assert(state.serial_count == 1 and state.zero_count == 2 and state.error_count == 0,
                "barrier did not elect exactly one serial thread")
  end)

  context:run("condition_wait_predicate_loop_and_try_statuses", function (_child: test.Context)
    local mutex = uv.mutex_t()
    success(uv.mutex_init(mutex))
    defer uv.mutex_destroy(mutex)
    local cond = uv.cond_t()
    success(uv.cond_init(cond))
    defer uv.cond_destroy(cond)
    local sem = uv.sem_t()
    success(uv.sem_init(sem, 0))
    defer uv.sem_destroy(sem)
    local state: owned *titan_cov_su_sync_matrix =
      foreign titan_cov_su_sync_matrix.new()
    state.mutex = mutex:borrow()
    state.cond = cond:borrow()
    state.sem = sem:borrow()
    state.mutex_lock = uv.native_mutex_lock
    state.mutex_trylock = uv.native_mutex_trylock
    state.mutex_unlock = uv.native_mutex_unlock
    state.cond_signal = uv.native_cond_signal
    state.cond_broadcast = uv.native_cond_broadcast
    state.cond_wait = uv.native_cond_wait
    state.sem_post = uv.native_sem_post
    state.sem_wait = uv.native_sem_wait
    state.sem_trywait = uv.native_sem_trywait
    local owners: {value} = {state, mutex, cond, sem}

    uv.native_mutex_lock(state.mutex)
    do
      defer uv.native_mutex_unlock(state.mutex)
      local probe_thread = uv.thread_t()
      success(uv.thread_create(
        probe_thread, ffi.titan_cov_su_try_busy_mutex, state, owners))
      success(uv.thread_join(probe_thread))
      test.assert((state.trylock_busy_status as integer) == uv.EBUSY,
                  "native_mutex_trylock did not report EBUSY across OS threads")
    end

    local waiters: {uv.thread_t} = {}
    local producer = uv.thread_t()
    local producer_started = false
    local joined = false
    defer if not joined then
      uv.native_mutex_lock(state.mutex)
      state.predicate_phase = 2
      uv.native_cond_broadcast(state.cond)
      uv.native_mutex_unlock(state.mutex)
      if producer_started then success(uv.thread_join(producer)) end
      for i = 1, #waiters do success(uv.thread_join(waiters[i])) end
    end
    for i = 1, 2 do
      local thread = uv.thread_t()
      local status = uv.thread_create(
        thread, ffi.titan_cov_su_cond_wait_worker, state, owners)
      if status == 0 then waiters[i] = thread end
      success(status)
    end
    local pstatus = uv.thread_create(
      producer, ffi.titan_cov_su_cond_producer_worker, state, owners)
    producer_started = pstatus == 0
    success(pstatus)
    success(uv.thread_join(producer))
    producer_started = false
    uv.native_sem_wait(state.sem)
    uv.native_sem_wait(state.sem)
    for i = 1, #waiters do success(uv.thread_join(waiters[i])) end
    joined = true
    state.trylock_free_status = uv.native_mutex_trylock(state.mutex)
    if state.trylock_free_status == 0 then uv.native_mutex_unlock(state.mutex) end
    test.assert((state.trywait_empty_status as integer) == uv.EAGAIN and
                state.trywait_ready_status == 0 and
                (state.trywait_after_status as integer) == uv.EAGAIN,
                "native_sem_trywait returned unexpected status values")
    test.assert(state.trylock_free_status == 0 and
                state.cond_wait_released_mutex == 1,
                "native_cond_wait did not release its mutex while waiting")
    test.assert(state.spurious_recheck_held == 1 and
                state.cond_waiters_done == 2,
                "condition predicate loop did not survive intermediate wake and finish")
  end)

  context:run("heap_mutex_lifecycle_and_null_destroy", function (_child: test.Context)
    uv.native_mutex_destroy(nil)
    local raw_mutex = uv.mutex_t.create_native()
    test.assert(raw_mutex ~= nil, "mutex_t.create_native returned NULL")
    local destroyed = false
    local locked = false
    defer if not destroyed then uv.native_mutex_destroy(raw_mutex) end
    defer if locked then uv.native_mutex_unlock(raw_mutex) end

    local try_status = uv.native_mutex_trylock(raw_mutex)
    locked = try_status == 0
    test.assert(locked)
    local state: owned *titan_cov_su_sync_matrix =
      foreign titan_cov_su_sync_matrix.new()
    state.mutex = raw_mutex
    state.mutex_trylock = uv.native_mutex_trylock
    state.mutex_unlock = uv.native_mutex_unlock
    local probe = uv.thread_t()
    success(uv.thread_create(probe, ffi.titan_cov_su_try_busy_mutex, state, state))
    success(uv.thread_join(probe))
    test.assert((state.trylock_busy_status as integer) == uv.EBUSY,
                "heap mutex trylock did not report EBUSY on another OS thread")
    uv.native_mutex_unlock(raw_mutex)
    locked = false

    local cond = uv.cond_t()
    success(uv.cond_init(cond))
    defer uv.cond_destroy(cond)
    uv.native_mutex_lock(raw_mutex)
    locked = true
    local timed_out = false
    for _attempt = 1, 5 do
      local rc: integer = uv.native_cond_timedwait(cond:borrow(), raw_mutex, 1000000)
      test.assert(rc == 0 or rc == uv.ETIMEDOUT)
      if rc == uv.ETIMEDOUT then timed_out = true; break end
    end
    state.trylock_busy_status = 0
    local reacquired_probe = uv.thread_t()
    success(uv.thread_create(
      reacquired_probe, ffi.titan_cov_su_try_busy_mutex, state, state))
    success(uv.thread_join(reacquired_probe))
    uv.native_mutex_unlock(raw_mutex)
    locked = false
    test.assert(timed_out and (state.trylock_busy_status as integer) == uv.EBUSY,
                "cond_timedwait did not reacquire heap mutex before returning")

    uv.native_mutex_destroy(raw_mutex)
    destroyed = true
    uv.native_mutex_destroy(nil)
  end)
end

function test_coverage_su_numeric_addresses_preserve_bytes_and_ipv6_fields(context: test.Context)
  context:run("ipv4", function (_child: test.Context)
    local status, address? = uv.ip4_addr("192.0.2.129", 65535)
    success(status)
    test.assert(address:family() == uv.AF_INET and address:port() == 65535)
    test.assert(address:is_complete() and address:byte_length() > 4)
    test.assert(#address:raw_bytes() == address:byte_length())
    test.assert(address:address_bytes() == "\192\0\2\129")
    local parsed, bytes? = uv.inet_pton(uv.AF_INET, "192.0.2.129")
    success(parsed)
    test.assert(bytes == address:address_bytes())
    local formatted, text? = uv.inet_ntop(uv.AF_INET, bytes)
    success(formatted)
    local named, name? = uv.ip4_name(address)
    success(named)
    local generic, generic_name? = uv.ip_name(address)
    success(generic)
    test.assert(text == "192.0.2.129" and name == text and generic_name == text)
    test.assert(address:scope_id() == 0 and address:flowinfo() == 0)
    local length? = address:sa_len()
    test.assert(length == nil or length == address:byte_length())
  end)
  context:run("ipv6", function (_child: test.Context)
    local status, address? = uv.ip6_addr("2001:db8::1", 4321)
    success(status)
    address:set_flowinfo(0x12345678)
    address:set_scope_id(7)
    test.assert(address:family() == uv.AF_INET6 and address:port() == 4321)
    test.assert(address:flowinfo() == 0x12345678 and address:scope_id() == 7)
    test.assert(#address:address_bytes() == 16 and #address:raw_bytes() == address:byte_length())
    local parsed, bytes? = uv.inet_pton(uv.AF_INET6, "2001:db8::1")
    success(parsed)
    test.assert(bytes == address:address_bytes())
    local formatted, text? = uv.inet_ntop(uv.AF_INET6, bytes)
    success(formatted)
    local named, name? = uv.ip6_name(address)
    success(named)
    local generic, generic_name? = uv.ip_name(address)
    success(generic)
    test.assert(text == "2001:db8::1" and name == text and generic_name == text)
  end)
  context:run("malformed_inputs", function (_child: test.Context)
    local bad4, absent4? = uv.ip4_addr("256.0.0.1", 80)
    local bad6, absent6? = uv.ip6_addr("2001:::1", 80)
    test.assert(bad4 == uv.EINVAL and absent4 == nil and bad6 == uv.EINVAL and absent6 == nil)
    local parsed, no_bytes? = uv.inet_pton(uv.AF_INET, "127.0.0")
    test.assert(parsed == uv.EINVAL and no_bytes == nil)
    local short4, no4? = uv.inet_ntop(uv.AF_INET, "abc")
    local short6, no6? = uv.inet_ntop(uv.AF_INET6, "short")
    test.assert(short4 == uv.EINVAL and no4 == nil and short6 == uv.EINVAL and no6 == nil)
    local unsupported, missing? = uv.inet_pton(-1, "127.0.0.1")
    local unsupported_text, missing_text? = uv.inet_ntop(-1, "abcd")
    test.assert(unsupported == uv.EAFNOSUPPORT and missing == nil and
                unsupported_text == uv.EAFNOSUPPORT and missing_text == nil)
    local valid4, address4? = uv.ip4_addr("127.0.0.1", 1)
    local valid6, address6? = uv.ip6_addr("::1", 1)
    success(valid4)
    success(valid6)
    local wrong6, absent_name6? = uv.ip6_name(address4)
    local wrong4, absent_name4? = uv.ip4_name(address6)
    test.assert(wrong6 == uv.EAFNOSUPPORT and absent_name6 == nil and
                wrong4 == uv.EAFNOSUPPORT and absent_name4 == nil)
  end)
end

function test_coverage_su_reverse_dns_callback_reuses_request_and_copies_results(_context: test.Context)
  local loop = new_loop()
  defer finish_loop(loop)
  local deadline = coverage_su_deadline(loop)
  local first_status, first? = uv.ip4_addr("127.0.0.1", 1234)
  local second_status, second? = uv.ip6_addr("::1", 4321)
  success(first_status)
  success(second_status)
  local request = uv.getnameinfo_t()
  local flags = uv.NI_NUMERICHOST | uv.NI_NUMERICSERV
  local calls = 0
  local saved_host: string? = nil
  local saved_service: string? = nil
  success(uv.getnameinfo(loop, request, function (completed: uv.getnameinfo_t, status: integer,
                                                host: string?, service: string?)
    success(status)
    calls = calls + 1
    test.assert(completed == request and completed:get_loop() == loop)
    test.assert(host == "127.0.0.1" and service == "1234")
    saved_host, saved_service = host, service
    success(uv.getnameinfo(loop, completed, function (again: uv.getnameinfo_t, result: integer,
                                                    next_host: string?, next_service: string?)
      success(result)
      calls = calls + 1
      test.assert(again == request and next_host == "::1" and next_service == "4321")
      collect()
      test.assert(saved_host == "127.0.0.1" and saved_service == "1234")
      uv.close(deadline:as_handle_t())
    end, second, flags))
    local busy, absent_host?, absent_service? = completed:result()
    test.assert(busy == uv.EBUSY and absent_host == nil and absent_service == nil)
    collect()
    test.assert(host == "127.0.0.1" and service == "1234")
  end, first, flags))
  test.assert(uv.getnameinfo(loop, request, nil, first, flags) == uv.EBUSY)
  collect()
  success(uv.run(loop))
  test.assert(calls == 2)
  local result, host?, service? = request:result()
  success(result)
  test.assert(host == "::1" and service == "4321")
end

function test_coverage_su_udp_immediate_and_batch_sends_preserve_datagrams(_context: test.Context)
  local loop = new_loop()
  defer finish_loop(loop)
  local deadline = coverage_su_deadline(loop)
  local receiver, address = bound(loop, 0)
  local sender = uv.udp_t()
  success(uv.udp_init(loop, sender))
  local packets: {string: integer} = {}
  local received = 0
  success(uv.udp_recv_start(receiver,
    function (_handle, _suggested) return uv.buf_t.allocate(128) end,
    function (owner, count, buffer, peer, flags)
      test.assert(count >= 0, "loopback UDP receive failed")
      if peer ~= nil then
        test.assert(flags == 0 and peer:family() == uv.AF_INET and peer:port() > 0)
        local packet = buffer:to_string(count)
        packets[packet] = (packets[packet] or 0) + 1
        received = received + 1
        if received == 4 then
          success(uv.udp_recv_stop(owner))
          uv.close(owner:as_handle_t())
          uv.close(sender:as_handle_t())
          uv.close(deadline:as_handle_t())
        end
      end
    end))
  test.assert(uv.udp_try_send(sender, {uv.buf_t.from_string("first\0packet")}, address) == 12)
  success(uv.udp_connect(sender, address))
  local peer_status, peer?, peer_size = uv.udp_getpeername(sender)
  success(peer_status)
  test.assert(peer:port() == address:port() and peer_size == peer:byte_length())
  test.assert(uv.udp_try_send(sender, {uv.buf_t.from_string("connected\0")}, nil) == 10)
  success(uv.udp_connect(sender, nil))
  local disconnected, no_peer?, _size = uv.udp_getpeername(sender)
  test.assert(disconnected == uv.ENOTCONN and no_peer == nil)
  local vectors = {{uv.buf_t.from_string("a\0"), uv.buf_t.from_string("b")},
                   {uv.buf_t.from_string("last")}}
  local addresses: {uv.sockaddr_t?} = {address, address}
  test.assert(uv.udp_try_send2(sender, vectors, addresses, 0) == 2)
  test.assert(uv.udp_get_send_queue_count(sender) == 0 and uv.udp_get_send_queue_size(sender) == 0)
  collect()
  success(uv.run(loop))
  test.assert(received == 4 and packets["first\0packet"] == 1 and packets["connected\0"] == 1 and
              packets["a\0b"] == 1 and packets["last"] == 1,
              "immediate/batch send merged, truncated, duplicated or lost a datagram")
end

local function su_native_ownership_case(context: test.Context, workspace: string,
                                        scenario: string)
  context:run(scenario, function (_child: test.Context)
    local output, why, status = su_fault_command.capture({
      su_fault_command.program(workspace, "uv_sync_alloc_fault_app"), scenario,
    }, workspace)
    test.assert(why == "exit" and status == 0,
                "native UV ownership scenario failed at " .. scenario .. ": " .. output)
    test.assert(output == "UV_NATIVE_OWNERSHIP_OK\n",
                "native ownership child omitted its receipt")
  end)
end

local function su_native_fault_workspace(context: test.Context): string
  if su_fault_common.is_windows() then
    test.skip("platform: native allocation wrapping requires Linux static archive linkage")
  end
  local host, why, status = su_fault_command.capture({"uname", "-s"})
  test.assert(why == "exit" and status == 0, host)
  if host ~= "Linux\n" then
    test.skip("platform: native allocation wrapping requires Linux static archive linkage")
  end
  local workspace = ""
  su_fault_runtime.run(function ()
    workspace = su_fault_fs.tmpname()
    su_fault_fs.unlink(workspace)
    su_fault_fs.mkdir(workspace)
    context:cleanup(function () su_fault_command.remove_tree(workspace) end)
    su_fault_fs.write_file(workspace .. "/uv_sync_alloc_fault_api.h",
      su_fault_fs.read_file("spec/fixtures/stdlib/native/uv_sync_alloc_fault_api.h"))
    su_fault_fs.write_file(workspace .. "/uv_sync_alloc_fault_app.titan",
      su_fault_fs.read_file("spec/fixtures/stdlib/titan/uv_sync_alloc_fault_app.titan"))
    local flags = su_fault_os.getenv("TITAN_EXTRA_LDFLAGS") or ""
    flags = flags .. " -Wl,--wrap=malloc,--wrap=free,--wrap=uv_mutex_init" ..
      ",--wrap=uv_thread_join,--wrap=uv_thread_detach,--wrap=uv_thread_create"
    local output, compile_why, code = su_fault_command.compile(workspace,
      "uv_sync_alloc_fault_app",
      {"--no-uv-bootstrap", "-X", su_fault_command.fixture_object("uv_sync_alloc_fault")},
      true, {["TITAN_EXTRA_LDFLAGS"] = flags})
    test.assert(compile_why == "exit" and code == 0,
                "could not compile unchanged-provider UV allocation child: " .. output)
  end)
  return workspace
end

function test_native_heap_mutex_allocation_failure_and_cleanup(context: test.Context)
  local workspace = su_native_fault_workspace(context)
  su_native_ownership_case(context, workspace, "malloc-failure")
  su_native_ownership_case(context, workspace, "init-failure")
  su_native_ownership_case(context, workspace, "success-and-destroy")
end
