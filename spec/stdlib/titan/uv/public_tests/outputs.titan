function test_caller_output_capacity_and_error_names(_context: test.Context)
  local status, path?, required = uv.cwd(1)
  test.assert(status == uv.ENOBUFS and path == nil and required > 1)
  local full_status, full_path?, length = uv.cwd(required)
  success(full_status)
  test.assert(full_path ~= nil and #full_path == length and length + 1 == required)
  local empty_status, empty?, _size = uv.cwd(0)
  test.assert(empty_status == uv.EINVAL and empty == nil)
  test.assert(uv.err_name(uv.ENOENT) == "ENOENT")
  test.assert(#uv.strerror(uv.ENOENT) > 0)
  test.assert(uv.err_name_r(uv.ENOENT, 2) == "E")
  test.assert(uv.err_name_r(uv.ENOENT, 0) == "")
  test.assert(uv.version() >= 0x013401 and #uv.version_string() > 0)
end

function test_copied_native_snapshot_survives_gc(_context: test.Context)
  local status, cpus?, count = uv.cpu_info()
  success(status)
  test.assert(cpus ~= nil and count > 0 and #cpus == count)
  local first: uv.cpu_info_t = cpus[1]
  local model? = first.model
  local speed = first.speed
  test.assert(speed >= 0 and first.cpu_times.user >= 0 and first.cpu_times.sys >= 0)
  local next_status, next_cpus?, next_count = uv.cpu_info()
  success(next_status)
  test.assert(next_cpus ~= nil and next_count > 0)
  collect()
  test.assert(first.model == model and first.speed == speed)
end

function test_unicode_lengths_binary_data_and_native_truncation(_context: test.Context)
  local units: {integer} = {65, 0, 66}
  test.assert(uv.utf16_length_as_wtf8(units, 3) == 3)
  test.assert(uv.utf16_length_as_wtf8(units, -1) == 1)
  local measured, no_text?, required = uv.utf16_to_wtf8(units, 3, nil)
  success(measured)
  test.assert(no_text == nil and required == 3)
  local status, text?, size = uv.utf16_to_wtf8(units, 3, required)
  success(status)
  test.assert(text == "A\0B" and size == 3)
  local short_status, partial?, needed = uv.utf16_to_wtf8({0x20AC}, 1, 1)
  test.assert(short_status == uv.ENOBUFS and partial == "\xE2" and needed >= 3)
  local retry_status, complete?, written = uv.utf16_to_wtf8({0x20AC}, 1, needed)
  success(retry_status)
  test.assert(complete == "\xE2\x82\xAC" and written == 3)
  local pair_status, pair?, pair_size = uv.utf16_to_wtf8({0xD83D, 0xDE00}, 2, 4)
  success(pair_status)
  test.assert(pair == "\xF0\x9F\x98\x80" and pair_size == 4)
  local lone_status, lone?, lone_size = uv.utf16_to_wtf8({0xD800}, 1, 3)
  success(lone_status)
  test.assert(lone == "\xED\xA0\x80" and lone_size == 3)
  test.assert(uv.wtf8_length_as_utf16("A\0B") == 2)
  local prefix = uv.wtf8_to_utf16("A\0B", 2)
  test.assert(#prefix == 2 and prefix[1] == 65 and prefix[2] == 0)
  test.assert(uv.wtf8_length_as_utf16("\xFF") == -1)
  expect_error(function () uv.wtf8_to_utf16("\xFF", 1) end, "invalid WTF-8 input")
end

function test_failed_library_open_retains_copied_error_and_requires_close(_context: test.Context)
  local path = fixture_file()
  defer remove_file(path)
  local library = uv.lib_t()
  defer uv.dlclose(library)
  test.assert(uv.dlopen(path .. ".missing", library) < 0)
  local copied = uv.dlerror(library)
  test.assert(#copied > 0 and copied ~= "no error")
  expect_error(function () uv.dlsym(library, "absent") end,
               "lib_t:dlsym requires an open library")
  uv.dlclose(library)
  uv.dlclose(library)
  test.assert(uv.dlerror(library) == "no error")
  test.assert(#copied > 0 and copied ~= "no error")
  expect_error(function () uv.dlopen(path, library) end,
               "lib_t:dlopen requires a fresh library owner")
end
