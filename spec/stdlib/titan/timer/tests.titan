local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local stream = import "io"
local timer = import "timer"
local uv = import "uv"
local gc = import "gc"
local task_support = import "support.async.titan"

local function native_handle_count(): integer
  -- Walk on the loop's main thread without advancing it. Cleanup registration
  -- also permits observing native retirement when cancellation is pending.
  local outcome = async.await_cleanup<|integer, nil|>(function (resolve, _reject, _fatal)
    local count = 0
    uv.walk(async.current_loop(), function (_handle: uv.handle_t, _: value)
      count = count + 1
    end)
    resolve(count)
  end)
  case outcome
  when success(count) then return count
  else raise "native handle inventory failed"
  end
end

function test_timer_yield_and_sleep(_context: test.Context)
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    timer.yield()
    timer.sleep(0)
    test.assert(native_handle_count() == baseline_handles,
                "zero sleep returned before its native timer closed")
    timer.sleep(2)
    test.assert(native_handle_count() == baseline_handles,
                "sleep returned before its native timer closed")

    local rejected = false
    do
      timer.sleep(-1)
    catch
      local failure = error as async.OperationError
      test.assert(failure.operation == "timer.sleep" and failure.name == "EINVAL",
                  "negative sleep reported the wrong operation or native error")
      rejected = true
    end
    test.assert(rejected, "negative sleep was accepted")
    test.assert(native_handle_count() == baseline_handles,
                "negative sleep initialized a native timer")
  end)
end

function test_timer_ticker_waited_and_retained_ticks(
    _context: test.Context)
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    local ticker = timer.ticker(1)
    defer ticker:close()

    local count = 0
    for _ = 1, 3 do
      gc.collect()
      if ticker:tick() then count = count + 1 end
      gc.collect()
    end
    test.assert(count == 3, "Ticker lost a waited tick")

    -- A recurring timer retains one pending fact, not an accumulated count.
    timer.sleep(8)
    test.assert(ticker:tick(),
                "Ticker did not retain its latest unwaited tick")

    local closer: stream.Closer = ticker
    closer:close()
    closer:close()
    test.assert(not ticker:tick(), "closed Ticker produced another tick")
    test.assert(native_handle_count() == baseline_handles,
                "Ticker close returned before native retirement")
  end)
end

function test_timer_ticker_pending_close_and_invalid_period(
    _context: test.Context)
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    local ticker = timer.ticker(10000)
    defer ticker:close()
    local ticked = true
    local waiter = async.run<|value, value|>(function (): value
      ticked = ticker:tick()
      return nil
    end)
    task_support.cleanup_task(waiter, "ticker waiter cleanup")

    while waiter:status():as_string() == "ready" do timer.yield() end
    test.assert(waiter:status():as_string() == "waiting",
                "Ticker waiter did not suspend")

    local competing_waiter_rejected = false
    do
      ticker:tick()
    catch
      competing_waiter_rejected = error == "Ticker already has a waiting Task"
    end
    test.assert(competing_waiter_rejected,
                "Ticker accepted a second waiting Task")

    gc.collect()
    ticker:close()
    gc.collect()
    while task_support.active(waiter) do timer.yield() end
    test.assert(waiter:status():as_string() == "succeeded",
                "closing Ticker failed its waiter")
    test.assert(not ticked, "closing Ticker resumed its waiter with true")

    local invalid = false
    do
      timer.ticker(0)
    catch
      invalid = error == "ticker interval must be positive"
    end
    test.assert(invalid, "Ticker accepted a nonpositive interval")
    test.assert(native_handle_count() == baseline_handles,
                "closed or rejected Ticker left a native handle")
  end)
end

function test_timer_sleep_owner_survives_collection_until_close(
    _context: test.Context)
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    local resumed = false
    local unwound = false
    local sleeper = async.run<|value, value|>(function (): value
      defer unwound = true
      timer.sleep(60000)
      resumed = true
      return nil
    end)
    task_support.cleanup_task(sleeper, "collected timer owner cleanup")
    while sleeper:status():as_string() == "ready" do timer.yield() end
    test.assert(sleeper:status():as_string() == "waiting",
                "one-shot timer did not suspend")
    test.assert(native_handle_count() == baseline_handles + 1,
                "accepted sleep did not own its native timer")

    gc.collect()
    local reason = async.CancellationReason<|value|>.simple("close collected timer")
    sleeper:cancel(reason)
    test.assert(not unwound, "sleep cancellation entered its Task inline")
    gc.collect()
    async.join(sleeper)
    local cancelled, actual? = sleeper:status():has_cancelled()
    test.assert(cancelled and actual == reason and unwound and not resumed,
                "collected timer owner lost its close continuation")
    test.assert(native_handle_count() == baseline_handles,
                "cancelled sleep retained its native timer")
  end)
end

function test_timer_sleep_closes_after_native_resume_queue_failure(
    _context: test.Context)
  local unwound, returned, native_closed = false, false, false
  local wake: uv.timer_t? = nil
  local sleeper = async.run<|nil, value|>(function (): nil
    local trigger = uv.timer_t.new()
    test.assert(uv.timer_init(async.current_loop(), trigger) == 0,
        "sleep fault trigger initialization failed")
    test.assert(uv.timer_start(trigger, function (owner: uv.timer_t)
      uv.timer_close(owner, function (_: uv.timer_t) native_closed = true end)
      -- Fault injection only: application adapters do not own this handle.
      -- This earlier zero timer closes the wake before sleep's callback tries
      -- to schedule its token. The consumed sleep callback must remain able
      -- to reach deferred native close during Runtime shutdown.
      uv.timer_close(wake as uv.timer_t)
    end, 0, 0) == 0, "sleep fault trigger start failed")
    defer unwound = true
    timer.sleep(0)
    returned = true
    return nil
  end)
  -- run creates the Runtime but defers Task entry. Inventory its sole timer
  -- here on the owning main thread, before the Task creates native work.
  uv.walk(async.current_loop(), function (handle: uv.handle_t, _: value)
    case handle
    when timer(owner) then wake = owner
    else
    end
  end)
  test.assert(wake ~= nil, "Runtime did not expose its initialized wake")
  local failed = false
  do async.loop()
  catch
    failed = error is async.OperationError
  end
  test.assert(failed and unwound and not returned and native_closed,
      "failed native token wake stranded sleep cleanup")
  test.assert(sleeper:status():has_cancelled(),
      "failed native token wake lost shutdown cancellation")
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    timer.sleep(0)
    test.assert(native_handle_count() == baseline_handles,
        "failed sleep left native state in the next Runtime")
  end)
end

function test_timer_ticker_replaces_cancelled_waiter_before_unwind(
    _context: test.Context)
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    local ticker = timer.ticker(60000)
    defer ticker:close()
    local unwound, delivered = false, false
    local old = async.run<|value, value|>(function (): value
      defer unwound = true
      ticker:tick()
      delivered = true
      return nil
    end)
    task_support.cleanup_task(old, "replaced Ticker waiter cleanup")
    while old:status():as_string() == "ready" do timer.yield() end
    test.assert(old:status():as_string() == "waiting",
                "old Ticker waiter did not suspend")

    old:cancel(async.CancellationReason.simple("replace Ticker waiter"))
    test.assert(not unwound, "Ticker cancellation unwound its waiter inline")
    local observer = async.run<|value, value|>(function (): value
      defer ticker:close()
      async.join(old)
      test.assert(unwound and old:status():has_cancelled() and not delivered,
                  "old Ticker waiter did not unwind through cancellation")
      local rejected = false
      do
        ticker:tick()
      catch
        rejected = error == "Ticker already has a waiting Task"
      end
      test.assert(rejected,
                  "old waiter cleanup detached the replacement or changed its diagnostic")
      return nil
    end)
    task_support.cleanup_task(observer, "replacement Ticker observer cleanup")

    -- No scheduler turn separates cancellation from this direct replacement.
    -- The observer closes the long-lived timer after checking its reservation.
    test.assert(not ticker:tick(), "replacement did not observe the observer's close")
    async.join(observer)
    test.assert(observer:status():has_succeeded(),
                "replacement Ticker observer failed")
    test.assert(native_handle_count() == baseline_handles,
                "replacement Ticker retained its native handle")
  end)
end

function test_timer_cancellation_precedes_competing_waiter_error(
    _context: test.Context)
  runtime_test.run(function ()
    local baseline_handles = native_handle_count()
    local ticker = timer.ticker(60000)
    defer ticker:close()
    local ticked = true
    local waiter = async.run<|value, value|>(function (): value
      ticked = ticker:tick()
      return nil
    end)
    task_support.cleanup_task(waiter, "cancelled competitor Ticker waiter cleanup")
    while waiter:status():as_string() == "ready" do timer.yield() end
    test.assert(waiter:status():as_string() == "waiting",
                "Ticker waiter did not suspend before the cancelled competitor")

    local reason = async.CancellationReason<|value|>.simple("cancelled tick caller")
    local observed: value = nil
    local close_completed = false
    local competitor = async.run<|value, value|>(function (): value
      async.running():cancel(reason)
      do
        ticker:tick()
      catch
        observed = error
      end
      ticker:close()
      close_completed = true
      return nil
    end)
    task_support.cleanup_task(competitor, "cancelled Ticker competitor cleanup")
    async.join(competitor)
    local cancelled, actual? = competitor:status():has_cancelled()
    test.assert(observed == reason and cancelled and actual == reason,
                "competing Ticker diagnostic took priority over pending cancellation")
    test.assert(close_completed,
                "pending cancellation prevented Ticker ownership cleanup")
    async.join(waiter)
    test.assert(waiter:status():has_succeeded() and not ticked,
                "cancelled caller's close did not release the existing Ticker waiter")
    test.assert(native_handle_count() == baseline_handles,
                "cancelled Ticker close retained its native handle")
  end)
end
