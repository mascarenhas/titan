-- Delays, yields and tickers of titan.timer on every target. Native timers
-- are uv handles that must close before a sleep or ticker returns: the
-- timers contributor counts them natively (native_timers) and holds the cases
-- that drive libuv or io directly. The browser has no native timers; the
-- async scheduler gate (spec/stdlib/titan/async/browser_tests) counts its
-- JavaScript timers instead.
local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local timer = import "timer"
local gc = import "gc"
local task_support = import "support.async.titan"

-- Check that the native timer count is `delta` above `baseline`, where the
-- target has native timers.
local function check_native_timers(baseline: integer?, delta: integer, message: string)
  const count? = native_timers()
  if baseline ~= nil and count ~= nil then test.assert(count == baseline + delta, message) end
end

function test_timer_yield_and_sleep(_context: test.Context)
  runtime_test.run(function ()
    const baseline? = native_timers()
    timer.yield()
    timer.sleep(0)
    check_native_timers(baseline, 0, "zero sleep returned before its native timer closed")
    timer.sleep(2)
    check_native_timers(baseline, 0, "sleep returned before its native timer closed")

    local rejected = false
    do
      timer.sleep(-1)
    catch
      const failure = error as async.OperationError
      test.assert(failure.operation == "timer.sleep" and failure.name == "EINVAL",
                  "negative sleep reported the wrong operation or native error")
      rejected = true
    end
    test.assert(rejected, "negative sleep was accepted")
    check_native_timers(baseline, 0, "negative sleep initialized a native timer")
  end)
end

function test_timer_ticker_waited_and_retained_ticks(
    _context: test.Context)
  runtime_test.run(function ()
    const baseline? = native_timers()
    const ticker = timer.ticker(1)
    defer ticker:close()

    local count = 0
    for _ = 1, 3 do
      gc.collect()
      if ticker:tick() then count = count + 1 end
      gc.collect()
    end
    test.assert(count == 3, "Ticker lost a waited tick")

    -- A recurring timer retains one pending fact, not an accumulated count.
    timer.sleep(8)
    test.assert(ticker:tick(),
                "Ticker did not retain its latest unwaited tick")

    ticker:close()
    ticker:close()
    test.assert(not ticker:tick(), "closed Ticker produced another tick")
    check_native_timers(baseline, 0, "Ticker close returned before native retirement")
  end)
end

function test_timer_ticker_pending_close_and_invalid_period(
    _context: test.Context)
  runtime_test.run(function ()
    const baseline? = native_timers()
    const ticker = timer.ticker(10000)
    defer ticker:close()
    local ticked = true
    const waiter = async.run<|value, value|>(function (): value
      ticked = ticker:tick()
      return nil
    end)
    task_support.cleanup_task(waiter, "ticker waiter cleanup")

    while waiter:status():as_string() == "ready" do timer.yield() end
    test.assert(waiter:status():as_string() == "waiting",
                "Ticker waiter did not suspend")

    local competing_waiter_rejected = false
    do
      ticker:tick()
    catch
      competing_waiter_rejected = error == "Ticker already has a waiting Task"
    end
    test.assert(competing_waiter_rejected,
                "Ticker accepted a second waiting Task")

    gc.collect()
    ticker:close()
    gc.collect()
    while task_support.active(waiter) do timer.yield() end
    test.assert(waiter:status():as_string() == "succeeded",
                "closing Ticker failed its waiter")
    test.assert(not ticked, "closing Ticker resumed its waiter with true")

    local invalid = false
    do
      timer.ticker(0)
    catch
      invalid = error == "ticker interval must be positive"
    end
    test.assert(invalid, "Ticker accepted a nonpositive interval")
    check_native_timers(baseline, 0, "closed or rejected Ticker left a native handle")
  end)
end

function test_timer_sleep_owner_survives_collection_until_close(
    _context: test.Context)
  runtime_test.run(function ()
    const baseline? = native_timers()
    local resumed = false
    local unwound = false
    const sleeper = async.run<|value, value|>(function (): value
      defer unwound = true
      timer.sleep(60000)
      resumed = true
      return nil
    end)
    task_support.cleanup_task(sleeper, "collected timer owner cleanup")
    while sleeper:status():as_string() == "ready" do timer.yield() end
    test.assert(sleeper:status():as_string() == "waiting",
                "one-shot timer did not suspend")
    check_native_timers(baseline, 1, "accepted sleep did not own its native timer")

    gc.collect()
    const reason = async.CancellationReason<|value|>.simple("close collected timer")
    sleeper:cancel(reason)
    test.assert(not unwound, "sleep cancellation entered its Task inline")
    gc.collect()
    async.join(sleeper)
    local cancelled, actual? = sleeper:status():has_cancelled()
    test.assert(cancelled and actual == reason and unwound and not resumed,
                "collected timer owner lost its close continuation")
    check_native_timers(baseline, 0, "cancelled sleep retained its native timer")
  end)
end

function test_timer_ticker_replaces_cancelled_waiter_before_unwind(
    _context: test.Context)
  runtime_test.run(function ()
    const baseline? = native_timers()
    const ticker = timer.ticker(60000)
    defer ticker:close()
    local unwound, delivered = false, false
    const old = async.run<|value, value|>(function (): value
      defer unwound = true
      ticker:tick()
      delivered = true
      return nil
    end)
    task_support.cleanup_task(old, "replaced Ticker waiter cleanup")
    while old:status():as_string() == "ready" do timer.yield() end
    test.assert(old:status():as_string() == "waiting",
                "old Ticker waiter did not suspend")

    old:cancel(async.CancellationReason.simple("replace Ticker waiter"))
    test.assert(not unwound, "Ticker cancellation unwound its waiter inline")
    const observer = async.run<|value, value|>(function (): value
      defer ticker:close()
      async.join(old)
      test.assert(unwound and old:status():has_cancelled() and not delivered,
                  "old Ticker waiter did not unwind through cancellation")
      local rejected = false
      do
        ticker:tick()
      catch
        rejected = error == "Ticker already has a waiting Task"
      end
      test.assert(rejected,
                  "old waiter cleanup detached the replacement or changed its diagnostic")
      return nil
    end)
    task_support.cleanup_task(observer, "replacement Ticker observer cleanup")

    -- No scheduler turn separates cancellation from this direct replacement.
    -- The observer closes the long-lived timer after checking its reservation.
    test.assert(not ticker:tick(), "replacement did not observe the observer's close")
    async.join(observer)
    test.assert(observer:status():has_succeeded(),
                "replacement Ticker observer failed")
    check_native_timers(baseline, 0, "replacement Ticker retained its native handle")
  end)
end

function test_timer_cancellation_precedes_competing_waiter_error(
    _context: test.Context)
  runtime_test.run(function ()
    const baseline? = native_timers()
    const ticker = timer.ticker(60000)
    defer ticker:close()
    local ticked = true
    const waiter = async.run<|value, value|>(function (): value
      ticked = ticker:tick()
      return nil
    end)
    task_support.cleanup_task(waiter, "cancelled competitor Ticker waiter cleanup")
    while waiter:status():as_string() == "ready" do timer.yield() end
    test.assert(waiter:status():as_string() == "waiting",
                "Ticker waiter did not suspend before the cancelled competitor")

    const reason = async.CancellationReason<|value|>.simple("cancelled tick caller")
    local observed: value = nil
    local close_completed = false
    const competitor = async.run<|value, value|>(function (): value
      async.running():cancel(reason)
      do
        ticker:tick()
      catch
        observed = error
      end
      ticker:close()
      close_completed = true
      return nil
    end)
    task_support.cleanup_task(competitor, "cancelled Ticker competitor cleanup")
    async.join(competitor)
    local cancelled, actual? = competitor:status():has_cancelled()
    test.assert(observed == reason and cancelled and actual == reason,
                "competing Ticker diagnostic took priority over pending cancellation")
    test.assert(close_completed,
                "pending cancellation prevented Ticker ownership cleanup")
    async.join(waiter)
    test.assert(waiter:status():has_succeeded() and not ticked,
                "cancelled caller's close did not release the existing Ticker waiter")
    check_native_timers(baseline, 0, "cancelled Ticker close retained its native handle")
  end)
end

-- Tickers are Runtime-bound: one left open when its Runtime closes no longer
-- ticks, and closing it later does nothing.
function test_timer_ticker_from_an_earlier_runtime(_context: test.Context)
  local leftover: timer.Ticker? = nil
  runtime_test.run(function ()
    leftover = timer.ticker(60000)
  end)
  runtime_test.run(function ()
    const ticker = leftover
    test.assert(not ticker:tick(), "a Ticker from an earlier Runtime ticked")
    ticker:close()
    test.assert(not ticker:tick(), "closing an earlier Runtime's Ticker revived it")
  end)
end
