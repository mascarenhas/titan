-- Executable-only module initialized independently by each Lua worker state.
local async = import "async"
local gc = import "gc"
local uv = import "uv"

local record ExternalWakeFixture
  loop: uv.loop_t?
  wake: uv.external_wake_t?
  -- Host-owned int[4]: detach, run, loop-close statuses, then callback count.
  const results: foreign *int
end

local receiver: async.Receiver? = nil
local worker: async.Task<|nil, value|>? = nil
local received = 0
local wake_fixture: ExternalWakeFixture? = nil

function initialized(): boolean
  return receiver ~= nil
end

function retained_handle(): foreign *void
  return receiver:handle()
end

function bootstrap(reply: value, quiescence: value): foreign *void
  -- Lua supplies the lightuserdata transferred from the host. Only this narrow
  -- fixture boundary converts it back to the statically typed borrowed handle.
  const destination = reply as foreign *void
  const gate = quiescence as foreign *void
  const wait: foreign function(*void): void = uv.native_sem_wait
  receiver = async.receiver()
  const owner = receiver as async.Receiver
  worker = async.run<|nil, value|>(function (): nil
    local response: async.TransferValue? = nil
    defer do
      -- Receipt can precede the sender's return from async.send. The host
      -- posts only after its last send has returned and keeps the gate alive
      -- until this worker is joined.
      wait(gate)
      owner:close()
      if response ~= nil then async.send(destination, response) end
    end
    async.send(destination, async.TransferValue.is_string("ready"))
    while true do
      const item = owner:wait()
      gc.collect()
      gc.collect()
      if item is string then
        const bytes: string = item
        if bytes == "close" then
          response = async.TransferValue.is_string("closed")
          return nil
        end
        if bytes == "stop" then
          response = async.TransferValue.is_integer(received)
          return nil
        end
        received = received + 1
        async.send(destination, async.TransferValue.is_string(bytes))
      else raise "Receiver fixture expected a string message"
      end
    end
    return nil
  end)
  return owner:handle()
end

function drive(): integer
  async.loop()
  case worker:status()
  when failed(failure) then failure:raise()
  when succeeded() then return received
  else raise "Receiver fixture worker did not finish normally"
  end
  return received
end

function fail_bootstrap()
  receiver = async.receiver()
  defer receiver:close()
  raise "Receiver fixture bootstrap failed"
end

local function require_wake_status(status: integer)
  if status ~= 0 then raise "External wake fixture status: " .. status end
end

local function finalize_wake_fixture(fixture: ExternalWakeFixture)
  const loop? = fixture.loop
  fixture.loop = nil
  if loop == nil then return end

  -- lua_close runs the later-registered external_wake_t finalizer first.
  -- Observe its detached core BEFORE closing/driving the underlying handle:
  -- otherwise the handle's close_handler could mask a missing GC detach.
  if fixture.wake ~= nil then
    const status = fixture.wake:reserve(705)
    fixture.results[0] = status
  end
  uv.walk(loop, function (handle: uv.handle_t, _argument: value)
    if not uv.is_closing(handle) then uv.close(handle) end
  end, nil)
  fixture.results[1] = uv.run(loop)
  fixture.results[2] = uv.loop_close(loop)
end

-- The child Lua caller receives borrowed pointers but never passes arbitrary
-- lightuserdata back through a typed raw-pointer argument. All reserve/activate
-- operations stay on this compiled public-UV boundary in the owning state.
-- The host keeps results rooted until state:close() finishes; finalizer errors
-- are Lua warnings, so it checks the recorded statuses after lua_close returns.
function external_wake_targets(results: value):
    (foreign *void, foreign *void, foreign *void, foreign *void)
  const fixture = ExternalWakeFixture(nil, nil, results as foreign *int)
  wake_fixture = fixture
  -- Register cleanup before native acquisition and before constructing wake.
  -- Reverse finalization detaches wake without driving, then retires its loop.
  gc.finalizable(fixture, finalize_wake_fixture)
  const loop = uv.loop_t()
  const status = uv.loop_init(loop)
  if status == 0 then fixture.loop = loop end
  require_wake_status(status)
  const wake = uv.external_wake_t()
  fixture.wake = wake
  require_wake_status(uv.external_wake_init(loop, wake,
    function (_: uv.external_wake_t)
      fixture.results[3] = (fixture.results[3] as integer) + 1
    end))
  -- Pre-populate the retired-target cache before reserving the returned targets
  -- so independent-state teardown exercises warm-cache reuse plus cached entries
  -- surviving alongside retained producer references through lua_close.
  local s_w1, w1 = wake:reserve(691)
  local s_w2, w2 = wake:reserve(692)
  local s_w3, w3 = wake:reserve(693)
  local s_w4, w4 = wake:reserve(694)
  local s_w5, w5 = wake:reserve(695)
  local s_w6, w6 = wake:reserve(696)
  require_wake_status(s_w1)
  require_wake_status(s_w2)
  require_wake_status(s_w3)
  require_wake_status(s_w4)
  require_wake_status(s_w5)
  require_wake_status(s_w6)
  require_wake_status(wake:activate(w2))
  require_wake_status(wake:activate(w4))
  require_wake_status(wake:activate(w6))
  require_wake_status(wake:unregister(w1))
  require_wake_status(wake:unregister(w2))
  require_wake_status(wake:unregister(w3))
  require_wake_status(wake:unregister(w4))
  require_wake_status(wake:unregister(w5))
  require_wake_status(wake:unregister(w6))

  local s1, prepared = wake:reserve(701)
  require_wake_status(s1)
  if prepared == nil then raise "External wake fixture returned NULL prepared target" end
  local s2, armed = wake:reserve(702)
  require_wake_status(s2)
  if armed == nil then raise "External wake fixture returned NULL armed target" end
  require_wake_status(wake:activate(armed))
  local s3, pending = wake:reserve(703)
  require_wake_status(s3)
  if pending == nil then raise "External wake fixture returned NULL pending target" end
  require_wake_status(wake:activate(pending))
  local s4, unretained = wake:reserve(704)
  require_wake_status(s4)
  if unretained == nil then raise "External wake fixture returned NULL active target" end
  require_wake_status(wake:activate(unretained))
  return prepared, armed, pending, unretained
end
