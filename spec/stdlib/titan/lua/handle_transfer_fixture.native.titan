-- Executable-only fixture for programmer-owned native handle transfer.
local async = import "async"
local gc = import "gc"
local protobuf = import "protobuf"
local reflect = import "reflect"
foreign import "handle_transfer_fixture.h"

record Pipe
  local resource: foreign *void
  local finalizer_probe: foreign *void
end

function Pipe:close()
  local resource = self.resource
  self.resource = nil
  self.finalizer_probe = nil
  if resource then ffi.titan_test_record_handle_close(resource) end
end

local function finalize_pipe(pipe: Pipe)
  if pipe.finalizer_probe then
    ffi.titan_test_record_handle_finalized(pipe.finalizer_probe)
  end
  pipe:close()
end

function Pipe.new(resource: foreign *void): Pipe
  if not resource then raise "native handle fixture requires a resource" end
  local pipe: Pipe = { resource = resource, finalizer_probe = resource }
  gc.finalizable(pipe, finalize_pipe)
  return pipe
end

local function pipe_fields(): const {reflect.Type}
  return {reflect.Type.is_foreign_pointer(reflect.Type.is_foreign_void(), {})}
end

function Pipe:to_transfer_payload(): string
  local resource = self.resource
  if not resource then raise "native handle fixture is detached" end
  local payload = protobuf.serialize_fields(pipe_fields(), resource)
  -- Only the wrapper moves close authority; the byte transport never owns it.
  self.resource = nil
  return payload
end

function Pipe.from_transfer_payload(payload: string): Pipe
  local resource = (protobuf.deserialize_fields(payload, pipe_fields())) as foreign *void
  return Pipe(resource)
end

function Pipe:read_byte(): integer
  if not self.resource then raise "native handle fixture is closed" end
  return ffi.titan_test_record_handle_read(self.resource)
end

local function detached_payload(resource: foreign *void): async.TransferValue
  local pipe = Pipe(resource)
  return async.TransferValue.from_value(pipe)
end

function send_detached(destination: value, resource: value)
  -- Only this Lua/lightuserdata boundary performs raw-pointer assertions.
  local packet = detached_payload(resource as foreign *void)
  -- The source wrapper's frame is gone before collection. Its finalizer must
  -- run while the token is retained and must observe the explicit detachment.
  gc.collect()
  gc.collect()
  async.send(destination as foreign *void, packet)
end

function resource_new(): foreign *void
  return ffi.titan_test_record_handle_new()
end

function resource_destroy(resource: foreign *void)
  ffi.titan_test_record_handle_destroy(resource)
end

function close_calls(resource: foreign *void): integer
  return ffi.titan_test_record_handle_close_calls(resource)
end

function finalizers(resource: foreign *void): integer
  return ffi.titan_test_record_handle_finalizers(resource)
end
