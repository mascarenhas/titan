local async = import "async"
local gc = import "gc"
local strings = import "string"
local protobuf = import "protobuf"
local reflect = import "reflect"
foreign import "lua.h"
foreign import "limits.h"
foreign import "float.h"
foreign import "titan/ffi.h"

record TransferRecord
  const number: integer
  text: string
  entries: {integer}
end

record DefaultRecord
  const number: integer
end

local constructions = 0

record CustomRecord
  const number: integer
end

function CustomRecord.new(): CustomRecord
  constructions = constructions + 1
  return { number = 407 }
end

function construction_count(): integer
  return constructions
end

union TransferUnion
  empty()
  present(record: TransferRecord, label: string)
end

record PrivateField
  public_field: integer
  local private_field: integer
end

local foreign function transfer_echo(state: *lua_State): int
  return ffi.lua_gettop(state)
end

function policies(pointer: value): (...: async.TransferValue)
  return async.TransferValue.is_nil(), async.TransferValue.is_boolean(false),
    async.TransferValue.is_integer(-73), async.TransferValue.is_float(2.5),
    async.TransferValue.is_string(strings.rep("policy\0bytes", 4096)),
    async.TransferValue.is_pointer(pointer as foreign *void),
    async.TransferValue.is_function(transfer_echo),
    async.TransferValue.is_record("explicit", "explicit.Record", "record\0wire"),
    async.TransferValue.is_union("explicit", "explicit.Union", "union\0wire")
end

function state_policy(pointer: value): async.TransferValue
  return async.TransferValue.is_lua_state(pointer as foreign *lua_State)
end

function record_value(number: integer): TransferRecord
  return TransferRecord(number, strings.rep("nominal\0bytes", 4096), {1, 2, 3})
end

function union_value(number: integer): TransferUnion
  return TransferUnion.present(record_value(number), "union\0label")
end

function private_value(): PrivateField
  return PrivateField(1, 2)
end

function closure_constant(): integer
  return 37
end

function closure_text(): function (): string
  local const text = strings.rep("closure\0text", 1024)
  return function (): string return text end
end

function closure_counter(): function (): integer
  local count = 5
  return function (): integer
    count = count + 1
    return count
  end
end

function closure_mutable_text(): function (): string
  local text = "a"
  return function (): string
    text = text .. "b"
    return text
  end
end

function closure_shared_boxes(): function (): integer
  local count = 5
  local first = function (): integer
    count = count + 1
    return count
  end
  local second = function (): integer
    count = count + 10
    return count
  end
  return function (): integer
    count = count + 100
    first()
    second()
    return count
  end
end

function closure_nominal(): function (): integer
  local const item = record_value(53)
  return function (): integer return item.number + item.entries[3] end
end

function closure_captured_policy(): function (): integer
  local const policy = async.TransferValue.is_integer(67)
  return function (): integer
    case policy
    when is_integer(number) then return number
    else raise "captured TransferValue was unwrapped during closure transfer" end
  end
end

function closure_adjusted(): function (integer, value): value
  local count = 3
  local source = function (amount: integer): integer
    count = count + amount
    return count
  end
  local adjusted: function (integer, value): value = source
  return adjusted
end

function DefaultRecord:read_number(): integer
  return self.number
end

function closure_bound_method(): function (): integer
  local item = DefaultRecord(61)
  return item:read_number
end

function closure_policy(): async.TransferValue
  return async.TransferValue.from_value(closure_counter())
end

function closure_array(): function (): integer
  local values = {1, 2, 3}
  return function (): integer return values[1] end
end

function closure_private_nominal(): function (): integer
  local item = private_value()
  return function (): integer return item.public_field end
end

function closure_cycle(): function (): integer
  local recurse: (function (): integer)? = nil
  recurse = function (): integer return recurse() end
  return recurse
end

function closure_native_numbers(): function (): boolean
  local wide: foreign unsigned long long = ffi.ULLONG_MAX
  local optional: (foreign unsigned long long)? = ffi.ULLONG_MAX
  local precise: foreign long double = (1 as foreign long double) + ffi.LDBL_EPSILON
  local maximum: foreign long double = ffi.LDBL_MAX
  return function (): boolean
    local exact = wide == ffi.ULLONG_MAX and optional ~= nil
      and (optional as foreign unsigned long long) == ffi.ULLONG_MAX
      and precise == (1 as foreign long double) + ffi.LDBL_EPSILON
      and maximum == ffi.LDBL_MAX
    wide = 0
    optional = nil
    precise = 0
    maximum = 0
    return exact
  end
end

local closure_global_count = 100

function closure_global_reset(number: integer)
  closure_global_count = number
end

function closure_global(): integer
  closure_global_count = closure_global_count + 1
  return closure_global_count
end

function closure_managed_pointer(): function (): boolean
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  local item: value = DefaultRecord(83)
  if ffi.lua_checkstack(L, 1) == 0 then raise "managed capture fixture stack" end
  ffi.lua_pushtvalue(L, item)
  local pointer = ffi.lua_togco(L, -1) as foreign *Udata
  return function (): boolean return pointer ~= nil end
end

function closure_optional_managed_pointer(present: boolean): function (): boolean
  local pointer: (foreign *Udata)? = nil
  if present then
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    local item: value = DefaultRecord(89)
    if ffi.lua_checkstack(L, 1) == 0 then raise "managed capture fixture stack" end
    ffi.lua_pushtvalue(L, item)
    pointer = ffi.lua_togco(L, -1) as foreign *Udata
  end
  return function (): boolean return pointer == nil end
end

local payload_encodes = 0
local payload_decodes = 0

function payload_hook_counts(): (integer, integer)
  return payload_encodes, payload_decodes
end

record PayloadRecord
  local number: integer
  local text: string
end

local function payload_fields(): const {reflect.Type}
  return {reflect.Type.is_integer(), reflect.Type.is_string(),
    reflect.Type.is_boolean(), reflect.Type.is_nil()}
end

function PayloadRecord:to_transfer_payload(): string
  payload_encodes = payload_encodes + 1
  gc.collect()
  return protobuf.serialize_fields(payload_fields(), self.number, self.text, false, nil)
end

function PayloadRecord.from_transfer_payload(payload: string): PayloadRecord
  payload_decodes = payload_decodes + 1
  local number: integer, text: string, flag: boolean, empty: value =
    protobuf.deserialize_fields(payload, payload_fields())
  gc.collect()
  if flag or empty ~= nil then raise "record payload metadata changed" end
  return PayloadRecord(number, text)
end

function PayloadRecord:number_value(): integer
  return self.number
end

function PayloadRecord:text_value(): string
  return self.text
end

function payload_record_value(number: integer): PayloadRecord
  return PayloadRecord(number, strings.rep("payload\0bytes", 1024))
end

record NestedPayload
  local item: PayloadRecord
end

function NestedPayload:to_transfer_payload(): string
  gc.collect()
  return self.item:to_transfer_payload()
end

function NestedPayload.from_transfer_payload(payload: string): NestedPayload
  gc.collect()
  return NestedPayload(PayloadRecord.from_transfer_payload(payload))
end

function NestedPayload:number_value(): integer
  return self.item:number_value()
end

function nested_payload_value(number: integer): NestedPayload
  return NestedPayload(payload_record_value(number))
end

record FailingPayload
  local phase: string
end

function FailingPayload:to_transfer_payload(): string
  if self.phase == "encode" then raise "record hook encode failure" end
  return self.phase
end

function FailingPayload.from_transfer_payload(payload: string): FailingPayload
  if payload == "decode" then raise "record hook decode failure" end
  return FailingPayload(payload)
end

function failing_payload_value(phase: string): FailingPayload
  return FailingPayload(phase)
end

record CyclicPayload
  local number: integer
end

function CyclicPayload:to_transfer_payload(): string
  local packet = async.TransferValue.from_value(function (): integer
    return self.number
  end)
  return ""
end

function CyclicPayload.from_transfer_payload(payload: string): CyclicPayload
  raise "cyclic payload should not reach reconstruction"
end

function cyclic_payload_value(): CyclicPayload
  return CyclicPayload(19)
end

function closure_custom_record(): function (): integer
  local item = payload_record_value(83)
  return function (): integer return item:number_value() end
end

function closure_custom_policy(): function (): integer
  local item = async.TransferValue.from_value(payload_record_value(89))
  return function (): integer
    case item
    when is_record_payload(_module, _name, _data) then
      local restored: PayloadRecord = item:to_value()
      return restored:number_value()
    else raise "captured custom TransferValue policy was unwrapped" end
  end
end

record EnvelopeWithPayload
  tag: string
  item: PayloadRecord
  items: {PayloadRecord}
end

union ChoiceWithPayload
  empty()
  wrapped(item: PayloadRecord, count: integer)
end

function envelope_payload_value(number: integer): EnvelopeWithPayload
  return EnvelopeWithPayload("env", payload_record_value(number), {
    payload_record_value(number + 1),
    payload_record_value(number + 2),
  })
end

function choice_payload_value(number: integer): ChoiceWithPayload
  return ChoiceWithPayload.wrapped(payload_record_value(number), number * 2)
end

