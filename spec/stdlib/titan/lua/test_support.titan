local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local fs = import "fs"
local reflect = import "reflect"
local thread = import "thread"
foreign import "lua.h"
foreign import "titan/ffi.h"
foreign import "source_fixture.h"

local type CheckedAction = function (): ()
local type PackageSearcher = function (string): (value, value)

local function make_source_fifo(path: string)
  test.assert(ffi.titan_lua_test_mkfifo(path) == 0,
              "could not create source-search FIFO")
end

local record PackageSearchState
  local package_table: {string: value}
  local searchers: {integer: value}
  local saved_path: string
  local custom_index: integer
end

local function find_literal(subject: string, needle: string): integer?
  if #needle == 0 then return 1 end
  if #needle > #subject then return nil end
  local bytes = subject as foreign const *unsigned char
  local wanted = needle as foreign const *unsigned char
  local first = 0
  while first <= #subject - #needle do
    local equal = true
    local offset = 0
    while offset < #needle do
      if bytes[first + offset] ~= wanted[offset] then
        equal = false
        break
      end
      offset = offset + 1
    end
    if equal then return first + 1 end
    first = first + 1
  end
  return nil
end

local function caught_string(action: CheckedAction): string?
  do
    action()
  catch
    if error is string then return error as string end
    return nil
  end
  return nil
end

local function temporary_file(_: test.Context,
                              suffix: string?): string
  local temporary = fs.tmpname()
  local path = temporary
  if suffix then
    path = temporary .. suffix
    fs.rename(temporary, path)
  end
  runtime_test.cleanup(function ()
    fs.unlink(path)
  end)
  return path
end

local function lua_package_table(): {string: value}
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  if ffi.lua_checkstack(L, 1) == 0 then
    raise "cannot reserve Lua stack for native package lookup"
  end
  ffi.lua_getglobal(L, "package")
  if ffi.lua_type(L, -1) ~= ffi.LUA_TTABLE then
    raise "global 'package' is not a table"
  end
  local raw_package: value = ffi.lua_totvalue(L, -1)
  return raw_package as {string: value}
end

local function install_miss_search(path: string,
                                   diagnostic: string): PackageSearchState
  local package_table = lua_package_table()
  local raw_path: value = package_table["path"]
  if not (raw_path is string) then
    raise "'package.path' is not a string"
  end
  local raw_searchers: value = package_table["searchers"]
  if not (raw_searchers is {integer: value}) then
    raise "'package.searchers' is not a table"
  end
  local searchers = raw_searchers as {integer: value}
  local index = 1
  while searchers[index] ~= nil do index = index + 1 end

  local custom: PackageSearcher =
    function (_: string): (value, value)
      return diagnostic, nil
    end
  package_table["path"] = path
  searchers[index] = custom
  return PackageSearchState.new(
    package_table, searchers, raw_path as string, index)
end

local function PackageSearchState:restore()
  self.searchers[self.custom_index] = nil
  self.package_table["path"] = self.saved_path
end

local function temporary_directory(_: test.Context): string
  local root = fs.tmpname()
  fs.unlink(root)
  fs.mkdir(root)
  runtime_test.cleanup(function () fs.rmdir(root) end)
  return root
end

local function owned_file(_: test.Context, path: string,
                          contents: string)
  runtime_test.cleanup(function () fs.unlink(path) end)
  fs.write_file(path, contents)
end

local function package_loaded_table(
    package_table: {string: value}): {string: value}
  local raw_loaded: value = package_table["loaded"]
  if not (raw_loaded is {string: value}) then
    raise "'package.loaded' is not a table"
  end
  return raw_loaded as {string: value}
end

-- Thread entry for late nominal registration. This module does not import the
-- probed record's declaring module, so a worker restoring this entry starts
-- without that nominal: the first resolution misses, then decoding the received
-- structural packet loads the declaring module and reconstructs the record with
-- the descriptor found after that load, after which the name resolves.
local function late_nominal_probe(packets: thread.Receiver<|value|>, name: string): integer
  case reflect.NamedType(name):resolve()
  when is_value() then
  else raise "nominal was registered before its packet arrived: " .. name
  end
  local item = packets:receive()
  case reflect.NamedType(name):resolve()
  when is_record(descriptor) then
    if descriptor.name ~= name then raise "late registration resolved another record" end
  else raise "a name registered after a miss did not resolve: " .. name
  end
  case reflect.inspect(item)
  when is_record(record_value) then
    if record_value.type.name ~= name then
      raise "decoded a different record: " .. record_value.type.name
    end
    return record_value:get(1)
  else raise "decoded packet is not a record"
  end
end

-- Spawn here, not in a test module: the erased spawn parameter realizes a
-- callable adapter in the spawning module, and the worker loads that module.
local function spawn_late_nominal_probe(packets: thread.Receiver<|value|>,
                                        name: string): thread.Thread<|integer|>
  return thread.spawn_two(late_nominal_probe, packets, name)
end
