local gclib = import "gc"
foreign import "lua.h"

-- Exact C callbacks build foreign values which Lua source cannot create.
-- They only access the independent state supplied by its protected call.
foreign function state_echo(state: *lua_State): int
  return ffi.lua_gettop(state)
end

foreign function state_userdata(state: *lua_State): int
  local pointer = ffi.lua_newuserdatauv(state, 1 as foreign size_t, 0)
  local bytes = pointer as foreign *unsigned char
  bytes[0] = 73 as foreign unsigned char
  return 1
end

function test_lua_independent_preserves_borrowed_state_stack(
    _context: test.Context)
  runtime_test.run(function ()
    local state = tlua.new()
    defer state:close()
    local transferred: async.TransferValue = state:run(
      "local thread = coroutine.running(); return thread")
    case transferred
    when is_lua_state(remote) then
      local top: integer = ffi.lua_gettop(remote)
      test.assert(ffi.lua_checkstack(remote, 1) ~= 0)
      ffi.lua_pushinteger(remote, 73)
      defer ffi.lua_settop(remote, top)
      local results: {async.TransferValue} = { state:run("return 1, 'copied'") }
      test.assert(#results == 2 and transfer_integer(results[1]) == 1 and
                  transfer_string(results[2]) == "copied")
      test.assert(ffi.lua_gettop(remote) as integer == top + 1 and
                  ffi.lua_tointegerx(remote, -1, nil) == 73,
                  "successful call changed a preexisting remote stack value")
      common.assert_raises_contains(function ()
        state:run_async("error('saved remote stack')")
      end, "saved remote stack")
      test.assert(ffi.lua_gettop(remote) as integer == top + 1 and
                  ffi.lua_tointegerx(remote, -1, nil) == 73,
                  "failed asynchronous call changed the saved remote stack")
      local result: async.TransferValue = state:run_async("return 42")
      test.assert(transfer_integer(result) == 42)
      test.assert(ffi.lua_gettop(remote) as integer == top + 1 and
                  ffi.lua_tointegerx(remote, -1, nil) == 73,
                  "successful asynchronous call changed the saved remote stack")
    else raise "could not borrow the independent main Lua state"
    end
  end)
end

foreign function state_count_finalizer(state: *lua_State): int
  local counter = ffi.lua_touserdata(state, 1) as foreign *int
  counter[0] = counter[0] + 1
  return 0
end

local function transfer_integer(candidate: async.TransferValue): integer
  case candidate
  when is_integer(number) then return number
  else raise "expected transferred integer"
  end
end

local function transfer_string(candidate: async.TransferValue): string
  case candidate
  when is_string(bytes) then return bytes
  else raise "expected transferred string"
  end
end

local function assert_transfer_nil(candidate: async.TransferValue)
  case candidate
  when is_nil() then
  else raise "expected transferred nil"
  end
end

local function assert_transfer_boolean(candidate: async.TransferValue,
                                      expected: boolean)
  case candidate
  when is_boolean(actual) then test.assert(actual == expected)
  else raise "expected transferred boolean"
  end
end

local function assert_state_reusable(state: tlua.Lua)
  local result: async.TransferValue = state:run("return 42")
  test.assert(transfer_integer(result) == 42,
              "failed call left the independent state unusable")
end

local function finalizable_state(counter: owned int[]): tlua.Lua
  local state = tlua.new()
  state:run([[
    local finish, counter = ...
    finalizer_probe = setmetatable({}, {
      __gc = function() finish(counter) end,
    })
  ]], "=state-finalizer", async.TransferValue.is_function(state_count_finalizer),
      async.TransferValue.is_pointer(counter as foreign *void))
  return state
end

local function abandon_state(counter: owned int[], close: boolean)
  local state = finalizable_state(counter)
  if close then
    state:close()
    state:close()
  end
end

function test_lua_independent_states_isolate_globals_and_load_libraries(
    _context: test.Context)
  local first = tlua.new()
  defer first:close()
  local second = tlua.new()
  defer second:close()
  first:run("independent_state_marker = 73")
  local values: {async.TransferValue} = { second:run([[
    return independent_state_marker, math.floor(4.8), string.upper('ok'),
           type(io.open), type(os.clock), type(debug.getinfo),
           type(package.loaded), type(coroutine.create), type(utf8.len)
  ]]) }
  test.assert(#values == 9)
  assert_transfer_nil(values[1])
  test.assert(transfer_integer(values[2]) == 4)
  test.assert(transfer_string(values[3]) == "OK")
  for index = 4, #values do
    local expected = "function"
    if index == 7 then expected = "table" end
    test.assert(transfer_string(values[index]) == expected)
  end
  local marker: async.TransferValue = first:run(
    "return independent_state_marker")
  test.assert(transfer_integer(marker) == 73)
  local host_marker: value = tlua.load("return independent_state_marker")()
  test.assert(host_marker == nil, "independent state changed host globals")
end

function test_lua_independent_transfer_scalars_and_binary_strings(
    _context: test.Context)
  local state = tlua.new()
  defer state:close()
  local values: {async.TransferValue} = { state:run("return ...", nil,
    async.TransferValue.is_nil(), async.TransferValue.is_boolean(false),
    async.TransferValue.is_boolean(true), async.TransferValue.is_integer(-73),
    async.TransferValue.is_float(2.5), async.TransferValue.is_string("a\0b"),
    async.TransferValue.is_nil()) }
  state:close()
  gclib.collect()
  test.assert(#values == 7, "transfer collapsed a nil position")
  assert_transfer_nil(values[1])
  assert_transfer_boolean(values[2], false)
  assert_transfer_boolean(values[3], true)
  test.assert(transfer_integer(values[4]) == -73)
  case values[5]
  when is_float(number) then test.assert(number == 2.5)
  else raise "floating-point result lost its Lua number tag"
  end
  test.assert(transfer_string(values[6]) == "a\0b",
              "returned string borrowed independent-state storage")
  assert_transfer_nil(values[7])
end

function test_lua_independent_binary_chunks_and_embedded_zero_source(
    _context: test.Context)
  local state = tlua.new()
  defer state:close()
  local dump = common.lua_helper([[
    return function() return string.dump(function(...) return ... end) end
  ]]) as function (): string
  local returned: async.TransferValue = state:run(dump(), "=independent-binary",
    async.TransferValue.is_string("binary\0argument"))
  test.assert(transfer_string(returned) == "binary\0argument")
  common.assert_raises_contains(function ()
    state:run("return 1\0return 2", "=independent-zero-source")
  end, "independent-zero-source")
  assert_state_reusable(state)
end

function test_lua_independent_foreign_functions_and_pointer_mappings(
    _context: test.Context)
  local state = tlua.new()
  defer state:close()
  local counter: owned int[] = foreign int.new_array(1)
  counter[0] = 12
  local values: {async.TransferValue} = { state:run([[
    local echo, make_userdata, pointer = ...
    saved_thread = coroutine.create(function() end)
    saved_userdata = make_userdata()
    return echo, pointer, saved_thread, saved_userdata, echo('a\0b', nil, 17)
  ]], "=state-pointers", async.TransferValue.is_function(state_echo),
      async.TransferValue.is_function(state_userdata),
      async.TransferValue.is_pointer(counter as foreign *void)) }
  test.assert(#values == 7)
  local expected_callback: foreign function (*lua_State): int = state_echo
  case values[1]
  when is_function(callback) then
    test.assert(callback == expected_callback)
  else raise "zero-upvalue C function was not transferred"
  end
  case values[2]
  when is_pointer(pointer) then
    test.assert(pointer == counter as foreign *void)
  else raise "light userdata was not transferred as a pointer"
  end
  case values[3]
  when is_lua_state(thread) then
    test.assert(thread ~= nil)
    local returned: async.TransferValue = state:run("return ...", nil,
      async.TransferValue.is_lua_state(thread))
    case returned
    when is_pointer(pointer) then
      test.assert(pointer == thread as foreign *void,
                  "Lua-state argument did not cross as light userdata")
    else raise "Lua-state argument was not represented by light userdata"
    end
  else raise "Lua thread was not transferred as a state pointer"
  end
  case values[4]
  when is_pointer(pointer) then
    local bytes = pointer as foreign *unsigned char
    test.assert(bytes[0] == 73,
                "full userdata transfer did not expose its payload")
  else raise "full userdata was not transferred as a pointer"
  end
  test.assert(transfer_string(values[5]) == "a\0b")
  assert_transfer_nil(values[6])
  test.assert(transfer_integer(values[7]) == 17)
  local echoed: async.TransferValue = state:run(
    "local echo = ...; return echo(19)", nil, values[1])
  test.assert(transfer_integer(echoed) == 19,
              "returned native function did not preserve its calling contract")
  common.assert_raises_contains(function ()
    state:run("return ...", nil, async.TransferValue.is_function(nil))
  end, "NULL")
  assert_state_reusable(state)
end

function test_lua_independent_errors_restore_stack_and_allow_reuse(
    context: test.Context)
  context:run("syntax", function (_: test.Context)
    local state = tlua.new()
    defer state:close()
    common.assert_raises_contains(function ()
      state:run("return )", "=independent-syntax")
    end, "independent-syntax")
    assert_state_reusable(state)
  end)
  context:run("runtime", function (_: test.Context)
    local state = tlua.new()
    defer state:close()
    common.assert_raises_contains(function ()
      state:run("error('independent runtime failure')", "=independent-error")
    end, "independent runtime failure")
    assert_state_reusable(state)
    common.assert_raises(function () state:run("error({})") end)
    assert_state_reusable(state)
    common.assert_raises(function () state:run("error(false)") end)
    assert_state_reusable(state)
    common.assert_raises(function ()
      state:run([[
        error(setmetatable({}, {
          __tostring = function() error('hostile tostring') end,
        }))
      ]])
    end)
    assert_state_reusable(state)
  end)
  context:run("unsupported_table", function (_: test.Context)
    local state = tlua.new()
    defer state:close()
    common.assert_raises(function ()
      state:run("return 'copied before failure', {}")
    end)
    assert_state_reusable(state)
  end)
  context:run("unsupported_lua_function", function (_: test.Context)
    local state = tlua.new()
    defer state:close()
    common.assert_raises(function ()
      state:run("return function() end")
    end)
    assert_state_reusable(state)
  end)
  context:run("unsupported_c_closure", function (_: test.Context)
    local state = tlua.new()
    defer state:close()
    common.assert_raises(function ()
      state:run("return string.gmatch('abc', '.')")
    end)
    assert_state_reusable(state)
  end)
end

function test_lua_independent_result_capacity_and_discarded_result_validation(
    _context: test.Context)
  local state = tlua.new()
  defer state:close()
  local results: {async.TransferValue} = { state:run([[
    local values = {}
    for i = 1, 200 do values[i] = i end
    return table.unpack(values)
  ]]) }
  test.assert(#results == 200, "independent result count was truncated")
  test.assert(transfer_integer(results[1]) == 1 and
              transfer_integer(results[200]) == 200)
  local wide_chunk = [[
    local values = {}
    for i = 1, 201 do values[i] = i end
    return table.unpack(values)
  ]]
  common.assert_raises(function ()
    local overflow: {async.TransferValue} = { state:run(wide_chunk) }
  end)
  assert_state_reusable(state)
  local first: async.TransferValue = state:run(wide_chunk)
  test.assert(transfer_integer(first) == 1,
              "finite result demand rejected a wide independent result run")
  state:run(wide_chunk)
  assert_state_reusable(state)
  common.assert_raises(function ()
    state:run("return 1, {}")
  end)
  assert_state_reusable(state)
  common.assert_raises(function ()
    local first: async.TransferValue = state:run("return 1, {}")
  end)
  assert_state_reusable(state)
  local empty: {async.TransferValue} = { state:run("return") }
  test.assert(#empty == 0)
end

function test_lua_independent_close_and_gc_close_exactly_once(
    _context: test.Context)
  local counter: owned int[] = foreign int.new_array(1)
  counter[0] = 0
  abandon_state(counter, true)
  test.assert(counter[0] == 1, "explicit close did not run Lua finalizers")
  gclib.collect()
  gclib.collect()
  test.assert(counter[0] == 1, "GC closed an already closed state again")
  abandon_state(counter, false)
  gclib.collect()
  gclib.collect()
  test.assert(counter[0] == 2, "unreachable Lua wrapper did not close its state")
  local closed = tlua.new()
  closed:close()
  common.assert_raises_contains(function ()
    closed:run("return 1")
  end, "closed")
  runtime_test.run(function ()
    common.assert_raises_contains(function ()
      closed:run_async("return 1")
    end, "closed")
  end)
end
