local record BlockingReader
  local bytes: string
  local reads: integer
  local phase: string
end

local function BlockingReader:read(): string?
  self.reads = self.reads + 1
  if self.reads == 1 then return self.bytes end
  self.phase = "waiting"
  timer.sleep(5000)
  return nil
end

local function BlockingReader:read_until(_delimiter: string,
                                          _chop: boolean?): string?
  raise "unused read_until"
end

local function BlockingReader:close()
end

function test_lua_require_cooperates_caches_and_rejects_a_duplicate(
    context: test.Context)
  local root = lua_support.temporary_directory(context)
  local package_table = lua_support.lua_package_table()
  local loaded = lua_support.package_loaded_table(package_table)
  local saved_path = package_table["path"] as string
  package_table["path"] = root .. "/?.lua"
  defer package_table["path"] = saved_path

  local source_name = "lua_tests_source"
  local source_path = root .. "/" .. source_name .. ".lua"
  lua_support.owned_file(context, source_path,
             "return { name = ..., filename = select(2, ...) }")
  context:cleanup(function () loaded[source_name] = nil end)

  local phase = 1
  local observer = async.run(function (): value
    test.assert(phase == 1, "source require did not yield cooperatively")
    phase = 2
    return nil
  end)
  task_support.cleanup_task(context, observer, "source observer cleanup")
  local result = tlua.require(source_name) as {string: value}
  test.assert(phase == 2,
              "source require completed without yielding to another Task")
  test.assert(result["name"] == source_name and
              result["filename"] == source_path,
              "source searcher changed its loader arguments")
  test.assert(tlua.require(source_name) == result,
              "source require did not cache its result")
  test.assert(async.join(observer):has_succeeded(),
              "source require observer failed")

  local concurrent_name = "lua_tests_concurrent"
  local concurrent_path = root .. "/" .. concurrent_name .. ".lua"
  lua_support.owned_file(context, concurrent_path, "return { loaded = true }")
  context:cleanup(function () loaded[concurrent_name] = nil end)
  local first_started = false
  local first_loaded = false
  local duplicate_message = ""
  local first = async.run(function (): value
    first_started = true
    local module_value = tlua.require(concurrent_name) as {string: value}
    first_loaded = module_value["loaded"] == true
    return nil
  end)
  task_support.cleanup_task(context, first, "first source require cleanup")
  local second = async.run(function (): value
    while not first_started do timer.yield() end
    do
      tlua.require(concurrent_name)
    catch
      if error is string then duplicate_message = error as string end
    end
    return nil
  end)
  task_support.cleanup_task(context, second, "duplicate source require cleanup")
  local first_status, second_status = async.join_two(first, second)
  test.assert(first_status:has_succeeded() and
              second_status:has_succeeded() and first_loaded,
              "concurrent source require Task failed")
  test.assert(common.contains(duplicate_message, "already being loaded"),
              duplicate_message)
end

function test_lua_reader_cancellation_stays_pending_after_translation(
    context: test.Context)
  local reader = BlockingReader.new("return { loaded = true }", 0, "idle")
  local transformed = false
  local loading = async.run(function (): value
    do
      tlua.load_from_reader(reader, "=blocking-reader", nil)
    catch
      transformed = true
      raise "translated reader failure"
    end
    return nil
  end)
  task_support.cleanup_task(context, loading, "blocking reader cleanup")
  local probes = 0
  while reader.phase ~= "waiting" and task_support.active(loading) and
        probes < 5000 do
    timer.sleep(1)
    probes = probes + 1
  end
  test.assert(reader.phase == "waiting" and
              loading:status():as_string() == "waiting",
              "reader did not consume its first chunk before waiting")
  loading:cancel(async.CancellationReason.simple("reader cancellation"))
  test.assert(loading:status():as_string() == "waiting",
              "reader cancellation abandoned an accepted wait")
  local status = async.join(loading)
  test.assert(status:has_cancelled() and transformed,
              "translated reader cancellation lost authority")
end

function test_lua_source_open_cancellation_is_retryable(
    context: test.Context)
  local root = lua_support.temporary_directory(context)
  local fifo = root .. "/source.fifo"
  test.assert(cstat.mkfifo(fifo, 384) == 0,
              "could not create source-search FIFO")
  context:cleanup(function () fs.unlink(fifo) end)

  local package_table = lua_support.lua_package_table()
  local loaded = lua_support.package_loaded_table(package_table)
  local saved_path = package_table["path"] as string
  defer package_table["path"] = saved_path
  local modname = "lua_tests_cancel_retry"
  context:cleanup(function () loaded[modname] = nil end)
  package_table["path"] = fifo

  local started = false
  local loading = async.run(function (): value
    started = true
    tlua.require(modname)
    return nil
  end)
  task_support.cleanup_task(context, loading, "cancelled source open cleanup")
  local probes = 0
  while (not started or loading:status():as_string() == "ready" or
         loading:status():as_string() == "running") and probes < 5000 do
    timer.sleep(1)
    probes = probes + 1
  end
  test.assert(started and loading:status():as_string() == "waiting",
              "source require did not wait on its accepted FIFO open")
  loading:cancel(async.CancellationReason.simple("source open cancellation"))
  test.assert(loading:status():as_string() == "waiting",
              "source-open cancellation abandoned its accepted request")

  local writer = fs.open(fifo, "w")
  writer:close()
  test.assert(async.join(loading):has_cancelled(),
              "cancelled source open did not publish cancellation")

  local retry_path = root .. "/" .. modname .. ".lua"
  lua_support.owned_file(context, retry_path, "return { retried = true }")
  package_table["path"] = root .. "/?.lua"
  local retry = tlua.require(modname) as {string: value}
  test.assert(retry["retried"] == true,
              "cancelled source require left a stale loading marker")
end
