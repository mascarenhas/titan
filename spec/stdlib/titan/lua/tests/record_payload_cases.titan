local function check_record_payload(packet: async.TransferValue, number: integer)
  case packet
  when is_record_payload(module, name, payload) then
    test.assert(module == "lua.transfer_fixture" and
      name == "lua.transfer_fixture.PayloadRecord" and #payload > 0)
  else raise "record hooks did not produce a payload carrier" end
  const restored: transfer_fixture.PayloadRecord = packet:to_value()
  test.assert(restored:number_value() == number)
  test.assert(restored:text_value() == strings.rep("payload\0bytes", 1024))
end

local function check_record_payload_source_close(run: IndependentRun)
  const state = tlua.new()
  defer state:close()
  const values: {async.TransferValue} = {run(state, [[
    local fixture = require('lua.transfer_fixture')
    return fixture.payload_record_value(71), nil,
      fixture.nested_payload_value(73), fixture.closure_custom_record(),
      fixture.closure_custom_policy()
  ]])}
  test.assert(#values == 5)
  state:close()
  gclib.collect()
  gclib.collect()
  check_record_payload(values[1], 71)
  assert_transfer_nil(values[2])
  const nested: transfer_fixture.NestedPayload = values[3]:to_value()
  test.assert(nested:number_value() == 73)
  const captured_record: function (): integer = values[4]:to_value()
  const captured_policy: function (): integer = values[5]:to_value()
  test.assert(captured_record() == 83)
  test.assert(captured_policy() == 89)
end

function test_lua_record_payloads_copy_private_values_and_survive_source_close(
    context: test.Context)
  with_independent_runners(context, check_record_payload_source_close)
end

local function check_record_payload_arguments(run: IndependentRun)
  const state = tlua.new()
  defer state:close()
  run(state, "require = nil")
  const packet = async.TransferValue.from_value(transfer_fixture.payload_record_value(79))
  const result: async.TransferValue = run(state, [[
    local item = ...
    assert(item:number_value() == 79)
    collectgarbage('collect')
    return item
  ]], nil, packet)
  check_record_payload(result, 79)
end

function test_lua_record_payload_arguments_initialize_destination_owner(
    context: test.Context)
  with_independent_runners(context, check_record_payload_arguments)
end

local function check_registered_payload_owner(run: IndependentRun)
  const state = tlua.new()
  defer state:close()
  run(state, [[
    require('lua.transfer_fixture')
    package.preload['lua.transfer_fixture'] = nil
    require = nil
  ]])
  const packet = async.TransferValue.from_value(transfer_fixture.payload_record_value(81))
  const result: async.TransferValue = run(state, [[
    local item = ...
    return item:number_value()
  ]], nil, packet)
  test.assert(transfer_integer(result) == 81,
    "a registered custom record unnecessarily required its module loader")
end

function test_lua_record_payload_uses_registered_owner_without_preload(
    context: test.Context)
  with_independent_runners(context, check_registered_payload_owner)
end

local function check_record_payload_failures(run: IndependentRun)
  const state = tlua.new()
  defer state:close()
  const partial = [[
    local fixture = require('lua.transfer_fixture')
    return fixture.payload_record_value(11), fixture.failing_payload_value('encode')
  ]]
  common.assert_raises_contains(function () run(state, partial) end,
    "record hook encode failure")
  assert_state_reusable(state)
  const rejected = async.TransferValue.from_value(
    transfer_fixture.failing_payload_value("decode"))
  common.assert_raises_contains(function ()
    run(state, "return ...", nil, rejected)
  end, "record hook decode failure")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').cyclic_payload_value()")
  end, "cyclic")
  assert_state_reusable(state)
end

function test_lua_record_payload_failures_release_partial_packets_and_state(
    context: test.Context)
  with_independent_runners(context, check_record_payload_failures)
end

local function check_nested_record_payload(run: IndependentRun)
  const state = tlua.new()
  defer state:close()
  local env_packet, choice_packet = run(state, [[
    local fixture = require('lua.transfer_fixture')
    return fixture.envelope_payload_value(101), fixture.choice_payload_value(107)
  ]])
  state:close()
  gclib.collect()
  const env: transfer_fixture.EnvelopeWithPayload = env_packet:to_value()
  test.assert(env.tag == "env")
  test.assert(env.item:number_value() == 101)
  test.assert(#env.items == 2)
  test.assert(env.items[1]:number_value() == 102)
  test.assert(env.items[2]:number_value() == 103)

  const choice: transfer_fixture.ChoiceWithPayload = choice_packet:to_value()
  case choice
  when wrapped(item, count) then
    test.assert(item:number_value() == 107 and count == 214)
  else raise "expected wrapped ChoiceWithPayload"
  end
end

function test_lua_nested_custom_record_payload_in_ordinary_record_and_union(
    context: test.Context)
  with_independent_runners(context, check_nested_record_payload)
end

local function check_payload_hook_states(run: IndependentRun)
  const state = tlua.new()
  defer state:close()
  local encoded, decoded = transfer_fixture.payload_hook_counts()
  const packet = async.TransferValue.from_value(
    transfer_fixture.payload_record_value(113))
  local source_encoded, source_decoded = transfer_fixture.payload_hook_counts()
  test.assert(source_encoded == encoded + 1 and source_decoded == decoded,
    "creating a payload did not encode only in its source state")
  const returned: async.TransferValue = run(state, [[
    local item = ...
    local fixture = require('lua.transfer_fixture')
    local encoded, decoded = fixture.payload_hook_counts()
    assert(encoded == 0 and decoded == 1, 'payload decoded outside its destination')
    assert(item:number_value() == 113)
    return item
  ]], nil, packet)
  run(state, [[
    local encoded, decoded = require('lua.transfer_fixture').payload_hook_counts()
    assert(encoded == 1 and decoded == 1, 'return payload encoded outside its source')
  ]])
  source_encoded, source_decoded = transfer_fixture.payload_hook_counts()
  test.assert(source_encoded == encoded + 1 and source_decoded == decoded,
    "running a child hook changed the parent's hook counters")
  const restored: transfer_fixture.PayloadRecord = returned:to_value()
  test.assert(restored:number_value() == 113)
  source_encoded, source_decoded = transfer_fixture.payload_hook_counts()
  test.assert(source_encoded == encoded + 1 and source_decoded == decoded + 1,
    "return payload did not decode in the parent destination")
end

function test_lua_record_payload_hooks_run_in_source_and_destination(
    context: test.Context)
  with_independent_runners(context, check_payload_hook_states)
end
