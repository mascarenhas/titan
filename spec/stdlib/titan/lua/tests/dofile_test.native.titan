local lua_support = import "lua.test_support.titan"
foreign import "uv_stdio_probe.h"

-- The shared native fixture counts descriptors on Unix and kernel handles on
-- Windows, so file-error cleanup remains observable on both platforms. The
-- portable dofile behavior is in filesystem_test.titan.
function test_lua_dofile_releases_native_file_handles_after_errors(
    context: test.Context)
  runtime_test.run(function ()
    const runtime_error = lua_support.temporary_file(context, "-dofile-runtime-error.lua")
    const syntax_error = lua_support.temporary_file(context, "-dofile-syntax-error.lua")
    fs.write_file(runtime_error, "error('runtime marker')")
    fs.write_file(syntax_error, "this is not Lua")

    const baseline_fds = ffi.titan_uv_test_stdio_open_fd_count() as integer
    test.assert(baseline_fds >= 0, "could not count native file handles")
    for _ = 1, 24 do
      test.assert(lua_support.caught_string(function ()
        tlua.dofile(runtime_error)
      end) ~= nil, "repeated dofile runtime failure escaped")
      test.assert(lua_support.caught_string(function ()
        tlua.dofile(syntax_error)
      end) ~= nil, "repeated dofile syntax failure escaped")
    end
    const final_fds = ffi.titan_uv_test_stdio_open_fd_count() as integer
    test.assert(final_fds >= 0 and final_fds <= baseline_fds + 2,
                "dofile leaked native file handles")
  end)
end
