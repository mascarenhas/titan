local function check_record_payload(packet: async.TransferValue, number: integer)
  case packet
  when is_record_payload(module, name, payload) then
    test.assert(module == "lua.transfer_fixture" and
      name == "lua.transfer_fixture.PayloadRecord" and #payload > 0)
  else raise "record hooks did not produce a payload carrier" end
  local restored: transfer_fixture.PayloadRecord = packet:to_value()
  test.assert(restored:number_value() == number)
  test.assert(restored:text_value() == strings.rep("payload\0bytes", 1024))
end

function test_lua_record_payloads_copy_private_values_and_survive_source_close(
    _context: test.Context)
  runtime_test.run(function ()
    local state = tlua.new()
    defer state:close()
    local values: {async.TransferValue} = {state:run_async([[
      local fixture = require('lua.transfer_fixture')
      return fixture.payload_record_value(71), nil,
        fixture.nested_payload_value(73), fixture.closure_custom_record(),
        fixture.closure_custom_policy()
    ]])}
    test.assert(#values == 5)
    state:close()
    gclib.collect()
    gclib.collect()
    check_record_payload(values[1], 71)
    assert_transfer_nil(values[2])
    local nested: transfer_fixture.NestedPayload = values[3]:to_value()
    test.assert(nested:number_value() == 73)
    local captured_record: function (): integer = values[4]:to_value()
    local captured_policy: function (): integer = values[5]:to_value()
    test.assert(captured_record() == 83)
    test.assert(captured_policy() == 89)
  end)
end

function test_lua_record_payload_arguments_initialize_destination_owner(
    _context: test.Context)
  runtime_test.run(function ()
    local state = tlua.new()
    defer state:close()
    state:run([[
      require = nil
    ]])
    local packet = async.TransferValue.from_value(transfer_fixture.payload_record_value(79))
    local result: async.TransferValue = state:run_async([[
      local item = ...
      assert(item:number_value() == 79)
      collectgarbage('collect')
      return item
    ]], nil, packet)
    check_record_payload(result, 79)
  end)
end

function test_lua_record_payload_uses_registered_owner_without_preload(_context: test.Context)
  local state = tlua.new()
  defer state:close()
  state:run([[
    require('lua.transfer_fixture')
    package.preload['lua.transfer_fixture'] = nil
    require = nil
  ]])
  local packet = async.TransferValue.from_value(transfer_fixture.payload_record_value(81))
  local result: async.TransferValue = state:run([[
    local item = ...
    return item:number_value()
  ]], nil, packet)
  test.assert(transfer_integer(result) == 81,
    "a registered custom record unnecessarily required its module loader")
end

function test_lua_record_payload_failures_release_partial_packets_and_state(
    _context: test.Context)
  local state = tlua.new()
  defer state:close()
  local partial = [[
    local fixture = require('lua.transfer_fixture')
    return fixture.payload_record_value(11), fixture.failing_payload_value('encode')
  ]]
  common.assert_raises_contains(function () state:run(partial) end,
    "record hook encode failure")
  assert_state_reusable(state)
  runtime_test.run(function ()
    common.assert_raises_contains(function () state:run_async(partial) end,
      "record hook encode failure")
    assert_state_reusable(state)
  end)
  local rejected = async.TransferValue.from_value(
    transfer_fixture.failing_payload_value("decode"))
  common.assert_raises_contains(function ()
    state:run("return ...", nil, rejected)
  end, "record hook decode failure")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    state:run("return require('lua.transfer_fixture').cyclic_payload_value()")
  end, "cyclic")
  assert_state_reusable(state)
end

function test_lua_record_payload_receiver_reconstructs_after_sender_close(
    _context: test.Context)
  runtime_test.run(function ()
    local inbox = async.receiver()
    defer inbox:close()
    local state = tlua.new()
    defer state:close()
    state:run("require('lua.transfer_fixture').send_custom_record(...)", nil,
      async.TransferValue.is_pointer(inbox:handle()))
    state:close()
    gclib.collect()
    check_record_payload(inbox:wait(), 97)
  end)
end

function test_lua_nested_custom_record_payload_in_ordinary_record_and_union(
    _context: test.Context)
  runtime_test.run(function ()
    local state = tlua.new()
    defer state:close()
    local env_packet, choice_packet = state:run_async([[
      local fixture = require('lua.transfer_fixture')
      return fixture.envelope_payload_value(101), fixture.choice_payload_value(107)
    ]])
    state:close()
    gclib.collect()
    local env: transfer_fixture.EnvelopeWithPayload = env_packet:to_value()
    test.assert(env.tag == "env")
    test.assert(env.item:number_value() == 101)
    test.assert(#env.items == 2)
    test.assert(env.items[1]:number_value() == 102)
    test.assert(env.items[2]:number_value() == 103)

    local choice: transfer_fixture.ChoiceWithPayload = choice_packet:to_value()
    case choice
    when wrapped(item, count) then
      test.assert(item:number_value() == 107 and count == 214)
    else raise "expected wrapped ChoiceWithPayload"
    end
  end)
end

