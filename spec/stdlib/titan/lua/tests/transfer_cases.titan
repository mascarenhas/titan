local transfer_fixture = import "lua.transfer_fixture"
local transfer_protobuf = import "protobuf"

local type IndependentRun = function (tlua.Lua, string, string?,
  ...: async.TransferValue): (...: async.TransferValue)

local function run_state_chunk(state: tlua.Lua, chunk: string, name: string?,
                              ...: async.TransferValue): (...: async.TransferValue)
  return state:run(chunk, name, ...)
end

local function run_state_loader(state: tlua.Lua, chunk: string, name: string?,
                               ...: async.TransferValue): (...: async.TransferValue)
  local reader = TrackingReader({ "", chunk, "" }, 0, false)
  defer test.assert(not reader.closed, "run_from_loader closed its borrowed reader")
  return state:run_from_loader(reader, name, ...)
end

local function with_independent_runners(context: test.Context,
                                       check: function (IndependentRun): ())
  context:run("chunk", function (_: test.Context) check(run_state_chunk) end)
  context:run("loader", function (_: test.Context) check(run_state_loader) end)
end

local foreign function transfer_state_pointer(state: *lua_State): int
  ffi.lua_pushlightuserdata(state, state)
  return 1
end

local function check_transfer_policies(values: {async.TransferValue},
                                      pointer: foreign *void)
  test.assert(#values == 9, "TransferValue temporary roots changed result arity")
  assert_transfer_nil(values[1])
  assert_transfer_boolean(values[2], false)
  test.assert(transfer_integer(values[3]) == -73)
  case values[4]
  when is_float(number) then test.assert(number == 2.5)
  else raise "origin TransferValue float policy was lost" end
  test.assert(transfer_string(values[5]) == strings.rep("policy\0bytes", 4096))
  case values[6]
  when is_pointer(actual) then test.assert(actual == pointer)
  else raise "origin TransferValue pointer policy was lost" end
  case values[7]
  when is_function(callback) then test.assert(callback ~= nil)
  else raise "origin TransferValue function policy was lost" end
  case values[8]
  when is_record(module, name, data) then
    test.assert(name == "explicit.Record" and data == "record\0wire")
  else raise "explicit record transfer was serialized again" end
  case values[9]
  when is_union(module, name, data) then
    test.assert(name == "explicit.Union" and data == "union\0wire")
  else raise "explicit union transfer was serialized again" end
end

local function check_origin_transfer_policies(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  local memory: owned int[] = foreign int.new_array(1)
  local pointer = memory as foreign *void
  local chunk = [[return require('lua.transfer_fixture').policies(...)]]
  local values: {async.TransferValue} = {run(state, chunk, nil,
    async.TransferValue.is_pointer(pointer))}
  gclib.collect()
  gclib.collect()
  check_transfer_policies(values, pointer)
  local echoed: async.TransferValue = run(state,
    "local callback = ...; return callback(41)", nil, values[7])
  test.assert(transfer_integer(echoed) == 41)
  local returned: async.TransferValue = run(state, [[
    local state_pointer = ...
    return require('lua.transfer_fixture').state_policy(state_pointer())
  ]], nil, async.TransferValue.is_function(transfer_state_pointer))
  case returned
  when is_lua_state(pointer) then
    test.assert(pointer ~= nil)
    local echoed: async.TransferValue = run(state, "return ...", nil, returned)
    case echoed
    when is_pointer(actual) then test.assert(actual == pointer as foreign *void)
    else raise "Lua-state argument was not represented by light userdata" end
  else raise "origin TransferValue state policy became an ordinary pointer" end
end

function test_lua_independent_honors_origin_transfer_policies(
    context: test.Context)
  with_independent_runners(context, check_origin_transfer_policies)
end

local function check_transferred_record(candidate: async.TransferValue,
                                        expected: integer)
  case candidate
  when is_record(module, name, data) then
    test.assert(module == "lua.transfer_fixture" and name == "lua.transfer_fixture.TransferRecord")
    local restored: transfer_fixture.TransferRecord =
      transfer_protobuf.deserialize_nominal(data, name, false)
    test.assert(restored.number == expected)
    test.assert(restored.text == strings.rep("nominal\0bytes", 4096))
    test.assert(#restored.entries == 3 and restored.entries[3] == 3)
  else raise "public record did not transfer as protobuf" end
end

local function check_nominal_transfers(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  local values: {async.TransferValue} = {run(state, [[
    local fixture = require('lua.transfer_fixture')
    require = nil
    return fixture.record_value(17), nil, fixture.union_value(29)
  ]])}
  test.assert(#values == 3, "nominal temporary roots changed result arity")
  gclib.collect()
  check_transferred_record(values[1], 17)
  assert_transfer_nil(values[2])
  case values[3]
  when is_union(module, name, data) then
    test.assert(module == "lua.transfer_fixture" and name == "lua.transfer_fixture.TransferUnion")
    local restored: transfer_fixture.TransferUnion =
      transfer_protobuf.deserialize_nominal(data, name, true)
    case restored
    when present(item, label) then
      test.assert(item.number == 29 and label == "union\0label")
    else raise "union tag changed during transfer" end
  else raise "public union did not transfer as protobuf" end
  local echoed: {async.TransferValue} = {run(state, "return ...", nil,
    values[1], values[2], values[3])}
  test.assert(#echoed == 3)
  check_transferred_record(echoed[1], 17)
  assert_transfer_nil(echoed[2])
  local scalar: async.TransferValue = run(state,
    "local record = ...; return record.number", nil, values[1])
  test.assert(transfer_integer(scalar) == 17)
end

function test_lua_independent_transfers_nominals_and_decodes_arguments(
    context: test.Context)
  with_independent_runners(context, check_nominal_transfers)
end

local function check_nominal_failure(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').private_value()")
  end, "public")
  assert_state_reusable(state)
  local partial = [[
    local fixture = require('lua.transfer_fixture')
    return fixture.record_value(11), fixture.private_value()
  ]]
  common.assert_raises_contains(function () run(state, partial) end, "public")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return ...", nil,
      async.TransferValue.is_record("lua.transfer_fixture", "missing.Record", ""))
  end, "unknown")
  assert_state_reusable(state)
end

function test_lua_independent_nominal_failure_releases_state(
    context: test.Context)
  with_independent_runners(context, check_nominal_failure)
end

local function check_nominal_defaults(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  local values: {async.TransferValue} = {run(state, [[
    local fixture = require('lua.transfer_fixture')
    return fixture.DefaultRecord.new(301), fixture.CustomRecord.new(),
      fixture.TransferUnion.empty(), fixture.construction_count()
  ]])}
  test.assert(#values == 4)
  test.assert(transfer_integer(values[4]) == 1)
  case values[1]
  when is_record(module, name, data) then
    local restored: transfer_fixture.DefaultRecord =
      transfer_protobuf.deserialize_nominal(data, name, false)
    test.assert(restored.number == 301)
  else raise "default record did not transfer" end
  case values[2]
  when is_record(module, name, data) then
    local restored: transfer_fixture.CustomRecord =
      transfer_protobuf.deserialize_nominal(data, name, false)
    test.assert(restored.number == 407)
  else raise "custom record did not transfer" end
  case values[3]
  when is_union(module, name, data) then
    local restored: transfer_fixture.TransferUnion =
      transfer_protobuf.deserialize_nominal(data, name, true)
    case restored
    when empty() then
    else raise "empty variant changed during transfer" end
  else raise "empty union did not transfer" end
  test.assert(transfer_fixture.construction_count() == 0,
    "deserializing invoked the destination's custom constructor")
  local returned: async.TransferValue = run(state, [[
    local item = ...
    assert(item.number == 407)
    return require('lua.transfer_fixture').construction_count()
  ]], nil, values[2])
  test.assert(transfer_integer(returned) == 1,
    "decoding a transfer argument invoked the origin's custom constructor")
end

function test_lua_independent_reconstructs_defaults_const_and_empty_variants(
    context: test.Context)
  with_independent_runners(context, check_nominal_defaults)
end

local function transfer_closure(item: async.TransferValue): value
  case item
  when is_closure() then return item:to_value()
  else raise "Titan closure did not preserve its transfer variant" end
end

local function check_closure_snapshots(run: IndependentRun, mode: string)
  local originally_incremental = gclib.incremental()
  defer do
    if originally_incremental then gclib.incremental()
    else gclib.generational() end
  end
  if mode == "generational" then gclib.generational() end
  local state = tlua.new()
  defer state:close()
  run(state, "collectgarbage('" .. mode .. "')")
  local values: {async.TransferValue} = {run(state, [[
    local fixture = require('lua.transfer_fixture')
    return fixture.closure_constant, fixture.closure_text(),
      fixture.closure_counter(), fixture.closure_mutable_text(),
      fixture.closure_shared_boxes(), fixture.closure_nominal(),
      fixture.closure_policy(), fixture.closure_bound_method(),
      fixture.closure_captured_policy()
  ]])}
  test.assert(#values == 9)
  state:close()
  gclib.collect()
  gclib.collect()
  local constant: function (): integer = transfer_closure(values[1])
  local text: function (): string = transfer_closure(values[2])
  local count: function (): integer = transfer_closure(values[3])
  local growing: function (): string = transfer_closure(values[4])
  local shared: function (): integer = transfer_closure(values[5])
  local nominal: function (): integer = transfer_closure(values[6])
  local policy: function (): integer = transfer_closure(values[7])
  local bound: function (): integer = transfer_closure(values[8])
  local captured_policy: function (): integer = transfer_closure(values[9])
  test.assert(constant() == 37)
  test.assert(text() == strings.rep("closure\0text", 1024))
  test.assert(count() == 6 and count() == 7)
  test.assert(growing() == "ab" and growing() == "abb")
  test.assert(shared() == 105 and shared() == 205,
    "independently reconstructed closures shared a mutable cell")
  test.assert(nominal() == 56 and policy() == 6 and bound() == 61)
  test.assert(captured_policy() == 67)
end

function test_lua_independent_closure_snapshots_survive_origin_close(
    context: test.Context)
  local modes = {"incremental", "generational"}
  for index = 1, #modes do
    local mode = modes[index]
    context:run(mode, function (child: test.Context)
      with_independent_runners(child, function (run: IndependentRun)
        check_closure_snapshots(run, mode)
      end)
    end)
  end
end

local function check_closure_arguments(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  -- The defining module is first loaded by the linked preload, not Lua require.
  run(state, "require = nil")
  local source = transfer_fixture.closure_shared_boxes()
  local carrier = async.TransferValue.from_value(source)
  local returned: async.TransferValue = run(state, [[
    local callback = ...
    assert(callback() == 105)
    collectgarbage('collect')
    return callback
  ]], nil, carrier)
  test.assert(source() == 116, "destination mutated the origin's captured box")
  local copied: function (): integer = transfer_closure(returned)
  test.assert(copied() == 205)
  test.assert(source() == 227, "returned closure retained origin box identity")
  local adjusted = transfer_fixture.closure_adjusted()
  local adjusted_result: async.TransferValue = run(state, [[
    local callback = ...
    assert(callback(4, 'unused') == 7)
    return callback
  ]], nil, async.TransferValue.from_value(adjusted))
  local restored: function (integer, value): value = transfer_closure(adjusted_result)
  test.assert(restored(5, nil) as integer == 12)
  test.assert(adjusted(1, nil) as integer == 4,
    "adjusted closure copied the origin's mutable cell")
end

function test_lua_independent_closure_arguments_initialize_owner_and_copy_boxes(
    context: test.Context)
  with_independent_runners(context, check_closure_arguments)
end

local function check_closure_preload(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  run(state, [[
    local original = package.preload['lua.transfer_fixture']
    assert(type(original) == 'function')
    local calls, owner = 0, nil
    local function counted_loader(...)
      calls = calls + 1
      local current = original(...)
      -- First initialization republishes its linked preload.
      package.preload['lua.transfer_fixture'] = counted_loader
      if owner then assert(current == owner) else owner = current end
      return current
    end
    package.preload['lua.transfer_fixture'] = counted_loader
    function transfer_loader_calls() return calls end
    require = nil
  ]])
  local packet = async.TransferValue.from_value(transfer_fixture.closure_counter())
  local first: async.TransferValue = run(state,
    "local callback = ...; return callback()", nil, packet)
  local second: async.TransferValue = run(state,
    "local callback = ...; return callback()", nil, packet)
  test.assert(transfer_integer(first) == 6 and transfer_integer(second) == 6)
  local calls: async.TransferValue = run(state, "return transfer_loader_calls()")
  test.assert(transfer_integer(calls) == 2,
    "closure restoration bypassed the ordinary preload function")
end

function test_lua_independent_closure_calls_preload_and_memoizes_module(
    context: test.Context)
  with_independent_runners(context, check_closure_preload)
end

local function check_unrelated_closure_preload(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  run(state, [[
    local fixture = require('lua.transfer_fixture')
    local original = package.preload['lua.transfer_fixture']
    -- A record's native integer payload must not be read as a module header.
    local unrelated = fixture.DefaultRecord.new(313)
    package.preload['lua.transfer_fixture'] = function() return unrelated end
    function restore_transfer_loader()
      package.preload['lua.transfer_fixture'] = original
    end
    require = nil
  ]])
  local packet = async.TransferValue.from_value(transfer_fixture.closure_counter())
  local malformed: async.TransferValue = packet
  case packet
  when is_closure(module, entry, _data) then
    malformed = async.TransferValue.is_closure(module, entry, "invalid protobuf")
  else raise "closure fixture did not produce a closure packet" end
  common.assert_raises_contains(function ()
    run(state, "return ...", nil, malformed)
  end, "different Titan module")
  assert_state_reusable(state)
  run(state, "restore_transfer_loader()")
  local result: async.TransferValue = run(state,
    "local callback = ...; return callback()", nil, packet)
  test.assert(transfer_integer(result) == 6)
end

function test_lua_independent_closure_rejects_unrelated_preload_result(
    context: test.Context)
  with_independent_runners(context, check_unrelated_closure_preload)
end

local function check_closure_capture_failures(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  common.assert_raises_contains(function ()
    run(state, "return function() return 42 end")
  end, "transfer")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').closure_array()")
  end, "transfer")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').closure_private_nominal()")
  end, "public")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').closure_cycle()")
  end, "cycl")
  assert_state_reusable(state)
  local partial = [[
    local fixture = require('lua.transfer_fixture')
    return fixture.closure_counter(), fixture.closure_array()
  ]]
  common.assert_raises_contains(function () run(state, partial) end, "transfer")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return ...", nil,
      async.TransferValue.from_value(transfer_fixture.closure_counter()),
      async.TransferValue.from_value(transfer_fixture.closure_array()))
  end, "transfer")
  assert_state_reusable(state)
end

function test_lua_independent_rejects_closure_capture_failures_and_reuses_state(
    context: test.Context)
  with_independent_runners(context, check_closure_capture_failures)
end

local function check_closure_native_numbers(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  local result: async.TransferValue = run(state,
    "return require('lua.transfer_fixture').closure_native_numbers()")
  state:close()
  gclib.collect()
  local restored: function (): boolean = transfer_closure(result)
  test.assert(restored(), "closure capture narrowed a native number")
  test.assert(not restored(), "native captures were not restored as mutable cells")
end

function test_lua_independent_closure_copies_native_numbers_exactly(
    context: test.Context)
  with_independent_runners(context, check_closure_native_numbers)
end

local function check_closure_destination_globals(run: IndependentRun)
  transfer_fixture.closure_global_reset(700)
  defer transfer_fixture.closure_global_reset(100)
  local state = tlua.new()
  defer state:close()
  local result: async.TransferValue = run(state, [[
    local fixture = require('lua.transfer_fixture')
    assert(fixture.closure_global() == 101)
    assert(fixture.closure_global() == 102)
    return fixture.closure_global
  ]])
  local restored: function (): integer = transfer_closure(result)
  test.assert(restored() == 701, "closure retained the origin module instance")
  local origin: async.TransferValue = run(state,
    "return require('lua.transfer_fixture').closure_global()")
  test.assert(transfer_integer(origin) == 103,
    "destination closure mutated origin module globals")
  test.assert(restored() == 702)
end

function test_lua_independent_closure_uses_destination_module_globals(
    context: test.Context)
  with_independent_runners(context, check_closure_destination_globals)
end

local function check_closure_managed_pointers(run: IndependentRun)
  local state = tlua.new()
  defer state:close()
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').closure_managed_pointer()")
  end, "transfer")
  assert_state_reusable(state)
  common.assert_raises_contains(function ()
    run(state, "return require('lua.transfer_fixture').closure_optional_managed_pointer(true)")
  end, "transfer")
  assert_state_reusable(state)
  local result: async.TransferValue = run(state,
    "return require('lua.transfer_fixture').closure_optional_managed_pointer(false)")
  state:close()
  gclib.collect()
  local callback: function (): boolean = transfer_closure(result)
  test.assert(callback(), "absent optional managed pointer did not remain nil")
end

function test_lua_independent_closure_rejects_managed_native_pointer_captures(
    context: test.Context)
  with_independent_runners(context, check_closure_managed_pointers)
end
