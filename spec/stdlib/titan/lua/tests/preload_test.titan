local independent_preload = import "lua.preload_fixture"

function test_lua_independent_preload_snapshot_skips_host_closures(
    _context: test.Context)
  local configure = common.lua_helper([=[
    return function()
      local preload = debug.getregistry()._PRELOAD
      local names = {
        'lua.tests.snapshot_lua', 'lua.tests.snapshot_c_closure',
        'lua.tests.snapshot_nonfunction', 'lua.tests.snapshot_late',
      }
      local saved = {}
      for index, name in ipairs(names) do saved[index] = preload[name] end
      local native = assert(preload['lua.preload_fixture'])
      preload[names[1]] = function() return 11 end
      preload[names[2]] = string.gmatch('abc', '.')
      preload[names[3]] = 17
      preload[names[4]] = nil
      local public_preload = package.preload
      package.preload = {}
      return function()
        package.preload = public_preload
        for index, name in ipairs(names) do preload[name] = saved[index] end
      end, function() preload[names[4]] = native end
    end
  ]=]) as function (): (function (): (), function (): ())
  local restore, register_late = configure()
  defer restore()
  local first = tlua.new()
  defer first:close()
  register_late()
  local values: {async.TransferValue} = { first:run([[
    return package.preload['lua.tests.snapshot_lua'] == nil,
           package.preload['lua.tests.snapshot_c_closure'] == nil,
           package.preload['lua.tests.snapshot_nonfunction'] == nil,
           package.preload['lua.tests.snapshot_late'] == nil,
           type(package.preload['lua.preload_fixture']) == 'function'
  ]]) }
  test.assert(#values == 5)
  for index = 1, #values do assert_transfer_boolean(values[index], true) end
  local second = tlua.new()
  defer second:close()
  local late: async.TransferValue = second:run([[
    package.path, package.cpath = '', ''
    return require('lua.tests.snapshot_late').increment(1)
  ]])
  test.assert(transfer_integer(late) == 42,
              "new state did not snapshot the registry's late native loader")
end
