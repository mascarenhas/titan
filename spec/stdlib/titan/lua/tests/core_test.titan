local record TrackingReader
  local const chunks: {string}
  local index: integer
  local closed: boolean
end

local function TrackingReader:read(): string?
  self.index = self.index + 1
  return self.chunks[self.index]
end

local function TrackingReader:read_until(_delimiter: string,
                                          _chop: boolean?): string?
  raise "unused read_until"
end

local function TrackingReader:close()
  self.closed = true
end

function test_lua_load_chunks_arguments_and_environments(_context: test.Context)
  runtime_test.run(function ()
    const passthrough = tlua.load("return ...", "=passthrough", nil)
    local values: {value} = { passthrough(1, nil, 3) }
    test.assert(#values == 3)
    test.assert(values[1] == 1 and values[2] == nil and values[3] == 3)

    const binary = tlua.load([[return "a\0b"]], "=binary", nil)
    const binary_result: value = binary()
    test.assert(binary_result == "a\0b")

    common.assert_raises_contains(function()
      tlua.load("return 1\0return 2", "=embedded-nul", nil)
    end, "embedded-nul")

    const dump = common.lua_helper([[
  return function()
    local source = function(...) return ... end
    return string.dump(source)
  end
  ]]) as function (): (string)
    const dumped = tlua.load(dump(), "=dumped", { ["ignored"] = true })
    values = { dumped(7, nil, 9) }
    test.assert(#values == 3)
    test.assert(values[1] == 7 and values[2] == nil and values[3] == 9)

    const environment: {string: value} = { ["answer"] = 42 }
    const scoped = tlua.load("return answer, _G", "=environment", environment)
    const scoped_values: {value} = { scoped() }
    test.assert(scoped_values[1] == 42 and scoped_values[2] == nil)

    const global_chunk = tlua.load("return _G", nil, nil)
    const actual_global: value = global_chunk()
    const global_value = common.lua_helper([[
  return function() return _G end
  ]]) as function (): (value)
    test.assert(actual_global == global_value())

    common.assert_raises_contains(function()
      tlua.load("this is not Lua", "=named-load", nil)
    end, "named-load")
  end)
end

function test_lua_load_from_reader_without_closing(_context: test.Context)
  runtime_test.run(function ()
    const reader = TrackingReader({
      "return 'left', nil, ",
      "'right'",
    }, 0, false)
    const chunk = tlua.load_from_reader(reader, "=reader", nil)
    test.assert(not reader.closed, "load_from_reader closed its reader")
    const values: {value} = { chunk() }
    test.assert(#values == 3)
    test.assert(values[1] == "left" and values[2] == nil and
                values[3] == "right")

    const empty_reader = TrackingReader({
      "", "return ", "", "'empty-chunks-ok'", "",
    }, 0, false)
    const empty_chunk = tlua.load_from_reader(empty_reader, "=empty-reader", nil)
    const empty_result: value = empty_chunk()
    test.assert(empty_result == "empty-chunks-ok")
    test.assert(not empty_reader.closed)
  end)
end

function test_lua_require_preload_cache_and_fallback(_context: test.Context)
  runtime_test.run(function ()
    const cleanup = common.lua_helper([[
  return function(name)
    package.preload[name] = nil
    package.loaded[name] = nil
  end
  ]]) as function (string): ()

    const preload_name = "lua.tests.preloaded"
    defer cleanup(preload_name)
    const setup_preload = common.lua_helper([[
  return function(name)
    package.loaded[name] = nil
    local state = { calls = 0 }
    package.preload[name] = function(actual, data)
      assert(actual == name and data == ":preload:")
      state.calls = state.calls + 1
      return { calls = state.calls }
    end
    return state
  end
  ]]) as function (string): ({string: value})
    const preload_state = setup_preload(preload_name)
    const first: value = tlua.require(preload_name)
    test.assert(first is {string: value})
    const first_map = first as {string: value}
    test.assert(first_map["calls"] == 1)
    const second: value = tlua.require(preload_name)
    test.assert(second == first)
    test.assert(preload_state["calls"] == 1)

    const fallback_name = "lua.tests.fallback"
    defer cleanup(fallback_name)
    const setup_fallback = common.lua_helper([[
  return function(name)
    package.loaded[name] = nil
    package.preload[name] = function() end
  end
  ]]) as function (string): ()
    setup_fallback(fallback_name)
    test.assert(tlua.require(fallback_name) == true)
    const loaded = common.lua_helper([[
  return function(name) return package.loaded[name] end
  ]]) as function (string): (value)
    test.assert(loaded(fallback_name) == true)

    const false_name = "lua.tests.false"
    defer cleanup(false_name)
    const setup_false = common.lua_helper([[
  return function(name)
    package.loaded[name] = nil
    local state = { calls = 0 }
    package.preload[name] = function()
      state.calls = state.calls + 1
      return false
    end
    return state
  end
  ]]) as function (string): ({string: value})
    const false_state = setup_false(false_name)
    test.assert(tlua.require(false_name) == false)
    test.assert(tlua.require(false_name) == false)
    test.assert(false_state["calls"] == 2)
  end)
end
