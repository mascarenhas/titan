local test = import "test"
local strings = import "string"
local support = import "string.test_support"

local record RegexCase
  expression: string
  subject: string
  expected: string?
end

local function bracket(found: string): string
  return "[" .. found .. "]"
end

local function whole(subject: string, expression: string,
                     initial: integer?): string?
  local found? = strings.match(subject, expression, initial)
  if not found then return nil end
  return found:whole()
end

local function diagnostic(expression: string, label: string): string
  local message = support.expect_error(function()
    strings.compile_regex(expression)
  end, "[" .. label .. "]")
  test.assert(support.contains(message, "(byte "), message)
  test.assert(support.contains(message, "\n"), message)
  test.assert(strings.sub(message, -1, nil) == "^", message)
  return message
end

local function check_empty_progress(subject: string,
                                    expected: {string},
                                    expected_output: string,
                                    expected_count: integer)
  local actual: {string} = {}
  local iterator = strings.gmatch(subject, "a*", nil)
  while true do
    local found? = iterator()
    if not found then break end
    actual[#actual + 1] = found:whole()
  end
  test.assert(#actual == #expected, "empty-match iterator count differs")
  for index = 1, #actual do
    test.assert(actual[index] == expected[index],
                "empty-match iterator value differs")
  end

  local replacements: {string} = {}
  local output, count = strings.gsub(
    subject, "a*", function(found: string): string
      replacements[#replacements + 1] = found
      return "X"
    end, nil)
  test.assert(output == expected_output and count == expected_count)
  test.assert(#replacements == #expected)
  for index = 1, #replacements do
    test.assert(replacements[index] == expected[index])
  end
end

function test_capture_iteration_and_split(context: test.Context)
  local words = strings.matches("one two", "\\w+")
  local word? = words()
  test.assert(word == "one")
  word = words()
  test.assert(word == "two")
  word = words()
  test.assert(word == nil)

  local assignments = strings.matches(
    "from=world,to=Lua", "(\\w+)=(\\w+)")
  local key?, captured_value? = assignments()
  test.assert(key == "from" and captured_value == "world")
  key, captured_value = assignments()
  test.assert(key == "to" and captured_value == "Lua")
  key, captured_value = assignments()
  test.assert(key == nil and captured_value == nil)

  local optional = strings.matches("b a", "(a)|(b)")
  local first?, second? = optional()
  test.assert(first == nil and second == "b")
  first, second = optional()
  test.assert(first == "a" and second == nil)

  local bytes = strings.split("a\0b", nil)
  test.assert(bytes() == "a")
  test.assert(bytes() == "\0")
  test.assert(bytes() == "b")
  test.assert(bytes() == nil)
  test.assert(strings.split("", nil)() == nil)

  local fields = strings.split(",a,,b,", ",")
  test.assert(fields() == "")
  test.assert(fields() == "a")
  test.assert(fields() == "")
  test.assert(fields() == "b")
  test.assert(fields() == "")
  test.assert(fields() == nil)

  local zero = strings.split("ab", "")
  test.assert(zero() == "")
  test.assert(zero() == "a")
  test.assert(zero() == "b")
  test.assert(zero() == "")
  test.assert(zero() == nil)

  local captured = strings.split("a1b22c", "(\\d+)")
  test.assert(captured() == "a")
  test.assert(captured() == "b")
  test.assert(captured() == "c")
  test.assert(captured() == nil)
end

function test_unmatched_and_empty_capture_spans(context: test.Context)
  local found? = strings.match("", "(a)?()", nil)
  test.assert(found ~= nil)
  test.assert(found:group_span(1) == nil)
  local empty = found:group_span(2)
  test.assert(empty.first == 1 and empty.last == 0)
  local first?, second? = found:values()
  test.assert(first == nil and second == "")
end

function test_pinned_ta_regex_corpus(context: test.Context)
  local cases: {RegexCase} = {
    RegexCase.new("foo", "xxfooy", "foo"),
    RegexCase.new("foo", "bar", nil),
    RegexCase.new("f.o", "xxfoo", "foo"),
    RegexCase.new(".", "\n", nil),
    RegexCase.new("[ab]", "xb", "b"),
    RegexCase.new("[A-Z]+", "xABCy", "ABC"),
    RegexCase.new("[ab]", "x", nil),
    RegexCase.new("[^ab]+", "abXYZ", "XYZ"),
    RegexCase.new("\\w+", "--abc", "abc"),
    RegexCase.new("\\w+", "--9", "9"),
    RegexCase.new("\\w+", "--_", "_"),
    RegexCase.new("\\w", "\x80", nil),
    RegexCase.new("\\W", "-", "-"),
    RegexCase.new("\\d+", "a123", "123"),
    RegexCase.new("\\D+", "1abc", "abc"),
    RegexCase.new("\\s", " x", " "),
    RegexCase.new("\\s", "\t", "\t"),
    RegexCase.new("\\s", "\v", "\v"),
    RegexCase.new("\\s", "\n", "\n"),
    RegexCase.new("\\s", "\r", "\r"),
    RegexCase.new("\\s", "\f", nil),
    RegexCase.new("\\S", "\f", "\f"),
    RegexCase.new("\\t", "\t", "\t"),
    RegexCase.new("\\n", "\n", "\n"),
    RegexCase.new("\\r", "\r", "\r"),
    RegexCase.new("\\f", "\f", "\f"),
    RegexCase.new("\\e", "\27", "\27"),
    RegexCase.new("\\a", "\7", "\7"),
    RegexCase.new("\\.", ".", "."),
    RegexCase.new("\\*", "*", "*"),
    RegexCase.new("\\+", "+", "+"),
    RegexCase.new("\\?", "?", "?"),
    RegexCase.new("\\(x\\)", "(x)", "(x)"),
    RegexCase.new("\\[x\\]", "[x]", "[x]"),
    RegexCase.new("\\{x\\}", "{x}", "{x}"),
    RegexCase.new("foo|bar", "xxfoo", "foo"),
    RegexCase.new("foo|bar", "xxbar", "bar"),
    RegexCase.new("a|ab", "ab", "a"),
    RegexCase.new("ab", "zab", "ab"),
    RegexCase.new("", "abc", ""),
    RegexCase.new("|", "abc", ""),
    RegexCase.new("a|", "b", ""),
    RegexCase.new("(ab)", "zab", "ab"),
    RegexCase.new("((a)b)", "zab", "ab"),
    RegexCase.new("(?:ab)", "zab", "ab"),
    RegexCase.new("a*", "bbb", ""),
    RegexCase.new("a*", "aaab", "aaa"),
    RegexCase.new("a+", "baa", "aa"),
    RegexCase.new("a+", "bbb", nil),
    RegexCase.new("ab?", "a", "a"),
    RegexCase.new("ab?", "ab", "ab"),
    RegexCase.new("a{3}", "aaaa", "aaa"),
    RegexCase.new("a{2,}", "baaa", "aaa"),
    RegexCase.new("a{2,}", "ba", nil),
    RegexCase.new("a{2,3}", "aaaa", "aaa"),
    RegexCase.new("a{2,3}b", "aab", "aab"),
    RegexCase.new("(a)+", "aaa", "aaa"),
    RegexCase.new("^a", "abc", "a"),
    RegexCase.new("^a", "ba", nil),
    RegexCase.new("a$", "ba", "a"),
    RegexCase.new("^a|b$", "xxb", nil),
    RegexCase.new("^a|b$", "b", "b"),
    RegexCase.new("\\<foo", " foo", "foo"),
    RegexCase.new("\\<foo", "afoo", nil),
    RegexCase.new("foo\\>", "foo!", "foo"),
    RegexCase.new("(a)\\1", "zaa", "aa"),
    RegexCase.new("(a)\\1", "zab", nil),
    RegexCase.new("(a)\\1b", "zaab", "aab"),
    RegexCase.new("[-a]+", "--a", "--a"),
    RegexCase.new("[a-]+", "--a", "--a"),
    RegexCase.new("[a\\-]+", "--a", "--a"),
    RegexCase.new("[a\\]]+", "]]a", "]]a"),
    RegexCase.new("\x80", "x\x80", "\x80"),
    RegexCase.new("a\0b", "xa\0b", "a\0b"),
    RegexCase.new(".", "\xff", "\xff"),
    RegexCase.new(".", "\r", "\r"),
    RegexCase.new("|a", "a", ""),
    RegexCase.new("()", "abc", ""),
    RegexCase.new("(?:)", "abc", ""),
    RegexCase.new("(a){0}", "a", ""),
    RegexCase.new("(a){0,1}", "a", "a"),
    RegexCase.new("\\d{2}", "x42", "42"),
    RegexCase.new("[\\dA-F]+", "xA9F", "A9F"),
    RegexCase.new("\\W", "9", nil),
    RegexCase.new("\\$", "$", "$"),
    RegexCase.new("\\^", "^", "^"),
    RegexCase.new("\\|", "|", "|"),
    RegexCase.new("\\\\", "\\", "\\"),
    RegexCase.new("$", "abc", ""),
  }
  test.assert(#cases == 89)
  for index = 1, #cases do
    local current = cases[index]
    local found? = strings.compile_regex(current.expression):match(
      current.subject, nil)
    if current.expected == nil then
      test.assert(found == nil,
                  "regex corpus case " .. strings.tostring(index) ..
                  " unexpectedly matched")
    else
      test.assert(found ~= nil and found:whole() == current.expected,
                  "regex corpus case " .. strings.tostring(index) ..
                  " differed")
    end
  end
end

function test_compiled_spans_captures_and_positions(context: test.Context)
  local regex = strings.compile_regex("(a|(b))+(c)?")
  test.assert(regex:source() == "(a|(b))+(c)?")
  test.assert(regex:group_count() == 3)
  local found? = regex:match("xxabb", 1)
  test.assert(found ~= nil and found:whole() == "abb")
  test.assert(found:group_count() == regex:group_count())
  test.assert(found:group(1) == "b")
  test.assert(found:group(2) == "b")
  test.assert(found:group(3) == nil)
  local span = found:span()
  test.assert(span.first == 3 and span.last == 5)
  span.first = 99
  test.assert(found:span().first == 3)
  local group_span = found:group_span(1)
  group_span.first = 99
  test.assert(found:group_span(1).first == 5)
  support.expect_error(function() found:group(0) end,
                       "capture group index out of range")
  support.expect_error(function() found:group_span(4) end,
                       "capture group index out of range")

  local source_match? = strings.match("a", "(a)?(b)?", nil)
  test.assert(source_match ~= nil and source_match:whole() == "a")
  local first?, second? = source_match:values()
  test.assert(first == "a" and second == nil)
  source_match = strings.match("xxab", "ab", nil)
  test.assert(source_match ~= nil and source_match:whole() == "ab")
  first = source_match:values()
  test.assert(first == "ab")

  test.assert(strings.match("ba", "^a", 2):whole() == "a")
  test.assert(strings.match("ba", "^a", 1) == nil)
  test.assert(strings.match("ba", "^b", 0):whole() == "b")
  test.assert(strings.match("ba", "^b", -99):whole() == "b")
  test.assert(strings.match("ba", "^a", -1):whole() == "a")
  test.assert(strings.match("ba", "a", 4) == nil)
  test.assert(strings.match("", "^$", 1):whole() == "")
end

function test_regex_corrected_defects(context: test.Context)
  test.assert(whole("aaab", "a*ab", nil) == "aaab")
  test.assert(whole("aaab", "a+ab", nil) == "aaab")
  test.assert(whole("aab", "(a)\\1b", nil) == "aab")
  test.assert(whole("aa", "((a))\\1", nil) == "aa")
  test.assert(strings.match("b", "(a)|(b)\\1", nil) == nil)

  local nested? = strings.compile_regex("(ab*)+"):match("xxabbbab!", nil)
  test.assert(nested ~= nil and nested:whole() == "abbbab")
  test.assert(nested:group(1) == "ab")
  nested = strings.compile_regex("((a)b)"):match("ab", nil)
  test.assert(nested ~= nil and nested:group(1) == "ab")
  test.assert(nested:group(2) == "a")
  nested = strings.compile_regex("(a+b+)*"):match("aaabbabx", nil)
  test.assert(nested ~= nil and nested:whole() == "aaabbab")
  test.assert(nested:group(1) == "ab")
  nested = strings.compile_regex(
    "((?:ab*)+)-\\1"):match("xabbbab-abbbab!", nil)
  test.assert(nested ~= nil and nested:whole() == "abbbab-abbbab")
  test.assert(nested:group(1) == "abbbab")

  local expressions: {string} = {
    "(a){0}", "(a){2}", "(a){2,}", "(a){2,4}",
  }
  for index = 1, #expressions do
    test.assert(strings.compile_regex(expressions[index]):group_count() == 1)
  end
  test.assert(strings.compile_regex("(a)?\\1"):match("", nil) == nil)
  test.assert(strings.compile_regex("(a?)\\1"):match("", nil):whole() == "")
  diagnostic("\\1|(a)", "invalid_backreference")
  test.assert(strings.compile_regex("(a)|\\1"):group_count() == 1)
  test.assert(strings.compile_regex("(a)|\\1"):match("a", nil):whole() == "a")

  test.assert(whole("\0\xff", "[\0\xff]+", nil) == "\0\xff")
  test.assert(whole("\r", ".", nil) == "\r")
  test.assert(strings.match("\n", ".", nil) == nil)
  test.assert(whole("\v", "\\s", nil) == "\v")
  test.assert(strings.match("\f", "\\s", nil) == nil)
  test.assert(whole("\f", "\\S", nil) == "\f")
  test.assert(whole(" foo", "\\<foo", nil) == "foo")
  test.assert(whole("foo!", "foo\\>", nil) == "foo")
  test.assert(whole("-ac", "[-a-c]+", nil) == "-ac")
  test.assert(whole("-az", "[--a]+", nil) == "-a")
  test.assert(whole("-", "[---]+", nil) == "-")
  test.assert(whole("c-", "[a-c-]+", nil) == "c-")
  test.assert(whole("a-c", "[a\\-c]+", nil) == "a-c")
  test.assert(whole("\t\n\r\f\27\7",
                    "[\\t\\n\\r\\f\\e\\a]+", nil) ==
              "\t\n\r\f\27\7")
  test.assert(whole("^-[]{}", "[\\^\\-\\[\\]\\{\\}]+", nil) ==
              "^-[]{}")
end

function test_regex_diagnostics(context: test.Context)
  diagnostic("*a", "misplaced_quantifier")
  local exact = diagnostic("a{5,2}", "bad_quantifier_bounds")
  test.assert(exact ==
    "invalid regular expression [bad_quantifier_bounds] " ..
    "at L1:C6 (byte 6): maximum repeat is smaller than minimum\n" ..
    "a{5,2}\n     ^")
  diagnostic("(a", "expected_group_close")
  local crlf_eof = diagnostic("a|\r\n[", "expected_class_close")
  test.assert(support.contains(crlf_eof, "at L2:C2 (byte 6)"), crlf_eof)
  diagnostic("[]", "empty_class")
  diagnostic("[^]", "empty_class")
  diagnostic("[z-a]", "bad_range")
  diagnostic("[\\d-a]", "bad_range")
  diagnostic("[a-b-c]", "bad_range")
  diagnostic("[a-b--d]", "bad_range")
  diagnostic("\\", "dangling_escape")
  diagnostic("\\v", "unsupported_escape")
  local crlf_target = diagnostic("a\\\r\n", "unsupported_escape")
  test.assert(crlf_target ==
    "invalid regular expression [unsupported_escape] " ..
    "at L2:C1 (byte 4): unsupported escape\n\n^")
  diagnostic("\\10", "unsupported_escape")
  diagnostic("\\0", "unsupported_escape")
  diagnostic("\\b", "unsupported_escape")
  diagnostic("$\\v", "unsupported_escape")
  diagnostic("*\\v", "unsupported_escape")
  diagnostic("\\1\\", "dangling_escape")
  diagnostic("[z-a]\\v", "unsupported_escape")
  diagnostic("\\1", "invalid_backreference")
  diagnostic("(\\1a)", "invalid_backreference")
  diagnostic("(?x)", "expected_atom")
  diagnostic("(?", "expected_atom")
  local malformed = diagnostic("a{,2}", "bad_quantifier")
  test.assert(support.contains(malformed, "(byte 3)"), malformed)
  test.assert(support.contains(
    malformed, ": malformed counted quantifier\n"), malformed)
  malformed = diagnostic("a{1,", "bad_quantifier")
  test.assert(support.contains(malformed, "(byte 5)"), malformed)
  test.assert(support.contains(
    malformed, ": malformed counted quantifier\n"), malformed)
  malformed = diagnostic("a{2,1", "bad_quantifier_bounds")
  test.assert(support.contains(malformed, "(byte 6)"), malformed)
  malformed = diagnostic("a{2,1x}", "bad_quantifier_bounds")
  test.assert(support.contains(malformed, "(byte 6)"), malformed)
  malformed = diagnostic("a**", "bad_quantifier")
  test.assert(support.contains(
    malformed, ": malformed counted quantifier\n"), malformed)
  test.assert(strings.compile_regex("a{0002}"):match("aa", nil):whole() ==
              "aa")
  diagnostic("a{999999999999999999999999999999999999}",
             "bad_quantifier")
  local trailing = diagnostic(")", "trailing_input")
  test.assert(support.contains(
    trailing, ": unexpected trailing input\n"), trailing)
  trailing = diagnostic("]", "trailing_input")
  test.assert(support.contains(
    trailing, ": unexpected trailing input\n"), trailing)
  trailing = diagnostic("a){", "trailing_input")
  test.assert(support.contains(trailing, "(byte 2)"), trailing)
  diagnostic("(a?)*", "nullable_repetition")
  diagnostic("(a?)\\1*", "nullable_repetition")
  diagnostic("(|a)+", "nullable_repetition")
  diagnostic("\\<*", "nullable_repetition")
  diagnostic("()*+", "nullable_repetition")
  diagnostic("(a?)*+", "nullable_repetition")
  diagnostic("\\<*{", "nullable_repetition")
  test.assert(strings.compile_regex("(|a){2}"):match("", nil):whole() == "")
  local anchored = diagnostic("a$b", "misplaced_anchor")
  test.assert(support.contains(anchored, "(byte 3)"), anchored)
  diagnostic("a^b", "misplaced_anchor")
  anchored = diagnostic("($)", "misplaced_anchor")
  test.assert(support.contains(anchored, "(byte 2)"), anchored)
  diagnostic("(a$)", "misplaced_anchor")
  diagnostic("a{10000}", "pattern_too_large")
  local after_prefix = diagnostic(
    "prefixa{10000}", "pattern_too_large")
  test.assert(support.contains(
    after_prefix, "at L1:C8 (byte 8)"), after_prefix)
  local after_newline = diagnostic(
    "prefix\na{10000}", "pattern_too_large")
  test.assert(support.contains(
    after_newline, "at L2:C2 (byte 9)"), after_newline)

  local groups200 = strings.rep("()", 200)
  local regex = strings.compile_regex(groups200)
  test.assert(regex:group_count() == 200)
  local found? = regex:match("", nil)
  test.assert(found ~= nil)
  local values: {string?} = {found:values()}
  test.assert(#values == 200)
  diagnostic(strings.rep("()", 201), "too_many_captures")
  diagnostic(strings.rep("(?:", 312) .. strings.rep("(", 201),
             "group_nesting_too_deep")
end

function test_regex_group_depth_and_size_limits(context: test.Context)
  local noncapturing =
    strings.rep("(?:", 512) .. "a" .. strings.rep(")", 512)
  local regex = strings.compile_regex(noncapturing)
  test.assert(regex:group_count() == 0)
  local found? = regex:match("a", nil)
  test.assert(found ~= nil and found:whole() == "a")

  local siblings = strings.compile_regex(strings.rep("(?:a)", 513))
  test.assert(siblings:group_count() == 0)
  test.assert(siblings:match(strings.rep("a", 513), nil):whole() ==
              strings.rep("a", 513))

  local flat = strings.rep("a", 1000)
  test.assert(strings.compile_regex(flat):match(flat, nil):whole() == flat)
  local wide_class = "[" .. strings.rep("a", 1000) .. "]"
  test.assert(strings.compile_regex(wide_class):match("a", nil):whole() ==
              "a")

  local capturing =
    strings.rep("(", 200) .. "a" .. strings.rep(")", 200)
  regex = strings.compile_regex(capturing)
  test.assert(regex:group_count() == 200)
  found = regex:match("a", nil)
  test.assert(found ~= nil and found:whole() == "a")
  local values: {string?} = {found:values()}
  test.assert(#values == 200)
  for index = 1, #values do
    test.assert(values[index] == "a")
  end

  local too_deep =
    strings.rep("(?:", 513) .. "a" .. strings.rep(")", 513)
  local message = support.expect_error(function()
    strings.compile_regex(too_deep)
  end, "[group_nesting_too_deep]")
  test.assert(support.contains(message,
    "at L1:C1537 (byte 1537): regular expression has more than " ..
    "512 nested groups"), message)

  local too_many =
    strings.rep("(", 201) .. "a" .. strings.rep(")", 201)
  message = support.expect_error(function()
    strings.compile_regex(too_many)
  end, "[too_many_captures]")
  test.assert(support.contains(message, "(byte 201)"), message)
end

function test_typed_iteration_and_empty_match_progress(context: test.Context)
  local iterator = strings.gmatch("b a", "(a)|(b)", nil)
  local first? = iterator()
  test.assert(first ~= nil and first:whole() == "b")
  test.assert(first:group(1) == nil and first:group(2) == "b")
  local second? = iterator()
  test.assert(second ~= nil and second:whole() == "a")
  test.assert(second:group(1) == "a" and second:group(2) == nil)
  test.assert(iterator() == nil)

  check_empty_progress("a", {"a"}, "X", 1)
  check_empty_progress("ba", {"", "a"}, "XbX", 2)
  check_empty_progress("ab", {"a", ""}, "XbX", 2)
  check_empty_progress("", {""}, "X", 1)
end

function test_gsub_callback_and_maximum(context: test.Context)
  local calls: {string} = {}
  local output, count = strings.gsub(
    "b ab", "(a)?b", function(found: string): string
      calls[#calls + 1] = found
      return "[" .. found .. "]"
    end, nil)
  test.assert(output == "[b] [ab]" and count == 2)
  test.assert(#calls == 2 and calls[1] == "b" and calls[2] == "ab")

  output, count = strings.gsub(
    "aaaa", "a", function(found: string): string return "X" end, 2)
  test.assert(output == "XXaa" and count == 2)
  local zero_calls = 0
  output, count = strings.gsub(
    "aaaa", "a", function(found: string): string
      zero_calls = zero_calls + 1
      return found
    end, 0)
  test.assert(output == "aaaa" and count == 0 and zero_calls == 0)

  output, count = strings.gsub(
    "a-b", "[ab]", function(found: string): string
      if found == "a" then return found end
      return ""
    end, nil)
  test.assert(output == "a-" and count == 2)
  test.assert(strings.gsub(
    "a", "a", function(found: string): string return "%1" end, nil) ==
    "%1")

  local regex = strings.compile_regex("a+")
  output, count = regex:gsub(
    "xaaayaa", function(found: string): string
      return "<" .. found .. ">"
    end, 1)
  test.assert(output == "x<aaa>yaa" and count == 1)

  output, count = strings.gsub("baaacaa", "(a+)", bracket, nil)
  test.assert(output == "b[aaa]c[aa]" and count == 2)
  output, count = strings.compile_regex("(a+)"):gsub(
    "baaacaa", bracket, nil)
  test.assert(output == "b[aaa]c[aa]" and count == 2)

  support.expect_error(function()
    strings.gsub(
      "a", "a", function(found: string): string
        raise "replacement exploded"
      end, nil)
  end, "replacement exploded")
  test.assert(strings.gsub(
    "a", "a", function(found: string): string
      return "[" .. found .. "]"
    end, nil) == "[a]")
end

function test_regex_gc_rooting(context: test.Context)
  local previous_mode = support.set_gc_mode("generational")
  defer support.set_gc_mode(previous_mode)
  local iterator: () -> strings.RegexMatch? =
    strings.compile_regex("((a|b)+)-\\1"):gmatch(
      "ab-ab xx b-b aa-aa", nil)
  for pass = 1, 12 do support.collect_gc() end
  local values: {string} = {}
  while true do
    support.collect_gc()
    local found? = iterator()
    if not found then break end
    values[#values + 1] = found:whole()
    test.assert(found:group(1) .. "-" .. found:group(1) == found:whole())
  end
  test.assert(#values == 3 and values[1] == "ab-ab" and
              values[2] == "b-b" and values[3] == "aa-aa")

  local callback_calls = 0
  local output, count = strings.gsub(
    "ab-ab b-b", "((a|b)+)-\\1",
    function(found: string): string
      callback_calls = callback_calls + 1
      support.collect_gc()
      test.assert(found == "ab-ab" or found == "b-b")
      return "<" .. found .. ">"
    end, nil)
  test.assert(output == "<ab-ab> <b-b>" and count == 2)
  test.assert(callback_calls == 2)

  support.set_gc_mode("incremental")
  for pass = 1, 12 do support.collect_gc() end
  local found? = strings.match("zz-aa-aa", "((a)+)-\\1", nil)
  test.assert(found ~= nil and found:whole() == "aa-aa")
  test.assert(found:group(1) == "aa")
end

function test_weak_cache_and_binary_matches_across_gc(context: test.Context)
  local previous_mode = support.set_gc_mode("generational")
  defer support.set_gc_mode(previous_mode)
  for index = 1, 12 do
    local subject = "\0\xffA\0\xff"
    local found? = strings.match(subject, "[\0\xff]+", nil)
    test.assert(found ~= nil and found:whole() == "\0\xff")
    local output, count = strings.gsub(
      subject, "[\0\xff]+", function(found_text: string): string
        test.assert(found_text == "\0\xff")
        return "\xff\0"
      end, nil)
    test.assert(output == "\xff\0A\xff\0" and count == 2)
    support.collect_gc()
  end
  support.set_gc_mode("incremental")
end
