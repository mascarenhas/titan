function test_incremental_read_and_delimiter_streaming(_: test.Context)
  runtime_test.run(function ()
    for variant = 1, 2 do
      local response = http.get(raw_server() .. "/stream")
      defer response:close()
      if variant == 1 then
        local first = response:read() or ""
        test.assert(#first > 0 and string.sub("first|", 1, #first) == first,
          "read waited for response completion or changed its first bytes")
        if first ~= "first|" then
          test.assert(response:read_until("|") == string.sub("first|", #first + 1),
            "read lost the rest of the initial bytes")
        end
      else
        test.assert(response:read_until("|") == "first|", "read_until waited for response completion")
      end
      -- The peer cannot produce the rest until this public read has returned.
      test.assert(get_body(raw_server() .. "/release", nil) == "")
      test.assert(response:read_until("|") == "second|", "delimiter read lost the second chunk")
      test.assert(response:read_until("|") == "tail" and response:read() == nil,
        "delimiter read lost or repeated the EOF tail")
    end
  end)
end

function test_gzip_wire_headers_cookies_and_mid_body_reset(_: test.Context)
  runtime_test.run(function ()
    local response = http.get(raw_server() .. "/gzip")
    defer response:close()
    local expected = "decoded\0" .. string.rep("response-body-", 256) .. "\255"
    local compressed? = math.tointeger(response.headers:get("Content-Length") or "")
    test.assert(compressed ~= nil and compressed < #expected and response.headers:get("Content-Encoding") == "gzip",
      "Fetch did not preserve the compressed wire metadata")
    test.assert(all(response) == expected, "decoded Fetch body was truncated to compressed Content-Length")
    local cookies = http.get(server() .. "/cookies")
    defer cookies:close()
    test.assert(cookies.headers:get("Set-Cookie") == nil and cookies.headers:get("Set-Cookie2") == nil and
      all(cookies) == "cookies", "Fetch exposed response cookie headers")
    local reset = http.get(raw_server() .. "/reset")
    defer reset:close()
    test.assert(reset:read_until("partial") == "partial", "reset peer did not expose its first bytes")
    test.assert(get_body(raw_server() .. "/reset-now", nil) == "")
    operation_error(function () reset:read() end, "http.read")
    test.assert(reset:read() == nil, "failed read did not retire its response")
  end)
end
