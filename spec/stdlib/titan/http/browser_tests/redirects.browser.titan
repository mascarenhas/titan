function test_redirect_status_mode_location_matrix(context: test.Context)
  for _, status in iteration.ipairs({301, 302, 303, 307, 308}) do
    for policy = 1, 3 do
      for location = 1, 2 do
        context:run(status .. "_" .. policy .. "_" .. location, function (_: test.Context)
          runtime_test.run(function ()
            local source = server() .. "/redirect/" .. status .. "/without"
            if location == 2 then source = server() .. "/redirect/" .. status .. "/with" end
            local mode = http.RedirectMode.follow()
            if policy == 2 then mode = http.RedirectMode.manual() end
            if policy == 3 then mode = http.RedirectMode.error() end
            const options = http.RequestOptions {redirect = mode}
            if policy == 3 then
              operation_error(function () http.get(source, options) end, "http.request")
            else
              const response = http.get(source, options)
              defer response:close()
              if policy == 2 then
                test.assert(response.status == 0 and response.reason == "" and #response.headers:all() == 0 and
                  response.url == source and not response.redirected and response:read() == nil,
                  "manual redirect changed its opaque envelope: " .. source)
              elseif location == 2 then
                test.assert(response.status == 200 and response.redirected and response.url == server() .. "/inspect" and
                  all(response) == "GET\n\n", "follow did not adopt the final response")
              else
                test.assert(response.status == status and not response.redirected and response.url == source,
                  "follow hid a redirect without Location")
                -- Node's Undici may abort this body despite returning its head.
                -- Real browsers must retain the readable response.
                if in_browser() then test.assert(all(response) == "redirect") end
                response:close()
              end
            end
          end)
        end)
      end
    end
  end
end

function test_redirect_rewrites_preservation_limit_and_authorization(_: test.Context)
  runtime_test.run(function ()
    for _, status in iteration.ipairs({301, 302, 303, 307, 308}) do
      for _, method in iteration.ipairs({"POST", "PUT"}) do
        const body = "redirect\0\255body"
        const options = http.RequestOptions {body = body, redirect = http.RedirectMode.follow()}
        const source = server() .. "/redirect/" .. status .. "/with"
        const response = http.request(method, source, options)
        defer response:close()
        const rewritten = status == 303 or (method == "POST" and (status == 301 or status == 302))
        local expected = method .. "\n\n" .. body
        if rewritten then expected = "GET\n\n" end
        test.assert(response.status == 200 and response.redirected and all(response) == expected,
          "redirect method/body policy changed for " .. status .. " " .. method)
        -- An options snapshot remains usable after host redirect rewriting.
        const echo = http.request(method, server() .. "/echo", options)
        defer echo:close()
        test.assert(all(echo) == body, "redirect mutated the RequestOptions snapshot")
      end
    end
    const twenty = http.get(server() .. "/chain/20")
    defer twenty:close()
    test.assert(twenty.status == 200 and twenty.redirected and twenty.url == server() .. "/chain/0")
    operation_error(function () http.get(server() .. "/chain/21") end, "http.request")
    const cross_target = "http://localhost:" .. url.parse(server()).port .. "/inspect"
    const redirected = http.get(server() .. "/cross", http.RequestOptions {headers = one_header("Authorization", "Bearer private")})
    defer redirected:close()
    const received = all(redirected)
    test.assert(redirected.status == 200 and redirected.redirected and redirected.url == cross_target and received == "GET\n\n",
      "cross-origin redirect mismatch: " .. redirected.status .. " url=" .. (redirected.url or "") .. " body=" .. received)
  end)
end
