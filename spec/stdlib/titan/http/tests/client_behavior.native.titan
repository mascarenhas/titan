local function start_client(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local server, port = support.raw_listen(first_port)
    defer server:close()
    const peer = async.run<|value, value|>(function (): value
      const connection = server:accept()
      defer connection:close()
      defer server:close()
      support.outcome = "peer-reading-request"
      const preamble = connection:read_until("\r\n\r\n", false)
      if not preamble then raise "HTTP client sent no request" end
      const request_text = preamble as string
      test.assert(support.contains(request_text, "POST /path?q=one HTTP/1.1\r\n"),
            "HTTP client sent the wrong request target")
      test.assert(support.contains(request_text, "Host: 127.0.0.1:" ..
                     string.tostring(port) .. "\r\n"),
            "HTTP client sent the wrong Host header")
      test.assert(not support.contains(request_text, "Connection: close\r\n"),
            "HTTP client unnecessarily disabled persistent connections")
      test.assert(support.read_exact(connection, 12) == "request\0body",
            "HTTP client changed the request body")
      support.outcome = "peer-writing-response"

      const response =
        "HTTP/1.1 302 Found\r\n" ..
        "X-Duplicate: one\r\n" ..
        "x-duplicate: two\r\n" ..
        "Transfer-Encoding: chunked\r\n" ..
        "Content-Encoding: gzip\r\n" ..
        "Connection: close\r\n\r\n" ..
        "4;kind=test\r\na\0b\n\r\n" ..
        "5\r\ntrail\r\n" ..
        "0\r\nX-Trailer: done\r\n\r\n"
      local index = 1
      while index <= #response do
        connection:write(string.sub(response, index, index))
        index = index + 1
      end
      connection:close()
      server:close()
      support.outcome = "peer-done"
      return nil
    end)
    defer task_support.cancel_and_join_task(peer, "nested HTTP peer cleanup")

    const request_headers = http.headers(nil)
    request_headers:add("X-Request", "present")
    support.outcome = "client-requesting"
    const response = http.request(
      "POST", "http://127.0.0.1:" .. string.tostring(port) ..
      "/path?q=one", http.RequestOptions { headers = request_headers, body = "request\0body" })
    defer response:close()
    support.outcome = "client-reading-response"
    test.assert(response.status == 302 and response.reason == "Found",
          "HTTP client did not return the redirect response")
    const duplicates = response.headers:values("x-duplicate")
    test.assert(#duplicates == 2 and duplicates[1] == "one" and
          duplicates[2] == "two",
          "HTTP headers lost spelling-independent duplicates")
    test.assert(response.headers:get("Content-Encoding") == "gzip",
          "HTTP client removed content encoding")
    test.assert(response:read_until("\n", true) == "a\0b",
          "HTTP client did not decode the first chunk")
    const remaining = string.writer()
    for chunk in response:read do remaining:write(chunk) end
    test.assert(remaining:drain() == "trail",
          "HTTP client did not decode the second chunk")
    test.assert(response.headers:get("X-Trailer") == "done",
          "HTTP client did not retain a trailer")
    while task_support.active(peer) do timer.yield() end
    test.assert(peer:status():has_succeeded(), "raw HTTP peer failed")
    support.outcome = "client-ok"
    return nil
  end)
end

local function expect_client_url_rejected(source_url: string,
                                          authority: string,
                                          expected_kind: string)
  local expected_url?, expected_error? =
    url.parse_request("http", authority, "/")
  test.assert(expected_url == nil and expected_error ~= nil,
        "URL request parser accepted invalid Host: " .. authority)
  const expected_diagnostic = expected_error as url.Error
  const request_headers = http.headers(nil)
  request_headers:add("Host", authority)
  local rejected = false
  do
    const response = http.get(source_url, http.RequestOptions { headers = request_headers })
    defer response:close()
    response:close()
  catch
    test.assert(error is url.Error,
          "HTTP client did not raise the URL parser's error record")
    const diagnostic = error as url.Error
    test.assert(diagnostic.kind == expected_kind and
          diagnostic.kind == expected_diagnostic.kind,
          "HTTP client URL error kind was " .. diagnostic.kind ..
          ", expected " .. expected_kind)
    test.assert(diagnostic.position == expected_diagnostic.position and
          diagnostic.message == expected_diagnostic.message,
          "HTTP client changed the URL parser's Host diagnostic")
    rejected = true
  end
  test.assert(rejected, "HTTP client accepted invalid Host: " .. authority)
end

local function start_client_host_validation(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local server, port = support.raw_listen(first_port)
    defer server:close()
    const peer = async.run<|value, value|>(function (): value
      const connection = server:accept()
      defer connection:close()
      defer server:close()
      const preamble = connection:read_until("\r\n\r\n", false)
      if not preamble then raise "HTTP client sent no Host test request" end
      test.assert(support.contains(preamble as string,
                     "Host: [2001:db8::1]:8443\r\n"),
            "HTTP client changed a valid supplied IP-literal Host")
      connection:write(
        "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
      return nil
    end)
    defer task_support.cancel_and_join_task(peer, "nested HTTP peer cleanup")

    const request_headers = http.headers(nil)
    request_headers:add("Host", "[2001:db8::1]:8443")
    const source_url =
      "http://127.0.0.1:" .. string.tostring(port) .. "/host-check"
    const response = http.get(source_url, http.RequestOptions { headers = request_headers })
    defer response:close()
    test.assert(response.status == 204,
          "HTTP client did not accept a valid supplied IP-literal Host")
    response:close()
    while task_support.active(peer) do timer.yield() end
    test.assert(peer:status():has_succeeded(), "Host validation peer failed")

    expect_client_url_rejected(source_url, "", "host")
    expect_client_url_rejected(source_url, "user@example.com", "userinfo")
    expect_client_url_rejected(
      source_url, "example.com/path", "authority_tail")
    expect_client_url_rejected(
      source_url, "example.com?query", "authority_tail")
    expect_client_url_rejected(
      source_url, "example.com#fragment", "authority_tail")
    expect_client_url_rejected(source_url, "::1", "ipv6_brackets")
    expect_client_url_rejected(source_url, "[::1", "ipv6_close")
    expect_client_url_rejected(source_url, "[::1]:0", "port")
    expect_client_url_rejected(source_url, "[::1]:65536", "port")
    expect_client_url_rejected(source_url, "example.com:oops", "port")

    const duplicate_headers = http.headers(nil)
    duplicate_headers:add("Host", "example.com")
    duplicate_headers:add("host", "example.net")
    local duplicate_rejected = false
    do
      const duplicate_response =
        http.get(source_url, http.RequestOptions { headers = duplicate_headers })
      defer duplicate_response:close()
      duplicate_response:close()
    catch
      const message = error as string
      test.assert(support.contains(message, "more than one Host header"),
            "HTTP client rejected duplicate Host for the wrong reason")
      duplicate_rejected = true
    end
    test.assert(duplicate_rejected,
          "HTTP client accepted more than one supplied Host field")

    const expect_headers = http.headers(nil)
    expect_headers:add("Expect", "100-continue")
    local expect_rejected = false
    do
      const expect_response = http.request(
        "POST", source_url, http.RequestOptions { headers = expect_headers, body = "body" })
      defer expect_response:close()
      expect_response:close()
    catch
      const message = error as string
      test.assert(support.contains(message, "do not support Expect"),
            "HTTP client rejected Expect for the wrong reason")
      expect_rejected = true
    end
    test.assert(expect_rejected,
          "HTTP client emitted an Expect field without withholding the body")

    support.outcome = "client-host-validation-ok"
    return nil
  end)
end

local function expect_header_rejected(name: string, contents: string,
                                      expected: string)
  local rejected = false
  do
    const values = http.headers(nil)
    values:add(name, contents)
  catch
    test.assert(error is string,
          "HTTP header validation raised a non-string error")
    const message = error as string
    test.assert(support.contains(message, expected),
          "HTTP header validation failed for the wrong reason: " .. message)
    rejected = true
  end
  test.assert(rejected, "HTTP headers accepted invalid input")
end

local function expect_length_rejected(contents: string, expected: string)
  const supplied = http.headers(nil)
  supplied:add("Content-Length", contents)
  local rejected = false
  do
    const response = http.request(
      "POST", "http://127.0.0.1:1/", http.RequestOptions { headers = supplied, body = "body" })
    defer response:close()
    response:close()
  catch
    test.assert(error is string,
          "HTTP Content-Length validation reached the network")
    const message = error as string
    test.assert(support.contains(message, expected),
          "HTTP Content-Length failed for the wrong reason: " .. message)
    rejected = true
  end
  test.assert(rejected, "HTTP client accepted an invalid Content-Length")
end

local function start_header_validation(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    const valid_name =
      "!#$" .. string.char(37) .. "&'*+-.^_`|~09AZaz"
    const valid_contents = string.char(9, 32, 126, 128, 255)
    const accepted = http.headers(nil)
    accepted:add(valid_name, valid_contents)
    test.assert(accepted:get(
            "!#$" .. string.char(37) .. "&'*+-.^_`|~09azaz") ==
          valid_contents,
          "HTTP header token or ASCII case folding changed valid bytes")

    expect_header_rejected("", "value", "must not be empty")
    const invalid_names = {
      "bad:name", "bad name", "bad" .. string.char(0),
      "bad" .. string.char(9), "bad" .. string.char(31),
      "bad" .. string.char(127), "bad" .. string.char(128),
    }
    for index = 1, #invalid_names do
      expect_header_rejected(
        invalid_names[index], "value", "invalid byte")
    end

    const forbidden_values = {0, 8, 10, 13, 31, 127}
    for index = 1, #forbidden_values do
      expect_header_rejected(
        "X-Invalid-Value", "ok" .. string.char(forbidden_values[index]),
        "forbidden byte")
    end

    local method_rejected = false
    do
      const response = http.request(
        "BAD METHOD", "http://127.0.0.1:1/")
      defer response:close()
      response:close()
    catch
      test.assert(error is string and
            support.contains(error as string, "HTTP method contains an invalid byte"),
            "HTTP method validation failed for the wrong reason")
      method_rejected = true
    end
    test.assert(method_rejected, "HTTP client accepted an invalid method token")

    expect_length_rejected("", "must not be empty")
    expect_length_rejected("12x", "only decimal digits")
    expect_length_rejected(string.rep("9", 100, nil), "too large")

    -- llhttp validates status-code framing but deliberately treats the reason
    -- phrase as an opaque span. The high-level client still enforces the same
    -- field-value byte repertoire that the server uses for outbound reasons.
    const forbidden_reasons = {1, 127}
    local server, port = support.raw_listen(first_port)
    defer server:close()
    const peer = async.run<|value, value|>(function (): value
      defer server:close()
      for index = 1, #forbidden_reasons do
        const connection = server:accept()
        defer connection:close()
        const preamble = connection:read_until("\r\n\r\n", false)
        if not preamble then raise "reason-validation peer saw no request" end
        if index == 1 then
          connection:write(
            "HTTP/1.1 103 bad" .. string.char(forbidden_reasons[index]) ..
            "\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 0\r\n" ..
            "Connection: close\r\n\r\n")
        else
          connection:write(
            "HTTP/1.1 200 bad" .. string.char(forbidden_reasons[index]) ..
            "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        end
        connection:close()
      end
      return nil
    end)
    defer task_support.cancel_and_join_task(peer, "nested HTTP peer cleanup")
    for _ = 1, #forbidden_reasons do
      local reason_rejected = false
      do
        const response = http.get(
          "http://127.0.0.1:" .. string.tostring(port) .. "/")
        defer response:close()
        response:close()
      catch
        test.assert(error is string and
              support.contains(error as string,
                       "reason phrase contains a forbidden"),
              "HTTP client rejected an invalid reason for the wrong reason")
        reason_rejected = true
      end
      test.assert(reason_rejected,
            "HTTP client accepted a forbidden reason-phrase byte")
    end
    while task_support.active(peer) do timer.yield() end
    test.assert(peer:status():has_succeeded(),
          "reason-validation peer failed")

    support.outcome = "header-validation-ok"
    return nil
  end)
end


local function start_client_framing(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local server, port = support.raw_listen(first_port)
    defer server:close()
    local current: net.Connection? = nil
    defer do
      if current ~= nil then
        (current as net.Connection):close()
      catch end
    end
    local timed_out = false
    const watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      support.outcome = "client-framing-timeout-after-" .. support.outcome
      if current then
        (current as net.Connection):close()
      catch end
      do server:close() catch end
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")
    const peer = async.run<|value, value|>(function (): value
      defer server:close()
      for index = 1, 7 do
        do
          const connection = server:accept()
          defer connection:close()
          current = connection
          const preamble? = connection:read_until("\r\n\r\n", false)
          if not preamble then raise "HTTP client sent no request" end
          const request_text = preamble as string
          if index == 1 then
            test.assert(support.contains(request_text, "GET /fixed HTTP/1.1\r\n"),
                  "fixed-length client case sent the wrong request")
            connection:write(
              "HTTP/1.1 100 Continue\r\nX-Info: interim\r\n\r\n" ..
              "HTTP/1.1 206 Partial Content\r\n" ..
              "Content-Length: 5\r\nConnection: close\r\n\r\nfixed")
          elseif index == 2 then
            test.assert(support.contains(request_text, "HEAD /head HTTP/1.1\r\n"),
                  "HEAD client case sent the wrong method")
            connection:write(
              "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n" ..
              "Connection: close\r\n\r\n")
          elseif index == 3 then
            test.assert(support.contains(request_text,
                           "head /lowercase-head HTTP/1.1\r\n"),
                  "lowercase method client case changed the method")
            connection:write(
              "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n" ..
              "Connection: close\r\n\r\nbody")
          elseif index == 4 then
            test.assert(support.contains(request_text, "GET /eof HTTP/1.1\r\n"),
                  "EOF-delimited client case sent the wrong request")
            connection:write(
              "HTTP/1.1 200 OK\r\nX-Mode: eof\r\n\r\neof-body")
          elseif index == 5 then
            test.assert(support.contains(request_text, "GET /truncated HTTP/1.1\r\n"),
                  "truncated client case sent the wrong request")
            connection:write(
              "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n" ..
              "Connection: close\r\n\r\nabc")
          elseif index == 6 then
            test.assert(support.contains(request_text, "GET /malformed HTTP/1.1\r\n"),
                  "malformed client case sent the wrong request")
            connection:write(
              "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n" ..
              "Transfer-Encoding: chunked\r\n" ..
              "Connection: close\r\n\r\n0\r\n\r\n")
          else
            test.assert(support.contains(request_text,
                           "GET /informational-eof HTTP/1.1\r\n"),
                  "informational EOF case sent the wrong request")
            connection:write(
              "HTTP/1.1 103 Early Hints\r\nX-Info: only\r\n\r\n")
          end
        end
        current = nil
      end
      return nil
    end)
    defer task_support.cancel_and_join_task(peer, "nested HTTP peer cleanup")

    const base = "http://127.0.0.1:" .. string.tostring(port)
    support.outcome = "client-fixed"
    const fixed = http.get(base .. "/fixed")
    defer fixed:close()
    test.assert(fixed.status == 206 and fixed.reason == "Partial Content",
          "HTTP client did not skip the informational response")
    test.assert(fixed.headers:get("X-Info") == nil,
          "HTTP client retained informational response headers")
    test.assert(support.read_response(fixed) == "fixed",
          "HTTP client did not read the fixed-length body")

    support.outcome = "client-head"
    const head = http.request(
      "HEAD", base .. "/head")
    defer head:close()
    test.assert(head.headers:get("Content-Length") == "5" and
          head:read() == nil,
          "HTTP client expected a body for a HEAD response")
    head:close()

    support.outcome = "client-lowercase-head"
    const lowercase_head = http.request(
      "head", base .. "/lowercase-head")
    defer lowercase_head:close()
    test.assert(support.read_response(lowercase_head) == "body",
          "HTTP client treated a case-distinct method as HEAD")

    support.outcome = "client-eof"
    const eof_response = http.get(base .. "/eof")
    defer eof_response:close()
    test.assert(support.read_response(eof_response) == "eof-body",
          "HTTP client did not read the EOF-delimited body")

    support.outcome = "client-truncated"
    const truncated = http.get(base .. "/truncated")
    defer truncated:close()
    local truncated_failed = false
    do
      support.read_response(truncated)
    catch
      truncated_failed = true
    end
    test.assert(truncated_failed,
          "HTTP client accepted a truncated Content-Length body")

    support.outcome = "client-malformed"
    local malformed_failed = false
    do
      const malformed = http.get(base .. "/malformed")
      defer malformed:close()
      malformed:close()
    catch
      malformed_failed = true
    end
    test.assert(malformed_failed,
          "HTTP client accepted conflicting response framing")

    support.outcome = "client-informational-eof"
    local informational_failed = false
    do
      const informational = http.get(
        base .. "/informational-eof")
      defer informational:close()
      informational:close()
    catch
      test.assert(error is string and
            support.contains(error as string,
                     "HTTP message ended before it was complete"),
            "HTTP client reported the wrong informational EOF error")
      informational_failed = true
    end
    test.assert(informational_failed,
          "HTTP client accepted EOF after only an informational response")

    while task_support.active(peer) do timer.yield() end
    watchdog:cancel(async.CancellationReason.simple(
      "client framing completed"))
    async.join(watchdog)
    test.assert(not timed_out, "HTTP client framing matrix timed out")
    test.assert(peer:status():has_succeeded(), "raw framing peer failed")
    support.outcome = "client-framing-ok"
    return nil
  end)
end
