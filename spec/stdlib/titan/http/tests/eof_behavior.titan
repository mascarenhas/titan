local function start_keep_alive_eof(first_port: integer,
                                    buffered_suffix: string,
                                    suffix: string, result: string,
                                    test_immediate: boolean): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handled = 0
    local handler: http.Handler = function (request: http.Request,
                                            response: http.Response)
      handled = handled + 1
      test.assert(request.target == "/first",
            "keep-alive EOF reached an unexpected handler")
      response:set_header("Content-Length", "0")
    end
    local server, port = support.http_listen(first_port, handler)
    defer server:close()
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    local current: net.Connection? = nil
    defer do
      if current ~= nil then
        do (current as net.Connection):close() catch end
      end
    end
    local timed_out = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      support.outcome = "keep-alive-eof-timeout-after-" .. support.outcome
      if current then
        do (current as net.Connection):close() catch end
      end
      do server:close() catch end
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")

    if test_immediate then
      -- Closing before request 1 and after a completed keep-alive request are
      -- both idle parser EOFs, not malformed messages.
      support.outcome = "keep-alive-immediate-eof"
      local immediate = net.connect("127.0.0.1", port)
      defer immediate:close()
      current = immediate
      immediate:shutdown()
      test.assert(immediate:read() == nil,
            "HTTP server did not close an idle initial connection")
      immediate:close()
      current = nil
    end

    local client = net.connect("127.0.0.1", port)
    defer client:close()
    current = client
    client:write(
      "GET /first HTTP/1.1\r\nHost: localhost\r\n\r\n" ..
      buffered_suffix)
    local response? = client:read_until("\r\n\r\n", false)
    test.assert(response ~= nil and
          support.contains(response as string, "Content-Length: 0\r\n") and
          not support.contains(response as string, "Connection: close\r\n"),
          "HTTP server did not leave the first response reusable")
    if #suffix > 0 then client:write(suffix) end
    support.outcome = "keep-alive-client-shutdown"
    client:shutdown()
    test.assert(client:read() == nil,
          "HTTP server did not close after the keep-alive peer EOF")
    client:close()
    current = nil

    server:close()
    watchdog:cancel(async.CancellationReason.simple(
      "keep-alive EOF completed"))
    async.join(watchdog)
    test.assert(not timed_out, "HTTP keep-alive EOF matrix timed out")
    while task_support.active(serving) do timer.yield() end
    test.assert(serving:status():has_succeeded(),
          "HTTP listener failed during keep-alive EOF handling")
    test.assert(handled == 1,
          "HTTP server dispatched an incomplete second request")
    support.outcome = result
    return nil
  end)
end

local function start_idle_keep_alive_eof(first_port: integer): async.Task
  return start_keep_alive_eof(
    first_port, "", "", "idle-keep-alive-eof-ok", true)
end

local function start_buffered_empty_lines_eof(
    first_port: integer): async.Task
  return start_keep_alive_eof(
    first_port, "\r\n\r\n", "",
    "buffered-empty-lines-eof-ok", false)
end

local function start_partial_keep_alive_eof(first_port: integer): async.Task
  return start_keep_alive_eof(
    first_port, "G", "", "partial-keep-alive-eof-ok", false)
end

local function start_partial_empty_line_eof(first_port: integer): async.Task
  return start_keep_alive_eof(
    first_port, "", "\r", "partial-empty-line-eof-ok", false)
end
