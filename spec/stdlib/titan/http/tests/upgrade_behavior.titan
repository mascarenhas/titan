-- A public stream implementation makes every response split and abort order
-- deterministic without coupling these tests to llhttp or native handles.
local record OpeningStream
  chunks: {string}
  index: integer
  output: string
  closed: boolean
  aborts: integer
  blocked_write: boolean
  writer: async.Task?
  token: async.ResumeToken
end

local function opening_stream(chunks: {string}, blocked: boolean?): OpeningStream
  return OpeningStream {
    chunks = chunks, index = 1, output = "", closed = false,
    aborts = 0, blocked_write = blocked or false, writer = nil,
    token = async.ResumeToken("HTTP test accepted output"),
  }
end

function OpeningStream:read(): string?
  if self.closed then return nil end
  local result? = self.chunks[self.index]
  self.index = self.index + 1
  return result
end

function OpeningStream:read_until(_: string, _chop: boolean?): string?
  raise "HTTP opening must parse stream chunks"
end

function OpeningStream:write(data: string)
  self.output = self.output .. data
  if not self.blocked_write then return end
  local current = async.running()
  self.writer = current
  local detach = function ()
    if self.writer == current then self.writer = nil end
  end
  defer detach()
  async.suspend(self.token, detach)
  if self.closed then raise "HTTP test output aborted" end
end

function OpeningStream:close()
  if self.closed then return end
  self.closed = true
  self.aborts = self.aborts + 1
  local writer? = self.writer
  if writer then writer:resume(self.token) end
end

local record OpeningFailure
  operation: string
end

local record FailingOpeningStream
  sentinel: OpeningFailure
  fail_write: boolean
  original_trace: string
  closed: boolean
  aborts: integer
end

local function FailingOpeningStream:fail()
  do raise self.sentinel
  catch
    self.original_trace = traceback
    raise
  end
end

function FailingOpeningStream:read(): string?
  if self.closed then return nil end
  self:fail()
  return nil
end

function FailingOpeningStream:read_until(_: string, _chop: boolean?): string?
  if self.closed then return nil end
  self:fail()
  return nil
end

function FailingOpeningStream:write(_: string)
  if self.fail_write then self:fail() end
end

function FailingOpeningStream:close()
  if self.closed then return end
  self.closed = true
  self.aborts = self.aborts + 1
end

local function opening_error_trace(fail_write: boolean)
  runtime_test.run(function ()
    local sentinel = OpeningFailure("public HTTP opening I/O")
    local stream = FailingOpeningStream(sentinel, fail_write, "", false, 0)
    local actual_error: value = nil
    local actual_trace = ""
    do
      http.request_upgrade_on(stream, stream:close, "http://example.test/", "echo")
    catch
      actual_error = error
      actual_trace = traceback
    end
    test.assert(actual_error is OpeningFailure and
                (actual_error as OpeningFailure) == sentinel,
                "HTTP supervisor replaced the exact nominal I/O error")
    test.assert(#stream.original_trace > 0 and actual_trace == stream.original_trace,
                "HTTP supervisor replaced the original I/O traceback")
    test.assert(stream.aborts == 1, "failed HTTP opening did not retire its transport")
  end)
end

function test_upgrade_supervisor_preserves_original_io_trace(context: test.Context)
  context:run("write", function (_: test.Context) opening_error_trace(true) end)
  context:run("read", function (_: test.Context) opening_error_trace(false) end)
end

local UPGRADE_RESPONSE =
  "HTTP/1.1 101 Switching Protocols\r\n" ..
  "Connection: Upgrade\r\nUpgrade: echo\r\n\r\n"
local UPGRADE_SUFFIX = "x\0prefixENDtail\0"

local function assert_http_error(action: function (): (), expected: string)
  local rejected = false
  do action()
  catch
    test.assert(error is string, "HTTP state failure was not a string")
    test.assert(support.contains(error as string, expected),
                "HTTP state failure did not identify its cause")
    rejected = true
  end
  test.assert(rejected, "HTTP accepted an invalid operation")
end

local function client_upgrade_split(split: integer)
  local input = UPGRADE_RESPONSE .. UPGRADE_SUFFIX
  local stream = opening_stream({
    string.sub(input, 1, split), string.sub(input, split + 1),
  })
  local response = http.request_upgrade_on(
    stream, stream:close, "http://example.test/path?q=one", "echo")
  defer response:close()
  test.assert(response.status == 101 and response.version == "HTTP/1.1")
  test.assert(support.contains(stream.output, "GET /path?q=one HTTP/1.1\r\n"))
  test.assert(support.contains(stream.output, "Connection: Upgrade\r\n"))
  assert_http_error(function () response:read() end, "no readable body")
  local upgraded = response:take_upgrade()
  defer upgraded:close()
  assert_http_error(function () response:take_upgrade() end, "no pending upgrade")
  test.assert(upgraded:read_until("END", true) == "x\0prefix",
              "HTTP upgrade lost bytes at the parser/stream boundary")
  local tail = string.writer()
  for chunk in upgraded:read do tail:write(chunk) end
  test.assert(tail:drain() == "tail\0", "HTTP upgrade changed binary excess")
  response:close()
  test.assert(stream.aborts == 0, "transferred response still owned its transport")
  upgraded:close()
  upgraded:close()
  test.assert(stream.aborts == 1, "upgraded stream did not retire exactly once")
end

function test_upgrade_client_preserves_every_binary_header_split(context: test.Context)
  local input = UPGRADE_RESPONSE .. UPGRADE_SUFFIX
  for split = 1, #input do
    context:run("split_" .. split, function (_: test.Context)
      runtime_test.run(function () client_upgrade_split(split) end)
    end)
  end
end

function test_upgrade_client_header_bound_excludes_binary_suffix(_: test.Context)
  runtime_test.run(function ()
    local prefix = "HTTP/1.1 101 Switching Protocols\r\n" ..
      "Connection: Upgrade\r\nUpgrade: echo\r\nX-Pad: "
    local header = prefix .. string.rep("x", 65536 - #prefix - 4) .. "\r\n\r\n"
    local stream = opening_stream({header .. string.rep("\0z", 65536)})
    local response = http.request_upgrade_on(
      stream, stream:close, "http://example.test/", "echo")
    defer response:close()
    local upgraded = response:take_upgrade()
    defer upgraded:close()
    test.assert(upgraded:read() == string.rep("\0z", 65536),
                "HTTP header limit charged coalesced protocol input")

    local excessive = opening_stream({prefix ..
      string.rep("x", 65536 - #prefix - 3) .. "\r\n\r\n"})
    assert_http_error(function ()
      http.request_upgrade_on(excessive, excessive:close,
                              "http://example.test/", "echo")
    end, "exceed the configured limit")
    test.assert(excessive.aborts == 1, "oversized opening did not abort")
  end)
end

function test_upgrade_client_bounds_interim_responses(_: test.Context)
  runtime_test.run(function ()
    local interim = "HTTP/1.1 100 Continue\r\n\r\n"
    local allowed = opening_stream({string.rep(interim, 16) .. UPGRADE_RESPONSE})
    local response = http.request_upgrade_on(
      allowed, allowed:close, "http://example.test/", "echo")
    defer response:close()
    test.assert(response.status == 101)
    local excessive = opening_stream({string.rep(interim, 17) .. UPGRADE_RESPONSE})
    assert_http_error(function ()
      http.request_upgrade_on(excessive, excessive:close,
                              "http://example.test/", "echo")
    end, "too many interim responses")
    test.assert(excessive.aborts == 1)
  end)
end

function test_upgrade_rejection_remains_readable_and_owned(_: test.Context)
  runtime_test.run(function ()
    local stream = opening_stream({
      "HTTP/1.1 403 Forbidden\r\nContent-Length: 4\r\n\r\nno\0!",
    })
    local response = http.request_upgrade_on(
      stream, stream:close, "http://example.test/", "echo")
    defer response:close()
    test.assert(response.status == 403)
    assert_http_error(function () response:take_upgrade() end, "no pending upgrade")
    test.assert(response:read_until("!", false) == "no\0!")
    test.assert(response:read() == nil and stream.aborts == 1)
  end)
end

function test_upgrade_opening_cancellation_aborts_before_output_drain(_: test.Context)
  runtime_test.run(function ()
    local stream = opening_stream({}, true)
    local opening = async.run<|nil, value|>(function (): nil
      local response = http.request_upgrade_on(
        stream, stream:close, "http://example.test/", "echo")
      defer response:close()
      return nil
    end)
    defer task_support.cancel_and_join_task(opening, "HTTP cancellation test cleanup")
    while stream.writer == nil do timer.yield() end
    opening:cancel(async.CancellationReason.simple("cancel accepted HTTP output"))
    local status = async.join(opening)
    test.assert(status:has_cancelled(), "opening did not preserve Task cancellation")
    test.assert(stream.closed and stream.aborts == 1 and stream.writer == nil,
                "opening published cancellation before abort and output retirement")
  end)
end

local function run_upgrade_server(first_port: integer,
                                   offered: string?, selected: string?)
  local protocol = "echo"
  if selected then protocol = selected end
  local protocols = protocol
  if offered then protocols = offered end
  local session: async.Task<|nil, value|>? = nil
  local handler_returned = false
  local server, port = support.http_listen(first_port,
    function (request: http.Request, response: http.Response)
      response:set_header("X-Handler", "preserved")
      local extra = http.headers(nil)
      extra:add("X-Accepted", "yes")
      local upgraded = response:upgrade(request, protocol, extra)
      response:abort() -- HTTP has transferred ownership; this must be a no-op.
      assert_http_error(function () request:read() end, "exchange has ended")
      assert_http_error(function () response:write("HTTP body") end, "exchange has ended")
      session = async.run<|nil, value|>(function (): nil
        defer upgraded:close()
        local suffix = upgraded:read_until("END", false)
        test.assert(suffix == "x\0prefixEND")
        test.assert(handler_returned, "HTTP handler did not return before the new owner ran")
        upgraded:write("accepted:" .. suffix)
        return nil
      end)
      handler_returned = true
    end)
  defer server:close()
  local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
  defer task_support.cancel_and_join_task(serving, "HTTP upgrade serving cleanup")
  local connection = net.connect("127.0.0.1", port)
  defer connection:close()
  connection:write("GET /upgrade HTTP/1.1\r\nHost: example.test\r\n" ..
    "Connection: Upgrade\r\nUpgrade: " .. protocols .. "\r\n\r\nx\0prefixEND")
  local preamble = connection:read_until("\r\n\r\n", false)
  test.assert(support.contains(preamble, "HTTP/1.1 101 Switching Protocols\r\n"))
  test.assert(support.contains(preamble, "X-Accepted: yes\r\n"))
  test.assert(support.contains(preamble, "X-Handler: preserved\r\n"))
  test.assert(not support.contains(preamble, "Content-Length") and
              not support.contains(preamble, "Transfer-Encoding"))
  test.assert(connection:read_until("END", false) == "accepted:x\0prefixEND",
              "HTTP outer handler cleanup closed a transferred session")
  test.assert(async.join(session):has_succeeded(), "transferred HTTP session failed")
end

function test_upgrade_server_transfers_binary_excess_and_handler_lifetime(_: test.Context)
  runtime_test.run(function () run_upgrade_server(58500) end)
end

function test_upgrade_server_accepts_versioned_protocol_lists(context: test.Context)
  context:run("websocket_and_versioned_offer", function (_: test.Context)
    runtime_test.run(function ()
      run_upgrade_server(59500, "WebSocket, IRC/6.9", "websocket")
    end)
  end)
  context:run("versioned_protocol_selection", function (_: test.Context)
    runtime_test.run(function ()
      run_upgrade_server(59600, "websocket, IRC/6.9", "irc/6.9")
    end)
  end)
end

function test_upgrade_server_rejection_does_not_drain_protocol_suffix(_: test.Context)
  runtime_test.run(function ()
    local called = 0
    local server, port = support.http_listen(58600,
      function (_: http.Request, response: http.Response)
        called = called + 1
        response:set_status(403)
        response:set_header("Content-Length", "0")
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP rejection cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    connection:write("GET /upgrade HTTP/1.1\r\nHost: example.test\r\n" ..
      "Connection: Upgrade\r\nUpgrade: echo\r\n\r\n\0binary suffix")
    local preamble = connection:read_until("\r\n\r\n", false)
    test.assert(support.contains(preamble, "HTTP/1.1 403 Forbidden\r\n"))
    test.assert(support.contains(preamble, "Connection: close\r\n"))
    test.assert(connection:read() == nil and called == 1)
  end)
end

function test_http_header_limit_setting_and_scheme_guard(_: test.Context)
  runtime_test.run(function ()
    local server, _port = support.http_listen(58700,
      function (_request: http.Request, _response: http.Response) end)
    defer server:close()
    test.assert(server:header_limit() == 65536)
    test.assert(server:header_limit(12345) == 65536)
    test.assert(server:header_limit() == 12345)
    assert_http_error(function () server:header_limit(0) end, "must be positive")
    test.assert(server:header_limit() == 12345)
    local rejected = false
    do http.get("wss://example.test/")
    catch
      test.assert(error is url.Error and (error as url.Error).kind == "scheme")
      rejected = true
    end
    test.assert(rejected, "ordinary HTTP routed a WebSocket URL")
  end)
end

function test_http_server_header_limit_counts_raw_leading_lines(context: test.Context)
  runtime_test.run(function ()
    local called = 0
    local request_text = "GET / HTTP/1.1\r\nHost: example.test\r\nConnection: close\r\n\r\n"
    local server, port = support.http_listen(58800,
      function (_request: http.Request, response: http.Response)
        called = called + 1
        response:set_header("Content-Length", "0")
      end)
    defer server:close()
    server:header_limit(#request_text + 2)
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP header cap cleanup")
    local exact = net.connect("127.0.0.1", port)
    defer exact:close()
    exact:write("\r\n" .. request_text)
    local preamble = exact:read_until("\r\n\r\n", false)
    test.assert(support.contains(preamble, "HTTP/1.1 200 OK\r\n") and called == 1)
    exact:close()
    context:log("BEGIN expected uncaught async Task diagnostics")
    local excessive = net.connect("127.0.0.1", port)
    defer excessive:close()
    excessive:write("\r\n\r\n" .. request_text)
    test.assert(excessive:read() == nil,
                "over-limit request reached HTTP response processing")
    context:log("END expected uncaught async Task diagnostics")
    test.assert(called == 1, "raw leading lines were not charged before the handler")
  end)
end

function test_upgrade_rejects_malformed_body_without_draining(_: test.Context)
  runtime_test.run(function ()
    local completed = false
    local server, port = support.http_listen(58900,
      function (request: http.Request, response: http.Response)
        local fields = http.headers(nil)
        fields:add("X-Rejection", "checked")
        response:reject_upgrade(request, 400, fields)
        completed = true
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP malformed rejection cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    -- Missing Upgrade and Connection plus an unsent declared body must not
    -- make rejection wait in the ordinary HTTP body's automatic drain.
    connection:write("GET /upgrade HTTP/1.1\r\nHost: example.test\r\n" ..
                     "Content-Length: 1000000\r\n\r\n")
    local preamble = connection:read_until("\r\n\r\n", false)
    test.assert(support.contains(preamble, "HTTP/1.1 400 Bad Request\r\n"))
    test.assert(support.contains(preamble, "X-Rejection: checked\r\n"))
    test.assert(support.contains(preamble, "Content-Length: 0\r\n"))
    test.assert(connection:read() == nil and completed,
                "bodyless rejection retained the HTTP exchange")
  end)
end

function test_upgrade_requires_live_pair_and_unsent_output(_: test.Context)
  runtime_test.run(function ()
    local previous: http.Request? = nil
    local checks = 0
    local server, port = support.http_listen(59000,
      function (request: http.Request, response: http.Response)
        if request.target == "/first" then
          previous = request
          response:set_header("Content-Length", "0")
        elseif request.target == "/wrong-pair" then
          assert_http_error(function () response:upgrade(previous, "echo") end,
                            "same live request and response")
          assert_http_error(function () response:reject_upgrade(previous, 400) end,
                            "same live request and response")
          checks = checks + 1
          response:reject_upgrade(request, 400)
        else
          response:set_header("Content-Length", "0")
          response:send_headers()
          assert_http_error(function () response:upgrade(request, "echo") end,
                            "unsent response")
          assert_http_error(function () response:reject_upgrade(request, 400) end,
                            "unsent response")
          checks = checks + 1
        end
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP live exchange cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    connection:write("GET /first HTTP/1.1\r\nHost: example.test\r\n\r\n")
    local first = connection:read_until("\r\n\r\n", false)
    test.assert(support.contains(first, "HTTP/1.1 200 OK\r\n"))
    connection:write("GET /wrong-pair HTTP/1.1\r\nHost: example.test\r\n" ..
                     "Connection: Upgrade\r\nUpgrade: echo\r\n\r\n")
    local rejected = connection:read_until("\r\n\r\n", false)
    test.assert(support.contains(rejected, "HTTP/1.1 400 Bad Request\r\n"))
    test.assert(connection:read() == nil and checks == 1)
    local sent = net.connect("127.0.0.1", port)
    defer sent:close()
    sent:write("GET /prior-output HTTP/1.1\r\nHost: example.test\r\n" ..
               "Connection: Upgrade\r\nUpgrade: echo\r\n\r\n")
    local ordinary = sent:read_until("\r\n\r\n", false)
    test.assert(support.contains(ordinary, "HTTP/1.1 200 OK\r\n"))
    test.assert(sent:read() == nil and checks == 2)
  end)
end

function test_ordinary_http_client_rejects_101(_: test.Context)
  runtime_test.run(function ()
    local server, port = support.raw_listen(59100)
    defer server:close()
    local peer = async.run<|nil, value|>(function (): nil
      local connection = server:accept()
      defer connection:close()
      connection:read_until("\r\n\r\n", false)
      connection:write(UPGRADE_RESPONSE .. "\0opaque")
      return nil
    end)
    defer task_support.cancel_and_join_task(peer, "HTTP ordinary client cleanup")
    assert_http_error(function ()
      http.get("http://127.0.0.1:" .. port .. "/")
    end, "upgrades")
    test.assert(async.join(peer):has_succeeded(), "ordinary HTTP rejection peer failed")
  end)
end

local function reject_upgrade_expectation(port_start: integer, opening: string)
  runtime_test.run(function ()
    local called = false
    local server, port = support.http_listen(port_start,
      function (_request: http.Request, _response: http.Response)
        called = true
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP upgrade expectation cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    connection:write("GET /upgrade HTTP/1.1\r\nHost: example.test\r\n" ..
      opening .. "Content-Length: 1\r\nExpect: 100-continue\r\n\r\n")
    local preamble = connection:read_until("\r\n\r\n", false)
    test.assert(preamble == "HTTP/1.1 400 Bad Request\r\n" ..
      "Content-Length: 0\r\nConnection: close\r\n\r\n")
    test.assert(not support.contains(preamble, "100 Continue") and not called)
    test.assert(connection:read() == nil)
  end)
end

local function reject_upgrade_semantics(port_start: integer, version: string,
                                         host_fields: string)
  runtime_test.run(function ()
    local called = false
    local server, port = support.http_listen(port_start,
      function (_request: http.Request, _response: http.Response)
        called = true
      end)
    defer server:close()
    server:idle_timeout(2000)
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP malformed upgrade cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    -- Withhold the declared body: rejection must happen at the complete
    -- header boundary without an interim response or any body drain.
    connection:write("GET /upgrade " .. version .. "\r\n" .. host_fields ..
      "Connection: Upgrade\r\nUpgrade: websocket\r\nContent-Length: 1\r\n\r\n")
    local preamble = connection:read_until("\r\n\r\n", false)
    test.assert(preamble == "HTTP/1.1 400 Bad Request\r\n" ..
      "Content-Length: 0\r\nConnection: close\r\n\r\n",
      "malformed complete upgrade did not receive one bodyless 400")
    test.assert(connection:read() == nil and not called,
      "malformed upgrade reached a handler or waited for its body")
  end)
end

function test_upgrade_rejects_complete_header_semantics_before_handler(context: test.Context)
  context:run("missing_host", function (_: test.Context)
    reject_upgrade_semantics(59700, "HTTP/1.1", "")
  end)
  context:run("duplicate_host", function (_: test.Context)
    reject_upgrade_semantics(59800, "HTTP/1.1",
      "Host: example.test\r\nHost: example.test\r\n")
  end)
  context:run("invalid_host_authority", function (_: test.Context)
    reject_upgrade_semantics(59900, "HTTP/1.1", "Host: example.test:oops\r\n")
  end)
  context:run("http_1_0", function (_: test.Context)
    reject_upgrade_semantics(60000, "HTTP/1.0", "Host: example.test\r\n")
  end)
end

function test_upgrade_expectation_rejects_before_interim_output(context: test.Context)
  context:run("complete_offer", function (_: test.Context)
    reject_upgrade_expectation(59200, "Connection: Upgrade\r\nUpgrade: echo\r\n")
  end)
  context:run("missing_connection", function (_: test.Context)
    reject_upgrade_expectation(59300, "Upgrade: echo\r\n")
  end)
  context:run("missing_upgrade", function (_: test.Context)
    reject_upgrade_expectation(59400, "Connection: Upgrade\r\n")
  end)
end

function test_response_abort_skips_output_and_unread_body_drain(_: test.Context)
  runtime_test.run(function ()
    local finished, wait_finished, close_finished = async.channel<|boolean|>(1)
    defer close_finished()
    local server, port = support.http_listen(59800,
      function (request: http.Request, response: http.Response)
        response:abort()
        response:abort()
        response:close()
        assert_http_error(function () request:read() end, "exchange has ended")
        assert_http_error(function () response:write("late") end, "exchange has ended")
        finished(true)
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP response abort cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    connection:write("POST /abort HTTP/1.1\r\nHost: example.test\r\n" ..
                     "Content-Length: 100\r\n\r\n")
    test.assert(connection:read() == nil, "abort sent output or waited for an unread body")
    test.assert(wait_finished(), "abort did not retire the exchange")
  end)
end

function test_response_abort_truncates_stream_and_preserves_later_exchange(_: test.Context)
  runtime_test.run(function ()
    local previous: http.Response? = nil
    local server, port = support.http_listen(59900,
      function (request: http.Request, response: http.Response)
        if request.target == "/first" then
          previous = response
          response:set_header("Content-Length", "0")
        else
          previous:abort() -- A completed response cannot close this exchange.
          if request.target == "/length" then response:set_header("Content-Length", "20") end
          response:write("partial")
          response:abort()
        end
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP response stream abort cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    connection:write("GET /first HTTP/1.1\r\nHost: example.test\r\n\r\n")
    test.assert(support.contains(connection:read_until("\r\n\r\n", false), "Content-Length: 0\r\n"))
    connection:write("GET /stream HTTP/1.1\r\nHost: example.test\r\n\r\n")
    local output = string.writer()
    for chunk in connection:read do output:write(chunk) end
    local bytes = output:drain()
    test.assert(support.contains(bytes, "HTTP/1.1 200 OK\r\n"), "stale response closed the later exchange")
    test.assert(support.contains(bytes, "\r\n7\r\npartial\r\n"), "abort lost committed output")
    test.assert(not support.contains(bytes, "\r\n0\r\n\r\n"), "abort finished a truncated stream")
    previous:abort() -- Retained responses stay harmless after transport retirement.
    local short = net.connect("127.0.0.1", port)
    defer short:close()
    short:write("GET /length HTTP/1.1\r\nHost: example.test\r\n\r\n")
    local short_output = string.writer()
    for chunk in short:read do short_output:write(chunk) end
    test.assert(support.contains(short_output:drain(), "Content-Length: 20\r\n"),
                "abort retried a short fixed-length response")
  end)
end

local function response_abort_pending_body(encrypted: boolean)
  runtime_test.run(function ()
    local publish, receive, close = async.channel<|http.Response|>(1)
    defer close()
    local finished, wait_finished, close_finished = async.channel<|boolean|>(1)
    defer close_finished()
    local handler: http.Handler = function (request: http.Request, response: http.Response)
        publish(response)
        local failed = false
        do request:read()
        catch failed = true
        end
        finished(failed)
      end
    local listen = function (): (http.Server, integer)
      if encrypted then return support.https_listen(60200, handler, 0) end
      return support.http_listen(60000, handler)
    end
    local server, port = listen()
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP pending body abort cleanup")
    local connect = function (): io.ReaderWriterCloser
      if encrypted then return ssl.connect("127.0.0.1", port, support.TRUST_ROOT) end
      return net.connect("127.0.0.1", port)
    end
    local connection = connect()
    defer connection:close()
    connection:write("POST /blocked HTTP/1.1\r\nHost: example.test\r\n" ..
                     "Content-Length: 100\r\n\r\n")
    local response = receive()
    local reason = async.CancellationReason.simple("cancelled abort owner")
    local aborting = async.run<|nil, value|>(function (): nil
      async.running():cancel(reason)
      response:abort()
      return nil
    end)
    defer task_support.cancel_and_join_task(aborting, "HTTP cancelled abort cleanup")
    test.assert(async.join(aborting):has_cancelled(), "abort cleared owner cancellation")
    test.assert(wait_finished(), "pending body read did not fail on abort")
    if encrypted then
      local observed = "no error"
      do connection:read()
      catch
        if error is ssl.Error then observed = (error as ssl.Error).name else raise end
      end
      test.assert(observed == "TLS_TRUNCATED_EOF", "HTTP abort performed graceful TLS close: " .. observed)
    else
      test.assert(connection:read() == nil, "cancelled abort did not retire the accepted transport")
    end
  end)
end

function test_response_abort_retires_pending_body_read_despite_cancellation(_: test.Context)
  response_abort_pending_body(false)
end

function test_response_abort_retires_pending_tls_body_read_despite_cancellation(_: test.Context)
  response_abort_pending_body(true)
end

function test_response_pending_headers_are_immutable_and_abortable(_: test.Context)
  runtime_test.run(function ()
    local publish, receive, close = async.channel<|http.Response|>(1)
    defer close()
    local finished, wait_finished, close_finished = async.channel<|boolean|>(1)
    defer close_finished()
    local owner: async.Task? = nil
    local release: (function (nil): ())? = nil
    local server, port = support.http_listen(60100,
      function (_request: http.Request, response: http.Response)
        owner = async.running()
        publish(response)
        async.await<|nil, nil|>(function (resolve, _reject, _fatal) release = resolve end)
        do response:send_headers()
        catch
          -- The test owner interrupts this pending output deliberately.
        end
        finished(true)
      end)
    defer server:close()
    local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
    defer task_support.cancel_and_join_task(serving, "HTTP header abort cleanup")
    local connection = net.connect("127.0.0.1", port)
    defer connection:close()
    connection:write("GET /blocked HTTP/1.1\r\nHost: example.test\r\n\r\n")
    local response = receive()
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local start = release
      release = nil
      start(nil) -- Reach native header submission before any UV callback runs.
      test.assert(owner:status():as_string() == "waiting", "header writer did not suspend before mutation checks")
      assert_http_error(function () response:set_status(500) end, "already been sent")
      assert_http_error(function () response:add_header("X-Late", "yes") end, "already been sent")
      assert_http_error(function () response:set_header("X-Late", "yes") end, "already been sent")
      resolve(nil)
    end)
    response:abort()
    test.assert(wait_finished(), "abort did not release the pending header writer")
  end)
end
