local function task_diagnostic_count(output: string): integer
  local diagnostics, offset = 0, 1
  while true do
    local found? = string.find(output, "uncaught error in async Task", offset)
    if found == nil then return diagnostics end
    diagnostics = diagnostics + 1
    offset = found + 1
  end
end

local function compile_disconnect_fixture(context: test.Context, program: string): string
  local workspace = ""
  runtime_test.run(function ()
    workspace = fs.tmpname()
    fs.unlink(workspace)
    fs.mkdir(workspace)
    context:cleanup(function () command.remove_tree(workspace) end)
    fs.write_file(workspace .. "/" .. program .. ".titan",
      fs.read_file("spec/fixtures/stdlib/titan/" .. program .. ".titan"))
    local output, why, compiled = command.compile(workspace, program)
    test.assert(why == "exit" and compiled == 0, "could not compile HTTP disconnect fixture:\n" .. output)
  end)
  return workspace
end

local function add_tls_disconnect_case(context: test.Context, workspace: string,
                                       mode: string, timed: boolean)
  local deadline = "disabled"
  if timed then deadline = "enabled" end
  context:run(mode .. "_timeout_" .. deadline, function (_: test.Context)
    runtime_test.run(function ()
      local output, why, status = command.capture({
        command.program(workspace, "http_tls_idle_app"), mode, deadline,
      })
      test.assert(why == "exit" and status == 0, "HTTPS disconnect fixture failed:\n" .. output)
      test.assert(string.find(output, "HTTPS DISCONNECT OK") ~= nil and
                  string.find(output, "LISTENER succeeded") ~= nil, "HTTPS fixture did not complete:\n" .. output)
      local diagnostics = task_diagnostic_count(output)
      if mode == "partial" or mode == "body" then
        test.assert(diagnostics == 1, "incomplete HTTPS request lost or duplicated its diagnostic:\n" .. output)
      else
        test.assert(diagnostics == 0, "idle HTTPS disconnect failed a server-owned Task:\n" .. output)
        test.assert(string.find(output, "CONNECTION succeeded") ~= nil,
                    "idle HTTPS connection Task did not succeed:\n" .. output)
      end
    end)
  end)
end

function test_https_idle_tls_disconnect_boundary(context: test.Context)
  local workspace = compile_disconnect_fixture(context, "http_tls_idle_app")
  add_tls_disconnect_case(context, workspace, "idle", false)
  add_tls_disconnect_case(context, workspace, "idle", true)
  add_tls_disconnect_case(context, workspace, "clean", false)
  add_tls_disconnect_case(context, workspace, "clean", true)
  add_tls_disconnect_case(context, workspace, "partial", false)
  add_tls_disconnect_case(context, workspace, "partial", true)
  add_tls_disconnect_case(context, workspace, "body", false)
  add_tls_disconnect_case(context, workspace, "body", true)
end

local function add_tcp_reset_case(context: test.Context, workspace: string,
                                  mode: string, timed: boolean)
  local deadline = "disabled"
  if timed then deadline = "enabled" end
  context:run(mode .. "_timeout_" .. deadline, function (_: test.Context)
    runtime_test.run(function ()
      local output, why, status = command.capture({
        command.program(workspace, "http_tcp_idle_app"), mode, deadline,
      })
      test.assert(why == "exit" and status == 0, "HTTP reset fixture failed:\n" .. output)
      test.assert(string.find(output, "HTTP RESET OK") ~= nil and
                  string.find(output, "LISTENER succeeded") ~= nil, "HTTP reset fixture did not complete:\n" .. output)
      local diagnostics = task_diagnostic_count(output)
      if mode == "partial" then
        test.assert(diagnostics == 1 and string.find(output, "net.read: ECONNRESET (") ~= nil,
          "partial HTTP reset lost or changed its transport error:\n" .. output)
      else
        test.assert(diagnostics == 0, "idle HTTP reset failed a server-owned Task:\n" .. output)
        test.assert(string.find(output, "CONNECTION succeeded") ~= nil,
          "idle HTTP reset connection Task did not succeed:\n" .. output)
      end
    end)
  end)
end

function test_http_idle_tcp_reset_boundary(context: test.Context)
  local workspace = compile_disconnect_fixture(context, "http_tcp_idle_app")
  add_tcp_reset_case(context, workspace, "idle", false)
  add_tcp_reset_case(context, workspace, "idle", true)
  add_tcp_reset_case(context, workspace, "partial", false)
  add_tcp_reset_case(context, workspace, "partial", true)
end
