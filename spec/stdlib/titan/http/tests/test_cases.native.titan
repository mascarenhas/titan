function test_server_idle_timeout_api_validation_and_updates(
    context: test.Context)
  runtime_test.run(function ()
    const missing_pem_path = support.absent_temporary_path(context)
    const start: CaseStart = function (first_port: integer): async.Task
      return start_idle_timeout_api(first_port, missing_pem_path)
    end
    run_case(context, start, 21000, "idle-timeout-api-ok")
  end)
end

