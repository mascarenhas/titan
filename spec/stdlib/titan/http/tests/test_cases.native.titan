-- Each legacy case used a fresh child process. The native runner keeps the
-- same complete Task boundary, deterministic port seed, EADDRINUSE retry, and
-- public status/support.outcome oracle while executing the protocols in one Runtime.
-- HTTP fixture listeners use 15000..25299, below default client ephemeral ports.
local type CaseStart = function (integer): (async.Task)

local function run_case(_: test.Context, start: CaseStart,
                        first_port: integer, expected: string)
  const task = start(first_port)
  runtime_test.cleanup(function ()
    task_support.cancel_and_join_task(task, "HTTP test cleanup")
  end)
  const status = async.join(task)
  test.assert(status:has_succeeded(),
        "HTTP case Task ended " .. status:as_string() ..
        " with support.outcome " .. support.result())
  test.assert(support.result() == expected,
        "HTTP case support.outcome was " .. support.result() .. ", expected " .. expected)
end

function test_client_parses_fragmented_chunked_response(
    context: test.Context)
  runtime_test.run(function ()
    run_case(context, start_client, 15000, "client-ok")
  end)
end

