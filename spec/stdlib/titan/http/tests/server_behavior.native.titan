local function start_server_streaming(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handler_started = false
    local server_value: http.Server? = nil
    local handler: http.Handler = function (request: http.Request,
                                            response: http.Response)
      handler_started = true
      test.assert(request.method == "POST" and request.url.path == "/upload",
            "HTTP server parsed the wrong request line")
      test.assert(request.url.query == "part=1",
            "HTTP server parsed the wrong query")
      test.assert(request.headers:get("X-Test") == "one",
            "HTTP server parsed the wrong header")
      test.assert(request:read_until("END", true) == "body\0",
            "HTTP Request Reader did not decode the body")
      local tail: string? = request:read()
      test.assert(tail == nil, "HTTP Request Reader did not end")

      local header_control_rejected = false
      do
        response:add_header("X-Bad", "control" .. string.char(1))
      catch
        header_control_rejected = true
      end
      test.assert(header_control_rejected,
            "HTTP response admitted a forbidden field-value control")

      local reason_control_rejected = false
      do
        response:set_status(200, "bad" .. string.char(127))
      catch
        reason_control_rejected = true
      end
      test.assert(reason_control_rejected,
            "HTTP response admitted DEL in the reason phrase")

      response:set_status(201, nil)
      response:add_header("X-Reply", "yes")
      response:write("first")
      response:write("second")
      do (server_value as http.Server):close() end
    end
    local server, port = support.http_listen(first_port, handler)
    defer server:close()
    server_value = server
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    local client = net.connect("127.0.0.1", port)
    defer client:close()
    client:write(
      "POST /upload?part=1 HTTP/1.1\r\n" ..
      "Host: 127.0.0.1\r\n" ..
      "X-Test: one\r\n" ..
      "Content-Length: 8\r\n" ..
      "Connection: close\r\n\r\n")
    local turns = 0
    while not handler_started and turns < 100 do
      timer.yield()
      turns = turns + 1
    end
    test.assert(handler_started,
          "HTTP handler did not start after headers were complete")
    client:write("body\0END")
    local response = client:read_until("\r\n\r\n", true)
    if not response then raise "HTTP server sent no response" end
    local response_text = response as string
    test.assert(support.contains(response_text, "HTTP/1.1 201 Created\r\n") and
          support.contains(response_text, "Transfer-Encoding: chunked\r\n"),
          "HTTP server sent the wrong response headers")
    local body = string.writer()
    for chunk in client:read do body:write(chunk) end
    test.assert(body:drain() ==
          "5\r\nfirst\r\n6\r\nsecond\r\n0\r\n\r\n",
          "HTTP server sent the wrong chunked body")
    client:close()
    while task_support.active(serving) do timer.yield() end
    test.assert(serving:status():has_succeeded(), "HTTP serve Task failed")
    support.outcome = "server-streaming-ok"
    return nil
  end)
end

local function start_expect_continue(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handled = 0
    local handler: http.Handler = function (request: http.Request,
                                            response: http.Response)
      handled = handled + 1
      test.assert(request.target == "/continue",
            "HTTP Expect request reached the wrong handler path")
      local body = string.writer()
      for chunk in request:read do body:write(chunk) end
      test.assert(body:drain() == "body",
            "HTTP Expect request body was not delivered after 100 Continue")
      response:set_header("Content-Length", "2")
      response:write("ok")
    end

    local server, port = support.http_listen(first_port, handler)
    defer server:close()
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    local current: net.Connection? = nil
    defer do
      if current ~= nil then
        do (current as net.Connection):close() catch end
      end
    end
    local timed_out = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      support.outcome = "expect-timeout-after-" .. support.outcome
      if current then
        do (current as net.Connection):close() catch end
      end
      do server:close() catch end
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")

    support.outcome = "expect-waiting-for-continue"
    local client = net.connect("127.0.0.1", port)
    defer client:close()
    current = client
    client:write(
      "POST /continue HTTP/1.1\r\n" ..
      "Host: 127.0.0.1\r\n" ..
      "Content-Length: 4\r\n" ..
      "Expect: 100-CoNtInUe\r\n" ..
      "Connection: close\r\n\r\n")
    -- Deliberately withhold the body until the server acknowledges it. This
    -- would deadlock if the handler entered Request:read before the interim
    -- response was written.
    local interim? = client:read_until("\r\n\r\n", false)
    if not interim then raise "HTTP server sent no interim response" end
    test.assert((interim as string) == "HTTP/1.1 100 Continue\r\n\r\n",
          "HTTP server did not acknowledge 100-continue before the body")
    support.outcome = "expect-sending-body"
    client:write("body")
    local final = string.writer()
    for chunk in client:read do final:write(chunk) end
    local final_text = final:drain()
    test.assert(support.contains(final_text, "HTTP/1.1 200 OK\r\n") and
          support.contains(final_text, "Content-Length: 2\r\n") and
          string.sub(final_text, #final_text - 1) == "ok",
          "HTTP server did not complete the continued request")
    client:close()
    current = nil

    local rejected = {
      "Expect: unsupported\r\n",
      "Expect: 100-continue, 100-continue\r\n",
      "Expect: 100-continue\r\nExpect: 100-continue\r\n",
    }
    for index = 1, #rejected do
      support.outcome = "expect-rejecting-" .. string.tostring(index)
      local rejected_client = net.connect("127.0.0.1", port)
      defer rejected_client:close()
      current = rejected_client
      rejected_client:write(
        "POST /never HTTP/1.1\r\n" ..
        "Host: 127.0.0.1\r\n" ..
        "Content-Length: 4\r\n" .. rejected[index] .. "\r\n")
      -- No body follows. A final 417 must arrive and close the connection
      -- without entering the handler or trying to drain the declared body.
      local refusal = string.writer()
      for chunk in rejected_client:read do refusal:write(chunk) end
      test.assert(refusal:drain() ==
              "HTTP/1.1 417 Expectation Failed\r\n" ..
              "Content-Length: 0\r\nConnection: close\r\n\r\n",
            "HTTP server did not reject an unsupported expectation")
      rejected_client:close()
      current = nil
    end

    test.assert(handled == 1,
          "HTTP server dispatched a rejected expectation to the handler")
    watchdog:cancel(async.CancellationReason.simple(
      "Expect matrix completed"))
    async.join(watchdog)
    test.assert(not timed_out, "HTTP Expect matrix timed out")
    server:close()
    while task_support.active(serving) do timer.yield() end
    test.assert(serving:status():has_succeeded(), "HTTP Expect serve Task failed")
    support.outcome = "expect-ok"
    return nil
  end)
end

local function start_buffered_next_requests(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handled = 0
    local handler: http.Handler = function (_: http.Request,
                                            response: http.Response)
      handled = handled + 1
      support.outcome = "buffered-handler-" .. string.tostring(handled)
      response:set_header("Content-Length", "1")
      response:write(string.tostring(handled))
    end
    local server, port = support.http_listen(first_port, handler)
    defer server:close()
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    local client = net.connect("127.0.0.1", port)
    defer client:close()
    local watchdog_fired = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      watchdog_fired = true
      support.outcome = "buffered-timeout-after-" .. support.outcome
      client:close()
      server:close()
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")
    client:write(
      "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n" ..
      "GET /two HTTP/1.1\r\nHost: localhost\r\n" ..
      "Connection: close\r\n\r\n")
    support.outcome = "buffered-reading"
    local all = string.writer()
    for chunk in client:read do all:write(chunk) end
    server:close()
    watchdog:cancel(async.CancellationReason.simple(
      "buffered requests completed"))
    async.join(watchdog)
    test.assert(not watchdog_fired,
          "buffered HTTP requests required the watchdog: " .. support.outcome)
    local responses = all:drain()
    local first: integer? = string.find(responses, "HTTP/1.1 200 OK")
    local second: integer? = nil
    if first then
      second = string.find(responses, "HTTP/1.1 200 OK",
                        (first as integer) + 1)
    end
    test.assert(first ~= nil and second ~= nil and handled == 2,
          "HTTP server lost a buffered next-request suffix")
    test.assert(support.contains(responses, "Content-Length: 1\r\n\r\n1") and
          support.contains(responses,
                   "Content-Length: 1\r\nConnection: close\r\n\r\n2"),
          "serial HTTP responses were not ordered or framed")
    client:close()
    while task_support.active(serving) do timer.yield() end
    test.assert(serving:status():has_succeeded(),
          "buffered-request HTTP serve Task failed")
    support.outcome = "buffered-suffix-ok"
    return nil
  end)
end


local function start_unread_request_drain(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handled = 0
    local targets: {string} = {}
    local handler: http.Handler = function (request: http.Request,
                                            response: http.Response)
      handled = handled + 1
      targets[handled] = request.target
      -- The first two bodies are intentionally unread. The connection Task
      -- must drain both fixed and chunked framing before advancing to the
      -- already-buffered next-request suffix.
      response:set_header("Content-Length", "1")
      response:write(string.char(64 + handled))
    end
    local server, port = support.http_listen(first_port, handler)
    defer server:close()
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    local client = net.connect("127.0.0.1", port)
    defer client:close()
    local timed_out = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      support.outcome = "request-drain-timeout-after-" .. support.outcome
      do client:close() catch end
      do server:close() catch end
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")
    client:write(
      "POST /fixed HTTP/1.1\r\nHost: localhost\r\n" ..
      "Content-Length: 4\r\n\r\nskip" ..
      "POST /chunked HTTP/1.1\r\nHost: localhost\r\n" ..
      "Transfer-Encoding: chunked\r\n\r\n" ..
      "3\r\nabc\r\n2\r\nde\r\n0\r\nX-Trailer: done\r\n\r\n" ..
      "GET /last HTTP/1.1\r\nHost: localhost\r\n" ..
      "Connection: close\r\n\r\n")
    support.outcome = "request-drain-reading"
    local all = string.writer()
    for chunk in client:read do all:write(chunk) end
    client:close()
    server:close()
    watchdog:cancel(async.CancellationReason.simple(
      "request drain completed"))
    async.join(watchdog)
    test.assert(not timed_out, "HTTP unread-body drain matrix timed out")
    test.assert(handled == 3 and targets[1] == "/fixed" and
          targets[2] == "/chunked" and targets[3] == "/last",
          "HTTP server lost ordering while draining unread bodies")
    local responses = all:drain()
    test.assert(support.contains(responses, "Content-Length: 1\r\n\r\nA") and
          support.contains(responses, "Content-Length: 1\r\n\r\nB") and
          support.contains(responses,
                   "Content-Length: 1\r\nConnection: close\r\n\r\nC"),
          "HTTP server framed unread-body responses incorrectly")
    while task_support.active(serving) do timer.yield() end
    test.assert(serving:status():has_succeeded(),
          "unread-body HTTP serve Task failed")
    support.outcome = "request-drain-ok"
    return nil
  end)
end

local function start_server_failure_isolation(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handled = 0
    local reset_body_rejected = false
    local handler: http.Handler = function (request: http.Request,
                                            response: http.Response)
      handled = handled + 1
      if request.target == "/bad-204" then
        response:set_status(204, nil)
        response:set_header("Content-Length", "1")
        -- This error deliberately escapes the connection Task. No response
        -- bytes may be committed, and the accept loop must remain live.
        response:send_headers()
      elseif request.target == "/fail" then
        raise "intentional HTTP handler failure"
      elseif request.target == "/reset" then
        response:set_status(205, nil)
        do
          response:write("forbidden")
        catch
          reset_body_rejected = true
        end
      else
        raise "unexpected HTTP failure-isolation target"
      end
    end

    local server, port = support.http_listen(first_port, handler)
    defer server:close()
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    local current: net.Connection? = nil
    defer do
      if current ~= nil then
        do (current as net.Connection):close() catch end
      end
    end
    local timed_out = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      support.outcome = "server-failure-timeout-after-" .. support.outcome
      if current then
        do (current as net.Connection):close() catch end
      end
      do server:close() catch end
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")

    local exchange: function (string): (string) = function (
        request_text: string): string
      local connection = net.connect("127.0.0.1", port)
      defer connection:close()
      current = connection
      connection:write(request_text)
      local received = string.writer()
      for chunk in connection:read do received:write(chunk) end
      connection:close()
      current = nil
      return received:drain()
    end

    local authority = "127.0.0.1:" .. string.tostring(port)
    support.outcome = "server-rejecting-204-length"
    local bad_204 = exchange(
      "GET /bad-204 HTTP/1.1\r\nHost: " .. authority .. "\r\n" ..
      "Connection: close\r\n\r\n")
    test.assert(#bad_204 == 0 and handled == 1,
          "HTTP 204 response admitted Content-Length")

    local non_origin_lines = {
      "OPTIONS * HTTP/1.1\r\n",
      "GET http://other.example/path HTTP/1.1\r\n",
      "GET example.com:443 HTTP/1.1\r\n",
      "CONNECT example.com:443 HTTP/1.1\r\n",
    }
    for index = 1, #non_origin_lines do
      support.outcome = "server-rejecting-non-origin-target-" ..
        string.tostring(index)
      local non_origin = exchange(
        non_origin_lines[index] .. "Host: " .. authority .. "\r\n" ..
        "Connection: close\r\n\r\n")
      test.assert(#non_origin == 0 and handled == 1,
            "HTTP server admitted a non-origin-form request target")
    end

    -- These delimiters would reinterpret the separately received origin-form
    -- target if Host were accepted merely as a prefix of a combined URL.
    local malicious_hosts = {
      "localhost/path", "localhost?query", "localhost#fragment",
      "user@localhost",
    }
    for index = 1, #malicious_hosts do
      support.outcome = "server-rejecting-host-" .. string.tostring(index)
      local rejected = exchange(
        "GET /never HTTP/1.1\r\nHost: " .. malicious_hosts[index] ..
        "\r\nConnection: close\r\n\r\n")
      test.assert(#rejected == 0 and handled == 1,
            "HTTP server admitted a non-authority Host delimiter")
    end

    support.outcome = "server-isolating-handler-failure"
    local failed = exchange(
      "GET /fail HTTP/1.1\r\nHost: " .. authority .. "\r\n" ..
      "Connection: close\r\n\r\n")
    test.assert(#failed == 0 and handled == 2,
          "HTTP handler failure did not close only its connection")

    support.outcome = "server-returning-205"
    local reset = exchange(
      "GET /reset HTTP/1.1\r\nHost: " .. authority .. "\r\n" ..
      "Connection: close\r\n\r\n")
    test.assert(handled == 3 and reset_body_rejected,
          "HTTP 205 response admitted a body")
    test.assert(support.contains(reset, "HTTP/1.1 205 ") and
          support.contains(reset, "\r\nContent-Length: 0\r\n") and
          not support.contains(reset, "\r\nTransfer-Encoding:"),
          "HTTP 205 response did not use zero-length framing")
    local header_end? = string.find(reset, "\r\n\r\n")
    test.assert(header_end ~= nil and
          string.sub(reset, (header_end as integer) + 4) == "",
          "HTTP 205 response emitted body bytes")

    server:close()
    watchdog:cancel(async.CancellationReason.simple(
      "server failure matrix completed"))
    async.join(watchdog)
    test.assert(not timed_out, "HTTP server failure matrix timed out")
    while task_support.active(serving) do timer.yield() end
    test.assert(serving:status():has_succeeded(),
          "HTTP listener failed with a connection Task")
    support.outcome = "server-failures-ok"
    return nil
  end)
end

local function start_cancelled_server_close(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handler: http.Handler = function (_request: http.Request,
                                            _response: http.Response)
      raise "cancelled-close server unexpectedly accepted a request"
    end
    local server, _ = support.http_listen(first_port, handler)
    defer server:close()
    local serving = async.run<|value, value|>(function (): value
      server:serve()
      return nil
    end)
    defer task_support.cancel_and_join_task(serving, "nested HTTP serving cleanup")
    while serving:status():as_string() == "ready" do timer.yield() end
    test.assert(serving:status():as_string() == "waiting",
          "HTTP serve Task did not suspend in accept")

    local closer: async.Task? = nil
    local close_returned = false
    closer = async.run<|value, value|>(function (): value
      (closer as async.Task):cancel(async.CancellationReason.simple(
        "cancel before HTTP listener transport close"))
      server:close()
      close_returned = true
      return nil
    end)
    defer task_support.cancel_and_join_task(
      closer as async.Task, "nested HTTP closer cleanup")
    local close_task = closer as async.Task
    while task_support.active(close_task) do timer.yield() end
    test.assert(close_task:status():has_cancelled() and close_returned,
          "Task cancellation interrupted HTTP Server close")

    local timed_out = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      serving:cancel(async.CancellationReason.simple(
        "cancelled HTTP Server close timed out"))
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")
    while task_support.active(serving) do timer.yield() end
    watchdog:cancel(async.CancellationReason.simple(
      "cancelled HTTP Server close completed"))
    async.join(watchdog)
    test.assert(not timed_out, "cancelled HTTP Server close left accept stranded")
    test.assert(serving:status():has_succeeded(),
          "cancelled HTTP Server close did not stop serve cleanly")
    server:close()
    support.outcome = "server-close-cancel-ok"
    return nil
  end)
end

local function start_cancelled_client_close(first_port: integer): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local server, port = support.raw_listen(first_port)
    defer server:close()
    local peer_connection: net.Connection? = nil
    defer do
      if peer_connection then
        do (peer_connection as net.Connection):close() catch end
      end
      do server:close() catch end
    end

    local peer_saw_eof = false
    local peer = async.run<|value, value|>(function (): value
      local connection = server:accept()
      defer connection:close()
      peer_connection = connection
      defer do
        peer_connection = nil
        connection:close()
        server:close()
      end
      local preamble? = connection:read_until("\r\n\r\n", false)
      if not preamble then raise "HTTP close peer saw no request" end
      connection:write(
        "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
      local trailing? = connection:read()
      test.assert(trailing == nil,
            "HTTP client wrote data after receiving its response")
      peer_saw_eof = true
      return nil
    end)
    defer task_support.cancel_and_join_task(peer, "nested HTTP peer cleanup")

    local response = http.get(
      "http://127.0.0.1:" .. string.tostring(port) .. "/close")
    defer response:close()
    local closer: async.Task? = nil
    local close_returned = false
    closer = async.run<|value, value|>(function (): value
      (closer as async.Task):cancel(async.CancellationReason.simple(
        "cancel before HTTP client transport close"))
      response:close()
      close_returned = true
      return nil
    end)
    defer task_support.cancel_and_join_task(
      closer as async.Task, "nested HTTP closer cleanup")
    local close_task = closer as async.Task
    while task_support.active(close_task) do timer.yield() end
    test.assert(close_task:status():has_cancelled() and close_returned,
          "Task cancellation interrupted HTTP response close")
    test.assert(response:read() == nil,
          "logically closed HTTP response remained readable")

    local timed_out = false
    local watchdog = async.run<|value, value|>(function (): value
      timer.sleep(5000)
      timed_out = true
      peer:cancel(async.CancellationReason.simple(
        "cancelled HTTP response close timed out"))
      return nil
    end)
    defer task_support.cancel_and_join_task(watchdog, "nested HTTP watchdog cleanup")
    while task_support.active(peer) do timer.yield() end
    watchdog:cancel(async.CancellationReason.simple(
      "cancelled HTTP response close completed"))
    async.join(watchdog)
    test.assert(not timed_out,
          "cancelled HTTP response close left its peer stranded")
    test.assert(peer:status():has_succeeded() and peer_saw_eof,
          "cancelled HTTP response close did not close its transport")
    response:close()
    support.outcome = "client-close-cancel-ok"
    return nil
  end)
end

local function start_idle_timeout_api(first_port: integer,
                                      missing_pem_path: string): async.Task
  support.outcome = "running"
  return async.run<|value, value|>(function (): value
    local handler: http.Handler = function (_request: http.Request,
                                            _response: http.Response)
    end

    -- A negative timeout wins over a listener error, proving that validation
    -- happens before the socket is opened.
    local occupied, occupied_port = support.raw_listen(first_port)
    defer occupied:close()
    local plain_rejected = false
    do
      local unexpected =
        http.listen("127.0.0.1", handler, occupied_port, nil, -1)
      defer unexpected:close()
      unexpected:close()
    catch
      plain_rejected =
        string.tostring(error) == "HTTP idle timeout must be non-negative"
    end
    occupied:close()
    test.assert(plain_rejected,
          "HTTP plain listener did not validate idle timeout first")

    -- TLS must likewise reject before attempting synchronous PEM input.
    local tls_rejected = false
    do
      local unexpected = http.listen_tls(
        "127.0.0.1", missing_pem_path, handler, nil, nil, nil, -1)
      defer unexpected:close()
      unexpected:close()
    catch
      tls_rejected =
        string.tostring(error) == "HTTP idle timeout must be non-negative"
    end
    test.assert(tls_rejected,
          "HTTPS listener read PEM input before timeout validation")

    local default_server, _ =
      support.http_listen(first_port + 101, handler, nil)
    defer default_server:close()
    test.assert(default_server:idle_timeout(nil) == 0,
          "HTTP Server default idle timeout was not zero")
    test.assert(default_server:idle_timeout(75) == 0 and
          default_server:idle_timeout(nil) == 75,
          "HTTP Server idle-timeout setter did not return the previous value")
    test.assert(default_server:idle_timeout(0) == 75 and
          default_server:idle_timeout(nil) == 0,
          "HTTP Server idle-timeout setter did not accept zero")
    local setter_rejected = false
    do
      default_server:idle_timeout(-2)
    catch
      setter_rejected =
        string.tostring(error) == "HTTP idle timeout must be non-negative"
    end
    test.assert(setter_rejected and default_server:idle_timeout(nil) == 0,
          "HTTP Server mutated its timeout after rejecting a value")
    default_server:close()

    local configured, _ =
      support.http_listen(first_port + 202, handler, 43)
    defer configured:close()
    test.assert(configured:idle_timeout(nil) == 43,
          "HTTP listener did not retain its configured idle timeout")
    configured:close()
    support.outcome = "idle-timeout-api-ok"
    return nil
  end)
end

-- One wire request; the server is expected to close after its response. A
-- server that keeps reading instead is reported after a bounded wait.
local function wire_response(port: integer, request_bytes: string): (string, boolean)
  local client = net.connect("127.0.0.1", port)
  defer client:close()
  local timed_out = false
  local watchdog = async.run<|nil, value|>(function (): nil
    timer.sleep(10000)
    timed_out = true
    client:close()
    return nil
  end)
  defer task_support.cancel_and_join_task(watchdog, "HTTP wire response watchdog")
  client:write(request_bytes)
  local output = string.writer()
  for chunk in client:read do output:write(chunk) end
  return output:drain(), timed_out
end

local function serve_in_background(server: http.Server, label: string): async.Task<|nil, value|>
  local serving = async.run<|nil, value|>(function (): nil server:serve(); return nil end)
  task_support.cleanup_task(serving, label)
  return serving
end

-- Serve each first exchange through a fresh adopted Exchange on this state.
local function adopting_handler(inner: http.Handler): http.Handler
  return function (request: http.Request, response: http.Response)
    async.yield()
    local packet = async.TransferValue.from_value(http.Exchange(request, response))
    local moved: http.Exchange = packet:to_value()
    moved:serve(inner)
  end
end

local function framing_body(): string
  return string.rep("0123456789", 7000)
end

-- A response first-write matrix. Each case records commitment before and
-- after its handler work and any raised framing error, then reports its path
-- as finished: the connection can end before the handler does.
local function framing_handler(notes: {string: string}, kept: {string: http.Response},
                               finished: function (string): ()): http.Handler
  return function (request: http.Request, response: http.Response)
    local path = request.url.path
    defer finished(path)
    kept[path] = response
    local before = response:is_committed()
    local failure = ""
    do
      if path == "/fixed" then
        response:set_header("Content-Length", "5")
        response:write("hello")
      elseif path == "/chunked" then
        response:write("hello")
      elseif path == "/fixed-large" then
        response:set_header("Content-Length", "70000")
        response:write(framing_body())
      elseif path == "/chunked-large" then
        response:write(framing_body())
      elseif path == "/empty-write" then
        response:write("")
      elseif path == "/send-headers" then
        response:set_header("Content-Length", "5")
        response:send_headers()
        if not response:is_committed() then raise "send_headers did not commit" end
        response:write("hello")
      elseif path == "/continue" then
        if response:is_committed() then raise "100 Continue committed the final response" end
        if request:read() ~= "ping" then raise "Expect body was not readable" end
        response:set_header("Content-Length", "2")
        response:write("ok")
      elseif path == "/head" then
        response:set_header("Content-Length", "5")
        response:write("")
      elseif path == "/204" then
        response:set_status(204)
      elseif path == "/205" then
        response:set_status(205)
      elseif path == "/304" then
        response:set_status(304)
      elseif path == "/overflow" then
        response:set_header("Content-Length", "3")
        response:write("hello")
      elseif path == "/mismatch" then
        response:set_header("Content-Length", "5")
        response:close()
      elseif path == "/failed-write" then
        owned_tcp.shutdown_write(request:local_address().port, request:peer_address().port)
        response:write("hello")
      end
    catch
      failure = string.tostring(error)
      if path == "/failed-write" then
        -- The failed write must not roll back the reserved commitment.
        do response:set_status(500)
        catch failure = failure .. ";" .. string.tostring(error) end
      end
      response:abort()
    end
    notes[path] = string.tostring(before) .. "|" .. string.tostring(response:is_committed()) ..
                  "|" .. failure
  end
end

local record FramingCase
  path: string
  request: string
  response: string
  note: string
end

local function framing_request(method: string, path: string): string
  return method .. " " .. path .. " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
end

local function framing_cases(): {FramingCase}
  local large = framing_body()
  local fixed_head = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\n"
  local chunked_head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
  return {
    FramingCase("/fixed", framing_request("GET", "/fixed"), fixed_head .. "hello",
                "false|true|"),
    FramingCase("/chunked", framing_request("GET", "/chunked"),
                chunked_head .. "5\r\nhello\r\n0\r\n\r\n", "false|true|"),
    FramingCase("/fixed-large", framing_request("GET", "/fixed-large"),
                "HTTP/1.1 200 OK\r\nContent-Length: 70000\r\nConnection: close\r\n\r\n" .. large,
                "false|true|"),
    FramingCase("/chunked-large", framing_request("GET", "/chunked-large"),
                chunked_head .. "11170\r\n" .. large .. "\r\n0\r\n\r\n", "false|true|"),
    FramingCase("/empty-write", framing_request("GET", "/empty-write"),
                chunked_head .. "0\r\n\r\n", "false|true|"),
    FramingCase("/send-headers", framing_request("GET", "/send-headers"),
                fixed_head .. "hello", "false|true|"),
    FramingCase("/continue",
                "POST /continue HTTP/1.1\r\nHost: localhost\r\nExpect: 100-continue\r\n" ..
                "Content-Length: 4\r\nConnection: close\r\n\r\nping",
                "HTTP/1.1 100 Continue\r\n\r\n" ..
                "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok",
                "false|true|"),
    FramingCase("/head", framing_request("HEAD", "/head"), fixed_head, "false|true|"),
    FramingCase("/204", framing_request("GET", "/204"),
                "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n", "false|false|"),
    FramingCase("/205", framing_request("GET", "/205"),
                "HTTP/1.1 205 Status\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
                "false|false|"),
    FramingCase("/304", framing_request("GET", "/304"),
                "HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\n", "false|false|"),
    FramingCase("/overflow", framing_request("GET", "/overflow"),
                "HTTP/1.1 200 OK\r\nContent-Length: 3\r\nConnection: close\r\n\r\n",
                "false|true|HTTP response exceeds its Content-Length"),
    FramingCase("/mismatch", framing_request("GET", "/mismatch"), fixed_head,
                "false|true|HTTP response body does not match its Content-Length"),
    FramingCase("/failed-write", framing_request("GET", "/failed-write"), "",
                "false|true|cannot write after Connection shutdown;" ..
                "HTTP response headers have already been sent"),
  }
end

-- Exact wire bytes and commitment for every first-write shape, with the
-- response committed before its transport write even when that write fails.
local function check_framing_matrix(adopt: boolean)
  local notes: {string: string} = {}
  local kept: {string: http.Response} = {}
  local finished, next_finished, close_finished = async.channel<|string|>(16)
  runtime_test.cleanup(close_finished)
  local handler = framing_handler(notes, kept, finished)
  if adopt then handler = adopting_handler(handler) end
  local server = http.listen("127.0.0.1", handler, 0)
  runtime_test.cleanup(function () server:close() end)
  server:read_ahead(false)
  local port = server:local_address().port
  serve_in_background(server, "HTTP framing matrix listener")
  local cases = framing_cases()
  for index = 1, #cases do
    local item = cases[index]
    local wire, timed_out = wire_response(port, item.request)
    test.assert(not timed_out, item.path .. " did not close its connection")
    test.assert(wire == item.response, item.path .. " sent " .. string.format("%q", wire))
    test.assert(next_finished() == item.path, item.path .. " handler finished out of order")
    test.assert(notes[item.path] == item.note, item.path .. " observed " ..
                string.tostring(notes[item.path]) .. ", expected " .. item.note)
    test.assert(kept[item.path]:is_committed(), item.path .. " lost its historical commitment")
  end
end

function test_server_coalesced_framing_and_commitment(_context: test.Context)
  runtime_test.run(function () check_framing_matrix(false) end)
end

-- A non-reusable exchange closes instead of reading an unread request body;
-- a persistent one still drains before the next pipelined request.
local function drain_handler(): http.Handler
  return function (request: http.Request, response: http.Response)
    local path = request.url.path
    if path == "/big-fixed" or path == "/big-chunked" then
      response:set_status(413)
      response:set_header("Connection", "close")
      response:set_header("Content-Length", "0")
    elseif path == "/client-close" then
      response:set_header("Content-Length", "2")
      response:write("ok")
    elseif path == "/unread" then
      response:set_header("Content-Length", "1")
      response:write("A")
    elseif path == "/after" then
      response:set_header("Content-Length", "1")
      response:write("B")
    end
  end
end

local function check_request_drain(adopt: boolean)
  local handler = drain_handler()
  if adopt then handler = adopting_handler(handler) end
  local server = http.listen("127.0.0.1", handler, 0)
  runtime_test.cleanup(function () server:close() end)
  server:read_ahead(false)
  local port = server:local_address().port
  serve_in_background(server, "HTTP request drain listener")
  -- Response framing re-sets Connection: close after the handler's headers.
  local rejected = "HTTP/1.1 413 Content Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
  local wire, timed_out = wire_response(port,
    "POST /big-fixed HTTP/1.1\r\nHost: localhost\r\nContent-Length: 104857600\r\n\r\n")
  test.assert(not timed_out and wire == rejected, "unread fixed-length body was drained")
  wire, timed_out = wire_response(port,
    "POST /big-chunked HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n")
  test.assert(not timed_out and wire == rejected, "unread chunked body was drained")
  wire, timed_out = wire_response(port,
    "POST /client-close HTTP/1.1\r\nHost: localhost\r\nContent-Length: 104857600\r\n" ..
    "Connection: close\r\n\r\n")
  test.assert(not timed_out and
              wire == "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok",
              "a client-closed exchange drained its unread body")
  local persistent = "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\nA" ..
                     "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nConnection: close\r\n\r\nB"
  local after = "GET /after HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
  wire, timed_out = wire_response(port,
    "POST /unread HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\n\r\nskip" .. after)
  test.assert(not timed_out and wire == persistent,
              "a persistent fixed-length exchange did not drain before the next request")
  wire, timed_out = wire_response(port,
    "POST /unread HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n" ..
    "4\r\nskip\r\n0\r\n\r\n" .. after)
  test.assert(not timed_out and wire == persistent,
              "a persistent chunked exchange did not drain before the next request")
end

function test_server_skips_drain_on_non_reusable_exchanges(_context: test.Context)
  runtime_test.run(function () check_request_drain(false) end)
end

-- Request endpoint queries reuse the connection's cached snapshots across
-- keep-alive exchanges and end with their exchange.
local function check_request_addresses(server: http.Server, addresses: {net.Address},
                                       kept: {http.Request}, ip: string, encrypted: boolean)
  runtime_test.cleanup(function () server:close() end)
  local bound = server:local_address()
  test.assert(bound.ip == ip and bound.port > 0, "HTTP listener reported " .. bound.ip)
  test.assert(server:local_address() == bound, "HTTP listener address was not cached")
  serve_in_background(server, "HTTP address listener")
  local channel: io.ReaderWriterCloser = (function (): io.ReaderWriterCloser
    if encrypted then return ssl.connect(ip, bound.port, support.TRUST_ROOT) end
    return net.connect(ip, bound.port)
  end)()
  runtime_test.cleanup(function () channel:close() end)
  channel:write("GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n" ..
                "GET /two HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
  local output = string.writer()
  for chunk in channel:read do output:write(chunk) end
  test.assert(support.contains(output:drain(), "\r\n\r\nok"), "HTTP address exchange failed")
  test.assert(#addresses == 4, "HTTP handler saw " .. #addresses .. " endpoint snapshots")
  test.assert(addresses[1] == addresses[3] and addresses[2] == addresses[4],
              "keep-alive exchanges did not reuse cached endpoint snapshots")
  test.assert(addresses[1].ip == ip and addresses[1].port == bound.port,
              "request local endpoint is not the listener")
  test.assert(addresses[2].ip == ip and addresses[2].port > 0 and
              addresses[2].port ~= bound.port, "request peer endpoint is not the client")
  transfer_common.assert_raises_contains(function () kept[1]:local_address() end,
    "HTTP request exchange has ended")
  transfer_common.assert_raises_contains(function () kept[1]:peer_address() end,
    "HTTP request exchange has ended")
  server:close()
  transfer_common.assert_raises_contains(function () server:local_address() end,
    "HTTP Server is closed")
end

local function address_handler(addresses: {net.Address}, kept: {http.Request}): http.Handler
  return function (request: http.Request, response: http.Response)
    addresses[#addresses + 1] = request:local_address()
    addresses[#addresses + 1] = request:peer_address()
    kept[1] = request
    response:set_header("Content-Length", "2")
    response:write("ok")
  end
end

function test_server_and_request_socket_addresses(context: test.Context)
  context:run("http_ipv4", function (_child: test.Context)
    runtime_test.run(function ()
      local addresses: {net.Address} = {}
      local kept: {http.Request} = {}
      local server = http.listen("127.0.0.1", address_handler(addresses, kept), 0)
      check_request_addresses(server, addresses, kept, "127.0.0.1", false)
    end)
  end)
  context:run("https_ipv4", function (_child: test.Context)
    runtime_test.run(function ()
      local addresses: {net.Address} = {}
      local kept: {http.Request} = {}
      local server = http.listen_tls("127.0.0.1", support.CERTIFICATE,
        address_handler(addresses, kept), support.PRIVATE_KEY, 0)
      check_request_addresses(server, addresses, kept, "127.0.0.1", true)
    end)
  end)
  context:run("http_ipv6", function (_child: test.Context)
    runtime_test.run(function ()
      local addresses: {net.Address} = {}
      local kept: {http.Request} = {}
      local server: http.Server? = nil
      do
        server = http.listen("::1", address_handler(addresses, kept), 0)
      catch
        if error is async.OperationError then
          local name = (error as async.OperationError).name
          if name == "EADDRNOTAVAIL" or name == "EAFNOSUPPORT" then
            test.skip("capability: IPv6 loopback is unavailable (" .. name .. ")")
          end
        end
        raise
      end
      check_request_addresses(server, addresses, kept, "::1", false)
    end)
  end)
end

-- Endpoint queries end with abort, upgrade, and upgrade rejection, while
-- commitment remains readable.
function test_request_addresses_end_with_their_exchange(_context: test.Context)
  runtime_test.run(function ()
    local notes: {string: string} = {}
    -- The client sees EOF before the handler records its observations.
    local finished, next_finished, close_finished = async.channel<|string|>(4)
    runtime_test.cleanup(close_finished)
    local handler: http.Handler = function (request: http.Request, response: http.Response)
      local path = request.url.path
      defer finished(path)
      if path == "/abort" then
        response:abort()
      elseif path == "/upgrade" then
        local upgraded = response:upgrade(request, "probe")
        upgraded:close()
      elseif path == "/reject" then
        response:reject_upgrade(request, 403)
      end
      local ended = ""
      do
        request:peer_address()
      catch
        ended = string.tostring(error)
      end
      notes[path] = ended .. "|" .. string.tostring(response:is_committed())
    end
    local server = http.listen("127.0.0.1", handler, 0)
    runtime_test.cleanup(function () server:close() end)
    local port = server:local_address().port
    serve_in_background(server, "HTTP ended-exchange listener")
    local upgrade_offer = "Connection: Upgrade\r\nUpgrade: probe\r\n\r\n"
    local wire, timed_out = wire_response(port, "GET /abort HTTP/1.1\r\nHost: localhost\r\n\r\n")
    test.assert(not timed_out and wire == "", "aborted exchange sent a response")
    test.assert(next_finished() == "/abort", "abort handler did not finish")
    wire, timed_out = wire_response(port,
      "GET /upgrade HTTP/1.1\r\nHost: localhost\r\n" .. upgrade_offer)
    test.assert(not timed_out and support.contains(wire, "101 Switching Protocols"))
    test.assert(next_finished() == "/upgrade", "upgrade handler did not finish")
    wire, timed_out = wire_response(port,
      "GET /reject HTTP/1.1\r\nHost: localhost\r\n" .. upgrade_offer)
    test.assert(not timed_out and support.contains(wire, "403 Forbidden"))
    test.assert(next_finished() == "/reject", "reject_upgrade handler did not finish")
    test.assert(notes["/abort"] == "HTTP request exchange has ended|false",
                "abort: " .. string.tostring(notes["/abort"]))
    test.assert(notes["/upgrade"] == "HTTP request exchange has ended|true",
                "upgrade: " .. string.tostring(notes["/upgrade"]))
    test.assert(notes["/reject"] == "HTTP request exchange has ended|true",
                "reject_upgrade: " .. string.tostring(notes["/reject"]))
  end)
end

-- A small response leaves in one TLS application record with its headers;
-- explicit send_headers still flushes the header block first.
function test_server_coalesces_tls_response_records(_context: test.Context)
  runtime_test.run(function ()
    local handler: http.Handler = function (request: http.Request, response: http.Response)
      local path = request.url.path
      if path == "/fixed" then
        response:set_header("Content-Length", "5")
        response:write("hello")
      elseif path == "/chunked" then
        response:write("hello")
      elseif path == "/explicit" then
        response:set_header("Content-Length", "5")
        response:send_headers()
        response:write("hello")
      end
    end
    local server = http.listen_tls("127.0.0.1", support.CERTIFICATE, handler,
                                   support.PRIVATE_KEY, 0)
    runtime_test.cleanup(function () server:close() end)
    serve_in_background(server, "HTTPS record listener")
    local secure = ssl.connect("127.0.0.1", server:local_address().port, support.TRUST_ROOT)
    runtime_test.cleanup(function () secure:close() end)
    local fixed_head = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n"
    local chunked_head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
    secure:write("GET /fixed HTTP/1.1\r\nHost: localhost\r\n\r\n")
    test.assert(secure:read() == fixed_head .. "hello", "fixed response was split")
    secure:write("GET /chunked HTTP/1.1\r\nHost: localhost\r\n\r\n")
    test.assert(secure:read() == chunked_head .. "5\r\nhello\r\n", "chunked response was split")
    test.assert(secure:read() == "0\r\n\r\n", "chunked terminator was not its own record")
    secure:write("GET /empty HTTP/1.1\r\nHost: localhost\r\n\r\n")
    test.assert(secure:read() == chunked_head .. "0\r\n\r\n", "empty response was split")
    secure:write("GET /explicit HTTP/1.1\r\nHost: localhost\r\n\r\n")
    test.assert(secure:read() == fixed_head, "send_headers did not flush headers alone")
    test.assert(secure:read() == "hello", "body after send_headers was not its own record")
  end)
end
