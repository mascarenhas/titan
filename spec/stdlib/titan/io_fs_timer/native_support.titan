local type PrintableFactory = (string, string, boolean) -> value
local type ConversionLog = () -> string

local function remove_native(path: string)
  test.assert(native.titan_spec_remove_if_present(path) == 0,
              "could not remove native fixture path")
end

local function cleanup_path(context: test.Context, path: string)
  context:cleanup(function ()
    remove_native(path)
  end)
end

local function new_workspace(context: test.Context): string
  local pattern = "/tmp/titan-io-fs-timer-XXXXXX"
  local storage = ffi.titan_ffi_char.new_array(#pattern + 1)
  cstring.memcpy(storage as *ffi.titan_ffi_char,
                 pattern as const *ffi.titan_ffi_char,
                 #pattern as cstring.size_t)
  storage[#pattern] = 0
  local created = native.mkdtemp(storage as *ffi.titan_ffi_char)
  test.assert(created, "could not create native workspace")
  local root = created as string
  cleanup_path(context, root)
  return root
end

local function make_symlink(context: test.Context,
                            target: string, link: string)
  cleanup_path(context, link)
  local status: integer = native.symlink(target, link)
  test.assert(status == 0, "could not create native symlink fixture")
end

local function set_fixture_environment(context: test.Context,
                                       name: string, contents: string)
  local old_pointer = cstdlib.getenv(name)
  local old_value: string? = nil
  if old_pointer then old_value = old_pointer as string end
  context:cleanup(function ()
    local status: integer = 0
    if old_value then
      status = native.setenv(name, old_value as string, 1)
    else
      status = native.unsetenv(name)
    end
    test.assert(status == 0, "could not restore native environment fixture")
  end)
  local status: integer = native.setenv(name, contents, 1)
  test.assert(status == 0, "could not set native environment fixture")
end

local function make_boundary_payload(): string
  local prefix_length = 65535
  local length = prefix_length + 6
  local storage = ffi.titan_ffi_char.new_array(length)
  cstring.memset(storage as *ffi.titan_ffi_char, 120,
                 prefix_length as cstring.size_t)
  storage[prefix_length] = 0
  storage[prefix_length + 1] = 89
  storage[prefix_length + 2] = 116
  storage[prefix_length + 3] = 97
  storage[prefix_length + 4] = 105
  storage[prefix_length + 5] = 108
  return storage as string
end

local function begin_stdout_capture(): (integer, integer)
  local read_descriptor = -1
  local write_descriptor = -1
  local saved_stdout = -1
  local redirected = false
  local transferred = false
  defer do
    if not transferred then
      if redirected and saved_stdout >= 0 then native.dup2(saved_stdout, 1) end
      if saved_stdout >= 0 then native.close(saved_stdout) end
      if write_descriptor >= 0 then native.close(write_descriptor) end
      if read_descriptor >= 0 then native.close(read_descriptor) end
    end
  end

  local descriptors = ffi.titan_ffi_int.new_array(2)
  local status: integer = native.titan_spec_capture_pipe(
      descriptors as *ffi.titan_ffi_int)
  test.assert(status == 0, "could not create stdout capture pipe")
  read_descriptor = descriptors[0]
  write_descriptor = descriptors[1]
  saved_stdout = native.dup(1)
  test.assert(saved_stdout >= 0, "could not duplicate stdout")
  test.assert(cstdio.fflush(nil) == 0, "could not flush stdout")
  status = native.dup2(write_descriptor, 1)
  test.assert(status == 1, "could not redirect stdout")
  redirected = true
  local closing = write_descriptor
  write_descriptor = -1
  test.assert(native.close(closing) == 0,
              "could not release redirected pipe descriptor")
  transferred = true
  return read_descriptor, saved_stdout
end

local function end_stdout_capture(read_descriptor: integer,
                                   saved_stdout: integer)
  local flushed = cstdio.fflush(nil) == 0
  local restored = native.dup2(saved_stdout, 1) == 1
  local saved_closed = native.close(saved_stdout) == 0
  local read_closed = native.close(read_descriptor) == 0
  test.assert(flushed, "could not flush redirected stdout")
  test.assert(restored, "could not restore stdout")
  test.assert(saved_closed, "could not release saved stdout descriptor")
  test.assert(read_closed, "could not release capture read descriptor")
end

local function captured_bytes(read_descriptor: integer,
                              capacity: integer): string
  local storage = ffi.titan_ffi_char.new_array(capacity)
  local count: integer = native.titan_spec_capture_read(
      read_descriptor, storage as *ffi.titan_ffi_char,
      capacity as native.titan_spec_size)
  test.assert(count >= 0, "stdout capture had no completed write")
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  test.assert(lua.lua_checkstack(L, 1) ~= 0,
              "cannot reserve Lua stack for captured stdout")
  lua.lua_pushlstring(L, storage as *ffi.titan_ffi_char,
                      count as native.titan_spec_size)
  local result: value = ffi.lua_totvalue(L, -1)
  return result as string
end

local function load_print_helpers(): (PrintableFactory, ConversionLog)
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  test.assert(lua.lua_checkstack(L, 3) ~= 0,
              "cannot reserve Lua stack for print fixtures")
  local source = [[
local conversions = {}
return
  function(label, rendered, should_fail)
    return setmetatable({}, {
      __tostring = function()
        conversions[#conversions + 1] = label
        if should_fail then error("conversion failure", 0) end
        return rendered
      end,
    })
  end,
  function()
    return table.concat(conversions, "|")
  end
]]
  local status = lual.luaL_loadstring(L, source)
  if status ~= lua.LUA_OK then
    local failure: value = ffi.lua_totvalue(L, -1)
    raise failure
  end
  status = lua.lua_pcallk(L, 0, 2, 0, 0, nil)
  if status ~= lua.LUA_OK then
    local failure: value = ffi.lua_totvalue(L, -1)
    raise failure
  end
  local factory_value: value = ffi.lua_totvalue(L, -2)
  local log_value: value = ffi.lua_totvalue(L, -1)
  return factory_value as PrintableFactory, log_value as ConversionLog
end
