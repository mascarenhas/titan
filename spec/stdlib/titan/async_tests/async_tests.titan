-- Native public-behavior tests migrated from async_channel_spec.lua and
-- async_combinators_spec.lua. This folder is one logical test module.
local test = import "test"
local async = import "async"
local timer = import "timer"

-- These narrow Lua/C boundaries build reachability probes and inspect raw
-- traceback text without adding unrelated Titan standard-library imports.
local lua = foreign import "lua.h"
local ffi = foreign import "titan/ffi.h"
local cstring = foreign import "string.h"

interface ReaderCloserShape
  function read(): string?
  function read_until(delimiter: string, chop: boolean?): string?
  function close()
end

interface WriterCloserShape
  function write(data: string)
  function close()
end
