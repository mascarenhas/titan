local type Finalizer = (value) -> ()

local function check(condition: boolean, message: string)
  test.assert(condition, message)
end

local function wait_until_waiting(task: async.Task)
  while task:status():as_string() == "ready" do timer.yield() end
  check(task:status():as_string() == "waiting", "Task did not suspend")
end

local function cancelled_with(status: async.TaskStatus,
                              expected: string): boolean
  local was_cancelled, reason? = status:has_cancelled()
  if not was_cancelled then return false end
  local exact = reason as async.CancellationReason
  case exact
  when simple: message then return message == expected
  else return false
  end
end

local function successful(result: value): async.Task
  return async.run(function (): value
    return result
  end)
end

local function sleeping(milliseconds: integer,
                        result: value): async.Task
  return async.run(function (): value
    timer.sleep(milliseconds)
    return result
  end)
end

local function cancelled(reason: string): async.Task
  local task = sleeping(60000, "unexpected cancellation return")
  task:cancel(async.CancellationReason.simple(reason))
  return task
end

local function failing(reason: value): async.Task
  return async.run(function (): value
    timer.yield()
    raise reason
    return nil
  end)
end

local function success_payload(status: async.TaskStatus): value
  local succeeded, result? = status:has_succeeded()
  check(succeeded, "expected succeeded Task status")
  return result
end

local function cancelled_payload(status: async.TaskStatus): value
  local was_cancelled, reason? = status:has_cancelled()
  check(was_cancelled, "expected cancelled Task status")
  local cancellation = reason as async.CancellationReason
  case cancellation
  when simple: text then return text
  when complex: payload then return payload
  else raise "invalid cancellation reason"
  end
end

local function contains(subject: string, fragment: string): boolean
  return cstring.strstr(subject, fragment) ~= nil
end

-- Install a finalizer only on the fresh fixture Map supplied by these tests.
-- This duplicates no production policy: it exists solely to observe whether
-- async ownership has released the Map, without importing titan.gc.
local function mark_finalizable(candidate: {string: value},
                                callback: Finalizer)
  local top = lua.lua_gettop(L)
  defer lua.lua_settop(L, top)
  check(lua.lua_checkstack(L, 3) ~= 0,
        "cannot reserve Lua stack for reachability probe")
  ffi.lua_pushtvalue(L, candidate)
  local metatable: {string: value} = {
    ["__gc"] = callback,
  }
  ffi.lua_pushtvalue(L, metatable)
  lua.lua_setmetatable(L, -2)
end

local function collect_garbage()
  check(lua.lua_gc(L, lua.LUA_GCCOLLECT) >= 0,
        "garbage collection is unavailable")
end

local function cancel_and_join_task(task: async.Task, reason: string)
  if not task:status():has_finished() then
    task:cancel(async.CancellationReason.simple(reason))
  end
  async.join(task)
end

local function cleanup_task(context: test.Context, task: async.Task,
                            reason: string)
  context:cleanup(function ()
    cancel_and_join_task(task, reason)
  end)
end
