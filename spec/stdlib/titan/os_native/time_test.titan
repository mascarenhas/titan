function test_clocks_and_calendar_results(_context: test.Context)
  local original_timezone: string? = install_test_timezone()
  defer restore_test_timezone(original_timezone)

  local before: float = system.clock()
  local total = 0
  for index = 1, 200000 do total = total + index end
  local after: float = system.clock()
  test.assert(total > 0 and before >= 0.0 and after >= before,
              "CPU clock did not remain monotonic")
  test.assert(system.difftime(27, 9) == 18.0)
  test.assert(system.difftime(25, 10) == 15.0)

  test.assert(as_string(system.date("!%Y-%m-%d %H:%M:%S", 0),
                        "formatted UTC date") ==
              "1970-01-01 00:00:00")
  test.assert(as_string(system.date("!%Y-%m-%d %H:%M:%S %w %j", 0),
                        "detailed UTC date") ==
              "1970-01-01 00:00:00 4 001")
  test.assert(as_string(system.date("%Y-%m-%d %H:%M:%S", 0),
                        "formatted local date") ==
              "1969-12-31 19:00:00")
  test.assert(system.date(nil, 0) is string,
              "default date format did not return a string")

  local date = as_date(system.date("!*t", 0), "UTC decomposition")
  test.assert(date.year == 1970 and date.month == 1 and date.day == 1)
  test.assert(date.hour == 0 and date.min == 0 and date.sec == 0)
  test.assert(date.wday == 5 and date.yday == 1)
  test.assert(date.isdst == false or date.isdst == nil)
end

function test_time_defaults_normalization_and_dst(
    _context: test.Context)
  local original_timezone: string? = install_test_timezone()
  defer restore_test_timezone(original_timezone)

  local expected_now = ctime.time(nil) as integer
  local now = system.time()
  local delta = now - expected_now
  if delta < 0 then delta = -delta end
  test.assert(delta <= 2, "os.time differed from the host current time")

  local direct_now = system.time(nil, nil, nil, nil, nil, nil, nil)
  delta = direct_now - now
  if delta < 0 then delta = -delta end
  test.assert(delta <= 2, "positional nil did not select current time")
  assert_raises_contains(function()
    system.time(nil, nil, nil, nil, nil, nil, false)
  end, "time requires year, month, and day together")

  local named_now = system.time {}
  delta = named_now - now
  if delta < 0 then delta = -delta end
  test.assert(delta <= 2, "empty named arguments did not select current time")
  named_now = system.time { isdst = nil }
  delta = named_now - now
  if delta < 0 then delta = -delta end
  test.assert(delta <= 2, "named nil did not select current time")
  assert_raises_contains(function()
    system.time { isdst = false }
  end, "time requires year, month, and day together")

  local inferred = system.time(2020, 7, 1, 12, 0, 0, nil)
  local standard = system.time(2020, 7, 1, 12, 0, 0, false)
  local daylight = system.time(2020, 7, 1, 12, 0, 0, true)
  test.assert(inferred == daylight,
              "inferred July time did not select daylight time")
  test.assert(standard - daylight == 60 * 60,
              "false isdst did not select standard time")

  local noon = system.time { year = 2001, month = 2, day = 3 }
  local explicit_noon = system.time(2001, 2, 3, 12, 0, 0, nil)
  test.assert(noon == explicit_noon,
              "named date fields did not use the noon default")

  local normalized = system.time(2020, 2, 30, 4, 5, 6, nil)
  local fields = as_date(system.date("*t", normalized),
                         "normalized local date")
  test.assert(fields.year == 2020 and fields.month == 3 and fields.day == 1)
  test.assert(fields.hour == 4 and fields.min == 5 and fields.sec == 6)
  test.assert(fields.wday == 1 and fields.yday == 61)
  test.assert(fields.isdst == false)
end

function test_date_growth_and_invalid_inputs(_context: test.Context)
  local format = ""
  local expected = ""
  for _index = 1, 1024 do
    format = format .. "%Y"
    expected = expected .. "1970"
  end
  test.assert(as_string(system.date("!" .. format, 0),
                        "long formatted date") == expected,
              "long date output was truncated")
  test.assert(as_string(system.date("!", 0),
                        "empty UTC format") == "")

  assert_raises_contains(function()
    system.date("%Q", 0)
  end, "invalid conversion specifier '%Q'")
  assert_raises_contains(function()
    system.date("%", 0)
  end, "invalid conversion specifier '%'")
  assert_raises_contains(function()
    system.date("%Y\0suffix", 0)
  end, "date format contains an embedded NUL")
  assert_raises_contains(function()
    system.time(2020)
  end, "time requires year, month, and day together")
  assert_raises_contains(function()
    system.time(nil, nil, nil, 12)
  end, "time requires year, month, and day together")
  assert_raises_contains(function()
    system.time(9223372036854775807, 1, 1)
  end, "time field 'year' is out of range")
end

function test_locale_query_change_restore_and_validation(
    _context: test.Context)
  local previous: string? = system.setlocale(nil, "time")
  test.assert(previous ~= nil, "could not query LC_TIME")
  local saved = previous as string
  defer do
    local restored: string? = system.setlocale(saved, "time")
    test.assert(restored ~= nil, "could not restore LC_TIME")
  end

  test.assert(system.setlocale("C", "time") == "C")
  test.assert(system.setlocale(nil, "time") == "C")
  test.assert(as_string(system.date("!%c", 0), "C-locale date") ==
              c_utc_format("%c"),
              "C-locale date differed from ISO C strftime")
  test.assert(system.setlocale(
    "titan-locale-that-does-not-exist", "time") == nil)

  assert_raises_contains(function()
    system.setlocale("C", "unknown")
  end, "invalid locale category 'unknown'")
  assert_raises_contains(function()
    system.setlocale("C\0suffix", "time")
  end, "locale name contains an embedded NUL")
  assert_raises_contains(function()
    system.setlocale("C", "time\0suffix")
  end, "locale category contains an embedded NUL")
end
