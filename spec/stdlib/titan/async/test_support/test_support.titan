-- Task helpers for async.tests on both targets; the timer-backed helpers are
-- in sleep.titan.
local test = import "test"
local async = import "async"
local transfer = import "transfer"
foreign import "lua.h"
foreign import "titan/ffi.h"
foreign import "string.h"

local function wait_until_waiting(task: async.Task)
  while task:status():as_string() == "ready" do async.yield() end
  test.assert(task:status():as_string() == "waiting", "Task did not suspend")
end

local function cancelled_with(status: async.TaskStatus,
                              expected: string): boolean
  local was_cancelled, reason? = status:has_cancelled()
  if not was_cancelled then return false end
  const exact = reason as async.CancellationReason
  case exact
  when simple(message) then return message == expected
  else return false
  end
end

local function successful(result: value): async.Task
  return async.run<|value, value|>(function (): value
    return result
  end)
end

local function failing(reason: value): async.Task
  return async.run<|value, value|>(function (): value
    async.yield()
    raise reason
    return nil
  end)
end

local function success_payload(status: async.TaskStatus): value
  local succeeded, result? = status:has_succeeded()
  test.assert(succeeded, "expected succeeded Task status")
  return result
end

local function cancelled_payload(status: async.TaskStatus): value
  local was_cancelled, reason? = status:has_cancelled()
  test.assert(was_cancelled, "expected cancelled Task status")
  const cancellation = reason as async.CancellationReason
  case cancellation
  when simple(text) then return text
  when complex(payload) then return payload
  else raise "invalid cancellation reason"
  end
end

local function contains(subject: string, fragment: string): boolean
  return ffi.strstr(subject, fragment) ~= nil
end

-- Install a finalizer only on the fresh fixture Map supplied by these tests.
-- This duplicates no production policy: it exists solely to observe whether
-- async ownership has released the Map, without importing titan.gc.
local function mark_finalizable(candidate: {string: value},
                                callback: function (value): ())
  const top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 3) ~= 0,
        "cannot reserve Lua stack for reachability probe")
  ffi.lua_pushtvalue(L, candidate)
  const metatable: {string: value} = {
    ["__gc"] = callback,
  }
  ffi.lua_pushtvalue(L, metatable)
  ffi.lua_setmetatable(L, -2)
end

local function collect_garbage()
  test.assert(ffi.lua_gc(L, ffi.LUA_GCCOLLECT) >= 0,
        "garbage collection is unavailable")
end

--- Decode the raw packet at `slots[offset]` from Lua code in an independent state.
-- Only this Lua/lightuserdata boundary asserts the borrowed slot address:
-- `transfer.decode_message` takes a raw C slot, which has no dynamic Lua
-- coercion, and consumes the packet on return or error. The caller supplies a
-- live host slot array and an in-bounds offset; nil and negative offsets are
-- rejected before any pointer arithmetic.
function decode_raw_slot(slots: value, offset: integer): value
  if slots == nil then raise "decode_raw_slot requires a slot array" end
  if offset < 0 then raise "decode_raw_slot requires a nonnegative offset" end
  return transfer.decode_message((slots as foreign *(*void)) + offset)
end
