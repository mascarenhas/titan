-- Channel, combinator, Task, subscription and Runtime behavior for
-- titan.async. Plain contributors run on every target; *.native.titan
-- contributors hold the cases that need libuv, timers, Receivers, foreign
-- work, external waits or other native-only facilities.
local test = import "test"
local runtime_test = import "support.runtime.titan"
local async = import "async"
local support = import "async.test_support.titan"
local task_support = import "support.async.titan"

-- These narrow Lua/C boundaries build reachability probes and inspect raw
-- traceback text without adding unrelated Titan standard-library imports.
foreign import "lua.h"
foreign import "titan/ffi.h"
foreign import "string.h"

interface ReaderCloserShape
  function read(): string?
  function read_until(delimiter: string, chop: boolean?): string?
  function close()
end

interface WriterCloserShape
  function write(data: string)
  function close()
end
