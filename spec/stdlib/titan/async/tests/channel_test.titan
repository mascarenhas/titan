local record ChannelPayload
  ordinal: integer
  text: string
end

local type FinalizablePayload = {string: value}

local function close_buffered_finalizable(
    send: function (FinalizablePayload): (), close: function (): (),
    callback: function (value): ())
  local payload: FinalizablePayload = {}
  support.mark_finalizable(payload, callback)
  send(payload)
  close()
end

function test_channel_capacity_and_fifo(_context: test.Context)
  runtime_test.run(function ()
    local send, receive = async.channel<|ChannelPayload|>(3)
    send(ChannelPayload.new(1, "first"))
    send(ChannelPayload.new(2, "second"))
    send(ChannelPayload.new(3, "third"))
    local first = receive()
    local second = receive()
    test.assert(first.ordinal == 1 and first.text == "first",
          "channel lost its first nominal item")
    test.assert(second.ordinal == 2 and second.text == "second",
          "channel lost its second nominal item")
    send(ChannelPayload.new(4, "fourth"))
    test.assert(receive().ordinal == 3, "channel FIFO order changed")
    test.assert(receive().ordinal == 4, "channel circular wrap changed")

    local send_nil, receive_nil = async.channel<|nil|>()
    send_nil(nil)
    test.assert(receive_nil() == nil, "channel did not carry nil")

    local send_integer, receive_integer = async.channel<|integer|>()
    send_integer(41)
    test.assert(receive_integer() + 1 == 42,
          "channel lost its precise scalar result")

    local send_value, receive_value = async.channel()
    send_value("fallback")
    test.assert((receive_value() as string) == "fallback",
          "bare channel did not retain its value fallback")

    local send_context: function (string): (), receive_context: function (): (string),
          close_context: function (): () = async.channel()
    send_context("context")
    test.assert(receive_context() == "context",
          "expected callback shapes did not infer the channel payload")
    close_context()

    local zero_rejected = false
    do
      async.channel<|integer|>(0)
    catch
      zero_rejected = error is string
    end
    local negative_rejected = false
    do
      async.channel<|integer|>(-1)
    catch
      negative_rejected = error is string
    end
    test.assert(zero_rejected and negative_rejected,
          "channel accepted a size below one")
  end)
end

function test_channel_blocking_handoffs_and_coalesced_wakes(
    context: test.Context)
  runtime_test.run(function ()
    -- The omitted size is one: the producer must block on its second send
    -- until this Task receives the buffered first item.
    local send, receive = async.channel<|string|>()
    local producer_trace = ""
    local producer = async.run(function (): nil
      producer_trace = producer_trace .. "send-first>"
      send("first")
      producer_trace = producer_trace .. "send-second>"
      send("second")
      producer_trace = producer_trace .. "sent"
      return
    end)
    task_support.cleanup_task(producer, "channel producer cleanup")
    support.wait_until_waiting(producer)
    test.assert(producer_trace == "send-first>send-second>",
          "default channel did not block its full sender")
    test.assert(receive() == "first", "default channel lost first handoff")
    test.assert(receive() == "second", "default channel lost second handoff")
    test.assert(async.join(producer):has_succeeded() and
          producer_trace == "send-first>send-second>sent",
          "blocked producer did not finish")

    -- Both sends request the same receiver wake before its zero timer fires.
    -- Task:resume must coalesce them while the receiver drains both items.
    local send_two, receive_two = async.channel<|string|>(2)
    local received = ""
    local consumer = async.run(function (): nil
      received = receive_two() .. ">" .. receive_two()
    end)
    task_support.cleanup_task(consumer, "channel consumer cleanup")
    support.wait_until_waiting(consumer)
    send_two("one")
    send_two("two")
    test.assert(async.join(consumer):has_succeeded() and received == "one>two",
          "coalesced receiver wake lost a buffered item")
  end)
end

function test_channel_allows_one_blocked_task_per_side(context: test.Context)
  runtime_test.run(function ()
    local send, receive = async.channel<|string|>()
    local first_receiver = async.run(receive)
    task_support.cleanup_task(first_receiver, "first receiver cleanup")
    support.wait_until_waiting(first_receiver)
    local receiver_rejected = false
    local second_receiver = async.run(function (): nil
      do
        receive()
      catch
        receiver_rejected = error is string
      end
    end)
    task_support.cleanup_task(second_receiver, "second receiver cleanup")
    test.assert(async.join(second_receiver):has_succeeded() and receiver_rejected,
          "channel accepted a second blocked receiver")
    send("received")
    receiver_rejected = false
    do
      receive()
    catch
      receiver_rejected = error is string
    end
    test.assert(receiver_rejected,
          "channel let a receiver barge ahead of its blocked receiver")
    local receiver_status = async.join(first_receiver)
    local receiver_succeeded, receiver_value =
      receiver_status:has_succeeded()
    test.assert(receiver_succeeded and receiver_value == "received",
          "first blocked receiver was disturbed")

    local send_full, receive_full = async.channel<|string|>()
    send_full("stored")
    local first_sender = async.run(function (): nil
      send_full("released")
    end)
    task_support.cleanup_task(first_sender, "first sender cleanup")
    support.wait_until_waiting(first_sender)
    local sender_rejected = false
    local second_sender = async.run(function (): nil
      do
        send_full("rejected")
      catch
        sender_rejected = error is string
      end
    end)
    task_support.cleanup_task(second_sender, "second sender cleanup")
    test.assert(async.join(second_sender):has_succeeded() and sender_rejected,
          "channel accepted a second blocked sender")
    test.assert(receive_full() == "stored", "full channel lost stored item")
    sender_rejected = false
    do
      send_full("barging")
    catch
      sender_rejected = error is string
    end
    test.assert(sender_rejected,
          "channel let a sender barge ahead of its blocked sender")
    test.assert(receive_full() == "released", "first blocked sender was disturbed")
    test.assert(async.join(first_sender):has_succeeded(),
          "first blocked sender did not finish")
  end)
end

function test_channel_cancellation_clears_waiters(context: test.Context)
  runtime_test.run(function ()
    local send, receive = async.channel<|string|>()
    local cancelled_receiver = async.run(receive)
    task_support.cleanup_task(cancelled_receiver, "cancelled receiver cleanup")
    support.wait_until_waiting(cancelled_receiver)
    cancelled_receiver:cancel(
      async.CancellationReason.simple("receiver cancelled"))
    test.assert(support.cancelled_with(async.join(cancelled_receiver),
                         "receiver cancelled"),
          "blocked receiver cancellation changed")

    -- Cancellation must have removed the sole receive waiter, allowing a new
    -- Task to occupy that side of the channel.
    local replacement_receiver = async.run(receive)
    task_support.cleanup_task(replacement_receiver, "replacement receiver cleanup")
    support.wait_until_waiting(replacement_receiver)
    send("replacement")
    local replacement_status = async.join(replacement_receiver)
    local replacement_succeeded, replacement =
      replacement_status:has_succeeded()
    test.assert(replacement_succeeded and replacement == "replacement",
          "cancelled receiver left a stale waiter")

    local send_full, receive_full = async.channel<|string|>()
    send_full("stored")
    local cancelled_sender = async.run(function (): nil
      send_full("cancelled")
    end)
    task_support.cleanup_task(cancelled_sender, "cancelled sender cleanup")
    support.wait_until_waiting(cancelled_sender)
    cancelled_sender:cancel(
      async.CancellationReason.simple("sender cancelled"))
    test.assert(support.cancelled_with(async.join(cancelled_sender), "sender cancelled"),
          "blocked sender cancellation changed")

    local replacement_sender = async.run(function (): nil
      send_full("replacement")
    end)
    task_support.cleanup_task(replacement_sender, "replacement sender cleanup")
    support.wait_until_waiting(replacement_sender)
    test.assert(receive_full() == "stored", "sender cleanup lost stored item")
    test.assert(receive_full() == "replacement",
          "cancelled sender left a stale waiter")
    test.assert(async.join(replacement_sender):has_succeeded(),
          "replacement sender did not finish")
  end)
end

function test_channel_rejects_foreign_resume_tokens(context: test.Context)
  runtime_test.run(function ()
    local wrong_token = async.ResumeToken.new("channel test outsider")
    local send, receive = async.channel<|string|>()
    send("stored")
    local sender = async.run(function (): nil
      send("released")
    end)
    task_support.cleanup_task(sender, "token-guarded sender cleanup")
    support.wait_until_waiting(sender)
    local sender_error = ""
    do
      sender:resume(wrong_token)
    catch
      sender_error = error as string
    end
    test.assert(sender_error ==
          "Task resume token mismatch (expected source: channel)" and
          sender:status():as_string() == "waiting",
          "foreign token did not fail in the blocked sender's caller")
    test.assert(receive() == "stored", "foreign sender wake changed the buffer")
    test.assert(receive() == "released", "channel progress did not wake sender")
    test.assert(async.join(sender):has_succeeded(),
          "token-guarded sender did not finish")

    local send_empty, receive_empty = async.channel<|string|>()
    local receiver = async.run(receive_empty)
    task_support.cleanup_task(receiver, "token-guarded receiver cleanup")
    support.wait_until_waiting(receiver)
    local receiver_error = ""
    do
      receiver:resume(wrong_token)
    catch
      receiver_error = error as string
    end
    test.assert(receiver_error ==
          "Task resume token mismatch (expected source: channel)" and
          receiver:status():as_string() == "waiting",
          "foreign token did not fail in the blocked receiver's caller")
    send_empty("delivered")
    local receiver_status = async.join(receiver)
    local receiver_succeeded, received = receiver_status:has_succeeded()
    test.assert(receiver_succeeded and received == "delivered",
          "channel progress did not wake receiver")
  end)
end

function test_channel_close_is_idempotent_and_wakes_waiters(
    context: test.Context)
  runtime_test.run(function ()
    local send, receive, close = async.channel<|string|>(2)
    send("discarded")
    close()
    close()
    local send_error = ""
    do
      send("after close")
    catch
      send_error = error as string
    end
    local receive_error = ""
    do
      receive()
    catch
      receive_error = error as string
    end
    test.assert(send_error == "channel is closed" and
          receive_error == "channel is closed",
          "closed channel accepted a direct operation")

    local discarded_finalized = false
    local retain_send, _, retain_close = async.channel<|FinalizablePayload|>()
    close_buffered_finalizable(
        retain_send, retain_close, function (_: value)
          discarded_finalized = true
        end)
    support.collect_garbage()
    support.collect_garbage()
    test.assert(discarded_finalized,
          "close retained a buffered channel value")

    local _, blocked_receive, close_receive = async.channel<|string|>()
    local receiver = async.run<|value, value|>(function (): value
      do
        blocked_receive()
      catch
        return error
      end
      return "receiver did not raise"
    end)
    task_support.cleanup_task(receiver, "closed receiver cleanup")
    support.wait_until_waiting(receiver)
    close_receive()
    close_receive()
    local receiver_status = async.join(receiver)
    local receiver_succeeded, receiver_result =
      receiver_status:has_succeeded()
    test.assert(receiver_succeeded and receiver_result == "channel is closed",
          "close did not wake its blocked receiver with an error")

    local blocked_send, drain, close_send = async.channel<|string|>()
    blocked_send("stored")
    local sender = async.run<|value, value|>(function (): value
      do
        blocked_send("blocked")
      catch
        return error
      end
      return "sender did not raise"
    end)
    task_support.cleanup_task(sender, "closed sender cleanup")
    support.wait_until_waiting(sender)
    close_send()
    close_send()
    local sender_status = async.join(sender)
    local sender_succeeded, sender_result = sender_status:has_succeeded()
    test.assert(sender_succeeded and sender_result == "channel is closed",
          "close did not wake its blocked sender with an error")
    do
      drain()
    catch
      test.assert(error == "channel is closed",
            "closed sender channel returned discarded data")
    end

    -- Cancellation remains authoritative if it races with the scheduled wake
    -- requested by close.
    local _, race_receive, race_close = async.channel<|string|>()
    local racing = async.run(race_receive)
    task_support.cleanup_task(racing, "racing receiver cleanup")
    support.wait_until_waiting(racing)
    race_close()
    racing:cancel(async.CancellationReason.simple("racing cancellation"))
    test.assert(support.cancelled_with(async.join(racing), "racing cancellation"),
          "channel close displaced a competing Task cancellation")
  end)
end

function test_reader_writer_channel_adapters(context: test.Context)
  runtime_test.run(function ()
    local zero_rejected = false
    do
      async.reader_writer_channel(0)
    catch
      zero_rejected = error is string
    end
    local negative_rejected = false
    do
      async.reader_writer_channel(-1)
    catch
      negative_rejected = error is string
    end
    test.assert(zero_rejected and negative_rejected,
          "reader/writer adapter accepted a size below one")

    local invalid_reader, invalid_writer = async.reader_writer_channel()
    local delimiter_rejected = false
    do
      invalid_reader:read_until("", true)
    catch
      delimiter_rejected = error is string
    end
    test.assert(delimiter_rejected,
          "ChannelReader accepted an empty delimiter")
    invalid_reader:close()
    invalid_writer:close()

    local concrete_reader, concrete_writer =
      async.reader_writer_channel()
    local reader: ReaderCloserShape = concrete_reader
    local writer: WriterCloserShape = concrete_writer
    local producer = async.run(function (): nil
      writer:write("alpha<")
      writer:write(">beta")
      writer:write("::tail")
    end)
    task_support.cleanup_task(producer, "adapter producer cleanup")

    local first? = reader:read_until("<>", true)
    local second? = reader:read_until("::", false)
    local third? = reader:read()
    test.assert(async.join(producer):has_succeeded(),
          "channel writer did not finish")
    test.assert(first == "alpha" and second == "beta::" and third == "tail",
          "channel reader changed message-boundary parsing")
    reader:close()
    writer:close()
    test.assert(reader:read() == nil,
          "closed ChannelReader returned data")

    local waiting_reader, closing_writer =
      async.reader_writer_channel()
    local close_result = "did not raise"
    local blocked = async.run(function (): nil
      do
        waiting_reader:read()
      catch
        close_result = error as string
      end
    end)
    task_support.cleanup_task(blocked, "adapter blocked reader cleanup")
    support.wait_until_waiting(blocked)
    closing_writer:close()
    test.assert(async.join(blocked):has_succeeded() and
          close_result == "channel is closed",
          "ChannelWriter close did not wake its blocked reader")
    waiting_reader:close()

    -- A delimiter suffix has already crossed the channel boundary and is
    -- reader-owned. Writer close preserves that excess; only the following
    -- receive observes the closed channel.
    local excess_reader, excess_writer =
      async.reader_writer_channel()
    excess_writer:write("head::tail")
    test.assert(excess_reader:read_until("::", true) == "head",
          "ChannelReader did not split its buffered suffix")
    excess_writer:close()
    test.assert(excess_reader:read() == "tail",
          "ChannelWriter close discarded reader-owned excess")
    local exhausted_error = ""
    do
      excess_reader:read()
    catch
      exhausted_error = error as string
    end
    test.assert(exhausted_error == "channel is closed",
          "ChannelReader did not observe close after its excess")
    excess_reader:close()

    local closing_reader, blocked_writer =
      async.reader_writer_channel()
    blocked_writer:write("stored")
    local blocked_writer_error = "did not raise"
    local blocked_writer_task = async.run(function (): nil
      do
        blocked_writer:write("blocked")
      catch
        blocked_writer_error = error as string
      end
    end)
    task_support.cleanup_task(blocked_writer_task, "adapter blocked writer cleanup")
    support.wait_until_waiting(blocked_writer_task)
    closing_reader:close()
    test.assert(async.join(blocked_writer_task):has_succeeded() and
          blocked_writer_error == "channel is closed",
          "ChannelReader close did not wake its blocked writer")

    local cancelled_reader, cancellation_writer =
      async.reader_writer_channel()
    local cancelled = async.run<|value, value|>(function (): value
      return cancelled_reader:read()
    end)
    task_support.cleanup_task(cancelled, "adapter cancelled reader cleanup")
    support.wait_until_waiting(cancelled)
    cancelled:cancel(
      async.CancellationReason.simple("adapter cancellation"))
    test.assert(support.cancelled_with(async.join(cancelled), "adapter cancellation"),
          "ChannelReader changed blocked Task cancellation")
    local replacement = async.run<|value, value|>(function (): value
      return cancelled_reader:read()
    end)
    task_support.cleanup_task(replacement, "adapter replacement reader cleanup")
    support.wait_until_waiting(replacement)
    cancellation_writer:write("replacement")
    local replacement_status = async.join(replacement)
    local replacement_succeeded, replacement_value =
      replacement_status:has_succeeded()
    test.assert(replacement_succeeded and replacement_value == "replacement",
          "cancelled ChannelReader left a stale receive waiter")
    cancelled_reader:close()
  end)
end

-- A finalizer wake of a blocked channel side at every safepoint of its
-- suspension window (task_support.each_wake_offset). The waiter receives from
-- an empty channel, or sends to a full one holding 1.
local record ChannelWindow
  send: function (integer): ()
  receive: function (): (integer)
  close: function (): ()
  received: value
end

local function channel_wake_window(blocked_send: boolean, driver: boolean,
    wake: function (ChannelWindow): (), expected: value)
  runtime_test.run(function ()
    task_support.each_wake_offset(driver, nil, function (): task_support.WakeCase
      local send, receive, close = async.channel<|integer|>(1)
      local channel = ChannelWindow(send, receive, close, nil)
      local body: function (): (value) = function (): value
        return receive()
      catch
        return error
      end
      if blocked_send then
        send(1)
        body = function (): value
          send(2)
          return "sent"
        catch
          return error
        end
      end
      return task_support.WakeCase(body, function (_: async.Task) wake(channel) end, nil,
        function (waiter: async.Task, offset: integer)
          local finished, result? = waiter:status():has_succeeded()
          test.assert(finished and result == expected, "offset " .. offset ..
            ": the channel wake left the waiter " .. waiter:status():as_string())
          if blocked_send and expected == "sent" then
            test.assert(channel.received == 1 and receive() == 2,
              "offset " .. offset .. ": the channel lost or reordered an item")
          end
          close()
        end)
    end)
  end)
end

local function channel_close(channel: ChannelWindow) channel.close() end

function test_channel_wake_before_waiter_suspends(context: test.Context)
  context:run("receive_send_in_waiter", function (_: test.Context)
    channel_wake_window(false, false, function (channel: ChannelWindow)
      channel.send(17)
    end, 17)
  end)
  context:run("receive_send_in_driver", function (_: test.Context)
    channel_wake_window(false, true, function (channel: ChannelWindow)
      channel.send(17)
    end, 17)
  end)
  context:run("receive_close_in_waiter", function (_: test.Context)
    channel_wake_window(false, false, channel_close, "channel is closed")
  end)
  context:run("receive_close_in_driver", function (_: test.Context)
    channel_wake_window(false, true, channel_close, "channel is closed")
  end)
  context:run("send_receive_in_waiter", function (_: test.Context)
    channel_wake_window(true, false, function (channel: ChannelWindow)
      channel.received = channel.receive()
    end, "sent")
  end)
  context:run("send_receive_in_driver", function (_: test.Context)
    channel_wake_window(true, true, function (channel: ChannelWindow)
      channel.received = channel.receive()
    end, "sent")
  end)
  context:run("send_close_in_waiter", function (_: test.Context)
    channel_wake_window(true, false, channel_close, "channel is closed")
  end)
  context:run("send_close_in_driver", function (_: test.Context)
    channel_wake_window(true, true, channel_close, "channel is closed")
  end)
end

-- A finalizer send while the receiver runs past its delivered receive leaves
-- a stale latch on the shared token. The receiver's next blocking receive
-- consumes it, rechecks the empty buffer and parks until a real send.
function test_channel_tolerates_stale_latched_wake(_: test.Context)
  runtime_test.run(function ()
    task_support.each_wake_offset(false, nil, function (): task_support.WakeCase
      local send, receive, close = async.channel<|integer|>(2)
      local stage = 0
      local body = function (): value
        local first = receive()
        local second = receive()
        stage = 3
        local third = receive()
        return first .. "," .. second .. "," .. third
      end
      local drive = function (window: task_support.WakeWindow, receiver: async.Task)
        window.open = false
        async.yield()
        window.open = true
        send(1)
        for _ = 1, 50 do
          if stage == 3 and receiver:status():as_string() == "waiting" then break end
          async.yield()
        end
        if stage == 3 then send(3) end
      end
      return task_support.WakeCase(body, function (_: async.Task) send(2) end, drive,
        function (receiver: async.Task, offset: integer)
          local finished, result? = receiver:status():has_succeeded()
          test.assert(finished and result == "1,2,3", "offset " .. offset ..
            ": a stale latched wake changed the receives: " .. receiver:status():as_string())
          close()
        end)
    end)
  end)
end
