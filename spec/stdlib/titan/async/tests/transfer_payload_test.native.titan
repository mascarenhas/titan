local transfer_reflect = import "reflect"
local transfer_protobuf = import "protobuf"
local transfer_mod = import "transfer"
local transfer_thread = import "thread"
local transfer_lua = import "lua"
local transfer_coroutine = import "coroutine"
local transfer_gc = import "gc"
local transfer_fs = import "fs"
local transfer_os = import "os"
local transfer_command = import "support.command.titan"
local transfer_common = import "support.common.titan"
foreign import "stdlib.h"
foreign import "transfer.h"
foreign type TransferMessageSlot = *void

-- Own the raw packet local in this frame: decode_message consumes and clears
-- the actual guarded local, so the deferred discard sees nil after success or
-- any decode error.
local function transfer_roundtrip_value(candidate: value): value
  local raw = transfer_mod.encode_message(candidate)
  defer transfer_mod.discard_message(raw)
  return transfer_mod.decode_message(raw)
end

-- This stateful C entry receives the *caller's slot*, not an unguarded raw
-- value. It is passed as an ordinary Lua C function to independent states.
local foreign function transfer_discard_slot_lua(state: *lua_State): int
  local slot = ffi.lua_touserdata(state, 1) as *(*void)
  local raw = slot[0]
  slot[0] = nil
  transfer_mod.discard_message(raw)
  return 0
end

record TransferPayloadRecord
  local secret: integer
end

local function transfer_record_fields(): const {transfer_reflect.Type}
  return {transfer_reflect.Type.is_nil(), transfer_reflect.Type.is_integer(),
    transfer_reflect.Type.is_string(), transfer_reflect.Type.is_boolean()}
end

function TransferPayloadRecord:to_transfer_payload(): string
  support.collect_garbage()
  return transfer_protobuf.serialize_fields(transfer_record_fields(), nil,
    self.secret, "payload\0bytes", false)
end

function TransferPayloadRecord.from_transfer_payload(payload: string): TransferPayloadRecord
  local empty: value, number: integer, bytes: string, flag: boolean =
    transfer_protobuf.deserialize_fields(payload, transfer_record_fields())
  test.assert(empty == nil and bytes == "payload\0bytes" and not flag)
  support.collect_garbage()
  return { secret = number }
end


record TransferPayloadNative
  local policies: {async.TransferValue}
end

local function transfer_policy_fields(): const {transfer_reflect.Type}
  return {transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
    transfer_reflect.Type.is_named(transfer_reflect.NamedType("titan.transfer.TransferValue")))}
end

function TransferPayloadNative:to_transfer_payload(): string
  return transfer_protobuf.serialize_fields(transfer_policy_fields(), self.policies)
end

function TransferPayloadNative.from_transfer_payload(payload: string): TransferPayloadNative
  local policies: {async.TransferValue} =
    transfer_protobuf.deserialize_fields(payload, transfer_policy_fields())
  return { policies = policies }
end


record TransferPayloadClosureCycle
  local marker: integer
end

function TransferPayloadClosureCycle:to_transfer_payload(): string
  local packet = async.TransferValue.from_value(function (): value return self end)
  return ""
end

function TransferPayloadClosureCycle.from_transfer_payload(payload: string): TransferPayloadClosureCycle
  return { marker = #payload }
end


record TransferPayloadMutator
  local mutate: function (): ()
end

function TransferPayloadMutator:read(): integer
  return 0
end

function TransferPayloadMutator:to_transfer_payload(): string
  self.mutate()
  return "mutator"
end

function TransferPayloadMutator.from_transfer_payload(payload: string): TransferPayloadMutator
  test.assert(payload == "mutator")
  return { mutate = function () end }
end


local function transfer_payload_error(action: function (): (), fragment: string)
  local caught = false
  do
    action()
  catch
    caught = error is string and support.contains(error, fragment)
  end
  test.assert(caught, "missing transfer error containing: " .. fragment)
end


function test_receiver_copies_custom_record_payload_and_retains_policy(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local source: TransferPayloadRecord = { secret = 211 }
    local packet = async.TransferValue.from_value(source)
    async.send(receiver:handle(), packet)
    source.secret = -1
    support.collect_garbage()
    case packet
    when is_record_payload(module, name, payload) then
      test.assert(module == "async.tests" and name == "async.tests.TransferPayloadRecord" and #payload > 0)
    else raise "TransferValue.from_value unwrapped the custom record policy"
    end
    local restored: TransferPayloadRecord = receiver:wait()
    test.assert(restored.secret == 211, "Receiver retained source payload storage")
    local policy_restored: TransferPayloadRecord = packet:to_value()
    test.assert(policy_restored.secret == 211, "sending a TransferValue policy mutated it")
  end)
end

function test_receiver_rejects_custom_record_closure_cycle(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local source: TransferPayloadClosureCycle = { marker = 1 }
    transfer_payload_error(function () async.TransferValue.from_value(source) end,
                           "cyclic")
    transfer_payload_error(function () async.send(receiver:handle(), source) end,
                           "cyclic")
    async.send(receiver:handle(), async.TransferValue.is_integer(42))
    test.assert((receiver:wait() as integer) == 42,
                "rejected payload poisoned a reusable Receiver")
  end)
end

function test_receiver_copies_opaque_payload_with_preconverted_native_policies(_context: test.Context)
  runtime_test.run(function ()
    local state = ffi.luaL_newstate()
    test.assert(state ~= nil, "could not allocate borrowed payload state")
    defer ffi.lua_close(state)
    local memory: owned int[] = foreign int.new_array(1)
    memory[0] = 137
    local null_pointer: foreign *void = nil
    local null_state: foreign *lua_State = nil
    local callback: foreign function (*lua_State): int = receiver_test_callback
    local inner: TransferPayloadNative = { policies = {
      async.TransferValue.is_pointer(null_pointer),
      async.TransferValue.is_pointer(memory as foreign *void),
      async.TransferValue.is_lua_state(null_state),
      async.TransferValue.is_lua_state(state),
      async.TransferValue.is_function(callback)
    } }
    local outer: TransferPayloadNative = {
      policies = { async.TransferValue.from_value(inner) }
    }
    local receiver = async.receiver()
    defer receiver:close()
    async.send(receiver:handle(), async.TransferValue.from_value(outer))
    support.collect_garbage()
    local outer_copy: TransferPayloadNative = receiver:wait()
    test.assert(#outer_copy.policies == 1)
    local inner_copy: TransferPayloadNative = outer_copy.policies[1]:to_value()
    local policies = inner_copy.policies
    test.assert(#policies == 5)
    case policies[1]
    when is_pointer(pointer) then test.assert(pointer == nil)
    else raise "nested NULL pointer policy changed variant" end
    case policies[2]
    when is_pointer(pointer) then test.assert(pointer == memory as foreign *void)
    else raise "nested pointer policy changed variant" end
    case policies[3]
    when is_lua_state(pointer) then test.assert(pointer == nil)
    else raise "nested NULL state policy changed variant" end
    case policies[4]
    when is_lua_state(pointer) then test.assert(pointer == state)
    else raise "nested state policy changed variant" end
    case policies[5]
    when is_function(entry) then test.assert(entry == callback)
    else raise "nested native function policy changed variant" end
    local native: function (...: value): (...: value) = policies[5]:to_value()
    test.assert(native(139) == 139, "nested native function lost callability")
    test.assert(memory[0] == 137, "nested pointer policy changed borrowed storage")
  end)
end

-- Issue #252: packet-scoped resource table, native discard, Packet lifecycle,
-- and demand-driven codec/reflection behavior.

local transfer_hook_log: {string} = {}
local transfer_hook_saved_sender: (transfer_thread.Sender<|integer|>)? = nil
local transfer_hook_saved_receiver: (transfer_thread.Receiver<|integer|>)? = nil
local transfer_forbidden_decode_calls = 0

local function reset_transfer_hook_state()
  transfer_hook_log = {}
  transfer_hook_saved_sender = nil
  transfer_hook_saved_receiver = nil
  transfer_forbidden_decode_calls = 0
end

-- Use and drop one hook-adopted endpoint in a frame that returns before the
-- caller collects garbage. Titan compiled code keeps expression values in
-- reserved GC-root slots for the lifetime of a function; reading the saved
-- wrapper in the observing frame would therefore retain it and hide its
-- finalizer. The ownership contract still requires the native claim to be
-- released once the wrapper itself becomes unreachable.
local function transfer_drain_saved_sender(
    peer: transfer_thread.Receiver<|integer|>,
    payload: integer,
    label: string): (boolean, integer?)
  local adopted: (transfer_thread.Sender<|integer|>)? = transfer_hook_saved_sender
  test.assert(adopted ~= nil and not peer:is_closed(), label)
  if adopted == nil then return false, nil end
  test.assert(adopted:try_send(payload))
  local got, item? = peer:try_receive()
  transfer_hook_saved_sender = nil
  return got, item
end

local function transfer_drain_saved_receiver(
    peer: transfer_thread.Sender<|integer|>,
    payload: integer,
    label: string): (boolean, integer?)
  local adopted: (transfer_thread.Receiver<|integer|>)? = transfer_hook_saved_receiver
  test.assert(adopted ~= nil and not peer:is_closed(), label)
  if adopted == nil then return false, nil end
  test.assert(peer:try_send(payload))
  local got, item? = adopted:try_receive()
  transfer_hook_saved_receiver = nil
  return got, item
end

local function transfer_payload_raises(action: function (): (), message: string)
  local caught = false
  do
    action()
  catch
    caught = true
  end
  test.assert(caught, message)
end
local foreign function test_resource_retain(raw: *void)
  local count = raw as *int
  count[0] = count[0] + 1
end

local foreign function test_resource_release(raw: *void)
  local count = raw as *int
  count[0] = count[0] - 1
end

local foreign function test_resource_other_release(raw: *void)
  local count = raw as *int
  count[0] = count[0] - 100
end

local foreign function transfer_limited_lua_alloc(
    ud: *void, ptr: *void, osize: size_t, nsize: size_t): *void
  if nsize == (0 as size_t) then
    ffi.free(ptr)
    return nil
  end
  local ctrl = ud as *size_t
  if ctrl ~= nil then
    local mode = ctrl[0]
    if mode == (1 as size_t) then
      if ptr == nil then
        if ctrl[1] > (0 as size_t) then
          ctrl[1] = ctrl[1] - (1 as size_t)
        end
        if ctrl[1] == (0 as size_t) then
          ctrl[2] = ctrl[2] + (1 as size_t)
          if ctrl[2] >= (2 as size_t) then
            ctrl[0] = 0 as size_t
          end
          return nil
        end
      end
    elseif mode == (2 as size_t) then
      if nsize >= ctrl[1] then
        if nsize > osize then
          ctrl[2] = ctrl[2] + (1 as size_t)
          if ctrl[2] >= (2 as size_t) then
            ctrl[0] = 0 as size_t
          end
          return nil
        end
      end
    end
  end
  return ffi.realloc(ptr, nsize)
end

record TransferPayloadHookStep
  local label: string
  local fail_encode: boolean
  local fail_decode: boolean
end

local function transfer_hook_step_fields(): const {transfer_reflect.Type}
  return {transfer_reflect.Type.is_string(), transfer_reflect.Type.is_boolean()}
end

function TransferPayloadHookStep:to_transfer_payload(): string
  transfer_hook_log[#transfer_hook_log + 1] = "enc:" .. self.label
  if self.fail_encode then
    raise "hook-encode-boom:" .. self.label
  end
  return transfer_protobuf.serialize_fields(
    transfer_hook_step_fields(), self.label, self.fail_decode)
end

function TransferPayloadHookStep.from_transfer_payload(
    payload: string): TransferPayloadHookStep
  local label: string, fail_decode: boolean =
    transfer_protobuf.deserialize_fields(payload, transfer_hook_step_fields())
  transfer_hook_log[#transfer_hook_log + 1] = "dec:" .. label
  if fail_decode then
    raise "hook-decode-boom:" .. label
  end
  return { label = label, fail_encode = false, fail_decode = false }
end

record TransferPayloadStashingSender
  local tx: (transfer_thread.Sender<|integer|>)?
  local index_bytes: string
end

function TransferPayloadStashingSender:to_transfer_payload(): string
  local sender = self.tx as transfer_thread.Sender<|integer|>
  local bytes = sender:to_transfer_payload()
  self.index_bytes = bytes
  return bytes
end

function TransferPayloadStashingSender.from_transfer_payload(
    payload: string): TransferPayloadStashingSender
  local adopted = transfer_thread.Sender<|integer|>.from_transfer_payload(payload)
  transfer_hook_saved_sender = adopted
  return { tx = adopted, index_bytes = payload }
end

record TransferPayloadStashingReceiver
  local rx: (transfer_thread.Receiver<|integer|>)?
  local index_bytes: string
end

function TransferPayloadStashingReceiver:to_transfer_payload(): string
  local receiver = self.rx as transfer_thread.Receiver<|integer|>
  local bytes = receiver:to_transfer_payload()
  self.index_bytes = bytes
  return bytes
end

function TransferPayloadStashingReceiver.from_transfer_payload(
    payload: string): TransferPayloadStashingReceiver
  local adopted = transfer_thread.Receiver<|integer|>.from_transfer_payload(payload)
  transfer_hook_saved_receiver = adopted
  return { rx = adopted, index_bytes = payload }
end

record TransferPayloadSenderComposite
  before: TransferPayloadHookStep
  first: transfer_thread.Sender<|integer|>
  middle: TransferPayloadHookStep
  second: transfer_thread.Sender<|integer|>
  after: TransferPayloadHookStep
end

record TransferPayloadReceiverComposite
  before: TransferPayloadHookStep
  first: transfer_thread.Receiver<|integer|>
  middle: TransferPayloadHookStep
  second: transfer_thread.Receiver<|integer|>
  after: TransferPayloadHookStep
end

record TransferPayloadPartialAdoptedSender
  adopted_first: TransferPayloadStashingSender
  failing_middle: TransferPayloadHookStep
  unclaimed_second: transfer_thread.Sender<|integer|>
end

record TransferPayloadPartialAdoptedReceiver
  adopted_first: TransferPayloadStashingReceiver
  failing_middle: TransferPayloadHookStep
  unclaimed_second: transfer_thread.Receiver<|integer|>
end

union TransferPayloadEndpointUnion
  empty()
  sender_only(transfer_thread.Sender<|integer|>)
  receiver_only(transfer_thread.Receiver<|integer|>)
  both(tx: transfer_thread.Sender<|integer|>, rx: transfer_thread.Receiver<|integer|>)
end

record TransferPayloadEndpointGraph
  direct_tx: transfer_thread.Sender<|integer|>
  direct_rx: transfer_thread.Receiver<|integer|>
  choice: TransferPayloadEndpointUnion
  tx_list: {transfer_thread.Sender<|integer|>}
  const_tx_list: const {transfer_thread.Sender<|integer|>}
  rx_list: {transfer_thread.Receiver<|integer|>}
  hooked: TransferPayloadStashingSender
end

record TransferPayloadDuplicateEndpoints
  left_tx: TransferPayloadStashingSender
  right_tx: TransferPayloadStashingSender
  tx_pair: {transfer_thread.Sender<|integer|>}
  left_rx: TransferPayloadStashingReceiver
  right_rx: TransferPayloadStashingReceiver
end

-- Claimed wrappers move here so the frame that read them can return before
-- the release observations collect garbage.
local record TransferPayloadDuplicateHolders
  local tx1: transfer_thread.Sender<|integer|>?
  local tx2: transfer_thread.Sender<|integer|>?
  local tx3: transfer_thread.Sender<|integer|>?
  local rx1: transfer_thread.Receiver<|integer|>?
  local rx2: transfer_thread.Receiver<|integer|>?
end

record TransferPayloadManySenders
  senders: {transfer_thread.Sender<|integer|>}
  tail: TransferPayloadHookStep
end

record TransferPayloadLargeAndSender
  first: transfer_thread.Sender<|integer|>
  text: string
  second: transfer_thread.Sender<|integer|>
end

record TransferPayloadForbiddenDecode
  local tx: (transfer_thread.Sender<|integer|>)?
  local rx: (transfer_thread.Receiver<|transfer_thread.Sender<|integer|>|>)?
end

function TransferPayloadForbiddenDecode:to_transfer_payload(): string
  local sender = self.tx as transfer_thread.Sender<|integer|>
  local tx_bytes = sender:to_transfer_payload()
  local rx_bytes = ""
  if self.rx ~= nil then
    local receiver = self.rx as transfer_thread.Receiver<|transfer_thread.Sender<|integer|>|>
    rx_bytes = receiver:to_transfer_payload()
  end
  return tx_bytes .. rx_bytes
end

function TransferPayloadForbiddenDecode.from_transfer_payload(
    _payload: string): TransferPayloadForbiddenDecode
  transfer_forbidden_decode_calls = transfer_forbidden_decode_calls + 1
  raise "discard must never invoke from_transfer_payload"
end

record TransferPayloadForbiddenEnvelope
  inner: TransferPayloadForbiddenDecode
end

union TransferPayloadForbiddenUnion
  item(TransferPayloadForbiddenDecode)
end

local function encode_sender_composite_raw(
    fail_before: boolean,
    fail_middle: boolean,
    fail_after: boolean): (foreign *void, transfer_thread.Receiver<|integer|>, transfer_thread.Receiver<|integer|>)
  local tx1, rx1 = transfer_thread.channel<|integer|>(1)
  local tx2, rx2 = transfer_thread.channel<|integer|>(1)
  local item = TransferPayloadSenderComposite(
    TransferPayloadHookStep("b", false, fail_before),
    tx1,
    TransferPayloadHookStep("m", false, fail_middle),
    tx2,
    TransferPayloadHookStep("a", false, fail_after))
  return transfer_mod.encode_message(item), rx1, rx2
end

local function encode_receiver_composite_raw(
    fail_before: boolean,
    fail_middle: boolean,
    fail_after: boolean): (foreign *void, transfer_thread.Sender<|integer|>, transfer_thread.Sender<|integer|>, transfer_thread.Receiver<|integer|>)
  local tx1, rx1 = transfer_thread.channel<|integer|>(1)
  local tx2, rx2 = transfer_thread.channel<|integer|>(1)
  local nested_tx, nested_rx = transfer_thread.channel<|integer|>(1)
  local msg_tx, msg_rx = transfer_thread.channel<|transfer_thread.Sender<|integer|>|>(1)
  test.assert(msg_tx:try_send(nested_tx))
  msg_tx:close()
  -- Keep rx1 and rx2 typed as Receiver<|integer|>, and verify
  -- buffered message drain on rx1 by pre-sending an integer and checking tx1:is_closed().
  test.assert(tx1:try_send(51))
  test.assert(tx2:try_send(52))
  msg_rx:close()
  local item = TransferPayloadReceiverComposite(
    TransferPayloadHookStep("b", false, fail_before),
    rx1,
    TransferPayloadHookStep("m", false, fail_middle),
    rx2,
    TransferPayloadHookStep("a", false, fail_after))
  return transfer_mod.encode_message(item), tx1, tx2, nested_rx
end

local function encode_partial_adopted_sender_raw(): (
    foreign *void, transfer_thread.Receiver<|integer|>, transfer_thread.Receiver<|integer|>)
  local tx1, rx1 = transfer_thread.channel<|integer|>(1)
  local tx2, rx2 = transfer_thread.channel<|integer|>(1)
  local item = TransferPayloadPartialAdoptedSender(
    TransferPayloadStashingSender(tx1, ""),
    TransferPayloadHookStep("m", false, true),
    tx2)
  return transfer_mod.encode_message(item), rx1, rx2
end

local function encode_partial_adopted_receiver_raw(): (
    foreign *void, transfer_thread.Sender<|integer|>, transfer_thread.Sender<|integer|>)
  local tx1, rx1 = transfer_thread.channel<|integer|>(1)
  local tx2, rx2 = transfer_thread.channel<|integer|>(1)
  test.assert(tx1:try_send(81))
  local item = TransferPayloadPartialAdoptedReceiver(
    TransferPayloadStashingReceiver(rx1, ""),
    TransferPayloadHookStep("m", false, true),
    rx2)
  return transfer_mod.encode_message(item), tx1, tx2
end

function test_transfer_resource_decoder_order_and_partial_adoption(context: test.Context)
  context:run("sender-success", function (_context: test.Context)
    reset_transfer_hook_state()
    local raw, rx1, rx2 = encode_sender_composite_raw(false, false, false)
    defer transfer_mod.discard_message(raw)
    defer rx1:close()
    defer rx2:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and not rx2:is_closed(),
                "encoded packet did not retain encoded Senders after source GC")
    local decoded: TransferPayloadSenderComposite = transfer_mod.decode_message(raw)
    test.assert(#transfer_hook_log == 6 and
                transfer_hook_log[1] == "enc:b" and transfer_hook_log[2] == "enc:m" and
                transfer_hook_log[3] == "enc:a" and transfer_hook_log[4] == "dec:b" and
                transfer_hook_log[5] == "dec:m" and transfer_hook_log[6] == "dec:a",
                "unexpected custom hook encounter order")
    test.assert(decoded.first:try_send(101) and decoded.second:try_send(202))
    local ok1, v1? = rx1:try_receive()
    local ok2, v2? = rx2:try_receive()
    test.assert(ok1 and v1 == 101 and ok2 and v2 == 202)
  end)

  context:run("sender-fail-before", function (_context: test.Context)
    reset_transfer_hook_state()
    local raw, rx1, rx2 = encode_sender_composite_raw(true, false, false)
    defer transfer_mod.discard_message(raw)
    defer rx1:close()
    defer rx2:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and not rx2:is_closed())
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = error is string and support.contains(error, "hook-decode-boom:b")
    end
    test.assert(caught, "missing transfer error containing: hook-decode-boom:b")
    -- Inverted #250 Appendix C: throwing decoder before later Senders releases
    -- all unclaimed table entries immediately upon decode_message unwind.
    test.assert(rx1:is_closed() and rx2:is_closed(),
                "throwing decoder before Senders leaked an unclaimed Sender retain")
    test.assert(#transfer_hook_log == 4 and transfer_hook_log[4] == "dec:b")
  end)

  context:run("sender-fail-middle-partial", function (_context: test.Context)
    reset_transfer_hook_state()
    local raw, rx1, rx2 = encode_sender_composite_raw(false, true, false)
    defer transfer_mod.discard_message(raw)
    defer rx1:close()
    defer rx2:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and not rx2:is_closed())
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = error is string and support.contains(error, "hook-decode-boom:m")
    end
    test.assert(caught, "missing transfer error containing: hook-decode-boom:m")
    -- second was never claimed, so packet unwind released it immediately.
    test.assert(rx2:is_closed(), "unclaimed second Sender was not released on unwind")
    -- first was adopted into a wrapper before middle failed; GC collects that wrapper.
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx1:is_closed(), "partially adopted first Sender wrapper leaked")
  end)

  context:run("sender-distinguish-adopted-from-unclaimed", function (_context: test.Context)
    reset_transfer_hook_state()
    defer reset_transfer_hook_state()
    local raw, rx1, rx2 = encode_partial_adopted_sender_raw()
    defer transfer_mod.discard_message(raw)
    defer rx1:close()
    defer rx2:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and not rx2:is_closed())
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = error is string and support.contains(error, "hook-decode-boom:m")
    end
    test.assert(caught, "missing transfer error containing: hook-decode-boom:m")
    support.collect_garbage()
    support.collect_garbage()
    -- Unclaimed entry (rx2) was released by packet unwind; already-adopted
    -- wrapper (saved in transfer_hook_saved_sender) remains live and usable.
    test.assert(rx2:is_closed(), "unclaimed entry was not disposed when decode failed")
    local ok, val? = transfer_drain_saved_sender(rx1, 777,
        "packet unwind prematurely released an already-adopted Sender")
    test.assert(ok and val == 777)
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx1:is_closed(), "adopted Sender did not close peer after finalization")
  end)

  context:run("receiver-success-and-failures", function (_context: test.Context)
    reset_transfer_hook_state()
    local raw_ok, tx1_ok, tx2_ok, _ = encode_receiver_composite_raw(false, false, false)
    defer transfer_mod.discard_message(raw_ok)
    defer tx1_ok:close()
    defer tx2_ok:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not tx1_ok:is_closed() and not tx2_ok:is_closed())
    local decoded: TransferPayloadReceiverComposite = transfer_mod.decode_message(raw_ok)
    local ok1, v1? = decoded.first:try_receive()
    local ok2, v2? = decoded.second:try_receive()
    test.assert(ok1 and v1 == 51 and ok2 and v2 == 52)
    decoded.first:close()
    decoded.second:close()
    test.assert(tx1_ok:is_closed() and tx2_ok:is_closed())

    reset_transfer_hook_state()
    local raw_fb, tx1_fb, tx2_fb, _ = encode_receiver_composite_raw(true, false, false)
    defer transfer_mod.discard_message(raw_fb)
    defer tx1_fb:close()
    defer tx2_fb:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not tx1_fb:is_closed() and not tx2_fb:is_closed())
    local caught_before = false
    do
      transfer_mod.decode_message(raw_fb)
    catch
      caught_before = error is string and support.contains(error, "hook-decode-boom:b")
    end
    test.assert(caught_before, "missing transfer error containing: hook-decode-boom:b")
    test.assert(tx1_fb:is_closed() and tx2_fb:is_closed(),
                "throwing decoder before Receivers leaked an unclaimed Receiver retain")

    reset_transfer_hook_state()
    defer reset_transfer_hook_state()
    local raw_pa, tx1_pa, tx2_pa = encode_partial_adopted_receiver_raw()
    defer transfer_mod.discard_message(raw_pa)
    defer tx1_pa:close()
    defer tx2_pa:close()
    support.collect_garbage()
    support.collect_garbage()
    local caught_partial = false
    do
      transfer_mod.decode_message(raw_pa)
    catch
      caught_partial = error is string and support.contains(error, "hook-decode-boom:m")
    end
    test.assert(caught_partial, "missing transfer error containing: hook-decode-boom:m")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(tx2_pa:is_closed(), "unclaimed Receiver entry was not disposed")
    test.assert(not tx1_pa:is_closed() and transfer_hook_saved_receiver ~= nil,
                "packet unwind prematurely released an already-adopted Receiver")
    local adopted_rx: (transfer_thread.Receiver<|integer|>)? = transfer_hook_saved_receiver
    local got, item? = adopted_rx:try_receive()
    test.assert(got and item == 81)
    adopted_rx:close()
    adopted_rx = nil
    transfer_hook_saved_receiver = nil
    test.assert(tx1_pa:is_closed())
  end)
end

local function encode_nested_graph_and_closure(): (
    foreign *void,
    foreign *void,
    {transfer_thread.Receiver<|integer|>},
    {transfer_thread.Sender<|integer|>})
  local tx1, rx1 = transfer_thread.channel<|integer|>(2)
  local tx2, rx2 = transfer_thread.channel<|integer|>(2)
  local tx3, rx3 = transfer_thread.channel<|integer|>(2)
  local tx4, rx4 = transfer_thread.channel<|integer|>(2)
  local tx5, rx5 = transfer_thread.channel<|integer|>(2)
  local tx6, rx6 = transfer_thread.channel<|integer|>(2)
  local ptx1, prx1 = transfer_thread.channel<|integer|>(2)
  local ptx2, prx2 = transfer_thread.channel<|integer|>(2)
  local ptx3, prx3 = transfer_thread.channel<|integer|>(2)
  test.assert(ptx1:try_send(11) and ptx2:try_send(22) and ptx3:try_send(33))
  local frozen_tx: const {transfer_thread.Sender<|integer|>} = {tx4}
  local graph = TransferPayloadEndpointGraph(
    tx1,
    prx1,
    TransferPayloadEndpointUnion.both(tx2, prx2),
    {tx3},
    frozen_tx,
    {prx3},
    TransferPayloadStashingSender(tx5, ""))
  local graph_raw = transfer_mod.encode_message(graph)
  defer transfer_mod.discard_message(graph_raw)
  local captured_tx = tx6
  local closure_raw = transfer_mod.encode_message(function (): integer
    test.assert(captured_tx:try_send(66))
    return 66
  end)
  local out_graph = graph_raw
  graph_raw = nil
  return out_graph, closure_raw, {rx1, rx2, rx3, rx4, rx5, rx6}, {ptx1, ptx2, ptx3}
end

local function encode_duplicate_endpoints(): (
    foreign *void,
    transfer_thread.Receiver<|integer|>,
    transfer_thread.Sender<|integer|>,
    string,
    string)
  local tx, rx_peer = transfer_thread.channel<|integer|>(4)
  local tx_peer, rx = transfer_thread.channel<|integer|>(4)
  local left_tx = TransferPayloadStashingSender(tx, "")
  local right_tx = TransferPayloadStashingSender(tx, "")
  local left_rx = TransferPayloadStashingReceiver(rx, "")
  local right_rx = TransferPayloadStashingReceiver(rx, "")
  local dup = TransferPayloadDuplicateEndpoints(
    left_tx, right_tx, {tx}, left_rx, right_rx)
  local raw = transfer_mod.encode_message(dup)
  return raw, rx_peer, tx_peer, left_tx.index_bytes, right_tx.index_bytes
end

-- Read the claimed wrappers inside this helper's frame and return only holder
-- state. Titan compiled expressions keep values in reserved GC-root slots for
-- the lifetime of the function, so the drop-and-collect observations below
-- must run in a frame that never read a wrapper value itself.
local function extract_duplicate_holders(
    candidate: value): TransferPayloadDuplicateHolders
  local decoded: TransferPayloadDuplicateEndpoints = candidate
  local holders = TransferPayloadDuplicateHolders {
    tx1 = decoded.left_tx.tx,
    tx2 = decoded.right_tx.tx,
    tx3 = decoded.tx_pair[1],
    rx1 = decoded.left_rx.rx,
    rx2 = decoded.right_rx.rx,
  }
  decoded.left_tx.tx = nil
  decoded.right_tx.tx = nil
  decoded.tx_pair = {}
  decoded.left_rx.rx = nil
  decoded.right_rx.rx = nil
  return holders
end

local function transfer_duplicate_use_last_sender(
    holders: TransferPayloadDuplicateHolders): boolean
  -- An explicitly optional local avoids the checker's inference-time option
  -- force, which would turn a nil field into a runtime error.
  local tx: (transfer_thread.Sender<|integer|>)? = holders.tx3
  holders.tx3 = nil
  if tx == nil then return false end
  return tx:try_send(303)
end

local function transfer_duplicate_receive_last(
    holders: TransferPayloadDuplicateHolders): (boolean, integer?)
  local rx: (transfer_thread.Receiver<|integer|>)? = holders.rx2
  holders.rx2 = nil
  if rx == nil then return false, nil end
  return rx:try_receive()
end

local function check_duplicate_adoption_release(
    holders: TransferPayloadDuplicateHolders,
    rx_peer: transfer_thread.Receiver<|integer|>,
    tx_peer: transfer_thread.Sender<|integer|>)
  defer reset_transfer_hook_state()
  reset_transfer_hook_state()

  holders.tx1 = nil
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not rx_peer:is_closed(), "dropping first duplicate Sender closed channel early")

  holders.tx2 = nil
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not rx_peer:is_closed(), "dropping second duplicate Sender closed channel early")
  test.assert(transfer_duplicate_use_last_sender(holders))
  local got, val? = rx_peer:try_receive()
  test.assert(got and val == 303)

  support.collect_garbage()
  support.collect_garbage()
  test.assert(rx_peer:is_closed(), "dropping last duplicate Sender did not close channel")

  holders.rx1 = nil
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not tx_peer:is_closed(), "dropping first duplicate Receiver closed channel early")
  test.assert(tx_peer:try_send(404))
  local got_rx, val_rx? = transfer_duplicate_receive_last(holders)
  test.assert(got_rx and val_rx == 404)

  support.collect_garbage()
  support.collect_garbage()
  test.assert(tx_peer:is_closed(), "dropping last duplicate Receiver did not close channel")
end

function test_transfer_resource_nested_shapes_duplicates_and_array_rejection(
    context: test.Context)
  context:run("nested-graph-and-closure", function (_context: test.Context)
    reset_transfer_hook_state()
    defer reset_transfer_hook_state()
    local graph_raw, closure_raw, rx_peers, tx_peers = encode_nested_graph_and_closure()
    defer transfer_mod.discard_message(graph_raw)
    defer transfer_mod.discard_message(closure_raw)
    defer do
      for i = 1, #rx_peers do rx_peers[i]:close() end
      for i = 1, #tx_peers do tx_peers[i]:close() end
    end
    support.collect_garbage()
    support.collect_garbage()
    for i = 1, #rx_peers do
      test.assert(not rx_peers[i]:is_closed(), "nested Sender was not retained in packet")
    end
    for i = 1, #tx_peers do
      test.assert(not tx_peers[i]:is_closed(), "nested Receiver was not retained in packet")
    end

    local decoded_graph: TransferPayloadEndpointGraph = transfer_mod.decode_message(graph_raw)
    local decoded_closure: function (): integer = transfer_mod.decode_message(closure_raw)

    reset_transfer_hook_state()
    test.assert(decoded_graph.direct_tx:try_send(1))
    local ok_r1, v_r1? = decoded_graph.direct_rx:try_receive()
    test.assert(ok_r1 and v_r1 == 11)
    case decoded_graph.choice
    when both(tx, rx) then
      test.assert(tx:try_send(2))
      local ok_r2, v_r2? = rx:try_receive()
      test.assert(ok_r2 and v_r2 == 22)
    else raise "expected both variant in decoded endpoint union"
    end
    test.assert(decoded_graph.tx_list[1]:try_send(3))
    test.assert(decoded_graph.const_tx_list[1]:try_send(4))
    local ok_r3, v_r3? = decoded_graph.rx_list[1]:try_receive()
    test.assert(ok_r3 and v_r3 == 33)
    test.assert((decoded_graph.hooked.tx as transfer_thread.Sender<|integer|>):try_send(5))
    test.assert(decoded_closure() == 66)

    for i = 1, 5 do
      local ok, item? = rx_peers[i]:try_receive()
      test.assert(ok and item == i)
    end
    local ok6, item6? = rx_peers[6]:try_receive()
    test.assert(ok6 and item6 == 66)
  end)

  context:run("duplicate-occurrences-independent-retains", function (_context: test.Context)
    reset_transfer_hook_state()
    local raw, rx_peer, tx_peer, idx0, idx1 = encode_duplicate_endpoints()
    defer transfer_mod.discard_message(raw)
    defer rx_peer:close()
    defer tx_peer:close()
    test.assert(#idx0 == 4 and #idx1 == 4 and idx0 ~= idx1,
                "duplicate endpoint occurrences did not receive distinct 4-byte slot indexes")
    test.assert(idx0 == "\0\0\0\0" and idx1 == "\1\0\0\0",
                "unexpected little-endian slot index encoding")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx_peer:is_closed() and not tx_peer:is_closed())
    local holders = extract_duplicate_holders(transfer_mod.decode_message(raw))
    check_duplicate_adoption_release(holders, rx_peer, tx_peer)
  end)

  context:run("top-level-array-rejected-without-leaking", function (_context: test.Context)
    local make_rejected_array = function (): transfer_thread.Receiver<|integer|>
      local tx, rx = transfer_thread.channel<|integer|>(1)
      local top_array: {transfer_thread.Sender<|integer|>} = {tx}
      transfer_payload_error(function ()
        async.TransferValue.from_value(top_array)
      end, "transfer: unsupported value")
      local rejected_raw: foreign *void = nil
      defer do transfer_mod.discard_message(rejected_raw) end
      transfer_payload_error(function ()
        rejected_raw = transfer_mod.encode_message(top_array)
      end, "transfer: unsupported value")
      local const_array: const {integer} = {1, 2, 3}
      local rejected_const_raw: foreign *void = nil
      defer do transfer_mod.discard_message(rejected_const_raw) end
      transfer_payload_error(function ()
        rejected_const_raw = transfer_mod.encode_message(const_array)
      end, "transfer: unsupported value")
      return rx
    end
    local rx = make_rejected_array()
    defer rx:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx:is_closed(), "rejected top-level Array leaked an endpoint reference")
  end)
end

record TransferPayloadNestedScopeProbe
  local mode: string
end

local nested_scope_peer_rxs: {transfer_thread.Receiver<|integer|>} = {}

function TransferPayloadNestedScopeProbe:to_transfer_payload(): string
  -- 1. Enclosing encode scope must not authorize claim_resource.
  transfer_payload_raises(function ()
    transfer_thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
  end, "enclosing encode scope authorized claim_resource")
  -- 2. Nested encode-from-encode succeeds in its own isolated table, then Nested
  -- decode-from-encode claims that inner slot while rejecting attach_resource.
  local inner_tx, inner_rx = transfer_thread.channel<|integer|>(1)
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = inner_rx
  local inner_decoded: TransferPayloadStashingSender =
    transfer_roundtrip_value(TransferPayloadStashingSender(inner_tx, ""))
  test.assert(inner_decoded.index_bytes == "\0\0\0\0",
              "nested encode did not start at its own slot 0")
  local inner_sender: transfer_thread.Sender<|integer|> = inner_decoded.tx
  test.assert(inner_sender:try_send(91))
  inner_sender:close()
  transfer_hook_saved_sender = nil

  -- 3. Nested failing encode-from-encode rolls back its own attachment and
  -- restores the outer encode scope.
  local fail_enc_rx = (function (): transfer_thread.Receiver<|integer|>
    local ftx, frx = transfer_thread.channel<|integer|>(1)
    transfer_payload_error(function ()
      transfer_roundtrip_value(TransferPayloadManySenders(
        {ftx}, TransferPayloadHookStep("inner-enc-fail", true, false)))
    end, "hook-encode-boom:inner-enc-fail")
    return frx
  end)()
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = fail_enc_rx

  -- 4. Nested failing decode-from-encode releases its unclaimed resource and
  -- restores the exact outer encode scope.
  local fail_dec_raw, fail_dec_rx1, fail_dec_rx2 =
    encode_sender_composite_raw(true, false, false)
  defer transfer_mod.discard_message(fail_dec_raw)
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = fail_dec_rx1
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = fail_dec_rx2
  local caught = false
  do
    transfer_mod.decode_message(fail_dec_raw)
  catch
    caught = error is string and support.contains(error, "hook-decode-boom:b")
  end
  test.assert(caught, "missing transfer error containing: hook-decode-boom:b")

  return self.mode
end

record TransferPayloadDecodeInsideEncodeProbe
  local dummy: integer
end

function TransferPayloadDecodeInsideEncodeProbe:to_transfer_payload(): string
  -- While an outer decode is paused underneath this nested encode, attempting
  -- to claim outer slot 1 must fail because the top scope is now ENCODE.
  transfer_payload_raises(function ()
    transfer_thread.Sender<|integer|>.from_transfer_payload("\1\0\0\0")
  end, "nested encode scope allowed claiming from paused outer decode scope")
  local tx, rx = transfer_thread.channel<|integer|>(1)
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = rx
  local idx = tx:to_transfer_payload()
  test.assert(idx == "\0\0\0\0", "encode-from-decode did not use its own table")
  return idx
end

function TransferPayloadDecodeInsideEncodeProbe.from_transfer_payload(
    payload: string): TransferPayloadDecodeInsideEncodeProbe
  local adopted = transfer_thread.Sender<|integer|>.from_transfer_payload(payload)
  test.assert(adopted:try_send(92))
  adopted:close()
  return { dummy = 92 }
end

function TransferPayloadNestedScopeProbe.from_transfer_payload(
    payload: string): TransferPayloadNestedScopeProbe
  -- 1. Enclosing decode scope must not authorize attach_resource.
  local tmp_tx, tmp_rx = transfer_thread.channel<|integer|>(1)
  defer tmp_tx:close()
  defer tmp_rx:close()
  transfer_payload_raises(function ()
    tmp_tx:to_transfer_payload()
  end, "enclosing decode scope authorized attach_resource")

  -- 2. Nested encode-from-decode pushes an encode scope (blocking claims against
  -- the paused outer decode scope), then Nested decode-from-decode decodes it,
  -- and both restore the exact outer decode scope.
  local nested_out: TransferPayloadDecodeInsideEncodeProbe =
    transfer_roundtrip_value(TransferPayloadDecodeInsideEncodeProbe(1))
  test.assert(nested_out.dummy == 92)

  -- 3. Nested failing encode-from-decode rolls back and restores outer decode scope.
  local fail_enc_rx = (function (): transfer_thread.Receiver<|integer|>
    local ftx, frx = transfer_thread.channel<|integer|>(1)
    transfer_payload_error(function ()
      transfer_roundtrip_value(TransferPayloadManySenders(
        {ftx}, TransferPayloadHookStep("dec-inner-enc-fail", true, false)))
    end, "hook-encode-boom:dec-inner-enc-fail")
    return frx
  end)()
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = fail_enc_rx

  -- 4. Nested failing decode-from-decode releases its packet and restores outer decode scope.
  local fail_dec_raw, fail_dec_rx1, fail_dec_rx2 =
    encode_sender_composite_raw(true, false, false)
  defer transfer_mod.discard_message(fail_dec_raw)
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = fail_dec_rx1
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = fail_dec_rx2
  local caught = false
  do
    transfer_mod.decode_message(fail_dec_raw)
  catch
    caught = error is string and support.contains(error, "hook-decode-boom:b")
  end
  test.assert(caught, "missing transfer error containing: hook-decode-boom:b")

  return { mode = payload }
end

record TransferPayloadOuterScopeEnvelope
  first: TransferPayloadStashingSender
  probe: TransferPayloadNestedScopeProbe
  second: TransferPayloadStashingSender
end

function test_transfer_resource_nested_scopes_table_growth_and_frontier(
    context: test.Context)
  context:run("table-growth-and-post-attach-encode-rollback", function (_context: test.Context)
    local make_failing_many = function (): {transfer_thread.Receiver<|integer|>}
      local txs: {transfer_thread.Sender<|integer|>} = {}
      local rxs: {transfer_thread.Receiver<|integer|>} = {}
      for i = 1, 12 do
        local tx, rx = transfer_thread.channel<|integer|>(1)
        txs[i] = tx
        rxs[i] = rx
      end
      transfer_payload_error(function ()
        transfer_roundtrip_value(TransferPayloadManySenders(
          txs, TransferPayloadHookStep("after-twelve", true, false)))
      end, "hook-encode-boom:after-twelve")
      return rxs
    end
    local rxs = make_failing_many()
    defer do for i = 1, #rxs do rxs[i]:close() end end
    support.collect_garbage()
    support.collect_garbage()
    for i = 1, #rxs do
      test.assert(rxs[i]:is_closed(),
                  "failed encode after table growth leaked Sender #" .. i)
    end
  end)

  context:run("nested-encode-decode-restores-exact-outer-scope", function (_context: test.Context)
    reset_transfer_hook_state()
    nested_scope_peer_rxs = {}
    defer do
      for i = 1, #nested_scope_peer_rxs do nested_scope_peer_rxs[i]:close() end
      nested_scope_peer_rxs = {}
      reset_transfer_hook_state()
    end
    local make_outer = function (): (
        foreign *void,
        transfer_thread.Receiver<|integer|>,
        transfer_thread.Receiver<|integer|>,
        string,
        string)
      local tx1, rx1 = transfer_thread.channel<|integer|>(1)
      local tx2, rx2 = transfer_thread.channel<|integer|>(1)
      local s1 = TransferPayloadStashingSender(tx1, "")
      local s2 = TransferPayloadStashingSender(tx2, "")
      local env = TransferPayloadOuterScopeEnvelope(
        s1, TransferPayloadNestedScopeProbe("nested-ok"), s2)
      local raw = transfer_mod.encode_message(env)
      return raw, rx1, rx2, s1.index_bytes, s2.index_bytes
    end
    local outer_raw, outer_rx1, outer_rx2, idx1, idx2 = make_outer()
    defer transfer_mod.discard_message(outer_raw)
    defer outer_rx1:close()
    defer outer_rx2:close()
    -- Outer slots must still be 0 and 1 despite inner encode/decode scopes.
    test.assert(idx1 == "\0\0\0\0" and idx2 == "\1\0\0\0",
                "nested scopes corrupted the outer packet's resource slot numbering")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not outer_rx1:is_closed() and not outer_rx2:is_closed())

    local decoded: TransferPayloadOuterScopeEnvelope = transfer_mod.decode_message(outer_raw)
    test.assert(decoded.probe.mode == "nested-ok")
    test.assert((decoded.first.tx as transfer_thread.Sender<|integer|>):try_send(111))
    test.assert((decoded.second.tx as transfer_thread.Sender<|integer|>):try_send(222))
    local ok1, v1? = outer_rx1:try_receive()
    local ok2, v2? = outer_rx2:try_receive()
    test.assert(ok1 and v1 == 111 and ok2 and v2 == 222)

    support.collect_garbage()
    support.collect_garbage()
    -- Check nested peers: [1] received 91 and closed, [5] received 92 and closed,
    -- and all failing nested encode/decode peers [2..4, 6..8] auto-closed!
    local ok_n1, vn1? = nested_scope_peer_rxs[1]:try_receive()
    local ok_n5, vn5? = nested_scope_peer_rxs[5]:try_receive()
    test.assert(ok_n1 and vn1 == 91 and ok_n5 and vn5 == 92)
    for i = 1, #nested_scope_peer_rxs do
      test.assert(nested_scope_peer_rxs[i]:is_closed(),
                  "nested scope peer #" .. i .. " was not released")
    end
  end)

  context:run("packet-encode-projects-capture-frontier-and-calls-hooks-once",
    function (_context: test.Context)
      reset_transfer_hook_state()
      local first_val = 10
      local second_val = 20
      local step2 = TransferPayloadHookStep("capture-second", false, false)
      local mutator = TransferPayloadMutator(function ()
        transfer_hook_log[#transfer_hook_log + 1] = "enc:capture-first"
        first_val = 900
        second_val = 800
        step2 = TransferPayloadHookStep("replaced-after-projection", true, true)
      end)
      local closure = function (): integer
        local base = mutator:read() + first_val + second_val
        if step2.fail_encode then return -1 end
        return base
      end
      local raw = transfer_mod.encode_message(closure)
      defer transfer_mod.discard_message(raw)
      test.assert(first_val == 900 and second_val == 800)
      test.assert(#transfer_hook_log == 2 and
                  transfer_hook_log[1] == "enc:capture-first" and
                  transfer_hook_log[2] == "enc:capture-second",
                  "packet closure encode did not project captures before hooks or called hooks twice")
      local restored: function (): integer = transfer_mod.decode_message(raw)
      test.assert(restored() == 30,
                  "packet closure encode observed post-hook mutated capture cells")
      test.assert(#transfer_hook_log == 3 and transfer_hook_log[3] == "dec:capture-second")
    end)
end

record TransferPayloadClaimProbe
  local mode: string
  local custom_bytes: string
end

function TransferPayloadClaimProbe:to_transfer_payload(): string
  local tx, rx = transfer_thread.channel<|integer|>(1)
  nested_scope_peer_rxs[#nested_scope_peer_rxs + 1] = rx
  local idx = tx:to_transfer_payload()
  test.assert(idx == "\0\0\0\0")
  return self.mode
end

function TransferPayloadClaimProbe.from_transfer_payload(
    payload: string): TransferPayloadClaimProbe
  if payload == "width-empty" then
    transfer_thread.Sender<|integer|>.from_transfer_payload("")
  elseif payload == "width-short" then
    transfer_thread.Sender<|integer|>.from_transfer_payload("abc")
  elseif payload == "width-long" then
    transfer_thread.Sender<|integer|>.from_transfer_payload("12345678")
  elseif payload == "bounds-invalid-sentinel" then
    transfer_thread.Sender<|integer|>.from_transfer_payload("\255\255\255\255")
  elseif payload == "bounds-out-of-range" then
    transfer_thread.Sender<|integer|>.from_transfer_payload("\1\0\0\0")
  elseif payload == "kind-mismatch-receiver" then
    transfer_thread.Receiver<|integer|>.from_transfer_payload("\0\0\0\0")
  elseif payload == "kind-mismatch-null-release" then
    local null_release: foreign function(*void): void = nil
    transfer_mod.claim_resource("\0\0\0\0", null_release)
  elseif payload == "kind-mismatch-other-release" then
    transfer_mod.claim_resource("\0\0\0\0", test_resource_other_release)
  elseif payload == "repeated-claim" then
    local first = transfer_thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
    transfer_hook_saved_sender = first
    local _second = transfer_thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
  end
  return { mode = payload, custom_bytes = "" }
end


local function encode_claim_probe_raw(mode: string): foreign *void
  return transfer_mod.encode_message(TransferPayloadClaimProbe(mode, ""))
end

function test_transfer_resource_validation_and_claim_errors(context: test.Context)
  context:run("no-active-scope-and-invalid-attach", function (_context: test.Context)

    local tx, rx = transfer_thread.channel<|integer|>(1)
    defer tx:close()
    defer rx:close()
    transfer_payload_raises(function ()
      tx:to_transfer_payload()
    end, "Sender:to_transfer_payload succeeded outside encode scope")
    transfer_payload_raises(function ()
      rx:to_transfer_payload()
    end, "Receiver:to_transfer_payload succeeded outside encode scope")
    transfer_payload_raises(function ()
      transfer_thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
    end, "Sender.from_transfer_payload succeeded outside decode scope")
    transfer_payload_raises(function ()
      transfer_thread.Receiver<|integer|>.from_transfer_payload("\0\0\0\0")
    end, "Receiver.from_transfer_payload succeeded outside decode scope")
    transfer_payload_raises(function ()
      async.TransferValue.from_value(tx)
    end, "TransferValue.from_value accepted an endpoint outside packet encode")

  end)

  context:run("index-width-bounds-kind-and-repeated-claim", function (_context: test.Context)
    reset_transfer_hook_state()
    nested_scope_peer_rxs = {}
    defer do
      for i = 1, #nested_scope_peer_rxs do nested_scope_peer_rxs[i]:close() end
      nested_scope_peer_rxs = {}
      reset_transfer_hook_state()
    end
    local modes = {
      "width-empty",
      "width-short",
      "width-long",
      "bounds-invalid-sentinel",
      "bounds-out-of-range",
      "kind-mismatch-receiver",
      "kind-mismatch-null-release",
      "kind-mismatch-other-release",
    }
    for i = 1, #modes do
      local mode = modes[i]
      local raw = encode_claim_probe_raw(mode)
      defer transfer_mod.discard_message(raw)
      local peer_rx = nested_scope_peer_rxs[#nested_scope_peer_rxs]
      support.collect_garbage()
      support.collect_garbage()
      test.assert(not peer_rx:is_closed())
      local caught = false
      do
        transfer_mod.decode_message(raw)
      catch
        caught = true
      end
      test.assert(caught, "invalid claim mode succeeded: " .. mode)
      test.assert(peer_rx:is_closed(),
                  "failed claim (" .. mode .. ") did not release unclaimed slot 0 on unwind")
    end

    -- Repeated claim of slot 0 raises on second claim without double-releasing the first.
    local rep_raw = encode_claim_probe_raw("repeated-claim")
    defer transfer_mod.discard_message(rep_raw)
    local rep_rx = nested_scope_peer_rxs[#nested_scope_peer_rxs]
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rep_rx:is_closed())
    local caught_repeat = false
    do
      transfer_mod.decode_message(rep_raw)
    catch
      caught_repeat = true
    end
    test.assert(caught_repeat, "repeated claim of slot 0 succeeded")
    -- First claim succeeded and stored its wrapper in transfer_hook_saved_sender;
    -- packet unwind must NOT release an already-claimed slot.
    support.collect_garbage()
    support.collect_garbage()
    local ok, val? = transfer_drain_saved_sender(rep_rx, 444,
        "repeated claim unwind released the first valid claimant")
    test.assert(ok and val == 444)
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rep_rx:is_closed(), "adopted Sender was not released after finalizer")
  end)
end

local function make_recursive_receiver_raw(): (
    foreign *void,
    transfer_thread.Receiver<|integer|>,
    transfer_thread.Receiver<|integer|>)
  local tx_b, rx_b = transfer_thread.channel<|integer|>(1)
  local tx_c, rx_c = transfer_thread.channel<|integer|>(1)
  local tx_a, rx_a = transfer_thread.channel<|transfer_thread.Sender<|integer|>|>(2)
  test.assert(tx_a:try_send(tx_b))
  tx_a:close()
  local raw = transfer_mod.encode_message(
    TransferPayloadForbiddenDecode(tx_c, rx_a))
  return raw, rx_b, rx_c
end

local foreign function transfer_count_module_load(state: *lua_State): int
  local count = ffi.lua_touserdata(state, 1) as *int
  count[0] = count[0] + 1
  return 0
end

function test_transfer_discard_skips_decoders_and_module_loaders(context: test.Context)
  context:run("no-runtime-and-post-runtime-recursive-discard", function (_context: test.Context)
    local decoder_calls_before = transfer_forbidden_decode_calls
    -- 1. Outside any Runtime (before runtime_test.run): discard_message recursively drains.
    local raw1, rx1_b, rx1_c = make_recursive_receiver_raw()
    defer transfer_mod.discard_message(raw1)
    defer rx1_b:close()
    defer rx1_c:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx1_b:is_closed() and not rx1_c:is_closed())
    transfer_mod.discard_message(raw1)
    raw1 = nil
    transfer_mod.discard_message(nil)
    test.assert(rx1_b:is_closed() and rx1_c:is_closed(),
                "discard_message outside Runtime did not recursively drain and release endpoints")

    -- 2. Created inside an active Runtime, then discarded after Runtime shutdown.
    local post_slot: foreign *TransferMessageSlot = foreign TransferMessageSlot.new_array(1)
    defer do
      transfer_mod.discard_message(post_slot[0])
      post_slot[0] = nil
    end
    local post_rx_b: (transfer_thread.Receiver<|integer|>)? = nil
    local post_rx_c: (transfer_thread.Receiver<|integer|>)? = nil
    runtime_test.run(function ()
      local raw_p, rb, rc = make_recursive_receiver_raw()
      post_slot[0] = raw_p
      post_rx_b = rb
      post_rx_c = rc
    end)
    local rb_after = post_rx_b as transfer_thread.Receiver<|integer|>
    local rc_after = post_rx_c as transfer_thread.Receiver<|integer|>
    defer rb_after:close()
    defer rc_after:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rb_after:is_closed() and not rc_after:is_closed())
    transfer_mod.discard_message(post_slot[0])
    post_slot[0] = nil
    test.assert(rb_after:is_closed() and rc_after:is_closed(),
                "discard_message after Runtime shutdown failed to release endpoints")
    test.assert(transfer_forbidden_decode_calls == decoder_calls_before,
                "runtime-free or post-shutdown discard entered a user decoder")
  end)

  context:run("zero-decoder-calls-across-all-packet-kinds", function (_context: test.Context)
    reset_transfer_hook_state()
    -- 1. Root custom hook record payload
    local raw1, rx1_b, rx1_c = make_recursive_receiver_raw()
    defer transfer_mod.discard_message(raw1)
    defer rx1_b:close()
    defer rx1_c:close()
    -- 2. Structural record containing custom hook record
    local raw2, rx2 = (function (): (foreign *void, transfer_thread.Receiver<|integer|>)
      local tx, rx = transfer_thread.channel<|integer|>(1)
      local env = TransferPayloadForbiddenEnvelope(TransferPayloadForbiddenDecode(tx, nil))
      return transfer_mod.encode_message(env), rx
    end)()
    defer transfer_mod.discard_message(raw2)
    defer rx2:close()
    -- 3. Structural union containing custom hook record
    local raw3, rx3 = (function (): (foreign *void, transfer_thread.Receiver<|integer|>)
      local tx, rx = transfer_thread.channel<|integer|>(1)
      local u = TransferPayloadForbiddenUnion.item(TransferPayloadForbiddenDecode(tx, nil))
      return transfer_mod.encode_message(u), rx
    end)()
    defer transfer_mod.discard_message(raw3)
    defer rx3:close()
    -- 4. Closure capturing custom hook record
    local raw4, rx4 = (function (): (foreign *void, transfer_thread.Receiver<|integer|>)
      local tx, rx = transfer_thread.channel<|integer|>(1)
      local item = TransferPayloadForbiddenDecode(tx, nil)
      return transfer_mod.encode_message(function (): value return item end), rx
    end)()
    defer transfer_mod.discard_message(raw4)
    defer rx4:close()

    support.collect_garbage()
    support.collect_garbage()
    transfer_mod.discard_message(raw1)
    raw1 = nil
    transfer_mod.discard_message(raw2)
    raw2 = nil
    transfer_mod.discard_message(raw3)
    raw3 = nil
    transfer_mod.discard_message(raw4)
    raw4 = nil
    test.assert(transfer_forbidden_decode_calls == 0,
                "discard invoked a user from_transfer_payload decoder")
    test.assert(rx1_b:is_closed() and rx1_c:is_closed() and
                rx2:is_closed() and rx3:is_closed() and rx4:is_closed(),
                "native discard failed to release endpoints across packet kinds")
  end)

  context:run("unavailable-nominal-module-and-zero-preload-calls-on-discard",
    function (_context: test.Context)
      reset_transfer_hook_state()
      local raw, rx_b, rx_c = make_recursive_receiver_raw()
      defer rx_b:close()
      defer rx_c:close()
      local slot: foreign *TransferMessageSlot = foreign TransferMessageSlot.new_array(1)
      defer do
        transfer_mod.discard_message(slot[0])
        slot[0] = nil
      end
      slot[0] = raw
      support.collect_garbage()
      support.collect_garbage()
      local state = transfer_lua.new()
      defer state:close()
      local loader_calls: owned int[] = foreign int.new_array(1)
      -- Remove async.tests from package.preload and install a trap on any remaining preload lookup.
      state:run([[
        local slot, counter, count_loader, discard = ...
        local transfer = require('titan.transfer')
        package.loaded['async.tests'] = nil
        package.preload['async.tests'] = function()
          count_loader(counter)
          error('discard must never invoke module preload loader')
        end
        discard(slot)
        package.preload['async.tests'] = nil
      ]], "=discard-without-module", async.TransferValue.is_pointer(slot as foreign *void),
        async.TransferValue.is_pointer(loader_calls as foreign *void),
        async.TransferValue.is_function(transfer_count_module_load),
        async.TransferValue.is_function(transfer_discard_slot_lua))
      test.assert(slot[0] == nil)
      test.assert(loader_calls[0] == 0,
                  "native discard called a nominal module loader")
      test.assert(transfer_forbidden_decode_calls == 0)
      test.assert(rx_b:is_closed() and rx_c:is_closed(),
                  "discard required nominal module initialization to reclaim endpoints")

      -- Also verify that when decode IS attempted in a state where the module loader
      -- is missing or throws, decode_message unwinds and still releases all attachments.
      local raw_missing, rx_m_b, rx_m_c = make_recursive_receiver_raw()
      defer rx_m_b:close()
      defer rx_m_c:close()
      local missing_slot: foreign *TransferMessageSlot = foreign TransferMessageSlot.new_array(1)
      defer do
        transfer_mod.discard_message(missing_slot[0])
        missing_slot[0] = nil
      end
      missing_slot[0] = raw_missing
      support.collect_garbage()
      support.collect_garbage()
      transfer_payload_raises(function ()
        state:run([[
          local slot = ...
          local support = require('async.test_support')
          return support.decode_raw_slot(slot, 0)
        ]], "=decode-missing-preload",
          async.TransferValue.is_pointer(missing_slot as foreign *void))
      end, "decode unexpectedly succeeded without its nominal module")
      test.assert(missing_slot[0] == nil,
                  "failed raw decode did not consume its caller's slot")
      test.assert(rx_m_b:is_closed() and rx_m_c:is_closed(),
                  "module-load failure during decode leaked attached endpoints")
    end)
end

record TransferPayloadAttachOomProbe
  local ptr: foreign *void
  local ctrl: foreign *size_t
end

function TransferPayloadAttachOomProbe:to_transfer_payload(): string
  -- This probe runs only in a freshly initialized independent Lua state.
  -- Its first slot-6 index is not shared with earlier aggregate cases.
  -- Fail string allocation after attach_reserved has retained that entry.
  for _ = 1, 6 do
    transfer_mod.attach_resource(self.ptr, test_resource_retain, test_resource_release)
  end
  self.ctrl[0] = 1 as foreign size_t
  self.ctrl[1] = 1 as foreign size_t
  self.ctrl[2] = 0 as foreign size_t
  return transfer_mod.attach_resource(self.ptr, test_resource_retain, test_resource_release)
end

function TransferPayloadAttachOomProbe.from_transfer_payload(
    _payload: string): TransferPayloadAttachOomProbe
  return { ptr = nil, ctrl = nil }
end

-- Public only so the fresh-state native preload can call it. This is test
-- infrastructure, not a production allocation hook or a discovered test.
function transfer_attach_string_oom_isolated(): integer
  local counter: owned int[] = foreign int.new_array(1)
  counter[0] = 1
  local ctrl: owned size_t[] = foreign size_t.new_array(3)
  local previous_data: foreign *void = nil
  local previous = ffi.lua_getallocf(L, previous_data)
  ffi.lua_setallocf(L, transfer_limited_lua_alloc, ctrl as foreign *void)
  local caught = false
  do
    local raw = transfer_mod.encode_message(
      TransferPayloadAttachOomProbe(counter as foreign *void, ctrl))
    defer transfer_mod.discard_message(raw)
  catch
    caught = true
  end
  ffi.lua_setallocf(L, previous, previous_data)
  test.assert(caught and ctrl[2] >= (2 as foreign size_t),
              "attach_resource post-retain string OOM did not trigger")
  test.assert(counter[0] == 1,
              "attach_resource post-retain string OOM leaked retained resource")
  return 1
end

function test_transfer_resource_allocation_and_finalizer_failures(context: test.Context)
  context:run("attach-resource-post-retain-string-oom", function (_context: test.Context)
    local state = transfer_lua.new()
    defer state:close()
    local receipt = state:run([[
      return require('async.tests').transfer_attach_string_oom_isolated()
    ]], "=isolated-attachment-string-oom")
    case receipt
    when is_integer(number) then test.assert(number == 1)
    else raise "isolated attachment string OOM omitted its receipt"
    end
  end)

  context:run("decode-large-payload-copy-oom-releases-endpoints", function (_context: test.Context)
    local make_large = function (): (
        foreign *void,
        transfer_thread.Receiver<|integer|>,
        transfer_thread.Receiver<|integer|>)
      local tx1, rx1 = transfer_thread.channel<|integer|>(1)
      local tx2, rx2 = transfer_thread.channel<|integer|>(1)
      local big = receiver_string.rep("payload-oom-bytes-", 4096)
      local item = TransferPayloadLargeAndSender(tx1, big, tx2)
      return transfer_mod.encode_message(item), rx1, rx2
    end
    local raw, rx1, rx2 = make_large()
    defer transfer_mod.discard_message(raw)
    defer rx1:close()
    defer rx2:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and not rx2:is_closed())

    local ctrl: owned size_t[] = foreign size_t.new_array(3)
    ctrl[0] = 2 as foreign size_t
    ctrl[1] = 32768 as foreign size_t
    ctrl[2] = 0 as foreign size_t
    local prev_ud: foreign *void = nil
    local prev_alloc = ffi.lua_getallocf(L, prev_ud)
    ffi.lua_setallocf(L, transfer_limited_lua_alloc, ctrl as foreign *void)
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = true
    end
    ffi.lua_setallocf(L, prev_alloc, prev_ud)
    test.assert(caught and ctrl[2] >= (2 as foreign size_t),
                "large payload decode OOM did not trigger")
    test.assert(rx2:is_closed(),
                "unclaimed second Sender was not released on payload OOM")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx1:is_closed(),
                "first Sender before OOM field was not released after GC")
  end)
end

-- Workstream 4: demand-driven function classification, single structural root
-- inspection, and direct scalar packet path.

local function transfer_shared_sig_add(a: integer, b: integer): integer
  return a + b
end

local function transfer_shared_sig_mul(a: integer, b: integer): integer
  return a * b
end

function transfer_generic_echo<|T|>(item: T): T
  return item
end

local function transfer_without_typedef(
    descriptor: transfer_reflect.Type): transfer_reflect.Type
  local result = descriptor
  for _ = 1, 16 do
    case result
    when is_foreign_typedef{target_descriptor} then result = target_descriptor
    when is_foreign_named(named) then result = named:resolve()
    else return result
    end
  end
  return result
end

local function transfer_foreign_origin_signature(
    pair: owned *div_t): foreign int
  return pair.quot
end

local function make_closure_8_captures(base: integer): function (integer): integer
  local c1 = base + 1
  local c2 = base + 2
  local c3 = base + 3
  local c4 = base + 4
  local c5 = base + 5
  local c6 = base + 6
  local c7 = base + 7
  local c8 = base + 8
  return function (x: integer): integer
    c1 = c1 + x
    return c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8
  end
end

local function make_closure_64_captures(base: integer): function (): integer
  local v1, v2, v3, v4, v5, v6, v7, v8 =
    base + 1, base + 2, base + 3, base + 4, base + 5, base + 6, base + 7, base + 8
  local v9, v10, v11, v12, v13, v14, v15, v16 =
    base + 9, base + 10, base + 11, base + 12, base + 13, base + 14, base + 15, base + 16
  local v17, v18, v19, v20, v21, v22, v23, v24 =
    base + 17, base + 18, base + 19, base + 20, base + 21, base + 22, base + 23, base + 24
  local v25, v26, v27, v28, v29, v30, v31, v32 =
    base + 25, base + 26, base + 27, base + 28, base + 29, base + 30, base + 31, base + 32
  local v33, v34, v35, v36, v37, v38, v39, v40 =
    base + 33, base + 34, base + 35, base + 36, base + 37, base + 38, base + 39, base + 40
  local v41, v42, v43, v44, v45, v46, v47, v48 =
    base + 41, base + 42, base + 43, base + 44, base + 45, base + 46, base + 47, base + 48
  local v49, v50, v51, v52, v53, v54, v55, v56 =
    base + 49, base + 50, base + 51, base + 52, base + 53, base + 54, base + 55, base + 56
  local v57, v58, v59, v60, v61, v62, v63, v64 =
    base + 57, base + 58, base + 59, base + 60, base + 61, base + 62, base + 63, base + 64
  return function (): integer
    v1 = v1 + 100
    v64 = v64 + 200
    -- Keep all 64 captures without deeply nested C macro expansions.
    local sum1 = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8
    local sum2 = v9 + v10 + v11 + v12 + v13 + v14 + v15 + v16
    local sum3 = v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24
    local sum4 = v25 + v26 + v27 + v28 + v29 + v30 + v31 + v32
    local sum5 = v33 + v34 + v35 + v36 + v37 + v38 + v39 + v40
    local sum6 = v41 + v42 + v43 + v44 + v45 + v46 + v47 + v48
    local sum7 = v49 + v50 + v51 + v52 + v53 + v54 + v55 + v56
    local sum8 = v57 + v58 + v59 + v60 + v61 + v62 + v63 + v64
    return sum1 + sum2 + sum3 + sum4 + sum5 + sum6 + sum7 + sum8
  end
end

record TransferPayloadReflectInHook
  local value: integer
end

function TransferPayloadReflectInHook:to_transfer_payload(): string
  case transfer_reflect.inspect(transfer_shared_sig_add)
  when is_titan_function{tf_type = type} then
    test.assert(#tf_type.param_descriptors == 2 and #tf_type.return_descriptors == 1)
  else raise "reflect.inspect inside to_transfer_payload failed"
  end
  return transfer_protobuf.serialize_fields({transfer_reflect.Type.is_integer()}, self.value)
end

function TransferPayloadReflectInHook.from_transfer_payload(
    payload: string): TransferPayloadReflectInHook
  case transfer_reflect.inspect(transfer_shared_sig_mul)
  when is_titan_function{tf_type = type} then
    test.assert(#tf_type.param_descriptors == 2 and #tf_type.return_descriptors == 1)
  else raise "reflect.inspect inside from_transfer_payload failed"
  end
  local v: integer = transfer_protobuf.deserialize_fields(
    payload, {transfer_reflect.Type.is_integer()})
  return { value = v }
end


function test_transfer_closure_avoids_signature_hydration_while_reflection_stays_eager(
    context: test.Context)
  context:run("captures-0-1-8-64-adjusted-shared-sig-generic-foreign-and-source-close",
    function (_context: test.Context)
      -- 0, 1, 8, and 64 captures through both TransferValue and encode_message/decode_message.
      local c0 = transfer_shared_sig_add
      local c0_dec: function (integer, integer): integer =
        transfer_roundtrip_value(c0)
      local c0_mul: function (integer, integer): integer =
        transfer_roundtrip_value(transfer_shared_sig_mul)
      test.assert(c0_dec(6, 7) == 13 and c0_mul(6, 7) == 42,
                  "distinct functions sharing a signature collided during transfer")

      local cell1 = 10
      local c1 = function (x: integer): integer
        cell1 = cell1 + x
        return cell1
      end
      local c1_pkt: function (integer): integer = transfer_roundtrip_value(c1)
      local c1_pol: function (integer): integer = async.TransferValue.from_value(c1):to_value()
      test.assert(c1_pkt(5) == 15 and c1_pol(5) == 15 and c1(1) == 11)

      local c8 = make_closure_8_captures(10)
      local c8_pkt: function (integer): integer = transfer_roundtrip_value(c8)
      local c8_pol: function (integer): integer = async.TransferValue.from_value(c8):to_value()
      -- Sum of (11..18) = 116; + 4 = 120.
      test.assert(c8_pkt(4) == 120 and c8_pol(4) == 120 and c8(0) == 116)

      local c64 = make_closure_64_captures(0)
      local c64_pkt: function (): integer = transfer_roundtrip_value(c64)
      local c64_pol: function (): integer = async.TransferValue.from_value(c64):to_value()
      -- Sum of 1..64 = 2080; + 100 + 200 = 2380.
      test.assert(c64_pkt() == 2380 and c64_pol() == 2380 and c64() == 2380)

      -- Adjusted closure, raw vs pre-converted policy capture, generic erasure,
      -- and foreign declaration-origin signature preservation.
      local adj_count = 20
      local adj_base = function (n: integer): integer
        adj_count = adj_count + n
        return adj_count
      end
      local adjusted: function (integer, string): (value, value) = adj_base
      local raw_cap = function (): integer return 31 end
      local policy_cap = async.TransferValue.from_value(function (): integer return 37 end)
      local raw_vs_policy = function (): integer
        case policy_cap
        when is_closure(_m, _e, _d) then
          local fn: function (): integer = policy_cap:to_value()
          return raw_cap() + fn()
        else raise "pre-converted closure policy was unwrapped during capture transfer"
        end
      end
      local hooked_reflect: TransferPayloadReflectInHook =
        transfer_roundtrip_value(TransferPayloadReflectInHook(77))
      test.assert(hooked_reflect.value == 77)

      local gen_fn = transfer_generic_echo
      local gen_restored: function (value): value =
        transfer_roundtrip_value(gen_fn)
      test.assert(gen_restored("erased-ok") as string == "erased-ok")
      case transfer_reflect.inspect(gen_restored)
      when is_titan_function{tf_type = type} then
        case tf_type.param_descriptors[1]
        when is_value() then
        else raise "generic function parameter lost erased value descriptor"
        end
      else raise "expected reflected generic Titan function"
      end

      local foreign_fn = transfer_foreign_origin_signature
      local foreign_restored: function (owned *div_t): foreign int =
        transfer_roundtrip_value(foreign_fn)
      local div_owner: owned *div_t = foreign div_t.new()
      div_owner.quot = 29
      div_owner.rem = 3
      test.assert(foreign_restored(div_owner) == (29 as foreign int))
      case transfer_reflect.inspect(foreign_restored)
      when is_titan_function{tf_type = type} then
        case tf_type.param_descriptors[1]
        when is_owned_foreign_pointer(owned_desc) then
          case transfer_without_typedef(owned_desc.pointee_descriptor)
          when is_foreign_struct(st) then
            test.assert(#st.fields == 2)
          else raise "foreign declaration origin did not resolve to div_t struct"
          end
        else raise "expected owned foreign pointer parameter descriptor"
        end
      else raise "expected reflected foreign-signature Titan function"
      end

      -- Cross-state closure transfer surviving source-state close.
      local state = transfer_lua.new()
      defer state:close()
      local adj_carrier, rvp_carrier, c64_carrier = state:run([[
        local adj, rvp, c64 = ...
        return adj, rvp, c64
      ]], "=closure-source-close",
        async.TransferValue.from_value(adjusted),
        async.TransferValue.from_value(raw_vs_policy),
        async.TransferValue.from_value(c64))
      state:close()
      support.collect_garbage()
      support.collect_garbage()
      local adj_after: function (integer, string): (value, value) =
        transfer_roundtrip_value(adj_carrier)
      local r1, r2 = adj_after(7, "extra")
      test.assert(r1 as integer == 27 and r2 == nil and adj_count == 20)
      local rvp_after: function (): integer =
        transfer_roundtrip_value(rvp_carrier)
      test.assert(rvp_after() == 68)
      local c64_after: function (): integer =
        transfer_roundtrip_value(c64_carrier)
      test.assert(c64_after() == 2680)
    end)
end



local function transfer_native_oom_case(context: test.Context, workspace: string,
                                      scenario: string)
  context:run(scenario, function (_context: test.Context)
    local output, why, code = transfer_command.capture({
      transfer_command.program(workspace, "transfer_alloc_fault_app"), scenario,
    }, workspace)
    test.assert(why == "exit" and code == 0,
                "native transfer allocation fixture failed at " .. scenario .. ": " .. output)
    test.assert(output == "TRANSFER_NATIVE_OOM_OK\n",
                "native transfer allocation fixture omitted its ownership receipt")
  end)
end

function test_transfer_native_allocation_failures_rollback_resources(
    context: test.Context)
  if transfer_common.is_windows() then
    test.skip("platform: native allocation wrapping requires Linux static archive linkage")
  end
  local host, host_why, host_code = transfer_command.capture({"uname", "-s"})
  test.assert(host_why == "exit" and host_code == 0, host)
  if host ~= "Linux\n" then
    test.skip("platform: native allocation wrapping requires Linux static archive linkage")
  end
  local workspace = ""
  runtime_test.run(function ()
    workspace = transfer_fs.tmpname()
    transfer_fs.unlink(workspace)
    transfer_fs.mkdir(workspace)
    context:cleanup(function () transfer_command.remove_tree(workspace) end)
    transfer_fs.write_file(workspace .. "/transfer_alloc_fault_api.h",
      transfer_fs.read_file("spec/fixtures/stdlib/native/transfer_alloc_fault_api.h"))
    transfer_fs.write_file(workspace .. "/transfer_alloc_fault_app.titan",
      transfer_fs.read_file("spec/fixtures/stdlib/titan/transfer_alloc_fault_app.titan"))
    local flags = transfer_os.getenv("TITAN_EXTRA_LDFLAGS") or ""
    flags = flags .. " -Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=lua_setmetatable"
    local output, why, code = transfer_command.compile(workspace,
      "transfer_alloc_fault_app",
      {"--no-uv-bootstrap", "-X", transfer_command.fixture_object("transfer_alloc_fault")},
      true, {["TITAN_EXTRA_LDFLAGS"] = flags})
    test.assert(why == "exit" and code == 0,
                "could not compile unchanged-provider native allocation child: " .. output)
  end)
  transfer_native_oom_case(context, workspace, "reserve-initial")
  transfer_native_oom_case(context, workspace, "reserve-growth")
  transfer_native_oom_case(context, workspace, "payload-copy")
  transfer_native_oom_case(context, workspace, "buffer-initial")
  transfer_native_oom_case(context, workspace, "buffer-growth")
  transfer_native_oom_case(context, workspace, "scalar-copy")
  transfer_native_oom_case(context, workspace, "policy-copy")
  transfer_native_oom_case(context, workspace, "sender-finalizer")
  transfer_native_oom_case(context, workspace, "receiver-finalizer")
  transfer_native_oom_case(context, workspace, "sender-finalizer-direct")
  transfer_native_oom_case(context, workspace, "receiver-finalizer-direct")
end

local function check_raw_child_has_no_transfer_authority(
    sender: transfer_thread.Sender<|integer|>, parent_index: string)
  local child = transfer_coroutine.create(function (_: value): value
    transfer_payload_raises(function () sender:to_transfer_payload() end,
      "raw child coroutine inherited parent encode authority")
    transfer_payload_raises(function ()
      transfer_thread.Sender<|integer|>.from_transfer_payload(parent_index)
    end, "raw child coroutine inherited parent decode authority")

    -- A child may open its own packet scope, but leaving either its successful
    -- or failed operation must restore the child's absent top, not the parent.
    local own_sender: transfer_thread.Sender<|integer|> = transfer_roundtrip_value(sender)
    test.assert(not own_sender:is_closed())
    transfer_payload_raises(function () own_sender:to_transfer_payload() end,
      "child packet completion retained an encode scope")
    transfer_payload_raises(function ()
      transfer_roundtrip_value(TransferPayloadManySenders(
        {sender}, TransferPayloadHookStep("raw-child-encode", true, false)))
    end, "child failing encoder unexpectedly succeeded")
    transfer_payload_raises(function () sender:to_transfer_payload() end,
      "failed child encoder did not restore the child's absent scope")

    local failing_raw = transfer_mod.encode_message(TransferPayloadSenderComposite(
      TransferPayloadHookStep("raw-child-decode", false, true), sender,
      TransferPayloadHookStep("middle", false, false), sender,
      TransferPayloadHookStep("after", false, false)))
    defer transfer_mod.discard_message(failing_raw)
    local caught = false
    do
      transfer_mod.decode_message(failing_raw)
    catch
      caught = error is string and support.contains(error, "hook-decode-boom:raw-child-decode")
    end
    test.assert(caught, "missing transfer error containing: hook-decode-boom:raw-child-decode")
    transfer_payload_raises(function ()
      transfer_thread.Sender<|integer|>.from_transfer_payload(parent_index)
    end, "failed child decoder restored the parent's scope into the child")
    return "child-finished"
  end, "transfer-synchronous-child")
  test.assert(child:resume(nil) == "child-finished" and child:status() == "dead",
              "synchronous child packet operations did not complete")
end

record TransferPayloadSynchronousChildScope
  local sender: (transfer_thread.Sender<|integer|>)?
end

function TransferPayloadSynchronousChildScope:to_transfer_payload(): string
  local first = self.sender:to_transfer_payload()
  check_raw_child_has_no_transfer_authority(self.sender, first)
  local second = self.sender:to_transfer_payload()
  test.assert(first == "\0\0\0\0" and second == "\1\0\0\0",
              "raw child operations changed the parent encode packet")
  return first .. second
end

function TransferPayloadSynchronousChildScope.from_transfer_payload(
    payload: string): TransferPayloadSynchronousChildScope
  local first = transfer_thread.Sender<|integer|>.from_transfer_payload(
    receiver_string.sub(payload, 1, 4))
  check_raw_child_has_no_transfer_authority(first, receiver_string.sub(payload, 5, 8))
  local second = transfer_thread.Sender<|integer|>.from_transfer_payload(
    receiver_string.sub(payload, 5, 8))
  test.assert(first:try_send(711) and second:try_send(712),
              "raw child operations changed the parent decode packet")
  return { sender = second }
end

function test_transfer_synchronous_hooks_isolate_raw_child_scope_authority(
    _context: test.Context)
  local make_raw = function (): (foreign *void, transfer_thread.Receiver<|integer|>)
    local tx, rx = transfer_thread.channel<|integer|>(4)
    return transfer_mod.encode_message(TransferPayloadSynchronousChildScope(tx)), rx
  end
  local raw, peer = make_raw()
  defer transfer_mod.discard_message(raw)
  defer peer:close()
  local decoded: TransferPayloadSynchronousChildScope = transfer_mod.decode_message(raw)
  local first_ok, first? = peer:try_receive()
  local second_ok, second? = peer:try_receive()
  test.assert(first_ok and first == 711 and second_ok and second == 712)
  test.assert(decoded.sender:try_send(713))
  local final_ok, final? = peer:try_receive()
  test.assert(final_ok and final == 713)
end

-- Deliberately violate the synchronous hook contract to test native ownership
-- isolation when an execution stack is abandoned. This is fault injection,
-- not a supported yielding-hook protocol, and no paused hook is resumed.
record TransferPayloadAbandonedScopeFault
  local sender: (transfer_thread.Sender<|integer|>)?
  local phase: string
end

function TransferPayloadAbandonedScopeFault:to_transfer_payload(): string
  local index = self.sender:to_transfer_payload()
  if self.phase == "encode" then
    transfer_coroutine.yield("unfinished-encode", "transfer-abandoned-scope-fault")
  end
  return index .. self.phase
end

function TransferPayloadAbandonedScopeFault.from_transfer_payload(
    payload: string): TransferPayloadAbandonedScopeFault
  local phase = receiver_string.sub(payload, 5)
  if phase == "decode" then
    transfer_coroutine.yield("unfinished-decode", "transfer-abandoned-scope-fault")
  end
  local adopted = transfer_thread.Sender<|integer|>.from_transfer_payload(
    receiver_string.sub(payload, 1, 4))
  return { sender = adopted, phase = phase }
end

local function abandon_transfer_scope_fault(phase: string): transfer_thread.Receiver<|integer|>
  local tx, rx = transfer_thread.channel<|integer|>(1)
  if phase == "encode" then
    local encoder = transfer_coroutine.create(function (_: value): value
      local raw = transfer_mod.encode_message(TransferPayloadAbandonedScopeFault(tx, phase))
      transfer_mod.discard_message(raw)
      return nil
    end, "transfer-abandoned-scope-fault")
    test.assert(encoder:resume(nil) == "unfinished-encode")
    test.assert(encoder:status() == "suspended")
  else
    local slot: foreign *TransferMessageSlot = foreign TransferMessageSlot.new_array(1)
    defer do
      transfer_mod.discard_message(slot[0])
      slot[0] = nil
    end
    slot[0] = transfer_mod.encode_message(TransferPayloadAbandonedScopeFault(tx, phase))
    local decoder = transfer_coroutine.create(function (_: value): value
      return transfer_mod.decode_message(slot)
    end, "transfer-abandoned-scope-fault")
    test.assert(decoder:resume(nil) == "unfinished-decode")
    test.assert(decoder:status() == "suspended")
    test.assert(slot[0] == nil, "decode scope did not move the packet out of the caller slot")
  end
  test.assert(not rx:is_closed(), "fault injection failed to retain the unfinished packet")
  transfer_payload_raises(function () tx:to_transfer_payload() end,
    "paused fault stack authorized an unrelated encoder")
  transfer_payload_raises(function ()
    transfer_thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
  end, "paused fault stack authorized an unrelated decoder")
  local independent = transfer_mod.encode_message(tx)
  transfer_mod.discard_message(independent)
  return rx
end

function test_transfer_abandoned_scope_fault_reclaims_native_ownership(
    context: test.Context)
  context:run("unfinished-encode", function (_context: test.Context)
    local peer = abandon_transfer_scope_fault("encode")
    defer peer:close()
    transfer_gc.collect()
    transfer_gc.collect()
    test.assert(peer:is_closed(), "abandoned encode scope stranded a native retain")
    transfer_payload_raises(function ()
      transfer_thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
    end, "abandoned encoder authorized an unrelated execution")
  end)
  context:run("unfinished-decode", function (_context: test.Context)
    local peer = abandon_transfer_scope_fault("decode")
    defer peer:close()
    transfer_gc.collect()
    transfer_gc.collect()
    test.assert(peer:is_closed(), "abandoned decode scope stranded its packet")
    local tx, rx = transfer_thread.channel<|integer|>(1)
    defer rx:close()
    transfer_payload_raises(function () tx:to_transfer_payload() end,
      "abandoned decoder authorized an unrelated execution")
  end)
end

local transfer_adoption_oom_ctrl: foreign *size_t = nil

record TransferPayloadAdoptionOom
  local sender: (transfer_thread.Sender<|integer|>)?
  local receiver: (transfer_thread.Receiver<|integer|>)?
end

function TransferPayloadAdoptionOom:to_transfer_payload(): string
  if self.sender ~= nil then return "S" .. self.sender:to_transfer_payload() end
  return "R" .. self.receiver:to_transfer_payload()
end

function TransferPayloadAdoptionOom.from_transfer_payload(
    payload: string): TransferPayloadAdoptionOom
  local index = receiver_string.sub(payload, 2)
  local sender_kind = receiver_string.sub(payload, 1, 1) == "S"
  -- Scope creation, module resolution, and payload copying have finished.
  -- Arm only at the public endpoint-adoption boundary, before constructing
  -- its inert wrapper/finalizer, rather than counting unrelated decode setup.
  if transfer_adoption_oom_ctrl ~= nil then
    transfer_adoption_oom_ctrl[0] = 1 as foreign size_t
  end
  if sender_kind then
    local sender = transfer_thread.Sender<|integer|>.from_transfer_payload(index)
    return { sender = sender, receiver = nil }
  end
  local receiver = transfer_thread.Receiver<|integer|>.from_transfer_payload(index)
  return { sender = nil, receiver = receiver }
end

local function transfer_adoption_failure_case(
    context: test.Context, kind: string, step: integer)
  context:run(kind .. "-allocation-" .. step, function (_context: test.Context)
    -- Warm both endpoint nominal/finalizer paths before installing the allocator.
    local warm_tx, warm_rx = transfer_thread.channel<|integer|>(1)
    defer warm_tx:close()
    defer warm_rx:close()
    local warm_sender: TransferPayloadAdoptionOom =
      transfer_roundtrip_value(TransferPayloadAdoptionOom(warm_tx, nil))
    local warm_receiver: TransferPayloadAdoptionOom =
      transfer_roundtrip_value(TransferPayloadAdoptionOom(nil, warm_rx))
    test.assert(warm_sender.sender ~= nil and warm_receiver.receiver ~= nil)

    local peer_rx: (transfer_thread.Receiver<|integer|>)? = nil
    local peer_tx: (transfer_thread.Sender<|integer|>)? = nil
    local raw = (function (): foreign *void
      local tx, rx = transfer_thread.channel<|integer|>(1)
      if kind == "sender" then
        peer_rx = rx
        return transfer_mod.encode_message(TransferPayloadAdoptionOom(tx, nil))
      end
      peer_tx = tx
      return transfer_mod.encode_message(TransferPayloadAdoptionOom(nil, rx))
    end)()
    defer transfer_mod.discard_message(raw)
    defer do
      if peer_rx ~= nil then peer_rx:close() end
      if peer_tx ~= nil then peer_tx:close() end
    end
    support.collect_garbage()
    support.collect_garbage()
    if peer_rx ~= nil then test.assert(not peer_rx:is_closed()) end
    if peer_tx ~= nil then test.assert(not peer_tx:is_closed()) end
    local ctrl: owned size_t[] = foreign size_t.new_array(3)
    ctrl[1] = step as foreign size_t
    transfer_adoption_oom_ctrl = ctrl
    defer do transfer_adoption_oom_ctrl = nil end
    local previous_data: foreign *void = nil
    local previous = ffi.lua_getallocf(L, previous_data)
    ffi.lua_setallocf(L, transfer_limited_lua_alloc, ctrl as foreign *void)
    local failed = false
    do
      transfer_mod.decode_message(raw)
    catch
      failed = true
    end
    ffi.lua_setallocf(L, previous, previous_data)
    transfer_adoption_oom_ctrl = nil
    test.assert(failed and ctrl[2] >= (2 as foreign size_t),
                "endpoint preparation did not reach its armed Lua allocation failure")
    support.collect_garbage()
    support.collect_garbage()
    if peer_rx ~= nil then
      test.assert(peer_rx:is_closed(), "failed Sender preparation leaked the packet retain")
    end
    if peer_tx ~= nil then
      test.assert(peer_tx:is_closed(), "failed Receiver preparation leaked the packet retain")
    end
  end)
end

function test_transfer_endpoint_adoption_allocation_failures(
    context: test.Context)
  transfer_adoption_failure_case(context, "sender", 1)
  transfer_adoption_failure_case(context, "sender", 2)
  transfer_adoption_failure_case(context, "receiver", 1)
  transfer_adoption_failure_case(context, "receiver", 2)
end


function test_transfer_decoder_failure_after_last_endpoint(context: test.Context)
  context:run("sender", function (_context: test.Context)
    reset_transfer_hook_state()
    defer reset_transfer_hook_state()
    local raw, peer1, peer2 = encode_sender_composite_raw(false, false, true)
    defer transfer_mod.discard_message(raw)
    defer peer1:close()
    defer peer2:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not peer1:is_closed() and not peer2:is_closed())
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = error is string and support.contains(error, "hook-decode-boom:a")
    end
    test.assert(caught, "missing transfer error containing: hook-decode-boom:a")
    test.assert(#transfer_hook_log == 6 and transfer_hook_log[6] == "dec:a",
                "decoder failed before reaching the post-Sender hook")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(peer1:is_closed() and peer2:is_closed(),
                "post-Sender decoder failure stranded already-adopted owners")
  end)
  context:run("receiver", function (_context: test.Context)
    reset_transfer_hook_state()
    defer reset_transfer_hook_state()
    local raw, peer1, peer2, nested = encode_receiver_composite_raw(false, false, true)
    defer transfer_mod.discard_message(raw)
    defer peer1:close()
    defer peer2:close()
    defer nested:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not peer1:is_closed() and not peer2:is_closed())
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = error is string and support.contains(error, "hook-decode-boom:a")
    end
    test.assert(caught, "missing transfer error containing: hook-decode-boom:a")
    test.assert(#transfer_hook_log == 6 and transfer_hook_log[6] == "dec:a",
                "decoder failed before reaching the post-Receiver hook")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(peer1:is_closed() and peer2:is_closed(),
                "post-Receiver decoder failure stranded already-adopted owners")
  end)
end

record TransferPayloadReceiverClaimFault
  local receiver: (transfer_thread.Receiver<|integer|>)?
  local mode: string
end

function TransferPayloadReceiverClaimFault:to_transfer_payload(): string
  return self.receiver:to_transfer_payload() .. self.mode
end

function TransferPayloadReceiverClaimFault.from_transfer_payload(
    payload: string): TransferPayloadReceiverClaimFault
  local index = receiver_string.sub(payload, 1, 4)
  local mode = receiver_string.sub(payload, 5)
  if mode == "wrong-kind" then
    transfer_thread.Sender<|integer|>.from_transfer_payload(index)
  else
    transfer_hook_saved_receiver =
      transfer_thread.Receiver<|integer|>.from_transfer_payload(index)
    transfer_thread.Receiver<|integer|>.from_transfer_payload(index)
  end
  return { receiver = nil, mode = mode }
end

local function transfer_receiver_claim_case(context: test.Context, mode: string)
  context:run(mode, function (_context: test.Context)
    reset_transfer_hook_state()
    defer reset_transfer_hook_state()
    local raw, peer = (function (): (foreign *void, transfer_thread.Sender<|integer|>)
      local tx, rx = transfer_thread.channel<|integer|>(1)
      return transfer_mod.encode_message(TransferPayloadReceiverClaimFault(rx, mode)), tx
    end)()
    defer transfer_mod.discard_message(raw)
    defer peer:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not peer:is_closed())
    local caught = false
    do
      transfer_mod.decode_message(raw)
    catch
      caught = true
    end
    test.assert(caught, "invalid Receiver attachment claim succeeded")
    if mode == "wrong-kind" then
      test.assert(peer:is_closed(), "wrong-kind claim did not dispose unclaimed Receiver")
    else
      support.collect_garbage()
      support.collect_garbage()
      local got, item? = transfer_drain_saved_receiver(peer, 719,
          "repeated Receiver claim released the valid first claimant")
      test.assert(got and item == 719)
      support.collect_garbage()
      support.collect_garbage()
      test.assert(peer:is_closed(), "last adopted Receiver was not reclaimed")
    end
  end)
end

function test_transfer_receiver_claim_kind_and_duplicate_validation(context: test.Context)
  transfer_receiver_claim_case(context, "wrong-kind")
  transfer_receiver_claim_case(context, "repeated")
end

function test_transfer_throwing_module_loader_releases_packet(_context: test.Context)
  local raw, peer1, peer2 = make_recursive_receiver_raw()
  defer peer1:close()
  defer peer2:close()
  local slot: foreign *TransferMessageSlot = foreign TransferMessageSlot.new_array(1)
  defer do
    transfer_mod.discard_message(slot[0])
    slot[0] = nil
  end
  slot[0] = raw
  support.collect_garbage()
  support.collect_garbage()
  local state = transfer_lua.new()
  defer state:close()
  local calls: owned int[] = foreign int.new_array(1)
  transfer_payload_error(function ()
    state:run([[
      local slot, counter, count_loader = ...
      local support = require('async.test_support')
      package.loaded['async.tests'] = nil
      package.preload['async.tests'] = function()
        count_loader(counter)
        error('owned-module-load-fault')
      end
      return support.decode_raw_slot(slot, 0)
    ]], "=throwing-transfer-module",
      transfer_mod.TransferValue.is_pointer(slot as foreign *void),
      transfer_mod.TransferValue.is_pointer(calls as foreign *void),
      transfer_mod.TransferValue.is_function(transfer_count_module_load))
  end, "owned-module-load-fault")
  test.assert(slot[0] == nil, "throwing module loader left the raw owner slot occupied")
  test.assert(calls[0] == 1, "decode did not reach the controlled nominal loader failure")
  test.assert(peer1:is_closed() and peer2:is_closed(),
              "throwing nominal loader leaked the packet's endpoint attachments")
end


function test_transfer_standalone_wire_and_policy_do_not_create_endpoint_owners(
    _context: test.Context)
  local tx, rx = transfer_thread.channel<|integer|>(1)
  defer tx:close()
  defer rx:close()
  transfer_payload_raises(function () transfer_protobuf.serialize(tx) end,
    "standalone protobuf encoding authorized a native endpoint retain")
  transfer_payload_raises(function ()
    transfer_mod.TransferValue.from_value(function (): value return tx end)
  end, "standalone closure policy authorized a captured endpoint retain")
  transfer_payload_raises(function ()
    transfer_mod.TransferValue.is_record_payload("titan.thread",
      "titan.thread.Sender", "\0\0\0\0"):to_value()
  end, "standalone policy decoding authorized an endpoint claim")
  test.assert(tx:try_send(727))
  local got, item? = rx:try_receive()
  test.assert(got and item == 727,
              "rejected standalone wire/policy conversion damaged the original endpoint")
end


-- Body-side failure after decode's entry has reserved its frame: the scope
-- preparation allocation fails inside the protected worker, and decode's catch
-- consumes the packet. Entry-preamble failures, which leave the packet to the
-- caller's guard, are covered by the scalar-envelope stack scan.
function test_transfer_raw_decode_scope_preparation_oom_consumes_owner(
    context: test.Context)
  context:run("body-scope-preparation-oom", function (_context: test.Context)
    local raw, peer1, peer2 = make_recursive_receiver_raw()
    defer transfer_mod.discard_message(raw)
    defer peer1:close()
    defer peer2:close()
    support.collect_garbage()
    support.collect_garbage()
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    -- Reserve decode's own frame first so the armed failure is the scope
    -- preparation inside its protected body, not stack growth at entry.
    test.assert(ffi.lua_checkstack(L, 64) ~= 0)
    local ctrl: owned size_t[] = foreign size_t.new_array(3)
    ctrl[0] = 1 as foreign size_t
    ctrl[1] = 1 as foreign size_t
    local previous_data: foreign *void = nil
    local previous = ffi.lua_getallocf(L, previous_data)
    ffi.lua_setallocf(L, transfer_limited_lua_alloc, ctrl as foreign *void)
    local failed = false
    do
      transfer_mod.decode_message(raw)
    catch
      failed = true
    end
    ffi.lua_setallocf(L, previous, previous_data)
    ffi.lua_settop(L, top)
    test.assert(failed and ctrl[2] >= (2 as foreign size_t),
                "raw decode scope preparation did not reach its Lua allocation failure")
    test.assert(raw == nil and peer1:is_closed() and peer2:is_closed(),
                "raw decode scope-preparation OOM stranded its caller slot or packet attachments")
  end)
end
