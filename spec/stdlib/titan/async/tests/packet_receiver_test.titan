local packet_receiver_transfer = import "transfer"
local packet_receiver_thread = import "thread"
local packet_receiver_lua = import "lua"
local packet_receiver_gc = import "gc"
local packet_receiver_string = import "string"
foreign import "packet_receiver_probe.h"

local packet_receiver_hook_encode_calls = 0
local packet_receiver_hook_decode_calls = 0

record PacketReceiverHookProbe
  local tag: integer
end

function PacketReceiverHookProbe.new(tag: integer): PacketReceiverHookProbe
  return { tag = tag }
end

function PacketReceiverHookProbe:value(): integer
  return self.tag
end

function PacketReceiverHookProbe:to_transfer_payload(): string
  packet_receiver_hook_encode_calls = packet_receiver_hook_encode_calls + 1
  return "" .. self.tag
end

function PacketReceiverHookProbe.from_transfer_payload(
    payload: string): PacketReceiverHookProbe
  packet_receiver_hook_decode_calls = packet_receiver_hook_decode_calls + 1
  local parsed = 0
  for index = 1, #payload do
    local code: integer = packet_receiver_string.byte(payload, index)
    parsed = parsed * 10 + (code - 48)
  end
  return { tag = parsed }
end

record PacketReceiverSenderEnvelope
  ordinal: integer
  probe: PacketReceiverHookProbe
  tx: packet_receiver_thread.Sender<|integer|>
end

record PacketReceiverReceiverEnvelope
  ordinal: integer
  probe: PacketReceiverHookProbe
  rx: packet_receiver_thread.Receiver<|integer|>
end

record PacketReceiverNestedReceiverEnvelope
  ordinal: integer
  probe: PacketReceiverHookProbe
  rx: packet_receiver_thread.Receiver<|packet_receiver_thread.Sender<|integer|>|>
end

record PacketReceiverDuplexEnvelope
  ordinal: integer
  probe: PacketReceiverHookProbe
  reply: packet_receiver_thread.Sender<|string|>
  inbox: packet_receiver_thread.Receiver<|integer|>
end

local function packet_receiver_reset_hook_counts()
  packet_receiver_hook_encode_calls = 0
  packet_receiver_hook_decode_calls = 0
end

local function packet_receiver_expect_error(action: function (): (),
                                            fragment: string?)
  local caught = false
  do
    action()
  catch
    caught = error is string
    if caught and fragment ~= nil then
      test.assert(support.contains(error as string, fragment),
                  "unexpected PacketReceiver diagnostic: " .. (error as string))
    end
  end
  test.assert(caught, "invalid PacketReceiver operation succeeded")
end

local function packet_receiver_unwrap_handle(
    item: async.TransferValue): foreign *void
  case item
  when is_pointer(pointer) then return pointer
  else raise "expected pointer TransferValue for PacketReceiver handle"
  end
end

-- Check callbacks run after the I/O poll. A pending PacketReceiver callback
-- therefore queues its reader before this ordinary await resumes the observer
-- directly from check, without driving the Runtime loop from test code.
local function packet_receiver_after_poll()
  local phase = uv.check_t.new()
  test.assert(uv.check_init(async.current_loop(), phase) == 0)
  local handle = phase:as_handle_t()
  defer if not uv.is_closing(handle) then uv.close(handle) end
  local idle = uv.idle_t.new()
  test.assert(uv.idle_init(async.current_loop(), idle) == 0)
  local idle_handle = idle:as_handle_t()
  defer if not uv.is_closing(idle_handle) then uv.close(idle_handle) end
  -- A check watcher alone does not prevent the poll from blocking when the
  -- signal was already processed. Keep this barrier's own poll nonblocking.
  test.assert(uv.idle_start(idle, function (_: uv.idle_t) end) == 0)
  async.await<|nil, nil|>(function (resolve, _reject, fatal)
    test.assert(uv.check_start(phase, function (current: uv.check_t)
      do
        test.assert(uv.check_stop(current) == 0)
        uv.close(handle)
        test.assert(uv.idle_stop(idle) == 0)
        uv.close(idle_handle)
        resolve(nil)
      catch
        fatal(error, traceback)
        raise
      end
    end) == 0)
  end)
end

-- A prepare callback following the completed poll/check phase observes the
-- ready timer's delivery of an already queued reader wake. This is a phase
-- barrier, not an assumption about a number of Task yields or elapsed time.
local function packet_receiver_after_ready_delivery()
  local phase = uv.prepare_t.new()
  test.assert(uv.prepare_init(async.current_loop(), phase) == 0)
  local handle = phase:as_handle_t()
  defer if not uv.is_closing(handle) then uv.close(handle) end
  async.await<|nil, nil|>(function (resolve, _reject, fatal)
    test.assert(uv.prepare_start(phase, function (current: uv.prepare_t)
      do
        test.assert(uv.prepare_stop(current) == 0)
        uv.close(handle)
        resolve(nil)
      catch
        fatal(error, traceback)
        raise
      end
    end) == 0)
  end)
end

local function make_sender_packet_in_frame(
    ordinal: integer): (packet_receiver_transfer.Packet,
                        packet_receiver_thread.Receiver<|integer|>)
  local tx, rx = packet_receiver_thread.channel<|integer|>(1)
  local env = PacketReceiverSenderEnvelope(
    ordinal, PacketReceiverHookProbe.new(ordinal), tx)
  local pkt = packet_receiver_transfer.Packet.from_value(env)
  return pkt, rx
end

local function make_sender_packet(
    ordinal: integer): (packet_receiver_transfer.Packet,
                        packet_receiver_thread.Receiver<|integer|>)
  local pkt, rx = make_sender_packet_in_frame(ordinal)
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not rx:is_closed(),
    "Packet did not retain the sole channel Sender reference")
  return pkt, rx
end

local function make_nested_receiver_packet_in_frame(
    ordinal: integer): (packet_receiver_transfer.Packet,
                        packet_receiver_thread.Sender<|packet_receiver_thread.Sender<|integer|>|>,
                        packet_receiver_thread.Receiver<|integer|>)
  local outer_tx, outer_rx =
    packet_receiver_thread.channel<|packet_receiver_thread.Sender<|integer|>|>(1)
  local inner_tx, inner_rx = packet_receiver_thread.channel<|integer|>(1)
  test.assert(outer_tx:try_send(inner_tx),
    "could not buffer nested Sender inside outer channel")
  local env = PacketReceiverNestedReceiverEnvelope(
    ordinal, PacketReceiverHookProbe.new(ordinal), outer_rx)
  local pkt = packet_receiver_transfer.Packet.from_value(env)
  return pkt, outer_tx, inner_rx
end

local function make_nested_receiver_packet(
    ordinal: integer): (packet_receiver_transfer.Packet,
                        packet_receiver_thread.Sender<|packet_receiver_thread.Sender<|integer|>|>,
                        packet_receiver_thread.Receiver<|integer|>)
  local pkt, outer_tx, inner_rx = make_nested_receiver_packet_in_frame(ordinal)
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not outer_tx:is_closed() and not inner_rx:is_closed(),
    "Packet did not retain the sole outer Receiver and buffered inner Sender")
  return pkt, outer_tx, inner_rx
end

local function send_and_drop_returned_packet(
    receiver: async.PacketReceiver,
    ordinal: integer): packet_receiver_thread.Receiver<|integer|>
  local pkt, rx = make_sender_packet(ordinal)
  async.send_packet(receiver:handle(), pkt)
  local delivered = receiver:wait_packet()
  test.assert(not rx:is_closed() and packet_receiver_hook_decode_calls == 0,
    "wait_packet decoded or released the packet before caller action")
  return rx
end

function test_packet_receiver_replace_before_callback_disposes_displaced_endpoints_without_decode(
    _context: test.Context)
  packet_receiver_reset_hook_counts()
  runtime_test.run(function ()
    local receiver = async.packet_receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local pkt1, rx1 = make_sender_packet(101)
    defer pkt1:close()
    defer rx1:close()
    local pkt2, outer_tx2, inner_rx2 = make_nested_receiver_packet(102)
    defer pkt2:close()
    defer outer_tx2:close()
    defer inner_rx2:close()
    local pkt3, rx3 = make_sender_packet(103)
    defer pkt3:close()
    defer rx3:close()

    test.assert(packet_receiver_hook_encode_calls == 3 and
                packet_receiver_hook_decode_calls == 0)

    -- Publish pkt1 into the native slot before yielding to any loop callback.
    async.send_packet(handle, pkt1)
    packet_receiver_expect_error(function ()
      pkt1:decode()
    end, "consumed")
    test.assert(not rx1:is_closed(),
      "admitted packet lost its endpoint ownership while sitting in the slot")

    -- Replacing before callback delivery must discard directly in C.
    async.send_packet(handle, pkt2)
    test.assert(rx1:is_closed(),
      "displaced Sender packet did not auto-close its peer Receiver")
    test.assert(not outer_tx2:is_closed() and not inner_rx2:is_closed(),
      "current Receiver packet in slot prematurely released its endpoints")
    test.assert(packet_receiver_hook_decode_calls == 0,
      "displacing a packet invoked a user transfer decoder")

    -- Discarding the outer Receiver also drains its buffered inner Sender.
    async.send_packet(handle, pkt3)
    test.assert(outer_tx2:is_closed() and inner_rx2:is_closed(),
      "displaced Receiver packet did not release outer channel and queued inner endpoint")
    test.assert(not rx3:is_closed() and packet_receiver_hook_decode_calls == 0,
      "latest packet was disturbed or decoded during replacement")

    local delivered = receiver:wait_packet()
    test.assert(not rx3:is_closed() and packet_receiver_hook_decode_calls == 0,
      "wait_packet decoded the packet before explicit decode")

    local restored: PacketReceiverSenderEnvelope = delivered:decode()
    test.assert(restored.ordinal == 103 and restored.probe:value() == 103)
    test.assert(packet_receiver_hook_decode_calls == 1,
      "Packet:decode did not invoke the decoder exactly once")

    -- Decoding consumes the Packet; subsequent operations fail while the
    -- adopted Sender remains live and connected to rx3.
    packet_receiver_expect_error(function ()
      delivered:decode()
    end, "consumed")
    packet_receiver_expect_error(function ()
      async.send_packet(handle, delivered)
    end, "consumed")
    delivered:close()
    delivered:close()
    test.assert(not rx3:is_closed(),
      "closing a decoded Packet closed the already-adopted endpoint")
    test.assert(restored.tx:try_send(919))
    local ok, value? = rx3:try_receive()
    test.assert(ok and value == 919,
      "adopted Sender from PacketReceiver did not deliver to its peer Receiver")
    restored.tx:close()
    test.assert(rx3:is_closed())
  end)
end

function test_packet_receiver_callbacks_wake_only_and_replace_before_wait(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    local receiver = async.packet_receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local pkt1, rx1 = make_sender_packet(201)
    defer rx1:close()
    async.send_packet(handle, pkt1)
    -- Observe the completed I/O phase while no reader is registered.
    packet_receiver_after_poll()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and packet_receiver_hook_decode_calls == 0,
      "wake callback consumed or decoded the unread packet when no reader waited")

    local pkt2, rx2 = make_sender_packet(202)
    defer rx2:close()
    async.send_packet(handle, pkt2)
    test.assert(rx1:is_closed() and not rx2:is_closed() and
                packet_receiver_hook_decode_calls == 0,
      "post-callback replacement did not dispose the earlier unread packet")
    packet_receiver_after_poll()
    support.collect_garbage()
    test.assert(not rx2:is_closed() and packet_receiver_hook_decode_calls == 0)

    local delivered2 = receiver:wait_packet()
    local env2: PacketReceiverSenderEnvelope = delivered2:decode()
    test.assert(env2.ordinal == 202 and env2.probe:value() == 202)
    test.assert(packet_receiver_hook_decode_calls == 1)
    test.assert(env2.tx:try_send(2020))
    local ok2, val2? = rx2:try_receive()
    test.assert(ok2 and val2 == 2020)
    env2.tx:close()

    local pkt3, rx3 = make_sender_packet(203)
    defer rx3:close()
    async.send_packet(handle, pkt3)
    local env3: PacketReceiverSenderEnvelope = receiver:wait_packet():decode()
    test.assert(env3.ordinal == 203 and env3.probe:value() == 203)
    test.assert(packet_receiver_hook_decode_calls == 2)
    test.assert(env3.tx:try_send(2030))
    local ok3, val3? = rx3:try_receive()
    test.assert(ok3 and val3 == 2030)
    env3.tx:close()
  end)
end

function test_packet_receiver_queued_wake_rejects_second_reader_and_coalesces_replacement(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    local receiver = async.packet_receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local reader1 = async.run<|packet_receiver_transfer.Packet, value|>(
      receiver:wait_packet)
    task_support.cleanup_task(reader1, "PacketReceiver reserved reader1 cleanup")
    support.wait_until_waiting(reader1)

    -- Contention while reader1 is parked before any packet arrives.
    packet_receiver_expect_error(function ()
      receiver:wait_packet()
    end, "waiting")

    local pkt1, rx1 = make_sender_packet(301)
    defer rx1:close()
    local pkt2, rx2 = make_sender_packet(302)
    defer rx2:close()

    async.send_packet(handle, pkt1)
    -- The check-phase observer resumes before the ready timer can deliver
    -- reader1's queued wake. The packet must still belong to the native slot.
    packet_receiver_after_poll()
    test.assert(reader1:status():as_string() == "waiting" and
                not rx1:is_closed() and packet_receiver_hook_decode_calls == 0,
      "wake callback consumed or decoded the reserved reader's packet")
    -- A second reader must not take the published packet across that wake.
    packet_receiver_expect_error(function ()
      receiver:wait_packet()
    end, "waiting")

    async.send_packet(handle, pkt2)
    test.assert(rx1:is_closed() and not rx2:is_closed() and
                packet_receiver_hook_decode_calls == 0,
      "replacing packet during queued wake did not dispose displaced packet")
    local st_reader1 = async.join(reader1)
    case st_reader1
    when succeeded(delivered) then
      local env2: PacketReceiverSenderEnvelope = delivered:decode()
      test.assert(env2.ordinal == 302 and env2.probe:value() == 302,
        "woken reader1 did not receive the replacement packet")
      test.assert(packet_receiver_hook_decode_calls == 1)
      test.assert(env2.tx:try_send(3020))
      local ok2, val2? = rx2:try_receive()
      test.assert(ok2 and val2 == 3020)
      env2.tx:close()
    else
      raise "reserved reader1 did not succeed after queued wake"
    end

    -- Reservation must be released once wait_packet returns.
    local pkt3, rx3 = make_sender_packet(303)
    defer rx3:close()
    async.send_packet(handle, pkt3)
    local env3: PacketReceiverSenderEnvelope = receiver:wait_packet():decode()
    test.assert(env3.ordinal == 303 and packet_receiver_hook_decode_calls == 2)
    env3.tx:close()
  end)
end

function test_packet_receiver_cancelled_reader_preserves_unread_packet(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    local receiver = async.packet_receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local waiting = async.run<|packet_receiver_transfer.Packet, value|>(
      receiver:wait_packet)
    task_support.cleanup_task(waiting, "cancelled PacketReceiver reader cleanup")
    support.wait_until_waiting(waiting)

    local pkt1, rx1 = make_sender_packet(401)
    defer rx1:close()
    -- Neither send_packet nor cancel yields: cancellation wins before delivery
    -- and must withdraw only the reader reservation while leaving pkt1 unread.
    async.send_packet(handle, pkt1)
    waiting:cancel(async.CancellationReason.simple("PacketReceiver wait cancelled"))
    test.assert(support.cancelled_with(
      async.join(waiting), "PacketReceiver wait cancelled"))
    support.collect_garbage()
    test.assert(not rx1:is_closed() and packet_receiver_hook_decode_calls == 0,
      "cancelled reader consumed or discarded the unread packet")

    -- A pre-cancelled Task calling wait_packet must also fail at checkpoint()
    -- before exchanging the unread slot, releasing its reservation cleanly.
    local pre_cancelled = async.run<|packet_receiver_transfer.Packet, value|>(
      receiver:wait_packet)
    task_support.cleanup_task(pre_cancelled, "pre-cancelled PacketReceiver reader")
    pre_cancelled:cancel(async.CancellationReason.simple("pre-cancelled reader"))
    test.assert(support.cancelled_with(
      async.join(pre_cancelled), "pre-cancelled reader"))
    test.assert(not rx1:is_closed() and packet_receiver_hook_decode_calls == 0,
      "pre-cancelled reader took the unread packet before checkpoint")

    local delivered1 = receiver:wait_packet()
    local env1: PacketReceiverSenderEnvelope = delivered1:decode()
    test.assert(env1.ordinal == 401 and env1.probe:value() == 401)
    test.assert(packet_receiver_hook_decode_calls == 1)
    test.assert(env1.tx:try_send(4010))
    local ok1, val1? = rx1:try_receive()
    test.assert(ok1 and val1 == 4010)
    env1.tx:close()

    local pkt2, rx2 = make_sender_packet(402)
    defer rx2:close()
    async.send_packet(handle, pkt2)
    local env2: PacketReceiverSenderEnvelope = receiver:wait_packet():decode()
    test.assert(env2.ordinal == 402 and packet_receiver_hook_decode_calls == 2)
    env2.tx:close()
  end)
end

function test_packet_receiver_send_between_empty_check_and_suspension_and_stale_wake_recheck(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    local receiver = async.packet_receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    -- Part 1: Send between the empty-slot check/suspension and the loop's I/O poll.
    -- Queue reader and sender together on the ready queue: reader runs first,
    -- checks the empty slot, sets notified = false, and yields into suspend;
    -- sender runs immediately in the same ready batch before uv_run polls
    -- uv.async_t, publishing pkt1 and leaving a pending UV signal.
    local pkt1, rx1 = make_sender_packet(501)
    defer rx1:close()
    local reader_between = async.run<|packet_receiver_transfer.Packet, value|>(
      receiver:wait_packet)
    task_support.cleanup_task(reader_between, "reader_between cleanup")
    local sender_between = async.run<|nil, value|>(function (): nil
      test.assert(reader_between:status():as_string() == "waiting",
        "reader did not suspend after empty check")
      async.send_packet(handle, pkt1)
      return nil
    end)
    task_support.cleanup_task(sender_between, "sender_between cleanup")

    local st_sender, st_reader = async.join_two(sender_between, reader_between)
    local sender_ok, sender_payload? = st_sender:has_succeeded()
    test.assert(sender_ok and sender_payload == nil,
      "sender failed to publish after the reader suspended on the empty slot")
    case st_reader
    when succeeded(delivered1) then
      local env1: PacketReceiverSenderEnvelope = delivered1:decode()
      test.assert(env1.ordinal == 501 and packet_receiver_hook_decode_calls == 1)
      env1.tx:close()
    else
      raise "reader missed a send between empty check and UV poll"
    end

    -- Part 2: Inert stale wake recheck.
    -- Send pkt_fast and consume it immediately via the synchronous fast path
    -- before uv_run polls uv.async_t. That leaves the UV async signal pending
    -- for an now-empty slot.
    local pkt_fast, rx_fast = make_sender_packet(502)
    defer rx_fast:close()
    async.send_packet(handle, pkt_fast)
    local env_fast: PacketReceiverSenderEnvelope = receiver:wait_packet():decode()
    test.assert(env_fast.ordinal == 502 and packet_receiver_hook_decode_calls == 2)
    env_fast.tx:close()

    -- Now park a reader on the empty slot; the next loop turn delivers the
    -- stale UV async callback from pkt_fast. The reader must recheck the empty
    -- slot, reset notified = false, keep its reservation, and re-suspend.
    local waiting_stale = async.run<|packet_receiver_transfer.Packet, value|>(
      receiver:wait_packet)
    task_support.cleanup_task(waiting_stale, "waiting_stale cleanup")
    support.wait_until_waiting(waiting_stale)
    packet_receiver_after_poll()
    packet_receiver_after_ready_delivery()
    test.assert(waiting_stale:status():as_string() == "waiting",
      "inert stale wake terminated or spun the waiting reader")
    packet_receiver_expect_error(function ()
      receiver:wait_packet()
    end, "waiting")

    local pkt_after_stale, rx_after_stale = make_sender_packet(503)
    defer rx_after_stale:close()
    async.send_packet(handle, pkt_after_stale)
    case async.join(waiting_stale)
    when succeeded(delivered_after) then
      local env_after: PacketReceiverSenderEnvelope = delivered_after:decode()
      test.assert(env_after.ordinal == 503 and packet_receiver_hook_decode_calls == 3)
      test.assert(env_after.tx:try_send(5030))
      local ok_after, val_after? = rx_after_stale:try_receive()
      test.assert(ok_after and val_after == 5030)
      env_after.tx:close()
    else
      raise "reader did not wake for real packet after inert stale wake recheck"
    end
  end)
end

function test_packet_receiver_close_and_dropped_packet_dispose_endpoints_without_decode(
    _context: test.Context)
  packet_receiver_reset_hook_counts()
  runtime_test.run(function ()
    -- 1. Closing a PacketReceiver wakes a parked reader with "receiver is closed".
    local receiver = async.packet_receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local waiting = async.run<|packet_receiver_transfer.Packet, value|>(
      receiver:wait_packet)
    task_support.cleanup_task(waiting, "closed PacketReceiver waiter cleanup")
    support.wait_until_waiting(waiting)
    receiver:close()
    receiver:close()
    case async.join(waiting)
    when failed(failure) then
      test.assert(failure.error == "receiver is closed",
        "closing PacketReceiver raised wrong error on parked reader")
    else
      raise "closing PacketReceiver did not fail its waiting Task"
    end
    packet_receiver_expect_error(function ()
      receiver:wait_packet()
    end, "closed")

    -- 2. Closing a PacketReceiver with an unread packet disposes it immediately
    -- without calling any decoder.
    local unread_receiver = async.packet_receiver()
    runtime_test.cleanup(function () unread_receiver:close() end)
    local pkt_unread, outer_tx_unread, inner_rx_unread =
      make_nested_receiver_packet(601)
    defer outer_tx_unread:close()
    defer inner_rx_unread:close()
    async.send_packet(unread_receiver:handle(), pkt_unread)
    test.assert(not outer_tx_unread:is_closed() and not inner_rx_unread:is_closed())
    unread_receiver:close()
    unread_receiver:close()
    test.assert(outer_tx_unread:is_closed() and inner_rx_unread:is_closed(),
      "closing PacketReceiver did not dispose its unread packet attachments")
    test.assert(packet_receiver_hook_decode_calls == 0,
      "closing PacketReceiver invoked a transfer decoder")
    packet_receiver_expect_error(function ()
      unread_receiver:wait_packet()
    end, "closed")

    -- 3. Explicit Packet:close() and GC drop of a Packet returned by wait_packet()
    -- both dispose the endpoint without decoding.
    local drop_receiver = async.packet_receiver()
    runtime_test.cleanup(function () drop_receiver:close() end)
    local pkt_explicit, rx_explicit = make_sender_packet(602)
    defer rx_explicit:close()
    async.send_packet(drop_receiver:handle(), pkt_explicit)
    local returned_explicit = drop_receiver:wait_packet()
    test.assert(not rx_explicit:is_closed())
    returned_explicit:close()
    returned_explicit:close()
    test.assert(rx_explicit:is_closed() and packet_receiver_hook_decode_calls == 0,
      "explicit close of returned Packet did not release its endpoint")
    packet_receiver_expect_error(function ()
      returned_explicit:decode()
    end, "consumed")

    local rx_gc_dropped = send_and_drop_returned_packet(drop_receiver, 603)
    defer rx_gc_dropped:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx_gc_dropped:is_closed() and packet_receiver_hook_decode_calls == 0,
      "dropping returned Packet without decode did not release its endpoint on GC")
  end)

  -- 4. Runtime shutdown disables a retained PacketReceiver and disposes its
  -- unread packet without invoking any decoder.
  local shutdown_receiver: async.PacketReceiver? = nil
  local rx_shutdown: packet_receiver_thread.Receiver<|integer|>? = nil
  runtime_test.run(function ()
    local receiver = async.packet_receiver()
    shutdown_receiver = receiver
    local pkt, peer = make_sender_packet(604)
    rx_shutdown = peer
    async.send_packet(receiver:handle(), pkt)
  end)
  defer shutdown_receiver:close()
  defer rx_shutdown:close()
  test.assert(rx_shutdown:is_closed() and packet_receiver_hook_decode_calls == 0,
    "Runtime shutdown did not dispose unread packet in retained PacketReceiver")
  local pkt_after_shutdown, rx_after_shutdown = make_sender_packet(605)
  defer pkt_after_shutdown:close()
  defer rx_after_shutdown:close()
  packet_receiver_expect_error(function ()
    async.send_packet(shutdown_receiver:handle(), pkt_after_shutdown)
  end, "closed")
  test.assert(not rx_after_shutdown:is_closed(),
    "rejected send after Runtime shutdown consumed caller's Packet")
  runtime_test.run(function ()
    packet_receiver_expect_error(function ()
      shutdown_receiver:wait_packet()
    end, "closed")
  end)
end

function test_packet_receiver_wrong_mode_pre_admit_preservation_and_post_commit_error_consumption(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    local legacy = async.receiver()
    runtime_test.cleanup(function () legacy:close() end)
    local owned_rx = async.packet_receiver()
    runtime_test.cleanup(function () owned_rx:close() end)
    local closed_rx = async.packet_receiver()
    runtime_test.cleanup(function () closed_rx:close() end)
    closed_rx:close()

    -- Seed legacy with an integer TransferValue to verify wrong-mode send_packet
    -- does not disturb legacy's slot.
    async.send(legacy:handle(), async.TransferValue.is_integer(77))

    local pkt_preserved, rx_preserved = make_sender_packet(701)
    defer rx_preserved:close()
    local preserved_message = pkt_preserved:borrow_message()

    -- Pre-admit failures: NULL handle, wrong-mode handle (legacy Receiver),
    -- and closed PacketReceiver handle must all preserve pkt_preserved.
    packet_receiver_expect_error(function ()
      async.send_packet(nil, pkt_preserved)
    end, "NULL")
    test.assert(not rx_preserved:is_closed() and
                pkt_preserved:borrow_message() == preserved_message)

    packet_receiver_expect_error(function ()
      async.send_packet(legacy:handle(), pkt_preserved)
    end, "mode")
    test.assert(not rx_preserved:is_closed() and
                pkt_preserved:borrow_message() == preserved_message)

    packet_receiver_expect_error(function ()
      async.send_packet(closed_rx:handle(), pkt_preserved)
    end, "closed")
    test.assert(not rx_preserved:is_closed() and
                pkt_preserved:borrow_message() == preserved_message and
                packet_receiver_hook_decode_calls == 0,
      "pre-admit send_packet rejection consumed or decoded the source Packet")

    -- Reverse wrong-mode direction: async.send on a PacketReceiver handle must
    -- fail with a mode mismatch without disturbing owned_rx.
    async.send_packet(owned_rx:handle(), pkt_preserved)
    packet_receiver_expect_error(function ()
      async.send(owned_rx:handle(), async.TransferValue.is_integer(88))
    end, "mode")
    test.assert(not rx_preserved:is_closed() and packet_receiver_hook_decode_calls == 0,
      "wrong-mode async.send displaced the unread Packet in PacketReceiver")

    -- Verify legacy Receiver still delivers its 77 and owned_rx delivers pkt_preserved.
    case legacy:wait()
    when is_integer(num) then test.assert(num == 77)
    else raise "wrong-mode send_packet corrupted legacy Receiver value"
    end

    local env_preserved: PacketReceiverSenderEnvelope =
      owned_rx:wait_packet():decode()
    test.assert(env_preserved.ordinal == 701 and
                packet_receiver_hook_decode_calls == 1)
    test.assert(env_preserved.tx:try_send(7010))
    local ok_p, val_p? = rx_preserved:try_receive()
    test.assert(ok_p and val_p == 7010)
    env_preserved.tx:close()

    -- Sending an already-consumed Packet fails before touching the slot.
    local pkt_slot, rx_slot = make_sender_packet(702)
    defer rx_slot:close()
    async.send_packet(owned_rx:handle(), pkt_slot)
    packet_receiver_expect_error(function ()
      async.send_packet(owned_rx:handle(), pkt_preserved)
    end, "consumed")
    test.assert(not rx_slot:is_closed(),
      "consumed Packet rejection disturbed the unread packet in owned_rx")
    local closed_packet = packet_receiver_transfer.Packet.from_value(702)
    closed_packet:close()
    packet_receiver_expect_error(function ()
      async.send_packet(owned_rx:handle(), closed_packet)
    end, "consumed")
    test.assert(not rx_slot:is_closed(),
      "closed Packet rejection disturbed the unread packet in owned_rx")

    -- Post-commit notification error: using the scoped probe fixture, override
    -- receiver->send to return uv.ENOMEM after atomic slot exchange.
    -- The displaced packet (pkt_slot) must be disposed, the new source Packet
    -- (pkt_committed) must be consumed so callers cannot double-free/resend,
    -- and the committed native packet must remain in owned_rx's slot.
    local pkt_committed, rx_committed = make_sender_packet(703)
    defer rx_committed:close()
    local committed_alias = pkt_committed
    -- The probe stores this guard's address in the receiver and mutates its
    -- call counter from native code across a caught error. Keep it in owned
    -- heap storage: automatic C objects are restored from their setjmp spill
    -- snapshot on catch recovery, which would discard the observed mutation.
    local guard: owned *titan_packet_receiver_send_guard =
      foreign titan_packet_receiver_send_guard.new()
    ffi.titan_packet_receiver_guard_install(
      guard, owned_rx:handle(), uv.ENOMEM as foreign int)
    defer ffi.titan_packet_receiver_guard_restore(guard)
    -- The alias shares the source owner; publication must consume both views.

    local notify_failed = false
    do
      async.send_packet(owned_rx:handle(), pkt_committed)
    catch
      if error is async.OperationError then
        local op_err = error as async.OperationError
        notify_failed = op_err.operation == "async.send_packet" and
                        op_err.code == uv.ENOMEM
      end
    end
    ffi.titan_packet_receiver_guard_restore(guard)
    test.assert(notify_failed and
                (ffi.titan_packet_receiver_guard_calls(guard) as integer) == 1,
      "post-commit notification failure did not raise OperationError(async.send_packet)")
    test.assert(rx_slot:is_closed(),
      "post-commit notification failure did not dispose displaced packet")
    test.assert(not rx_committed:is_closed() and
                packet_receiver_hook_decode_calls == 1,
      "post-commit notification failure lost or decoded the committed packet")
    packet_receiver_expect_error(function ()
      pkt_committed:decode()
    end, "consumed")
    packet_receiver_expect_error(function ()
      committed_alias:borrow_message()
    end, "consumed")
    packet_receiver_expect_error(function ()
      async.send_packet(owned_rx:handle(), pkt_committed)
    end, "consumed")

    -- The committed packet in owned_rx's slot is still recoverable by wait_packet
    -- and disposable by close.
    local env_committed: PacketReceiverSenderEnvelope =
      owned_rx:wait_packet():decode()
    test.assert(env_committed.ordinal == 703 and
                packet_receiver_hook_decode_calls == 2)
    test.assert(env_committed.tx:try_send(7030))
    local ok_c, val_c? = rx_committed:try_receive()
    test.assert(ok_c and val_c == 7030)
    env_committed.tx:close()

    local pkt_committed_close, rx_committed_close = make_sender_packet(704)
    defer rx_committed_close:close()
    ffi.titan_packet_receiver_guard_install(
      guard, owned_rx:handle(), uv.EIO as foreign int)
    local close_notify_failed = false
    do
      async.send_packet(owned_rx:handle(), pkt_committed_close)
    catch
      if error is async.OperationError then
        local op_err = error as async.OperationError
        close_notify_failed = op_err.operation == "async.send_packet" and
                              op_err.code == uv.EIO
      end
    end
    ffi.titan_packet_receiver_guard_restore(guard)
    test.assert(close_notify_failed and not rx_committed_close:is_closed() and
                packet_receiver_hook_decode_calls == 2)
    packet_receiver_expect_error(function ()
      pkt_committed_close:decode()
    end, "consumed")
    owned_rx:close()
    test.assert(rx_committed_close:is_closed() and
                packet_receiver_hook_decode_calls == 2,
      "closing PacketReceiver after post-commit wake error did not dispose slot")
  end)
end

local function packet_receiver_thread_worker(
    host_handle_val: async.TransferValue,
    ready_tx: packet_receiver_thread.Sender<|integer|>,
    ctrl_rx: packet_receiver_thread.Receiver<|integer|>): integer
  local host_handle = packet_receiver_unwrap_handle(host_handle_val)
  packet_receiver_reset_hook_counts()
  defer ready_tx:close()

  -- 1. Send a displaced endpoint packet followed by a live duplex endpoint
  -- packet from this child OS thread to the host's PacketReceiver before
  -- signaling ready_tx so the host never races between the two sends.
  local disp_pkt, disp_rx = make_sender_packet(801)
  defer disp_rx:close()
  async.send_packet(host_handle, disp_pkt)
  test.assert(not disp_rx:is_closed())

  local reply_tx, reply_rx = packet_receiver_thread.channel<|string|>(1)
  defer reply_rx:close()
  local inbox_tx, inbox_rx = packet_receiver_thread.channel<|integer|>(1)
  defer inbox_tx:close()
  local duplex_pkt = packet_receiver_transfer.Packet.from_value(
    PacketReceiverDuplexEnvelope(
      802, PacketReceiverHookProbe.new(802), reply_tx, inbox_rx))
  async.send_packet(host_handle, duplex_pkt)
  test.assert(disp_rx:is_closed() and packet_receiver_hook_decode_calls == 0,
    "cross-thread replacement in host PacketReceiver did not dispose displaced endpoint")

  test.assert(inbox_tx:try_send(8020))
  ready_tx:send(1)
  test.assert(reply_rx:receive() == "host-ack-8020")
  -- 2. Create a child-thread PacketReceiver, send its handle to the host,
  -- receive a coalesced endpoint packet from the host, and retire host sends
  -- via ctrl_rx before closing worker_receiver.
  local worker_receiver = async.packet_receiver()
  defer worker_receiver:close()
  async.send_packet(
    host_handle,
    packet_receiver_transfer.Packet.from_value(
      async.TransferValue.is_pointer(worker_receiver:handle())))

  -- Wait until the host has sent both its displaced and replacement packets.
  test.assert(ctrl_rx:receive() == 1)
  local from_host_pkt = worker_receiver:wait_packet()
  local from_host: PacketReceiverSenderEnvelope = from_host_pkt:decode()
  test.assert(from_host.ordinal == 804 and from_host.probe:value() == 804)
  test.assert(packet_receiver_hook_decode_calls == 1,
    "child thread decoded more than the surviving packet")
  from_host.tx:send(8040)
  from_host.tx:close()

  -- Wait for host confirmation that all sends to worker_receiver have finished
  -- before defer worker_receiver:close() runs.
  test.assert(ctrl_rx:receive() == 2)
  return 8040
end

function test_packet_receiver_cross_thread_endpoint_handoff_and_coalescing(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    local host_receiver = async.packet_receiver()
    runtime_test.cleanup(function () host_receiver:close() end)
    local ready_tx, ready_rx = packet_receiver_thread.channel<|integer|>(1)
    local ctrl_tx, ctrl_rx = packet_receiver_thread.channel<|integer|>(2)
    runtime_test.cleanup(function ()
      ready_tx:close()
      ready_rx:close()
      ctrl_tx:close()
      ctrl_rx:close()
    end)

    local worker = packet_receiver_thread.spawn_three(
      packet_receiver_thread_worker,
      async.TransferValue.is_pointer(host_receiver:handle()),
      ready_tx,
      ctrl_rx)
    runtime_test.cleanup(function ()
      worker:cancel()
      worker:join()
    end)

    test.assert(ready_rx:receive() == 1)
    local duplex_pkt = host_receiver:wait_packet()
    local duplex: PacketReceiverDuplexEnvelope = duplex_pkt:decode()
    test.assert(duplex.ordinal == 802 and duplex.probe:value() == 802)
    test.assert(packet_receiver_hook_decode_calls == 1,
      "host decoded displaced cross-thread packet")
    test.assert(duplex.inbox:receive() == 8020)
    duplex.reply:send("host-ack-8020")
    duplex.reply:close()
    duplex.inbox:close()

    local handle_pkt = host_receiver:wait_packet()
    -- The sent Packet payload was an explicit pointer policy; decoding
    -- publishes the borrowed lightuserdata address, not the policy wrapper.
    local worker_handle = handle_pkt:decode() as foreign *void

    local host_disp_pkt, host_disp_rx = make_sender_packet(803)
    defer host_disp_rx:close()
    local host_live_pkt, host_live_rx = make_sender_packet(804)
    defer host_live_rx:close()

    async.send_packet(worker_handle, host_disp_pkt)
    test.assert(not host_disp_rx:is_closed())
    async.send_packet(worker_handle, host_live_pkt)
    test.assert(host_disp_rx:is_closed(),
      "displaced packet sent to worker thread did not auto-close its peer Receiver")

    ctrl_tx:send(1)
    test.assert(host_live_rx:receive() == 8040)
    ctrl_tx:send(2)

    case worker:join()
    when succeeded(code) then test.assert(code == 8040)
    else raise "cross-thread PacketReceiver worker did not succeed"
    end
    host_receiver:close()
  end)
end

local packet_receiver_remote_inbox: async.PacketReceiver? = nil
local packet_receiver_remote_worker: async.Task<|integer, value|>? = nil

function packet_receiver_remote_initialized(): boolean
  return packet_receiver_remote_inbox ~= nil
end

function packet_receiver_remote_bootstrap(host_raw: value): foreign *void
  local host_handle = host_raw as foreign *void
  packet_receiver_reset_hook_counts()
  local owner = async.packet_receiver()
  packet_receiver_remote_inbox = owner
  packet_receiver_remote_worker = async.run<|integer, value|>(function (): integer
    -- 1. Receive the surviving duplex packet sent by the host (after the host
    -- replaced an earlier packet in owner's slot).
    local from_host_pkt = owner:wait_packet()
    local from_host: PacketReceiverDuplexEnvelope = from_host_pkt:decode()
    test.assert(from_host.ordinal == 902 and from_host.probe:value() == 902)
    test.assert(packet_receiver_hook_decode_calls == 1,
      "independent state decoded displaced packet")
    local number = from_host.inbox:receive()
    from_host.inbox:close()

    -- 2. Send a displaced packet followed by a surviving endpoint packet back
    -- to the host's PacketReceiver before acknowledging on from_host.reply so
    -- the host waits until replacement has completed.
    local remote_disp_pkt, remote_disp_rx = make_sender_packet(903)
    defer remote_disp_rx:close()
    local remote_live_pkt, remote_live_rx = make_sender_packet(904)
    defer remote_live_rx:close()
    async.send_packet(host_handle, remote_disp_pkt)
    test.assert(not remote_disp_rx:is_closed())
    async.send_packet(host_handle, remote_live_pkt)
    test.assert(remote_disp_rx:is_closed(),
      "independent-state replacement in host PacketReceiver did not close peer")

    from_host.reply:send("remote-ack-" .. number)
    from_host.reply:close()
    -- 3. Wait for the stop packet carrying the quiescence Receiver, wait until
    -- the host signals that its final send_packet has returned, and only then
    -- close owner.
    local stop_pkt = owner:wait_packet()
    local stop_env: PacketReceiverReceiverEnvelope = stop_pkt:decode()
    test.assert(stop_env.ordinal == 905 and packet_receiver_hook_decode_calls == 2)
    local stop_code = stop_env.rx:receive()
    stop_env.rx:close()
    owner:close()
    packet_receiver_gc.collect()
    return remote_live_rx:receive() + stop_code
  end)
  return owner:handle()
end

function packet_receiver_remote_drive(): integer
  async.loop()
  local worker = packet_receiver_remote_worker as async.Task<|integer, value|>
  case worker:status()
  when succeeded(total) then return total
  when failed(failure) then failure:raise()
  else raise "independent-state PacketReceiver worker did not succeed"
  end
  return 0
end

function test_packet_receiver_independent_lua_state_endpoint_handoff(
    _context: test.Context)
  runtime_test.run(function ()
    packet_receiver_reset_hook_counts()
    test.assert(not packet_receiver_remote_initialized(),
      "host module unexpectedly owns an independent-state PacketReceiver")

    local host_receiver = async.packet_receiver()
    runtime_test.cleanup(function () host_receiver:close() end)
    local state = packet_receiver_lua.new()
    runtime_test.cleanup(function () state:close() end)

    local remote_handle = packet_receiver_unwrap_handle(state:run_async([[
      package.path, package.cpath = '', ''
      return require('async.tests').packet_receiver_remote_bootstrap(...)
    ]], "=packet-receiver-bootstrap",
      async.TransferValue.is_pointer(host_receiver:handle())))

    -- Before driving the remote state's loop, send a displaced packet and then
    -- a live duplex packet to remote_handle.
    local host_disp_pkt, host_disp_rx = make_sender_packet(901)
    defer host_disp_rx:close()
    async.send_packet(remote_handle, host_disp_pkt)
    test.assert(not host_disp_rx:is_closed())

    local reply_tx, reply_rx = packet_receiver_thread.channel<|string|>(1)
    defer reply_rx:close()
    local inbox_tx, inbox_rx = packet_receiver_thread.channel<|integer|>(1)
    defer inbox_tx:close()
    local host_duplex_pkt = packet_receiver_transfer.Packet.from_value(
      PacketReceiverDuplexEnvelope(
        902, PacketReceiverHookProbe.new(902), reply_tx, inbox_rx))
    async.send_packet(remote_handle, host_duplex_pkt)
    test.assert(host_disp_rx:is_closed() and packet_receiver_hook_decode_calls == 0,
      "replacing packet in independent-state PacketReceiver did not close peer")

    local driving = async.run<|integer, value|>(function (): integer
      local result = state:run_async([[
        return require('async.tests').packet_receiver_remote_drive()
      ]], "=packet-receiver-drive")
      case result
      when is_integer(number) then return number
      else raise "expected integer result from packet_receiver_remote_drive"
      end
    end)
    task_support.cleanup_task(driving, "independent-state PacketReceiver driver")

    inbox_tx:send(99)
    test.assert(reply_rx:receive() == "remote-ack-99")

    local from_remote_pkt = host_receiver:wait_packet()
    local from_remote: PacketReceiverSenderEnvelope = from_remote_pkt:decode()
    test.assert(from_remote.ordinal == 904 and from_remote.probe:value() == 904)
    test.assert(packet_receiver_hook_decode_calls == 1,
      "host decoded displaced packet from independent state")

    local done_tx, done_rx = packet_receiver_thread.channel<|integer|>(1)
    defer done_tx:close()
    local stop_pkt = packet_receiver_transfer.Packet.from_value(
      PacketReceiverReceiverEnvelope(
        905, PacketReceiverHookProbe.new(905), done_rx))
    async.send_packet(remote_handle, stop_pkt)
    from_remote.tx:send(9000)
    from_remote.tx:close()
    -- Signal only after async.send_packet(remote_handle, stop_pkt) has returned.
    done_tx:send(42)

    case async.join(driving)
    when succeeded(total) then test.assert(total == 9042)
    else raise "independent-state PacketReceiver driver failed"
    end
    test.assert(not packet_receiver_remote_initialized(),
      "remote PacketReceiver leaked into host module instance")

    -- The remote state's module retains its closed PacketReceiver until
    -- state:close(); late sends must fail with "receiver is closed" and
    -- preserve the caller's Packet.
    local late_pkt, late_rx = make_sender_packet(906)
    defer late_pkt:close()
    defer late_rx:close()
    packet_receiver_expect_error(function ()
      async.send_packet(remote_handle, late_pkt)
    end, "closed")
    test.assert(not late_rx:is_closed(),
      "late send to closed remote PacketReceiver consumed the caller's Packet")

    state:close()
    host_receiver:close()
  end)
end
