-- Public fixed-arity contracts under controlled terminal publication order.
-- Each worker waits on its own channel, so results depend on explicit release
-- rather than timer delays. The same cases exercise each positional listener.
local record CoverageAsyncMatrixOperand
  const task: async.Task
  const release: function (value): ()
  const close: function (): ()
end

local record CoverageAsyncMatrixOutcome
  const position: integer
  const status: async.TaskStatus?
  const payload: value
end

local function coverage_async_matrix_operand(fails: boolean): CoverageAsyncMatrixOperand
  local send, receive, close = async.channel<|value|>()
  const task = async.run<|value, value|>(function (): value
    const result = receive()
    if fails then raise result end
    return result
  end)
  runtime_test.cleanup(close)
  task_support.cleanup_task(task, "combinator matrix worker cleanup")
  return CoverageAsyncMatrixOperand(task, send, close)
end

local function coverage_async_matrix_operands(count: integer,
                                              fails: boolean): {CoverageAsyncMatrixOperand}
  const result: {CoverageAsyncMatrixOperand} = {}
  for position = 1, count do
    result[position] = coverage_async_matrix_operand(fails)
  end
  for position = 1, count do support.wait_until_waiting(result[position].task) end
  return result
end

local function coverage_async_matrix_tasks(operands: {CoverageAsyncMatrixOperand}): {async.Task}
  const result: {async.Task} = {}
  for position = 1, #operands do result[position] = operands[position].task end
  return result
end

local function coverage_async_matrix_retire(operands: {CoverageAsyncMatrixOperand})
  for position = 1, #operands do
    task_support.cancel_and_join_task(operands[position].task, "matrix loser cleanup")
    operands[position].close()
  end
end

local function coverage_async_matrix_assert_status(status: async.TaskStatus,
                                                  mode: integer, label: string)
  local cancelled, reason? = status:has_cancelled()
  test.assert(cancelled == (mode == 3), "status inspector changed its cancellation result")
  if mode ~= 3 then test.assert(reason == nil, "non-cancelled status retained a reason") end
  case status
  when succeeded(payload) then
    test.assert(mode == 1 and payload == label, "race changed its success payload")
  when failed(failure) then
    test.assert(mode == 2 and failure.error == label and #failure.traceback > 0,
                "combinator changed its failure or discarded the traceback")
  when cancelled(reason) then
    test.assert(mode == 3, "combinator changed the terminal status")
    case reason
    when simple(message) then test.assert(message == label, "combinator changed cancellation")
    else raise "matrix cancellation lost its simple reason"
    end
  else raise "combinator returned a nonterminal status"
  end
end

local function coverage_async_matrix_settle(operand: CoverageAsyncMatrixOperand,
                                           mode: integer, label: string)
  if mode == 3 then operand.task:cancel(async.CancellationReason.simple(label))
  else operand.release(label) end
  coverage_async_matrix_assert_status(async.join(operand.task), mode, label)
end

local function coverage_async_matrix_any(tasks: {async.Task}): CoverageAsyncMatrixOutcome
  if #tasks == 2 then
    case async.any_two(tasks[1], tasks[2])
    when first(payload) then return CoverageAsyncMatrixOutcome(1, nil, payload)
    when second(payload) then return CoverageAsyncMatrixOutcome(2, nil, payload)
    when none() then return CoverageAsyncMatrixOutcome(0, nil, nil)
    end
  elseif #tasks == 3 then
    case async.any_three(tasks[1], tasks[2], tasks[3])
    when first(payload) then return CoverageAsyncMatrixOutcome(1, nil, payload)
    when second(payload) then return CoverageAsyncMatrixOutcome(2, nil, payload)
    when third(payload) then return CoverageAsyncMatrixOutcome(3, nil, payload)
    when none() then return CoverageAsyncMatrixOutcome(0, nil, nil)
    end
  elseif #tasks == 4 then
    case async.any_four(tasks[1], tasks[2], tasks[3], tasks[4])
    when first(payload) then return CoverageAsyncMatrixOutcome(1, nil, payload)
    when second(payload) then return CoverageAsyncMatrixOutcome(2, nil, payload)
    when third(payload) then return CoverageAsyncMatrixOutcome(3, nil, payload)
    when fourth(payload) then return CoverageAsyncMatrixOutcome(4, nil, payload)
    when none() then return CoverageAsyncMatrixOutcome(0, nil, nil)
    end
  elseif #tasks == 5 then
    case async.any_five(tasks[1], tasks[2], tasks[3], tasks[4], tasks[5])
    when first(payload) then return CoverageAsyncMatrixOutcome(1, nil, payload)
    when second(payload) then return CoverageAsyncMatrixOutcome(2, nil, payload)
    when third(payload) then return CoverageAsyncMatrixOutcome(3, nil, payload)
    when fourth(payload) then return CoverageAsyncMatrixOutcome(4, nil, payload)
    when fifth(payload) then return CoverageAsyncMatrixOutcome(5, nil, payload)
    when none() then return CoverageAsyncMatrixOutcome(0, nil, nil)
    end
  end
  raise "unsupported matrix arity"
end

local function coverage_async_matrix_race(tasks: {async.Task}): CoverageAsyncMatrixOutcome
  if #tasks == 2 then
    case async.race_two(tasks[1], tasks[2])
    when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
    when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
    end
  elseif #tasks == 3 then
    case async.race_three(tasks[1], tasks[2], tasks[3])
    when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
    when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
    when third(status) then return CoverageAsyncMatrixOutcome(3, status, nil)
    end
  elseif #tasks == 4 then
    case async.race_four(tasks[1], tasks[2], tasks[3], tasks[4])
    when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
    when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
    when third(status) then return CoverageAsyncMatrixOutcome(3, status, nil)
    when fourth(status) then return CoverageAsyncMatrixOutcome(4, status, nil)
    end
  elseif #tasks == 5 then
    case async.race_five(tasks[1], tasks[2], tasks[3], tasks[4], tasks[5])
    when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
    when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
    when third(status) then return CoverageAsyncMatrixOutcome(3, status, nil)
    when fourth(status) then return CoverageAsyncMatrixOutcome(4, status, nil)
    when fifth(status) then return CoverageAsyncMatrixOutcome(5, status, nil)
    end
  end
  raise "unsupported matrix arity"
end

local function coverage_async_matrix_all(tasks: {async.Task}): {value}
  if #tasks == 2 then
    local first, second = async.all_two(tasks[1], tasks[2])
    return {first, second}
  elseif #tasks == 3 then
    local first, second, third = async.all_three(tasks[1], tasks[2], tasks[3])
    return {first, second, third}
  elseif #tasks == 4 then
    local first, second, third, fourth = async.all_four(tasks[1], tasks[2], tasks[3], tasks[4])
    return {first, second, third, fourth}
  elseif #tasks == 5 then
    local first, second, third, fourth, fifth = async.all_five(tasks[1], tasks[2], tasks[3], tasks[4], tasks[5])
    return {first, second, third, fourth, fifth}
  end
  raise "unsupported matrix arity"
end

local function coverage_async_matrix_rejection(tasks: {async.Task}): CoverageAsyncMatrixOutcome
  do
    coverage_async_matrix_all(tasks)
  catch
    if error is async.AllTwoError then
      case error as async.AllTwoError
      when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
      when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
      end
    elseif error is async.AllThreeError then
      case error as async.AllThreeError
      when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
      when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
      when third(status) then return CoverageAsyncMatrixOutcome(3, status, nil)
      end
    elseif error is async.AllFourError then
      case error as async.AllFourError
      when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
      when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
      when third(status) then return CoverageAsyncMatrixOutcome(3, status, nil)
      when fourth(status) then return CoverageAsyncMatrixOutcome(4, status, nil)
      end
    elseif error is async.AllFiveError then
      case error as async.AllFiveError
      when first(status) then return CoverageAsyncMatrixOutcome(1, status, nil)
      when second(status) then return CoverageAsyncMatrixOutcome(2, status, nil)
      when third(status) then return CoverageAsyncMatrixOutcome(3, status, nil)
      when fourth(status) then return CoverageAsyncMatrixOutcome(4, status, nil)
      when fifth(status) then return CoverageAsyncMatrixOutcome(5, status, nil)
      end
    else raise end
  end
  raise "all unexpectedly accepted a rejected operand"
end

local function coverage_async_matrix_waiter(call: function (): (CoverageAsyncMatrixOutcome)): async.Task
  const task = async.run<|value, value|>(function (): value return call() end)
  task_support.cleanup_task(task, "matrix waiter cleanup")
  support.wait_until_waiting(task)
  return task
end

local function coverage_async_matrix_result(task: async.Task): CoverageAsyncMatrixOutcome
  return support.success_payload(async.join(task)) as CoverageAsyncMatrixOutcome
end

function test_coverage_async_matrix_any_terminal_failures(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected matrix Task failure diagnostic")
    const failure = support.failing("matrix-terminal-failure")
    task_support.cleanup_task(failure, "matrix terminal failure cleanup")
    coverage_async_matrix_assert_status(async.join(failure), 2, "matrix-terminal-failure")
    for arity = 2, 5 do
      const tasks: {async.Task} = {}
      for position = 1, arity do tasks[position] = failure end
      test.assert(coverage_async_matrix_any(tasks).position == 0,
                  "any did not reject all already-failed operands")
    end
    context:log("END expected matrix Task failure diagnostic")
  end)
end

function test_coverage_async_matrix_any_live_success_positions(_context: test.Context)
  runtime_test.run(function ()
    for arity = 2, 5 do
      for winner = 1, arity do
        const operands = coverage_async_matrix_operands(arity, false)
        const tasks = coverage_async_matrix_tasks(operands)
        const waiter = coverage_async_matrix_waiter(function (): CoverageAsyncMatrixOutcome
          return coverage_async_matrix_any(tasks)
        end)
        const label = "winner-" .. arity .. "-" .. winner
        coverage_async_matrix_settle(operands[winner], 1, label)
        const outcome = coverage_async_matrix_result(waiter)
        test.assert(outcome.position == winner and outcome.payload == label,
                    "any lost the released operand's position or payload")
        for position = 1, arity do
          if position ~= winner then
            test.assert(not operands[position].task:status():has_finished(),
                        "any cancelled an unrelated pending operand")
          end
        end
        coverage_async_matrix_retire(operands)
      end
    end
  end)
end

function test_coverage_async_matrix_any_live_all_rejections(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected matrix Task failure diagnostics")
    for mode = 2, 3 do
      for arity = 2, 5 do
        for final = 1, arity do
          const operands = coverage_async_matrix_operands(arity, mode == 2)
          const tasks = coverage_async_matrix_tasks(operands)
          const waiter = coverage_async_matrix_waiter(function (): CoverageAsyncMatrixOutcome
            return coverage_async_matrix_any(tasks)
          end)
          for position = 1, arity do
            if position ~= final then
              coverage_async_matrix_settle(operands[position], mode, "reject-" .. position)
              test.assert(not waiter:status():has_finished(),
                          "any returned none while an operand could still succeed")
            end
          end
          coverage_async_matrix_settle(operands[final], mode, "last-rejection")
          test.assert(coverage_async_matrix_result(waiter).position == 0,
                      "any retained a success after every operand rejected")
          coverage_async_matrix_retire(operands)
        end
      end
    end
    context:log("END expected matrix Task failure diagnostics")
  end)
end

function test_coverage_async_matrix_race_live_terminal_positions(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected matrix Task failure diagnostics")
    for mode = 1, 3 do
      for arity = 2, 5 do
        for winner = 1, arity do
          const operands = coverage_async_matrix_operands(arity, mode == 2)
          const tasks = coverage_async_matrix_tasks(operands)
          const waiter = coverage_async_matrix_waiter(function (): CoverageAsyncMatrixOutcome
            return coverage_async_matrix_race(tasks)
          end)
          const label = "race-" .. arity .. "-" .. winner
          coverage_async_matrix_settle(operands[winner], mode, label)
          const outcome = coverage_async_matrix_result(waiter)
          test.assert(outcome.position == winner, "race lost the terminal operand's position")
          coverage_async_matrix_assert_status(outcome.status, mode, label)
          for position = 1, arity do
            if position ~= winner then
              test.assert(not operands[position].task:status():has_finished(),
                          "race cancelled an unrelated pending operand")
            end
          end
          coverage_async_matrix_retire(operands)
        end
      end
    end
    context:log("END expected matrix Task failure diagnostics")
  end)
end

function test_coverage_async_matrix_all_terminal_failure_positions(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected matrix Task failure diagnostic")
    const failure = support.failing("matrix-all-terminal-failure")
    const succeeded = support.successful("retained-success")
    task_support.cleanup_task(failure, "matrix failure cleanup")
    task_support.cleanup_task(succeeded, "matrix success cleanup")
    async.join_two(failure, succeeded)
    for arity = 2, 5 do
      for rejected = 1, arity do
        const tasks: {async.Task} = {}
        for position = 1, arity do tasks[position] = succeeded end
        tasks[rejected] = failure
        const outcome = coverage_async_matrix_rejection(tasks)
        test.assert(outcome.position == rejected, "all changed the already-failed position")
        coverage_async_matrix_assert_status(outcome.status, 2, "matrix-all-terminal-failure")
      end
    end
    context:log("END expected matrix Task failure diagnostic")
  end)
end

function test_coverage_async_matrix_all_live_rejection_positions(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected matrix Task failure diagnostics")
    for mode = 2, 3 do
      for arity = 2, 5 do
        for rejected = 1, arity do
          const operands = coverage_async_matrix_operands(arity, mode == 2)
          const tasks = coverage_async_matrix_tasks(operands)
          const waiter = coverage_async_matrix_waiter(function (): CoverageAsyncMatrixOutcome
            return coverage_async_matrix_rejection(tasks)
          end)
          const label = "all-rejection-" .. rejected
          coverage_async_matrix_settle(operands[rejected], mode, label)
          const outcome = coverage_async_matrix_result(waiter)
          test.assert(outcome.position == rejected, "all changed the live rejecting position")
          coverage_async_matrix_assert_status(outcome.status, mode, label)
          for position = 1, arity do
            if position ~= rejected then
              test.assert(not operands[position].task:status():has_finished(),
                          "all cancelled an unrelated pending operand")
            end
          end
          coverage_async_matrix_retire(operands)
        end
      end
    end
    context:log("END expected matrix Task failure diagnostics")
  end)
end

function test_coverage_async_matrix_all_live_completion_positions(_context: test.Context)
  runtime_test.run(function ()
    for arity = 2, 5 do
      for final = 1, arity do
        const operands = coverage_async_matrix_operands(arity, false)
        const tasks = coverage_async_matrix_tasks(operands)
        const waiter = coverage_async_matrix_waiter(function (): CoverageAsyncMatrixOutcome
          return CoverageAsyncMatrixOutcome(0, nil, coverage_async_matrix_all(tasks))
        end)
        for position = 1, arity do
          if position ~= final then
            coverage_async_matrix_settle(operands[position], 1, "result-" .. position)
            test.assert(not waiter:status():has_finished(), "all completed with a pending operand")
          end
        end
        coverage_async_matrix_settle(operands[final], 1, "result-" .. final)
        const results = coverage_async_matrix_result(waiter).payload as {value}
        test.assert(#results == arity, "all changed its result count")
        for position = 1, arity do
          test.assert(results[position] == "result-" .. position, "all reordered completion values")
        end
        coverage_async_matrix_retire(operands)
      end
    end
  end)
end

function test_coverage_async_matrix_channel_exact_delimiter_boundary(_context: test.Context)
  runtime_test.run(function ()
    local reader, writer = async.reader_writer_channel()
    runtime_test.cleanup(function () writer:close(); reader:close() end)
    const producer = async.run(function (): nil
      writer:write("prefix")
      writer:write("suffix\n")
    end)
    task_support.cleanup_task(producer, "exact delimiter producer cleanup")
    test.assert(reader:read_until("\n", false) == "prefixsuffix\n",
                "single-byte delimiter lost a preceding complete chunk")
    test.assert(async.join(producer):has_succeeded(), "delimiter producer did not finish")
    reader:close()
    test.assert(reader:read_until("\n", false) == nil,
                "exact delimiter boundary retained an unread suffix after close")
  end)
end

function test_coverage_async_matrix_subscription_batch_terminals(_context: test.Context)
  runtime_test.run(function ()
    for mode = 1, 3 do
      local stops, closes = 0, 0
      const stream = async.BufferedSubscription<|value, value|>(
        function (_publish, reject, finish): async.SubscriptionActions<|value|>
          const actions = async.SubscriptionActions<|value|>(
            function () stops = stops + 1 end,
            function (drain: function (): (async.SubscriptionBatch<|value|>))
              closes = closes + 1
              test.assert(drain().count == 0, "terminal batch retained an unread item")
            end)
          if mode == 1 then test.assert(reject(false), "false terminal error was rejected")
          elseif mode == 2 then test.assert(finish(), "terminal end was rejected") end
          return actions
        end)
      defer stream:close()
      if mode == 3 then stream:close() end
      for _ = 1, 2 do
        case stream:next_batch()
        when error(failure) then
          test.assert(mode == 1 and failure == false, "batch changed its false error payload")
        when ended() then test.assert(mode == 2, "batch changed its end outcome")
        when closed() then test.assert(mode == 3, "batch changed its close outcome")
        else raise "terminal subscription unexpectedly returned a batch"
        end
      end
      stream:close()
      stream:close()
      test.assert(stops == 1 and closes == 1, "terminal cleanup did not run exactly once")
    end
  end)
end

function test_coverage_async_matrix_coalescing_stop_keeps_latest(_context: test.Context)
  runtime_test.run(function ()
    local stops, closes = 0, 0
    const stream = async.CoalescingSubscription<|value, value|>(
      function (publish, _reject, _finish): async.SubscriptionActions<|value|>
        const actions = async.SubscriptionActions<|value|>(
          function () stops = stops + 1 end,
          function (drain: function (): (async.SubscriptionBatch<|value|>))
            closes = closes + 1
            test.assert(drain().count == 0, "consumed latest item survived cleanup")
          end)
        test.assert(publish("old") and publish("latest"), "live source rejected publication")
        return actions
      end)
    defer stream:close()
    stream:stop()
    stream:stop()
    test.assert(stops == 1 and closes == 0, "stop changed its idempotence or closed the source")
    case stream:next()
    when item(payload) then test.assert(payload == "latest", "stop discarded the latest item")
    else raise "stop delivered its terminal outcome ahead of the buffered item"
    end
    case stream:next() when ended() then else raise "stopped source did not end" end
    stream:close()
    test.assert(stops == 1 and closes == 1, "close repeated stop or omitted cleanup")
    case stream:next() when closed() then else raise "closed source did not remain closed" end
  end)
end
