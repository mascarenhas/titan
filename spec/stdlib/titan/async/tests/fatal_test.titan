local rollback_gc = import "titan.gc"

-- These cases deliberately fail a Runtime and verify its next session.
-- The callback's raw error and original traceback must survive generic E.
local record FatalMarker
  id: integer
  source_trace: string
end

local function fatal_test_fatal_origin(marker: FatalMarker)
  raise marker
end


local function fatal_test_later(milliseconds: integer, action: function (): ())
  local timer = uv.timer_t.new()
  local handle = timer:as_handle_t()
  local closed = function (_unused1: uv.handle_t) action() end
  local fired = function (_unused1: uv.timer_t) uv.close(handle, closed) end
  test.assert(uv.timer_init(async.current_loop(), timer) == 0, "timer init failed")
  local status = uv.timer_start(timer, fired, milliseconds, 0)
  if status < 0 then uv.close(handle); raise "timer start failed" end
end


local function fatal_test_terminal_failure(marker: FatalMarker, fatal: function (value, string): ())
  do
    fatal_test_fatal_origin(marker)
  catch
    marker.source_trace = traceback
    fatal(error, traceback)
    raise
  end
end


local function fatal_test_drive_failure(marker: FatalMarker)
  local caught = false
  local original: value = nil
  local trace = ""
  do
    async.loop()
  catch
    caught = true
    original = error
    trace = traceback
  end
  test.assert(caught, "driver did not report callback failure")
  test.assert(original == marker, "driver replaced original failure")
  test.assert(trace == marker.source_trace, "driver replaced original traceback")
end


local function fatal_test_fs_cleanup(done: function (): (), resolve: function (integer): (), fatal: function (value, string): ())
  local request = uv.fs_t.new()
  local callback = function (_unused1: uv.fs_t)
    local status = uv.fs_get_result(request)
    uv.fs_req_cleanup(request)
    do
      test.assert(status == 0, "cleanup stat failed")
      done()
      resolve(17)
    catch
      fatal(error, traceback)
      raise
    end
  end
  test.assert(uv.fs_stat(async.current_loop(), request, ".", callback) == 0, "stat submission failed")
end

function test_ready_queue_recovers_after_shared_wake_failure(context: test.Context)
  local marker = FatalMarker(196, "")
  local blocker = uv.timer_t.new()
  local trigger = uv.timer_t.new()
  local cleanup_started, cleanup_closed = false, false
  local keeper = async.run<|nil, value|>(function (): nil
    test.assert(uv.timer_init(async.current_loop(), blocker) == 0, "blocker init failed")
    test.assert(uv.timer_start(blocker, function (_: uv.timer_t) end, 60000, 60000) == 0,
        "blocker start failed")
    defer do
      cleanup_started = true
      async.await_cleanup<|nil, nil|>(function (resolve, _reject, fatal)
        uv.timer_close(blocker, function (_: uv.timer_t)
          cleanup_closed = true
          do resolve(nil) catch fatal(error, traceback); raise end
        end)
      end)
    end
    while true do async.yield() end
    return nil
  end)
  local origin = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (_resolve, _reject, fatal)
      test.assert(uv.timer_init(async.current_loop(), trigger) == 0, "failure trigger init failed")
      local fired = function (owner: uv.timer_t)
        uv.timer_close(owner)
        -- Deliberate fault injection: ordinary clients may only manage their
        -- own handles on this borrowed loop. Close the sole other timer to
        -- make Runtime wake rearming fail with queued work still outstanding.
        local broken = 0
        uv.walk(async.current_loop(), function (handle: uv.handle_t, _: value)
          case handle
          when timer(timer_owner) then
            if timer_owner ~= blocker and timer_owner ~= trigger and not uv.is_closing(handle) then
              uv.timer_close(timer_owner)
              broken = broken + 1
            end
          else
          end
        end)
        test.assert(broken == 1, "fault injection did not find one shared wake")
        fatal_test_terminal_failure(marker, fatal)
      end
      test.assert(uv.timer_start(trigger, fired, 0, 0) == 0, "failure trigger start failed")
    end)
    return nil
  end)
  local queued: {async.Task<|nil, nil|>} = {}
  for index = 1, 130 do
    queued[index] = async.run<|nil, nil|>(function (): nil
      async.yield()
      return nil
    end)
  end
  fatal_test_drive_failure(marker)
  test.assert(cleanup_started and cleanup_closed,
      "failed shared wake stranded cleanup behind another referenced handle")
  test.assert(keeper:status():has_cancelled() and origin:status():has_finished(),
      "failed shared wake lost its active Tasks")
  for index = 1, #queued do
    test.assert(queued[index]:status():has_finished(), "remaining ready entry was lost")
  end
  runtime_test.run(function () async.yield() end)
end


local function fatal_test_exact_orphan_wait()
  local marker = FatalMarker(2, "")
  local resolve_second: (function (integer): ())? = nil
  local first_waiting = false
  local second_waiting = false
  local second_callback = false
  local second_result = 0
  async.run<|value, value|>(function (): value
    defer do
      local result = async.await_cleanup<|value, string|>(function (resolve: function (value): (), _unused1: function (string): (), _unused2: function (value, string): ())
        resolve_second(99)
        resolve(nil)
      end)
      case result
      when error(message) then raise message
      else
      end
    end
    async.await<|integer, string|>(function (_unused1: function (integer): (), _unused2: function (string): (), _unused3: function (value, string): ())
      first_waiting = true
    end)
    return nil
  end)
  async.run<|value, value|>(function (): value
    defer do
      local result = async.await_cleanup<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), fatal: function (value, string): ())
        fatal_test_fs_cleanup(function () second_callback = true end, resolve, fatal)
      end)
      case result
      when success(value) then second_result = value
      when error(message) then raise message
      end
    end
    async.await<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), _unused2: function (value, string): ())
      resolve_second = resolve
      second_waiting = true
    end)
    return nil
  end)
  async.run<|value, value|>(function (): value
    while not first_waiting or not second_waiting do async.yield() end
    async.await<|integer, string|>(function (_unused1: function (integer): (), _unused2: function (string): (), fatal: function (value, string): ())
      fatal_test_later(1, function () fatal_test_terminal_failure(marker, fatal) end)
    end)
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(second_callback, "new cleanup request never completed")
  test.assert(second_result == 17, "orphan sweep retired a newer cleanup Wait")
end


local function fatal_test_cleanup_timer(sticky: boolean)
  local marker = FatalMarker(3, "")
  local delivered = false
  local result_value = 0
  local task = async.run<|value, value|>(function (): value
    if sticky then
      async.running():cancel(async.CancellationReason<|value|>.complex("sticky reason"))
    end
    defer do
      local result = async.await_cleanup<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), fatal: function (value, string): ())
        fatal_test_later(3, function ()
          do
            delivered = true
            resolve(29)
          catch
            fatal(error, traceback)
            raise
          end
        end)
      end)
      case result
      when success(value) then result_value = value
      when error(message) then raise message
      end
    end
    async.await_cleanup<|integer, string|>(function (_unused1: function (integer): (), _unused2: function (string): (), fatal: function (value, string): ())
      fatal_test_later(1, function () fatal_test_terminal_failure(marker, fatal) end)
    end)
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(delivered and result_value == 29, "failure sweep suppressed accepted cleanup timer")
  if sticky then
    local cancelled, reason? = task:status():has_cancelled()
    test.assert(cancelled, "prior cancellation was lost")
    case reason as async.CancellationReason
    when complex(payload) then test.assert(payload == "sticky reason", "first cancellation reason changed")
    else raise "wrong cancellation reason"
    end
  else
    case task:status()
    when failed(failure) then test.assert(failure.error == marker, "uncancelled fatal origin did not retain failure")
    else raise "fatal origin did not fail" end
  end
end


local function fatal_test_settled_orphan_wait()
  local marker = FatalMarker(6, "")
  local resolve_second: (function (integer): ())? = nil
  local first_waiting = false
  local second_waiting = false
  local second_result = 0
  async.run<|value, value|>(function (): value
    -- This call runs on the Task coroutine, so settlement of the other Task
    -- queues delivery while retaining that exact Wait in WAIT_SETTLED.
    defer resolve_second(43)
    async.await<|integer, string|>(function (_unused1: function (integer): (), _unused2: function (string): (), _unused3: function (value, string): ())
      first_waiting = true
    end)
    return nil
  end)
  async.run<|value, value|>(function (): value
    local result = async.await_cleanup<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), _unused2: function (value, string): ())
      resolve_second = resolve
      second_waiting = true
    end)
    case result
    when success(value) then second_result = value
    when error(message) then raise message
    end
    return nil
  end)
  async.run<|value, value|>(function (): value
    while not first_waiting or not second_waiting do async.yield() end
    async.await<|integer, string|>(function (_unused1: function (integer): (), _unused2: function (string): (), fatal: function (value, string): ())
      fatal_test_later(1, function () fatal_test_terminal_failure(marker, fatal) end)
    end)
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(second_result == 43, "orphan sweep retired a same-identity settled Wait")
end


local function fatal_test_after_settlement()
  local marker = FatalMarker(4, "")
  local second = FatalMarker(400, "")
  local callback_completed = false
  local result_value = 0
  async.run<|value, value|>(function (): value
    async.await<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), fatal: function (value, string): ())
      fatal_test_later(1, function ()
        resolve(1)
        do
          fatal_test_fatal_origin(marker)
        catch
          marker.source_trace = traceback
          fatal(error, traceback)
          fatal(second, "secondary failure trace")
          raise
        end
      end)
    end)
    local result = async.await_cleanup<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), fatal: function (value, string): ())
      fatal_test_fs_cleanup(function () callback_completed = true end, resolve, fatal)
    end)
    case result
    when success(value) then result_value = value
    when error(message) then raise message
    end
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(callback_completed and result_value == 17, "late fatal changed the newer cleanup Wait")
end


local function fatal_test_cancellable_fatal(sticky: boolean)
  local marker = FatalMarker(7, "")
  local owner: async.Task<|value, value|>? = nil
  local observed = false
  local cleaned = false
  owner = async.run<|value, value|>(function (): value
    defer do
      local result = async.await_cleanup<|integer, string|>(function (resolve: function (integer): (), _reject: function (string): (), fatal: function (value, string): ())
        fatal_test_later(2, function ()
          do
            cleaned = true
            resolve(1)
          catch
            fatal(error, traceback)
            raise
          end
        end)
      end)
      case result
      when error(message) then raise message
      else
      end
    end
    do
      async.await_cancellable<|integer, string|>(function (_resolve: function (integer): (), _reject: function (string): (), fatal: function (value, string): ()): uv.req_t?
        local request = uv.fs_t.new()
        local callback = function (_request: uv.fs_t)
          uv.fs_req_cleanup(request)
          if sticky then
            owner:cancel(async.CancellationReason<|value|>.complex("cancellable sticky"))
          end
          fatal_test_terminal_failure(marker, fatal)
        end
        test.assert(uv.fs_stat(async.current_loop(), request, ".", callback) == 0, "cancellable stat submission failed")
        return request:as_req_t()
      end)
    catch
      observed = error == marker
      raise
    end
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(observed and cleaned, "cancellable fatal failed raw handoff or cleanup shielding")
  if sticky then
    local cancelled, reason? = owner:status():has_cancelled()
    test.assert(cancelled, "cancellable first cancellation was lost")
    case reason as async.CancellationReason
    when complex(payload) then test.assert(payload == "cancellable sticky", "cancellable first reason changed")
    else raise "wrong cancellable reason"
    end
  else
    case owner:status()
    when failed(failure) then test.assert(failure.error == marker, "cancellable raw fatal did not remain failed")
    else raise "cancellable fatal origin did not fail" end
  end
end


local function fatal_test_registration_fatal(after_settle: boolean)
  local marker = FatalMarker(5, "")
  local returned = false
  local observed = false
  local reentered = false
  local result_value = 0
  marker.source_trace = "registration fatal trace"
  local task = async.run<|value, value|>(function (): value
    do
      local result = async.await_cleanup<|integer, string|>(function (resolve: function (integer): (), _unused1: function (string): (), fatal: function (value, string): ())
        if after_settle then resolve(31) end
        fatal(marker, marker.source_trace)
        returned = true
      end)
      case result
      when success(value) then result_value = value
      when error(message) then raise message
      end
    catch
      observed = error == marker
      reentered = not returned
      raise
    end
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(returned and not reentered, "registration fatal recursively entered the Task")
  if after_settle then
    test.assert(result_value == 31, "late inline fatal replaced settled cleanup result")
    local succeeded = task:status():has_succeeded()
    test.assert(succeeded, "late inline fatal changed the completed Task status")
  else
    test.assert(observed, "registration fatal entered generic E instead of raw exception")
    local failed = task:status():has_failed()
    test.assert(failed, "registration fatal origin did not remain failed")
  end
end


local function fatal_test_fresh_session()
  local task = async.run<|integer, value|>(function (): integer return 42 end)
  async.loop()
  local success, value? = task:status():has_succeeded()
  test.assert(success and value == 42, "failed Runtime leaked into next session")
end


function test_generic_await_fatal_during_registration(context: test.Context)
  context:log("BEGIN expected fatal callback diagnostics")
  fatal_test_registration_fatal(false)
  fatal_test_fresh_session()
  fatal_test_registration_fatal(true)
  fatal_test_fresh_session()
  context:log("END expected fatal callback diagnostics")
end

function test_generic_await_fatal_preserves_exact_cleanup_wait(context: test.Context)
  context:log("BEGIN expected fatal callback diagnostics")
  fatal_test_exact_orphan_wait()
  fatal_test_fresh_session()
  fatal_test_settled_orphan_wait()
  fatal_test_fresh_session()
  fatal_test_after_settlement()
  fatal_test_fresh_session()
  context:log("END expected fatal callback diagnostics")
end

function test_generic_await_fatal_shields_cleanup_and_first_cancellation(context: test.Context)
  context:log("BEGIN expected fatal callback diagnostics")
  fatal_test_cleanup_timer(false)
  fatal_test_fresh_session()
  fatal_test_cleanup_timer(true)
  fatal_test_fresh_session()
  fatal_test_cancellable_fatal(false)
  fatal_test_fresh_session()
  fatal_test_cancellable_fatal(true)
  fatal_test_fresh_session()
  context:log("END expected fatal callback diagnostics")
end

function test_subscription_callback_failure_drains_native_owner(context: test.Context)
  context:log("BEGIN expected persistent callback diagnostic")
  local reader_entered, callback_failed, cleanup_started, native_closed = false, false, false, false
  local returned_normally, cleanup_completed = false, false
  local task = async.run<|value, value|>(function (): value
    local stream = async.BufferedSubscription<|value, value|>(function (_emit: function (value): (boolean), _: function (value): (boolean), _end: function (): (boolean)): async.SubscriptionActions<|value|>
      local timer = uv.timer_t()
      local handle = timer:as_handle_t()
      local resolve_close: (function (value): ())? = nil
      local fail_close: (function (value, string): ())? = nil
      local on_closed = function (_: uv.handle_t)
        native_closed = true
        do resolve_close(nil)
        catch fail_close(error, traceback); raise end
      end
      local on_tick = function (_: uv.timer_t)
        test.assert(reader_entered, "producer callback ran before reader suspension")
        if not callback_failed then
          callback_failed = true
          -- No event or temporary native owner was created before this throw.
          raise "persistent producer callback failed"
        end
      end
      local result = async.SubscriptionActions<|value|>(function () uv.timer_stop(timer) end,
        function (drain: function (): (async.SubscriptionBatch<|value|>))
          cleanup_started = true
          test.assert(drain().count == 0, "failure created an event")
          async.await_cleanup<|value, value|>(function (resolve: function (value): (), _: function (value): (), fatal: function (value, string): ())
            resolve_close, fail_close = resolve, fatal
            uv.close(handle, on_closed)
          end)
          test.assert(native_closed, "cleanup returned before native close")
          cleanup_completed = true
        end)
      test.assert(uv.timer_init(async.current_loop(), timer) == 0, "producer timer init failed")
      local status = uv.timer_start(timer, on_tick, 0, 100)
      if status < 0 then uv.close(handle); raise status end
      return result
    end)
    defer stream:close()
    reader_entered = true
    stream:next()
    returned_normally = true
    return nil
  end)
  local caught = false
  do async.loop()
  catch caught = error == "persistent producer callback failed" end
  test.assert(caught and callback_failed, "loop lost the original producer callback failure")
  test.assert(cleanup_started and native_closed and cleanup_completed and not returned_normally,
      "callback failure stranded cleanup or returned a normal read")
  case task:status()
  when cancelled() then
  else raise "failed producer did not cancel its suspended reader" end
  fatal_test_fresh_session()
  context:log("END expected persistent callback diagnostic")
end


function test_generic_await_fatal_keeps_dependency_wakes_runnable(context: test.Context)
  context:log("BEGIN expected dependent-worker fatal diagnostic")
  local marker = FatalMarker(8, "inline fatal with dependent foreign work")
  local fixture = new_foreign_work_fixture(41)
  defer ffi.titan_async_work_fixture_destroy(fixture)
  local release_token = ffi.titan_async_work_fixture_release_token(fixture) as integer
  local suspended, work_submitted, cleaned = false, false, false
  async.run<|value, value|>(function (): value
    defer do
      release_foreign_work(release_token)
      cleaned = true
    end
    suspended = true
    async.suspend(async.ResumeToken("fatal dependent-worker cleanup"))
    return nil
  end)
  async.run<|value, value|>(function (): value
    work_submitted = true
    async.run_foreign(blocking_foreign_work, fixture as foreign *void)
    return nil
  end)
  async.run<|value, value|>(function (): value
    while not suspended or not work_submitted do async.yield() end
    async.await_cleanup<|integer, nil|>(function (resolve, _reject, fatal)
      resolve(1)
      fatal(marker, marker.source_trace)
    end)
    return nil
  end)
  fatal_test_drive_failure(marker)
  test.assert(cleaned and ffi.titan_async_work_fixture_result(fixture) == 42,
      "fatal shutdown discarded the Task wake needed to release foreign work")
  fatal_test_fresh_session()
  context:log("END expected dependent-worker fatal diagnostic")
end

-- Deliberate fault injection, not ordinary borrowed-loop handle management.
-- Exactly two Tasks enter the initial FIFO drain. The first reserves a wait;
-- the last closes the currently unarmed Runtime wake, then catches admission
-- failure before installing a shielded acknowledgment for its native close.
local record WakeRepair
  owner: uv.timer_t?
  loop: uv.loop_t?
  data: value
  ack: async.Completion<|WakeRepair, nil, nil|>?
  number: integer
  repaired: boolean
  closed: integer
end

local function capture_wake(repair: WakeRepair)
  repair.loop = async.current_loop()
  local count = 0
  uv.walk(repair.loop as uv.loop_t, function (handle: uv.handle_t, _: value)
    case handle
    when timer(owner) then
      count = count + 1
      repair.owner = owner
      repair.data = uv.timer_get_data(owner)
    else
    end
  end)
  test.assert(count == 1 and repair.owner ~= nil and repair.data ~= nil,
      "fault injection must capture the sole Runtime timer on the main thread")
end

local function break_wake(repair: WakeRepair)
  uv.timer_close(repair.owner as uv.timer_t, function (owner: uv.timer_t)
    local done = repair.ack as async.Completion<|WakeRepair, nil, nil|>
    local number = repair.number
    repair.ack = nil
    do
      test.assert(uv.timer_init(repair.loop as uv.loop_t, owner) == 0,
          "shared wake reinitialization failed")
      uv.timer_set_data(owner, repair.data)
      repair.closed = repair.closed + 1
      repair.repaired = true
      -- This outside-Task settlement synchronously resumes the injector. Its
      -- retry therefore executes in a peer Task and must enqueue once again.
      done:resolve(number, nil)
    catch done:fatal(number, error, traceback); raise end
  end)
end

local function start_repair_ack(
    done: async.Completion<|WakeRepair, nil, nil|>, number: integer): uv.req_t?
  local repair = done:context(number)
  repair.ack = done
  repair.number = number
  return nil
end

local function await_repair(repair: WakeRepair)
  local result = async.await_cleanup_with<|WakeRepair, nil, nil|>(repair, start_repair_ack)
  case result
  when success(_) then
  else raise "native repair acknowledgment failed" end
  test.assert(repair.repaired and repair.closed == 1,
      "injector resumed without its one completed native repair")
end

local function check_arm_failure(failure: value)
  test.assert(failure is async.OperationError, "wake rejection was not an OperationError")
  local operation = failure as async.OperationError
  test.assert(operation.operation == "runtime.timer.start" and operation.code == (uv.EINVAL as integer),
      "fault did not reject the exact shared-wake arm")
  test.assert(not async.is_closing(), "caught admission failure fatally closed the Runtime")
end

function test_peer_completion_wake_failure_rolls_back_then_retries(_context: test.Context)
  local repair = WakeRepair(nil, nil, nil, nil, 0, false, 0)
  local saved: async.Completion<|string, integer, string|>? = nil
  local number = 0
  local deliveries = 0
  local rejected = false
  local consumer = async.run<|nil, nil|>(function (): nil
    local result = async.await_with<|string, integer, string|>("original operation",
        function (done, operation_number): uv.req_t?
          saved = done
          number = operation_number
          return nil
        end)
    deliveries = deliveries + 1
    case result
    when error(message) then
      test.assert(message == "accepted retry", "failed attempt overwrote the retry outcome")
    else raise "failed success attempt was committed" end
    return nil
  end)
  local injector = async.run<|nil, nil|>(function (): nil
    test.assert(saved ~= nil and consumer:status():as_string() == "waiting", "consumer did not reserve its wait first")
    local done = saved as async.Completion<|string, integer, string|>
    break_wake(repair)
    do done:resolve(number, 17)
    catch check_arm_failure(error); rejected = true end
    test.assert(rejected and deliveries == 0 and consumer:status():as_string() == "waiting",
        "failed peer admission advanced the consumer")
    test.assert(done:context(number) == "original operation", "failed admission retired the operation")
    await_repair(repair)
    test.assert(not async.is_closing() and deliveries == 0, "repair changed the pending consumer")
    done:reject(number, "accepted retry")
    test.assert(deliveries == 0 and consumer:status():as_string() == "waiting", "peer retry delivered inline")
    return nil
  end)
  capture_wake(repair)
  async.loop()
  test.assert(rejected and deliveries == 1 and repair.closed == 1,
      "peer rollback/retry did not deliver exactly once")
  test.assert(consumer:status():has_succeeded() and injector:status():has_succeeded(),
      "peer rollback/retry failed or cancelled a Task")
end

local record PublicationItem
  id: integer
  disposed: boolean
end

local function rejected_publication(send: function (PublicationItem): (boolean),
    weak_roots: {value: value}): boolean
  local item = PublicationItem(1, false)
  weak_roots["rejected"] = item
  local rejected = false
  do send(item)
  catch
    check_arm_failure(error)
    rejected = true
    item.disposed = true
  end
  test.assert(rejected and item.disposed, "failed publication did not return producer ownership")
  return rejected
end

function test_subscription_wake_failure_restores_publication_and_reservation(_context: test.Context)
  local repair = WakeRepair(nil, nil, nil, nil, 0, false, 0)
  local publish: (function (PublicationItem): (boolean))? = nil
  local close_count = 0
  local stream = async.BufferedSubscription<|PublicationItem, nil|>(
      function (send, _fail, _finish): async.SubscriptionActions<|PublicationItem|>
        publish = send
        return async.SubscriptionActions<|PublicationItem|>(function () end,
            function (drain: function (): (async.SubscriptionBatch<|PublicationItem|>))
              close_count = close_count + 1
              test.assert(drain().count == 0, "closed subscription still owned a publication")
            end)
      end)
  local weak_roots: {value: value} = {}
  rollback_gc.weak(weak_roots)
  local accepted_item = PublicationItem(2, false)
  local deliveries = 0
  local rejected = false
  local consumer = async.run<|nil, nil|>(function (): nil
    defer stream:close()
    case stream:next_batch()
    when batch(items) then
      test.assert(items.count == 1 and items:get(1) == accepted_item,
          "failed publication leaked or retry duplicated an item")
      test.assert(rejected and weak_roots["rejected"] == nil, "failed publication retained producer ownership")
      deliveries = deliveries + 1
      accepted_item.disposed = true
    else raise "subscription retry did not deliver its exact batch" end
    return nil
  end)
  local injector = async.run<|nil, nil|>(function (): nil
    test.assert(stream:has_waiter() and consumer:status():as_string() == "waiting", "reader did not reserve its wait first")
    break_wake(repair)
    rejected = rejected_publication(publish, weak_roots)
    test.assert(rejected and deliveries == 0 and consumer:status():as_string() == "waiting",
        "failed publication advanced the reader")
    test.assert(stream:has_waiter(), "failed notification released the reader reservation")
    -- The helper's strong local is gone. Check before destructive draining:
    -- count-only rollback must not hide a stale item root in the backing array.
    rollback_gc.collect()
    rollback_gc.collect()
    test.assert(weak_roots["rejected"] == nil, "failed publication retained its rejected item")
    test.assert(stream:drain_pending().count == 0, "failed publication left an owned queue item")
    await_repair(repair)
    test.assert(not async.is_closing() and stream:has_waiter() and deliveries == 0,
        "repair lost the original pending reader")
    test.assert(publish(accepted_item), "repaired publication was not accepted")
    test.assert(stream:has_waiter() and deliveries == 0,
        "accepted peer publication released its reservation or delivered inline")
    return nil
  end)
  capture_wake(repair)
  async.loop()
  test.assert(rejected and deliveries == 1 and close_count == 1 and repair.closed == 1,
      "subscription rollback/retry did not retire exactly once")
  test.assert(weak_roots["rejected"] == nil and accepted_item.disposed and not stream:has_waiter(),
      "publication ownership or reader reservation survived retirement")
  test.assert(consumer:status():has_succeeded() and injector:status():has_succeeded(),
      "subscription rollback/retry failed or cancelled a Task")
end

function test_saved_error_raise_preserves_value_and_trace(context: test.Context)
  local marker = FatalMarker.new(193, "original supervised trace")
  local caught: value = nil
  local original = ""
  do
    async.Error(marker, marker.source_trace):raise()
  catch
    caught = error
    original = traceback
  end
  test.assert(caught == marker, "saved-error raise changed nominal identity")
  test.assert(original == marker.source_trace, "saved-error raise replaced trace")
  local later = ""
  do raise "later independent error"
  catch later = traceback end
  test.assert(later ~= marker.source_trace, "pinned trace escaped one handoff")
end
