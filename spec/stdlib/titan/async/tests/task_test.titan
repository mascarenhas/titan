local function cancel_join_with_finalizable(
    operand: async.Task, callback: function (value): ())
  local sentinel: {string: value} = {}
  support.mark_finalizable(sentinel, callback)
  local joining = async.run<|value, value|>(function (): value
    async.join(operand)
    return nil
  end)
  defer task_support.cancel_and_join_task(joining, "listener probe cleanup")
  support.wait_until_waiting(joining)
  joining:cancel(async.CancellationReason<|value|>.complex(sentinel))
  local status = async.join(joining)
  test.assert(status:has_cancelled(),
        "listener-retention probe did not cancel its combinator")
end

-- Task identity, explicit suspension, synchronous resume scheduling, and
-- terminal notification are the primitives beneath every combinator.
function test_ready_queue_preserves_fifo_and_services_native_work(context: test.Context)
  local order: {integer} = {}
  local tasks: {async.Task<|nil, nil|>} = {}
  for index = 1, 130 do
    local id = index
    tasks[index] = async.run<|nil, nil|>(function (): nil
      for round = 1, 4 do
        order[#order + 1] = id
        if round < 4 then async.yield() end
      end
      return nil
    end)
  end
  local observed = 0
  local observer = uv.timer_t.new()
  test.assert(uv.timer_init(async.current_loop(), observer) == 0,
      "queue observer timer initialization failed")
  local fired = function (owner: uv.timer_t)
    observed = #order
    uv.timer_close(owner)
  end
  test.assert(uv.timer_start(observer, fired, 0, 0) == 0,
      "queue observer timer submission failed")
  async.loop()
  test.assert(observed > 0 and observed < 130,
      "ready queue did not bound its initial batch before native work")
  test.assert(#order == 520, "ready queue lost a requeued Task")
  for round = 0, 3 do
    for index = 1, 130 do
      test.assert(order[round * 130 + index] == index,
          "ready queue changed FIFO order during same-Task requeue")
    end
  end
  for index = 1, #tasks do
    test.assert(tasks[index]:status():has_succeeded(), "queued Task failed")
  end
end

function test_observed_task_status_snapshots_keep_transition_identity(context: test.Context)
  local running_first: async.TaskStatus? = nil
  local running_second: async.TaskStatus? = nil
  local waiting_first: async.TaskStatus? = nil
  local waiting_second: async.TaskStatus? = nil
  local target = async.run<|value, value|>(function (): value
    local current = async.running()
    running_first = current:status()
    test.assert(running_first == current:status(), "running snapshot was not cached")
    async.yield()
    running_second = current:status()
    test.assert(running_second == current:status(), "new running snapshot was not cached")
    async.yield()
    return nil
  end)
  local ready = target:status()
  test.assert(ready == target:status(), "ready snapshot was not cached")
  local observer = async.run<|nil, nil|>(function (): nil
    waiting_first = target:status()
    test.assert(waiting_first == target:status(), "waiting snapshot was not cached")
    async.yield()
    waiting_second = target:status()
    test.assert(waiting_second == target:status(), "new waiting snapshot was not cached")
    return nil
  end)
  async.loop()
  test.assert(target:status():has_succeeded() and observer:status():has_succeeded(),
      "status observation Tasks did not succeed")
  test.assert(ready:as_string() == "ready" and
      running_first:as_string() == "running" and running_second:as_string() == "running" and
      waiting_first:as_string() == "waiting" and waiting_second:as_string() == "waiting",
      "a retained status snapshot changed its tag")
  test.assert(running_first ~= running_second and waiting_first ~= waiting_second,
      "different transitions reused an observed status identity")
  test.assert(target:status() == target:status(), "terminal snapshot was not stable")
end

function test_queued_yield_observes_first_cancellation_without_resuming_twice(context: test.Context)
  local reason = async.CancellationReason<|value|>.complex(false)
  local caught = 0
  local continued = false
  local target = async.run<|nil, value|>(function (): nil
    do async.yield()
    catch
      test.assert(error == reason, "queued yield changed cancellation identity")
      caught = caught + 1
    end
    do async.yield()
    catch
      test.assert(error == reason, "later yield changed sticky cancellation identity")
      caught = caught + 1
    end
    continued = true
    return nil
  end)
  local cancelling = async.run<|nil, nil|>(function (): nil
    target:cancel(reason)
    target:cancel(async.CancellationReason.simple("second reason"))
    return nil
  end)
  async.loop()
  case target:status()
  when cancelled(actual) then test.assert(actual == reason, "terminal cancellation identity changed")
  else raise "queued yield lost terminal cancellation"
  end
  test.assert(caught == 2 and continued and cancelling:status():has_succeeded(),
      "queued cancellation skipped or duplicated continuation")
end

function test_task_primitives_and_terminal_listeners(context: test.Context)
  runtime_test.run(function ()
    local self_task: async.Task? = nil
    self_task = async.run<|value, value|>(function (): value
      test.assert(async.running() == (self_task as async.Task),
            "async.running did not return the current Task")

      local rejected = false
      do
        async.join(self_task as async.Task)
      catch
        rejected = error is string
      end
      test.assert(rejected, "combinator accepted its running Task")

      local listener_order = ""
      local listener_status = ""
      local listener_ran_in_scheduler = false
      local removed_listener_ran = false
      -- The bare all-value callback is adjusted independently at each precise
      -- registration. Its remover must not rediscover that wrapper by identity.
      local removed_listener = function (_: async.TaskStatus)
        removed_listener_ran = true
        listener_order = listener_order .. "removed"
      end
      local target = async.run<|string, value|>(function (): string
          timer.sleep(2)
          return "listener-result"
        end)
      defer task_support.cancel_and_join_task(target, "listener target cleanup")
      local first_listener = function (
          status: async.TaskStatus<|string, value|>)
        listener_order = listener_order .. "1"
        listener_status = status:as_string()
        do
          async.running()
        catch
          listener_ran_in_scheduler = true
        end
      end
      local remove_first_listener =
        target:add_terminal_listener(first_listener)
      defer remove_first_listener()

      local remove_removed_listener =
        target:add_terminal_listener(removed_listener)
      remove_removed_listener()
      remove_removed_listener()

      local duplicate_listener_count = 0
      local duplicate_listener = function (_: async.TaskStatus)
        duplicate_listener_count = duplicate_listener_count + 1
        listener_order = listener_order .. "d"
      end
      local remove_duplicate_first =
        target:add_terminal_listener(duplicate_listener)
      local remove_duplicate_second =
        target:add_terminal_listener(duplicate_listener)
      defer remove_duplicate_second()
      remove_duplicate_first()
      remove_duplicate_first()

      local remove_second_listener = target:add_terminal_listener(
        function (_: async.TaskStatus<|string, value|>)
          listener_order = listener_order .. "2"
          -- Terminal delivery uses a detached snapshot. A remover for an
          -- already-delivered registration must not shift it and skip 3.
          remove_first_listener()
          raise "swallowed-listener-error"
        end)
      defer remove_second_listener()
      local remove_third_listener = target:add_terminal_listener(
        function (_: async.TaskStatus<|string, value|>)
          listener_order = listener_order .. "3"
        end)
      defer remove_third_listener()

      local target_status = async.join(target)
      test.assert(support.success_payload(target_status) == "listener-result",
            "terminal listener target lost its result")
      local exact_succeeded, exact_result? =
        target:status():has_succeeded()
      test.assert(exact_succeeded and
            (exact_result as string) == "listener-result",
            "generic Task status lost its exact success payload")
      test.assert(listener_order == "1d23",
            "terminal listeners were not called sequentially")
      test.assert(duplicate_listener_count == 1,
            "duplicate listener registrations did not remain distinct")
      test.assert(not removed_listener_ran,
            "removed terminal listener was invoked")
      test.assert(listener_status == "succeeded",
            "terminal listener received the wrong status")
      test.assert(listener_ran_in_scheduler,
            "terminal listener unexpectedly ran in a user Task")

      local late_listener_ran = false
      local remove_late_listener = target:add_terminal_listener(
        function (_: async.TaskStatus<|string, value|>)
          late_listener_ran = true
        end)
      remove_late_listener()
      remove_late_listener()
      timer.yield()
      test.assert(not late_listener_ran,
            "terminal Task retained or reran a listener")

      local suspended_task: async.Task? = nil
      local resumed_count = 0
      local resume_token =
        async.ResumeToken.new("async Task primitive test")
      suspended_task = async.run<|value, value|>(function (): value
        test.assert(async.running() == (suspended_task as async.Task),
              "async.running changed inside suspended Task")
        async.suspend(resume_token)
        resumed_count = resumed_count + 1
        return nil
      end)
      defer task_support.cancel_and_join_task(
        suspended_task as async.Task, "suspended target cleanup")
      local target = suspended_task
      support.wait_until_waiting(target)
      target:resume(resume_token)
      test.assert(target:status():as_string() == "waiting" and
            resumed_count == 0,
            "Task:resume resumed a suspended Task synchronously")
      -- A second request before the timer fires must coalesce.
      target:resume(resume_token)
      test.assert(async.join(target):has_succeeded() and
            resumed_count == 1,
            "suspended Task did not receive exactly one scheduled wake")
      local retired_error = ""
      do
        target:resume(resume_token)
      catch
        retired_error = error as string
      end
      timer.yield()
      test.assert(retired_error ==
            "Task resume token mismatch (expected source: unknown source)" and
            resumed_count == 1,
            "a retired resume token did not fail at its caller")
      return nil
    end)
    task_support.cleanup_task(self_task as async.Task,
                 "Task primitive probe cleanup")
    local status = async.join(self_task as async.Task)
    test.assert(status:has_succeeded(), "Task primitive probe failed")
  end)
end

function test_resume_tokens_guard_identity_and_each_suspension(
    context: test.Context)
  runtime_test.run(function ()
    local first = async.ResumeToken.new("first guarded suspension")
    local same_source =
      async.ResumeToken.new("first guarded suspension")
    local second = async.ResumeToken.new("second guarded suspension")
    local phase = 0
    local target = async.run<|nil, value|>(function (): nil
      phase = 1
      async.suspend(first)
      phase = 2
      async.suspend(second)
      phase = 3
      return nil
    end)
    task_support.cleanup_task(target, "resume-token target cleanup")
    support.wait_until_waiting(target)

    local identity_error = ""
    do
      target:resume(same_source)
    catch
      identity_error = error as string
    end
    test.assert(identity_error ==
          "Task resume token mismatch (expected source: " ..
          "first guarded suspension)" and
          target:status():as_string() == "waiting" and phase == 1,
          "same-source token identity mismatch changed the target")

    target:resume(first)
    test.assert(target:status():as_string() == "waiting" and phase == 1,
          "matching token resumed its target inline")

    -- Validation precedes wake coalescing: another record remains invalid
    -- even after the correct token has already scheduled the one wake.
    local pending_error = ""
    do
      target:resume(same_source)
    catch
      pending_error = error as string
    end
    test.assert(pending_error == identity_error,
          "pending wake suppressed a caller-side token mismatch")

    while phase < 2 do timer.yield() end
    test.assert(target:status():as_string() == "waiting",
          "second guarded suspension did not wait")
    local stale_error = ""
    do
      target:resume(first)
    catch
      stale_error = error as string
    end
    test.assert(stale_error ==
          "Task resume token mismatch (expected source: " ..
          "second guarded suspension)" and phase == 2 and
          target:status():as_string() == "waiting",
          "stale token woke or changed a later suspension")

    target:resume(second)
    test.assert(async.join(target):has_succeeded() and phase == 3,
          "current resume token did not finish the guarded Task")
  end)
end

function test_resume_token_rejects_ready_task(context: test.Context)
  runtime_test.run(function ()
    local started = false
    local target = async.run<|nil, value|>(function (): nil
      started = true
      return nil
    end)
    task_support.cleanup_task(target, "ready Task token target cleanup")
    test.assert(target:status():as_string() == "ready" and not started,
          "async.run did not leave its new Task ready")

    local mismatch = ""
    do
      target:resume(async.ResumeToken.new("ready Task outsider"))
    catch
      mismatch = error as string
    end
    test.assert(mismatch ==
          "Task resume token mismatch (expected source: unknown source)" and
          target:status():as_string() == "ready" and not started,
          "Task:resume changed a ready Task after its caller-side mismatch")

    test.assert(async.join(target):has_succeeded() and started,
          "ready Task did not run normally after token rejection")
  end)
end

function test_resume_token_reports_unknown_source(context: test.Context)
  runtime_test.run(function ()
    local expected = async.ResumeToken.new(nil)
    local wrong_token = async.ResumeToken.new(nil)
    local target = async.run<|nil, value|>(function (): nil
      async.suspend(expected)
      return nil
    end)
    task_support.cleanup_task(target, "unknown-source token target cleanup")
    support.wait_until_waiting(target)

    local mismatch = ""
    do
      target:resume(wrong_token)
    catch
      mismatch = error as string
    end
    test.assert(mismatch ==
          "Task resume token mismatch (expected source: unknown source)" and
          target:status():as_string() == "waiting",
          "nil token source did not report an unknown expected source")
    target:resume(expected)
    test.assert(async.join(target):has_succeeded(),
          "unknown-source matching token did not resume its Task")
  end)
end

-- Keep this fixture a one-shot callback wait. timer.sleep intentionally uses
-- a subscription now, whose explicit suspension has its own token source.
local function wait_for_native_callback(milliseconds: integer)
  async.await<|nil, nil|>(function (resolve, _reject, fatal)
    local timer = uv.timer_t.new()
    local handle = timer:as_handle_t()
    local closed = function (_: uv.handle_t)
      do resolve(nil)
      catch fatal(error, traceback); raise end
    end
    local fired = function (_: uv.timer_t) uv.close(handle, closed) end
    test.assert(uv.timer_init(async.current_loop(), timer) == 0,
        "native-wait timer initialization failed")
    local status = uv.timer_start(timer, fired, milliseconds, 0)
    if status < 0 then uv.close(handle); raise "native-wait timer start failed" end
  end)
end

function test_resume_token_cannot_wake_native_callback_wait(
    context: test.Context)
  runtime_test.run(function ()
    local completed = false
    local target = async.run<|nil, value|>(function (): nil
      wait_for_native_callback(50)
      completed = true
      return nil
    end)
    task_support.cleanup_task(target, "native-wait token target cleanup")
    support.wait_until_waiting(target)

    local mismatch = ""
    do
      target:resume(async.ResumeToken.new("native wait outsider"))
    catch
      mismatch = error as string
    end
    test.assert(mismatch ==
          "Task resume token mismatch (expected source: unknown source)" and
          target:status():as_string() == "waiting" and not completed,
          "Task:resume woke or changed a native callback wait")

    test.assert(async.join(target):has_succeeded() and completed,
          "ordinary native callback did not complete its guarded wait")
  end)
end

function test_retired_resume_token_cannot_wake_next_native_wait(
    context: test.Context)
  runtime_test.run(function ()
    local token = async.ResumeToken.new("completed explicit suspension")
    local resumed_mismatch = ""
    local phase = 0
    local target = async.run<|nil, value|>(function (): nil
      phase = 1
      async.suspend(token)
      do
        async.running():resume(token)
      catch
        resumed_mismatch = error as string
      end
      phase = 2
      wait_for_native_callback(50)
      phase = 3
      return nil
    end)
    task_support.cleanup_task(target, "retired-token native wait cleanup")
    support.wait_until_waiting(target)
    target:resume(token)
    while phase < 2 do timer.yield() end
    -- A running Task latches the resume; its next wait is native, which
    -- discards the latch instead of being woken by it.
    test.assert(resumed_mismatch == "",
          "a running Task's resume raised instead of latching: " .. resumed_mismatch)
    test.assert(target:status():as_string() == "waiting",
          "resumed Task did not enter its native wait")

    local mismatch = ""
    do
      target:resume(token)
    catch
      mismatch = error as string
    end
    test.assert(mismatch ==
          "Task resume token mismatch (expected source: unknown source)" and
          target:status():as_string() == "waiting" and phase == 2,
          "retired token survived into or woke the next native wait")
    target:cancel()
    test.assert(async.join(target):has_cancelled() and phase == 2,
          "native wait did not cancel after retired-token rejection")
  end)
end

-- Generic Task views carry exact success and cancellation projections while
-- the Runtime continues to own the same all-value Task userdata.
function test_generic_task_payload_and_cancellation_views(context: test.Context)
  runtime_test.run(function ()
    local successful: async.Task<|string, {string: integer}|>? = nil
    successful = async.run<|string, {string: integer}|>(function (): string
      test.assert(async.running() ==
            (successful as async.Task<|string, {string: integer}|>),
            "monomorphic async.running lost generic Task identity")
      timer.yield()
      return "typed-success"
    end)
    local exact_successful =
      successful as async.Task<|string, {string: integer}|>
    defer task_support.cancel_and_join_task(exact_successful,
                 "generic success Task cleanup")
    async.join(exact_successful)
    local did_succeed, success? =
      exact_successful:status():has_succeeded()
    test.assert(did_succeed and (success as string) == "typed-success",
          "generic success projection lost its exact payload")

    local cancellation_payload: {string: integer} = {
      ["code"] = 42,
    }
    local cancelled = async.run<|boolean, {string: integer}|>(function (): boolean
        timer.sleep(60000)
        return false
      end)
    defer task_support.cancel_and_join_task(cancelled,
                 "generic cancelled Task cleanup")
    cancelled:cancel(
      async.CancellationReason<|{string: integer}|>.complex(
        cancellation_payload))
    async.join(cancelled)
    local was_cancelled, reason? = cancelled:status():has_cancelled()
    test.assert(was_cancelled,
          "generic cancellation did not publish a cancelled status")
    local exact_reason =
      reason as async.CancellationReason<|{string: integer}|>
    local exact_code = 0
    case exact_reason
    when complex(payload) then exact_code = payload["code"]
    else
    end
    test.assert(exact_code == 42,
          "generic cancellation projection lost its exact payload")

    local raw_success = async.run<|value, value|>(function (): value
      return "polluted-success"
    end)
    defer task_support.cancel_and_join_task(raw_success,
                 "polluted success Task cleanup")
    local integer_view = raw_success as async.Task<|integer, value|>
    async.join(raw_success)
    local success_projection_rejected = false
    do
      local _, _? = integer_view:status():has_succeeded()
    catch
      success_projection_rejected = true
    end
    test.assert(success_projection_rejected,
          "generic success projection accepted a polluted Runtime payload")

    local raw_cancelled = async.run<|value, value|>(function (): value
      timer.sleep(60000)
      return nil
    end)
    defer task_support.cancel_and_join_task(raw_cancelled,
                 "polluted cancellation Task cleanup")
    local integer_reason_view =
      raw_cancelled as async.Task<|value, integer|>
    raw_cancelled:cancel(
      async.CancellationReason<|value|>.complex("polluted-reason"))
    async.join(raw_cancelled)
    local cancellation_projection_rejected = false
    do
      local _, polluted_reason? =
        integer_reason_view:status():has_cancelled()
      local exact =
        polluted_reason as async.CancellationReason<|integer|>
      case exact
      when complex(_) then
      else
      end
    catch
      cancellation_projection_rejected = true
    end
    test.assert(cancellation_projection_rejected,
          "generic cancellation projection accepted a polluted payload")
  end)
end

-- Cancellation of a Task suspended inside a combinator wakes it through the
-- same explicit resume path. Unwinding removes its operand listener before a
-- later operand completion.
function test_cancelled_combinator_removes_its_listener(context: test.Context)
  runtime_test.run(function ()
    local operand = support.sleeping(60000, "cancelled operand returned")
    task_support.cleanup_task(operand, "operand cleanup")
    local joining = async.run<|value, value|>(function (): value
      async.join(operand)
      raise "cancelled combinator resumed user code"
      return nil
    end)
    task_support.cleanup_task(joining, "cancelled combinator cleanup")
    support.wait_until_waiting(joining)
    joining:cancel(async.CancellationReason.simple("cancelled combinator"))
    test.assert(joining:status():as_string() == "waiting" and
          not joining:status():has_finished(),
          "cancel published an intermediate TaskStatus")
    test.assert(support.cancelled_payload(async.join(joining)) == "cancelled combinator",
          "suspended combinator cancellation reason changed")

    operand:cancel(async.CancellationReason.simple("operand cleanup"))
    test.assert(support.cancelled_payload(async.join(operand)) == "operand cleanup",
          "late operand completion disturbed terminal combinator")
  end)
end

-- Identity, rather than an intermediate public cancellation state, rejects a
-- current Task after it requests its own cancellation.
function test_self_cancelled_task_is_rejected_by_combinators(
    context: test.Context)
  runtime_test.run(function ()
    local candidate: async.Task? = nil
    candidate = async.run<|value, value|>(function (): value
      timer.yield()
      local current = candidate as async.Task
      current:cancel(async.CancellationReason.simple("self-cancelled"))
      test.assert(current:status():as_string() == "running",
            "self-cancellation published an intermediate TaskStatus")
      local rejected = false
      do
        async.join(current)
      catch
        rejected = error is string
      end
      test.assert(rejected, "combinator accepted its current Task")
      return nil
    end)
    task_support.cleanup_task(candidate as async.Task,
                 "self-cancelled Task cleanup")
    local status = async.join(candidate as async.Task)
    test.assert(support.cancelled_with(status, "self-cancelled"),
          "self-cancelled Task did not publish its reason")
  end)
end

-- The operand remains alive while a finalizable value reachable only through
-- the cancelled combinator is collected. This proves defer removed the
-- operand listener instead of merely making its callback inert.
function test_cancelled_combinator_listener_is_not_retained(context: test.Context)
  runtime_test.run(function ()
    local listener_cleanup_finalized = false
    local operand = support.sleeping(60000, "listener cleanup operand returned")
    task_support.cleanup_task(operand, "operand cleanup")
    cancel_join_with_finalizable(
        operand, function (_: value)
          listener_cleanup_finalized = true
        end)
    support.collect_garbage()
    support.collect_garbage()
    test.assert(listener_cleanup_finalized,
          "cancelled combinator remained retained by its operand listener")
    operand:cancel(async.CancellationReason.simple("operand cleanup"))
    async.join(operand)
  end)
end

-- Issue #289: a Lua call/return hook counts fresh trace captures. The error
-- handler that luaG_errormsg calls is a C function which, while the trace pin
-- is clear, stores a new traceback string in registry[TITAN_BACKTRACE_KEY]
-- before it returns; a pinned re-raise keeps the saved string. Every provider
-- links its own errorhandler, so the hook recognizes a capture by its effect:
-- an outermost C call entered with the pin clear whose own return finds
-- another trace string. Calls nested in that pending call are ignored. Its
-- CallInfo and the trace seen at its call stay in the registry until it
-- returns. Cell 0 counts the captures.
local foreign function task_trace_capture_hook(state: *lua_State, ar: *lua_Debug)
  ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_cells")
  local cells = ffi.lua_touserdata(state, -1) as foreign *int
  ffi.lua_settop(state, -2)
  if cells == nil then return end
  local call = ar.i_ci as foreign *void
  ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_call")
  local pending = ffi.lua_touserdata(state, -1)
  ffi.lua_settop(state, -2)
  if ar.event == ffi.LUA_HOOKRET then
    if pending == nil then return end
    if pending ~= call then return end
    ffi.lua_pushlightuserdata(state, nil)
    ffi.lua_setfield(state, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_call")
    ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY)
    ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_before")
    local trace = ffi.lua_topointer(state, -2)
    local before = ffi.lua_topointer(state, -1)
    ffi.lua_settop(state, -3)
    if trace == nil then return end
    if trace ~= before then cells[0] = cells[0] + 1 end
    return
  end
  if pending ~= nil then return end
  if ffi.lua_getinfo(state, "S", ar) == 0 then return end
  if ffi.strcmp(ar.what, "C") ~= 0 then return end
  ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, ffi.TITAN_TRACE_PINNED)
  local pinned = ffi.lua_toboolean(state, -1)
  ffi.lua_settop(state, -2)
  if pinned ~= 0 then return end
  -- Store false for an absent trace, so that this existing key is only updated.
  if ffi.lua_getfield(state, ffi.LUA_REGISTRYINDEX, ffi.TITAN_BACKTRACE_KEY) == ffi.LUA_TNIL then
    ffi.lua_settop(state, -2)
    ffi.lua_pushboolean(state, 0)
  end
  ffi.lua_setfield(state, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_before")
  ffi.lua_pushlightuserdata(state, call)
  ffi.lua_setfield(state, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_call")
end

-- Count from zero with no pending call.
local function task_trace_reset(cells: owned int[])
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 1) ~= 0, "cannot reserve Lua stack for the trace hook")
  ffi.lua_pushlightuserdata(L, nil)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_call")
  cells[0] = 0
end

-- Hook the current thread, whose later Tasks inherit the hook, and the main
-- thread, where the driver resumes Task roots.
local function task_trace_hook_install(cells: owned int[])
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 2) ~= 0, "cannot reserve Lua stack for the trace hook")
  task_trace_reset(cells)
  ffi.lua_pushboolean(L, 0)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_before")
  ffi.lua_pushlightuserdata(L, cells as foreign *void)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_cells")
  ffi.lua_rawgeti(L, ffi.LUA_REGISTRYINDEX, ffi.LUA_RIDX_MAINTHREAD as foreign lua_Integer)
  local main = ffi.lua_tothread(L, -1)
  local mask = ffi.LUA_MASKCALL | ffi.LUA_MASKRET
  ffi.lua_sethook(L, task_trace_capture_hook, mask, 0)
  ffi.lua_sethook(main, task_trace_capture_hook, mask, 0)
end

local function task_trace_hook_remove()
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 2) ~= 0, "cannot reserve Lua stack for the trace hook")
  ffi.lua_sethook(L, nil, 0, 0)
  ffi.lua_rawgeti(L, ffi.LUA_REGISTRYINDEX, ffi.LUA_RIDX_MAINTHREAD as foreign lua_Integer)
  ffi.lua_sethook(ffi.lua_tothread(L, -1), nil, 0, 0)
  ffi.lua_pushnil(L)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_cells")
  ffi.lua_pushnil(L)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_call")
  ffi.lua_pushnil(L)
  ffi.lua_setfield(L, ffi.LUA_REGISTRYINDEX, "async.tests.task_trace_before")
end

local function task_trace_failing_body(): value
  raise "trace capture probe failure"
end

local function task_trace_cancelled_parked_task()
  runtime_test.run(function ()
    local cells: owned int[] = foreign int.new_array(1)
    task_trace_hook_install(cells)
    defer task_trace_hook_remove()
    local token = async.ResumeToken("trace capture probe")
    local parked = async.run<|value, value|>(function (): value
      async.suspend(token)
      return nil
    end)
    task_support.cleanup_task(parked, "trace capture probe cleanup")
    support.wait_until_waiting(parked)
    task_trace_reset(cells)
    parked:cancel(async.CancellationReason.simple("trace capture probe"))
    local status = async.join(parked)
    local count = cells[0] as integer
    test.assert(support.cancelled_with(status, "trace capture probe"),
      "the parked Task was not cancelled")
    -- Only the cancellation raised at the Task's yield point builds a trace,
    -- the one that the Task's own catch blocks can observe.
    test.assert(count == 1, "cancelling a parked Task captured " .. count .. " traces")
  end)
end

local function task_trace_reported_failure(context: test.Context, with_cleanup: boolean)
  runtime_test.run(function ()
    local cells: owned int[] = foreign int.new_array(1)
    task_trace_hook_install(cells)
    defer task_trace_hook_remove()
    local failing: async.Task? = nil
    if with_cleanup then
      failing = async.run_with_cleanup<|value, value|>(task_trace_failing_body,
        function (_: async.CancellationReason<|value|>?) end)
    else
      failing = async.run<|value, value|>(task_trace_failing_body)
    end
    task_support.cleanup_task(failing, "trace capture probe cleanup")
    task_trace_reset(cells)
    context:log("BEGIN expected uncaught async Task diagnostics")
    local status = async.join(failing)
    context:log("END expected uncaught async Task diagnostics")
    local count = cells[0] as integer
    local failed, failure? = status:has_failed()
    test.assert(failed and failure.error == "trace capture probe failure",
      "the failing Task reported " .. status:as_string())
    test.assert(support.contains(failure.traceback, "task_trace_failing_body"),
      "the reported trace lost the raising frame")
    -- The body's raise builds a trace. An ordinary Task also appends the
    -- driver's propagation trace, which run_with_cleanup never reports: it
    -- reports the trace that its body recorded.
    local expected = 2
    if with_cleanup then expected = 1 end
    test.assert(count == expected,
      "the failing Task captured " .. count .. " traces, expected " .. expected)
  end)
end

function test_task_trace_captures_follow_reported_failures(context: test.Context)
  context:run("cancelled_parked_task", function (_: test.Context)
    task_trace_cancelled_parked_task()
  end)
  context:run("reported_failure", function (child: test.Context)
    task_trace_reported_failure(child, false)
  end)
  context:run("cleanup_body_failure", function (child: test.Context)
    task_trace_reported_failure(child, true)
  end)
end

-- A finalizer that cancels a Task while its explicit suspension registers,
-- after the driver's admission check (run_wake_in_suspend_window), must still
-- deliver the cancellation.
function test_cancel_during_suspend_registration_is_delivered(_: test.Context)
  runtime_test.run(function ()
    local token = async.ResumeToken("cancelled while registering")
    local target = run_wake_in_suspend_window("waiting", function (): value
      async.suspend(token)
      return "resumed"
    end, function (task: async.Task)
      task:cancel(async.CancellationReason.simple("cancelled while registering"))
    end)
    test.assert(support.cancelled_with(target:status(), "cancelled while registering"),
      "a cancellation during suspend registration left the Task " ..
      target:status():as_string())
  end)
end

-- The public-API path of issue #280: a finalizer that resumes a Task with its
-- token while the Task is about to suspend (run_wake_in_suspend_window), as
-- thread.Group:cancel does for its admission waiters, latches the wake.
function test_resume_before_suspend_registration_is_latched(_: test.Context)
  runtime_test.run(function ()
    local token = async.ResumeToken("resumed before registration")
    local target = run_wake_in_suspend_window("running", function (): value
      async.suspend(token)
      return "resumed"
    end, function (task: async.Task) task:resume(token) end)
    local finished, result? = target:status():has_succeeded()
    test.assert(finished and result == "resumed",
      "a resume before suspend registration left the Task " .. target:status():as_string())
  end)
end

-- A running Task latches Task:resume for its next explicit suspension: a
-- matching suspend settles at once, the latest call wins, and a mismatching
-- suspension discards the latch.
function test_running_task_resume_latches_next_suspension(_: test.Context)
  runtime_test.run(function ()
    local first = async.ResumeToken("first latched suspension")
    local second = async.ResumeToken("second latched suspension")
    local log = ""
    local target = async.run<|value, value|>(function (): value
      local current = async.running()
      current:resume(first)
      async.suspend(first)
      log = log .. "first;"
      current:resume(first)
      current:resume(second)
      async.suspend(second)
      log = log .. "second;"
      current:resume(first)
      async.suspend(second)
      log = log .. "third;"
      return nil
    end)
    task_support.cleanup_task(target, "latched resume cleanup")
    support.wait_until_waiting(target)
    test.assert(log == "first;second;",
      "latched resumes did not settle exactly the matching suspensions: " .. log)
    target:resume(second)
    test.assert(async.join(target):has_succeeded() and log == "first;second;third;",
      "the suspension that discarded its latch was not resumable: " .. log)
  end)
end
