local runtime_close_lua = import "lua"
local runtime_close_gc = import "gc"
local runtime_close_coroutine = import "coroutine"
foreign import "stdio.h"
-- Descriptor capture shared with the io tests.
foreign import "../../io/print_capture.h"

function test_runtime_close_listeners_follow_native_cleanup_and_allow_removal(context: test.Context)
  local order: {integer} = {}
  local native_closed = false
  local task = async.run<|nil, nil|>(function (): nil return nil end)
  local owner = uv.timer_t.new()
  test.assert(uv.timer_init(async.current_loop(), owner) == 0)
  uv.timer_close(owner, function (_: uv.timer_t) native_closed = true end)
  local remove_later: function (): () = function () end
  local remove_first = async.add_close_listener(function ()
    test.assert(task:status():has_finished() and native_closed,
      "Runtime listener ran before Task/native retirement")
    test.assert(async.is_closing(), "Runtime listener observed open Runtime")
    order[#order + 1] = 1
    remove_later()
    local rejected = false
    do async.run<|nil, nil|>(function (): nil return nil end)
    catch rejected = true end
    test.assert(rejected, "close listener resurrected Runtime work")
    rejected = false
    do async.running() catch rejected = true end
    test.assert(rejected, "Runtime close listener ran inside a Task")
    rejected = false
    do async.loop() catch rejected = true end
    test.assert(rejected, "Runtime close listener reentered the driver")
    rejected = false
    do async.add_close_listener(function () end) catch rejected = true end
    test.assert(rejected, "Runtime close listener registered new cleanup")
  end)
  remove_later = async.add_close_listener(function () order[#order + 1] = 2 end)
  async.add_close_listener(function () order[#order + 1] = 3 end)
  local remove_early = async.add_close_listener(function () raise "removed listener ran" end)
  remove_early()
  remove_early()
  async.loop()
  remove_first()
  remove_later()
  test.assert(#order == 2 and order[1] == 1 and order[2] == 3,
    "Runtime listeners lost order, removal, or once-only behavior")
  runtime_test.run(function () async.yield() end)
  test.assert(#order == 2, "Runtime listener leaked into the next session")
end

function test_runtime_close_listener_failure_preserves_error_and_runs_remaining(context: test.Context)
  local marker: {string} = {"close failure"}
  local remaining = false
  async.run<|nil, nil|>(function (): nil return nil end)
  async.add_close_listener(function () raise marker end)
  async.add_close_listener(function () remaining = true; raise "later failure" end)
  local caught = false
  do async.loop()
  catch
    caught = true
    test.assert(error == marker, "Runtime close replaced first failure")
  end
  test.assert(caught and remaining, "Runtime close stopped notifying after failure")
  local rejected = false
  do async.add_close_listener(function () end)
  catch rejected = true end
  test.assert(rejected, "listener registration silently created a Runtime")
  runtime_test.run(function () async.yield() end)
end

local function close_exit_transfer_file(file: integer)
  local request = uv.fs_t.new()
  local status = uv.fs_close(nil, request, file)
  uv.fs_req_cleanup(request)
  test.assert(status == 0, "exit transfer fixture could not close its descriptor")
end

function test_exit_rejects_native_adoption_during_cleanup_and_preserves_payload(_: test.Context)
  local status, read_file, write_file = uv.pipe(uv.NONBLOCK_PIPE, uv.NONBLOCK_PIPE)
  test.assert(status == 0)
  defer if read_file >= 0 then close_exit_transfer_file(read_file) end
  defer if write_file >= 0 then close_exit_transfer_file(write_file) end
  local packet: string? = nil
  defer if packet ~= nil then
    test.assert(uv.pipe_t.discard_transfer_payload(packet) == 0,
                "exit transfer fixture could not dispose its descriptor")
  end
  local rejected, cleanup_completed, closing_flag_preserved = false, false, false
  local task = async.run<|nil, value|>(function (): nil
    local writer = uv.pipe_t.new()
    test.assert(uv.pipe_init(async.current_loop(), writer, 0) == 0)
    test.assert(uv.pipe_open(writer, write_file) == 0)
    write_file = -1
    packet = writer:to_transfer_payload()
    defer do
      -- Exit cancellation is distinct from fatal Runtime closing, but native
      -- handoff admission must already be closed before cleanup registrars run.
      closing_flag_preserved = not async.is_closing()
      async.await_cleanup<|nil, nil|>(function (resolve, _reject, _fatal)
        local adopted: uv.pipe_t? = nil
        do adopted = uv.pipe_t.from_transfer_payload(packet)
        catch
          rejected = error == "native transfer requires an active destination async Runtime"
        end
        if adopted ~= nil then
          packet = nil
          uv.close(adopted:as_handle_t())
        end
        local cleanup_timer = uv.timer_t.new()
        test.assert(uv.timer_init(async.current_loop(), cleanup_timer) == 0)
        test.assert(uv.timer_start(cleanup_timer, function (owner: uv.timer_t)
          uv.timer_close(owner, function (_: uv.timer_t)
            cleanup_completed = true
            resolve(nil)
          end)
        end, 0, 0) == 0)
      end)
    end
    async.request_exit(23)
    return nil
  end)
  async.loop()
  test.assert(task:status():has_cancelled(), "exit request lost sticky cancellation")
  test.assert(rejected, "exit cleanup adopted a new native owner")
  test.assert(closing_flag_preserved, "exit changed the public fatal-closing query")
  test.assert(cleanup_completed, "exit prevented accepted cleanup callbacks from retiring")
  local retired = false
  runtime_test.run(function ()
    local adopted = uv.pipe_t.from_transfer_payload(packet)
    packet = nil
    test.assert(uv.handle_get_loop(adopted:as_handle_t()) == async.current_loop())
    test.assert(uv.is_writable(adopted:as_stream_t()),
      "rejected adoption consumed the pipe descriptor")
    uv.close(adopted:as_handle_t(), function (_: uv.handle_t) retired = true end)
  end)
  test.assert(retired, "fresh Runtime did not retire the recovered owner")
end

local foreign function runtime_close_record(cells: *void, slot: int, code: int)
  local codes = cells as foreign *int
  codes[slot] = code
end

-- Observation codes recorded per abandoned Task: 0 unobserved, 1 status()
-- raised, 2 a stale or wrong status, 3 the expected status. An expected
-- reason of nil means the Task must stay nonterminal and waiting.
record RuntimeCloseTaskOracle
  cells: foreign *void
  tasks: {async.Task}
  reasons: {string}
  gated: async.Task?
  gate_context: foreign *void
end
local runtime_close_task_probe: RuntimeCloseTaskOracle? = nil

local function runtime_close_task_code(task: async.Task, reason: string?): integer
  local code = 1
  do
    local status = task:status()
    code = 2
    if reason == nil then
      if status:as_string() == "waiting" and not status:has_finished() then code = 3 end
    elseif status:has_finished() and support.cancelled_with(status, reason) then
      code = 3
    end
  catch
  end
  return code
end

local function runtime_close_task_oracle(owner: RuntimeCloseTaskOracle)
  -- Registered before the Runtime, so lua_close runs it after abandonment.
  for index = 1, #owner.tasks do
    runtime_close_record(owner.cells, index - 1,
      runtime_close_task_code(owner.tasks[index], owner.reasons[index]))
  end
  local gated? = owner.gated
  if gated ~= nil then
    runtime_close_record(owner.cells, #owner.tasks, runtime_close_task_code(gated, nil))
    -- The abandoned gate never unregistered; release the domain's own retain.
    external_retirement_unregister(owner.gate_context)
  end
end

-- Public only so a fresh independent state can call it; test infrastructure.
-- Leaves seven Tasks of an unretired Runtime for a finalizer registered before
-- that Runtime: parked waiting, parked with a requested cancellation that the
-- closing state never delivers, queued and observed ready, queued and never
-- observed, two run_with_cleanup Tasks whose body returned or raised while
-- their cleanup is still parked, and one parked behind a still-armed native
-- retirement gate (cells 0-6). An eighth, parked run_with_cleanup Task records
-- into cells 7 and 8 whether its body defer ran and which reason its cleanup
-- received when lua_close unwinds it. A terminal listener on every Task
-- records into cell 9 if it ever runs.
function runtime_close_abandoned_task_bootstrap(cells_raw: value)
  local cells = cells_raw as foreign *void
  local oracle = RuntimeCloseTaskOracle(cells, {}, {}, nil, nil)
  runtime_close_gc.finalizable(oracle, runtime_close_task_oracle)
  runtime_close_task_probe = oracle
  local parked_token = async.ResumeToken("abandoned parked Task")
  local parked = async.run<|value, value|>(function (): value
    async.suspend(parked_token)
    return 1
  end)
  local cancelled_token = async.ResumeToken("abandoned cancelled Task")
  local cancelled = async.run<|value, value|>(function (): value
    async.suspend(cancelled_token)
    return 2
  end)
  local returned_token = async.ResumeToken("abandoned cleanup after a returned body")
  local returned = async.run_with_cleanup<|value, value|>(function (): value
    return 5
  end, function (_: async.CancellationReason?)
    async.suspend(returned_token)
  end)
  local raised_token = async.ResumeToken("abandoned cleanup after a raised body")
  local raised = async.run_with_cleanup<|value, value|>(function (): value
    raise "abandoned body failure"
    return 6
  end, function (_: async.CancellationReason?)
    async.suspend(raised_token)
  end)
  local gate, gate_fixture = external_wait_prepare_retirement(false)
  local gated_token = async.ResumeToken("abandoned gated Task")
  local gated = async.run_with_cleanup<|value, value|>(function (): value
    async.suspend(gated_token)
    return 7
  end, function (_: async.CancellationReason?)
    gate:wait_cleanup()
  end, gate)
  oracle.gated = gated
  oracle.gate_context = gate_fixture as foreign *void
  local unwound_token = async.ResumeToken("abandoned Task with cleanup")
  local unwound = async.run_with_cleanup<|value, value|>(function (): value
    defer runtime_close_record(cells, 7, 3)
    async.suspend(unwound_token)
    return 8
  end, function (reason: async.CancellationReason<|value|>?)
    local code = 1
    if reason ~= nil then
      code = 2
      case reason
      when simple(text) then
        if text == "async Runtime abandoned at Lua state close" then code = 3 end
      else
      end
    end
    runtime_close_record(cells, 8, code)
  end)
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  test.assert(unwound:status():as_string() == "waiting",
    "the abandoned Task with cleanup did not park")
  test.assert(returned:status():as_string() == "waiting" and
              raised:status():as_string() == "waiting",
    "a finished body with a parked cleanup did not leave its Task waiting")
  test.assert(parked:status():as_string() == "waiting" and
              cancelled:status():as_string() == "waiting" and
              gated:status():as_string() == "waiting",
    "abandoned Runtime Tasks did not park")
  cancelled:cancel(async.CancellationReason.simple("requested before state close"))
  test.assert(cancelled:status():as_string() == "waiting",
    "cancellation completed without a driven loop")
  local observed = async.run<|value, value|>(function (): value return 3 end)
  test.assert(observed:status():as_string() == "ready", "queued Task did not report ready")
  local unobserved = async.run<|value, value|>(function (): value return 4 end)
  local abandoned = "async Runtime abandoned at Lua state close"
  oracle.tasks = {parked, cancelled, observed, unobserved, returned, raised}
  oracle.reasons = {abandoned, "requested before state close", abandoned, abandoned,
                    abandoned, abandoned}
  local listener = function (_: async.TaskStatus) runtime_close_record(cells, 9, 1) end
  local all: {async.Task} = {parked, cancelled, observed, unobserved, returned, raised,
                             gated, unwound}
  for index = 1, #all do all[index]:add_terminal_listener(listener) end
end

-- Run `action` with descriptor 2 redirected into a pipe, and return what it
-- wrote there. The action must write less than a pipe buffer.
local function runtime_close_capture_stderr(action: function (): ()): string
  local descriptors: owned int[] = foreign int.new_array(2)
  test.assert((ffi.titan_spec_capture_pipe(descriptors as foreign *int) as integer) == 0,
    "could not create a stderr capture pipe")
  local read_descriptor = descriptors[0]
  defer ffi.titan_spec_capture_close(read_descriptor)
  local saved = ffi.titan_spec_capture_duplicate(2)
  test.assert((saved as integer) >= 0, "could not duplicate stderr")
  defer ffi.titan_spec_capture_close(saved)
  ffi.fflush(nil)
  local redirected = (ffi.titan_spec_capture_replace(descriptors[1], 2) as integer) == 2
  ffi.titan_spec_capture_close(descriptors[1])
  test.assert(redirected, "could not redirect stderr")
  do
    defer do
      ffi.fflush(nil)
      ffi.titan_spec_capture_replace(saved, 2)
    end
    action()
  end
  local capacity = 65536
  local storage: owned char[] = foreign char.new_array(capacity)
  local top = ffi.lua_gettop(L)
  defer ffi.lua_settop(L, top)
  test.assert(ffi.lua_checkstack(L, 1) ~= 0, "cannot reserve Lua stack for captured stderr")
  local count = ffi.titan_spec_capture_read(read_descriptor, storage as foreign *char,
    capacity as foreign titan_spec_size) as integer
  if count < 0 then count = 0 end
  ffi.lua_pushlstring(L, storage as foreign *char, count as foreign size_t)
  local captured: value = ffi.lua_totvalue(L, -1)
  return captured as string
end

-- A Task of a Runtime abandoned at lua_close never resumes, but a later
-- finalizer that still holds it must read a consistent status: cancelled,
-- unless its native retirement gate is still armed (then nonterminal). That
-- includes a body that finished while its cleanup was pending, no terminal
-- listener runs, and no Task error is reported, not even the raised body's.
function test_lua_close_publishes_consistent_status_for_abandoned_tasks(_: test.Context)
  local cells: owned int[] = foreign int.new_array(10)
  for index = 0, 9 do cells[index] = 0 end
  local state = runtime_close_lua.new()
  defer state:close()
  state:run([[
    package.path, package.cpath = '', ''
    require('async.tests').runtime_close_abandoned_task_bootstrap(...)
  ]], "=abandoned-task-bootstrap", async.TransferValue.is_pointer(cells as foreign *void))
  -- The expected coroutine cleanup warning goes to the captured stderr too.
  local diagnostics = runtime_close_capture_stderr(function () state:close() end)
  test.assert(not support.contains(diagnostics, "uncaught error in async Task:"),
    "lua_close reported an abandoned Task's error: " .. diagnostics)
  local names: {string} = {"parked", "cancel-requested", "observed-ready", "unobserved",
                           "body-returned-cleanup-pending", "body-raised-cleanup-pending",
                           "armed-retirement-gate"}
  local outcomes: {string} = {"unobserved", "raised", "stale or wrong", "expected"}
  local report = ""
  local consistent = true
  for index = 1, #names do
    local code = cells[index - 1] as integer
    consistent = consistent and code == 3
    report = report .. " " .. names[index] .. "=" .. outcomes[code + 1]
  end
  if (cells[9] as integer) ~= 0 then
    consistent = false
    report = report .. " terminal-listener=ran"
  end
  test.assert(consistent, "abandoned Task status after state close:" .. report)
  -- The parked Task unwinds; its cleanup receives the abandonment reason
  -- (codes: 0 cleanup not run, 1 nil reason, 2 another reason).
  test.assert((cells[7] as integer) == 3, "the abandoned Task's body defer did not run")
  test.assert((cells[8] as integer) == 3,
    "abandoned Task cleanup reason code: " .. (cells[8] as integer))
end

-- Public only so a fresh independent state can call it; test infrastructure.
-- A parked Task whose defers start Tasks when lua_close unwinds it, and an
-- older plain coroutine whose defer, unwound after runtime_finalize, would
-- create a new Runtime. Cells: 0 the caught async.run (1 started, 2 another
-- error, 3 refused), 1 the outermost defer ran after an uncaught refused
-- start, 2 a started Task body ran, 3 the caught run_with_cleanup, 4 the
-- caught Runtime creation (async.receiver; 3 refused).
function runtime_close_start_refused_bootstrap(cells_raw: value)
  local cells = cells_raw as foreign *void
  local older = runtime_close_coroutine.create(function (_: value): value
    defer do
      local code = 1
      do
        async.receiver()
      catch
        code = 2
        if error == "cannot create an async Runtime during Lua state close" then code = 3 end
      end
      runtime_close_record(cells, 4, code)
    end
    runtime_close_coroutine.yield(nil, "older")
    return nil
  end, "older")
  older:resume(nil)
  runtime_close_held = older
  local started = function (): nil
    runtime_close_record(cells, 2, 3)
    return nil
  end
  local token = async.ResumeToken("parked Task that starts Tasks at close")
  local parked = async.run<|nil, value|>(function (): nil
    defer runtime_close_record(cells, 1, 3)
    defer async.run<|nil, value|>(started)
    defer do
      local code = 1
      do
        async.run<|nil, value|>(started)
      catch
        code = 2
        if error == "cannot start a Task during Lua state close" then code = 3 end
      end
      runtime_close_record(cells, 0, code)
      code = 1
      do
        async.run_with_cleanup<|nil, value|>(started,
          function (_: async.CancellationReason<|value|>?) end)
      catch
        code = 2
        if error == "cannot start a Task during Lua state close" then code = 3 end
      end
      runtime_close_record(cells, 3, code)
    end
    async.suspend(token)
    return nil
  end)
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  test.assert(parked:status():as_string() == "waiting", "the Task did not park")
end

local runtime_close_held: value = nil

function test_lua_close_refuses_task_start_from_unwinding_task(context: test.Context)
  local cells: owned int[] = foreign int.new_array(5)
  for index = 0, 4 do cells[index] = 0 end
  local state = runtime_close_lua.new()
  defer state:close()
  state:run([[
    package.path, package.cpath = '', ''
    require('async.tests').runtime_close_start_refused_bootstrap(...)
  ]], "=start-refused-bootstrap", async.TransferValue.is_pointer(cells as foreign *void))
  context:log("BEGIN expected coroutine cleanup warning")
  state:close()
  context:log("END expected coroutine cleanup warning")
  test.assert((cells[0] as integer) == 3,
    "a Task start during state close gave code " .. (cells[0] as integer))
  test.assert((cells[1] as integer) == 3, "the unwind stopped at the refused start")
  test.assert((cells[2] as integer) == 0, "a Task started during state close ran")
  test.assert((cells[3] as integer) == 3,
    "a run_with_cleanup start during state close gave code " .. (cells[3] as integer))
  test.assert((cells[4] as integer) == 3,
    "a Runtime creation during state close gave code " .. (cells[4] as integer))
end

-- A finalizer that settles an await Completion while no Task is current
-- queues the delivery: the Task resumes after the finalizer.
record RuntimeCloseResolver
  resolve: (function (string): ())?
end

local function runtime_close_resolve_in_finalizer(candidate: value)
  local holder: RuntimeCloseResolver = candidate
  local resolve = holder.resolve as function (string): ()
  resolve("from-finalizer")
end

local function runtime_close_drop_resolver(holder: RuntimeCloseResolver)
  local finalized = RuntimeCloseResolver(holder.resolve)
  runtime_close_gc.finalizable<|value|>(finalized, runtime_close_resolve_in_finalizer)
end

function test_unwind_finalizer_settles_completion_after_finalizer(_: test.Context)
  local holder = RuntimeCloseResolver(nil)
  local task = async.run<|string, value|>(function (): string
    local result = async.await<|string, value|>(function (resolve, _reject, _fatal)
      holder.resolve = resolve
    end)
    case result
    when success(text) then return text
    else raise "the await failed"
    end
  end)
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  test.assert(holder.resolve ~= nil, "the Task did not await")
  runtime_close_drop_resolver(holder)
  for _ = 1, 4 do runtime_close_gc.collect() end
  async.loop()
  local succeeded, result? = task:status():has_succeeded()
  test.assert(succeeded and result == "from-finalizer",
    "the finalizer's settlement gave " .. task:status():as_string())
end

-- A finalizer that reports the fatal failure of two pending waits while no
-- Task is current queues each delivery: every Task receives its own
-- operation's error after the finalizer, and the driver reports the first.
record RuntimeCloseFatals
  first: (function (value, string): ())?
  second: (function (value, string): ())?
end

local function runtime_close_fatal_in_finalizer(candidate: value)
  local holder: RuntimeCloseFatals = candidate
  holder.first("first-operation-error", "first-trace")
  holder.second("second-operation-error", "second-trace")
end

local function runtime_close_drop_fatals(holder: RuntimeCloseFatals)
  local finalized = RuntimeCloseFatals(holder.first, holder.second)
  runtime_close_gc.finalizable<|value|>(finalized, runtime_close_fatal_in_finalizer)
end

local function runtime_close_await_fatal(observed: {string}, index: integer,
                                         store: function (function (value, string): ()): ())
  async.run<|nil, value|>(function (): nil
    do
      async.await_cleanup<|nil, value|>(function (_resolve, _reject, fatal)
        store(fatal)
      end)
      observed[index] = "success"
    catch
      observed[index] = error as string
    end
    return nil
  end)
end

function test_unwind_finalizer_fatal_delivers_each_operation_error(_: test.Context)
  local holder = RuntimeCloseFatals(nil, nil)
  local observed: {string} = {"pending", "pending"}
  runtime_close_await_fatal(observed, 1, function (fatal: function (value, string): ())
    holder.first = fatal
  end)
  runtime_close_await_fatal(observed, 2, function (fatal: function (value, string): ())
    holder.second = fatal
  end)
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  test.assert(holder.first ~= nil and holder.second ~= nil, "the Tasks did not await")
  runtime_close_drop_fatals(holder)
  for _ = 1, 4 do runtime_close_gc.collect() end
  local loop_error: value = nil
  do async.loop()
  catch loop_error = error
  end
  test.assert(loop_error == "first-operation-error", "the driver reported another error")
  test.assert(observed[1] == "first-operation-error", "first wait: " .. observed[1])
  test.assert(observed[2] == "second-operation-error", "second wait: " .. observed[2])
  runtime_test.run(function () async.yield() end)
end

-- Outside state close, a defer of an abandoned coroutine may hand disposal to
-- a Task of the active Runtime; that Task runs after the unwind.
local function runtime_close_abandon_generator(log: {string})
  local generator = runtime_close_coroutine.create(function (_: value): value
    defer do
      log[#log + 1] = "defer"
      async.run<|nil, value|>(function (): nil
        log[#log + 1] = "disposal"
        return nil
      end)
    end
    runtime_close_coroutine.yield("first", "generator")
    return nil
  end, "generator")
  test.assert(generator:resume(nil) == "first")
end

function test_unwind_defer_starts_task_after_collection(_: test.Context)
  runtime_test.run(function ()
    local log: {string} = {}
    runtime_close_abandon_generator(log)
    for _ = 1, 4 do runtime_close_gc.collect() end
    test.assert(#log == 1 and log[1] == "defer", "the generator was not unwound")
    for _ = 1, 10 do
      if #log == 2 then break end
      async.yield()
    end
    test.assert(#log == 2 and log[2] == "disposal", "the disposal Task did not run")
  end)
end
