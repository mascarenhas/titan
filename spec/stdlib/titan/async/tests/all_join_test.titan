local function caught_all_two(first: async.Task,
                              second: async.Task): string
  do
    async.all_two(first, second)
  catch
    local rejected = error as async.AllTwoError
    case rejected
    when first: status then
      support.cancelled_payload(status)
      return "1"
    when second: status then
      support.cancelled_payload(status)
      return "2"
    end
  end
  raise "all_two unexpectedly succeeded"
end

local function caught_all_three(first: async.Task, second: async.Task,
                                third: async.Task): string
  do
    async.all_three(first, second, third)
  catch
    local rejected = error as async.AllThreeError
    case rejected
    when first: status then
      support.cancelled_payload(status)
      return "1"
    when second: status then
      support.cancelled_payload(status)
      return "2"
    when third: status then
      support.cancelled_payload(status)
      return "3"
    end
  end
  raise "all_three unexpectedly succeeded"
end

local function caught_all_four(first: async.Task, second: async.Task,
                               third: async.Task,
                               fourth: async.Task): string
  do
    async.all_four(first, second, third, fourth)
  catch
    local rejected = error as async.AllFourError
    case rejected
    when first: status then
      support.cancelled_payload(status)
      return "1"
    when second: status then
      support.cancelled_payload(status)
      return "2"
    when third: status then
      support.cancelled_payload(status)
      return "3"
    when fourth: status then
      support.cancelled_payload(status)
      return "4"
    end
  end
  raise "all_four unexpectedly succeeded"
end

local function caught_all_five(first: async.Task, second: async.Task,
                               third: async.Task, fourth: async.Task,
                               fifth: async.Task): string
  do
    async.all_five(first, second, third, fourth, fifth)
  catch
    local rejected = error as async.AllFiveError
    case rejected
    when first: status then
      support.cancelled_payload(status)
      return "1"
    when second: status then
      support.cancelled_payload(status)
      return "2"
    when third: status then
      support.cancelled_payload(status)
      return "3"
    when fourth: status then
      support.cancelled_payload(status)
      return "4"
    when fifth: status then
      support.cancelled_payload(status)
      return "5"
    end
  end
  raise "all_five unexpectedly succeeded"
end

function test_all_combinators_values_and_error_positions(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected uncaught async Task diagnostics")
    local first = support.sleeping(3, "one")
    task_support.cleanup_task(first, "all first cleanup")
    local second = support.successful(nil)
    task_support.cleanup_task(second, "all second cleanup")
    local third = support.successful("three")
    task_support.cleanup_task(third, "all third cleanup")
    local fourth = support.successful("four")
    task_support.cleanup_task(fourth, "all fourth cleanup")
    local fifth = support.successful("five")
    task_support.cleanup_task(fifth, "all fifth cleanup")

    local one, two = async.all_two(first, second)
    test.assert(one == "one" and two == nil, "all_two success values")
    local a, b, c = async.all_three(first, second, third)
    test.assert(a == "one" and b == nil and c == "three",
          "all_three success values")
    local d, e, f, g = async.all_four(first, second, third, fourth)
    test.assert(d == "one" and e == nil and f == "three" and g == "four",
          "all_four success values")
    local h, i, j, k, l =
      async.all_five(first, second, third, fourth, fifth)
    test.assert(h == "one" and i == nil and j == "three" and
          k == "four" and l == "five", "all_five success values")

    local live_duplicate = support.sleeping(2, "all-live-duplicate")
    task_support.cleanup_task(live_duplicate, "all duplicate cleanup")
    local duplicate_first, duplicate_second =
      async.all_two(live_duplicate, live_duplicate)
    test.assert(duplicate_first == "all-live-duplicate" and
          duplicate_second == "all-live-duplicate",
          "live all duplicate lost a positional result")
    local live_three = support.sleeping(2, "all-live-three")
    task_support.cleanup_task(live_three, "all three cleanup")
    local three_first, three_second, three_third =
      async.all_three(live_three, live_three, live_three)
    test.assert(three_first == "all-live-three" and
          three_second == "all-live-three" and
          three_third == "all-live-three",
          "live all_three duplicate lost a positional result")
    local live_four = support.sleeping(2, "all-live-four")
    task_support.cleanup_task(live_four, "all four cleanup")
    local four_first, four_second, four_third, four_fourth =
      async.all_four(live_four, live_four, live_four, live_four)
    test.assert(four_first == "all-live-four" and
          four_second == "all-live-four" and
          four_third == "all-live-four" and
          four_fourth == "all-live-four",
          "live all_four duplicate lost a positional result")
    local live_five = support.sleeping(2, "all-live-five")
    task_support.cleanup_task(live_five, "all five cleanup")
    local five_first, five_second, five_third, five_fourth, five_fifth =
      async.all_five(live_five, live_five, live_five, live_five, live_five)
    test.assert(five_first == "all-live-five" and
          five_second == "all-live-five" and
          five_third == "all-live-five" and
          five_fourth == "all-live-five" and
          five_fifth == "all-live-five",
          "live all_five duplicate lost a positional result")

    local rejected = support.cancelled("all-cancelled")
    task_support.cleanup_task(rejected, "all rejected cleanup")
    async.join(rejected)
    test.assert(caught_all_two(rejected, first) == "1",
          "AllTwoError first variant")
    test.assert(caught_all_two(first, rejected) == "2",
          "AllTwoError second variant")
    local tied_rejection = support.cancelled("all-tied-cancellation")
    task_support.cleanup_task(tied_rejection, "all tied rejection cleanup")
    async.join(tied_rejection)
    test.assert(caught_all_two(rejected, tied_rejection) == "1",
          "all cancellation tie was not left-to-right")
    test.assert(caught_all_three(rejected, first, first) == "1",
          "AllThreeError first variant")
    test.assert(caught_all_three(first, rejected, first) == "2",
          "AllThreeError second variant")
    test.assert(caught_all_three(first, first, rejected) == "3",
          "AllThreeError third variant")
    test.assert(caught_all_four(rejected, first, first, first) == "1",
          "AllFourError first variant")
    test.assert(caught_all_four(first, rejected, first, first) == "2",
          "AllFourError second variant")
    test.assert(caught_all_four(first, first, rejected, first) == "3",
          "AllFourError third variant")
    test.assert(caught_all_four(first, first, first, rejected) == "4",
          "AllFourError fourth variant")
    test.assert(caught_all_five(rejected, first, first, first, first) == "1",
          "AllFiveError first variant")
    test.assert(caught_all_five(first, rejected, first, first, first) == "2",
          "AllFiveError second variant")
    test.assert(caught_all_five(first, first, rejected, first, first) == "3",
          "AllFiveError third variant")
    test.assert(caught_all_five(first, first, first, rejected, first) == "4",
          "AllFiveError fourth variant")
    test.assert(caught_all_five(first, first, first, first, rejected) == "5",
          "AllFiveError fifth variant")

    -- Exercise the live fifth listener rather than the initial status scan.
    local live_all_peer = support.sleeping(60000, "all live peer returned")
    task_support.cleanup_task(live_all_peer, "all live peer cleanup")
    local live_all_failure = support.failing("all-live-logged-failure")
    task_support.cleanup_task(live_all_failure, "all live failure cleanup")
    do
      async.all_five(live_all_peer, live_all_peer, live_all_peer,
                     live_all_peer, live_all_failure)
    catch
      local failure = error as async.AllFiveError
      case failure
      when fifth: status then
        local failed, details? = status:has_failed()
        test.assert(failed and details ~= nil,
              "live all_five listener lost failed Task status")
      else
        raise "live all_five reported the wrong failed position"
      end
    end
    test.assert(not live_all_peer:status():has_finished(),
          "live all_five cancelled an unfinished peer")
    live_all_peer:cancel(
      async.CancellationReason.simple("all live peer cleanup"))
    async.join(live_all_peer)

    local pending = support.sleeping(60000, "late")
    task_support.cleanup_task(pending, "all cleanup")
    do
      async.all_two(rejected, pending)
    catch
      test.assert(error is async.AllTwoError,
            "all raised a value of the wrong type")
    end
    test.assert(not pending:status():has_finished(),
          "all cancelled an unfinished peer after rejection")
    pending:cancel(async.CancellationReason.simple("all cleanup"))
    async.join(pending)

    local failed_task = support.failing("all-logged-failure")
    task_support.cleanup_task(failed_task, "all failure cleanup")
    async.join(failed_task)
    do
      async.all_two(first, failed_task)
    catch
      local failure = error as async.AllTwoError
      case failure
      when second: status then
        local failed, details? = status:has_failed()
        test.assert(failed and details ~= nil,
              "all did not preserve failed Task status")
      else
        raise "all reported the wrong failed position"
      end
    end
    context:log("END expected uncaught async Task diagnostics")
  end)
end

function test_join_arities_and_complete_status_payloads(context: test.Context)
  runtime_test.run(function ()
    context:log("BEGIN expected uncaught async Task diagnostics")
    local timer_task = async.run<value, value>(function (): value
      timer.sleep(2)
      return "joined-timer"
    end)
    task_support.cleanup_task(timer_task, "join timer cleanup")
    local nil_task = support.successful(nil)
    task_support.cleanup_task(nil_task, "join nil cleanup")
    local cancelled_task = support.cancelled("join-cancelled")
    task_support.cleanup_task(cancelled_task, "join cancelled cleanup")
    local failed_task = support.failing("join-logged-failure")
    task_support.cleanup_task(failed_task, "join failure cleanup")
    local operation_task = async.run<value, value>(function (): value
      timer.sleep(-1)
      return nil
    end)
    task_support.cleanup_task(operation_task, "join operation cleanup")

    local timer_status, nil_status, cancelled_status, failed_status,
          operation_status = async.join_five(
              timer_task, nil_task, cancelled_task, failed_task,
              operation_task)
    test.assert(support.success_payload(timer_status) == "joined-timer",
          "join lost timer success payload")
    local nil_succeeded, nil_result? = nil_status:has_succeeded()
    test.assert(nil_succeeded and nil_result == nil,
          "join lost nil success payload")
    test.assert(support.cancelled_payload(cancelled_status) == "join-cancelled",
          "join lost cancellation reason")

    local default_cancelled = support.sleeping(60000, "default cancellation returned")
    task_support.cleanup_task(default_cancelled, "default cancellation cleanup")
    default_cancelled:cancel(nil)
    test.assert(support.cancelled_payload(async.join(default_cancelled)) == "cancelled",
          "cancel(nil) did not preserve the default simple reason")
    local marker: value = {}
    local complex_cancelled = support.sleeping(60000, "complex cancellation returned")
    task_support.cleanup_task(complex_cancelled, "complex cancellation cleanup")
    complex_cancelled:cancel(async.CancellationReason<value>.complex(marker))
    local complex_status = async.join(complex_cancelled)
    local has_complex, complex_reason? = complex_status:has_cancelled()
    test.assert(has_complex and complex_reason ~= nil,
          "complex cancellation did not produce cancelled status")
    case complex_reason as async.CancellationReason
    when complex: payload then
      test.assert(payload == marker, "complex cancellation payload changed")
    else
      raise "complex cancellation became a simple reason"
    end
    local failed, failure? = failed_status:has_failed()
    test.assert(failed and failure ~= nil and
          (failure as async.Error).error == "join-logged-failure",
          "join lost arbitrary failure value")
    test.assert((failure as async.Error).traceback ~= "",
          "Task failure has no traceback")
    test.assert(not support.contains((failure as async.Error).traceback,
                       "stack traceback:") and
          not support.contains((failure as async.Error).traceback,
                       "uncaught error in async Task:"),
          "Error.traceback contains presentation headers")
    local operation_failed, operation_failure? =
      operation_status:has_failed()
    test.assert(operation_failed and operation_failure ~= nil,
          "OperationError Task did not fail")
    test.assert((operation_failure as async.Error).error is async.OperationError,
          "Error.error wrapped or replaced the OperationError")
    local operation_error =
      (operation_failure as async.Error).error as async.OperationError
    test.assert(operation_error.operation == "timer.sleep" and
          operation_error.code < 0 and #operation_error.name > 0 and
          #operation_error.message > 0,
          "Error.error did not retain exact OperationError payload")

    -- Exercise every fixed join arity again with already-terminal Tasks.
    test.assert(async.join(timer_task):as_string() == "succeeded",
          "join single status")
    local j1, j2 = async.join_two(timer_task, cancelled_task)
    test.assert(j1:as_string() == "succeeded" and
          j2:as_string() == "cancelled", "join_two statuses")
    local j3, j4, j5 =
      async.join_three(timer_task, cancelled_task, failed_task)
    test.assert(j3:as_string() == "succeeded" and
          j4:as_string() == "cancelled" and
          j5:as_string() == "failed", "join_three statuses")
    local j6, j7, j8, j9 =
      async.join_four(timer_task, nil_task, cancelled_task, failed_task)
    test.assert(j6:as_string() == "succeeded" and
          j7:as_string() == "succeeded" and
          j8:as_string() == "cancelled" and
          j9:as_string() == "failed", "join_four statuses")
    local j10, j11, j12, j13, j14 = async.join_five(
      timer_task, nil_task, cancelled_task, failed_task, operation_task)
    test.assert(j10:has_finished() and j11:has_finished() and
          j12:has_finished() and j13:has_finished() and
          j14:has_finished(), "join_five returned active status")

    local live_duplicate = support.sleeping(2, "join-live-duplicate")
    task_support.cleanup_task(live_duplicate, "join duplicate cleanup")
    local duplicate_first, duplicate_second =
      async.join_two(live_duplicate, live_duplicate)
    test.assert(support.success_payload(duplicate_first) == "join-live-duplicate" and
          support.success_payload(duplicate_second) == "join-live-duplicate",
          "live join duplicate lost a positional status")
    local live_three = support.sleeping(2, "join-live-three")
    task_support.cleanup_task(live_three, "join three cleanup")
    local three_first, three_second, three_third =
      async.join_three(live_three, live_three, live_three)
    test.assert(support.success_payload(three_first) == "join-live-three" and
          support.success_payload(three_second) == "join-live-three" and
          support.success_payload(three_third) == "join-live-three",
          "live join_three duplicate lost a positional status")
    local live_four = support.sleeping(2, "join-live-four")
    task_support.cleanup_task(live_four, "join four cleanup")
    local four_first, four_second, four_third, four_fourth =
      async.join_four(live_four, live_four, live_four, live_four)
    test.assert(support.success_payload(four_first) == "join-live-four" and
          support.success_payload(four_second) == "join-live-four" and
          support.success_payload(four_third) == "join-live-four" and
          support.success_payload(four_fourth) == "join-live-four",
          "live join_four duplicate lost a positional status")
    local live_five = support.sleeping(2, "join-live-five")
    task_support.cleanup_task(live_five, "join five cleanup")
    local five_first, five_second, five_third, five_fourth, five_fifth =
      async.join_five(live_five, live_five, live_five,
                      live_five, live_five)
    test.assert(support.success_payload(five_first) == "join-live-five" and
          support.success_payload(five_second) == "join-live-five" and
          support.success_payload(five_third) == "join-live-five" and
          support.success_payload(five_fourth) == "join-live-five" and
          support.success_payload(five_fifth) == "join-live-five",
          "live join_five duplicate lost a positional status")
    context:log("END expected uncaught async Task diagnostics")
  end)
end

function test_generic_all_and_join_operand_positions(context: test.Context)
  runtime_test.run(function ()
    local number = async.run<integer, string>(function (): integer
      return 41
    end)
    task_support.cleanup_task(number, "generic all/join number cleanup")
    local text = async.run<string, integer>(function (): string
      return "typed"
    end)
    task_support.cleanup_task(text, "generic all/join text cleanup")
    local flag = async.run<boolean, {string: integer}>(function (): boolean
      return true
    end)
    task_support.cleanup_task(flag, "generic all/join flag cleanup")
    local nothing = async.run<nil, boolean>(function (): nil
      return nil
    end)
    task_support.cleanup_task(nothing, "generic all/join nil cleanup")
    local decimal = async.run<float, string>(function (): float
      return 2.5
    end)
    task_support.cleanup_task(decimal, "generic all/join float cleanup")

    local number_status = async.join(number)
    local number_ok, number_value? = number_status:has_succeeded()
    test.assert(number_ok and (number_value as integer) + 1 == 42,
          "generic join lost its result type")

    local two_number, two_text = async.all_two(number, text)
    test.assert(two_number + 1 == 42 and two_text == "typed",
          "generic all_two lost operand result types")
    local three_text, three_number, three_flag =
      async.all_three(text, number, flag)
    test.assert(three_text == "typed" and three_number + 1 == 42 and
          three_flag, "generic all_three lost operand result types")
    local four_flag, four_text, four_number, four_nil =
      async.all_four(flag, text, number, nothing)
    test.assert(four_flag and four_text == "typed" and
          four_number + 1 == 42 and four_nil == nil,
          "generic all_four lost operand result types")
    local five_float, five_nil, five_flag, five_text, five_number =
      async.all_five(decimal, nothing, flag, text, number)
    test.assert(five_float == 2.5 and five_nil == nil and five_flag and
          five_text == "typed" and five_number + 1 == 42,
          "generic all_five lost operand result types")

    local joined_two_number, joined_two_text = async.join_two(number, text)
    local joined_three_text, joined_three_number, joined_three_flag =
      async.join_three(text, number, flag)
    local joined_four_flag, joined_four_text, joined_four_number,
          joined_four_nil = async.join_four(flag, text, number, nothing)
    local joined_five_float, joined_five_nil, joined_five_flag,
          joined_five_text, joined_five_number =
      async.join_five(decimal, nothing, flag, text, number)
    test.assert(joined_two_number:has_succeeded() and
          joined_two_text:has_succeeded() and
          joined_three_text:has_succeeded() and
          joined_three_number:has_succeeded() and
          joined_three_flag:has_succeeded() and
          joined_four_flag:has_succeeded() and
          joined_four_text:has_succeeded() and
          joined_four_number:has_succeeded() and
          joined_four_nil:has_succeeded() and
          joined_five_float:has_succeeded() and
          joined_five_nil:has_succeeded() and
          joined_five_flag:has_succeeded() and
          joined_five_text:has_succeeded() and
          joined_five_number:has_succeeded(),
          "generic join arities lost exact TaskStatus results")
  end)
end
