local coalescing_receiver_thread = import "thread"
local coalescing_receiver_lua = import "lua"
local coalescing_receiver_gc = import "gc"
local coalescing_receiver_string = import "string"
local coalescing_receiver_transfer = import "transfer"
foreign import "receiver_probe.h"

local coalescing_receiver_hook_encode_calls = 0
local coalescing_receiver_hook_decode_calls = 0

record CoalescingReceiverHookProbe
  local tag: integer
end

function CoalescingReceiverHookProbe.new(tag: integer): CoalescingReceiverHookProbe
  return { tag = tag }
end

function CoalescingReceiverHookProbe:value(): integer
  return self.tag
end

function CoalescingReceiverHookProbe:to_transfer_payload(): string
  coalescing_receiver_hook_encode_calls = coalescing_receiver_hook_encode_calls + 1
  return "" .. self.tag
end

function CoalescingReceiverHookProbe.from_transfer_payload(
    payload: string): CoalescingReceiverHookProbe
  coalescing_receiver_hook_decode_calls = coalescing_receiver_hook_decode_calls + 1
  local parsed = 0
  for index = 1, #payload do
    local code: integer = coalescing_receiver_string.byte(payload, index)
    parsed = parsed * 10 + (code - 48)
  end
  return { tag = parsed }
end

record CoalescingReceiverSenderEnvelope
  ordinal: integer
  probe: CoalescingReceiverHookProbe
  tx: coalescing_receiver_thread.Sender<|integer|>
end

record CoalescingReceiverReceiverEnvelope
  ordinal: integer
  probe: CoalescingReceiverHookProbe
  rx: coalescing_receiver_thread.Receiver<|integer|>
end

record CoalescingReceiverNestedReceiverEnvelope
  ordinal: integer
  probe: CoalescingReceiverHookProbe
  rx: coalescing_receiver_thread.Receiver<|coalescing_receiver_thread.Sender<|integer|>|>
end

record CoalescingReceiverDuplexEnvelope
  ordinal: integer
  probe: CoalescingReceiverHookProbe
  reply: coalescing_receiver_thread.Sender<|string|>
  inbox: coalescing_receiver_thread.Receiver<|integer|>
end

local foreign function coalescing_receiver_counter_retain(raw: *void)
  local count = raw as foreign *int
  count[0] = count[0] + 1
end

local foreign function coalescing_receiver_counter_release(raw: *void)
  local count = raw as foreign *int
  count[0] = count[0] - 1
end

local coalescing_receiver_decode_fail_trace = ""

-- Attaches two counted native resources, then fails decode before claiming
-- either; the traceback at the original raise is saved for comparison.
record CoalescingReceiverDecodeFailProbe
  local first: foreign *void
  local second: foreign *void
end

function CoalescingReceiverDecodeFailProbe:to_transfer_payload(): string
  return coalescing_receiver_transfer.attach_resource(self.first,
      coalescing_receiver_counter_retain, coalescing_receiver_counter_release) ..
    coalescing_receiver_transfer.attach_resource(self.second,
      coalescing_receiver_counter_retain, coalescing_receiver_counter_release)
end

function CoalescingReceiverDecodeFailProbe.from_transfer_payload(
    payload: string): CoalescingReceiverDecodeFailProbe
  do
    raise "coalescing-receiver-decode-fail:" .. #payload
  catch
    coalescing_receiver_decode_fail_trace = traceback
    raise
  end
end

-- Fields decode in order: `before` is adopted into a finalized wrapper before
-- the probe fails, while `after` stays an unclaimed packet attachment.
record CoalescingReceiverDecodeFailEnvelope
  before: coalescing_receiver_thread.Sender<|integer|>
  probe: CoalescingReceiverDecodeFailProbe
  after: coalescing_receiver_thread.Sender<|integer|>
end

local function coalescing_receiver_reset_hook_counts()
  coalescing_receiver_hook_encode_calls = 0
  coalescing_receiver_hook_decode_calls = 0
end

local function coalescing_receiver_expect_error(action: function (): (),
                                                fragment: string?)
  local caught = false
  do
    action()
  catch
    caught = error is string
    if caught and fragment ~= nil then
      test.assert(support.contains(error as string, fragment),
                  "unexpected Receiver diagnostic: " .. (error as string))
    end
  end
  test.assert(caught, "invalid Receiver operation succeeded")
end

local function coalescing_receiver_unwrap_handle(
    item: async.TransferValue): foreign *void
  case item
  when is_pointer(pointer) then return pointer
  else raise "expected pointer TransferValue for Receiver handle"
  end
end

-- Check callbacks run after the I/O poll. A pending Receiver callback
-- therefore queues its reader before this ordinary await resumes the observer
-- directly from check, without driving the Runtime loop from test code.
local function coalescing_receiver_after_poll()
  local phase = uv.check_t.new()
  test.assert(uv.check_init(async.current_loop(), phase) == 0)
  local handle = phase:as_handle_t()
  defer if not uv.is_closing(handle) then uv.close(handle) end
  local idle = uv.idle_t.new()
  test.assert(uv.idle_init(async.current_loop(), idle) == 0)
  local idle_handle = idle:as_handle_t()
  defer if not uv.is_closing(idle_handle) then uv.close(idle_handle) end
  -- A check watcher alone does not prevent the poll from blocking when the
  -- signal was already processed. Keep this barrier's own poll nonblocking.
  test.assert(uv.idle_start(idle, function (_: uv.idle_t) end) == 0)
  async.await<|nil, nil|>(function (resolve, _reject, fatal)
    test.assert(uv.check_start(phase, function (current: uv.check_t)
      do
        test.assert(uv.check_stop(current) == 0)
        uv.close(handle)
        test.assert(uv.idle_stop(idle) == 0)
        uv.close(idle_handle)
        resolve(nil)
      catch
        fatal(error, traceback)
        raise
      end
    end) == 0)
  end)
end

-- A prepare callback following the completed poll/check phase observes the
-- ready timer's delivery of an already queued reader wake. This is a phase
-- barrier, not an assumption about a number of Task yields or elapsed time.
local function coalescing_receiver_after_ready_delivery()
  local phase = uv.prepare_t.new()
  test.assert(uv.prepare_init(async.current_loop(), phase) == 0)
  local handle = phase:as_handle_t()
  defer if not uv.is_closing(handle) then uv.close(handle) end
  async.await<|nil, nil|>(function (resolve, _reject, fatal)
    test.assert(uv.prepare_start(phase, function (current: uv.prepare_t)
      do
        test.assert(uv.prepare_stop(current) == 0)
        uv.close(handle)
        resolve(nil)
      catch
        fatal(error, traceback)
        raise
      end
    end) == 0)
  end)
end

local function send_ephemeral_sender_in_frame(
    handle: foreign *void,
    ordinal: integer): coalescing_receiver_thread.Receiver<|integer|>
  local tx, rx = coalescing_receiver_thread.channel<|integer|>(1)
  local env = CoalescingReceiverSenderEnvelope(
    ordinal, CoalescingReceiverHookProbe.new(ordinal), tx)
  async.send(handle, env)
  return rx
end

local function send_ephemeral_sender(
    handle: foreign *void,
    ordinal: integer): coalescing_receiver_thread.Receiver<|integer|>
  local rx = send_ephemeral_sender_in_frame(handle, ordinal)
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not rx:is_closed(),
    "Receiver slot did not retain the sole channel Sender reference")
  return rx
end

local function send_ephemeral_nested_receiver_in_frame(
    handle: foreign *void,
    ordinal: integer): (coalescing_receiver_thread.Sender<|coalescing_receiver_thread.Sender<|integer|>|>,
                        coalescing_receiver_thread.Receiver<|integer|>)
  local outer_tx, outer_rx =
    coalescing_receiver_thread.channel<|coalescing_receiver_thread.Sender<|integer|>|>(1)
  local inner_tx, inner_rx = coalescing_receiver_thread.channel<|integer|>(1)
  test.assert(outer_tx:try_send(inner_tx),
    "could not buffer nested Sender inside outer channel")
  local env = CoalescingReceiverNestedReceiverEnvelope(
    ordinal, CoalescingReceiverHookProbe.new(ordinal), outer_rx)
  async.send(handle, env)
  return outer_tx, inner_rx
end

local function send_ephemeral_nested_receiver(
    handle: foreign *void,
    ordinal: integer): (coalescing_receiver_thread.Sender<|coalescing_receiver_thread.Sender<|integer|>|>,
                        coalescing_receiver_thread.Receiver<|integer|>)
  local outer_tx, inner_rx = send_ephemeral_nested_receiver_in_frame(handle, ordinal)
  support.collect_garbage()
  support.collect_garbage()
  test.assert(not outer_tx:is_closed() and not inner_rx:is_closed(),
    "Receiver slot did not retain the sole outer Receiver and buffered inner Sender")
  return outer_tx, inner_rx
end

local function wait_and_drop_decoded_envelope(
    receiver: async.Receiver,
    ordinal: integer): coalescing_receiver_thread.Receiver<|integer|>
  local rx = send_ephemeral_sender(receiver:handle(), ordinal)
  local delivered: CoalescingReceiverSenderEnvelope = receiver:wait()
  test.assert(delivered.ordinal == ordinal and not rx:is_closed(),
    "wait did not adopt the live Sender endpoint")
  return rx
end

function test_receiver_replace_before_callback_disposes_displaced_endpoints_without_decode(
    _context: test.Context)
  coalescing_receiver_reset_hook_counts()
  runtime_test.run(function ()
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    -- Publish 101 into the native slot before yielding to any loop callback.
    local rx1 = send_ephemeral_sender(handle, 101)
    defer rx1:close()
    test.assert(coalescing_receiver_hook_encode_calls == 1 and
                coalescing_receiver_hook_decode_calls == 0)

    -- Replacing before callback delivery must discard directly in C.
    local outer_tx2, inner_rx2 = send_ephemeral_nested_receiver(handle, 102)
    defer outer_tx2:close()
    defer inner_rx2:close()
    test.assert(rx1:is_closed(),
      "displaced Sender packet did not auto-close its peer Receiver")
    test.assert(not outer_tx2:is_closed() and not inner_rx2:is_closed(),
      "current Receiver packet in slot prematurely released its endpoints")
    test.assert(coalescing_receiver_hook_decode_calls == 0,
      "displacing a packet invoked a user transfer decoder")

    -- Discarding the outer Receiver also drains its buffered inner Sender.
    local rx3 = send_ephemeral_sender(handle, 103)
    defer rx3:close()
    test.assert(outer_tx2:is_closed() and inner_rx2:is_closed(),
      "displaced Receiver packet did not release outer channel and queued inner endpoint")
    test.assert(not rx3:is_closed() and coalescing_receiver_hook_decode_calls == 0,
      "latest packet was disturbed or decoded during replacement")

    local restored: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(restored.ordinal == 103 and restored.probe:value() == 103)
    test.assert(coalescing_receiver_hook_encode_calls == 3 and
                coalescing_receiver_hook_decode_calls == 1,
      "Receiver:wait did not invoke the decoder exactly once for the surviving packet")
    test.assert(not rx3:is_closed(),
      "decoding the surviving packet prematurely closed its adopted endpoint")
    test.assert(restored.tx:try_send(919))
    local ok, value? = rx3:try_receive()
    test.assert(ok and value == 919,
      "adopted Sender from Receiver did not deliver to its peer Receiver")
    restored.tx:close()
    test.assert(rx3:is_closed())
  end)
end

function test_receiver_callbacks_wake_only_and_replace_before_wait(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local rx1 = send_ephemeral_sender(handle, 201)
    defer rx1:close()
    -- Observe the completed I/O phase while no reader is registered.
    coalescing_receiver_after_poll()
    support.collect_garbage()
    test.assert(not rx1:is_closed() and coalescing_receiver_hook_decode_calls == 0,
      "wake callback consumed or decoded the unread packet when no reader waited")

    local rx2 = send_ephemeral_sender(handle, 202)
    defer rx2:close()
    test.assert(rx1:is_closed() and not rx2:is_closed() and
                coalescing_receiver_hook_decode_calls == 0,
      "post-callback replacement did not dispose the earlier unread packet")
    coalescing_receiver_after_poll()
    support.collect_garbage()
    test.assert(not rx2:is_closed() and coalescing_receiver_hook_decode_calls == 0)

    local env2: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(env2.ordinal == 202 and env2.probe:value() == 202)
    test.assert(coalescing_receiver_hook_decode_calls == 1)
    test.assert(env2.tx:try_send(2020))
    local ok2, val2? = rx2:try_receive()
    test.assert(ok2 and val2 == 2020)
    env2.tx:close()

    local rx3 = send_ephemeral_sender(handle, 203)
    defer rx3:close()
    local env3: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(env3.ordinal == 203 and env3.probe:value() == 203)
    test.assert(coalescing_receiver_hook_decode_calls == 2)
    test.assert(env3.tx:try_send(2030))
    local ok3, val3? = rx3:try_receive()
    test.assert(ok3 and val3 == 2030)
    env3.tx:close()
  end)
end

function test_receiver_queued_wake_rejects_second_reader_and_coalesces_replacement(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local reader1 = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(reader1, "Receiver reserved reader1 cleanup")
    support.wait_until_waiting(reader1)

    -- Contention while reader1 is parked before any packet arrives.
    coalescing_receiver_expect_error(function ()
      receiver:wait()
    end, "waiting")

    local rx1 = send_ephemeral_sender(handle, 301)
    defer rx1:close()
    -- The check-phase observer resumes before the ready timer can deliver
    -- reader1's queued wake. The packet must still belong to the native slot.
    coalescing_receiver_after_poll()
    test.assert(reader1:status():as_string() == "waiting" and
                not rx1:is_closed() and coalescing_receiver_hook_decode_calls == 0,
      "wake callback consumed or decoded the reserved reader's packet")
    -- A second reader must not take the published packet across that wake.
    coalescing_receiver_expect_error(function ()
      receiver:wait()
    end, "waiting")

    local rx2 = send_ephemeral_sender(handle, 302)
    defer rx2:close()
    test.assert(rx1:is_closed() and not rx2:is_closed() and
                coalescing_receiver_hook_decode_calls == 0,
      "replacing packet during queued wake did not dispose displaced packet")
    local st_reader1 = async.join(reader1)
    case st_reader1
    when succeeded(delivered) then
      local env2: CoalescingReceiverSenderEnvelope = delivered
      test.assert(env2.ordinal == 302 and env2.probe:value() == 302,
        "woken reader1 did not receive the replacement packet")
      test.assert(coalescing_receiver_hook_decode_calls == 1)
      test.assert(env2.tx:try_send(3020))
      local ok2, val2? = rx2:try_receive()
      test.assert(ok2 and val2 == 3020)
      env2.tx:close()
    else
      raise "reserved reader1 did not succeed after queued wake"
    end

    -- Reservation must be released once wait returns.
    local rx3 = send_ephemeral_sender(handle, 303)
    defer rx3:close()
    local env3: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(env3.ordinal == 303 and coalescing_receiver_hook_decode_calls == 2)
    env3.tx:close()
  end)
end

function test_receiver_cancelled_reader_preserves_unread_packet(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    local waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "cancelled Receiver reader cleanup")
    support.wait_until_waiting(waiting)

    -- Neither send nor cancel yields: cancellation wins before delivery
    -- and must withdraw only the reader reservation while leaving 401 unread.
    local rx1 = send_ephemeral_sender(handle, 401)
    defer rx1:close()
    waiting:cancel(async.CancellationReason.simple("Receiver wait cancelled"))
    test.assert(support.cancelled_with(
      async.join(waiting), "Receiver wait cancelled"))
    support.collect_garbage()
    test.assert(not rx1:is_closed() and coalescing_receiver_hook_decode_calls == 0,
      "cancelled reader consumed or discarded the unread packet")

    -- A started Task with pending cancellation must fail at wait's checkpoint()
    -- before exchanging the unread slot, releasing its reservation cleanly.
    local entered_wait = false
    local pre_cancelled = async.run<|value, value|>(function (): value
      entered_wait = true
      async.running():cancel(async.CancellationReason.simple("pre-cancelled reader"))
      return receiver:wait()
    end)
    task_support.cleanup_task(pre_cancelled, "pre-cancelled Receiver reader")
    test.assert(support.cancelled_with(
      async.join(pre_cancelled), "pre-cancelled reader"))
    test.assert(entered_wait and not rx1:is_closed() and
                coalescing_receiver_hook_decode_calls == 0,
      "reader with pending cancellation took the unread packet before checkpoint")

    local env1: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(env1.ordinal == 401 and env1.probe:value() == 401)
    test.assert(coalescing_receiver_hook_decode_calls == 1)
    test.assert(env1.tx:try_send(4010))
    local ok1, val1? = rx1:try_receive()
    test.assert(ok1 and val1 == 4010)
    env1.tx:close()

    local rx2 = send_ephemeral_sender(handle, 402)
    defer rx2:close()
    local env2: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(env2.ordinal == 402 and coalescing_receiver_hook_decode_calls == 2)
    env2.tx:close()
  end)
end

function test_receiver_send_between_empty_check_and_suspension_and_stale_wake_recheck(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local handle = receiver:handle()

    -- Part 1: Send between the empty-slot check/suspension and the loop's I/O poll.
    -- Queue reader and sender together on the ready queue: reader runs first,
    -- checks the empty slot, sets notified = false, and yields into suspend;
    -- sender runs immediately in the same ready batch before uv_run polls
    -- uv.async_t, publishing 501 and leaving a pending UV signal.
    local rx1: coalescing_receiver_thread.Receiver<|integer|>? = nil
    local reader_between = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(reader_between, "reader_between cleanup")
    local sender_between = async.run<|nil, value|>(function (): nil
      test.assert(reader_between:status():as_string() == "waiting",
        "reader did not suspend after empty check")
      rx1 = send_ephemeral_sender(handle, 501)
      return nil
    end)
    task_support.cleanup_task(sender_between, "sender_between cleanup")

    local st_sender, st_reader = async.join_two(sender_between, reader_between)
    defer if rx1 ~= nil then rx1:close() end
    local sender_ok, sender_payload? = st_sender:has_succeeded()
    test.assert(sender_ok and sender_payload == nil,
      "sender failed to publish after the reader suspended on the empty slot")
    case st_reader
    when succeeded(delivered1) then
      local env1: CoalescingReceiverSenderEnvelope = delivered1
      test.assert(env1.ordinal == 501 and coalescing_receiver_hook_decode_calls == 1)
      env1.tx:close()
    else
      raise "reader missed a send between empty check and UV poll"
    end

    -- Part 2: Inert stale wake recheck.
    -- Send 502 and consume it immediately via the synchronous fast path
    -- before uv_run polls uv.async_t. That leaves the UV async signal pending
    -- for a now-empty slot.
    local rx_fast = send_ephemeral_sender(handle, 502)
    defer rx_fast:close()
    local env_fast: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(env_fast.ordinal == 502 and coalescing_receiver_hook_decode_calls == 2)
    env_fast.tx:close()

    -- Now park a reader on the empty slot; the next loop turn delivers the
    -- stale UV async callback from 502. The reader must recheck the empty
    -- slot, reset notified = false, keep its reservation, and re-suspend.
    local waiting_stale = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting_stale, "waiting_stale cleanup")
    support.wait_until_waiting(waiting_stale)
    coalescing_receiver_after_poll()
    coalescing_receiver_after_ready_delivery()
    test.assert(waiting_stale:status():as_string() == "waiting",
      "inert stale wake terminated or spun the waiting reader")
    coalescing_receiver_expect_error(function ()
      receiver:wait()
    end, "waiting")

    local rx_after_stale = send_ephemeral_sender(handle, 503)
    defer rx_after_stale:close()
    case async.join(waiting_stale)
    when succeeded(delivered_after) then
      local env_after: CoalescingReceiverSenderEnvelope = delivered_after
      test.assert(env_after.ordinal == 503 and coalescing_receiver_hook_decode_calls == 3)
      test.assert(env_after.tx:try_send(5030))
      local ok_after, val_after? = rx_after_stale:try_receive()
      test.assert(ok_after and val_after == 5030)
      env_after.tx:close()
    else
      raise "reader did not wake for real packet after inert stale wake recheck"
    end
  end)
end

function test_receiver_close_and_shutdown_dispose_endpoints_without_decode(
    _context: test.Context)
  coalescing_receiver_reset_hook_counts()
  runtime_test.run(function ()
    -- 1. Closing a Receiver wakes a parked reader with "receiver is closed".
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "closed Receiver waiter cleanup")
    support.wait_until_waiting(waiting)
    receiver:close()
    receiver:close()
    case async.join(waiting)
    when failed(failure) then
      test.assert(failure.error == "receiver is closed",
        "closing Receiver raised wrong error on parked reader")
    else
      raise "closing Receiver did not fail its waiting Task"
    end
    coalescing_receiver_expect_error(function ()
      receiver:wait()
    end, "closed")

    -- 2. Closing a Receiver with an unread packet disposes it immediately
    -- without calling any decoder.
    local unread_receiver = async.receiver()
    runtime_test.cleanup(function () unread_receiver:close() end)
    local outer_tx_unread, inner_rx_unread =
      send_ephemeral_nested_receiver(unread_receiver:handle(), 601)
    defer outer_tx_unread:close()
    defer inner_rx_unread:close()
    test.assert(not outer_tx_unread:is_closed() and not inner_rx_unread:is_closed())
    unread_receiver:close()
    unread_receiver:close()
    test.assert(outer_tx_unread:is_closed() and inner_rx_unread:is_closed(),
      "closing Receiver did not dispose its unread packet attachments")
    test.assert(coalescing_receiver_hook_decode_calls == 0,
      "closing Receiver invoked a transfer decoder")
    coalescing_receiver_expect_error(function ()
      unread_receiver:wait()
    end, "closed")

    -- 3. Dropping a decoded envelope returned by wait() releases its adopted
    -- endpoint on GC, and lua_close finalization of an unclosed Receiver in an
    -- independent state disposes its unread packet without decoding.
    local drop_receiver = async.receiver()
    runtime_test.cleanup(function () drop_receiver:close() end)
    local rx_gc_dropped = wait_and_drop_decoded_envelope(drop_receiver, 602)
    defer rx_gc_dropped:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx_gc_dropped:is_closed() and coalescing_receiver_hook_decode_calls == 1,
      "dropping decoded envelope from wait did not release its endpoint on GC")

    local state = coalescing_receiver_lua.new()
    defer state:close()
    local remote_unclosed = coalescing_receiver_unwrap_handle(state:run([[
      package.path, package.cpath = '', ''
      local async = require('titan.async')
      _G.held_unclosed_receiver = async.receiver()
      return _G.held_unclosed_receiver:handle()
    ]], "=receiver-finalize-on-lua-close"))
    local rx_lua_close = send_ephemeral_sender(remote_unclosed, 603)
    defer rx_lua_close:close()
    state:close()
    test.assert(rx_lua_close:is_closed() and coalescing_receiver_hook_decode_calls == 1,
      "lua_close finalization of unclosed Receiver did not dispose unread packet")
  end)

  -- 4. Runtime shutdown disables a retained Receiver and disposes its
  -- unread packet without invoking any decoder.
  local shutdown_receiver: async.Receiver? = nil
  local rx_shutdown: coalescing_receiver_thread.Receiver<|integer|>? = nil
  runtime_test.run(function ()
    local receiver = async.receiver()
    shutdown_receiver = receiver
    rx_shutdown = send_ephemeral_sender(receiver:handle(), 604)
  end)
  defer shutdown_receiver:close()
  defer rx_shutdown:close()
  test.assert(rx_shutdown:is_closed() and coalescing_receiver_hook_decode_calls == 1,
    "Runtime shutdown did not dispose unread packet in retained Receiver")
  local tx_after_shutdown, rx_after_shutdown =
    coalescing_receiver_thread.channel<|integer|>(1)
  defer tx_after_shutdown:close()
  defer rx_after_shutdown:close()
  local env_after_shutdown = CoalescingReceiverSenderEnvelope(
    605, CoalescingReceiverHookProbe.new(605), tx_after_shutdown)
  coalescing_receiver_expect_error(function ()
    async.send(shutdown_receiver:handle(), env_after_shutdown)
  end, "closed")
  test.assert(not rx_after_shutdown:is_closed(),
    "rejected send after Runtime shutdown closed caller's live Sender")
  runtime_test.run(function ()
    coalescing_receiver_expect_error(function ()
      shutdown_receiver:wait()
    end, "closed")
  end)
end

local foreign function coalescing_receiver_count(counter: *void, slot: int)
  local counts = counter as foreign *int
  counts[slot] = counts[slot] + (1 as foreign int)
end

local coalescing_receiver_abandoned_inbox: async.Receiver? = nil
local coalescing_receiver_abandoned_sender: coalescing_receiver_thread.Sender<|integer|>? = nil

record CoalescingReceiverLoopOracle
  loop: uv.loop_t?
  counts: foreign *void
end
local coalescing_receiver_loop_probe: CoalescingReceiverLoopOracle? = nil

local function coalescing_receiver_loop_oracle(owner: CoalescingReceiverLoopOracle)
  -- Registered before Runtime creation, so it observes retirement afterward.
  if owner.loop ~= nil and uv.loop_close(owner.loop) == uv.EINVAL then
    coalescing_receiver_count(owner.counts, 5)
  end
end

-- Public only so a fresh independent state can call it; test infrastructure.
-- Leaves that state's Runtime unretired with a live Receiver, an active timer
-- and a timer whose requested close was never drained. With park_task, one
-- borrowed loop turn first parks a Task in a linked external wait.
-- Host counters: [0] finalized-owner callback, [1] registrations,
-- [2] unregistrations, [3] Runtime listeners, [4] recursive-loop callback,
-- [5] successful loop-closure oracle.
function coalescing_receiver_abandoned_runtime_bootstrap(
    counts_raw: value, park_task: boolean): foreign *void
  local counts = counts_raw as foreign *void
  local oracle = CoalescingReceiverLoopOracle(nil, counts)
  coalescing_receiver_gc.finalizable(oracle, coalescing_receiver_loop_oracle)
  coalescing_receiver_loop_probe = oracle
  local owner = async.receiver()
  coalescing_receiver_abandoned_inbox = owner
  local loop = async.current_loop()
  oracle.loop = loop
  async.add_close_listener(function ()
    coalescing_receiver_count(counts, 3)
  end)
  local live = uv.timer_t.new()
  test.assert(uv.timer_init(loop, live) == 0)
  test.assert(uv.timer_start(live, function (_: uv.timer_t) end, 60000, 0) == 0)
  if park_task then
    local parked = async.run<|nil, value|>(function (): nil
      async.wait_external(function (_: foreign *void): boolean
        coalescing_receiver_count(counts, 1)
        return true
      end, function ()
        coalescing_receiver_count(counts, 2)
      end)
      return nil
    end)
    local channel_waiter = async.run<|integer, value|>(function (): integer
      -- Endpoints are newer than this coroutine, so their finalizers withdraw
      -- the intrusive wait while its stack is still allocated.
      local tx, rx = coalescing_receiver_thread.channel<|integer|>(1)
      coalescing_receiver_abandoned_sender = tx
      return rx:receive()
    end)
    uv.run(loop, uv.RUN_NOWAIT)
    test.assert(parked:status():as_string() == "waiting",
      "abandoned Runtime Task did not park in its external wait")
    test.assert(channel_waiter:status():as_string() == "waiting",
      "abandoned Runtime channel Task did not register a real native waiter")
  end
  -- This Thread's finalizer runs before Runtime retirement and clears its
  -- native pointer. Dispatching its captured callback afterward is unsafe.
  local worker = coalescing_receiver_thread.spawn(function (): integer return 17 end)
  local closing = uv.timer_t.new()
  test.assert(uv.timer_init(loop, closing) == 0)
  uv.close(closing:as_handle_t(), function (_: uv.handle_t)
    coalescing_receiver_count(counts, 0)
    worker:status()
  end)
  local recursive = uv.timer_t.new()
  test.assert(uv.timer_init(loop, recursive) == 0)
  uv.close(recursive:as_handle_t(), function (_: uv.handle_t)
    coalescing_receiver_count(counts, 4)
    async.loop()
  end)
  return owner:handle()
end

local function coalescing_receiver_close_unretired_runtime(park_task: boolean)
  local counts: owned int[] = foreign int.new_array(6)
  counts[0] = 0
  counts[1] = 0
  counts[2] = 0
  counts[3] = 0
  counts[4] = 0
  counts[5] = 0
  local registrations = 0
  if park_task then registrations = 1 end
  local state = coalescing_receiver_lua.new()
  defer state:close()
  local remote = coalescing_receiver_unwrap_handle(state:run([[
    package.path, package.cpath = '', ''
    return require('async.tests').coalescing_receiver_abandoned_runtime_bootstrap(...)
  ]], "=abandoned-runtime-bootstrap",
    async.TransferValue.is_pointer(counts as foreign *void),
    async.TransferValue.is_boolean(park_task)))
  local rx = send_ephemeral_sender(remote, 701)
  defer rx:close()
  test.assert((counts[0] as integer) == 0 and (counts[1] as integer) == registrations and
              (counts[2] as integer) == 0 and not rx:is_closed(),
    "unretired Runtime delivered a close or disposed its unread packet early")
  -- Neither requested user callback may run after owner finalization. A
  -- separately ordered finalizer must observe successful native loop close.
  state:close()
  test.assert((counts[0] as integer) == 0,
    "lua_close dispatched a callback capturing an already-finalized Thread")
  test.assert((counts[5] as integer) == 1,
    "lua_close did not successfully close the unretired Runtime's loop")
  -- The parked Task unwinds at close: its wait's own cleanup withdraws the
  -- closure registration exactly once, and nothing registers again.
  test.assert((counts[1] as integer) == registrations and
              (counts[2] as integer) == registrations,
    "lua_close did not withdraw the abandoned external wait exactly once")
  test.assert((counts[3] as integer) == 0,
    "lua_close entered a Runtime-close listener")
  test.assert((counts[4] as integer) == 0,
    "lua_close dispatched a callback that could recursively drive async.loop")
  test.assert(rx:is_closed(),
    "lua_close finalization of an unclosed Receiver kept its unread packet")
end

function test_receiver_lua_close_retires_unretired_runtime_loop(context: test.Context)
  context:run("undriven", function (_: test.Context)
    coalescing_receiver_close_unretired_runtime(false)
  end)
  context:run("abandoned-with-parked-task", function (_: test.Context)
    coalescing_receiver_close_unretired_runtime(true)
  end)
end

local function coalescing_receiver_retire_runtime()
  local owner = async.receiver()
  owner:close()
  async.loop()
end

-- Public only for execution in an independent state with its own Runtime.
function coalescing_receiver_collect_runtime()
  coalescing_receiver_gc.pause()
  coalescing_receiver_retire_runtime()
  local owner = async.receiver()
  local loop = async.current_loop()
  local closed = false
  async.add_close_listener(function () closed = true end)
  coalescing_receiver_gc.resume()
  -- The old Runtime is unreachable; the new active one is module-rooted.
  coalescing_receiver_gc.collect()
  coalescing_receiver_gc.collect()
  test.assert(async.current_loop() == loop and not closed,
    "ordinary GC retired the active Runtime or notified its close listener")
  async.send(owner:handle(), 709)
  local task = async.run<|integer, value|>(function (): integer
    defer owner:close()
    return owner:wait()
  end)
  async.loop()
  local succeeded, result? = task:status():has_succeeded()
  test.assert(succeeded and result == 709 and closed,
    "ordinary GC changed driven Runtime completion or listener notification")
end

function test_receiver_runtime_finalizer_is_inert_during_ordinary_gc(_: test.Context)
  local state = coalescing_receiver_lua.new()
  defer state:close()
  state:run([[
    package.path, package.cpath = '', ''
    require('async.tests').coalescing_receiver_collect_runtime()
  ]], "=runtime-ordinary-gc")
end

local function send_decode_failing_envelope_in_frame(
    handle: foreign *void,
    first: foreign *void,
    second: foreign *void): (coalescing_receiver_thread.Receiver<|integer|>,
                             coalescing_receiver_thread.Receiver<|integer|>)
  local before_tx, before_rx = coalescing_receiver_thread.channel<|integer|>(1)
  local after_tx, after_rx = coalescing_receiver_thread.channel<|integer|>(1)
  async.send(handle, CoalescingReceiverDecodeFailEnvelope(
    before_tx, CoalescingReceiverDecodeFailProbe(first, second), after_tx))
  return before_rx, after_rx
end

-- Receiver:wait guards a fresh raw local only after the native take; a decode
-- failure must consume that packet once, raise the decoder's original error
-- and traceback, and leave the reader reservation and slot ready for reuse.
function test_receiver_wait_decode_failure_consumes_packet_and_keeps_receiver_usable(
    _context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    runtime_test.cleanup(function () receiver:close() end)
    local c1: owned int[] = foreign int.new_array(1)
    local c2: owned int[] = foreign int.new_array(1)
    c1[0] = 1
    c2[0] = 1
    local before_rx, after_rx = send_decode_failing_envelope_in_frame(
      receiver:handle(), c1 as foreign *void, c2 as foreign *void)
    defer before_rx:close()
    defer after_rx:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not before_rx:is_closed() and not after_rx:is_closed() and
                c1[0] == 2 and c2[0] == 2,
      "Receiver slot did not retain every packet attachment")

    coalescing_receiver_decode_fail_trace = ""
    local failed = false
    local preserved_trace = false
    do
      receiver:wait()
    catch
      failed = error is string and
        support.contains(error as string, "coalescing-receiver-decode-fail:8")
      preserved_trace = #coalescing_receiver_decode_fail_trace > 0 and
        traceback == coalescing_receiver_decode_fail_trace
    end
    test.assert(failed, "Receiver:wait did not raise the decoder's error")
    test.assert(preserved_trace,
      "Receiver:wait replaced the decoder's original traceback")
    -- Before any explicit collection, decode's catch has released each
    -- unclaimed attachment exactly once; only the adopted Sender waits for
    -- its wrapper finalizer.
    test.assert(c1[0] == 1 and c2[0] == 1 and after_rx:is_closed(),
      "failed Receiver:wait decode did not release unclaimed attachments once")
    support.collect_garbage()
    support.collect_garbage()
    test.assert(c1[0] == 1 and c2[0] == 1 and before_rx:is_closed(),
      "failed Receiver:wait decode released twice or leaked the adopted Sender")

    -- The reader reservation and native slot are clear for the next value.
    local rx_next = send_ephemeral_sender(receiver:handle(), 701)
    defer rx_next:close()
    local delivered: CoalescingReceiverSenderEnvelope = receiver:wait()
    test.assert(delivered.ordinal == 701 and delivered.probe:value() == 701,
      "Receiver was unusable after a failed decode")
    test.assert(delivered.tx:try_send(7010))
    local ok, item? = rx_next:try_receive()
    test.assert(ok and item == 7010)
    delivered.tx:close()
  end)
end

local function send_ephemeral_sender_to_closed_in_frame(
    closed_handle: foreign *void,
    ordinal: integer): coalescing_receiver_thread.Receiver<|integer|>
  local tx, rx = coalescing_receiver_thread.channel<|integer|>(1)
  local env = CoalescingReceiverSenderEnvelope(
    ordinal, CoalescingReceiverHookProbe.new(ordinal), tx)
  coalescing_receiver_expect_error(function ()
    async.send(closed_handle, env)
  end, "closed")
  return rx
end

local function send_ephemeral_sender_expecting_notify_failure_in_frame(
    handle: foreign *void,
    ordinal: integer,
    expected_code: integer): coalescing_receiver_thread.Receiver<|integer|>
  local tx, rx = coalescing_receiver_thread.channel<|integer|>(1)
  local env = CoalescingReceiverSenderEnvelope(
    ordinal, CoalescingReceiverHookProbe.new(ordinal), tx)
  local notify_failed = false
  do
    async.send(handle, env)
  catch
    if error is async.OperationError then
      local op_err = error as async.OperationError
      notify_failed = op_err.operation == "async.send" and
                      op_err.code == expected_code
    end
  end
  test.assert(notify_failed,
    "post-commit notification failure did not raise OperationError(async.send)")
  return rx
end

function test_receiver_pre_admit_guard_and_post_exchange_notification_failure(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    local owned_rx = async.receiver()
    runtime_test.cleanup(function () owned_rx:close() end)
    local closed_rx = async.receiver()
    runtime_test.cleanup(function () closed_rx:close() end)
    closed_rx:close()

    -- Pre-admission rejection on a closed Receiver must discard the temporary
    -- encoded packet natively (releasing its attached endpoint unit) while
    -- leaving the caller's value live for later sends.
    local rx_discarded_temp =
      send_ephemeral_sender_to_closed_in_frame(closed_rx:handle(), 700)
    defer rx_discarded_temp:close()
    support.collect_garbage()
    support.collect_garbage()
    test.assert(rx_discarded_temp:is_closed() and
                coalescing_receiver_hook_encode_calls == 1 and
                coalescing_receiver_hook_decode_calls == 0,
      "closed-receiver send guard leaked or decoded the rejected temporary packet")

    local tx_preserved, rx_preserved = coalescing_receiver_thread.channel<|integer|>(1)
    defer tx_preserved:close()
    defer rx_preserved:close()
    local env_preserved = CoalescingReceiverSenderEnvelope(
      701, CoalescingReceiverHookProbe.new(701), tx_preserved)

    coalescing_receiver_expect_error(function ()
      async.send(nil, env_preserved)
    end, "NULL")
    test.assert(not rx_preserved:is_closed() and
                coalescing_receiver_hook_encode_calls == 1)

    coalescing_receiver_expect_error(function ()
      async.send(closed_rx:handle(), env_preserved)
    end, "closed")
    test.assert(not rx_preserved:is_closed() and
                coalescing_receiver_hook_encode_calls == 2 and
                coalescing_receiver_hook_decode_calls == 0,
      "pre-admit send rejection closed the caller's live Sender or decoded")

    async.send(owned_rx:handle(), env_preserved)
    local env_delivered: CoalescingReceiverSenderEnvelope = owned_rx:wait()
    test.assert(env_delivered.ordinal == 701 and
                coalescing_receiver_hook_decode_calls == 1)
    test.assert(env_delivered.tx:try_send(7010))
    local ok_p, val_p? = rx_preserved:try_receive()
    test.assert(ok_p and val_p == 7010)
    env_delivered.tx:close()

    -- Seed owned_rx with 702, then verify an encoding failure before C admission
    -- leaves the unread packet in owned_rx's slot untouched.
    local rx_slot = send_ephemeral_sender(owned_rx:handle(), 702)
    defer rx_slot:close()
    coalescing_receiver_expect_error(function ()
      async.send(owned_rx:handle(),
        async.TransferValue.is_function(nil as foreign function (*lua_State): int))
    end, "NULL Lua C function")
    test.assert(not rx_slot:is_closed(),
      "pre-exchange encode rejection disturbed the unread packet in owned_rx")

    -- Post-exchange notification error: using the scoped probe fixture, override
    -- receiver->send to return uv.ENOMEM after atomic slot exchange.
    -- The displaced packet (702) must be disposed, the new packet (703) must
    -- remain committed in owned_rx's slot even after the sender's local is
    -- collected (proving the caller's raw local was cleared before raising),
    -- and wait() must still recover and decode 703.
    local guard: owned *titan_receiver_send_guard =
      foreign titan_receiver_send_guard.new()
    ffi.titan_receiver_guard_install(
      guard, owned_rx:handle(), uv.ENOMEM as foreign int)
    defer ffi.titan_receiver_guard_restore(guard)

    local rx_committed = send_ephemeral_sender_expecting_notify_failure_in_frame(
      owned_rx:handle(), 703, uv.ENOMEM)
    defer rx_committed:close()
    ffi.titan_receiver_guard_restore(guard)
    support.collect_garbage()
    support.collect_garbage()
    test.assert((ffi.titan_receiver_guard_calls(guard) as integer) == 1,
      "notification probe was not invoked exactly once")
    test.assert(rx_slot:is_closed(),
      "post-commit notification failure did not dispose displaced packet")
    test.assert(not rx_committed:is_closed() and
                coalescing_receiver_hook_decode_calls == 1,
      "post-commit notification failure lost or decoded the committed packet")

    local env_committed: CoalescingReceiverSenderEnvelope = owned_rx:wait()
    test.assert(env_committed.ordinal == 703 and
                coalescing_receiver_hook_decode_calls == 2)
    test.assert(env_committed.tx:try_send(7030))
    local ok_c, val_c? = rx_committed:try_receive()
    test.assert(ok_c and val_c == 7030)
    env_committed.tx:close()

    ffi.titan_receiver_guard_install(
      guard, owned_rx:handle(), uv.EIO as foreign int)
    local rx_committed_close = send_ephemeral_sender_expecting_notify_failure_in_frame(
      owned_rx:handle(), 704, uv.EIO)
    defer rx_committed_close:close()
    ffi.titan_receiver_guard_restore(guard)
    support.collect_garbage()
    support.collect_garbage()
    test.assert(not rx_committed_close:is_closed() and
                coalescing_receiver_hook_decode_calls == 2)
    owned_rx:close()
    test.assert(rx_committed_close:is_closed() and
                coalescing_receiver_hook_decode_calls == 2,
      "closing Receiver after post-commit wake error did not dispose slot")
  end)
end

local function coalescing_receiver_thread_worker(
    host_handle_val: async.TransferValue,
    ready_tx: coalescing_receiver_thread.Sender<|integer|>,
    ctrl_rx: coalescing_receiver_thread.Receiver<|integer|>): integer
  local host_handle = coalescing_receiver_unwrap_handle(host_handle_val)
  coalescing_receiver_reset_hook_counts()
  defer ready_tx:close()

  -- 1. Send a displaced endpoint packet followed by a live duplex endpoint
  -- packet from this child OS thread to the host's Receiver before
  -- signaling ready_tx so the host never races between the two sends.
  local disp_rx = send_ephemeral_sender(host_handle, 801)
  defer disp_rx:close()
  test.assert(not disp_rx:is_closed())

  local reply_tx, reply_rx = coalescing_receiver_thread.channel<|string|>(1)
  defer reply_rx:close()
  local inbox_tx, inbox_rx = coalescing_receiver_thread.channel<|integer|>(1)
  defer inbox_tx:close()
  async.send(
    host_handle,
    CoalescingReceiverDuplexEnvelope(
      802, CoalescingReceiverHookProbe.new(802), reply_tx, inbox_rx))
  test.assert(disp_rx:is_closed() and coalescing_receiver_hook_decode_calls == 0,
    "cross-thread replacement in host Receiver did not dispose displaced endpoint")

  test.assert(inbox_tx:try_send(8020))
  ready_tx:send(1)
  test.assert(reply_rx:receive() == "host-ack-8020")
  -- 2. Create a child-thread Receiver, send its handle to the host,
  -- receive a coalesced endpoint packet from the host, and retire host sends
  -- via ctrl_rx before closing worker_receiver.
  local worker_receiver = async.receiver()
  defer worker_receiver:close()
  async.send(
    host_handle,
    async.TransferValue.is_pointer(worker_receiver:handle()))

  -- Wait until the host has sent both its displaced and replacement packets.
  test.assert(ctrl_rx:receive() == 1)
  local from_host: CoalescingReceiverSenderEnvelope = worker_receiver:wait()
  test.assert(from_host.ordinal == 804 and from_host.probe:value() == 804)
  test.assert(coalescing_receiver_hook_decode_calls == 1,
    "child thread decoded more than the surviving packet")
  from_host.tx:send(8040)
  from_host.tx:close()

  -- Wait for host confirmation that all sends to worker_receiver have finished
  -- before defer worker_receiver:close() runs.
  test.assert(ctrl_rx:receive() == 2)
  return 8040
end

function test_receiver_cross_thread_endpoint_handoff_and_coalescing(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    local host_receiver = async.receiver()
    runtime_test.cleanup(function () host_receiver:close() end)
    local ready_tx, ready_rx = coalescing_receiver_thread.channel<|integer|>(1)
    local ctrl_tx, ctrl_rx = coalescing_receiver_thread.channel<|integer|>(2)
    runtime_test.cleanup(function ()
      ready_tx:close()
      ready_rx:close()
      ctrl_tx:close()
      ctrl_rx:close()
    end)

    local worker = coalescing_receiver_thread.spawn_three(
      coalescing_receiver_thread_worker,
      async.TransferValue.is_pointer(host_receiver:handle()),
      ready_tx,
      ctrl_rx)
    runtime_test.cleanup(function ()
      worker:cancel()
      worker:join()
    end)

    test.assert(ready_rx:receive() == 1)
    local duplex: CoalescingReceiverDuplexEnvelope = host_receiver:wait()
    test.assert(duplex.ordinal == 802 and duplex.probe:value() == 802)
    test.assert(coalescing_receiver_hook_decode_calls == 1,
      "host decoded displaced cross-thread packet")
    test.assert(duplex.inbox:receive() == 8020)
    duplex.reply:send("host-ack-8020")
    duplex.reply:close()
    duplex.inbox:close()

    -- The sent payload was an explicit pointer policy; eager wait()
    -- returns the borrowed lightuserdata address, not the policy wrapper.
    local worker_handle = host_receiver:wait() as foreign *void

    local host_disp_rx = send_ephemeral_sender(worker_handle, 803)
    defer host_disp_rx:close()
    test.assert(not host_disp_rx:is_closed())
    local host_live_rx = send_ephemeral_sender(worker_handle, 804)
    defer host_live_rx:close()
    test.assert(host_disp_rx:is_closed(),
      "displaced packet sent to worker thread did not auto-close its peer Receiver")

    ctrl_tx:send(1)
    test.assert(host_live_rx:receive() == 8040)
    ctrl_tx:send(2)

    case worker:join()
    when succeeded(code) then test.assert(code == 8040)
    else raise "cross-thread Receiver worker did not succeed"
    end
    host_receiver:close()
  end)
end

local coalescing_receiver_remote_inbox: async.Receiver? = nil
local coalescing_receiver_remote_worker: async.Task<|integer, value|>? = nil

function coalescing_receiver_remote_initialized(): boolean
  return coalescing_receiver_remote_inbox ~= nil
end

function coalescing_receiver_remote_bootstrap(host_raw: value): foreign *void
  local host_handle = host_raw as foreign *void
  coalescing_receiver_reset_hook_counts()
  local owner = async.receiver()
  coalescing_receiver_remote_inbox = owner
  coalescing_receiver_remote_worker = async.run<|integer, value|>(function (): integer
    -- 1. Receive the surviving duplex packet sent by the host (after the host
    -- replaced an earlier packet in owner's slot).
    local from_host: CoalescingReceiverDuplexEnvelope = owner:wait()
    test.assert(from_host.ordinal == 902 and from_host.probe:value() == 902)
    test.assert(coalescing_receiver_hook_decode_calls == 1,
      "independent state decoded displaced packet")
    local number = from_host.inbox:receive()
    from_host.inbox:close()

    -- 2. Send a displaced packet followed by a surviving endpoint packet back
    -- to the host's Receiver before acknowledging on from_host.reply so
    -- the host waits until replacement has completed.
    local remote_disp_rx = send_ephemeral_sender(host_handle, 903)
    defer remote_disp_rx:close()
    test.assert(not remote_disp_rx:is_closed())
    local remote_live_rx = send_ephemeral_sender(host_handle, 904)
    defer remote_live_rx:close()
    test.assert(remote_disp_rx:is_closed(),
      "independent-state replacement in host Receiver did not close peer")

    from_host.reply:send("remote-ack-" .. number)
    from_host.reply:close()
    -- 3. Wait for the stop packet carrying the quiescence Receiver, wait until
    -- the host signals that its final send has returned, and only then
    -- close owner.
    local stop_env: CoalescingReceiverReceiverEnvelope = owner:wait()
    test.assert(stop_env.ordinal == 905 and coalescing_receiver_hook_decode_calls == 2)
    local stop_code = stop_env.rx:receive()
    stop_env.rx:close()
    owner:close()
    coalescing_receiver_gc.collect()
    return remote_live_rx:receive() + stop_code
  end)
  return owner:handle()
end

function coalescing_receiver_remote_drive(): integer
  async.loop()
  local worker = coalescing_receiver_remote_worker as async.Task<|integer, value|>
  case worker:status()
  when succeeded(total) then return total
  when failed(failure) then failure:raise()
  else raise "independent-state Receiver worker did not succeed"
  end
  return 0
end

function test_receiver_independent_lua_state_endpoint_handoff(
    _context: test.Context)
  runtime_test.run(function ()
    coalescing_receiver_reset_hook_counts()
    test.assert(not coalescing_receiver_remote_initialized(),
      "host module unexpectedly owns an independent-state Receiver")

    local host_receiver = async.receiver()
    runtime_test.cleanup(function () host_receiver:close() end)
    local state = coalescing_receiver_lua.new()
    runtime_test.cleanup(function () state:close() end)

    local remote_handle = coalescing_receiver_unwrap_handle(state:run_async([[
      package.path, package.cpath = '', ''
      return require('async.tests').coalescing_receiver_remote_bootstrap(...)
    ]], "=coalescing-receiver-bootstrap",
      async.TransferValue.is_pointer(host_receiver:handle())))

    -- Before driving the remote state's loop, send a displaced packet and then
    -- a live duplex packet to remote_handle.
    local host_disp_rx = send_ephemeral_sender(remote_handle, 901)
    defer host_disp_rx:close()
    test.assert(not host_disp_rx:is_closed())

    local reply_tx, reply_rx = coalescing_receiver_thread.channel<|string|>(1)
    defer reply_rx:close()
    local inbox_tx, inbox_rx = coalescing_receiver_thread.channel<|integer|>(1)
    defer inbox_tx:close()
    async.send(
      remote_handle,
      CoalescingReceiverDuplexEnvelope(
        902, CoalescingReceiverHookProbe.new(902), reply_tx, inbox_rx))
    test.assert(host_disp_rx:is_closed() and coalescing_receiver_hook_decode_calls == 0,
      "replacing packet in independent-state Receiver did not close peer")

    local driving = async.run<|integer, value|>(function (): integer
      local result = state:run_async([[
        return require('async.tests').coalescing_receiver_remote_drive()
      ]], "=coalescing-receiver-drive")
      case result
      when is_integer(number) then return number
      else raise "expected integer result from coalescing_receiver_remote_drive"
      end
    end)
    task_support.cleanup_task(driving, "independent-state Receiver driver")

    inbox_tx:send(99)
    test.assert(reply_rx:receive() == "remote-ack-99")

    local from_remote: CoalescingReceiverSenderEnvelope = host_receiver:wait()
    test.assert(from_remote.ordinal == 904 and from_remote.probe:value() == 904)
    test.assert(coalescing_receiver_hook_decode_calls == 1,
      "host decoded displaced packet from independent state")

    local done_tx, done_rx = coalescing_receiver_thread.channel<|integer|>(1)
    defer done_tx:close()
    async.send(
      remote_handle,
      CoalescingReceiverReceiverEnvelope(
        905, CoalescingReceiverHookProbe.new(905), done_rx))
    from_remote.tx:send(9000)
    from_remote.tx:close()
    -- Signal only after async.send(remote_handle, ...) has returned.
    done_tx:send(42)

    case async.join(driving)
    when succeeded(total) then test.assert(total == 9042)
    else raise "independent-state Receiver driver failed"
    end
    test.assert(not coalescing_receiver_remote_initialized(),
      "remote Receiver leaked into host module instance")

    -- The remote state's module retains its closed Receiver until
    -- state:close(); late sends must fail with "receiver is closed" and
    -- discard the temporary packet without closing the caller's live Sender.
    local late_tx, late_rx = coalescing_receiver_thread.channel<|integer|>(1)
    defer late_tx:close()
    defer late_rx:close()
    local late_env = CoalescingReceiverSenderEnvelope(
      906, CoalescingReceiverHookProbe.new(906), late_tx)
    coalescing_receiver_expect_error(function ()
      async.send(remote_handle, late_env)
    end, "closed")
    test.assert(not late_rx:is_closed(),
      "late send to closed remote Receiver closed the caller's live Sender")

    state:close()
    host_receiver:close()
  end)
end
