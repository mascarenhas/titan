local receiver_string = import "string"
local receiver_gc = import "gc"
foreign import "lauxlib.h"

local foreign function receiver_test_callback(state: *lua_State): int
  return ffi.lua_gettop(state)
end

local function receiver_integer(item: value): integer
  test.assert(item is integer, "receiver changed an integer's variant")
  return item
end

local function receiver_error(action: function (): (), expected: string?)
  local caught = false
  do
    action()
  catch
    caught = error is string
    if expected then test.assert(error == expected, "unexpected Receiver diagnostic") end
  end
  test.assert(caught, "invalid Receiver operation succeeded")
end

local function receiver_send_transient_string(handle: foreign *void)
  async.send(handle, async.TransferValue.is_string(
    receiver_string.rep("receiver\0bytes", 4096)))
end

function test_receiver_preloop_burst_coalesces_to_latest_message(_context: test.Context)
  const receiver = async.receiver()
  defer receiver:close()
  const handle = receiver:handle()
  -- No loop callback can run between these sends.
  for ordinal = 1, 257 do
    async.send(handle, async.TransferValue.is_integer(ordinal))
  end
  support.collect_garbage()
  runtime_test.run(function ()
    test.assert(receiver_integer(receiver:wait()) == 257,
                "pre-loop Receiver burst did not retain the latest message")
    async.send(handle, async.TransferValue.is_integer(258))
    test.assert(receiver_integer(receiver:wait()) == 258,
                "Receiver retained a superseded message after the burst")
  end)
end

function test_receiver_callbacks_replace_unread_value(_context: test.Context)
  const receiver = async.receiver()
  defer receiver:close()
  const handle = receiver:handle()
  -- Drive each callback before starting a reader. The second callback must
  -- replace a value already delivered by the first, beyond native coalescing.
  async.send(handle, async.TransferValue.is_integer(41))
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  support.collect_garbage()
  async.send(handle, async.TransferValue.is_integer(42))
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  support.collect_garbage()
  runtime_test.run(function ()
    test.assert(receiver_integer(receiver:wait()) == 42,
                "Receiver queued an unread value from an earlier callback")
    async.send(handle, async.TransferValue.is_integer(43))
    test.assert(receiver_integer(receiver:wait()) == 43,
                "Receiver did not clear its consumed value")
  end)
end

function test_receiver_preserves_all_transfer_variants_and_copied_bytes(
    _context: test.Context)
  runtime_test.run(function ()
    const state = ffi.luaL_newstate()
    test.assert(state ~= nil, "could not allocate borrowed state fixture")
    defer ffi.lua_close(state)
    const receiver = async.receiver()
    defer receiver:close()
    const handle = receiver:handle()
    const memory: owned int[] = foreign int.new_array(1)
    memory[0] = 42
    const expected_callback: foreign function (*lua_State): int = receiver_test_callback
    async.send(handle, async.TransferValue.is_nil())
    test.assert(receiver:wait() == nil, "Receiver changed nil's variant")
    async.send(handle, nil)
    test.assert(receiver:wait() == nil, "Receiver changed direct nil")
    async.send(handle, async.TransferValue.is_boolean(false))
    const false_val = receiver:wait()
    test.assert(false_val is boolean and false_val == false,
                "Receiver changed false's variant")
    async.send(handle, false)
    const direct_false = receiver:wait()
    test.assert(direct_false is boolean and direct_false == false,
                "Receiver changed direct false")
    async.send(handle, async.TransferValue.is_boolean(true))
    const true_val = receiver:wait()
    test.assert(true_val is boolean and true_val == true,
                "Receiver changed true's variant")
    async.send(handle, async.TransferValue.is_integer(-73))
    test.assert(receiver_integer(receiver:wait()) == -73)
    async.send(handle, async.TransferValue.is_float(2.5))
    const float_val = receiver:wait()
    test.assert(float_val is float and (float_val as float) == 2.5,
                "Receiver changed a float's variant")
    receiver_send_transient_string(handle)
    support.collect_garbage()
    support.collect_garbage()
    const string_val = receiver:wait()
    test.assert(string_val is string, "Receiver changed a string's variant")
    const bytes: string = string_val
    test.assert(bytes == receiver_string.rep("receiver\0bytes", 4096),
                "Receiver lost copied string bytes after sender GC")
    async.send(handle, async.TransferValue.is_lua_state(state))
    const state_pointer = receiver:wait() as foreign *lua_State
    test.assert(state_pointer == state,
                "Receiver changed a borrowed state's pointer")
    async.send(handle, async.TransferValue.is_function(receiver_test_callback))
    const callback = receiver:wait()
    const top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    test.assert(ffi.lua_checkstack(L, 1) ~= 0,
                "could not reserve callback inspection slot")
    ffi.lua_pushtvalue(L, callback)
    const actual_callback = ffi.lua_tocfunction(L, -1)
    ffi.lua_settop(L, top)
    test.assert(actual_callback == expected_callback,
                "Receiver changed a native Lua C function")
    async.send(handle, async.TransferValue.is_pointer(memory as foreign *void))
    const pointer = receiver:wait() as foreign *void
    test.assert(pointer == memory as foreign *void,
                "Receiver changed a raw pointer's address")
    test.assert(memory[0] == 42, "Receiver wrote through a borrowed pointer")
  end)
end

function test_receiver_reserves_one_waiter_without_barging(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    const waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "Receiver reserved waiter cleanup")
    support.wait_until_waiting(waiting)
    receiver_error(function () receiver:wait() end)
    async.send(receiver:handle(), async.TransferValue.is_integer(41))
    receiver_error(function () receiver:wait() end)
    case async.join(waiting)
    when succeeded(item) then test.assert(receiver_integer(item) == 41)
    else raise "second reader disturbed the reserved Receiver waiter" end
    async.send(receiver:handle(), async.TransferValue.is_integer(42))
    test.assert(receiver_integer(receiver:wait()) == 42,
                "completed Receiver waiter retained its reservation")
  end)
end

record ReceiverNominalRecord
  label: string
  payload: string
  ordinal: integer
end

union ReceiverNominalUnion
  bytes(string)
  number(integer)
end

local function receiver_send_record_bytes(handle: foreign *void)
  async.send(handle, ReceiverNominalRecord(
    receiver_string.rep("record.label", 128),
    receiver_string.rep("record\0bytes", 4096),
    91))
end

local function receiver_send_union_bytes(handle: foreign *void)
  async.send(handle, ReceiverNominalUnion.bytes(
    receiver_string.rep("union\0bytes", 4096)))
end

function test_receiver_copies_nominal_names_and_wire_bytes(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    receiver_send_record_bytes(receiver:handle())
    support.collect_garbage()
    support.collect_garbage()
    const record_val: ReceiverNominalRecord = receiver:wait()
    test.assert(record_val.label == receiver_string.rep("record.label", 128))
    test.assert(record_val.payload == receiver_string.rep("record\0bytes", 4096))
    test.assert(record_val.ordinal == 91)
    receiver_send_union_bytes(receiver:handle())
    support.collect_garbage()
    support.collect_garbage()
    const union_val: ReceiverNominalUnion = receiver:wait()
    case union_val
    when bytes(data) then
      test.assert(data == receiver_string.rep("union\0bytes", 4096))
    else raise "Receiver changed the union transfer payload" end
    async.send(receiver:handle(),
      async.TransferValue.is_record("async.tests", "MissingNominalRecord", "bad"))
    receiver_error(function () receiver:wait() end)
    async.send(receiver:handle(), 92)
    test.assert(receiver_integer(receiver:wait()) == 92,
                "failed nominal decode did not consume the Receiver slot")
  end)
end

function test_receiver_cancellation_preserves_pending_message(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    const waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "cancelled Receiver waiter cleanup")
    support.wait_until_waiting(waiting)
    -- Neither send nor cancel yields: cancellation wins before delivery.
    async.send(receiver:handle(), async.TransferValue.is_integer(73))
    waiting:cancel(async.CancellationReason.simple("Receiver wait cancelled"))
    test.assert(support.cancelled_with(async.join(waiting), "Receiver wait cancelled"))
    support.collect_garbage()
    test.assert(receiver_integer(receiver:wait()) == 73,
                "cancelled Receiver waiter consumed its pending message")
    async.send(receiver:handle(), async.TransferValue.is_integer(74))
    test.assert(receiver_integer(receiver:wait()) == 74,
                "cancelled wait closed or stalled the Receiver")
  end)
end

function test_receiver_cancelled_reader_exit_keeps_successor_reservation(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    const first = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(first, "cancelled Receiver reader cleanup")
    support.wait_until_waiting(first)
    -- Queue the successor before cancelling: cancellation withdraws the first
    -- reservation at once, so the successor reserves and suspends before the
    -- cancelled reader's queued wake unwinds through its own wait.
    const successor = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(successor, "successor Receiver reader cleanup")
    first:cancel(async.CancellationReason.simple("first Receiver reader cancelled"))
    support.wait_until_waiting(successor)
    test.assert(support.cancelled_with(async.join(first), "first Receiver reader cancelled"))
    async.send(receiver:handle(), async.TransferValue.is_integer(81))
    -- The successor still owns the reader slot after the cancelled reader left.
    receiver_error(function () receiver:wait() end, "receiver already has a waiting reader")
    case async.join(successor)
    when succeeded(item) then test.assert(receiver_integer(item) == 81)
    else raise "cancelled Receiver reader withdrew its successor's reservation" end
    -- A reader woken by the callback leaves no stale notification for the next
    -- reader that must suspend on the same Receiver.
    const third = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(third, "third Receiver reader cleanup")
    support.wait_until_waiting(third)
    async.send(receiver:handle(), async.TransferValue.is_integer(82))
    case async.join(third)
    when succeeded(item) then test.assert(receiver_integer(item) == 82)
    else raise "reused Receiver reader state missed a later wake" end
    async.send(receiver:handle(), async.TransferValue.is_integer(83))
    test.assert(receiver_integer(receiver:wait()) == 83,
                "Receiver reservation remained after successive readers")
  end)
end

function test_receiver_failed_first_wait_leaves_reusable_reader_state(_context: test.Context)
  const receiver = async.receiver()
  defer receiver:close()
  -- A wait outside a Task is rejected and leaves the Receiver usable by Tasks.
  receiver_error(function () receiver:wait() end,
                 "asynchronous operation must be called from an async Task")
  runtime_test.run(function ()
    -- The first wait in a Task creates and reserves the reader state, then
    -- fails at its checkpoint; that failure must release the reservation.
    const pre_cancelled = async.run<|value, value|>(function (): value
      async.running():cancel(async.CancellationReason.simple("first Receiver wait cancelled"))
      return receiver:wait()
    end)
    task_support.cleanup_task(pre_cancelled, "first Receiver wait cleanup")
    test.assert(support.cancelled_with(async.join(pre_cancelled), "first Receiver wait cancelled"))
    async.send(receiver:handle(), async.TransferValue.is_integer(61))
    test.assert(receiver_integer(receiver:wait()) == 61,
                "failed first Receiver wait kept its reservation")
  end)
end

-- Run one wait under the limited Lua allocator from transfer_payload_test:
-- the countdown-th fresh allocation fails, as does its emergency-GC retry.
-- Returns whether the wait raised, the injected failures and the unused count.
local function receiver_wait_with_failing_allocation(receiver: async.Receiver,
    countdown: integer): (boolean, integer, integer)
  const ctrl: owned size_t[] = foreign size_t.new_array(3)
  ctrl[0] = 1 as foreign size_t
  ctrl[1] = countdown as foreign size_t
  ctrl[2] = 0 as foreign size_t
  local failed = false
  local previous_data: foreign *void = nil
  const previous = ffi.lua_getallocf(L, previous_data)
  ffi.lua_setallocf(L, transfer_limited_lua_alloc, ctrl as foreign *void)
  do
    receiver:wait()
  catch
    failed = true
  end
  ffi.lua_setallocf(L, previous, previous_data)
  return failed, ctrl[2] as integer, ctrl[1] as integer
end

function test_receiver_first_wait_allocation_failure_leaves_no_partial_state(_context: test.Context)
  runtime_test.run(function ()
    -- Keep the collector from running finalizers between counted allocations.
    support.collect_garbage()
    support.collect_garbage()
    ffi.lua_gc(L, ffi.LUA_GCSTOP)
    defer ffi.lua_gc(L, ffi.LUA_GCRESTART)
    -- Warm this call depth on one Receiver, then count every fresh Lua
    -- allocation of a first wait on another (a packet is ready, so the
    -- wait never suspends and the scalar decode allocates nothing).
    const warm = async.receiver()
    defer warm:close()
    async.send(warm:handle(), async.TransferValue.is_integer(1))
    local warm_failed, warm_injected, _ =
      receiver_wait_with_failing_allocation(warm, 1000000)
    test.assert(not warm_failed and warm_injected == 0, "warm Receiver wait failed")
    const counted = async.receiver()
    defer counted:close()
    async.send(counted:handle(), async.TransferValue.is_integer(2))
    local count_failed, count_injected, unused =
      receiver_wait_with_failing_allocation(counted, 1000000)
    const first_wait_allocations = 1000000 - unused
    -- At least the reader record, its ResumeToken and its cancellation action.
    test.assert(not count_failed and count_injected == 0 and first_wait_allocations >= 3,
                "first Receiver wait did not allocate its reader state")
    for nth = 1, first_wait_allocations do
      const receiver = async.receiver()
      defer receiver:close()
      const handle = receiver:handle()
      async.send(handle, async.TransferValue.is_integer(100 + nth))
      local failed, injected, _ = receiver_wait_with_failing_allocation(receiver, nth)
      test.assert(failed and injected >= 1,
                  "first Receiver wait survived failing allocation " .. nth)
      -- No partial reader state remains: a later wait succeeds, a suspended
      -- reader's cancellation withdraws its reservation at once, and a
      -- further wait still works.
      async.send(handle, async.TransferValue.is_integer(200 + nth))
      test.assert(receiver_integer(receiver:wait()) == 200 + nth,
                  "Receiver wait after allocation failure " .. nth .. " failed")
      const cancelled = async.run<|value, value|>(receiver:wait)
      task_support.cleanup_task(cancelled, "Receiver reader after allocation failure cleanup")
      support.wait_until_waiting(cancelled)
      async.send(handle, async.TransferValue.is_integer(300 + nth))
      cancelled:cancel(async.CancellationReason.simple("Receiver reader cancelled after OOM"))
      test.assert(receiver_integer(receiver:wait()) == 300 + nth,
                  "cancellation after allocation failure " .. nth .. " kept its reservation")
      test.assert(support.cancelled_with(async.join(cancelled), "Receiver reader cancelled after OOM"))
      async.send(handle, async.TransferValue.is_integer(400 + nth))
      test.assert(receiver_integer(receiver:wait()) == 400 + nth,
                  "further Receiver wait after allocation failure " .. nth .. " failed")
    end
  end)
end

function test_receiver_close_wakes_successor_after_cancelled_reader(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    const first = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(first, "cancelled Receiver reader cleanup")
    support.wait_until_waiting(first)
    const successor = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(successor, "closed successor Receiver reader cleanup")
    first:cancel(async.CancellationReason.simple("first Receiver reader cancelled"))
    support.wait_until_waiting(successor)
    test.assert(support.cancelled_with(async.join(first), "first Receiver reader cancelled"))
    -- Probe with a packet present so a lost reservation fails here instead of
    -- leaving the successor parked.
    async.send(receiver:handle(), async.TransferValue.is_integer(71))
    receiver_error(function () receiver:wait() end, "receiver already has a waiting reader")
    -- Close disposes the unread packet and wakes the reservation holder: the
    -- successor, not the cancelled reader that has already left.
    receiver:close()
    case async.join(successor)
    when failed(failure) then test.assert(failure.error == "receiver is closed")
    else raise "close did not wake the successor Receiver reader" end
    receiver_error(function () receiver:wait() end, "receiver is closed")
  end)
end

function test_receiver_cancel_after_queued_wake_keeps_packet_and_successor(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    const first = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(first, "queued-wake Receiver reader cleanup")
    support.wait_until_waiting(first)
    async.send(receiver:handle(), async.TransferValue.is_integer(91))
    -- After the poll phase the callback has queued the reader's wake, but the
    -- ready timer has not delivered it yet.
    coalescing_receiver_after_poll()
    test.assert(first:status():as_string() == "waiting",
                "queued Receiver wake was delivered before cancellation")
    first:cancel(async.CancellationReason.simple("woken Receiver reader cancelled"))
    -- Cancellation withdrew the reservation despite the queued wake and left
    -- the packet unread, before the cancelled reader has unwound.
    test.assert(receiver_integer(receiver:wait()) == 91,
                "cancelled reader with a queued wake kept its reservation or packet")
    const successor = async.running()
    const prober = async.run<|nil, value|>(function (): nil
      while not first:status():has_finished() do async.yield() end
      async.send(receiver:handle(), async.TransferValue.is_integer(92))
      do
        receiver_error(function () receiver:wait() end,
                       "receiver already has a waiting reader")
      catch
        -- Fail the parked successor instead of leaving it suspended forever.
        successor:cancel(async.CancellationReason.simple("Receiver reservation lost"))
        raise
      end
      return nil
    end)
    task_support.cleanup_task(prober, "queued-wake Receiver prober cleanup")
    -- Suspend as the successor while the cancelled reader's wake is still
    -- queued; its later unwinding must keep this reservation and its wakes.
    test.assert(receiver_integer(receiver:wait()) == 92,
                "cancelled reader's unwinding released its successor's reservation")
    test.assert(support.cancelled_with(async.join(first), "woken Receiver reader cancelled"))
    test.assert(async.join(prober):has_succeeded(), "Receiver reservation probe failed")
  end)
end

function test_receiver_close_wakes_waiter_and_rejects_late_sends(_context: test.Context)
  runtime_test.run(function ()
    receiver_error(function ()
      async.send(nil, async.TransferValue.is_nil())
    end, "receiver handle must not be NULL")
    const receiver = async.receiver()
    defer receiver:close()
    const handle = receiver:handle()
    const waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "closed Receiver waiter cleanup")
    support.wait_until_waiting(waiting)
    receiver:close()
    receiver:close()
    case async.join(waiting)
    when failed(failure) then test.assert(failure.error == "receiver is closed")
    else raise "closing a Receiver did not fail its waiting Task" end
    support.collect_garbage()
    receiver_error(function ()
      async.send(handle, async.TransferValue.is_integer(1))
    end, "receiver is closed")
    receiver_error(function () receiver:wait() end, "receiver is closed")

    const queued = async.receiver()
    defer queued:close()
    receiver_send_transient_string(queued:handle())
    queued:close()
    support.collect_garbage()
    receiver_error(function () queued:wait() end, "receiver is closed")
  end)
end

function test_receiver_runtime_shutdown_retires_retained_endpoint(_context: test.Context)
  -- Construction and send are allowed before a Task starts driving this Runtime.
  const receiver = async.receiver()
  defer receiver:close()
  const handle = receiver:handle()
  async.send(handle, async.TransferValue.is_integer(29))
  const waiting = async.run<|value, value|>(receiver:wait)
  async.loop()
  case waiting:status()
  when succeeded(item) then test.assert(receiver_integer(item) == 29)
  else raise "pre-loop Receiver message did not reach its Task" end
  support.collect_garbage()
  support.collect_garbage()
  receiver_error(function ()
    async.send(handle, async.TransferValue.is_integer(30))
  end, "receiver is closed")
  runtime_test.run(function ()
    receiver_error(function () receiver:wait() end, "receiver is closed")
  end)
  receiver:close()
end

local function receiver_send_transient_closure(handle: foreign *void)
  local count = 13
  const text = receiver_string.rep("queued\0closure", 1024)
  const callback = function (): integer
    count = count + 1
    return count + #text
  end
  const packet = async.TransferValue.from_value(callback)
  test.assert(callback() == 14 + #text)
  async.send(handle, packet)
end

function test_receiver_copies_closure_snapshots_and_retires_packet_bytes(_context: test.Context)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    const handle = receiver:handle()
    receiver_send_transient_closure(handle)
    support.collect_garbage()
    support.collect_garbage()
    const callback: function (): integer = receiver:wait()
    const size = #receiver_string.rep("queued\0closure", 1024)
    test.assert(callback() == 14 + size and callback() == 15 + size,
      "Receiver did not snapshot the sender's closure captures")
    const invalid = async.TransferValue.is_closure("async.tests", nil, "invalid protobuf")
    async.send(handle, invalid)
    receiver_error(function () receiver:wait() end,
      "closure transfer entry belongs to a different provider or is invalid")
    async.send(handle, 99)
    test.assert(receiver_integer(receiver:wait()) == 99,
      "failed closure decode did not consume the Receiver slot")
    receiver_send_transient_closure(handle)
    receiver:close()
    receiver_error(function () receiver_send_transient_closure(handle) end, "receiver is closed")
    support.collect_garbage()
  end)
end

-- Decode-time close fixture: the hook closes `receiver_closing_target` directly,
-- or through a finalizer that a forced full collection runs inside decode.
local receiver_closing_target: async.Receiver? = nil
local receiver_closing_by_finalizer = false
local receiver_closing_finalized = false
local receiver_closing_failure: value = nil

record ReceiverClosingProbe
  label: string
end

function ReceiverClosingProbe:to_transfer_payload(): string
  return self.label
end

record ReceiverCloseOnCollect
  receiver: async.Receiver
end

local function receiver_close_on_collect(item: value)
  const owner: ReceiverCloseOnCollect = item
  receiver_closing_finalized = true
  -- A finalizer error would only become a Lua warning; record it instead.
  do owner.receiver:close()
  catch receiver_closing_failure = error end
end

-- A separate frame, so no stack slot of the decode hook still roots the owner.
local function receiver_drop_close_on_collect(target: async.Receiver)
  receiver_gc.finalizable<|value|>(ReceiverCloseOnCollect(target), receiver_close_on_collect)
end

function ReceiverClosingProbe.from_transfer_payload(payload: string): ReceiverClosingProbe
  const target = receiver_closing_target
  receiver_closing_target = nil
  if receiver_closing_by_finalizer then
    receiver_drop_close_on_collect(target)
    receiver_gc.collect()
  else
    target:close()
  end
  return { label = payload }
end

local function receiver_close_during_first_pass_decode(by_finalizer: boolean)
  runtime_test.run(function ()
    const receiver = async.receiver()
    defer receiver:close()
    -- The packet is already in the slot, so wait decodes on its first pass
    -- while its reader Task is running, never suspended on the reader token.
    async.send(receiver:handle(), ReceiverClosingProbe("closed-during-decode"))
    receiver_closing_target = receiver
    receiver_closing_by_finalizer = by_finalizer
    receiver_closing_finalized = false
    receiver_closing_failure = nil
    -- Before the fix this raised "Task resume token mismatch" from the decode.
    const item = receiver:wait()
    test.assert(receiver_closing_target == nil, "the closing decode hook did not run")
    test.assert(receiver_closing_finalized == by_finalizer,
      "the closing finalizer did not run inside decode")
    test.assert(receiver_closing_failure == nil,
      "closing the Receiver from its reader's decode raised")
    test.assert(item is ReceiverClosingProbe, "wait lost the message decoded before close")
    const probe: ReceiverClosingProbe = item
    test.assert(probe.label == "closed-during-decode", "wait changed the decoded message")
    receiver_error(function () receiver:wait() end, "receiver is closed")
  end)
end

function test_receiver_decode_may_close_its_receiver(context: test.Context)
  context:run("decode_hook", function (_: test.Context)
    receiver_close_during_first_pass_decode(false)
  end)
  context:run("finalizer", function (_: test.Context)
    receiver_close_during_first_pass_decode(true)
  end)
end

-- A finalizer wake of a Receiver reader at every safepoint of its suspension
-- window (task_support.each_wake_offset): in the reader before it parks, or in
-- the driver before its suspension registers.
local function receiver_wake_window(driver: boolean, wake: function (async.Receiver): (),
    expected: value)
  runtime_test.run(function ()
    task_support.each_wake_offset(driver, nil, function (): task_support.WakeCase
      const receiver = async.receiver()
      runtime_test.cleanup(function () receiver:close() end)
      return task_support.WakeCase(function (): value
        return receiver:wait()
      catch
        return error
      end, function (_: async.Task) wake(receiver) end, nil,
      function (reader: async.Task, offset: integer)
        local finished, result? = reader:status():has_succeeded()
        test.assert(finished and result == expected, "offset " .. offset ..
          ": the Receiver wake left the reader " .. reader:status():as_string())
      end)
    end)
  end)
end

function test_receiver_wake_before_reader_suspends(context: test.Context)
  context:run("close_in_reader", function (_: test.Context)
    receiver_wake_window(false, function (receiver: async.Receiver)
      receiver:close()
    end, "receiver is closed")
  end)
  context:run("close_in_driver", function (_: test.Context)
    receiver_wake_window(true, function (receiver: async.Receiver)
      receiver:close()
    end, "receiver is closed")
  end)
  context:run("send_in_reader", function (_: test.Context)
    receiver_wake_window(false, function (receiver: async.Receiver)
      async.send(receiver:handle(), async.TransferValue.is_integer(5))
    end, 5)
  end)
end
