local receiver_string = import "string"
foreign import "lauxlib.h"

local foreign function receiver_test_callback(state: *lua_State): int
  return ffi.lua_gettop(state)
end

local function receiver_integer(item: value): integer
  test.assert(item is integer, "receiver changed an integer's variant")
  return item
end

local function receiver_error(action: function (): (), expected: string?)
  local caught = false
  do
    action()
  catch
    caught = error is string
    if expected then test.assert(error == expected, "unexpected Receiver diagnostic") end
  end
  test.assert(caught, "invalid Receiver operation succeeded")
end

local function receiver_send_transient_string(handle: foreign *void)
  async.send(handle, async.TransferValue.is_string(
    receiver_string.rep("receiver\0bytes", 4096)))
end

function test_receiver_preloop_burst_coalesces_to_latest_message(_context: test.Context)
  local receiver = async.receiver()
  defer receiver:close()
  local handle = receiver:handle()
  -- No loop callback can run between these sends.
  for ordinal = 1, 257 do
    async.send(handle, async.TransferValue.is_integer(ordinal))
  end
  support.collect_garbage()
  runtime_test.run(function ()
    test.assert(receiver_integer(receiver:wait()) == 257,
                "pre-loop Receiver burst did not retain the latest message")
    async.send(handle, async.TransferValue.is_integer(258))
    test.assert(receiver_integer(receiver:wait()) == 258,
                "Receiver retained a superseded message after the burst")
  end)
end

function test_receiver_callbacks_replace_unread_value(_context: test.Context)
  local receiver = async.receiver()
  defer receiver:close()
  local handle = receiver:handle()
  -- Drive each callback before starting a reader. The second callback must
  -- replace a value already delivered by the first, beyond native coalescing.
  async.send(handle, async.TransferValue.is_integer(41))
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  support.collect_garbage()
  async.send(handle, async.TransferValue.is_integer(42))
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  support.collect_garbage()
  runtime_test.run(function ()
    test.assert(receiver_integer(receiver:wait()) == 42,
                "Receiver queued an unread value from an earlier callback")
    async.send(handle, async.TransferValue.is_integer(43))
    test.assert(receiver_integer(receiver:wait()) == 43,
                "Receiver did not clear its consumed value")
  end)
end

function test_receiver_preserves_all_transfer_variants_and_copied_bytes(
    _context: test.Context)
  runtime_test.run(function ()
    local state = ffi.luaL_newstate()
    test.assert(state ~= nil, "could not allocate borrowed state fixture")
    defer ffi.lua_close(state)
    local receiver = async.receiver()
    defer receiver:close()
    local handle = receiver:handle()
    local memory: owned int[] = foreign int.new_array(1)
    memory[0] = 42
    local expected_callback: foreign function (*lua_State): int = receiver_test_callback
    async.send(handle, async.TransferValue.is_nil())
    test.assert(receiver:wait() == nil, "Receiver changed nil's variant")
    async.send(handle, nil)
    test.assert(receiver:wait() == nil, "Receiver changed direct nil")
    async.send(handle, async.TransferValue.is_boolean(false))
    local false_val = receiver:wait()
    test.assert(false_val is boolean and false_val == false,
                "Receiver changed false's variant")
    async.send(handle, false)
    local direct_false = receiver:wait()
    test.assert(direct_false is boolean and direct_false == false,
                "Receiver changed direct false")
    async.send(handle, async.TransferValue.is_boolean(true))
    local true_val = receiver:wait()
    test.assert(true_val is boolean and true_val == true,
                "Receiver changed true's variant")
    async.send(handle, async.TransferValue.is_integer(-73))
    test.assert(receiver_integer(receiver:wait()) == -73)
    async.send(handle, async.TransferValue.is_float(2.5))
    local float_val = receiver:wait()
    test.assert(float_val is float and (float_val as float) == 2.5,
                "Receiver changed a float's variant")
    receiver_send_transient_string(handle)
    support.collect_garbage()
    support.collect_garbage()
    local string_val = receiver:wait()
    test.assert(string_val is string, "Receiver changed a string's variant")
    local bytes: string = string_val
    test.assert(bytes == receiver_string.rep("receiver\0bytes", 4096),
                "Receiver lost copied string bytes after sender GC")
    async.send(handle, async.TransferValue.is_lua_state(state))
    local state_pointer = receiver:wait() as foreign *lua_State
    test.assert(state_pointer == state,
                "Receiver changed a borrowed state's pointer")
    async.send(handle, async.TransferValue.is_function(receiver_test_callback))
    local callback = receiver:wait()
    local top = ffi.lua_gettop(L)
    defer ffi.lua_settop(L, top)
    test.assert(ffi.lua_checkstack(L, 1) ~= 0,
                "could not reserve callback inspection slot")
    ffi.lua_pushtvalue(L, callback)
    local actual_callback = ffi.lua_tocfunction(L, -1)
    ffi.lua_settop(L, top)
    test.assert(actual_callback == expected_callback,
                "Receiver changed a native Lua C function")
    async.send(handle, async.TransferValue.is_pointer(memory as foreign *void))
    local pointer = receiver:wait() as foreign *void
    test.assert(pointer == memory as foreign *void,
                "Receiver changed a raw pointer's address")
    test.assert(memory[0] == 42, "Receiver wrote through a borrowed pointer")
  end)
end

function test_receiver_reserves_one_waiter_without_barging(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "Receiver reserved waiter cleanup")
    support.wait_until_waiting(waiting)
    receiver_error(function () receiver:wait() end)
    async.send(receiver:handle(), async.TransferValue.is_integer(41))
    receiver_error(function () receiver:wait() end)
    case async.join(waiting)
    when succeeded(item) then test.assert(receiver_integer(item) == 41)
    else raise "second reader disturbed the reserved Receiver waiter" end
    async.send(receiver:handle(), async.TransferValue.is_integer(42))
    test.assert(receiver_integer(receiver:wait()) == 42,
                "completed Receiver waiter retained its reservation")
  end)
end

record ReceiverNominalRecord
  label: string
  payload: string
  ordinal: integer
end

union ReceiverNominalUnion
  bytes(string)
  number(integer)
end

local function receiver_send_record_bytes(handle: foreign *void)
  async.send(handle, ReceiverNominalRecord(
    receiver_string.rep("record.label", 128),
    receiver_string.rep("record\0bytes", 4096),
    91))
end

local function receiver_send_union_bytes(handle: foreign *void)
  async.send(handle, ReceiverNominalUnion.bytes(
    receiver_string.rep("union\0bytes", 4096)))
end

function test_receiver_copies_nominal_names_and_wire_bytes(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    receiver_send_record_bytes(receiver:handle())
    support.collect_garbage()
    support.collect_garbage()
    local record_val: ReceiverNominalRecord = receiver:wait()
    test.assert(record_val.label == receiver_string.rep("record.label", 128))
    test.assert(record_val.payload == receiver_string.rep("record\0bytes", 4096))
    test.assert(record_val.ordinal == 91)
    receiver_send_union_bytes(receiver:handle())
    support.collect_garbage()
    support.collect_garbage()
    local union_val: ReceiverNominalUnion = receiver:wait()
    case union_val
    when bytes(data) then
      test.assert(data == receiver_string.rep("union\0bytes", 4096))
    else raise "Receiver changed the union transfer payload" end
    async.send(receiver:handle(),
      async.TransferValue.is_record("async.tests", "MissingNominalRecord", "bad"))
    receiver_error(function () receiver:wait() end)
    async.send(receiver:handle(), 92)
    test.assert(receiver_integer(receiver:wait()) == 92,
                "failed nominal decode did not consume the Receiver slot")
  end)
end

function test_receiver_cancellation_preserves_pending_message(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "cancelled Receiver waiter cleanup")
    support.wait_until_waiting(waiting)
    -- Neither send nor cancel yields: cancellation wins before delivery.
    async.send(receiver:handle(), async.TransferValue.is_integer(73))
    waiting:cancel(async.CancellationReason.simple("Receiver wait cancelled"))
    test.assert(support.cancelled_with(async.join(waiting), "Receiver wait cancelled"))
    support.collect_garbage()
    test.assert(receiver_integer(receiver:wait()) == 73,
                "cancelled Receiver waiter consumed its pending message")
    async.send(receiver:handle(), async.TransferValue.is_integer(74))
    test.assert(receiver_integer(receiver:wait()) == 74,
                "cancelled wait closed or stalled the Receiver")
  end)
end

function test_receiver_close_wakes_waiter_and_rejects_late_sends(_context: test.Context)
  runtime_test.run(function ()
    receiver_error(function ()
      async.send(nil, async.TransferValue.is_nil())
    end, "receiver handle must not be NULL")
    local receiver = async.receiver()
    defer receiver:close()
    local handle = receiver:handle()
    local waiting = async.run<|value, value|>(receiver:wait)
    task_support.cleanup_task(waiting, "closed Receiver waiter cleanup")
    support.wait_until_waiting(waiting)
    receiver:close()
    receiver:close()
    case async.join(waiting)
    when failed(failure) then test.assert(failure.error == "receiver is closed")
    else raise "closing a Receiver did not fail its waiting Task" end
    support.collect_garbage()
    receiver_error(function ()
      async.send(handle, async.TransferValue.is_integer(1))
    end, "receiver is closed")
    receiver_error(function () receiver:wait() end, "receiver is closed")

    local queued = async.receiver()
    defer queued:close()
    receiver_send_transient_string(queued:handle())
    queued:close()
    support.collect_garbage()
    receiver_error(function () queued:wait() end, "receiver is closed")
  end)
end

function test_receiver_runtime_shutdown_retires_retained_endpoint(_context: test.Context)
  -- Construction and send are allowed before a Task starts driving this Runtime.
  local receiver = async.receiver()
  defer receiver:close()
  local handle = receiver:handle()
  async.send(handle, async.TransferValue.is_integer(29))
  local waiting = async.run<|value, value|>(receiver:wait)
  async.loop()
  case waiting:status()
  when succeeded(item) then test.assert(receiver_integer(item) == 29)
  else raise "pre-loop Receiver message did not reach its Task" end
  support.collect_garbage()
  support.collect_garbage()
  receiver_error(function ()
    async.send(handle, async.TransferValue.is_integer(30))
  end, "receiver is closed")
  runtime_test.run(function ()
    receiver_error(function () receiver:wait() end, "receiver is closed")
  end)
  receiver:close()
end

local function receiver_send_transient_closure(handle: foreign *void)
  local count = 13
  local text = receiver_string.rep("queued\0closure", 1024)
  local callback = function (): integer
    count = count + 1
    return count + #text
  end
  local packet = async.TransferValue.from_value(callback)
  test.assert(callback() == 14 + #text)
  async.send(handle, packet)
end

function test_receiver_copies_closure_snapshots_and_retires_packet_bytes(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local handle = receiver:handle()
    receiver_send_transient_closure(handle)
    support.collect_garbage()
    support.collect_garbage()
    local callback: function (): integer = receiver:wait()
    local size = #receiver_string.rep("queued\0closure", 1024)
    test.assert(callback() == 14 + size and callback() == 15 + size,
      "Receiver did not snapshot the sender's closure captures")
    local invalid = async.TransferValue.is_closure("async.tests", nil, "invalid protobuf")
    async.send(handle, invalid)
    receiver_error(function () receiver:wait() end,
      "closure transfer entry belongs to a different provider or is invalid")
    async.send(handle, 99)
    test.assert(receiver_integer(receiver:wait()) == 99,
      "failed closure decode did not consume the Receiver slot")
    receiver_send_transient_closure(handle)
    receiver:close()
    receiver_error(function () receiver_send_transient_closure(handle) end, "receiver is closed")
    support.collect_garbage()
  end)
end
