local transfer_reflect = import "reflect"
local transfer_protobuf = import "protobuf"
foreign import "transfer.h"

local transfer_payload_new_calls = 0
local transfer_payload_encode_calls = 0
local transfer_payload_decode_calls = 0

record TransferPayloadRecord
  local secret: integer
end

function TransferPayloadRecord.new(secret: integer): TransferPayloadRecord
  transfer_payload_new_calls = transfer_payload_new_calls + 1
  return { secret = secret }
end

local function transfer_record_fields(): const {transfer_reflect.Type}
  return {transfer_reflect.Type.is_nil(), transfer_reflect.Type.is_integer(),
    transfer_reflect.Type.is_string(), transfer_reflect.Type.is_boolean()}
end

function TransferPayloadRecord:to_transfer_payload(): string
  transfer_payload_encode_calls = transfer_payload_encode_calls + 1
  support.collect_garbage()
  return transfer_protobuf.serialize_fields(transfer_record_fields(), nil,
    self.secret, "payload\0bytes", false)
end

function TransferPayloadRecord.from_transfer_payload(payload: string): TransferPayloadRecord
  transfer_payload_decode_calls = transfer_payload_decode_calls + 1
  local empty: value, number: integer, bytes: string, flag: boolean =
    transfer_protobuf.deserialize_fields(payload, transfer_record_fields())
  test.assert(empty == nil and bytes == "payload\0bytes" and not flag)
  support.collect_garbage()
  return { secret = number }
end

record TransferPayloadEmpty
  local marker: integer
end

function TransferPayloadEmpty:to_transfer_payload(): string
  return ""
end

function TransferPayloadEmpty.from_transfer_payload(payload: string): TransferPayloadEmpty
  test.assert(payload == "", "empty transfer payload changed bytes")
  return { marker = 42 }
end

record TransferPayloadGeneric<|T|>
  local item: T
end

function TransferPayloadGeneric:to_transfer_payload(): string
  return transfer_protobuf.serialize_fields({transfer_reflect.Type.is_string()}, self.item)
end

function TransferPayloadGeneric.from_transfer_payload(payload: string): TransferPayloadGeneric<|T|>
  local item: value = transfer_protobuf.deserialize_fields(payload,
    {transfer_reflect.Type.is_string()})
  return { item = item }
end

record TransferPayloadNative
  local policies: {async.TransferValue}
end

local function transfer_policy_fields(): const {transfer_reflect.Type}
  return {transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
    transfer_reflect.Type.is_named(transfer_reflect.NamedType("titan.transfer.TransferValue")))}
end

function TransferPayloadNative:to_transfer_payload(): string
  return transfer_protobuf.serialize_fields(transfer_policy_fields(), self.policies)
end

function TransferPayloadNative.from_transfer_payload(payload: string): TransferPayloadNative
  local policies: {async.TransferValue} =
    transfer_protobuf.deserialize_fields(payload, transfer_policy_fields())
  return { policies = policies }
end

record TransferPayloadRetry
  local fail: boolean
end

function TransferPayloadRetry:to_transfer_payload(): string
  if self.fail then raise "transfer-hook-failure" end
  return "retry"
end

function TransferPayloadRetry.from_transfer_payload(payload: string): TransferPayloadRetry
  test.assert(payload == "retry")
  return { fail = false }
end

record TransferPayloadCycle
  local marker: integer
end

function TransferPayloadCycle:to_transfer_payload(): string
  local packet = async.TransferValue.from_value(self)
  return ""
end

function TransferPayloadCycle.from_transfer_payload(payload: string): TransferPayloadCycle
  return { marker = #payload }
end

record TransferPayloadClosureCycle
  local marker: integer
end

function TransferPayloadClosureCycle:to_transfer_payload(): string
  local packet = async.TransferValue.from_value(function (): value return self end)
  return ""
end

function TransferPayloadClosureCycle.from_transfer_payload(payload: string): TransferPayloadClosureCycle
  return { marker = #payload }
end

record TransferPayloadToOnly
  marker: integer
end

function TransferPayloadToOnly:to_transfer_payload(): string
  return ""
end

record TransferPayloadFromOnly
  marker: integer
end

function TransferPayloadFromOnly.from_transfer_payload(payload: string): TransferPayloadFromOnly
  return { marker = #payload }
end

record TransferPayloadWrongKinds
  marker: integer
end

function TransferPayloadWrongKinds.to_transfer_payload(): string
  return ""
end

function TransferPayloadWrongKinds:from_transfer_payload(payload: string): TransferPayloadWrongKinds
  return self
end

record TransferPayloadFixedOutput
  marker: integer
end

function TransferPayloadFixedOutput:to_transfer_payload(): async.TransferValue
  return async.TransferValue.is_integer(self.marker)
end

function TransferPayloadFixedOutput.from_transfer_payload(payload: string): TransferPayloadFixedOutput
  return { marker = #payload }
end

record TransferPayloadWrongTail
  marker: integer
end

function TransferPayloadWrongTail:to_transfer_payload(): (...: string)
  return ""
end

function TransferPayloadWrongTail.from_transfer_payload(payload: string): TransferPayloadWrongTail
  return { marker = #payload }
end

record TransferPayloadFixedInput
  marker: integer
end

function TransferPayloadFixedInput:to_transfer_payload(): string
  return ""
end

function TransferPayloadFixedInput.from_transfer_payload(item: integer): TransferPayloadFixedInput
  return { marker = item }
end

record TransferPayloadWrongReturn
  marker: integer
end

function TransferPayloadWrongReturn:to_transfer_payload(): string
  return ""
end

function TransferPayloadWrongReturn.from_transfer_payload(payload: string): integer
  return #payload
end

record TransferPayloadPlain
  marker: integer
end

record TransferPayloadMutator
  local mutate: function (): ()
end

function TransferPayloadMutator:read(): integer
  return 0
end

function TransferPayloadMutator:to_transfer_payload(): string
  self.mutate()
  return "mutator"
end

function TransferPayloadMutator.from_transfer_payload(payload: string): TransferPayloadMutator
  test.assert(payload == "mutator")
  return { mutate = function () end }
end

union TransferPayloadPlainUnion
  item(integer)
end

local function transfer_payload_error(action: function (): (), fragment: string)
  local caught = false
  do
    action()
  catch
    caught = error is string and support.contains(error, fragment)
  end
  test.assert(caught, "missing transfer error containing: " .. fragment)
end

function test_transfer_payload_private_fields_empty_and_generic(_context: test.Context)
  transfer_payload_new_calls = 0
  transfer_payload_encode_calls = 0
  transfer_payload_decode_calls = 0
  local source: TransferPayloadRecord = { secret = 73 }
  local packet = async.TransferValue.from_value(source)
  test.assert(transfer_payload_encode_calls == 1 and transfer_payload_decode_calls == 0)
  case packet
  when is_record_payload(module, name, payload) then
    test.assert(module == "async.tests" and name == "async.tests.TransferPayloadRecord" and #payload > 0)
  else raise "private record did not select custom payload hooks"
  end
  support.collect_garbage()
  local restored: TransferPayloadRecord = packet:to_value()
  test.assert(restored ~= source and restored.secret == 73)
  test.assert(transfer_payload_decode_calls == 1 and transfer_payload_new_calls == 0,
              "custom transfer invoked a constructor or repeated reconstruction")
  local empty: TransferPayloadEmpty = { marker = -1 }
  local empty_copy: TransferPayloadEmpty = async.TransferValue.from_value(empty):to_value()
  test.assert(empty_copy.marker == 42)
  local generic: TransferPayloadGeneric<|string|> = { item = "erased\0payload" }
  local generic_copy: TransferPayloadGeneric<|string|> =
    async.TransferValue.from_value(generic):to_value()
  test.assert(generic_copy.item == generic.item)
end

function test_transfer_payload_rejects_malformed_hook_pairs(_context: test.Context)
  local cases: {value} = {
    TransferPayloadToOnly(1), TransferPayloadFromOnly(1), TransferPayloadWrongKinds(1),
    TransferPayloadFixedOutput(1), TransferPayloadWrongTail(1),
    TransferPayloadFixedInput(1), TransferPayloadWrongReturn(1)
  }
  for index = 1, #cases do
    transfer_payload_error(function () async.TransferValue.from_value(cases[index]) end,
                           "transfer:")
  end
  transfer_payload_error(function ()
    async.TransferValue.is_record_payload("async.tests", "async.tests.TransferPayloadPlain", ""):to_value()
  end, "record has no payload hooks")
  transfer_payload_error(function ()
    async.TransferValue.is_record_payload("async.tests", "missing.TransferPayloadRecord", ""):to_value()
  end, "unknown record type")
  transfer_payload_error(function ()
    async.TransferValue.is_record_payload("async.tests", "async.tests.TransferPayloadPlainUnion", ""):to_value()
  end, "nominal type is not a record")
end

function test_transfer_payload_reentrant_error_releases_pack_guard(_context: test.Context)
  local source: TransferPayloadRetry = { fail = true }
  transfer_payload_error(function () async.TransferValue.from_value(source) end,
                         "transfer-hook-failure")
  source.fail = false
  local restored: TransferPayloadRetry = async.TransferValue.from_value(source):to_value()
  test.assert(not restored.fail, "failed transfer retained its active-record guard")
  local cyclic: TransferPayloadCycle = { marker = 1 }
  transfer_payload_error(function () async.TransferValue.from_value(cyclic) end,
                         "cyclic record payload")
  transfer_payload_error(function () async.TransferValue.from_value(cyclic) end,
                         "cyclic record payload")
end

function test_transfer_closure_projects_all_immediate_captures_before_hooks(_context: test.Context)
  local number = 41
  local mutator = TransferPayloadMutator(function () number = 99 end)
  local source = function (): integer return mutator:read() + number end
  local packet = async.TransferValue.from_value(source)
  test.assert(source() == 99, "fixture hook did not change the origin cell")
  local restored: function (): integer = packet:to_value()
  test.assert(restored() == 41, "a hook changed a later immediate capture before projection")
end

function test_transfer_closure_validates_entry_before_decoding_payload(context: test.Context)
  local packet = async.TransferValue.from_value(function (): integer return 43 end)
  case packet
  when is_closure(module, entry, _bytes) then
    local pointer_fields: const {transfer_reflect.Type} = {
      transfer_reflect.Type.is_foreign_pointer(transfer_reflect.Type.is_foreign_void(), {}),
    }
    local address_one = (transfer_protobuf.deserialize_fields(
      "\9\1\0\0\0\0\0\0\0", pointer_fields)) as foreign *void
    local copied: owned *TitanTransferEntry = foreign TitanTransferEntry.new()
    ffi.memcpy(copied, entry, foreign TitanTransferEntry.sizeof)
    local tokens: {async.TransferValue} = {
      async.TransferValue.is_pointer(nil), async.TransferValue.is_pointer(address_one),
      async.TransferValue.is_pointer(copied as foreign *void),
    }
    local names = {"null", "address-one", "unregistered-identical-entry"}
    for index = 1, #tokens do
      local token = tokens[index]
      context:run(names[index], function (_context: test.Context)
        case token
        when is_pointer(pointer) then
          transfer_payload_error(function ()
            async.TransferValue.is_closure(module, pointer, "invalid protobuf"):to_value()
          end, "entry")
        else raise "invalid entry fixture policy" end
      end)
    end
  else raise "closure snapshot did not preserve its carrier" end
end

function test_transfer_closure_validates_counts_before_decoding_captures(_context: test.Context)
  local source = TransferPayloadRecord(47)
  local packet = async.TransferValue.from_value(function (): integer return source.secret end)
  local fields: const {transfer_reflect.Type} = {
    transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
      transfer_reflect.Type.is_named(transfer_reflect.NamedType("titan.transfer.TransferValue"))),
    transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
      transfer_reflect.Type.is_boolean()),
  }
  local policies = {async.TransferValue.from_value(source)}
  local flags: {boolean} = {}
  local bytes = transfer_protobuf.serialize_fields(fields, policies, flags)
  transfer_payload_decode_calls = 0
  case packet
  when is_closure(module, entry, _bytes) then
    transfer_payload_error(function ()
      async.TransferValue.is_closure(module, entry, bytes):to_value()
    end, "capture count")
  else raise "closure snapshot did not preserve its carrier" end
  test.assert(transfer_payload_decode_calls == 0,
    "invalid closure capture counts invoked a resource-capable decoder")
end

function test_transfer_closure_validates_all_slots_before_decoding_captures(context: test.Context)
  local source = TransferPayloadRecord(53)
  local left = 1
  local right = 2
  local packet = async.TransferValue.from_value(function (): integer
    return source.secret + left + right
  end)
  local fields: const {transfer_reflect.Type} = {
    transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
      transfer_reflect.Type.is_named(transfer_reflect.NamedType("titan.transfer.TransferValue"))),
    transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
      transfer_reflect.Type.is_boolean()),
  }
  local record_policy = async.TransferValue.from_value(source)
  local valid_policies: {value} = {record_policy,
    async.TransferValue.is_integer(1), async.TransferValue.is_integer(2)}
  local valid_flags: {value} = {false, false, false}
  local policy_hole: {value} = {record_policy, nil, async.TransferValue.is_integer(2)}
  local flag_hole: {value} = {false, nil, false}
  local rejected = function (policies: {value}, flags: {value}, expected: string)
    local bytes = transfer_protobuf.serialize_fields(fields, policies, flags)
    transfer_payload_decode_calls = 0
    case packet
    when is_closure(module, entry, _bytes) then
      transfer_payload_error(function ()
        async.TransferValue.is_closure(module, entry, bytes):to_value()
      end, expected)
    else raise "closure snapshot did not preserve its carrier" end
    test.assert(transfer_payload_decode_calls == 0,
      "a malformed closure slot invoked a resource-capable decoder")
  end
  context:run("policy-hole", function (_context: test.Context)
    rejected(policy_hole, valid_flags, "nil")
  end)
  context:run("flag-hole", function (_context: test.Context)
    rejected(valid_policies, flag_hole, "boolean")
  end)
end

function test_transfer_closure_failed_restore_releases_temporary_state(_context: test.Context)
  local number = 5
  local source = function (): integer number = number + 1 return number end
  local packet = async.TransferValue.from_value(source)
  local fields: const {transfer_reflect.Type} = {
    transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
      transfer_reflect.Type.is_named(transfer_reflect.NamedType("titan.transfer.TransferValue"))),
    transfer_reflect.Type.is_array(transfer_reflect.ArrayTypeConstness.is_mutable(),
      transfer_reflect.Type.is_boolean()),
  }
  local wrong = {async.TransferValue.is_string("wrong capture type")}
  local flags = {false}
  local bytes = transfer_protobuf.serialize_fields(fields, wrong, flags)
  case packet
  when is_closure(module, entry, _bytes) then
    transfer_payload_error(function ()
      async.TransferValue.is_closure(module, entry, bytes):to_value()
    end, "integer")
  else raise "closure snapshot did not preserve its carrier" end
  support.collect_garbage()
  local first: function (): integer = packet:to_value()
  local second: function (): integer = packet:to_value()
  test.assert(first() == 6 and second() == 6 and source() == 6,
    "failed restoration corrupted the state or shared restored cells")
end

function test_transfer_payload_explicit_policies_and_structural_fallback(_context: test.Context)
  local chosen = async.TransferValue.is_string("chosen\0policy")
  test.assert(async.TransferValue.from_value(chosen) == chosen,
              "explicit TransferValue policy was reinterpreted")
  test.assert(chosen:to_value() == "chosen\0policy")
  test.assert(async.TransferValue.from_value(nil):to_value() == nil)
  test.assert(async.TransferValue.from_value(false):to_value() == false)
  case async.TransferValue.from_value(42.0)
  when is_float(number) then test.assert(number == 42.0)
  else raise "from_value changed an integral float into an integer"
  end
  local plain = TransferPayloadPlain(42)
  local plain_packet = async.TransferValue.from_value(plain)
  case plain_packet
  when is_record(module, name, bytes) then
    test.assert(module == "async.tests" and name == "async.tests.TransferPayloadPlain")
    test.assert(bytes == transfer_protobuf.serialize(plain))
  else raise "record without hooks skipped structural protobuf"
  end
  local plain_copy: TransferPayloadPlain = plain_packet:to_value()
  test.assert(plain_copy ~= plain and plain_copy.marker == 42)
  local message = TransferPayloadPlainUnion.item(73)
  local union_copy: TransferPayloadPlainUnion = async.TransferValue.from_value(message):to_value()
  case union_copy
  when item(number) then test.assert(number == 73)
  end
  local closure = function (): integer return 91 end
  local closure_packet = async.TransferValue.from_value(closure)
  local restored_closure: function (): integer = closure_packet:to_value()
  test.assert(restored_closure() == 91, "local closure snapshot changed its behavior")
  local storage: owned int[] = foreign int.new_array(1)
  storage[0] = 117
  local pointer_packet = async.TransferValue.is_pointer(storage as foreign *void)
  case transfer_reflect.inspect(pointer_packet:to_value())
  when is_raw_pointer(pointer) then test.assert(pointer == storage as foreign *void)
  else raise "borrowed pointer policy did not recover a raw pointer"
  end
  local native: function (...: value): (...: value) =
    async.TransferValue.is_function(receiver_test_callback):to_value()
  test.assert(native(23) == 23)
  transfer_payload_error(function () async.TransferValue.from_value({1, 2, 3}) end,
                         "unsupported value")
end

function test_receiver_copies_custom_record_payload_and_retains_policy(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local source: TransferPayloadRecord = { secret = 211 }
    local packet = async.TransferValue.from_value(source)
    async.send(receiver:handle(), packet)
    source.secret = -1
    support.collect_garbage()
    local delivered = receiver:wait()
    case delivered
    when is_record_payload(module, name, payload) then
      test.assert(module == "async.tests" and name == "async.tests.TransferPayloadRecord" and #payload > 0)
    else raise "Receiver unwrapped the custom record policy"
    end
    local restored: TransferPayloadRecord = delivered:to_value()
    test.assert(restored.secret == 211, "Receiver retained source payload storage")
  end)
end

function test_receiver_rejects_custom_record_closure_cycle(_context: test.Context)
  runtime_test.run(function ()
    local receiver = async.receiver()
    defer receiver:close()
    local source: TransferPayloadClosureCycle = { marker = 1 }
    transfer_payload_error(function () async.TransferValue.from_value(source) end,
                           "cyclic")
    async.send(receiver:handle(), async.TransferValue.is_integer(42))
    test.assert(receiver:wait():to_value() == 42,
                "rejected payload poisoned a reusable Receiver")
  end)
end

function test_receiver_copies_opaque_payload_with_preconverted_native_policies(_context: test.Context)
  runtime_test.run(function ()
    local state = ffi.luaL_newstate()
    test.assert(state ~= nil, "could not allocate borrowed payload state")
    defer ffi.lua_close(state)
    local memory: owned int[] = foreign int.new_array(1)
    memory[0] = 137
    local null_pointer: foreign *void = nil
    local null_state: foreign *lua_State = nil
    local callback: foreign function (*lua_State): int = receiver_test_callback
    local inner: TransferPayloadNative = { policies = {
      async.TransferValue.is_pointer(null_pointer),
      async.TransferValue.is_pointer(memory as foreign *void),
      async.TransferValue.is_lua_state(null_state),
      async.TransferValue.is_lua_state(state),
      async.TransferValue.is_function(callback)
    } }
    local outer: TransferPayloadNative = {
      policies = { async.TransferValue.from_value(inner) }
    }
    local receiver = async.receiver()
    defer receiver:close()
    async.send(receiver:handle(), async.TransferValue.from_value(outer))
    support.collect_garbage()
    local outer_copy: TransferPayloadNative = receiver:wait():to_value()
    test.assert(#outer_copy.policies == 1)
    local inner_copy: TransferPayloadNative = outer_copy.policies[1]:to_value()
    local policies = inner_copy.policies
    test.assert(#policies == 5)
    case policies[1]
    when is_pointer(pointer) then test.assert(pointer == nil)
    else raise "nested NULL pointer policy changed variant" end
    case policies[2]
    when is_pointer(pointer) then test.assert(pointer == memory as foreign *void)
    else raise "nested pointer policy changed variant" end
    case policies[3]
    when is_lua_state(pointer) then test.assert(pointer == nil)
    else raise "nested NULL state policy changed variant" end
    case policies[4]
    when is_lua_state(pointer) then test.assert(pointer == state)
    else raise "nested state policy changed variant" end
    case policies[5]
    when is_function(entry) then test.assert(entry == callback)
    else raise "nested native function policy changed variant" end
    local native: function (...: value): (...: value) = policies[5]:to_value()
    test.assert(native(139) == 139, "nested native function lost callability")
    test.assert(memory[0] == 137, "nested pointer policy changed borrowed storage")
  end)
end
