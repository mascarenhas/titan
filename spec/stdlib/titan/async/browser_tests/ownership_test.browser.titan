-- Ownership: a C-created child state never drives the instance. Its
-- async.loop() and Runtime creation raise at once, with no owner Runtime and
-- with owner waits pending when an owner Task calls into it, and the owner's
-- drive progresses after each refusal.
function test_child_state_refuses_to_drive(_: test.Context)
  const child: value = ffi.scheduler_new_child(L)
  defer ffi.scheduler_close_child(L, child)
  ffi.scheduler_child_check(L, child)
  runtime_test.run(function ()
    const waiter = async.run<|integer, value|>(function (): integer
      return await_delay(10, 5, false)
    end)
    task_support.cleanup_task(waiter, "owner waiter cleanup")
    async.yield()
    test.assert(waiter:status():as_string() == "waiting", "the owner wait was not pending")
    ffi.scheduler_child_check(L, child)
    local ok, item? = async.join(waiter):has_succeeded()
    test.assert(ok and item == 5, "the owner drive did not progress after the child's refusal")
  end)
end

local function check_public_child_state(child: ownership_lua.Lua)
  child:run("require('async.browser_child').check()")
  const result = child:run("return 6 * 7")
  test.assert(result:to_value() == 42,
    "synchronous public child work failed while the owner was waiting")
end

function test_public_child_state_refuses_to_drive_and_preserves_owner(
    _: test.Context)
  const child = ownership_lua.new()
  defer child:close()
  check_public_child_state(child)
  runtime_test.run(function ()
    const waiter = async.run<|integer, value|>(function (): integer
      return await_delay(10, 5, false)
    end)
    task_support.cleanup_task(waiter, "public child owner waiter cleanup")
    async.yield()
    test.assert(waiter:status():as_string() == "waiting",
      "the public child case had no owner wait pending")
    -- Initialize another async module instance while its owner request is live.
    const second = ownership_lua.new()
    defer second:close()
    check_public_child_state(second)
    check_public_child_state(child)
    local ok, item? = async.join(waiter):has_succeeded()
    test.assert(ok and item == 5,
      "the owner request did not progress after the public child's refusal")
  end)
end
