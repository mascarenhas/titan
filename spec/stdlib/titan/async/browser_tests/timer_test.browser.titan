-- titan.timer on the browser driver: timers mixed with host requests across
-- relinquishes, zero delays that resume in a later browser task, and sleeps
-- and tickers that leave no JavaScript timer armed after cancellation, close
-- or the end of their Runtime. The harness counts the JavaScript timers.

-- JavaScript timers armed with this delay and still pending.
local function host_timers(milliseconds: integer): integer
  return integer_of(call_binding("host_timers", Value.is_integer(milliseconds)))
end

-- Gate 1, timers: Tasks that alternate timer sleeps (zero delays included)
-- with host requests keep their own order across hundreds of turns.
function test_timers_and_requests_across_relinquishes(_: test.Context)
  runtime_test.run(function ()
    const workers: {async.Task<|integer, value|>} = {}
    for worker = 1, 24 do
      const task = async.run<|integer, value|>(function (): integer
        local total = 0
        for step = 1, 5 do
          if (worker + step) % 2 == 0 then
            timer.sleep((worker + step) % 4)
            total = total + step
          else
            total = total + await_delay(1, step, false)
          end
        end
        return total
      end)
      task_support.cleanup_task(task, "timer worker cleanup")
      workers[worker] = task
    end
    const yielder = async.run<|integer, value|>(function (): integer
      for _ = 1, 300 do timer.yield() end
      return 300
    end)
    task_support.cleanup_task(yielder, "timer yielder cleanup")
    for worker = 1, 24 do
      local ok, total? = async.join(workers[worker]):has_succeeded()
      test.assert(ok and total == 15, "timer worker " .. worker .. " lost a step")
    end
    local ok, yields? = async.join(yielder):has_succeeded()
    test.assert(ok and yields == 300, "the timer yielder did not finish")
  end)
end

-- A marker armed on the driver's turn source before the Task yields runs
-- before the turn that resumes it, and not while the Task keeps the browser
-- task.
local function marker_ran(label: string, action: function ()): boolean
  call_binding("arm_marker")
  action()
  case call_binding("marked")
  when is_boolean(marked) then return marked
  end
  raise label .. ": marked returned a non-boolean"
end

function test_zero_delays_resume_in_a_later_browser_task(_: test.Context)
  runtime_test.run(function ()
    for _ = 1, 3 do
      test.assert(not marker_ran("no wait", function () end),
        "the marker ran while the Task kept the browser task")
      test.assert(marker_ran("timer.sleep(0)", function () timer.sleep(0) end),
        "timer.sleep(0) resumed in the same browser task")
      test.assert(marker_ran("timer.yield()", function () timer.yield() end),
        "timer.yield() resumed in the same browser task")
      test.assert(marker_ran("async.yield()", function () async.yield() end),
        "async.yield() resumed in the same browser task")
    end
  end)
end

function test_cancelled_sleeps_and_closed_tickers_clear_host_timers(_: test.Context)
  runtime_test.run(function ()
    const sleeper = async.run<|nil, value|>(function (): nil
      timer.sleep(60000)
      return nil
    end)
    task_support.cleanup_task(sleeper, "host timer sleeper cleanup")
    while sleeper:status():as_string() == "ready" do timer.yield() end
    test.assert(host_timers(60000) == 1, "a waiting sleep armed no JavaScript timer")
    sleeper:cancel(async.CancellationReason<|value|>.simple("clear the host timer"))
    async.join(sleeper)
    test.assert(host_timers(60000) == 0, "a cancelled sleep left its JavaScript timer armed")

    const ticker = timer.ticker(55000)
    defer ticker:close()
    test.assert(host_timers(55000) == 1, "a ticker armed no JavaScript timer")
    ticker:close()
    test.assert(host_timers(55000) == 0, "a closed ticker left its JavaScript timer armed")
  end)
  runtime_test.run(function ()
    timer.ticker(50000)
    test.assert(host_timers(50000) == 1, "a leftover ticker armed no JavaScript timer")
  end)
  test.assert(host_timers(50000) == 0, "a ticker left open past its Runtime kept its JavaScript timer")
end

-- The spy holds these delays, so every chunk boundary is driven explicitly.
local const LONG_PERIOD = 3000000000
local const FIRST_CHUNK = 2147483647
local const LAST_CHUNK = 852516353 -- 3000000000 - 2147483647

local function wait_for_host_timer(milliseconds: integer)
  while host_timers(milliseconds) == 0 do timer.yield() end
  test.assert(host_timers(milliseconds) == 1, "expected exactly one host timer chunk")
end

local function fire_host_timer(milliseconds: integer)
  case call_binding("fire_host_timer", Value.is_integer(milliseconds))
  when is_boolean(fired) then
    test.assert(fired, "the expected long timer chunk was not held")
    return
  end
  raise "fire_host_timer returned a non-boolean"
end

local function long_sleep(): async.Task<|nil, value|>
  const sleeper = async.run<|nil, value|>(function (): nil
    timer.sleep(LONG_PERIOD)
    return nil
  end)
  task_support.cleanup_task(sleeper, "long sleeper cleanup")
  return sleeper
end

function test_long_sleeps_chain_chunks_and_cancel(_: test.Context)
  runtime_test.run(function ()
    local sleeper = long_sleep()
    wait_for_host_timer(FIRST_CHUNK)
    test.assert(host_timers(LONG_PERIOD) == 0, "a long sleep reached the host without chunking")
    fire_host_timer(FIRST_CHUNK)
    wait_for_host_timer(LAST_CHUNK)
    test.assert(sleeper:status():as_string() == "waiting", "a long sleep finished before its final chunk")
    fire_host_timer(LAST_CHUNK)
    test.assert(async.join(sleeper):has_succeeded(), "a long sleep did not finish after its final chunk")
    test.assert(host_timers(FIRST_CHUNK) == 0 and host_timers(LAST_CHUNK) == 0,
      "a completed long sleep left a host timer")

    sleeper = long_sleep()
    wait_for_host_timer(FIRST_CHUNK)
    fire_host_timer(FIRST_CHUNK)
    wait_for_host_timer(LAST_CHUNK)
    sleeper:cancel(async.CancellationReason<|value|>.simple("cancel a long sleep"))
    test.assert(async.join(sleeper):has_cancelled(), "a long sleep ignored cancellation")
    test.assert(host_timers(FIRST_CHUNK) == 0 and host_timers(LAST_CHUNK) == 0,
      "a cancelled long sleep left its current chunk armed")
  end)
end

local function long_ticker_wait(...: Value): Value
  -- Intentionally left open: disposal must retire it through Runtime close.
  const ticker = timer.ticker(LONG_PERIOD)
  ticker:tick()
  return Value.is_nil()
end

function test_long_tickers_rearm_whole_periods_and_close(_: test.Context)
  runtime_test.run(function ()
    local ticks = 0
    local ticking = async.run<|nil, value|>(function (): nil
      const ticker = timer.ticker(LONG_PERIOD)
      defer ticker:close()
      for _ = 1, 2 do
        test.assert(ticker:tick(), "a long ticker closed before its tick")
        test.assert(host_timers(FIRST_CHUNK) == 1 and host_timers(LAST_CHUNK) == 0,
          "a long ticker published before re-arming its whole period")
        ticks = ticks + 1
      end
      return nil
    end)
    task_support.cleanup_task(ticking, "long ticker cleanup")
    for tick = 1, 2 do
      wait_for_host_timer(FIRST_CHUNK)
      fire_host_timer(FIRST_CHUNK)
      wait_for_host_timer(LAST_CHUNK)
      test.assert(ticks == tick - 1, "a long ticker fired before its final chunk")
      fire_host_timer(LAST_CHUNK)
      while ticks < tick and not ticking:status():has_finished() do timer.yield() end
      test.assert(ticks == tick, "a whole long period never ticked")
    end
    test.assert(async.join(ticking):has_succeeded(), "a long ticker did not tick twice")
    test.assert(host_timers(FIRST_CHUNK) == 0 and host_timers(LAST_CHUNK) == 0,
      "a closed long ticker left a host timer")

    ticking = async.run<|nil, value|>(function (): nil
      const ticker = timer.ticker(LONG_PERIOD)
      defer ticker:close()
      ticker:tick()
      return nil
    end)
    task_support.cleanup_task(ticking, "cancelled long ticker cleanup")
    wait_for_host_timer(FIRST_CHUNK)
    fire_host_timer(FIRST_CHUNK)
    wait_for_host_timer(LAST_CHUNK)
    ticking:cancel(async.CancellationReason<|value|>.simple("cancel a long ticker"))
    test.assert(async.join(ticking):has_cancelled(), "a long ticker waiter ignored cancellation")
    test.assert(host_timers(FIRST_CHUNK) == 0 and host_timers(LAST_CHUNK) == 0,
      "cancelling and closing a long ticker left its current chunk armed")
  end)
end
