-- Native in-process behavior migrated from the direct portions of
-- spec/stdlib/lua_spec.lua and spec/stdlib/peg_spec.lua. This folder is one
-- logical test module, invoked with:
--   titanc --test --tree spec/stdlib/titan lua_peg_native
local test = import "test"
local fs = import "fs"
local gc = import "titan.gc"
local tlua = import "titan.lua"
local peg = import "peg"

-- The only raw-Lua operation this suite needs is reading the existing package
-- table so a miss-only search configuration can be installed and restored.
local lua = foreign import "lua.h"
local ffi = foreign import "titan/ffi.h"
