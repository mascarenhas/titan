local async = import "async"
local fs = import "fs"
local system = import "os"
local str = import "string"
foreign import "uv_stdio_probe.h"

local function child_path(): string
  local child? = system.getenv("TITAN_PROCESS_CHILD")
  if not child or #child == 0 then raise "runner did not supply TITAN_PROCESS_CHILD" end
  return child
end

local function required_input(candidate: system.InputStream?,
                              label: string): system.InputStream
  if not candidate then raise label .. " was not captured" end
  return candidate as system.InputStream
end

local function required_output(candidate: system.OutputStream?,
                               label: string): system.OutputStream
  if not candidate then raise label .. " was not captured" end
  return candidate as system.OutputStream
end

local function read_all(input: system.InputStream): string
  local result = ""
  for chunk in input:read do result = result .. chunk end
  return result
end

local function expect_normal(process: system.Process, label: string)
  local status = process:wait()
  if status.code ~= 0 or status.signal_number ~= 0 then
    raise label .. " did not exit normally"
  end
end


local function expect_shutdown_enotsup(stream: system.OutputStream, label: string)
  local rejected = false
  do
    stream:shutdown()
  catch
    if not (error is async.OperationError) then
      raise label .. " shutdown did not raise OperationError"
    end
    local failure = error as async.OperationError
    if failure.operation ~= "stdio.shutdown" or failure.name ~= "ENOTSUP" then
      raise label .. " shutdown raised unexpected error: " ..
            failure.operation .. ": " .. failure.name
    end
    rejected = true
  end
  if not rejected then
    raise label .. " unexpectedly accepted shutdown"
  end
end
local function parent_pipes(): string
  if system.stdin:is_tty() or system.stdout:is_tty() or system.stderr:is_tty() or
     system.stdin:kind() ~= "pipe" or system.stdout:kind() ~= "pipe" or
     system.stderr:kind() ~= "pipe" then
    raise "pipe parent stdio was misclassified"
  end
  if read_all(system.stdin) ~= "parent-pipe-input" then
    raise "parent stdin changed bytes"
  end
  expect_shutdown_enotsup(system.stdout, "pipe stdout")
  expect_shutdown_enotsup(system.stderr, "pipe stderr")
  system.stdout:write("pipe-stdout")
  system.stderr:write("pipe-stderr")
  return "parent-pipes-ok"
end

local function parent_inheritance(): string
  local process = system.spawn(
    child_path(), {"exit", "0"},
    system.with_parent_stdin, system.with_parent_stdout,
    system.with_parent_stderr)
  if process.stdin then
    raise "inherited stdin exposed a captured endpoint"
  end
  if process.stdout then
    raise "inherited stdout exposed a captured endpoint"
  end
  if process.stderr then
    raise "inherited stderr exposed a captured endpoint"
  end
  expect_normal(process, "inherited low-level child")
  return "parent-inheritance-ok"
end

local function parent_tty(): string
  if not system.stdout:is_tty() or system.stdout:kind() ~= "tty" then
    raise "PTY stdout was not classified as a TTY"
  end
  expect_shutdown_enotsup(system.stdout, "TTY stdout")
  system.stdout:write("tty-output")
  return "parent-tty-ok"
end

local function parent_file(): string
  -- Windows counts process kernel handles; warm the process-wide libuv thread pool first.
  fs.stat(".")
  local before = ffi.titan_uv_test_stdio_open_fd_count()
  if before < 0 then raise "could not count descriptors before file stdio" end
  if system.stdout:is_tty() or system.stdout:kind() ~= "file" then
    raise "file stdout was misclassified"
  end
  expect_shutdown_enotsup(system.stdout, "file stdout")
  system.stdout:write("file-output")
  system.stdout:close()
  if system.stdout:kind() ~= "file" then
    raise "closing file stdout changed its kind"
  end
  if ffi.titan_uv_test_stdio_open_fd_count() ~= before then
    raise "parent file stdout leaked a descriptor"
  end
  return "parent-file-ok"
end

local function expect_write_rejected(stream: system.OutputStream, data: string,
                                     label: string)
  local rejected = false
  do
    stream:write(data)
  catch
    if not (error is async.OperationError) then
      raise label .. " write did not raise OperationError"
    end
    local failure = error as async.OperationError
    if failure.operation ~= "stdio.write" or failure.code >= 0 then
      raise label .. " write raised unexpected error: " ..
            failure.operation .. ": " .. failure.name
    end
    rejected = true
  end
  if not rejected then
    raise label .. " unexpectedly accepted write after shutdown"
  end
end

local function parent_tcp(): string
  if system.stdin:is_tty() or system.stdout:is_tty() or system.stderr:is_tty() or
     system.stdin:kind() ~= "tcp" or system.stdout:kind() ~= "tcp" or
     system.stderr:kind() ~= "tcp" then
    raise "TCP parent stdio was misclassified"
  end
  system.stdin:close()
  system.stdout:close()
  system.stderr:close()
  if read_all(system.stdin) ~= "parent-tcp-input" then
    raise "parent TCP stdin changed bytes"
  end
  if system.stdin:read() ~= nil then
    raise "parent TCP stdin did not keep sticky EOF"
  end
  system.stdout:write("tcp-stdout")
  system.stderr:write("tcp-stderr")
  system.stdout:shutdown()
  system.stdout:shutdown()
  expect_write_rejected(system.stdout, "after-shutdown", "TCP stdout")
  expect_write_rejected(system.stdout, "", "TCP stdout empty")
  return "parent-tcp-ok"
end

local function warm_child_process()
  local warm = system.spawn(child_path(), {"exit", "0"})
  local warm_stdin = required_output(warm.stdin, "warm stdin")
  expect_shutdown_enotsup(warm_stdin, "captured child stdin")
  warm_stdin:close()
  local warm_stdout = required_input(warm.stdout, "warm stdout")
  local warm_stderr = required_input(warm.stderr, "warm stderr")
  read_all(warm_stdout)
  read_all(warm_stderr)
  expect_normal(warm, "warm child")
  warm_stdout:close()
  warm_stderr:close()
  async.yield()
end

local function reject_parent_stdout_after_warm(
    expected: string, expected_name: string?, expected_probe: string?,
    close_stdout: boolean?): string
  if close_stdout and ffi.titan_uv_test_stdio_close_child_stdout() ~= 0 then
    raise "could not close child stdout for EBADF probe"
  end
  local before = ffi.titan_uv_test_stdio_open_fd_count()
  if before < 0 then raise "could not count descriptors before rejection" end
  local kind_rejected = false
  do
    system.stdout:is_tty()
  catch
    if not (error is async.OperationError) then
      raise "parent classification did not raise OperationError"
    end
    local failure = error as async.OperationError
    local name = expected_name or "ENOTSUP"
    if failure.operation ~= "stdio.parent.kind" or failure.name ~= name or
       str.find(failure.message, "fd 1:") == nil or
       (expected_probe and str.find(failure.message, expected_probe) == nil) then
      raise "unexpected parent classification error: " .. failure.operation ..
            ": " .. failure.name .. ": " .. failure.message
    end
    kind_rejected = true
  end
  if not kind_rejected then raise "unsupported stdout classification succeeded" end

  if not close_stdout then
    -- With fd 1 closed, unrelated spawn setup can legitimately reuse that
    -- number before the parent-stream option runs. The direct probe above
    -- owns the EBADF assertion; live unsupported descriptors also exercise
    -- the failed-spawn ownership path.
    local rejected = false
    do
      local process = system.spawn(
        child_path(), {"exit", "0"}, system.with_parent_stdout)
      if process.stdin then (process.stdin as system.OutputStream):close() end
      if process.stdout then (process.stdout as system.InputStream):close() end
      if process.stderr then (process.stderr as system.InputStream):close() end
      process:wait()
    catch
      rejected = true
    end
    if not rejected then raise "unsupported parent stdout was accepted" end
  end
  if ffi.titan_uv_test_stdio_open_fd_count() ~= before then
    raise "parent stdout rejection leaked a descriptor"
  end
  return expected
end

local function reject_parent_stdout(expected: string, expected_name: string?,
                                     expected_probe: string?,
                                     close_stdout: boolean?): string
  warm_child_process()
  return reject_parent_stdout_after_warm(
    expected, expected_name, expected_probe, close_stdout)
end

local function reject_windows_child_sockets(): string
  warm_child_process()
  local modes: {integer} = {
    ffi.TITAN_UV_TEST_CHILD_SOCKET_TCP_OVERLAPPED,
    ffi.TITAN_UV_TEST_CHILD_SOCKET_TCP_NONOVERLAPPED,
    ffi.TITAN_UV_TEST_CHILD_SOCKET_TCP_LISTENER,
    ffi.TITAN_UV_TEST_CHILD_SOCKET_TCP_UNCONNECTED,
    ffi.TITAN_UV_TEST_CHILD_SOCKET_UDP_UNCONNECTED,
    ffi.TITAN_UV_TEST_CHILD_SOCKET_UDP_CONNECTED,
  }
  for index = 1, #modes do
    local installed = ffi.titan_uv_test_stdio_install_child_socket_stdout(modes[index])
    if installed ~= 0 then
      raise ffi.titan_uv_test_stdio_failure() as string
    end
    do
      defer do
        if ffi.titan_uv_test_stdio_restore_child_socket_stdout() ~= 0 then
          raise ffi.titan_uv_test_stdio_failure() as string
        end
      end
      reject_parent_stdout_after_warm(
        "parent-windows-socket-rejected", "ENOTSUP",
        "socket-backed parent stdio is not supported on Windows")
    end
  end
  if system.stdout:is_tty() or system.stdout:kind() ~= "pipe" then
    raise "restored Windows pipe stdout was misclassified after socket rejection"
  end
  expect_shutdown_enotsup(system.stdout, "restored Windows pipe stdout")
  system.stdout:write("pipe-stdout")
  system.stderr:write("pipe-stderr")
  return "parent-windows-sockets-rejected"
end

local function deny_metadata(probes: integer, descriptors: integer,
                             access_error: boolean?)
  local access = 0
  if access_error then access = 1 end
  if ffi.titan_uv_test_stdio_deny_metadata(probes, descriptors, access) ~= 0 then
    raise ffi.titan_uv_test_stdio_failure() as string
  end
end

local function parent_stdout(): string
  if system.stdout:is_tty() or system.stdout:kind() ~= "pipe" then
    raise "socket stdout was misclassified"
  end
  system.stdout:write("pipe-stdout")
  return "parent-stdout-ok"
end

local function denied_diagnostic(): string
  local task = async.run<|nil, value|>(function (): nil
    system.stdout:is_tty()
    return nil
  end)
  local failed, failure? = async.join(task):has_failed()
  if not failed or not failure then raise "denied stdio Task did not fail" end
  if not (failure.error is async.OperationError) then
    raise "denied stdio Task lost its OperationError"
  end
  return "parent-denied-diagnostic"
end

local function run_case(mode: string): string
  if mode == "pipes" then
    return parent_pipes()
  elseif mode == "inherit" then
    return parent_inheritance()
  elseif mode == "tty" then
    return parent_tty()
  elseif mode == "file" then
    return parent_file()
  elseif mode == "tcp" then
    return parent_tcp()
  elseif mode == "socket" then
    return reject_parent_stdout("parent-socket-rejected")
  elseif mode == "tcp-unconnected" then
    return reject_parent_stdout("parent-tcp-unconnected-rejected", "ENOTSUP",
                                "unconnected TCP socket")
  elseif mode == "tcp-listener" then
    return reject_parent_stdout("parent-tcp-listener-rejected", "ENOTSUP",
                                "listening TCP socket")
  elseif mode == "udp-connected" then
    return reject_parent_stdout("parent-udp-connected-rejected", "ENOTSUP",
                                "uv_guess_handle classified unsupported kind udp")
  elseif mode == "windows-sockets" then
    return reject_windows_child_sockets()
  elseif mode == "closed" then
    return reject_parent_stdout("parent-closed-rejected", "EBADF",
                                ffi.titan_uv_test_stdio_closed_probe() as string, true)
  elseif mode == "denied-pipes" or mode == "denied-pipes-access" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_ALL, 7,
                  mode == "denied-pipes-access")
    return parent_pipes()
  elseif mode == "denied-stdin" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_ALL, 7)
    if system.stdin:is_tty() or system.stdin:kind() ~= "pipe" or
       read_all(system.stdin) ~= "parent-pipe-input" then
      raise "hinted stdin did not preserve pipe input"
    end
    return "parent-stdin-ok"
  elseif mode == "denied-stdout" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_ALL, 7)
    return parent_stdout()
  elseif mode == "denied-stderr" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_ALL, 7)
    if system.stderr:is_tty() or system.stderr:kind() ~= "pipe" then
      raise "hinted stderr was misclassified"
    end
    system.stderr:write("pipe-stderr")
    return "parent-stderr-ok"
  elseif mode == "denied-reject" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_ALL, 7)
    return reject_parent_stdout("parent-denied-rejected", "EPERM", "getsockname")
  elseif mode == "deny-name-stdout" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_NAME, 2)
    return parent_stdout()
  elseif mode == "deny-type-stdout" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_TYPE, 2, true)
    return parent_stdout()
  elseif mode == "deny-name-reject" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_NAME, 2)
    return reject_parent_stdout("parent-contradiction-rejected", "ENOTSUP",
                                 "getsockopt(SO_TYPE)")
  elseif mode == "deny-type-reject" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_TYPE, 2)
    return reject_parent_stdout("parent-contradiction-rejected", "ENOTSUP",
                                 "getsockname")
  elseif mode == "deny-peer-reject" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_PEER, 2)
    return reject_parent_stdout("parent-peer-denied-rejected", "EPERM",
                                "getpeername")
  elseif mode == "denied-diagnostic" then
    deny_metadata(ffi.TITAN_UV_TEST_STDIO_DENY_ALL, 7)
    return denied_diagnostic()
  end
  raise "unknown stdio fixture mode '" .. mode .. "'"
end

function main(arguments: {string}): integer
  local mode? = arguments[1]
  local result_path? = arguments[2]
  if not mode or not result_path then return 2 end

  local succeeded = true
  local result = ""
  do
    result = run_case(mode as string)
  catch
    succeeded = false
    result = str.tostring(error) .. "\n" .. traceback
  end

  local report = "ERROR:" .. result
  if succeeded then report = "OK:" .. result end
  fs.write_file(result_path as string, report)
  if succeeded then return 0 end
  return 1
end
