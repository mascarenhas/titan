local test = import "test"
local async = import "async"
local fs = import "fs"
local gc = import "gc"
local io = import "io"
local tlua = import "lua"
local system = import "os"
local strings = import "string"
local timer = import "timer"
local uv = import "uv"
foreign import "titan/ffi.h"
foreign import "os_descriptor_limit.h"

record ReleaseWatch
  cells: foreign *void
end

local function on_release_finalize(candidate: value)
  local watch: ReleaseWatch = candidate
  ffi.titan_test_worker_gate_release(watch.cells)
end

local function hold_n_workers(count: integer): (owned int[], {async.Task<|nil, value|>})
  local cells: owned int[] = foreign int.new_array(4)
  local raw = cells as foreign *void
  ffi.titan_test_worker_gate_init(raw)
  local handed_off = false
  defer if not handed_off then ffi.titan_test_worker_gate_release(raw) end
  local workers: {async.Task<|nil, value|>} = {}
  for index = 1, count do
    workers[index] = async.run<|nil, value|>(function (): nil
      async.run_foreign(
        ffi.titan_test_worker_gate_work,
        cells as foreign *void,
        ffi.titan_test_worker_gate_noop)
      return nil
    end)
  end
  local attempts = 0
  while ffi.titan_test_worker_gate_entered(raw) < count do
    attempts = attempts + 1
    if attempts > 5000 then
      ffi.titan_test_worker_gate_release(raw)
      raise "worker gate timed out waiting for workers"
    end
    async.yield()
    uv.sleep(1)
  end
  handed_off = true
  return cells, workers
end

local function hold_workers(): (owned int[], {async.Task<|nil, value|>})
  return hold_n_workers(4)
end

local function release_workers(
    cells: owned int[], workers: {async.Task<|nil, value|>})
  ffi.titan_test_worker_gate_release(cells as foreign *void)
  for index = 1, #workers do
    async.join(workers[index])
  end
end

function exercise_cancelled_worker_gate_acquisition()
  local reason = async.CancellationReason.simple("cancel-during-worker-gate-acquisition")
  local returned = false
  local target = async.run<|nil, value|>(function (): nil
    local cells, workers = hold_workers()
    defer ffi.titan_test_worker_gate_release(cells as foreign *void)
    returned = true
    release_workers(cells, workers)
    return nil
  end)
  local canceller = async.run<|nil, value|>(function (): nil
    target:cancel(reason)
    return nil
  end)
  async.loop()
  local cancelled, observed? = target:status():has_cancelled()
  test.assert(cancelled and observed == reason and not returned and
              canceller:status():has_succeeded(),
              "cancelled gate acquisition did not release its native workers")
end

local function wait_until_task_waiting(task: async.Task<|value, value|>, label: string)
  while task:status():as_string() == "ready" or
        task:status():as_string() == "running" do
    async.yield()
  end
  test.assert(task:status():as_string() == "waiting",
              label .. " did not reach waiting status")
end

local function assert_raises_substring(action: function (): (), expected: string)
  local caught = false
  do
    action()
  catch
    caught = true
    test.assert(strings.find(strings.tostring(error), expected) ~= nil,
                "expected '" .. expected .. "', got: " .. strings.tostring(error))
  end
  test.assert(caught, "expected error containing '" .. expected .. "'")
end

local function cancel_and_retain_inflight_read(
    reason: async.CancellationReason<|value|>): value
  local cells_a, workers_a = hold_n_workers(3)
  defer ffi.titan_test_worker_gate_release(cells_a as foreign *void)
  local cells_b, workers_b = hold_n_workers(1)
  defer ffi.titan_test_worker_gate_release(cells_b as foreign *void)

  local observed: value = nil
  local reader = async.run<|nil, value|>(function (): nil
    do
      system.stdin:read()
    catch
      observed = error
    end
    return nil
  end)
  wait_until_task_waiting(reader, "cancelled retention reader")
  reader:cancel(reason)
  async.join(reader)
  test.assert(reader:status():has_cancelled() and observed == reason,
              "cancelled retention reader lost cancellation reason")

  local sentinel = async.run<|nil, value|>(function (): nil
    async.run_foreign(
      ffi.titan_test_worker_gate_noop,
      nil,
      ffi.titan_test_worker_gate_noop)
    return nil
  end)
  wait_until_task_waiting(sentinel, "retention completion sentinel")

  release_workers(cells_b, workers_b)
  async.join(sentinel)
  test.assert(sentinel:status():has_succeeded(),
              "retention completion sentinel failed")
  release_workers(cells_a, workers_a)
  return observed
end

function setup_abandoned_state(raw: value)
  local cells = raw as foreign *void
  local armed = false
  defer if not armed then ffi.titan_test_worker_gate_release(cells) end
  for _ = 1, 4 do
    async.run<|nil, value|>(function (): nil
      async.run_foreign(
        ffi.titan_test_worker_gate_work,
        cells,
        ffi.titan_test_worker_gate_noop)
      return nil
    end)
  end
  local attempts = 0
  while ffi.titan_test_worker_gate_entered(cells) < 4 do
    attempts = attempts + 1
    if attempts > 5000 then
      ffi.titan_test_worker_gate_release(cells)
      raise "abandoned state worker gate timed out"
    end
    uv.run(async.current_loop(), uv.RUN_NOWAIT)
    uv.sleep(1)
  end
  gc.collect()
  test.assert(ffi.titan_test_worker_gate_is_released(cells) == 0,
              "the abandonment release watch finalized during setup")
  local w1 = async.run<|nil, value|>(function (): nil
    do
      system.stdout:write("ABANDONED-INFLIGHT;")
      ffi.titan_test_worker_gate_fail(cells)
    catch
      ffi.titan_test_worker_gate_fail(cells)
    end
    return nil
  end)
  local w2 = async.run<|nil, value|>(function (): nil
    do
      system.stdout:write("ABANDONED-QUEUED;")
      ffi.titan_test_worker_gate_fail(cells)
    catch
      ffi.titan_test_worker_gate_fail(cells)
    end
    return nil
  end)
  local r1 = async.run<|nil, value|>(function (): nil
    do
      system.stdin:read()
      ffi.titan_test_worker_gate_fail(cells)
    catch
      ffi.titan_test_worker_gate_fail(cells)
    end
    return nil
  end)
  uv.run(async.current_loop(), uv.RUN_NOWAIT)
  if w1:status():as_string() ~= "waiting" or
     w2:status():as_string() ~= "waiting" or
     r1:status():as_string() ~= "waiting" then
    ffi.titan_test_worker_gate_release(cells)
    raise "abandoned state tasks did not park in waiting state"
  end
  gc.finalizable<|value|>(ReleaseWatch(cells), on_release_finalize)
  armed = true
end

function exercise_cancelled_read_error(file_path: value)
  local path = file_path as string
  local saved_stdin = ffi.titan_test_dup_fd(0)
  test.assert(saved_stdin >= 0, "could not save stdin for read error")
  defer ffi.titan_test_restore_fd(saved_stdin, 0)
  test.assert(ffi.titan_test_open_file_onto_fd(path, 1, 0) == 0,
              "could not open write-only file onto stdin")
  local completed = false
  local main_task = async.run<|nil, value|>(function (): nil
    test.assert(system.stdin:kind() == "file", "write-only file stdin lost file kind")
    local cancel_reason = async.CancellationReason.simple("cancel-error-read")
    cancel_and_retain_inflight_read(cancel_reason)

    for attempt = 1, 2 do
      local caught: async.OperationError? = nil
      do
        system.stdin:read()
      catch
        if error is async.OperationError then
          caught = error as async.OperationError
        else
          raise
        end
      end
      test.assert(caught ~= nil and caught.operation == "stdio.read" and caught.code < 0,
                  "retained/sticky read error failed on attempt " .. attempt)
    end
    completed = true
    return nil
  end)
  async.loop()
  local failed, err? = main_task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(completed and main_task:status():has_succeeded(),
              "cancelled read error task did not complete")

  local recovered = false
  local recover_task = async.run<|nil, value|>(function (): nil
    fs.write_file(path, "RECOVERED_AFTER_STICKY_READ_ERROR")
    test.assert(ffi.titan_test_open_file_onto_fd(path, 0, 0) == 0,
                "could not reopen readable file onto stdin between Runtimes")
    test.assert(system.stdin:kind() == "file",
                "reopened stdin lost file kind in later Runtime")
    test.assert(system.stdin:read() == "RECOVERED_AFTER_STICKY_READ_ERROR",
                "later Runtime retained sticky read error from previous Runtime")
    test.assert(system.stdin:read() == nil,
                "later Runtime did not reach fresh EOF after error reset")
    recovered = true
    return nil
  end)
  async.loop()
  local rec_failed, rec_err? = recover_task:status():has_failed()
  if rec_failed and rec_err ~= nil then rec_err:raise() end
  test.assert(recovered and recover_task:status():has_succeeded(),
              "read error reset across Runtimes failed")
end

function exercise_pump_fatal_drains_tail(out_path: value, recovery: value)
  local path = out_path as string
  local fail_recovery = recovery as boolean
  local budget = 2
  if fail_recovery then budget = 4 end
  local saved_stdout = ffi.titan_test_dup_fd(1)
  test.assert(saved_stdout >= 0, "could not save stdout for pump fatal test")
  defer ffi.titan_test_restore_fd(saved_stdout, 1)
  defer ffi.titan_test_fsize_limit_restore()

  local prev_ud: foreign *void = nil
  local prev_alloc = ffi.lua_getallocf(L, prev_ud)
  ffi.titan_test_slice_fault_configure(
    prev_alloc, prev_ud, ffi.LUA_TUSERDATA as foreign size_t)
  ffi.lua_setallocf(L, ffi.titan_test_slice_fault_alloc, nil)
  defer do
    ffi.titan_test_slice_fault_disarm()
    ffi.lua_setallocf(L, prev_alloc, prev_ud)
  end
  local _calibrate = uv.buf_t.from_string("calibrate")
  ffi.titan_test_slice_fault_watch_end()
  test.assert(ffi.titan_test_slice_fault_size() > 0,
              "could not calibrate buf_t userdata allocation size")

  test.assert(ffi.titan_test_open_file_onto_fd(path, 1, 1) == 0,
              "could not open pump fatal output file onto stdout")

  local first_error = ""
  local second_done = false
  local third_done = false
  local main_task = async.run<|nil, value|>(function (): nil
    local cells, _workers = hold_workers()
    defer ffi.titan_test_worker_gate_release(cells as foreign *void)
    test.assert(ffi.titan_test_fsize_limit_short_write_once(4096) == 0,
                "could not arm short write limit for pump fatal test")
    local g1: (function (nil): ())? = nil
    local g2: (function (nil): ())? = nil
    local g3: (function (nil): ())? = nil
    local w1 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) g1 = resolve end)
      do
        system.stdout:write(strings.rep("A", 10000))
      catch
        first_error = strings.tostring(error)
      end
      return nil
    end)
    local w2 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) g2 = resolve end)
      do system.stdout:write("MIDDLE_AFTER_PUMP_FATAL") catch end
      second_done = true
      return nil
    end)
    local w3 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) g3 = resolve end)
      do system.stdout:write("TAIL_AFTER_PUMP_FATAL") catch end
      third_done = true
      return nil
    end)
    while g1 == nil or g2 == nil or g3 == nil do async.yield() end
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local r1, r2, r3 = g1, g2, g3
      g1, g2, g3 = nil, nil, nil
      r1(nil)
      r2(nil)
      r3(nil)
      test.assert(w1:status():as_string() == "waiting" and
                  w2:status():as_string() == "waiting" and
                  w3:status():as_string() == "waiting",
                  "pump fatal writers did not park")
      resolve(nil)
    end)
    ffi.titan_test_slice_fault_arm(budget)
    ffi.titan_test_worker_gate_release(cells as foreign *void)
    return nil
  end)

  local outer_error = ""
  do
    async.loop()
  catch
    outer_error = strings.tostring(error)
  end
  ffi.titan_test_slice_fault_disarm()
  ffi.lua_setallocf(L, prev_alloc, prev_ud)
  test.assert(ffi.titan_test_fsize_limit_restore() == 0,
              "could not restore fsize limit after pump fatal")
  test.assert(ffi.titan_test_slice_fault_hits() == budget,
              "slice/recovery allocator did not exhaust its fault budget")
  test.assert(strings.find(first_error, "not enough memory") ~= nil,
              "first write did not observe OOM: " .. first_error)
  test.assert(strings.find(outer_error, "not enough memory") ~= nil,
              "async.loop did not report fatal OOM: " .. outer_error)
  test.assert(second_done and third_done and main_task:status():has_succeeded(),
              "queued tail write was abandoned after pump fatal error")

  local check_done = false
  local check_task = async.run<|nil, value|>(function (): nil
    local expected = strings.rep("A", 4096)
    if not fail_recovery then expected = expected .. "MIDDLE_AFTER_PUMP_FATAL" end
    expected = expected .. "TAIL_AFTER_PUMP_FATAL"
    test.assert(fs.read_file(path) == expected,
                "pump fatal output file lost queued tail bytes")
    system.stdout:write(":AFTER_RECOVERY")
    test.assert(fs.read_file(path) == expected .. ":AFTER_RECOVERY",
                "subsequent Runtime write failed after pump fatal recovery")
    check_done = true
    return nil
  end)
  async.loop()
  local failed, err? = check_task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(check_done and check_task:status():has_succeeded(),
              "post-fatal verification task failed")
end

function exercise_delimiter_across_chunks(file_path: value)
  local path = file_path as string
  local part1 = strings.rep("P\0\r\n", 18000)
  local part2 = strings.rep("Q\255\n\r", 18000)
  local tail = "TAIL_WITHOUT_DELIMITER\0!"
  local saved_stdin = ffi.titan_test_dup_fd(0)
  test.assert(saved_stdin >= 0, "could not save stdin for delimiter test")
  defer ffi.titan_test_restore_fd(saved_stdin, 0)
  local completed = false
  local main_task = async.run<|nil, value|>(function (): nil
    fs.write_file(path, part1 .. "<DELIM>" .. part2 .. "<DELIM>" .. tail)
    test.assert(ffi.titan_test_open_file_onto_fd(path, 0, 0) == 0,
                "could not open delimiter input file onto stdin")
    test.assert(system.stdin:read_until("<DELIM>", true) == part1,
                "first multi-chunk read_until result mismatched")
    test.assert(system.stdin:read_until("<DELIM>", false) == part2 .. "<DELIM>",
                "second multi-chunk read_until result mismatched")
    test.assert(system.stdin:read_until("<DELIM>", true) == tail,
                "final tail read_until result mismatched")
    test.assert(system.stdin:read_until("<DELIM>", true) == nil,
                "read_until after EOF did not return nil")
    test.assert(system.stdin:read() == nil,
                "read after read_until EOF did not stay at EOF")
    completed = true
    return nil
  end)
  async.loop()
  local failed, err? = main_task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(completed and main_task:status():has_succeeded(),
              "delimiter across chunks task did not complete")
end

function exercise_partial_read_inheritance(file_path: value, program_path: value)
  local path = file_path as string
  local prog = program_path as string
  local full_input = strings.rep("0123456789abcdef\0\r\n!", 7500)
  local saved_stdin = ffi.titan_test_dup_fd(0)
  test.assert(saved_stdin >= 0, "could not save stdin for partial inheritance")
  defer ffi.titan_test_restore_fd(saved_stdin, 0)
  local completed = false
  local main_task = async.run<|nil, value|>(function (): nil
    fs.write_file(path, full_input)
    test.assert(ffi.titan_test_open_file_onto_fd(path, 0, 0) == 0,
                "could not open partial inheritance file onto stdin")
    test.assert(system.stdin:kind() == "file" and not system.stdin:is_tty(),
                "partial inheritance stdin was not classified as file")
    system.stdin:close()

    -- First verify kind/is_tty/close alone consumed 0 bytes by reading the first chunk.
    local first_chunk? = system.stdin:read()
    test.assert(first_chunk ~= nil, "first partial read returned EOF")
    local prefix = first_chunk as string
    test.assert(#prefix > 0 and #prefix < #full_input,
                "first read did not return a single partial chunk: " .. #prefix)
    test.assert(prefix == strings.sub(full_input, 1, #prefix),
                "first partial chunk bytes mismatched")

    local child = system.spawn(
      prog, {"child-inherit", "drain-stdin"}, system.with_parent_stdin)
    test.assert(child.stdin == nil, "inherited stdin exposed a captured endpoint")
    local child_out = child.stdout as system.InputStream
    local child_err = child.stderr as system.InputStream
    local remainder = ""
    for chunk in child_out:read do remainder = remainder .. chunk end
    local err_bytes = ""
    for chunk in child_err:read do err_bytes = err_bytes .. chunk end
    child_out:close()
    child_err:close()
    local status = child:wait()
    test.assert(status.code == 0 and status.signal_number == 0,
                "inheriting child failed: " .. err_bytes)
    test.assert(remainder == strings.sub(full_input, #prefix + 1),
                "inheriting child did not read the exact remainder from descriptor offset")
    test.assert(system.stdin:read() == nil,
                "parent stdin did not observe EOF after child drained remainder")
    completed = true
    return nil
  end)
  async.loop()
  local failed, err? = main_task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(completed and main_task:status():has_succeeded(),
              "partial read inheritance task did not complete")
end

function exercise_runtime_failure_and_reuse(in_path: value, out_path: value)
  local input_file = in_path as string
  local output_file = out_path as string
  local saved_stdin = ffi.titan_test_dup_fd(0)
  local saved_stdout = ffi.titan_test_dup_fd(1)
  test.assert(saved_stdin >= 0 and saved_stdout >= 0, "could not save stdio fds")
  defer do
    ffi.titan_test_restore_fd(saved_stdin, 0)
    ffi.titan_test_restore_fd(saved_stdout, 1)
  end
  test.assert(ffi.titan_test_open_file_onto_fd(input_file, 0, 0) == 0, "open r1 stdin")
  test.assert(ffi.titan_test_open_file_onto_fd(output_file, 1, 1) == 0, "open r1 stdout")

  local marker: value = {["fatal-runtime"] = "drain-writes"}
  local source_trace = "runtime failure write drain origin"
  local task1 = async.run<|nil, value|>(function (): nil
    test.assert(system.stdin:read_until("|", true) == "R1_HEAD", "r1 read_until failed")
    local cells, _workers = hold_workers()
    defer ffi.titan_test_worker_gate_release(cells as foreign *void)
    local gate1: (function (nil): ())? = nil
    local gate2: (function (nil): ())? = nil
    local w1 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) gate1 = resolve end)
      do system.stdout:write("FATAL-1;") catch end
      return nil
    end)
    local w2 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) gate2 = resolve end)
      do system.stdout:write("FATAL-2;") catch end
      return nil
    end)
    while gate1 == nil or gate2 == nil do async.yield() end
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local r1, r2 = gate1, gate2
      gate1 = nil
      gate2 = nil
      r1(nil)
      r2(nil)
      test.assert(w1:status():as_string() == "waiting" and
                  w2:status():as_string() == "waiting",
                  "fatal test writers did not suspend")
      resolve(nil)
    end)
    ffi.titan_test_worker_gate_release(cells as foreign *void)
    do
      async.await_cleanup<|nil, nil|>(function (_resolve, _reject, fatal)
        fatal(marker, source_trace)
      end)
    catch
    end
    return nil
  end)
  local caught_fatal = false
  do
    async.loop()
  catch
    caught_fatal = error == marker and traceback == source_trace
  end
  test.assert(caught_fatal and task1:status():has_succeeded(),
              "Runtime 1 did not report expected fatal error")

  test.assert(ffi.titan_test_rewind_fd(0) == 0, "could not rewind stdin for Runtime 2")
  local r2_done = false
  local task2 = async.run<|nil, value|>(function (): nil
    test.assert(fs.read_file(output_file) == "FATAL-1;FATAL-2;",
                "Runtime 1 failure did not drain accepted queued writes")
    test.assert(system.stdin:kind() == "file" and system.stdout:kind() == "file",
                "Runtime 2 lost file kind")
    local fresh = ""
    for chunk in system.stdin:read do fresh = fresh .. chunk end
    test.assert(fresh == "R1_HEAD|R1_EXCESS_TAIL",
                "Runtime 2 kept stale excess from Runtime 1: " .. fresh)
    test.assert(system.stdin:read() == nil and system.stdin:read() == nil,
                "Runtime 2 did not reach sticky EOF")
    system.stdout:write("RUNTIME-2-OK;")
    test.assert(fs.read_file(output_file) == "FATAL-1;FATAL-2;RUNTIME-2-OK;",
                "Runtime 2 output did not append after Runtime 1 drained writes")
    r2_done = true
    return nil
  end)
  async.loop()
  local failed2, err2? = task2:status():has_failed()
  if failed2 and err2 ~= nil then err2:raise() end
  test.assert(r2_done and task2:status():has_succeeded(), "Runtime 2 task failed")

  test.assert(ffi.titan_test_rewind_fd(0) == 0, "could not rewind stdin for Runtime 3")
  local r3_done = false
  local task3 = async.run<|nil, value|>(function (): nil
    test.assert(system.stdin:kind() == "file" and system.stdout:kind() == "file",
                "Runtime 3 lost file kind")
    local fresh3 = ""
    for chunk in system.stdin:read do fresh3 = fresh3 .. chunk end
    test.assert(fresh3 == "R1_HEAD|R1_EXCESS_TAIL",
                "Runtime 3 kept sticky EOF from Runtime 2: " .. fresh3)
    test.assert(system.stdin:read() == nil, "Runtime 3 did not reach fresh EOF")
    system.stdout:write("RUNTIME-3-OK;")
    test.assert(fs.read_file(output_file) ==
                "FATAL-1;FATAL-2;RUNTIME-2-OK;RUNTIME-3-OK;",
                "Runtime 3 output did not append after Runtime 2")
    r3_done = true
    return nil
  end)
  async.loop()
  local failed3, err3? = task3:status():has_failed()
  if failed3 and err3 ~= nil then err3:raise() end
  test.assert(r3_done and task3:status():has_succeeded(), "Runtime 3 task failed")
end

function roundtrip_transferred_file_stdio()
  local in_tv = async.TransferValue.from_value(system.stdin)
  local out_tv = async.TransferValue.from_value(system.stdout)
  local err_tv = async.TransferValue.from_value(system.stderr)
  local destination = tlua.new()
  defer destination:close()
  destination:run([[require("os_descriptor_limit_app").exercise_transferred_file_stdio(...)]],
    "=transfer-file-stdio-dest", in_tv, out_tv, err_tv)
end

function exercise_transferred_file_stdio(
    stdin_val: value, stdout_val: value, stderr_val: value)
  local in_stream = stdin_val as system.InputStream
  local out_stream = stdout_val as system.OutputStream
  local err_stream = stderr_val as system.OutputStream
  local done = false
  local task = async.run<|nil, value|>(function (): nil
    test.assert(in_stream:kind() == "file" and not in_stream:is_tty(),
                "transferred file stdin lost kind")
    test.assert(out_stream:kind() == "file" and not out_stream:is_tty(),
                "transferred file stdout lost kind")
    test.assert(err_stream:kind() == "file" and not err_stream:is_tty(),
                "transferred file stderr lost kind")
    local data = ""
    for chunk in in_stream:read do data = data .. chunk end
    test.assert(data == "TRANSFER_FILE_INPUT",
                "transferred file stdin read wrong bytes: " .. data)
    out_stream:write("TRANSFER_FILE_STDOUT:" .. data)
    err_stream:write("TRANSFER_FILE_STDERR")
    done = true
    return nil
  end)
  async.loop()
  local failed, err? = task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(done and task:status():has_succeeded(),
              "transferred file stdio worker failed")
end

local function run_emfile_case(result_path: string): integer
  test.assert(ffi.titan_test_fd_limit_lower() == 0, "could not lower child descriptor soft limit")
  local rejected = false
  do
    system.stdin:read()
  catch
    local restore_status = ffi.titan_test_fd_limit_restore()
    test.assert(restore_status == 0, "could not restore child descriptor soft limit")
    test.assert(error is async.OperationError, "dup failure lost nominal OperationError")
    local failure = error as async.OperationError
    test.assert(failure.name == "EMFILE" and failure.operation == "stdio.parent.duplicate",
                "unexpected descriptor failure: " .. failure.operation .. " " .. failure.name)
    rejected = true
  end
  local restore_status = ffi.titan_test_fd_limit_restore()
  test.assert(restore_status == 0 and ffi.titan_test_fd_limit_restored() == 1,
              "descriptor soft limit was not restored")
  test.assert(rejected, "dup unexpectedly succeeded with descriptor soft limit zero")
  local input = ""
  for chunk in system.stdin:read do input = input .. chunk end
  test.assert(input == "RLIMIT_INPUT_MARKER", "failed duplicate closed original input")
  test.assert(system.stdin:read() == nil, "restored input did not stay at EOF")
  system.stdin:close()
  fs.write_file(result_path, "EMFILE_OK")
  return 0
end

local function run_shell_redirect(args: {string}): integer
  local submode = args[2]
  if submode == "echo-lines" then
    test.assert(not system.stdin:is_tty() and system.stdin:kind() == "file",
                "shell redirected stdin was not file")
    test.assert(not system.stdout:is_tty() and system.stdout:kind() == "file",
                "shell redirected stdout was not file")
    test.assert(not system.stderr:is_tty() and system.stderr:kind() == "file",
                "shell redirected stderr was not file")
    io.print("HEADER")
    for line in io.lines(system.stdin) do
      io.print("LINE:" .. line)
    end
    system.stderr:write("STDERR_LOG\n")
    return 0
  elseif submode == "append" then
    test.assert(system.stdout:kind() == "file", "append stdout was not file")
    io.print(args[3])
    return 0
  elseif submode == "dev-null" then
    test.assert(not system.stdin:is_tty() and system.stdin:kind() == "file",
                "null device stdin was not classified as file")
    test.assert(not system.stdout:is_tty() and system.stdout:kind() == "file",
                "null device stdout was not classified as file")
    test.assert(system.stdin:read() == nil, "null device stdin did not report immediate EOF")
    test.assert(system.stdin:read() == nil, "null device stdin EOF was not sticky")
    system.stdout:write("discarded-to-null")
    io.print("also-discarded")
    fs.write_file(args[3], "DEV_NULL_OK")
    return 0
  elseif submode == "binary-copy" then
    test.assert(system.stdin:kind() == "file" and system.stdout:kind() == "file",
                "binary-copy stdio was not file")
    for chunk in system.stdin:read do
      system.stdout:write(chunk)
    end
    return 0
  end
  raise "unknown shell-redirect submode: " .. submode
end

local function run_child_inherit(args: {string}): integer
  local submode = args[2]
  if submode == "drain-stdin" then
    test.assert(system.stdin:kind() == "file", "inherited stdin was not file")
    for chunk in system.stdin:read do
      system.stdout:write(chunk)
    end
    return 0
  elseif submode == "middle-all" then
    test.assert(system.stdin:kind() == "file" and
                system.stdout:kind() == "file" and
                system.stderr:kind() == "file",
                "inherited all-three stdio was not file")
    local line? = system.stdin:read_until("\n", true)
    test.assert(line ~= nil, "inherited stdin had no line")
    system.stdout:write("CHILD-STDOUT:" .. (line as string) .. "\n")
    system.stderr:write("CHILD-STDERR\n")
    return 0
  end
  raise "unknown child-inherit submode: " .. submode
end

local function run_write_fifo_cancel_gc(workspace: string, result_path: string): integer
  do
    local state = tlua.new()
    defer state:close()
    state:run([[require("os_descriptor_limit_app").exercise_cancelled_worker_gate_acquisition()]],
      "=cancel-worker-gate-acquisition")
  end
  local saved_stdout = ffi.titan_test_dup_fd(1)
  test.assert(saved_stdout >= 0, "could not save stdout")
  defer ffi.titan_test_restore_fd(saved_stdout, 1)

  local fifo_path = workspace .. "/fifo.out"
  test.assert(ffi.titan_test_open_file_onto_fd(fifo_path, 1, 1) == 0, "open fifo.out")
  test.assert(not system.stdout:is_tty() and system.stdout:kind() == "file",
              "fifo stdout was not classified as file")

  -- Empty write is a checked no-op; idle facade transfers cleanly.
  system.stdout:write("")
  test.assert(#fs.read_file(fifo_path) == 0, "empty write modified file")
  async.TransferValue.from_value(system.stdout)

  -- Cancelled before registration: nothing written.
  local pre_reason = async.CancellationReason.simple("cancel-before-write-admission")
  local pre_observed: value = nil
  local pre_task = async.run<|nil, value|>(function (): nil
    async.running():cancel(pre_reason)
    do
      system.stdout:write("MUST_NOT_WRITE")
    catch
      pre_observed = error
    end
    return nil
  end)
  async.join(pre_task)
  test.assert(pre_task:status():has_cancelled() and pre_observed == pre_reason,
              "pre-cancelled write task did not report exact cancellation reason")
  test.assert(#fs.read_file(fifo_path) == 0, "pre-cancelled write wrote bytes")
  async.TransferValue.from_value(system.stdout)

  -- Hold worker threads so w1 is deterministically in flight and w2, w3 are queued.
  local cells, workers = hold_workers()
  defer ffi.titan_test_worker_gate_release(cells as foreign *void)
  local gate1: (function (nil): ())? = nil
  local gate2: (function (nil): ())? = nil
  local gate3: (function (nil): ())? = nil
  local reason_inflight = async.CancellationReason.simple("cancel-inflight-file-write")
  local reason_queued = async.CancellationReason.simple("cancel-queued-file-write")
  local obs1: value = nil
  local obs2: value = nil
  local w3_done = false
  local chunk1 = strings.rep("W1\0\r\n", 4096)
  local chunk2 = strings.rep("W2\0\n\r", 4096)
  local chunk3 = strings.rep("W3\255\0!", 4096)

  local w1 = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) gate1 = resolve end)
    local payload = strings.rep("W1\0\r\n", 4096)
    do system.stdout:write(payload) catch obs1 = error end
    return nil
  end)
  local w2 = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) gate2 = resolve end)
    local payload = strings.rep("W2\0\n\r", 4096)
    do system.stdout:write(payload) catch obs2 = error end
    return nil
  end)
  local w3 = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) gate3 = resolve end)
    local payload = strings.rep("W3\255\0!", 4096)
    system.stdout:write(payload)
    w3_done = true
    return nil
  end)
  while gate1 == nil or gate2 == nil or gate3 == nil do async.yield() end

  async.await<|nil, nil|>(function (resolve, _reject, _fatal)
    local r1, r2, r3 = gate1, gate2, gate3
    gate1, gate2, gate3 = nil, nil, nil
    r1(nil)
    r2(nil)
    r3(nil)
    test.assert(w1:status():as_string() == "waiting" and
                w2:status():as_string() == "waiting" and
                w3:status():as_string() == "waiting",
                "file writers did not park after admission")
    w1:cancel(reason_inflight)
    w2:cancel(reason_queued)
    gc.collect()
    gc.collect()
    test.assert(w1:status():as_string() == "waiting" and
                w2:status():as_string() == "waiting" and
                w3:status():as_string() == "waiting" and
                obs1 == nil and obs2 == nil and not w3_done,
                "cancelled file writes unwound before settlement")
    assert_raises_substring(function ()
      async.TransferValue.from_value(system.stdout)
    end, "stream has pending output")
    resolve(nil)
  end)

  -- Other Tasks stay responsive while file writes are queued and in flight.
  local responsive_turns = 0
  local resp_task = async.run<|nil, value|>(function (): nil
    for _ = 1, 5 do
      responsive_turns = responsive_turns + 1
      async.yield()
    end
    timer.sleep(1)
    return nil
  end)
  async.join(resp_task)
  test.assert(resp_task:status():has_succeeded() and responsive_turns == 5 and
              w1:status():as_string() == "waiting" and
              w2:status():as_string() == "waiting" and
              w3:status():as_string() == "waiting",
              "other Tasks were not responsive while writes were queued")

  release_workers(cells, workers)
  async.join(w1)
  async.join(w2)
  async.join(w3)
  gc.collect()
  test.assert(w1:status():has_cancelled() and obs1 == reason_inflight,
              "in-flight cancelled write lost its exact reason")
  test.assert(w2:status():has_cancelled() and obs2 == reason_queued,
              "queued cancelled write lost its exact reason")
  test.assert(w3:status():has_succeeded() and w3_done,
              "trailing uncancelled write did not succeed")
  test.assert(fs.read_file(fifo_path) == chunk1 .. chunk2 .. chunk3,
              "FIFO write order or completeness failed across cancelled entries")
  async.TransferValue.from_value(system.stdout)

  -- Multi-MiB concurrent Tasks test (16 Tasks * 8 chunks * 16 KiB = 2 MiB)
  local bulk_path = workspace .. "/multi_mib.out"
  test.assert(ffi.titan_test_open_file_onto_fd(bulk_path, 1, 1) == 0, "open multi_mib.out")
  local expected_chunks: {string} = {}
  local writers: {async.Task<|nil, value|>} = {}
  for task_id = 1, 16 do
    writers[task_id] = async.run<|nil, value|>(function (): nil
      for step = 1, 8 do
        local tag = strings.format("T%02d-S%02d:", task_id, step)
        local block = strings.rep(tag, 2048)
        expected_chunks[#expected_chunks + 1] = block
        system.stdout:write(block)
      end
      return nil
    end)
  end
  for task_id = 1, 16 do
    async.join(writers[task_id])
    test.assert(writers[task_id]:status():has_succeeded(), "bulk writer failed")
  end
  local builder = strings.writer()
  for index = 1, #expected_chunks do
    builder:write(expected_chunks[index])
  end
  local expected_bulk = builder:drain()
  local actual_bulk = fs.read_file(bulk_path)
  test.assert(#actual_bulk == 2097152 and actual_bulk == expected_bulk,
              "multi-MiB concurrent writes lost order or bytes: " .. #actual_bulk)

  fs.write_file(result_path, "WRITE_FIFO_OK")
  return 0
end

local function run_short_write_and_errors(workspace: string, result_path: string): integer
  local saved_stdout = ffi.titan_test_dup_fd(1)
  test.assert(saved_stdout >= 0, "could not save stdout")
  defer ffi.titan_test_restore_fd(saved_stdout, 1)
  defer ffi.titan_test_fsize_limit_restore()

  -- 1. Read-only file on fd 1 fails with stdio.write, and later entry progresses
  local ro_path = workspace .. "/readonly.txt"
  local rec_path = workspace .. "/recovered.txt"
  fs.write_file(ro_path, "seed")
  test.assert(ffi.titan_test_open_file_onto_fd(ro_path, 0, 1) == 0, "open ro onto fd 1")
  test.assert(system.stdout:kind() == "file", "readonly file stdout was not file")
  local ro_err: async.OperationError? = nil
  do
    system.stdout:write("FAIL_ON_RO")
  catch
    if error is async.OperationError then
      ro_err = error as async.OperationError
    else
      raise
    end
  end
  test.assert(ro_err ~= nil and ro_err.operation == "stdio.write" and ro_err.code < 0,
              "read-only stdout did not raise OperationError(stdio.write)")
  test.assert(ffi.titan_test_open_file_onto_fd(rec_path, 1, 1) == 0, "open rec onto fd 1")
  system.stdout:write("RECOVERED_AFTER_RO_ERR")
  test.assert(fs.read_file(rec_path) == "RECOVERED_AFTER_RO_ERR",
              "later write did not progress after write error")

  -- 2. POSIX RLIMIT_FSIZE short-write continuation (normal + cancelled) and EFBIG
  if ffi.titan_test_fsize_limit_supported() == 1 then
    local sw1_path = workspace .. "/sw1.out"
    local sw2_path = workspace .. "/sw2.out"
    local sw3_path = workspace .. "/sw3.out"

    -- 2a. Short write (4096) then continuation succeeds (total 10000)
    test.assert(ffi.titan_test_open_file_onto_fd(sw1_path, 1, 1) == 0, "open sw1")
    test.assert(ffi.titan_test_fsize_limit_short_write_once(4096) == 0, "short_write_once 1")
    local payload1 = strings.rep("A", 4096) .. strings.rep("B", 5904)
    system.stdout:write(payload1)
    test.assert(ffi.titan_test_fsize_limit_restore() == 0, "restore sw1")
    test.assert(ffi.titan_test_fsize_sigxfsz_count() == 1,
                "expected exactly 1 SIGXFSZ short write in sw1")
    test.assert(fs.read_file(sw1_path) == payload1, "sw1 content mismatch")

    -- 2b. Short write (4096) under Task cancellation still finishes all 10000 bytes
    test.assert(ffi.titan_test_open_file_onto_fd(sw2_path, 1, 1) == 0, "open sw2")
    test.assert(ffi.titan_test_fsize_limit_short_write_once(4096) == 0, "short_write_once 2")
    local payload2 = strings.rep("C", 4096) .. strings.rep("D", 5904)
    local sw_reason = async.CancellationReason.simple("cancel-during-short-write")
    local sw_observed: value = nil
    local sw_gate: (function (nil): ())? = nil
    local sw_writer = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) sw_gate = resolve end)
      do system.stdout:write(payload2) catch sw_observed = error end
      return nil
    end)
    while sw_gate == nil do async.yield() end
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local release = sw_gate
      sw_gate = nil
      release(nil)
      sw_writer:cancel(sw_reason)
      resolve(nil)
    end)
    async.join(sw_writer)
    test.assert(ffi.titan_test_fsize_limit_restore() == 0, "restore sw2")
    test.assert(ffi.titan_test_fsize_sigxfsz_count() == 1,
                "expected 1 SIGXFSZ short write in cancelled sw2")
    test.assert(sw_writer:status():has_cancelled() and sw_observed == sw_reason,
                "cancelled short write did not deliver exact reason")
    test.assert(fs.read_file(sw2_path) == payload2,
                "cancelled short write truncated its remainder")

    -- 2c. Short write (4096) then EFBIG error with queued entry behind it
    test.assert(ffi.titan_test_open_file_onto_fd(sw3_path, 1, 1) == 0, "open sw3")
    test.assert(ffi.titan_test_fsize_limit_efbig(4096) == 0, "efbig limit")
    local payload3 = strings.rep("E", 4096) .. strings.rep("F", 5904)
    local efbig1: async.OperationError? = nil
    local efbig2: async.OperationError? = nil
    local g1: (function (nil): ())? = nil
    local g2: (function (nil): ())? = nil
    local t1 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) g1 = resolve end)
      do system.stdout:write(payload3)
      catch
        if error is async.OperationError then efbig1 = error as async.OperationError
        else raise end
      end
      return nil
    end)
    local t2 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) g2 = resolve end)
      do system.stdout:write("SECOND_AT_LIMIT")
      catch
        if error is async.OperationError then efbig2 = error as async.OperationError
        else raise end
      end
      return nil
    end)
    while g1 == nil or g2 == nil do async.yield() end
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local r1, r2 = g1, g2
      g1, g2 = nil, nil
      r1(nil)
      r2(nil)
      resolve(nil)
    end)
    async.join(t1)
    async.join(t2)
    test.assert(ffi.titan_test_fsize_limit_restore() == 0, "restore sw3")
    test.assert(efbig1 ~= nil and efbig1.operation == "stdio.write" and efbig1.name == "EFBIG",
                "first write at fsize limit did not report EFBIG")
    test.assert(efbig2 ~= nil and efbig2.operation == "stdio.write" and efbig2.name == "EFBIG",
                "queued write after EFBIG did not run")
    test.assert(fs.read_file(sw3_path) == strings.rep("E", 4096),
                "EFBIG did not preserve 4096-byte short-write prefix")
    system.stdout:write(":AFTER_EFBIG")
    test.assert(fs.read_file(sw3_path) == strings.rep("E", 4096) .. ":AFTER_EFBIG",
                "subsequent write after restoring RLIMIT_FSIZE failed")
    -- 2d. Pump callback exception on head entry still drains queued FIFO tail
    for mode = 1, 2 do
      local state = tlua.new()
      defer state:close()
      state:run([[require("os_descriptor_limit_app").exercise_pump_fatal_drains_tail(...)]],
        "=pump-fatal-tail",
        async.TransferValue.is_string(workspace .. "/pump_fatal_" .. mode .. ".out"),
        async.TransferValue.is_boolean(mode == 2))
    end
  end

  -- 3. Linux /dev/full -> ENOSPC
  if ffi.titan_test_fsize_limit_supported() == 1 and fs.stat("/dev/full") ~= nil then
    if ffi.titan_test_open_file_onto_fd("/dev/full", 1, 1) == 0 then
      test.assert(system.stdout:kind() == "file", "/dev/full was not classified as file")
      local full_err: async.OperationError? = nil
      do
        system.stdout:write("WRITE_TO_DEV_FULL")
      catch
        if error is async.OperationError then
          full_err = error as async.OperationError
        else
          raise
        end
      end
      test.assert(full_err ~= nil and full_err.operation == "stdio.write" and
                  full_err.name == "ENOSPC",
                  "/dev/full write did not report stdio.write ENOSPC")
    end
  end

  fs.write_file(result_path, "SHORT_WRITE_AND_ERRORS_OK")
  return 0
end

local function run_read_cancel_sticky_inheritance(
    workspace: string, result_path: string, program_path: string): integer
  local saved_stdin = ffi.titan_test_dup_fd(0)
  local saved_stdout = ffi.titan_test_dup_fd(1)
  local saved_stderr = ffi.titan_test_dup_fd(2)
  test.assert(saved_stdin >= 0 and saved_stdout >= 0 and saved_stderr >= 0,
              "could not save stdio descriptors")
  defer do
    ffi.titan_test_restore_fd(saved_stdin, 0)
    ffi.titan_test_restore_fd(saved_stdout, 1)
    ffi.titan_test_restore_fd(saved_stderr, 2)
  end

  local in_file = workspace .. "/read_test.in"
  fs.write_file(in_file, "READ_CHUNK_PAYLOAD")
  test.assert(ffi.titan_test_open_file_onto_fd(in_file, 0, 0) == 0, "open read_test.in")

  -- 1. kind() outside a Task raises asynchronous operation must be called from an async Task
  async.await<|nil, nil|>(function (resolve, _reject, _fatal)
    assert_raises_substring(function () system.stdin:kind() end, "must be called from an async Task")
    assert_raises_substring(function () system.stdout:kind() end, "must be called from an async Task")
    assert_raises_substring(function () system.stderr:kind() end, "must be called from an async Task")
    resolve(nil)
  end)

  -- 2. Untouched file stdin: kind(), is_tty(), close(), and transfer succeed without starting reads
  test.assert(system.stdin:kind() == "file" and not system.stdin:is_tty(),
              "file stdin kind/is_tty failed")
  system.stdin:close()
  async.TransferValue.from_value(system.stdin)

  -- 3. Cancelled before read submission does not start subscription
  local pre_reason = async.CancellationReason.simple("cancel-before-read-submit")
  local pre_obs: value = nil
  local pre_reader = async.run<|nil, value|>(function (): nil
    async.running():cancel(pre_reason)
    do system.stdin:read() catch pre_obs = error end
    return nil
  end)
  async.join(pre_reader)
  test.assert(pre_reader:status():has_cancelled() and pre_obs == pre_reason,
              "pre-cancelled reader lost reason")
  async.TransferValue.from_value(system.stdin)

  -- 4. In-flight read cancellation + immediate waiter replacement + competing reader rejection + GC
  local cells1, workers1 = hold_workers()
  defer ffi.titan_test_worker_gate_release(cells1 as foreign *void)
  local r_reason = async.CancellationReason.simple("replace-inflight-file-reader")
  local r_obs: value = nil
  local old_reader = async.run<|nil, value|>(function (): nil
    do system.stdin:read() catch r_obs = error end
    return nil
  end)
  wait_until_task_waiting(old_reader, "in-flight file reader")
  assert_raises_substring(function ()
    system.stdin:read()
  end, "stream already has a waiting reader")
  assert_raises_substring(function ()
    async.TransferValue.from_value(system.stdin)
  end, "standard input has active or buffered read state")

  local releaser = async.run<|nil, value|>(function (): nil
    async.join(old_reader)
    gc.collect()
    gc.collect()
    release_workers(cells1, workers1)
    return nil
  end)
  old_reader:cancel(r_reason)
  test.assert(r_obs == nil and old_reader:status():as_string() == "waiting",
              "cancelled file reader unwound before replacement")
  -- The successor reserves the reader immediately before old_reader unwinds.
  local replacement_chunk = system.stdin:read()
  async.join(releaser)
  test.assert(old_reader:status():has_cancelled() and r_obs == r_reason,
              "old file reader lost cancellation reason")
  test.assert(releaser:status():has_succeeded() and
              replacement_chunk == "READ_CHUNK_PAYLOAD",
              "replacement file reader did not receive in-flight chunk once")

  -- 5. Cancelled-read data retention and EOF retention (no replacement waiter at completion)
  test.assert(ffi.titan_test_rewind_fd(0) == 0, "rewind for data retention")
  cancel_and_retain_inflight_read(async.CancellationReason.simple("cancel-retain-data"))
  test.assert(system.stdin:read() == "READ_CHUNK_PAYLOAD",
              "cancelled in-flight read did not retain its completed chunk")

  cancel_and_retain_inflight_read(async.CancellationReason.simple("cancel-retain-eof"))
  test.assert(system.stdin:read() == nil and system.stdin:read() == nil,
              "cancelled in-flight EOF was not retained or sticky")
  test.assert(system.stdin:kind() == "file", "file stdin lost kind after EOF")
  assert_raises_substring(function ()
    async.TransferValue.from_value(system.stdin)
  end, "standard input has active or buffered read state")

  -- 6. Cancelled-read error retention + sticky read error (fresh Runtime in tlua.Lua state)
  do
    local state = tlua.new()
    defer state:close()
    state:run([[require("os_descriptor_limit_app").exercise_cancelled_read_error(...)]],
      "=read-err", async.TransferValue.is_string(workspace .. "/write_only_stdin.tmp"))
  end

  -- 7. Delimiter excess across 64 KiB chunk boundaries and final tail before nil
  do
    local state = tlua.new()
    defer state:close()
    state:run([[require("os_descriptor_limit_app").exercise_delimiter_across_chunks(...)]],
      "=delim-chunks", async.TransferValue.is_string(workspace .. "/delim_chunks.tmp"))
  end

  -- 8. Partial read followed by inherited child reading the remainder
  do
    local state = tlua.new()
    defer state:close()
    state:run([[require("os_descriptor_limit_app").exercise_partial_read_inheritance(...)]],
      "=partial-inherit",
      async.TransferValue.is_string(workspace .. "/partial_inherit.tmp"),
      async.TransferValue.is_string(program_path))
  end

  -- 9. All three file-backed descriptors inherited (ordered parent/child/parent content)
  local inh_in = workspace .. "/inh_all.in"
  local inh_out = workspace .. "/inh_all.out"
  local inh_err = workspace .. "/inh_all.err"
  fs.write_file(inh_in, "CHILD_INPUT_LINE\n")
  test.assert(ffi.titan_test_open_file_onto_fd(inh_in, 0, 0) == 0, "open inh_in")
  test.assert(ffi.titan_test_open_file_onto_fd(inh_out, 1, 1) == 0, "open inh_out")
  test.assert(ffi.titan_test_open_file_onto_fd(inh_err, 1, 2) == 0, "open inh_err")
  system.stdout:write("PARENT-OUT-1\n")
  system.stderr:write("PARENT-ERR-1\n")
  local child = system.spawn(
    program_path, {"child-inherit", "middle-all"},
    system.with_parent_stdin, system.with_parent_stdout, system.with_parent_stderr)
  test.assert(child.stdin == nil and child.stdout == nil and child.stderr == nil,
              "inherited file stdio exposed a captured endpoint")
  local status = child:wait()
  test.assert(status.code == 0 and status.signal_number == 0,
              "all-inherited child did not exit 0")
  system.stdout:write("PARENT-OUT-2\n")
  system.stderr:write("PARENT-ERR-2\n")
  test.assert(fs.read_file(inh_out) ==
              "PARENT-OUT-1\nCHILD-STDOUT:CHILD_INPUT_LINE\nPARENT-OUT-2\n",
              "inherited file stdout lost parent/child/parent ordering")
  test.assert(fs.read_file(inh_err) ==
              "PARENT-ERR-1\nCHILD-STDERR\nPARENT-ERR-2\n",
              "inherited file stderr lost parent/child/parent ordering")

  -- 10. Untouched file-backed facades transfer across states and function in destination
  local tr_in = workspace .. "/tr_file.in"
  local tr_out = workspace .. "/tr_file.out"
  local tr_err = workspace .. "/tr_file.err"
  fs.write_file(tr_in, "TRANSFER_FILE_INPUT")
  test.assert(ffi.titan_test_open_file_onto_fd(tr_in, 0, 0) == 0, "open tr_in")
  test.assert(ffi.titan_test_open_file_onto_fd(tr_out, 1, 1) == 0, "open tr_out")
  test.assert(ffi.titan_test_open_file_onto_fd(tr_err, 1, 2) == 0, "open tr_err")
  do
    local origin = tlua.new()
    defer origin:close()
    origin:run([[require("os_descriptor_limit_app").roundtrip_transferred_file_stdio()]],
      "=transfer-file-stdio")
  end
  test.assert(fs.read_file(tr_out) == "TRANSFER_FILE_STDOUT:TRANSFER_FILE_INPUT",
              "transferred file stdout content mismatched")
  test.assert(fs.read_file(tr_err) == "TRANSFER_FILE_STDERR",
              "transferred file stderr content mismatched")

  fs.write_file(result_path, "READ_CANCEL_STICKY_INHERIT_OK")
  return 0
end

local function run_exit_queued_writes(): integer
  local cells, _workers = hold_workers()
  defer ffi.titan_test_worker_gate_release(cells as foreign *void)
  local g1: (function (nil): ())? = nil
  local g2: (function (nil): ())? = nil
  local g3: (function (nil): ())? = nil
  local w1 = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) g1 = resolve end)
    do system.stdout:write("EXIT-1;") catch end
    return nil
  end)
  local w2 = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) g2 = resolve end)
    do system.stdout:write("EXIT-2;") catch end
    return nil
  end)
  local w3 = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) g3 = resolve end)
    do system.stdout:write("EXIT-3;") catch end
    return nil
  end)
  while g1 == nil or g2 == nil or g3 == nil do async.yield() end
  async.await<|nil, nil|>(function (resolve, _reject, _fatal)
    local r1, r2, r3 = g1, g2, g3
    g1, g2, g3 = nil, nil, nil
    r1(nil)
    r2(nil)
    r3(nil)
    test.assert(w1:status():as_string() == "waiting" and
                w2:status():as_string() == "waiting" and
                w3:status():as_string() == "waiting",
                "exit writers did not park")
    resolve(nil)
  end)
  ffi.titan_test_worker_gate_release(cells as foreign *void)
  system.exit(17)
  return 0
end

local function run_runtime_failure_and_reuse(workspace: string, result_path: string): integer
  local rf_in = workspace .. "/rf_in.txt"
  local rf_out = workspace .. "/rf_out.txt"
  fs.write_file(rf_in, "R1_HEAD|R1_EXCESS_TAIL")
  local state = tlua.new()
  defer state:close()
  state:run([[require("os_descriptor_limit_app").exercise_runtime_failure_and_reuse(...)]],
    "=runtime-failure-reuse",
    async.TransferValue.is_string(rf_in),
    async.TransferValue.is_string(rf_out))
  fs.write_file(result_path, "RUNTIME_FAILURE_REUSE_OK")
  return 0
end

local function run_destructive_state_close(
    workspace: string, result_path: string): integer
  local saved_stdin = ffi.titan_test_dup_fd(0)
  local saved_stdout = ffi.titan_test_dup_fd(1)
  test.assert(saved_stdin >= 0 and saved_stdout >= 0, "could not save stdio")
  defer do
    ffi.titan_test_restore_fd(saved_stdin, 0)
    ffi.titan_test_restore_fd(saved_stdout, 1)
  end
  local in_path = workspace .. "/abandon.in"
  local out_path = workspace .. "/abandon.out"
  fs.write_file(in_path, "ABANDON_INPUT_DATA")
  test.assert(ffi.titan_test_open_file_onto_fd(in_path, 0, 0) == 0, "open abandon.in")
  test.assert(ffi.titan_test_open_file_onto_fd(out_path, 1, 1) == 0, "open abandon.out")

  local cells: owned int[] = foreign int.new_array(4)
  local raw = cells as foreign *void
  ffi.titan_test_worker_gate_init(raw)
  local state = tlua.new()
  state:run([[require("os_descriptor_limit_app").setup_abandoned_state(...)]],
    "=abandon-state", async.TransferValue.is_pointer(raw))
  state:close()

  test.assert(ffi.titan_test_worker_gate_failed(raw) == 0,
              "a Titan/Lua callback ran during destructive state:close()")
  test.assert(ffi.titan_test_fd_is_open(0) == 1 and
              ffi.titan_test_fd_is_open(1) == 1 and
              ffi.titan_test_fd_is_open(2) == 1,
              "destructive state:close() closed a borrowed parent stdio descriptor")
  system.stdout:write("HOST-AFTER-ABANDON;")
  test.assert(fs.read_file(out_path) == "ABANDONED-INFLIGHT;HOST-AFTER-ABANDON;",
              "destructive state:close() did not drain submitted write or failed to drop queued write: " ..
              fs.read_file(out_path))
  fs.write_file(result_path, "DESTRUCTIVE_STATE_CLOSE_OK")
  return 0
end

record PeerTcp
  tcp: uv.tcp_t
  stream: uv.stream_t
  handle: uv.handle_t
  reads: async.BufferedSubscription<|string, integer|>?
end

local function PeerTcp.adopt(fd: integer): PeerTcp
  local tcp = uv.tcp_t.new()
  test.assert(uv.tcp_init(async.current_loop(), tcp) == 0, "peer tcp_init failed")
  test.assert(uv.tcp_open(tcp, uv.os_sock_t.from_integer(fd)) == 0, "peer tcp_open failed")
  return {
    tcp = tcp,
    stream = tcp:as_stream_t(),
    handle = tcp:as_handle_t(),
    reads = nil,
  }
end

local function PeerTcp:close()
  if self.reads ~= nil then
    self.reads:close()
    return
  end
  local handle = self.handle
  if not handle:is_initialized() or uv.is_closing(handle) then return end
  async.await_cleanup<|nil, nil|>(function (resolve, _reject, _fatal)
    uv.close(handle, function (_: uv.handle_t)
      resolve(nil)
    end)
  end)
end

local function PeerTcp:ensure_reads()
  if self.reads ~= nil then return end
  local peer = self
  self.reads = async.BufferedSubscription<|string, integer|>.new(
    function (publish, fail, finish)
      local actions = async.SubscriptionActions<|string|>(
        function ()
          if peer.handle:is_initialized() and not uv.is_closing(peer.handle) then
            uv.read_stop(peer.stream)
          end
        end,
        function (drain)
          drain()
          if peer.handle:is_initialized() and not uv.is_closing(peer.handle) then
            async.await_cleanup<|nil, nil|>(function (resolve, _reject, _fatal)
              uv.close(peer.handle, function (_: uv.handle_t)
                resolve(nil)
              end)
            end)
          end
        end)
      local status = uv.read_start(
        peer.stream,
        function (_: uv.handle_t, size: integer): uv.buf_t
          return uv.buf_t.allocate(size)
        end,
        function (_: uv.stream_t, count: integer, buffer: uv.buf_t?)
          if count == 0 then return end
          if count > 0 then
            publish(buffer:to_string(count))
            return
          end
          uv.read_stop(peer.stream)
          if count == uv.EOF then finish() else fail(count) end
        end)
      if status < 0 then fail(status) end
      return actions
    end)
end

local function PeerTcp:read(): string?
  self:ensure_reads()
  case self.reads:next()
  when item(chunk) then return chunk
  when error(code) then raise "peer TCP read failed: " .. uv.err_name(code)
  when ended() then return nil
  when closed() then return nil
  end
end

local function PeerTcp:read_all(): string
  local writer = strings.writer()
  while true do
    local chunk? = self:read()
    if not chunk then break end
    writer:write(chunk as string)
  end
  return writer:drain()
end

local function PeerTcp:write(data: string)
  if #data == 0 then return end
  local request = uv.write_t.new()
  case async.await<|nil, integer|>(function (resolve, reject, _fatal)
    local status = uv.write_string(request, self.stream, data,
      function (_: uv.write_t, result: integer)
        if result < 0 then reject(result) else resolve(nil) end
      end)
    if status < 0 then reject(status) end
  end)
  when success() then
  when error(code) then raise "peer TCP write failed: " .. uv.err_name(code)
  end
end

local function PeerTcp:shutdown()
  local request = uv.shutdown_t.new()
  case async.await<|nil, integer|>(function (resolve, reject, _fatal)
    local status = uv.shutdown(request, self.stream,
      function (_: uv.shutdown_t, result: integer)
        if result < 0 then reject(result) else resolve(nil) end
      end)
    if status < 0 then reject(status) end
  end)
  when success() then
  when error(code) then raise "peer TCP shutdown failed: " .. uv.err_name(code)
  end
end

local function assert_stdio_operation_error(
    action: function (): (), expected_operation: string, label: string)
  local caught = false
  do
    action()
  catch
    test.assert(error is async.OperationError,
                label .. " did not raise OperationError")
    local failure = error as async.OperationError
    test.assert(failure.operation == expected_operation and failure.code < 0,
                label .. " raised unexpected OperationError: " ..
                failure.operation .. ": " .. failure.name)
    caught = true
  end
  test.assert(caught, label .. " unexpectedly succeeded")
end

local function run_tcp_inetd_child(result_path: string, tag: string): integer
  test.assert(not system.stdin:is_tty() and system.stdin:kind() == "tcp",
              "inetd child stdin was not tcp")
  test.assert(not system.stdout:is_tty() and system.stdout:kind() == "tcp",
              "inetd child stdout was not tcp")
  system.stdin:close()
  system.stdout:close()
  test.assert(system.stdin:kind() == "tcp" and system.stdout:kind() == "tcp",
              "closing parent TCP stdio changed kind")

  local req = system.stdin:read_until("<END_REQ>", true)
  test.assert(req == "REQ\0\r\n\255PART1|PART2",
              "inetd child read_until request mismatched")
  local excess_line = system.stdin:read_until("\n", false)
  test.assert(excess_line == "EXCESS_LINE\n",
              "inetd child lost excess after delimiter")

  system.stdout:write("")
  system.stdout:write("RESP_HEAD\0")
  system.stdout:write("RESP_BODY\r\n\255")
  system.stdout:shutdown()
  system.stdout:shutdown()
  assert_stdio_operation_error(
    function () system.stdout:write("LATE_WRITE") end,
    "stdio.write", "TCP stdout write after shutdown")
  assert_stdio_operation_error(
    function () system.stdout:write("") end,
    "stdio.write", "TCP stdout empty write after shutdown")

  local post = system.stdin:read_until("|", true)
  test.assert(post == "POST_SHUTDOWN",
              "inetd child could not read stdin after stdout shutdown")
  local tail = system.stdin:read_until("<MISSING>", true)
  test.assert(tail == "UNTERMINATED_TAIL\0!",
              "inetd child lost final unterminated tail at EOF")
  test.assert(system.stdin:read() == nil and
              system.stdin:read_until("x", true) == nil,
              "inetd child stdin did not keep sticky EOF")
  fs.write_file(result_path, "TCP_INETD_OK:" .. tag)
  return 0
end

local function run_tcp_launchd_child(result_path: string): integer
  test.assert(not system.stdin:is_tty() and system.stdin:kind() == "tcp" and
              not system.stdout:is_tty() and system.stdout:kind() == "tcp" and
              not system.stderr:is_tty() and system.stderr:kind() == "tcp",
              "launchd child stdio was not classified as tcp")
  system.stdin:close()
  system.stdout:close()
  system.stderr:close()
  system.stdout:write("LAUNCHD_STDOUT;")
  system.stderr:write("LAUNCHD_STDERR;")
  system.stdout:shutdown()
  assert_stdio_operation_error(
    function () system.stderr:write("STDERR_AFTER_SHARED_SHUTDOWN") end,
    "stdio.write", "aliased stderr write after stdout shutdown")
  local ack = system.stdin:read_until("!", false)
  test.assert(ack == "PEER_AFTER_LAUNCHD_FIN!",
              "launchd child stdin failed after shared output shutdown")
  test.assert(system.stdin:read() == nil,
              "launchd child stdin did not observe peer EOF")
  fs.write_file(result_path, "TCP_LAUNCHD_OK")
  return 0
end

local function run_tcp_grandchild(args: {string}): integer
  local submode = args[2]
  if submode == "read-line-and-write" then
    test.assert(not system.stdin:is_tty() and system.stdin:kind() == "tcp" and
                not system.stdout:is_tty() and system.stdout:kind() == "tcp" and
                not system.stderr:is_tty() and system.stderr:kind() == "tcp",
                "inherited grandchild stdio was not tcp")
    local line? = system.stdin:read_until("\n", true)
    test.assert(line ~= nil, "inherited grandchild TCP stdin returned EOF")
    system.stdout:write("GC1_OUT:" .. (line as string) .. "\n")
    system.stderr:write("GC1_ERR\n")
    return 0
  elseif submode == "shutdown-stdout" then
    test.assert(system.stdout:kind() == "tcp",
                "inherited grandchild 2 stdout was not tcp")
    system.stdout:write("GC2_FINAL\n")
    system.stdout:shutdown()
    return 0
  end
  raise "unknown tcp-grandchild submode: " .. submode
end

local function run_tcp_inherit_parent(
    result_path: string, program_path: string): integer
  test.assert(not system.stdin:is_tty() and system.stdin:kind() == "tcp" and
              not system.stdout:is_tty() and system.stdout:kind() == "tcp" and
              not system.stderr:is_tty() and system.stderr:kind() == "tcp",
              "inherit parent stdio was not tcp")
  system.stdin:close()
  system.stdout:close()
  system.stderr:close()
  system.stdout:write("PARENT_PRE\n")

  local gc1 = system.spawn(
    program_path, {"tcp-grandchild", "read-line-and-write"},
    system.with_parent_stdin, system.with_parent_stdout, system.with_parent_stderr)
  test.assert(gc1.stdin == nil and gc1.stdout == nil and gc1.stderr == nil,
              "inherited TCP stdio exposed a captured endpoint")
  local status1 = gc1:wait()
  test.assert(status1.code == 0 and status1.signal_number == 0,
              "TCP grandchild 1 failed: " .. status1.code)

  system.stdout:write("PARENT_POST\n")

  local gc2 = system.spawn(
    program_path, {"tcp-grandchild", "shutdown-stdout"},
    system.with_parent_stdout)
  if gc2.stdin then (gc2.stdin as system.OutputStream):close() end
  if gc2.stderr then (gc2.stderr as system.InputStream):close() end
  local status2 = gc2:wait()
  test.assert(status2.code == 0 and status2.signal_number == 0,
              "TCP grandchild 2 failed: " .. status2.code)

  assert_stdio_operation_error(
    function () system.stdout:write("PARENT_AFTER_CHILD_SHUTDOWN") end,
    "stdio.write", "parent write after inherited child shutdown")

  local final_in = system.stdin:read_until("\n", true)
  test.assert(final_in == "AFTER_GC2_FIN_ACK",
              "inherit parent could not read remaining TCP input after child shutdown")
  test.assert(system.stdin:read() == nil,
              "inherit parent did not reach TCP EOF")
  fs.write_file(result_path, "TCP_INHERIT_OK")
  return 0
end

local function wait_tcp_child(pid: integer): integer
  local code = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_wait_child(pid as foreign int, code) == 0,
              "waitpid for TCP stdio child failed")
  return code[0] as integer
end

local function exercise_tcp_inetd_session(
    program_path: string, child_result: string, ipv6: integer, tag: string): boolean
  local peer_fd_out = foreign int.new_array(1)
  local pid_out = foreign int.new_array(1)
  local spawn_status = ffi.titan_test_tcp_stdio_spawn_child(
    program_path, "tcp-inetd-child", child_result, tag,
    ipv6 as foreign int, 0 as foreign int, peer_fd_out, pid_out) as integer
  if ipv6 ~= 0 and spawn_status == -2 then
    return false
  end
  test.assert(spawn_status == 0,
              "could not spawn tcp-inetd-child (" .. tag .. "): " .. spawn_status)
  local peer_fd = peer_fd_out[0] as integer
  local child_pid = pid_out[0] as integer
  local peer = PeerTcp.adopt(peer_fd)
  defer peer:close()

  peer:write("REQ\0\r\n\255PART1")
  peer:write("|PART2<END_REQ>EXCESS_LINE\n")
  local response = peer:read_all()
  test.assert(response == "RESP_HEAD\0RESP_BODY\r\n\255",
              "peer did not receive response + FIN from child shutdown (" .. tag .. "): " .. response)
  peer:write("POST_SHUTDOWN|UNTERMINATED_TAIL\0!")
  peer:shutdown()
  local exit_code = wait_tcp_child(child_pid)
  test.assert(exit_code == 0 and fs.read_file(child_result) == "TCP_INETD_OK:" .. tag,
              "tcp-inetd-child failed (" .. exit_code .. ")")
  return true
end

local function run_tcp_ipv4_session(
    workspace: string, result_path: string, program_path: string): integer
  local child_result = workspace .. "/tcp-inetd-ipv4.result"
  test.assert(exercise_tcp_inetd_session(program_path, child_result, 0, "ipv4"),
              "IPv4 tcp-inetd-child session did not run")
  fs.write_file(result_path, "TCP_IPV4_SESSION_OK")
  return 0
end

local function run_tcp_ipv6_session(
    workspace: string, result_path: string, program_path: string): integer
  local child_result = workspace .. "/tcp-inetd-ipv6.result"
  if not exercise_tcp_inetd_session(program_path, child_result, 1, "ipv6") then
    fs.write_file(result_path, "SKIP:capability: IPv6 loopback unavailable")
    return 0
  end
  fs.write_file(result_path, "TCP_IPV6_SESSION_OK")
  return 0
end

local function run_tcp_launchd_session(
    workspace: string, result_path: string, program_path: string): integer
  local launchd_result = workspace .. "/tcp-launchd.result"
  local peer_fd_out = foreign int.new_array(1)
  local pid_out = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_spawn_child(
    program_path, "tcp-launchd-child", launchd_result, "unused",
    0 as foreign int, 1 as foreign int, peer_fd_out, pid_out) == 0,
    "could not spawn tcp-launchd-child")
  local peer = PeerTcp.adopt(peer_fd_out[0] as integer)
  defer peer:close()
  local combined = peer:read_all()
  test.assert(combined == "LAUNCHD_STDOUT;LAUNCHD_STDERR;",
              "launchd aliased stdout/stderr output mismatched: " .. combined)
  peer:write("PEER_AFTER_LAUNCHD_FIN!")
  peer:shutdown()
  local exit_code = wait_tcp_child(pid_out[0] as integer)
  test.assert(exit_code == 0 and fs.read_file(launchd_result) == "TCP_LAUNCHD_OK",
              "tcp-launchd-child failed (" .. exit_code .. ")")
  fs.write_file(result_path, "TCP_LAUNCHD_SESSION_OK")
  return 0
end

local function run_tcp_inheritance_session(
    workspace: string, result_path: string, program_path: string): integer
  local inherit_result = workspace .. "/tcp-inherit.result"
  local peer_fd_out = foreign int.new_array(1)
  local pid_out = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_spawn_child(
    program_path, "tcp-inherit-parent", inherit_result, program_path,
    0 as foreign int, 1 as foreign int, peer_fd_out, pid_out) == 0,
    "could not spawn tcp-inherit-parent")
  local peer = PeerTcp.adopt(peer_fd_out[0] as integer)
  defer peer:close()
  peer:write("GRANDCHILD_LINE\n")
  local inherited_out = peer:read_all()
  test.assert(inherited_out ==
              "PARENT_PRE\nGC1_OUT:GRANDCHILD_LINE\nGC1_ERR\nPARENT_POST\nGC2_FINAL\n",
              "inherited TCP output mismatched: " .. inherited_out)
  peer:write("AFTER_GC2_FIN_ACK\n")
  peer:shutdown()
  local exit_code = wait_tcp_child(pid_out[0] as integer)
  test.assert(exit_code == 0 and fs.read_file(inherit_result) == "TCP_INHERIT_OK",
              "tcp-inherit-parent failed (" .. exit_code .. ")")
  fs.write_file(result_path, "TCP_INHERITANCE_OK")
  return 0
end

local function run_tcp_read_cancel_and_replace(
    _workspace: string, result_path: string): integer
  local saved_in = ffi.titan_test_dup_fd(0)
  local saved_out = ffi.titan_test_dup_fd(1)
  test.assert(saved_in >= 0 and saved_out >= 0, "save stdio fds for read cancel")
  defer do
    ffi.titan_test_restore_fd(saved_in, 0)
    ffi.titan_test_restore_fd(saved_out, 1)
  end

  local acc = foreign int.new_array(1)
  local peer_raw = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_pair(0 as foreign int, acc, peer_raw) == 0,
              "create tcp pair for read cancel")
  test.assert(ffi.titan_test_tcp_stdio_install_fd(acc[0], 0) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc[0], 1) == 0,
              "install tcp pair onto 0 and 1")
  ffi.titan_test_tcp_stdio_close_fd(acc[0])
  local peer = PeerTcp.adopt(peer_raw[0] as integer)
  defer peer:close()

  test.assert(system.stdin:kind() == "tcp" and system.stdout:kind() == "tcp",
              "read-cancel stdio was not tcp")

  -- 1. Pre-cancelled Tasks submit no read, write, or shutdown
  local pre_r = async.CancellationReason.simple("cancel-before-tcp-op")
  for mode_idx = 1, 3 do
    local obs: value = nil
    local pre_task = async.run<|nil, value|>(function (): nil
      async.running():cancel(pre_r)
      do
        if mode_idx == 1 then
          system.stdin:read()
        elseif mode_idx == 2 then
          system.stdout:write("MUST_NOT_SEND")
        else
          system.stdout:shutdown()
        end
      catch
        obs = error
      end
      return nil
    end)
    async.join(pre_task)
    test.assert(pre_task:status():has_cancelled() and obs == pre_r,
                "pre-cancelled TCP operation " .. mode_idx .. " lost cancellation reason")
  end
  async.TransferValue.from_value(system.stdin)
  async.TransferValue.from_value(system.stdout)

  -- 2. In-flight read cancellation + competing reader rejection + immediate replacement
  local r_reason = async.CancellationReason.simple("replace-tcp-stdin-reader")
  local r_obs: value = nil
  local old_reader = async.run<|nil, value|>(function (): nil
    do system.stdin:read() catch r_obs = error end
    return nil
  end)
  wait_until_task_waiting(old_reader, "TCP old reader")
  assert_raises_substring(function ()
    system.stdin:read()
  end, "stream already has a waiting reader")
  assert_raises_substring(function ()
    async.TransferValue.from_value(system.stdin)
  end, "standard input has active or buffered read state")

  local sender = async.run<|nil, value|>(function (): nil
    async.join(old_reader)
    gc.collect()
    peer:write("REPLACED_TCP_READER_OK")
    peer:shutdown()
    return nil
  end)
  old_reader:cancel(r_reason)
  test.assert(r_obs == nil and old_reader:status():as_string() == "waiting",
              "cancelled TCP reader unwound before replacement")
  local replaced_chunk = system.stdin:read()
  local eof_chunk? = system.stdin:read()
  async.join(sender)
  test.assert(old_reader:status():has_cancelled() and r_obs == r_reason,
              "cancelled TCP reader lost cancellation reason")
  test.assert(replaced_chunk == "REPLACED_TCP_READER_OK" and eof_chunk == nil,
              "replacement TCP reader lost chunk or EOF")

  fs.write_file(result_path, "TCP_READ_CANCEL_REPLACE_OK")
  return 0
end

function exercise_tcp_isolated_shutdown_and_overlap()
  local saved_in = ffi.titan_test_dup_fd(0)
  local saved_out = ffi.titan_test_dup_fd(1)
  test.assert(saved_in >= 0 and saved_out >= 0, "save fds for isolated shutdown")
  defer do
    ffi.titan_test_restore_fd(saved_in, 0)
    ffi.titan_test_restore_fd(saved_out, 1)
  end
  local acc = foreign int.new_array(1)
  local peer_raw = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_pair(0 as foreign int, acc, peer_raw) == 0,
              "create tcp pair for isolated shutdown")
  test.assert(ffi.titan_test_tcp_stdio_install_fd(acc[0], 0) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc[0], 1) == 0,
              "install tcp pair for isolated shutdown")
  ffi.titan_test_tcp_stdio_close_fd(acc[0])
  local peer_fd = peer_raw[0] as integer

  local done = false
  local task = async.run<|nil, value|>(function (): nil
    local peer = PeerTcp.adopt(peer_fd)
    defer peer:close()
    test.assert(system.stdout:kind() == "tcp", "isolated shutdown stdout was not tcp")
    system.stdout:write("BEFORE_OVERLAP_SHUTDOWN;")
    local output_identity = system.stdout:to_transfer_payload()

    local s1_gate: (function (nil): ())? = nil
    local s2_gate: (function (nil): ())? = nil
    local s2_returned = false
    local s1 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) s1_gate = resolve end)
      system.stdout:shutdown()
      return nil
    end)
    local s2 = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal) s2_gate = resolve end)
      system.stdout:shutdown()
      s2_returned = true
      return nil
    end)
    while s1_gate == nil or s2_gate == nil do async.yield() end
    async.await<|nil, nil|>(function (resolve, _reject, _fatal)
      local r1, r2 = s1_gate, s2_gate
      s1_gate, s2_gate = nil, nil
      r1(nil)
      test.assert(s1:status():as_string() == "waiting",
                  "first TCP shutdown task did not park")
      -- C2: shutdown is the sole pending output; transfer must be rejected.
      assert_raises_substring(function ()
        async.TransferValue.from_value(system.stdout)
      end, "stream has pending output")
      test.assert(system.OutputStream.discard_transfer_payload(output_identity) == 0 and
                  s1:status():as_string() == "waiting",
                  "discarding an older parent identity disturbed pending shutdown")
      -- C1: overlapping second shutdown returns immediately while s1 is still waiting.
      r2(nil)
      test.assert(s2_returned and s2:status():has_succeeded() and
                  s1:status():as_string() == "waiting",
                  "overlapping second shutdown did not return immediately while first was waiting")
      resolve(nil)
    end)
    async.join(s1)
    async.join(s2)
    test.assert(s1:status():has_succeeded() and s2:status():has_succeeded(),
                "overlapping TCP shutdown tasks failed")
    local received = peer:read_all()
    test.assert(received == "BEFORE_OVERLAP_SHUTDOWN;",
                "peer did not receive earlier bytes and EOF after overlapping shutdown: " .. received)
    done = true
    return nil
  end)
  async.loop()
  local failed, err? = task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(done and task:status():has_succeeded(),
              "isolated shutdown and overlap task failed")
end

local function run_tcp_backpressure_and_shutdown(
    _workspace: string, result_path: string): integer
  do
    local overlap_state = tlua.new()
    defer overlap_state:close()
    overlap_state:run([[require("os_descriptor_limit_app").exercise_tcp_isolated_shutdown_and_overlap()]],
      "=tcp-isolated-shutdown-overlap")
  end

  local saved_in = ffi.titan_test_dup_fd(0)
  local saved_out = ffi.titan_test_dup_fd(1)
  test.assert(saved_in >= 0 and saved_out >= 0, "save stdio fds for backpressure")
  defer do
    ffi.titan_test_restore_fd(saved_in, 0)
    ffi.titan_test_restore_fd(saved_out, 1)
  end

  local acc = foreign int.new_array(1)
  local peer_raw = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_pair(0 as foreign int, acc, peer_raw) == 0,
              "create tcp pair for backpressure")
  test.assert(ffi.titan_test_tcp_stdio_bound_buffers(acc[0], peer_raw[0], 16384 as foreign int) == 0,
              "bound tcp socket buffers for backpressure")
  test.assert(ffi.titan_test_tcp_stdio_install_fd(acc[0], 0) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc[0], 1) == 0,
              "install tcp pair onto 0 and 1")
  ffi.titan_test_tcp_stdio_close_fd(acc[0])
  local peer = PeerTcp.adopt(peer_raw[0] as integer)
  defer peer:close()

  test.assert(system.stdin:kind() == "tcp" and system.stdout:kind() == "tcp",
              "backpressure stdio was not tcp")

  -- Withhold peer reads while 8 bulk writers (8 * 256 KiB = 2 MiB) plus a
  -- trailing write (cw) and shutdown (cs) submit in deterministic order.
  local expected_chunks: {string} = {}
  local writers: {async.Task<|nil, value|>} = {}
  local b_gates: {(function (nil): ())?} = {}
  local bulk_template = strings.rep("0123456789abcdef\0\r\n\255", 13107)
  for task_id = 1, 8 do
    local block = strings.format("TCP-%02d-BULK:", task_id) .. bulk_template
    expected_chunks[task_id] = block
    writers[task_id] = async.run<|nil, value|>(function (): nil
      async.await<|nil, nil|>(function (resolve, _reject, _fatal)
        b_gates[task_id] = resolve
      end)
      system.stdout:write(block)
      return nil
    end)
  end

  local w_gate: (function (nil): ())? = nil
  local s_gate: (function (nil): ())? = nil
  local w_reason = async.CancellationReason.simple("cancel-accepted-tcp-write")
  local s_reason = async.CancellationReason.simple("cancel-accepted-tcp-shutdown")
  local w_obs: value = nil
  local s_obs: value = nil
  local tail_payload = strings.rep("FINAL_CANCELLED_WRITE\0\r\n", 8192)
  expected_chunks[9] = tail_payload

  local cw = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) w_gate = resolve end)
    local copy = strings.rep("FINAL_CANCELLED_WRITE\0\r\n", 8192)
    do system.stdout:write(copy) catch w_obs = error end
    return nil
  end)
  local cs = async.run<|nil, value|>(function (): nil
    async.await<|nil, nil|>(function (resolve, _reject, _fatal) s_gate = resolve end)
    do system.stdout:shutdown() catch s_obs = error end
    return nil
  end)
  while true do
    local ready = w_gate ~= nil and s_gate ~= nil
    for task_id = 1, 8 do
      if b_gates[task_id] == nil then ready = false end
    end
    if ready then break end
    async.yield()
  end

  async.await<|nil, nil|>(function (resolve, _reject, _fatal)
    for task_id = 1, 8 do
      local release_bulk = b_gates[task_id]
      b_gates[task_id] = nil
      release_bulk(nil)
    end
    local rw, rs = w_gate, s_gate
    w_gate, s_gate = nil, nil
    rw(nil)
    rs(nil)
    resolve(nil)
  end)

  -- Advance several loop turns with peer reads still withheld so any write that
  -- merely deferred its completion callback would settle. Because 2+ MiB exceeds
  -- the bounded socket buffers, the send queue remains non-empty and cw/cs stay
  -- blocked on real kernel TCP backpressure.
  for _ = 1, 5 do async.yield() end
  local queued_before_cancel = ffi.titan_test_tcp_stdio_pending_send_bytes(1 as foreign int) as integer
  test.assert(queued_before_cancel > 0,
              "expected positive pending kernel TCP send bytes under backpressure, got " ..
              queued_before_cancel)
  test.assert(cw:status():as_string() == "waiting" and
              cs:status():as_string() == "waiting",
              "backpressured TCP write/shutdown settled before peer started reading")
  assert_raises_substring(function ()
    async.TransferValue.from_value(system.stdout)
  end, "stream has pending output")

  cw:cancel(w_reason)
  cs:cancel(s_reason)
  gc.collect()
  gc.collect()
  for _ = 1, 5 do async.yield() end
  test.assert(cw:status():as_string() == "waiting" and
              cs:status():as_string() == "waiting" and
              w_obs == nil and s_obs == nil and
              (ffi.titan_test_tcp_stdio_pending_send_bytes(1 as foreign int) as integer) > 0,
              "cancelled backpressured TCP write/shutdown unwound while peer was still not reading")

  -- Now release peer drain and verify all bytes arrive in order followed by EOF.
  local received_all = ""
  local drain_task = async.run<|nil, value|>(function (): nil
    received_all = peer:read_all()
    return nil
  end)
  for task_id = 1, 8 do
    async.join(writers[task_id])
    test.assert(writers[task_id]:status():has_succeeded(), "TCP bulk writer failed")
  end
  async.join(cw)
  async.join(cs)
  async.join(drain_task)
  test.assert(cw:status():has_cancelled() and w_obs == w_reason,
              "cancelled backpressured TCP write lost its cancellation reason")
  test.assert(cs:status():has_cancelled() and s_obs == s_reason,
              "cancelled backpressured TCP shutdown lost its cancellation reason")
  test.assert(drain_task:status():has_succeeded(), "peer drain task failed")

  local builder = strings.writer()
  for index = 1, #expected_chunks do
    builder:write(expected_chunks[index])
  end
  local expected_total = builder:drain()
  test.assert(#received_all == #expected_total and received_all == expected_total,
              "TCP backpressured multi-MiB + cancelled write/shutdown bytes mismatched: " ..
              #received_all .. " vs " .. #expected_total)
  fs.write_file(result_path, "TCP_BACKPRESSURE_SHUTDOWN_OK")
  return 0
end

function exercise_tcp_peer_reset()
  local saved_in = ffi.titan_test_dup_fd(0)
  local saved_out = ffi.titan_test_dup_fd(1)
  test.assert(saved_in >= 0 and saved_out >= 0, "save fds for tcp reset")
  defer do
    ffi.titan_test_restore_fd(saved_in, 0)
    ffi.titan_test_restore_fd(saved_out, 1)
  end
  local acc = foreign int.new_array(1)
  local peer_raw = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_pair(0 as foreign int, acc, peer_raw) == 0,
              "create tcp pair for reset")
  test.assert(ffi.titan_test_tcp_stdio_install_fd(acc[0], 0) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc[0], 1) == 0,
              "install tcp pair for reset")
  ffi.titan_test_tcp_stdio_close_fd(acc[0])
  local peer_fd = peer_raw[0] as integer

  local done = false
  local task = async.run<|nil, value|>(function (): nil
    test.assert(system.stdin:kind() == "tcp" and system.stdout:kind() == "tcp",
                "reset stdio was not tcp")
    test.assert(ffi.titan_test_tcp_stdio_reset_close(peer_fd as foreign int) == 0,
                "reset close peer_fd failed")
    -- Sticky read error on TCP reset (not nil EOF)
    for attempt = 1, 2 do
      assert_stdio_operation_error(
        function () system.stdin:read() end,
        "stdio.read", "TCP stdin read after peer RST attempt " .. attempt)
    end
    -- C1: shutdown after peer reset raises OperationError(stdio.shutdown) with negative code,
    -- and a subsequent shutdown() returns without error.
    assert_stdio_operation_error(
      function () system.stdout:shutdown() end,
      "stdio.shutdown", "TCP stdout shutdown after peer RST")
    system.stdout:shutdown()
    done = true
    return nil
  end)
  async.loop()
  local failed, err? = task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(done and task:status():has_succeeded(), "tcp reset task failed")
end

local function run_tcp_peer_reset(
    _workspace: string, result_path: string): integer
  local reset_state = tlua.new()
  defer reset_state:close()
  reset_state:run([[require("os_descriptor_limit_app").exercise_tcp_peer_reset()]],
    "=tcp-peer-reset")
  fs.write_file(result_path, "TCP_PEER_RESET_OK")
  return 0
end

function exercise_tcp_emfile_and_runtime_reuse()
  local saved_in = ffi.titan_test_dup_fd(0)
  local saved_out = ffi.titan_test_dup_fd(1)
  local saved_err = ffi.titan_test_dup_fd(2)
  test.assert(saved_in >= 0 and saved_out >= 0 and saved_err >= 0,
              "save fds for tcp reuse")
  defer do
    ffi.titan_test_restore_fd(saved_in, 0)
    ffi.titan_test_restore_fd(saved_out, 1)
    ffi.titan_test_restore_fd(saved_err, 2)
  end

  local acc = foreign int.new_array(1)
  local peer_raw = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_pair(0 as foreign int, acc, peer_raw) == 0,
              "create tcp pair for reuse")
  test.assert(ffi.titan_test_tcp_stdio_install_fd(acc[0], 0) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc[0], 1) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc[0], 2) == 0,
              "install tcp pair onto 0, 1, 2")
  ffi.titan_test_tcp_stdio_close_fd(acc[0])
  local peer_fd = peer_raw[0] as integer
  defer ffi.titan_test_tcp_stdio_close_fd(peer_fd as foreign int)

  -- Runtime 1: EMFILE duplicate failure preserves raw descriptors, then works after restore
  local r1_done = false
  local t1 = async.run<|nil, value|>(function (): nil
    test.assert(ffi.titan_test_fd_limit_lower() == 0, "lower fd limit for tcp")
    local emfile_caught = false
    do
      system.stdin:kind()
    catch
      test.assert(ffi.titan_test_fd_limit_restore() == 0, "restore fd limit for tcp")
      test.assert(error is async.OperationError, "tcp EMFILE lost OperationError")
      local failure = error as async.OperationError
      test.assert(failure.operation == "stdio.parent.duplicate" and failure.name == "EMFILE",
                  "unexpected tcp duplicate error: " .. failure.operation .. ": " .. failure.name)
      emfile_caught = true
    end
    test.assert(ffi.titan_test_fd_limit_restore() == 0 and emfile_caught,
                "tcp EMFILE did not trigger")
    test.assert(system.stdin:kind() == "tcp" and system.stdout:kind() == "tcp" and
                system.stderr:kind() == "tcp",
                "tcp stdio failed after restoring fd limit")
    r1_done = true
    return nil
  end)
  async.loop()
  local f1, e1? = t1:status():has_failed()
  if f1 and e1 ~= nil then e1:raise() end
  test.assert(r1_done and t1:status():has_succeeded(), "Runtime 1 tcp task failed")

  local fd_count_baseline = ffi.titan_test_open_fd_count()
  test.assert(fd_count_baseline > 0, "open_fd_count baseline failed")

  -- Runtime 2 & Runtime 3: sequential Runtimes acquire fresh owners, clear excess, and leak 0 fds
  for round = 2, 3 do
    local round_done = false
    local task = async.run<|nil, value|>(function (): nil
      local dup_peer = ffi.titan_test_dup_fd(peer_fd as foreign int)
      test.assert(dup_peer >= 0, "dup peer_fd for round " .. round)
      local peer = PeerTcp.adopt(dup_peer)
      defer peer:close()
      peer:write("R" .. round .. "_HEAD|R" .. round .. "_EXCESS\n")
      test.assert(system.stdin:read_until("|", true) == "R" .. round .. "_HEAD",
                  "Round " .. round .. " read_until prefix mismatched")
      system.stdout:write("R" .. round .. "_OUT;")
      local rest = system.stdin:read_until("\n", true)
      test.assert(rest == "R" .. round .. "_EXCESS",
                  "Round " .. round .. " excess read mismatched")
      -- Leave new excess in facade at end of Runtime 2 to verify Runtime 3 clears it
      if round == 2 then
        peer:write("R2_DONE|LEFTOVER")
        test.assert(system.stdin:read_until("|", true) == "R2_DONE", "R2 leftover setup")
      end
      round_done = true
      return nil
    end)
    async.loop()
    local failed, err? = task:status():has_failed()
    if failed and err ~= nil then err:raise() end
    test.assert(round_done and task:status():has_succeeded(),
                "Runtime " .. round .. " tcp task failed")
    test.assert(ffi.titan_test_fd_is_open(0) == 1 and
                ffi.titan_test_fd_is_open(1) == 1 and
                ffi.titan_test_fd_is_open(2) == 1,
                "Runtime " .. round .. " teardown closed raw TCP parent fd")
    test.assert(ffi.titan_test_open_fd_count() == fd_count_baseline,
                "Runtime " .. round .. " leaked a file descriptor")
  end
end

local function run_tcp_emfile_and_runtime_reuse(
    _workspace: string, result_path: string): integer
  local reuse_state = tlua.new()
  defer reuse_state:close()
  reuse_state:run([[require("os_descriptor_limit_app").exercise_tcp_emfile_and_runtime_reuse()]],
    "=tcp-emfile-runtime-reuse")
  fs.write_file(result_path, "TCP_EMFILE_RUNTIME_REUSE_OK")
  return 0
end

function exercise_transferred_tcp_stdio_dest(
    stdin_val: value, stdout_val: value, stderr_val: value): value
  local in_stream = stdin_val as system.InputStream
  local out_stream = stdout_val as system.OutputStream
  local err_stream = stderr_val as system.OutputStream
  local post_shutdown_tv: async.TransferValue? = nil
  local task = async.run<|nil, value|>(function (): nil
    test.assert(in_stream:kind() == "tcp" and not in_stream:is_tty() and
                out_stream:kind() == "tcp" and not out_stream:is_tty() and
                err_stream:kind() == "tcp" and not err_stream:is_tty(),
                "transferred TCP parent facades lost tcp kind")
    local line = in_stream:read_until("\n", true)
    test.assert(line == "TRANSFER_TCP_IN",
                "transferred TCP stdin read wrong bytes")
    out_stream:write("TRANSFER_TCP_OUT:" .. (line as string) .. ";")
    err_stream:write("TRANSFER_TCP_ERR;")
    out_stream:shutdown()
    test.assert(system.OutputStream.discard_transfer_payload(
      out_stream:to_transfer_payload()) == 0,
      "disposing a TCP parent identity after shutdown failed")
    post_shutdown_tv = async.TransferValue.from_value(out_stream)
    return nil
  end)
  async.loop()
  local failed, err? = task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(post_shutdown_tv ~= nil and task:status():has_succeeded(),
              "transferred TCP stdio dest task failed")
  return post_shutdown_tv as async.TransferValue
end

function exercise_transferred_post_shutdown_tcp_stdout(stdout_val: value)
  local out_stream = stdout_val as system.OutputStream
  local done = false
  local task = async.run<|nil, value|>(function (): nil
    test.assert(out_stream:kind() == "tcp",
                "post-shutdown transferred TCP stdout lost tcp kind")
    assert_stdio_operation_error(
      function () out_stream:write("WRITE_IN_THIRD_STATE_AFTER_SHUTDOWN") end,
      "stdio.write", "post-shutdown transferred TCP stdout write in another state")
    done = true
    return nil
  end)
  async.loop()
  local failed, err? = task:status():has_failed()
  if failed and err ~= nil then err:raise() end
  test.assert(done and task:status():has_succeeded(),
              "post-shutdown transferred TCP stdout check failed")
end

function exercise_tcp_cross_state_transfers()
  local saved_in = ffi.titan_test_dup_fd(0)
  local saved_out = ffi.titan_test_dup_fd(1)
  local saved_err = ffi.titan_test_dup_fd(2)
  test.assert(saved_in >= 0 and saved_out >= 0 and saved_err >= 0,
              "save fds for tcp transfers")
  defer do
    ffi.titan_test_restore_fd(saved_in, 0)
    ffi.titan_test_restore_fd(saved_out, 1)
    ffi.titan_test_restore_fd(saved_err, 2)
  end

  local acc2 = foreign int.new_array(1)
  local peer2_raw = foreign int.new_array(1)
  test.assert(ffi.titan_test_tcp_stdio_pair(0 as foreign int, acc2, peer2_raw) == 0,
              "create tcp pair for transfer")
  test.assert(ffi.titan_test_tcp_stdio_install_fd(acc2[0], 0) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc2[0], 1) == 0 and
              ffi.titan_test_tcp_stdio_install_fd(acc2[0], 2) == 0,
              "install tcp pair onto 0, 1, 2")
  ffi.titan_test_tcp_stdio_close_fd(acc2[0])
  local peer2_fd = peer2_raw[0] as integer

  local tr_done = false
  local tr_task = async.run<|nil, value|>(function (): nil
    local peer = PeerTcp.adopt(peer2_fd)
    defer peer:close()
    peer:write("TRANSFER_TCP_IN\n")

    test.assert(system.stdin:kind() == "tcp" and system.stdout:kind() == "tcp" and
                system.stderr:kind() == "tcp",
                "pre-transfer TCP kind check failed")
    local in_tv = async.TransferValue.from_value(system.stdin)
    local out_tv = async.TransferValue.from_value(system.stdout)
    local err_tv = async.TransferValue.from_value(system.stderr)

    local disposal = tlua.new()
    defer disposal:close()
    local disposed = disposal:run([[
      local input, output, diagnostics = ...
      local os = require("titan.os")
      local async = require("titan.async")
      assert(not pcall(async.current_loop), "disposal state already has a Runtime")
      assert(os.InputStream.discard_transfer_payload(input) == 0)
      assert(os.OutputStream.discard_transfer_payload(output) == 0)
      assert(os.OutputStream.discard_transfer_payload(diagnostics) == 0)
      assert(not pcall(async.current_loop), "TCP identity disposal initialized a Runtime")
      return true
    ]], "=discard-tcp-parent-identities",
      async.TransferValue.is_string(system.stdin:to_transfer_payload()),
      async.TransferValue.is_string(system.stdout:to_transfer_payload()),
      async.TransferValue.is_string(system.stderr:to_transfer_payload()))
    test.assert(disposed:to_value() == true)

    local dest = tlua.new()
    defer dest:close()
    local post_shutdown_tv: async.TransferValue = dest:run(
      [[return require("os_descriptor_limit_app").exercise_transferred_tcp_stdio_dest(...)]],
      "=transfer-tcp-dest", in_tv, out_tv, err_tv)

    local received = peer:read_all()
    test.assert(received == "TRANSFER_TCP_OUT:TRANSFER_TCP_IN;TRANSFER_TCP_ERR;",
                "transferred TCP destination output mismatched: " .. received)

    local third = tlua.new()
    defer third:close()
    third:run(
      [[require("os_descriptor_limit_app").exercise_transferred_post_shutdown_tcp_stdout(...)]],
      "=transfer-tcp-third", post_shutdown_tv)
    tr_done = true
    return nil
  end)
  async.loop()
  local tr_failed, tr_err? = tr_task:status():has_failed()
  if tr_failed and tr_err ~= nil then tr_err:raise() end
  test.assert(tr_done and tr_task:status():has_succeeded(),
              "TCP transfer task failed")
end

local function run_tcp_transfers(
    _workspace: string, result_path: string): integer
  local tr_state = tlua.new()
  defer tr_state:close()
  tr_state:run([[require("os_descriptor_limit_app").exercise_tcp_cross_state_transfers()]],
    "=tcp-cross-state-transfers")
  fs.write_file(result_path, "TCP_TRANSFERS_OK")
  return 0
end

function main(args: {string}): integer
  local mode = args[1]
  if mode == "exit-queued-writes" then
    return run_exit_queued_writes()
  elseif #args == 1 then
    return run_emfile_case(args[1])
  end
  if mode == "shell-redirect" then
    return run_shell_redirect(args)
  elseif mode == "child-inherit" then
    return run_child_inherit(args)
  elseif mode == "write-fifo-cancel-gc" then
    return run_write_fifo_cancel_gc(args[2], args[3])
  elseif mode == "short-write-and-errors" then
    return run_short_write_and_errors(args[2], args[3])
  elseif mode == "read-cancel-sticky-inheritance" then
    return run_read_cancel_sticky_inheritance(args[2], args[3], args[4])
  elseif mode == "exit-queued-writes" then
    return run_exit_queued_writes()
  elseif mode == "runtime-failure-and-reuse" then
    return run_runtime_failure_and_reuse(args[2], args[3])
  elseif mode == "destructive-state-close" then
    return run_destructive_state_close(args[2], args[3])
  elseif mode == "tcp-inetd-child" then
    return run_tcp_inetd_child(args[2], args[3])
  elseif mode == "tcp-launchd-child" then
    return run_tcp_launchd_child(args[2])
  elseif mode == "tcp-grandchild" then
    return run_tcp_grandchild(args)
  elseif mode == "tcp-inherit-parent" then
    return run_tcp_inherit_parent(args[2], args[3])
  elseif mode == "tcp-ipv4-session" then
    return run_tcp_ipv4_session(args[2], args[3], args[4])
  elseif mode == "tcp-ipv6-session" then
    return run_tcp_ipv6_session(args[2], args[3], args[4])
  elseif mode == "tcp-launchd-session" then
    return run_tcp_launchd_session(args[2], args[3], args[4])
  elseif mode == "tcp-inheritance" then
    return run_tcp_inheritance_session(args[2], args[3], args[4])
  elseif mode == "tcp-read-cancel-replace" then
    return run_tcp_read_cancel_and_replace(args[2], args[3])
  elseif mode == "tcp-backpressure-shutdown" then
    return run_tcp_backpressure_and_shutdown(args[2], args[3])
  elseif mode == "tcp-peer-reset" then
    return run_tcp_peer_reset(args[2], args[3])
  elseif mode == "tcp-emfile-runtime-reuse" then
    return run_tcp_emfile_and_runtime_reuse(args[2], args[3])
  elseif mode == "tcp-transfers" then
    return run_tcp_transfers(args[2], args[3])
  end
  raise "unknown os_descriptor_limit_app mode: " .. mode
end
