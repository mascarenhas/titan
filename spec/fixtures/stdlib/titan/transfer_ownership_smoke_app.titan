local async = import "async"
local gc = import "gc"
local test = import "test"
local thread = import "thread"
local transfer = import "transfer"
foreign import "titan/ffi.h"

record SmokeEnvelope
  const id: integer
  const reply: thread.Sender<|integer|>
end

record SmokeDuplicatePair
  left: (thread.Sender<|integer|>)?
  right: (thread.Sender<|integer|>)?
end

record SmokeMalformedClaim
  local tx: (thread.Sender<|integer|>)?
  local mode: string
end

local function expect_raises(action: function (): ())
  local caught = false
  do
    action()
  catch
    caught = true
  end
  test.assert(caught, "expected operation to raise")
end

function SmokeMalformedClaim:to_transfer_payload(): string
  local sender = self.tx as thread.Sender<|integer|>
  local _idx = sender:to_transfer_payload()
  return self.mode
end

function SmokeMalformedClaim.from_transfer_payload(
    payload: string): SmokeMalformedClaim
  expect_raises(function ()
    thread.Sender<|integer|>.from_transfer_payload("")
  end)
  expect_raises(function ()
    thread.Sender<|integer|>.from_transfer_payload("\255\255\255\255")
  end)
  expect_raises(function ()
    thread.Receiver<|integer|>.from_transfer_payload("\0\0\0\0")
  end)
  if payload == "fail-unclaimed" then
    raise "smoke-abort-after-rejected-claims"
  end
  local adopted = thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
  expect_raises(function ()
    thread.Sender<|integer|>.from_transfer_payload("\0\0\0\0")
  end)
  return { tx = adopted, mode = payload }
end

union SmokeChoice
  empty()
  pair(tx: thread.Sender<|integer|>, rx: thread.Receiver<|integer|>)
end

local function encode_ephemeral_envelope_raw(
    id: integer): (foreign *void, thread.Receiver<|integer|>)
  local tx, rx = thread.channel<|integer|>(1)
  return transfer.encode_message(SmokeEnvelope(id, tx)), rx
end

local function send_ephemeral_envelope(
    handle: foreign *void,
    id: integer): thread.Receiver<|integer|>
  local tx, rx = thread.channel<|integer|>(1)
  async.send(handle, SmokeEnvelope(id, tx))
  return rx
end

local function encode_closure_raw(
    base: integer): (
    foreign *void,
    thread.Receiver<|integer|>,
    thread.Sender<|integer|>,
    thread.Receiver<|integer|>)
  local rep_tx, rep_rx = thread.channel<|integer|>(1)
  local in_tx, in_rx = thread.channel<|integer|>(1)
  local direct_tx, direct_rx = thread.channel<|integer|>(1)
  local choice = SmokeChoice.pair(rep_tx, in_rx)
  local acc = base
  local fn = function (delta: integer): integer
    acc = acc + delta
    direct_tx:send(acc * 2)
    direct_tx:close()
    case choice
    when pair(tx, rx) then
      local item = rx:receive()
      tx:send(acc + item)
      tx:close()
      rx:close()
    else
      raise "unexpected empty SmokeChoice"
    end
    return acc
  end
  return transfer.encode_message(fn), rep_rx, in_tx, direct_rx
end

local function run_smoke()
  -- 1. Raw encode_message / decode_message / discard_message and duplicate/claim rules.
  local raw1, rx1 = encode_ephemeral_envelope_raw(10)
  defer transfer.discard_message(raw1)
  defer rx1:close()
  gc.collect()
  gc.collect()
  test.assert(not rx1:is_closed(), "encoded packet did not retain attached Sender")
  local top1 = ffi.lua_gettop(L)
  local status1 = transfer.decode_message(L, raw1)
  local val1: value = nil
  if status1 >= 0 then val1 = ffi.lua_totvalue(L, -1) end
  ffi.lua_settop(L, top1)
  if status1 ~= 0 then transfer.raise_message_error(status1, val1) end
  test.assert(raw1 == nil)
  local env1: SmokeEnvelope = val1
  env1.reply:send(env1.id + 100)
  env1.reply:close()
  test.assert(rx1:receive() == 110)
  test.assert(rx1:is_closed())

  local raw2, rx2 = encode_ephemeral_envelope_raw(20)
  defer transfer.discard_message(raw2)
  defer rx2:close()
  gc.collect()
  gc.collect()
  test.assert(not rx2:is_closed())
  transfer.discard_message(raw2)
  raw2 = nil
  transfer.discard_message(nil)
  test.assert(rx2:is_closed(), "discard_message did not release attached Sender")

  -- 1b. Duplicate references in one packet retain independently, and scoped
  -- malformed/wrong-kind/repeated claims are rejected safely.
  local dup_raw, dup_rx = (function (): (foreign *void, thread.Receiver<|integer|>)
    local tx, rx = thread.channel<|integer|>(2)
    return transfer.encode_message(SmokeDuplicatePair(tx, tx)), rx
  end)()
  defer transfer.discard_message(dup_raw)
  defer dup_rx:close()
  gc.collect()
  gc.collect()
  test.assert(not dup_rx:is_closed())
  local top_dup = ffi.lua_gettop(L)
  local status_dup = transfer.decode_message(L, dup_raw)
  local val_dup: value = nil
  if status_dup >= 0 then val_dup = ffi.lua_totvalue(L, -1) end
  ffi.lua_settop(L, top_dup)
  if status_dup ~= 0 then transfer.raise_message_error(status_dup, val_dup) end
  local dup_decoded: SmokeDuplicatePair = val_dup
  dup_decoded.left = nil
  gc.collect()
  gc.collect()
  test.assert(not dup_rx:is_closed(), "dropping first duplicate Sender closed peer early")
  test.assert((dup_decoded.right as thread.Sender<|integer|>):try_send(77))
  dup_decoded.right = nil
  gc.collect()
  gc.collect()
  local ok_dup, v_dup? = dup_rx:try_receive()
  test.assert(ok_dup and v_dup == 77 and dup_rx:is_closed(),
              "dropping second duplicate Sender did not close peer")

  local mal_fail_raw, mal_fail_rx = (function (): (foreign *void, thread.Receiver<|integer|>)
    local tx, rx = thread.channel<|integer|>(1)
    return transfer.encode_message(SmokeMalformedClaim(tx, "fail-unclaimed")), rx
  end)()
  defer transfer.discard_message(mal_fail_raw)
  defer mal_fail_rx:close()
  gc.collect()
  gc.collect()
  local malformed_failed = false
  do
    local top_mf = ffi.lua_gettop(L)
    local status_mf = transfer.decode_message(L, mal_fail_raw)
    local val_mf: value = nil
    if status_mf >= 0 then val_mf = ffi.lua_totvalue(L, -1) end
    ffi.lua_settop(L, top_mf)
    if status_mf ~= 0 then transfer.raise_message_error(status_mf, val_mf) end
  catch
    malformed_failed = true
  end
  test.assert(malformed_failed, "expected malformed attachment decode to raise")
  test.assert(mal_fail_raw == nil and mal_fail_rx:is_closed(),
              "failed decode after rejected malformed claims leaked unclaimed Sender")

  local mal_ok_raw, mal_ok_rx = (function (): (foreign *void, thread.Receiver<|integer|>)
    local tx, rx = thread.channel<|integer|>(1)
    return transfer.encode_message(SmokeMalformedClaim(tx, "adopt-and-reject-repeat")), rx
  end)()
  defer transfer.discard_message(mal_ok_raw)
  defer mal_ok_rx:close()
  gc.collect()
  gc.collect()
  local top_mo = ffi.lua_gettop(L)
  local status_mo = transfer.decode_message(L, mal_ok_raw)
  local val_mo: value = nil
  if status_mo >= 0 then val_mo = ffi.lua_totvalue(L, -1) end
  ffi.lua_settop(L, top_mo)
  if status_mo ~= 0 then transfer.raise_message_error(status_mo, val_mo) end
  local mal_ok: SmokeMalformedClaim = val_mo
  test.assert((mal_ok.tx as thread.Sender<|integer|>):try_send(88))
  mal_ok.tx = nil
  gc.collect()
  gc.collect()
  local ok_mal, v_mal? = mal_ok_rx:try_receive()
  test.assert(ok_mal and v_mal == 88 and mal_ok_rx:is_closed())

  -- 2. Direct nominal policy, protected string decode, and closure capture packet.
  local str_raw = transfer.encode_message("smoke\0string")
  defer transfer.discard_message(str_raw)
  local top_str = ffi.lua_gettop(L)
  local status_str = transfer.decode_message(L, str_raw)
  local val_str: value = nil
  if status_str >= 0 then val_str = ffi.lua_totvalue(L, -1) end
  ffi.lua_settop(L, top_str)
  if status_str ~= 0 then transfer.raise_message_error(status_str, val_str) end
  test.assert(str_raw == nil and (val_str as string) == "smoke\0string")

  local nom_policy = transfer.TransferValue.from_value(SmokeChoice.empty())
  local nom_raw = transfer.encode_message(nom_policy)
  defer transfer.discard_message(nom_raw)
  local top_nom = ffi.lua_gettop(L)
  local status_nom = transfer.decode_message(L, nom_raw)
  local val_nom: value = nil
  if status_nom >= 0 then val_nom = ffi.lua_totvalue(L, -1) end
  ffi.lua_settop(L, top_nom)
  if status_nom ~= 0 then transfer.raise_message_error(status_nom, val_nom) end
  local dec_nom: SmokeChoice = val_nom
  case dec_nom
  when empty() then
  else raise "nominal policy smoke round-trip failed"
  end

  local closure_raw, rep_rx, in_tx, direct_rx = encode_closure_raw(50)
  defer transfer.discard_message(closure_raw)
  defer rep_rx:close()
  defer in_tx:close()
  defer direct_rx:close()
  gc.collect()
  gc.collect()
  test.assert(not rep_rx:is_closed() and not in_tx:is_closed() and not direct_rx:is_closed())
  local top_cl = ffi.lua_gettop(L)
  local status_cl = transfer.decode_message(L, closure_raw)
  local val_cl: value = nil
  if status_cl >= 0 then val_cl = ffi.lua_totvalue(L, -1) end
  ffi.lua_settop(L, top_cl)
  if status_cl ~= 0 then transfer.raise_message_error(status_cl, val_cl) end
  local restored_fn: function (integer): integer = val_cl
  in_tx:send(7)
  local worker = thread.spawn_one(function (cb: function (integer): integer): integer
    return cb(5)
  end, restored_fn)
  test.assert(direct_rx:receive() == 110)
  test.assert(rep_rx:receive() == 62)
  case worker:join()
  when succeeded(total) then test.assert(total == 55)
  else raise "worker thread failed closure packet execution"
  end

  local proxy_worker = thread.spawn(function (): integer
    return 91
  end)
  defer do
    proxy_worker:cancel()
    proxy_worker:join()
  end
  case async.join(proxy_worker:task())
  when succeeded(total) then test.assert(total == 91)
  else raise "worker proxy failed source-free execution"
  end

  -- 3. Eager async.Receiver coalescing replacement, delivery, and close discard.
  local inbox = async.receiver()
  defer inbox:close()
  local first_rx = send_ephemeral_envelope(inbox:handle(), 1)
  defer first_rx:close()
  gc.collect()
  gc.collect()
  test.assert(not first_rx:is_closed())
  local second_rx = send_ephemeral_envelope(inbox:handle(), 2)
  defer second_rx:close()
  gc.collect()
  gc.collect()
  test.assert(first_rx:is_closed(),
              "coalescing send overwrite did not discard replaced packet")
  test.assert(not second_rx:is_closed())

  local env2: SmokeEnvelope = inbox:wait()
  test.assert(env2.id == 2)
  env2.reply:send(202)
  env2.reply:close()
  test.assert(second_rx:receive() == 202)

  local unread_rx = send_ephemeral_envelope(inbox:handle(), 3)
  defer unread_rx:close()
  gc.collect()
  gc.collect()
  test.assert(not unread_rx:is_closed())
  inbox:close()
  inbox:close()
  test.assert(unread_rx:is_closed(),
              "closing Receiver did not discard unread packet")
end

function main(_args: {string}): integer
  local bootstrapped = true
  do
    async.running()
  catch
    bootstrapped = false
  end
  if bootstrapped then
    run_smoke()
  else
    local task = async.run<|nil, value|>(function (): nil
      run_smoke()
      return nil
    end)
    async.loop()
    case task:status()
    when succeeded(_) then
    when failed(failure) then failure:raise()
    else raise "smoke task did not succeed"
    end
  end
  return 0
end
