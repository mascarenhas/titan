-- Runs only against the generated __test_phase5_* uv/net variants.
local lua = foreign import "lua.h"
local net = import "net"
local timer = import "timer"
local uv = import "uv"

local dns_result_delivered = false

local function check(condition: boolean, message: string)
  if not condition then raise message end
end

local function repeat_bytes(seed: string, minimum: integer): string
  local bytes = seed
  while #bytes < minimum do bytes = bytes .. bytes end
  return bytes .. "\0END"
end

local function schedule_buffer_write(connection: net.Connection,
                                     payload: string): uv.Task
  return uv.run(function (): value
    connection:write(payload)
    return "write-result-must-not-win"
  end)
end

local function expect_cancelled(task: uv.Task, reason: string)
  local caught = false
  do
    task:join()
  catch
    local cancelled = error as uv.Cancelled
    check(cancelled.reason == reason, "cancellation reason changed")
    caught = true
  end
  check(caught and task:status() == "cancelled",
        "Task did not finish cancelled")
end

local function wait_for_network_clear()
  local turns = 0
  while (uv.__test_phase5_net_pending() > 0 or
         uv.__test_phase5_tcp_resources() > 0) and turns < 1000 do
    timer.yield()
    turns = turns + 1
  end
  check(uv.__test_phase5_net_pending() == 0,
        "network request owner did not retire")
  check(uv.__test_phase5_tcp_resources() == 0,
        "TCP resource did not close")
end

local function expect_uv_failure(func: () -> value, operation: string)
  local caught = false
  do
    func()
  catch
    local failure = error as uv.Error
    check(failure.code < 0 and failure.operation == operation,
          "synchronous rejection raised the wrong uv.Error")
    caught = true
  end
  check(caught, "synchronous rejection unexpectedly succeeded")
  check(not uv.__test_phase5_sync_rejection_pending(),
        "synchronous rejection hook was not consumed")
end

function schedule_dns_failure_and_cleanup(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_force_next_dns_failure()
  return uv.run(function (): value
    local caught = false
    do
      net.connect("localhost", 80)
    catch
      local failure = error as uv.Error
      check(failure.operation == "net.resolve" and failure.code < 0,
            "forced DNS failure raised the wrong error")
      caught = true
    end
    check(caught, "forced DNS failure unexpectedly connected")
    check(uv.__test_phase5_dns_callbacks() == 1,
          "DNS completion callback count changed")
    check(uv.__test_phase5_dns_release_calls() == 1,
          "DNS result release shim was not called exactly once")
    return "dns-failure-cleaned"
  end)
end

local function check_dns_cancel_cleanup(target: uv.Task,
                                        reason: string,
                                        expected_status: integer)
  expect_cancelled(target, reason)
  wait_for_network_clear()
  check(uv.__test_phase5_dns_submissions() == 1,
        "DNS cancellation did not follow one accepted submission")
  check(uv.__test_phase5_dns_cancel_calls() == 1,
        "DNS cancellation did not call uv_cancel exactly once")
  if expected_status == 0 then
    check(uv.__test_phase5_dns_cancel_status() == 0,
          "successful DNS uv_cancel status was not observed")
  else
    check(uv.__test_phase5_dns_cancel_status() < 0 and
          uv.__test_phase5_dns_cancel_actual_status() < 0,
          "completed DNS request did not report a too-late cancel")
  end
  check(uv.__test_phase5_dns_callbacks() == 1,
        "cancelled DNS did not consume one completion callback")
  local results = uv.__test_phase5_dns_nonnull_results()
  check(results >= 0 and results <= 1,
        "cancelled DNS callback reported an invalid result count")
  check(uv.__test_phase5_dns_release_calls() == results,
        "cancelled DNS did not free each non-null result exactly once")
  check(not dns_result_delivered,
        "cancelled DNS result resumed stale user code")
end

function schedule_inflight_dns_cancel_success(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_cancel_next_dns_inflight()
  dns_result_delivered = false
  local target = uv.run(function (): value
    net.connect("127.0.0.1", 9)
    dns_result_delivered = true
    return "cancelled-dns-result-must-not-win"
  end)
  return uv.run(function (): value
    check_dns_cancel_cleanup(target, "cancel-inflight-dns", 0)
    check(uv.__test_phase5_inflight_dns_observed(),
          "DNS was not cancelled while libuv owned its request")
    return "inflight-dns-cancel-success-ok"
  end)
end

function schedule_late_dns_cancel_failure(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_delay_next_dns_callback(40)
  dns_result_delivered = false
  local target = uv.run(function (): value
    net.connect("127.0.0.1", 9)
    dns_result_delivered = true
    return "late-dns-result-must-not-win"
  end)
  return uv.run(function (): value
    local milliseconds = 0
    while uv.__test_phase5_dns_callbacks() == 0 and milliseconds < 5000 do
      -- Give libuv's worker thread CPU even on a contended 1-core runner.
      -- Counting zero-delay loop turns can exhaust an arbitrary iteration
      -- limit before the worker gets scheduled.
      timer.sleep(5)
      milliseconds = milliseconds + 5
    end
    check(uv.__test_phase5_dns_callbacks() == 1,
          "delayed DNS callback did not arrive exactly once")
    target:cancel("cancel-late-dns")
    lua.lua_gc(L, lua.LUA_GCGEN)
    lua.lua_gc(L, lua.LUA_GCCOLLECT)
    check_dns_cancel_cleanup(target, "cancel-late-dns", -1)
    check(uv.__test_phase5_dns_nonnull_results() == 1 and
          uv.__test_phase5_dns_release_calls() == 1,
          "late DNS callback did not free its addrinfo exactly once")
    return "late-dns-cancel-failure-ok"
  end)
end

function schedule_refused_connect(): uv.Task
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 2)
    local port = net.__test_phase5_bound_port(server)
    server:close()
    local caught = false
    do
      net.connect("127.0.0.1", port)
    catch
      local failure = error as uv.Error
      check(failure.operation == "net.connect" and failure.code < 0,
            "refused connection raised the wrong error")
      caught = true
    end
    check(caught, "connection to a closed loopback port succeeded")
    return "refused-connect-cleaned"
  end)
end

function schedule_cancelled_connect(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_delay_next_connect_callback(30)
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local target = uv.run(function (): value
      return net.connect("127.0.0.1", port)
    end)
    while uv.__test_phase5_connect_callbacks() == 0 do timer.yield() end
    target:cancel("cancel-connect")
    local caught = false
    do
      target:join()
    catch
      local cancelled = error as uv.Cancelled
      check(cancelled.reason == "cancel-connect",
            "connect cancellation reason changed")
      caught = true
    end
    check(caught and target:status() == "cancelled",
          "late successful connect beat cancellation")
    while uv.__test_phase5_net_pending() > 0 do timer.yield() end
    check(uv.__test_phase5_connect_publications() == 0,
          "cancelled unpublished connect became public")
    check(uv.__test_phase5_tcp_close_callbacks() >= 1,
          "cancelled connect handle did not close")
    server:close()
    return "cancelled-connect-cleaned"
  end)
end

function schedule_inflight_connect_cancel_gc(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_cancel_next_connect_inflight()
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local target = uv.run(function (): value
      return net.connect("127.0.0.1", port)
    end)

    expect_cancelled(target, "cancel-inflight-connect")
    check(uv.__test_phase5_inflight_connect_observed(),
          "connect was not cancelled while libuv owned its request")
    while uv.__test_phase5_connect_callbacks() == 0 do timer.yield() end
    check(uv.__test_phase5_connect_callbacks() == 1,
          "in-flight connect did not complete through one physical callback")
    check(uv.__test_phase5_connect_publications() == 0,
          "cancelled in-flight connect published a Connection")
    while uv.__test_phase5_net_pending() > 0 do timer.yield() end
    server:close()
    return "inflight-connect-gc-cancel-ok"
  end)
end

function schedule_write_gc_and_cancel(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_delay_next_write_callback(30)
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local reader = uv.run(function (): value
      local peer = server:accept()
      local data = peer:read_until("\0END", 2 * 1024 * 1024)
      check(#data >= 1024 * 1024, "large write was truncated")
      check(peer:read_exactly(2) == "ok",
            "Connection was unusable after write cancellation")
      peer:close()
      return #data
    end)

    local connection = net.connect("127.0.0.1", port)
    local payload: string? = repeat_bytes("binary\0payload:", 1024 * 1024)
    local expected = #(payload as string)
    local writer = schedule_buffer_write(connection, payload as string)
    payload = nil
    while uv.__test_phase5_write_callbacks() == 0 do timer.yield() end

    lua.lua_gc(L, lua.LUA_GCGEN)
    lua.lua_gc(L, lua.LUA_GCCOLLECT)
    writer:cancel("cancel-write")
    lua.lua_gc(L, lua.LUA_GCSTEP, 0 as lua.lua_Integer)
    local caught = false
    do
      writer:join()
    catch
      local cancelled = error as uv.Cancelled
      check(cancelled.reason == "cancel-write",
            "write cancellation reason changed")
      caught = true
    end
    check(caught and writer:status() == "cancelled",
          "active write result beat cancellation")
    check(uv.__test_phase5_write_callbacks() == 1,
          "active write callback was not consumed once")

    connection:write("ok")
    connection:close()
    check((reader:join() as integer) == expected,
          "reader received the wrong large payload length")
    server:close()
    return "write-gc-cancel-ok"
  end)
end

function schedule_inflight_write_cancel_gc(): uv.Task
  uv.__test_phase5_reset_counters()
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local payload: string? = repeat_bytes("owned-buffer\0", 1024 * 1024)
    local expected_payload = payload as string
    local expected = #expected_payload
    local reader = uv.run(function (): value
      local peer = server:accept()
      local received = peer:read_exactly(expected)
      check(received == expected_payload,
            "cancelled in-flight write lost its physical payload")
      check(peer:read_exactly(2) == "ok",
            "Connection was unusable after in-flight write cancellation")
      peer:close()
      return "inflight-reader-ok"
    end)

    local connection = net.connect("127.0.0.1", port)
    uv.__test_phase5_cancel_next_write_inflight()
    local writer = schedule_buffer_write(connection, payload as string)
    payload = nil
    expect_cancelled(writer, "cancel-inflight-write")
    check(uv.__test_phase5_inflight_write_observed(),
          "write was not cancelled while libuv owned its request/buffer")
    while uv.__test_phase5_write_callbacks() == 0 do timer.yield() end
    check(uv.__test_phase5_write_callbacks() == 1,
          "in-flight write did not complete through one physical callback")

    connection:write("ok")
    check(reader:join() == "inflight-reader-ok",
          "in-flight write reader returned the wrong result")
    connection:close()
    server:close()
    return "inflight-write-gc-cancel-ok"
  end)
end

function schedule_sync_setup_rejections(): uv.Task
  return uv.run(function (): value
    uv.__test_phase5_reset_counters()
    uv.__test_phase5_force_sync_rejection("dns")
    expect_uv_failure(function (): value
      net.connect("127.0.0.1", 9)
      return nil
    end, "net.resolve")
    check(uv.__test_phase5_dns_callbacks() == 0 and
          uv.__test_phase5_dns_release_calls() == 0,
          "synchronously rejected DNS unexpectedly produced a callback/result")
    wait_for_network_clear()

    uv.__test_phase5_reset_counters()
    uv.__test_phase5_force_sync_rejection("tcp-init")
    expect_uv_failure(function (): value
      net.connect("127.0.0.1", 9)
      return nil
    end, "net.tcp.init")
    check(uv.__test_phase5_connect_callbacks() == 0,
          "rejected TCP init unexpectedly reached connect callback")
    wait_for_network_clear()

    uv.__test_phase5_reset_counters()
    uv.__test_phase5_force_sync_rejection("listen")
    expect_uv_failure(function (): value
      net.listen("127.0.0.1", 0, 4)
      return nil
    end, "net.listen")
    check(uv.__test_phase5_connect_callbacks() == 0,
          "rejected listen unexpectedly reached connect callback")
    wait_for_network_clear()

    uv.__test_phase5_reset_counters()
    uv.__test_phase5_force_sync_rejection("connect")
    expect_uv_failure(function (): value
      net.connect("127.0.0.1", 9)
      return nil
    end, "net.connect")
    check(uv.__test_phase5_connect_callbacks() == 0,
          "synchronously rejected connect unexpectedly got a callback")
    wait_for_network_clear()
    return "sync-setup-rejections-ok"
  end)
end

function schedule_sync_stream_rejections(): uv.Task
  return uv.run(function (): value
    uv.__test_phase5_reset_counters()
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local send_reply = false
    local peer_task = uv.run(function (): value
      local peer = server:accept()
      check(peer:read_exactly(2) == "ok",
            "successful write after rejection changed bytes")
      while not send_reply do timer.yield() end
      peer:write("reply")
      check(not peer:read_some(1),
            "peer did not observe close after rejected shutdown")
      peer:close()
      return "sync-stream-peer-ok"
    end)
    local connection = net.connect("127.0.0.1", port)
    -- Leave the successful connect callback so its request owner is no longer
    -- part of the synchronous-rejection accounting below.
    timer.yield()

    uv.__test_phase5_force_sync_rejection("write")
    expect_uv_failure(function (): value
      connection:write("must-not-arrive")
      return nil
    end, "net.write")
    check(uv.__test_phase5_write_callbacks() == 0 and
          uv.__test_phase5_net_pending() == 0,
          "synchronously rejected write retained an owner or got a callback")
    connection:write("ok")
    timer.yield()
    check(uv.__test_phase5_write_callbacks() == 1,
          "Connection did not recover after rejected write")

    local starts = net.__test_phase5_read_starts(connection)
    uv.__test_phase5_force_sync_rejection("read-start")
    expect_uv_failure(function (): value
      connection:read_some(16)
      return nil
    end, "net.read")
    check(net.__test_phase5_read_starts(connection) == starts + 1,
          "synchronous read-start rejection was not exercised exactly once")
    send_reply = true
    check(connection:read_exactly(5) == "reply",
          "Connection did not recover after rejected read-start")
    check(net.__test_phase5_read_starts(connection) == starts + 2,
          "successful retry did not start one new read")

    uv.__test_phase5_force_sync_rejection("shutdown")
    expect_uv_failure(function (): value
      connection:shutdown()
      return nil
    end, "net.shutdown")
    check(uv.__test_phase5_net_pending() == 0,
          "synchronously rejected shutdown retained its request owner")
    connection:close()
    check(peer_task:join() == "sync-stream-peer-ok",
          "sync-rejection peer returned the wrong result")
    server:close()
    return "sync-stream-rejections-ok"
  end)
end

function schedule_shutdown_cancel_after_queue(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_delay_next_write_callback(30)
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local payload = "shielded-shutdown\0payload"
    local peer_saw_eof = false
    local peer_task = uv.run(function (): value
      local peer = server:accept()
      check(peer:read_exactly(#payload) == payload,
            "peer received the wrong pre-shutdown payload")
      check(not peer:read_some(1),
            "peer did not observe the physical write-side shutdown")
      peer_saw_eof = true
      peer:close()
      return "peer-eof"
    end)

    local connection = net.connect("127.0.0.1", port)
    local writer = uv.run(function (): value
      connection:write(payload)
      return "write-complete"
    end)
    -- The physical write callback has happened, but the transformed logical
    -- delivery remains delayed and keeps this write at the FIFO head.
    while uv.__test_phase5_write_callbacks() == 0 do timer.yield() end

    local shutdown_entered = false
    local shutdown_returned = false
    local shutdown = uv.run(function (): value
      shutdown_entered = true
      connection:shutdown()
      shutdown_returned = true
      return "shutdown-result-must-not-win"
    end)
    while not shutdown_entered or shutdown:status() == "ready" do
      timer.yield()
    end
    check(shutdown:status() == "waiting",
          "shutdown did not queue behind the delayed write")

    shutdown:cancel("cancel-shielded-shutdown")
    check(shutdown:status() == "waiting",
          "cleanup-shielded shutdown delivered cancellation too early")
    local write_rejected = false
    do
      connection:write("late")
    catch
      write_rejected = true
    end
    check(write_rejected,
          "write after queued shutdown unexpectedly succeeded")

    local caught = false
    do
      shutdown:join()
    catch
      local cancelled = error as uv.Cancelled
      check(cancelled.reason == "cancel-shielded-shutdown",
            "shielded shutdown cancellation reason changed")
      caught = true
    end
    check(caught and shutdown:status() == "cancelled",
          "shielded shutdown did not finish cancelled")
    check(shutdown_returned,
          "cancellation won before physical shutdown completion")
    check(writer:join() == "write-complete",
          "delayed write did not complete before shutdown")
    check(peer_task:join() == "peer-eof" and peer_saw_eof,
          "peer EOF was not observed after physical shutdown")

    connection:close()
    server:close()
    return "shielded-shutdown-cancel-ok"
  end)
end

function schedule_reset_terminal_read(): uv.Task
  uv.__test_phase5_reset_counters()
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    local connected = false
    local resetter = uv.run(function (): value
      local peer = server:accept()
      -- Accept may run before the client connect callback publishes its
      -- Connection. Reset only after net.connect has returned so this tests a
      -- sticky read-terminal error rather than a failed acquisition.
      while not connected do timer.yield() end
      net.__test_phase5_reset(peer)
      return nil
    end)
    local connection = net.connect("127.0.0.1", port)
    connected = true
    local first_name = ""
    do
      connection:read_some(1)
    catch
      local failure = error as uv.Error
      check(failure.code < 0 and failure.name ~= "EOF",
            "reset was normalized to EOF")
      first_name = failure.name
    end
    check(#first_name > 0, "reset read unexpectedly succeeded")
    local starts = net.__test_phase5_read_starts(connection)
    do
      connection:read_some(1)
    catch
      local failure = error as uv.Error
      check(failure.name == first_name,
            "stored read terminal error changed")
    end
    check(net.__test_phase5_read_starts(connection) == starts,
          "terminal read attempted uv_read_start again")
    connection:close()
    resetter:join()
    server:close()
    return "reset-terminal-ok"
  end)
end

local function connected_pair(): (net.Server, net.Connection, net.Connection)
  local server = net.listen("127.0.0.1", 0, 4)
  local port = net.__test_phase5_bound_port(server)
  local acceptor = uv.run(function (): value
    return server:accept()
  end)
  local client = net.connect("127.0.0.1", port)
  local peer = acceptor:join() as net.Connection
  return server, client, peer
end

function schedule_dispatch_dns_after_free(): uv.Task
  uv.__test_phase5_reset_counters()
  uv.__test_phase5_fail_next_dispatch("dns-after-free")
  return uv.run(function (): value
    net.connect("127.0.0.1", 9)
    raise "DNS dispatcher fault returned to user code"
    return nil
  end)
end

function schedule_dispatch_unpublished_connect(): uv.Task
  return uv.run(function (): value
    local server = net.listen("127.0.0.1", 0, 4)
    local port = net.__test_phase5_bound_port(server)
    -- Close the listener first so the injected connect callback owns exactly
    -- one unpublished TCP handle and cannot race an accepted peer handle.
    server:close()
    uv.__test_phase5_reset_counters()
    uv.__test_phase5_fail_next_dispatch("connect-before-publish")
    net.connect("127.0.0.1", port)
    raise "connect dispatcher fault published its Connection"
    return nil
  end)
end

function schedule_dispatch_published_write(): uv.Task
  return uv.run(function (): value
    local server, client, peer = connected_pair()
    server:close()
    uv.__test_phase5_reset_counters()
    uv.__test_phase5_fail_next_dispatch("write-before-unlink")
    client:write("dispatcher-write")
    peer:close()
    raise "write dispatcher fault returned to user code"
    return nil
  end)
end

function schedule_dispatch_tcp_read(): uv.Task
  return uv.run(function (): value
    local server, client, peer = connected_pair()
    server:close()
    uv.__test_phase5_reset_counters()
    uv.__test_phase5_fail_next_dispatch("tcp-read-after-root-clear")
    uv.run(function (): value
      peer:write("R")
      return nil
    end)
    client:read_exactly(1)
    raise "read dispatcher fault returned to user code"
    return nil
  end)
end

function schedule_dispatch_tcp_close(): uv.Task
  return uv.run(function (): value
    local server, client, peer = connected_pair()
    peer:close()
    server:close()
    uv.__test_phase5_reset_counters()
    uv.__test_phase5_fail_next_dispatch("tcp-close-after-terminal")
    client:close()
    raise "close dispatcher fault returned to user code"
    return nil
  end)
end

function counters(): (integer, integer)
  return uv.__test_phase5_net_pending(), uv.__test_phase5_tcp_resources()
end

function runtime_active(): boolean
  return uv.__test_phase5_runtime_active()
end
