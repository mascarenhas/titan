-- Runs only against the generated __test_fs_* uv variant.
local fs = import "fs"
local timer = import "timer"
local uv = import "uv"

local function check(condition: boolean, message: string)
  if not condition then raise message end
end

local function expect_uv_error(func: () -> value,
                               operation: string)
  local caught = false
  do
    func()
  catch
    local failure = error as uv.Error
    check(failure.code < 0, operation .. " did not report a negative status")
    check(failure.operation == operation,
          "expected " .. operation .. ", got " .. failure.operation)
    caught = true
  end
  check(caught, operation .. " unexpectedly succeeded")
end

local function check_balanced(expected: integer, context: string)
  check(uv.__test_fs_submission_count() == expected,
        context .. " submission count changed")
  check(uv.__test_fs_cleanup_count() == expected,
        context .. " cleanup count changed")
  check(uv.__test_fs_current_active() == 0,
        context .. " left an active request")
end

local function test_sync_and_callback_paths(root: string)
  local path = root .. "/sync-and-callback.dat"
  local missing = root .. "/missing-stat-target"
  local file = fs.open(path, "w")

  uv.__test_fs_reset_counters()
  uv.__test_fs_fail_next_submit("fs.write")

  -- A different operation must not consume the exact-name injection. This
  -- missing stat is a normally submitted callback error and still cleans once.
  expect_uv_error(function (): value
    fs.stat(missing)
    return nil
  end, "fs.stat")
  check_balanced(1, "callback error")

  -- The matching operation fails synchronously without fabricating a callback.
  expect_uv_error(function (): value
    file:write("not-written")
    return nil
  end, "fs.write")
  check_balanced(2, "synchronous submit error")

  check(file:write("ok") == 2, "File did not recover after submit failure")
  file:close()
  check_balanced(4, "successful write and close")
  check(uv.__test_fs_max_active_per_file() == 1,
        "a File had more than one active request")
end

local function test_partial_write_resubmission(root: string)
  local path = root .. "/partial-write.dat"
  local payload = "abcdefghij"
  local file = fs.open(path, "w")

  uv.__test_fs_reset_counters()
  uv.__test_fs_set_max_write_chunk(3)
  check(file:write(payload) == #payload,
        "partial native writes changed the high-level write result")
  check_balanced(4, "partial-write resubmission")
  check(uv.__test_fs_max_active_per_file() == 1,
        "partial writes overlapped on one File")

  uv.__test_fs_set_max_write_chunk(0)
  file:close()
  check(fs.read_file(path) == payload,
        "partial-write resubmission changed the payload")
  check(uv.__test_fs_current_active() == 0,
        "partial-write verification left an active request")
  check(uv.__test_fs_submission_count() ==
        uv.__test_fs_cleanup_count(),
        "partial-write verification leaked a request cleanup")
end

local function test_whole_file_overflow(root: string)
  uv.__test_fs_reset_counters()
  local caught = false
  do
    fs.read_file(root .. "/overflow-read.dat")
  catch
    check(error == "file is too large to read into a string",
          "whole-file overflow reported the wrong error")
    caught = true
  end
  check(caught, "whole-file overflow guard did not run")
  check(uv.__test_fs_current_active() == 0,
        "whole-file overflow left an active request")
  check(uv.__test_fs_submission_count() ==
        uv.__test_fs_cleanup_count(),
        "whole-file overflow leaked request cleanup")
end

local function test_close_retry(root: string)
  local path = root .. "/close-retry.dat"
  local file = fs.open(path, "w")
  file:write("close")

  uv.__test_fs_reset_counters()
  uv.__test_fs_fail_next_submit("fs.close")
  expect_uv_error(function (): value
    file:close()
    return nil
  end, "fs.close")
  check_balanced(1, "synchronous close error")
  check(not file:is_closed(), "failed close reported the File as closed")

  file:close()
  check(file:is_closed(), "close retry did not close the File")
  check_balanced(2, "close retry")
end

local function test_cancel_before_allocation(root: string)
  local path = root .. "/paused-fifo.dat"
  local file = fs.open(path, "w")

  uv.__test_fs_reset_counters()
  uv.__test_fs_pause_next_file_submission()
  local first = uv.run(function (): value
    return file:write("first")
  end)
  while first:status() == "ready" do timer.yield() end
  check(first:status() == "waiting",
        "the paused File operation did not become current")
  check_balanced(0, "paused current operation")

  local queued = uv.run(function (): value
    return file:write("-cancelled")
  end)
  while queued:status() == "ready" do timer.yield() end
  check(queued:status() == "waiting",
        "the cancellable File operation did not queue")
  queued:cancel("cancel-before-allocation")

  local cancelled = false
  do
    queued:join()
  catch
    local reason = error as uv.Cancelled
    check(reason.reason == "cancel-before-allocation",
          "queued cancellation reason changed")
    cancelled = true
  end
  check(cancelled and queued:status() == "cancelled",
        "queued File operation did not cancel")
  check_balanced(0, "queued cancellation before allocation")

  uv.__test_fs_resume_file_submissions()
  check(uv.__test_fs_current_active() == 1,
        "resume did not submit the paused File operation")
  check((first:join() as integer) == 5,
        "resumed File operation returned the wrong result")
  check_balanced(1, "resumed File operation")
  check(uv.__test_fs_max_active_per_file() == 1,
        "resumed File operation overlapped another request")

  file:close()
  check(fs.read_file(path) == "first",
        "cancelled queued write reached the filesystem")
  check(uv.__test_fs_submission_count() ==
        uv.__test_fs_cleanup_count(),
        "pause/cancel verification leaked a request cleanup")
end

local function test_close_waiter_epoch_change(root: string)
  local file = fs.open(root .. "/close-waiter-epoch.dat", "w")
  file:write("waiters")
  uv.__test_fs_pause_next_file_submission()

  local primary = uv.run(function (): value
    file:close()
    return nil
  end)
  while primary:status() == "ready" do timer.yield() end
  check(primary:status() == "waiting",
        "primary close did not pause before allocation")

  local secondary_completed = false
  local secondary = uv.run(function (): value
    file:close()
    secondary_completed = true
    return nil
  end)
  while secondary:status() == "ready" do timer.yield() end
  check(secondary:status() == "waiting",
        "secondary close did not become a close waiter")

  -- Keep an older zero-timer pending while the physical close runs. Once the
  -- callback marks the File closed and schedules the secondary cleanup drive,
  -- this Task cancels the waiter first and increments its epoch.
  local canceller = uv.run(function (): value
    while not file:is_closed() do timer.yield() end
    secondary:cancel("close-waiter-epoch-change")
    return nil
  end)
  while canceller:status() == "ready" do timer.yield() end
  check(canceller:status() == "waiting",
        "close-waiter canceller did not arm before resume")

  uv.__test_fs_resume_file_submissions()
  primary:join()
  canceller:join()
  local cancelled = false
  do
    secondary:join()
  catch
    local reason = error as uv.Cancelled
    check(reason.reason == "close-waiter-epoch-change",
          "secondary close cancellation reason changed")
    cancelled = true
  end
  check(cancelled and secondary:status() == "cancelled",
        "secondary close did not retain cancellation")
  check(secondary_completed,
        "cleanup drive was lost after the waiter epoch changed")
  check(file:is_closed(), "physical close did not finish for both waiters")
end

local function test_cancelled_finally_closes_two_files(root: string)
  local first = fs.open(root .. "/finally-first.dat", "w")
  local second = fs.open(root .. "/finally-second.dat", "w")
  local entered = false
  local first_closed = false
  local second_closed = false

  local target = uv.run(function (): value
    do
      entered = true
      timer.sleep(1000)
    finally
      first:close()
      first_closed = first:is_closed()
      second:close()
      second_closed = second:is_closed()
    end
    return nil
  end)
  while not entered do timer.yield() end
  target:cancel("two-file-finally")

  local cancelled = false
  do
    target:join()
  catch
    local reason = error as uv.Cancelled
    check(reason.reason == "two-file-finally",
          "two-File cleanup cancellation reason changed")
    cancelled = true
  end
  check(cancelled and target:status() == "cancelled",
        "two-File cleanup Task did not finish cancelled")
  check(first_closed and second_closed and
        first:is_closed() and second:is_closed(),
        "cancellation interrupted sequential File cleanup")
end

local function trigger_dispatcher_catch(root: string)
  local file = fs.open(root .. "/dispatcher-catch.dat", "w")
  -- The dispatch: qualifier is a variant-only extension of the existing fault
  -- selector. It leaves submission untouched, then raises after callback entry
  -- so the trusted fs_dispatch catch owns cleanup and outer File repair.
  uv.__test_fs_fail_next_submit("dispatch:fs.write")
  file:write("callback-failure")
  raise "injected dispatcher failure returned to user code"
end

function main(args: {string}): integer
  local root = args[1]
  if #args > 1 and args[2] == "dispatcher-catch" then
    trigger_dispatcher_catch(root)
    return 1
  end
  test_sync_and_callback_paths(root)
  test_partial_write_resubmission(root)
  test_whole_file_overflow(root)
  test_close_retry(root)
  test_cancel_before_allocation(root)
  test_close_waiter_epoch_change(root)
  test_cancelled_finally_closes_two_files(root)
  return 0
end
