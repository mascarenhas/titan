-- Runs only against the generated __test_phase4_* uv variant.
local lua = foreign import "lua.h"
local fs = import "fs"
local timer = import "timer"
local uv = import "uv"

record YoungReason
  marker: string
end

local sticky_catches = 0
local sticky_owner_before = 0
local sticky_owner_after = 0
local delayed_waiter_resumed = false
local concurrent_failure_observed = false
local fs_result_delivered = false

local function check(condition: boolean, message: string)
  if not condition then raise message end
end

function schedule_completion(): uv.Task
  return uv.run(function (): value
    return "completion-wins"
  end)
end

function schedule_sticky_zero_allocation(): uv.Task
  sticky_catches = 0
  sticky_owner_before = 0
  sticky_owner_after = 0

  local target = uv.run(function (): value
    do
      timer.sleep(1000)
    catch
      local cancelled = error as uv.Cancelled
      check(cancelled.reason == "sticky-zero-allocation",
            "first sticky cancellation reason changed")
      sticky_catches = sticky_catches + 1
    end

    sticky_owner_before = uv.__test_phase4_owner_starts()
    do
      timer.yield()
    catch
      local cancelled = error as uv.Cancelled
      sticky_owner_after = uv.__test_phase4_owner_starts()
      check(cancelled.reason == "sticky-zero-allocation",
            "second sticky cancellation reason changed")
      sticky_catches = sticky_catches + 1
    end
    return "cancelled-return-must-not-win"
  end)

  uv.run(function (): value
    while target:status() == "ready" do timer.yield() end
    target:cancel("sticky-zero-allocation")
    return nil
  end)
  return target
end

function sticky_metrics(): (integer, integer, integer)
  return sticky_catches, sticky_owner_before, sticky_owner_after
end

function schedule_delayed_ticker_cancellation(): uv.Task
  delayed_waiter_resumed = false
  return uv.run(function (): value
    local ticker = timer.ticker(1)
    local target = uv.run(function (): value
      local ticked = ticker:tick()
      delayed_waiter_resumed = true
      return ticked
    end)

    while target:status() == "ready" do timer.yield() end
    check(target:status() == "waiting",
          "Ticker waiter did not arm before cancellation")
    uv.__test_phase4_delay_next_cancel(30)
    target:cancel("delayed-ticker-cancel")

    -- Several recurring callbacks run before cancellation delivery. Detaching
    -- the logical waiter synchronously must suppress every one of them.
    timer.sleep(5)
    check(not delayed_waiter_resumed,
          "detached Ticker waiter resumed before delayed cancellation")

    local caught = false
    do
      target:join()
    catch
      local cancelled = error as uv.Cancelled
      check(cancelled.reason == "delayed-ticker-cancel",
            "delayed Ticker cancellation reason changed")
      caught = true
    end
    check(caught and target:status() == "cancelled",
          "delayed cancellation did not terminalize the waiter")

    local replacement = uv.run(function (): value
      return ticker:tick()
    end)
    check(replacement:join() as boolean,
          "Ticker was not reusable after the cancelled waiter")
    ticker:close()
    return "delayed-ticker-cancellation-ok"
  end)
end

function schedule_concurrent_public_error(): uv.Task
  concurrent_failure_observed = false
  local failed = uv.run(function (): value
    timer.yield()
    raise "phase4-public-task-failure"
    return nil
  end)

  local observer = uv.run(function (): value
    do
      failed:join()
    catch
      check(error == "phase4-public-task-failure",
            "public Task propagated the wrong failure")
      concurrent_failure_observed = true
      return "failure-observed"
    end
    raise "public Task unexpectedly succeeded"
    return nil
  end)

  local independent = uv.run(function (): value
    timer.sleep(5)
    check(concurrent_failure_observed,
          "independent Task ran before the public failure was observed")
    return 41
  end)

  return uv.run(function (): value
    check(observer:join() == "failure-observed",
          "failure observer returned the wrong result")
    check((independent:join() as integer) == 41,
          "independent Task returned the wrong result")
    return "concurrent-public-error-ok"
  end)
end

local function schedule_buffer_write(file: fs.File,
                                     payload: string): uv.Task
  return uv.run(function (): value
    return file:write(payload)
  end)
end

function schedule_cross_generation_graph(root: string): uv.Task
  return uv.run(function (): value
    local file = fs.open(root .. "/cross-generation.dat", "w")
    local ticker = timer.ticker(1000)
    local old_error_task = uv.run(function (): value
      timer.sleep(80)
      do
        fs.stat(root .. "/missing-cross-generation-target")
      catch
        local failure = error as uv.Error
        check(failure.operation == "fs.stat" and failure.code < 0,
              "old Task received the wrong young uv.Error")
        -- The callback has just injected a fresh Error into a Task/coroutine
        -- aged below. Keep using it across a minor collection.
        lua.lua_gc(L, lua.LUA_GCSTEP, 0 as lua.lua_Integer)
        check(failure.operation == "fs.stat" and failure.code < 0,
              "young uv.Error was lost across a minor collection")
        return "young-error-ok"
      end
      raise "missing stat unexpectedly succeeded"
      return nil
    end)

    while old_error_task:status() == "ready" do timer.yield() end
    check(old_error_task:status() == "waiting",
          "error Task did not arm before Runtime aging")

    -- Age the Runtime, parent/error Tasks, recurring timer owner, File, and
    -- sleeping owner before attaching any of the objects below.
    lua.lua_gc(L, lua.LUA_GCGEN)
    lua.lua_gc(L, lua.LUA_GCCOLLECT)
    uv.__test_phase4_reset_fs_counters()
    uv.__test_phase4_delay_next_fs_callback(30)

    local payload: string? =
        "young-buffer:" .. root .. ":shared-tag-continuation"
    local expected_length = #(payload as string)
    -- This Task and its tagged coroutine are created after Runtime aging. Its
    -- closure holds the fresh dynamic buffer; drop the parent copy so the
    -- young continuation graph is the only semantic owner.
    local writer = schedule_buffer_write(file, payload as string)
    payload = nil

    while uv.__test_phase4_fs_physical_callbacks() == 0 do
      timer.yield()
    end
    -- The old Runtime/File now point into a young Task, tagged coroutine,
    -- FsOperation/owner, and write buffer graph while logical delivery waits.
    lua.lua_gc(L, lua.LUA_GCSTEP, 0 as lua.lua_Integer)
    check((writer:join() as integer) == expected_length,
          "young shared-tag writer returned the wrong byte count")
    check(uv.__test_phase4_fs_deliveries() == 1 and
          uv.__test_phase4_fs_cleanups() == 1,
          "young write callback did not deliver and clean exactly once")
    check(old_error_task:join() == "young-error-ok",
          "old Task did not retain its young uv.Error")

    ticker:close()
    file:close()
    return "cross-generation-graph-ok"
  end)
end

function schedule_late_fs_cancellation(path: string,
                                       override_success: boolean): uv.Task
  fs_result_delivered = false
  uv.__test_phase4_reset_fs_counters()
  uv.__test_phase4_delay_next_fs_callback(40)

  local target = uv.run(function (): value
    fs.stat(path)
    fs_result_delivered = true
    return "late-result-must-not-win"
  end)

  local canceller = uv.run(function (): value
    while uv.__test_phase4_fs_physical_callbacks() == 0 do
      timer.yield()
    end

    -- At this point libuv has completed the request, but the test variant has
    -- not delivered it. Age the Runtime/Task/owners, then store a young record
    -- through Task.cancel and force a generational minor collection.
    lua.lua_gc(L, lua.LUA_GCGEN)
    lua.lua_gc(L, lua.LUA_GCCOLLECT)
    local reason: YoungReason? =
        YoungReason.new("young-cross-generation-cancel")
    if override_success then
      uv.__test_phase4_override_next_fs_cancel_success()
    end
    target:cancel(reason)
    reason = nil
    lua.lua_gc(L, lua.LUA_GCSTEP, 0 as lua.lua_Integer)
    return nil
  end)

  return uv.run(function (): value
    canceller:join()
    local caught = false
    do
      target:join()
    catch
      local cancelled = error as uv.Cancelled
      local reason = cancelled.reason as YoungReason
      check(reason.marker == "young-cross-generation-cancel",
            "young cancellation reason was not retained by the old Task")
      caught = true
    end
    check(caught and target:status() == "cancelled",
          "late filesystem cancellation did not win logically")

    while uv.__test_phase4_fs_deliveries() == 0 do timer.yield() end
    check(not fs_result_delivered,
          "late filesystem result resumed a cancelled Task")
    check(uv.__test_phase4_fs_cancel_calls() == 1,
          "active filesystem cancellation did not call uv_cancel once")
    if override_success then
      check(uv.__test_phase4_fs_cancel_status() == 0,
            "overridden successful uv_cancel status was not observed")
    else
      check(uv.__test_phase4_fs_cancel_status() < 0,
            "completed filesystem request did not report too-late cancel")
    end
    check(uv.__test_phase4_fs_cleanups() == 1,
          "late filesystem callback did not clean exactly once")
    if override_success then
      return "late-fs-success-cancellation-ok"
    end
    return "late-fs-too-late-cancellation-ok"
  end)
end
