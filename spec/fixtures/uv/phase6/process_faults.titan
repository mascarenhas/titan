-- Runs only against the isolated __test_phase6_* uv variant.
local os = import "os"
local uv = import "uv"

local function check(condition: boolean, message: string)
  if not condition then raise message end
end

local function read_stdout_all(process: os.Process): string
  local output = ""
  local chunk: string? = process:read_stdout(4096)
  while chunk do
    output = output .. (chunk as string)
    chunk = process:read_stdout(4096)
  end
  return output
end

local function read_stderr_all(process: os.Process): string
  local output = ""
  local chunk: string? = process:read_stderr(4096)
  while chunk do
    output = output .. (chunk as string)
    chunk = process:read_stderr(4096)
  end
  return output
end

local function expect_setup_error(child: string, stage: string): string
  uv.__test_phase6_force_process_failure(stage)
  do
    os.spawn(child, { "exit", "0" })
  catch
    local failure = error as uv.Error
    check(failure.code < 0 and #failure.operation > 0,
          "setup rejection raised the wrong uv.Error")
    check(not uv.__test_phase6_process_fault_pending(),
          "setup rejection did not consume its one-shot fault")
    return failure.operation
  end
  raise "forced process setup rejection unexpectedly succeeded"
  return ""
end

function schedule_setup_failure(child: string, stage: string): uv.Task
  return uv.run(function (): value
    return expect_setup_error(child, stage)
  end)
end

function schedule_missing_executable(child: string): uv.Task
  return uv.run(function (): value
    do
      os.spawn(child .. ".missing", {})
    catch
      local failure = error as uv.Error
      check(failure.operation == "process.spawn" and failure.code < 0,
            "missing executable raised the wrong uv.Error")
      return "missing-executable-cleaned"
    end
    raise "missing executable unexpectedly spawned"
    return nil
  end)
end

function schedule_live_ordering(child: string): uv.Task
  return uv.run(function (): value
    local process = os.spawn(child, { "ready-wait" })
    process:close_stdin()
    check(process:read_stdout(64) == "READY\n",
          "live-order child did not publish READY")
    check(uv.__test_phase6_process_counter("process-close-callbacks") == 0,
          "live Process closed before it exited")
    process:kill("term")
    local status = process:wait()
    check(status.signal == "term" and status.signal_number > 0,
          "live-order child did not retain SIGTERM status")
    check(read_stdout_all(process) == "" and read_stderr_all(process) == "",
          "live-order child left unexpected output")
    check(uv.__test_phase6_process_counter("close-before-exit") == 0,
          "published Process close callback preceded exit callback")
    return "live-ordering-cleaned"
  end)
end

function schedule_write_rejection(child: string): uv.Task
  return uv.run(function (): value
    local process = os.spawn(child, { "echo" })
    uv.__test_phase6_force_process_failure("write")
    local caught = false
    do
      process:write_stdin("must-not-reach-child")
    catch
      local failure = error as uv.Error
      check(failure.operation == "process.stdin.write" and failure.code < 0,
            "write rejection raised the wrong uv.Error")
      caught = true
    end
    check(caught, "forced write rejection unexpectedly succeeded")
    check(uv.__test_phase6_process_requests() == 0,
          "rejected write retained its native request owner")
    process:close_stdin()
    check(read_stdout_all(process) == "",
          "rejected write reached the child")
    check(read_stderr_all(process) == "",
          "write-rejection child wrote stderr")
    check(process:wait().code == 0,
          "write-rejection child did not exit normally")
    return "write-rejection-cleaned"
  end)
end

function schedule_close_transition_failure(child: string): uv.Task
  return uv.run(function (): value
    local process = os.spawn(child, { "wait-eof" })
    uv.__test_phase6_force_process_failure("close")
    local caught = false
    do
      process:close_stdin()
    catch
      local failure = error as uv.Error
      check(failure.operation == "process.stdin.close" and
            failure.code < 0,
            "stdin close transition raised the wrong uv.Error")
      caught = true
    end
    check(caught, "forced stdin close transition unexpectedly succeeded")
    check(uv.__test_phase6_process_requests() == 0,
          "failed stdin close transition retained a native request owner")
    check(read_stdout_all(process) == "EOF:0\n" and
          read_stderr_all(process) == "",
          "failed stdin close transition did not close the child pipe")
    check(process:wait().code == 0,
          "stdin-close child did not exit normally")
    return "stdin-close-transition-cleaned"
  end)
end

function schedule_callback_failure(child: string,
                                   stage: string): uv.Task
  return uv.run(function (): value
    if stage == "exit" or stage == "process-close" then
      local process = os.spawn(child, { "exit", "0" })
      uv.__test_phase6_fail_next_process_callback(stage)
      process:close_stdin()
      process:wait()
    elseif stage == "pipe-close" then
      local process = os.spawn(child, { "wait-eof" })
      uv.__test_phase6_fail_next_process_callback(stage)
      process:close_stdin()
    elseif stage == "pipe-read" then
      local process = os.spawn(child, { "delayed-output" })
      process:close_stdin()
      uv.__test_phase6_fail_next_process_callback(stage)
      process:read_stdout(64)
    elseif stage == "write" then
      local process = os.spawn(child, { "echo" })
      uv.__test_phase6_fail_next_process_callback(stage)
      process:write_stdin("callback-write")
    elseif stage == "grace" then
      local process = os.spawn(child, { "ignore-term" })
      process:close_stdin()
      check(process:read_stdout(64) == "READY\n",
            "grace-callback child did not publish READY")
      uv.__test_phase6_fail_next_process_callback(stage)
      return "grace-child-ready"
    else
      raise "unknown callback failure stage"
    end
    raise "forced process callback failure did not become Runtime-fatal"
    return nil
  end)
end

function schedule_communicate_helper_failure(child: string): uv.Task
  return uv.run(function (): value
    uv.__test_phase6_force_process_failure("write")
    local caught = false
    do
      os.communicate(child, { "echo" }, "helper-write-must-fail")
    catch
      local failure = error as uv.Error
      check(failure.operation == "process.stdin.write" and failure.code < 0,
            "communicate surfaced the wrong helper error")
      caught = true
    end
    check(caught, "communicate hid its forced writer failure")
    check(uv.__test_phase6_process_resources() == 0 and
          uv.__test_phase6_process_requests() == 0,
          "communicate surfaced its helper error before native cleanup")
    check(uv.__test_phase6_process_counter("helper-starts") == 4 and
          uv.__test_phase6_process_counter("helper-completions") == 4 and
          uv.__test_phase6_process_live_helpers() == 0,
          "communicate surfaced its error before every helper completed")
    check(not uv.__test_phase6_process_fault_pending(),
          "communicate left a helper fault pending")

    local output, diagnostics, status =
      os.communicate(child, { "echo" }, "after-helper-cleanup")
    check(output == "after-helper-cleanup" and diagnostics == "" and
          status.code == 0 and not status.signal,
          "communicate was unusable after helper cleanup")
    return "communicate-helper-cleaned"
  end)
end

function schedule_communicate_start_failure(child: string): uv.Task
  return uv.run(function (): value
    uv.__test_phase6_force_process_failure("helper-start")
    local caught = false
    do
      os.communicate(child, { "echo" }, "start-failure-input")
    catch
      local failure = error as uv.Error
      check(failure.operation == "task.start" and failure.code < 0,
            "communicate surfaced the wrong helper-start error")
      caught = true
    end
    check(caught, "communicate hid its helper-start failure")
    check(uv.__test_phase6_process_counter("helper-starts") == 4 and
          uv.__test_phase6_process_counter("helper-completions") == 4 and
          uv.__test_phase6_process_live_helpers() == 0,
          "helper-start failure escaped permanent group observation")
    check(uv.__test_phase6_process_resources() == 0 and
          uv.__test_phase6_process_requests() == 0,
          "helper-start failure surfaced before process cleanup")

    local output, diagnostics, status =
      os.communicate(child, { "echo" }, "after-start-cleanup")
    check(output == "after-start-cleanup" and diagnostics == "" and
          status.code == 0 and not status.signal,
          "communicate was unusable after helper-start cleanup")
    return "communicate-start-cleaned"
  end)
end
