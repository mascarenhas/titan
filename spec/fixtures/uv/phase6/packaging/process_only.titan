local system = import "os"

-- The application imports only os. Its first asynchronous call therefore
-- proves that the canonical os.so -> uv.so dependency installs the standalone
-- main bootstrap without statically linking either implementation here.
function main(args: {string}): integer
  if #args ~= 1 then return 90 end
  local child = args[1]

  local payload = "packaged\0process-data"
  for _ = 1, 14 do payload = payload .. payload end
  local output, diagnostics, status =
    system.communicate(child, { "echo" }, payload)
  if output ~= payload or diagnostics ~= "" then return 91 end
  if status.code ~= 0 or status.signal or status.signal_number ~= 0 then
    return 92
  end

  local exited = system.spawn(child, { "exit", "37" })
  exited:close_stdin()
  if exited:read_stdout(4096) or exited:read_stderr(4096) then return 93 end
  local exit_status = exited:wait()
  if exit_status.code ~= 37 or exit_status.signal or
      exit_status.signal_number ~= 0 then
    return 94
  end
  return 0
end
