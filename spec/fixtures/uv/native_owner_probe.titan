local libuv = foreign import "uv.h"
local lua = foreign import "lua.h"
local ffi = foreign import "titan/ffi.h"
local shim = foreign import "titan/uv.h"
local allocation = foreign import "titan_uv_test_allocation.h"
local coroutine = import "coroutine"

-- Private native-owner lifecycle values.  Public Task/cancellation state is a
-- separate Phase-2 concern and must not become coupled to storage lifetime.
local OWNER_ALLOCATED = 0
local OWNER_ACTIVE = 1
local OWNER_CLOSING = 2
local OWNER_CLOSED = 3
local OWNER_CLEANED = 4

-- Kept in lockstep with enum titan_uvshim_event_kind in titan/uv.h.  Imported
-- enum values are not Titan constant expressions, so these remain literals.
local EVENT_TIMER = 1
local EVENT_HANDLE_CLOSE = 2
local EVENT_FS = 3

-- A private loop owns the userdata that contains its native bytes.  The
-- pointer is never transported through value and is read directly thereafter.
local record Loop
  local handle: *libuv.uv_loop_t
  local storage: value
  local generation: integer
  local state: integer
end

-- Runtime roots callback-owner records by their existing Lua identity.  The
-- map key is dynamic because timer and filesystem owners are distinct nominal
-- types; native handles themselves always stay in exact typed local fields.
local record Runtime
  local loop: Loop
  local generation: integer
  local pending: {value: boolean}
  local resources: {value: boolean}
  local fatal: boolean
  local fatal_error: value
  local fatal_traceback: string
  local callback_count: integer
  local timer_count: integer
  local close_count: integer
  local fs_count: integer
  local task_failure_sequence: integer
  local followup_timer_sequence: integer
  local proof_incremental_paused: boolean
  local proof_layout_valid: boolean
  local proof_allocation_counter_active: boolean
  local proof_access_without_allocation: boolean
  local proof_incremental_buffer_length: integer
end

local record CallbackState
  local runtime: Runtime
  local generation: integer
  local lifecycle: integer
  local cleaned: boolean
  local inject_dispatch_failure: boolean
  local fail_task: boolean
  local fail_task_handler: boolean
  local task_failed: boolean
  local task_error: value
  local task_traceback: string
  local result: integer
  local size: integer
  local probe_role: integer
end

-- Persistent timers cross into the higher-level timer module.  All eight
-- fields are local: only uv can construct one, read its native pointer, or
-- mutate callback state.  The wrapper itself is the native callback owner.
record uv_timer_t
  local handle: *libuv.uv_timer_t -- slot 1 / C index 0
  local storage: value           -- slot 2 / C index 1
  local main_thread: value       -- slot 3 / C index 2
  local module: value            -- slot 4 / C index 3
  local dispatcher: (uv_timer_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> () -- 5/4
  local root: value              -- slot 6 / C index 5
  local metadata: CallbackState  -- slot 7 / C index 6
  local buffer: value            -- slot 8 / C index 7
end

-- Filesystem requests stay wholly inside uv, but use the same fixed layout.
-- Its family-specific dispatcher erases to the same native Udata* ABI while
-- preserving the exact nominal type inside Titan.
local record uv_fs_t
  local handle: *libuv.uv_fs_t
  local storage: value
  local main_thread: value
  local module: value
  local dispatcher: (uv_fs_t, integer, integer, libuv.size_t,
                     ffi.titan_ffi_void_ptr) -> ()
  local root: value
  local metadata: CallbackState
  local buffer: value
end

local record Bytes
  local data: *ffi.titan_ffi_char
  local storage: value
  local length: integer
end

local record Buffer
  local handle: *libuv.uv_buf_t
  local storage: value
  local bytes: Bytes
end

local generation = 0
local active_runtime: Runtime? = nil
local weak_owners: value = nil

local function ensure_weak_owners()
  if weak_owners == nil then
    local top = lua.lua_gettop(L)
    lua.lua_createtable(L, 0, 0)
    lua.lua_createtable(L, 0, 1)
    lua.lua_pushstring(L, "v")
    lua.lua_setfield(L, -2, "__mode")
    lua.lua_setmetatable(L, -2)
    weak_owners = ffi.lua_totvalue(L, -1)
    lua.lua_settop(L, top)
  end
end

local function weak_store(slot: integer, item: value)
  ensure_weak_owners()
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, weak_owners)
  ffi.lua_pushtvalue(L, item)
  lua.lua_rawseti(L, -2, slot as lua.lua_Integer)
  lua.lua_settop(L, top)
end

local function weak_present(slot: integer): boolean
  ensure_weak_owners()
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, weak_owners)
  lua.lua_rawgeti(L, -1, slot as lua.lua_Integer)
  local present = lua.lua_type(L, -1) ~= lua.LUA_TNIL
  lua.lua_settop(L, top)
  return present
end

local function weak_item(slot: integer): value
  ensure_weak_owners()
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, weak_owners)
  lua.lua_rawgeti(L, -1, slot as lua.lua_Integer)
  local item = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return item
end

local function weak_range_present(first: integer, last: integer): boolean
  for slot = first, last do
    if not weak_present(slot) then return false end
  end
  return true
end

local function weak_range_absent(first: integer, last: integer): boolean
  for slot = first, last do
    if weak_present(slot) then return false end
  end
  return true
end

-- Lua userdata payloads have LUAI_MAXALIGN.  TValue is a member of that
-- aligned union, so this comparison rejects a target requiring a fallback
-- allocator instead of silently assuming the payload is sufficiently aligned.
local function check_storage_alignment()
  if libuv.uv_loop_t.alignof > ffi.TValue.alignof or
      libuv.uv_timer_t.alignof > ffi.TValue.alignof or
      libuv.uv_fs_t.alignof > ffi.TValue.alignof or
      libuv.uv_buf_t.alignof > ffi.TValue.alignof then
    raise "libuv requires over-aligned storage on this target"
  end
end

local function main_thread_value(): value
  local top = lua.lua_gettop(L)
  lua.lua_rawgeti(L, lua.LUA_REGISTRYINDEX,
                  lua.LUA_RIDX_MAINTHREAD as lua.lua_Integer)
  local thread = ffi.lua_totvalue(L, -1)
  lua.lua_settop(L, top)
  return thread
end

local function owner_slot_type(owner: value, slot: integer): integer
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, owner)
  lua.lua_getiuservalue(L, -1, slot as ffi.titan_ffi_int)
  local kind = lua.lua_type(L, -1)
  lua.lua_settop(L, top)
  return kind as integer
end

local function owner_layout_is_valid(owner: value): boolean
  return owner_slot_type(owner, 1) == (lua.LUA_TLIGHTUSERDATA as integer) and
         owner_slot_type(owner, 2) == (lua.LUA_TUSERDATA as integer) and
         owner_slot_type(owner, 3) == (lua.LUA_TTHREAD as integer) and
         owner_slot_type(owner, 4) == (lua.LUA_TUSERDATA as integer) and
         owner_slot_type(owner, 5) == (lua.LUA_TFUNCTION as integer) and
         owner_slot_type(owner, 6) == (lua.LUA_TUSERDATA as integer) and
         owner_slot_type(owner, 7) == (lua.LUA_TUSERDATA as integer) and
         owner_slot_type(owner, 8) == (lua.LUA_TUSERDATA as integer)
end

local function timer_owner_pointer(owner: uv_timer_t): ffi.titan_ffi_void_ptr
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  lua.lua_settop(L, top)
  return pointer
end

local function fs_owner_pointer(owner: uv_fs_t): ffi.titan_ffi_void_ptr
  local top = lua.lua_gettop(L)
  ffi.lua_pushtvalue(L, owner)
  local pointer = ffi.lua_togco(L, -1)
  lua.lua_settop(L, top)
  return pointer
end

local function allocate_loop(next_generation: integer): Loop
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_loop_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local handle = memory as *libuv.uv_loop_t
  local loop = Loop.new(handle, storage, next_generation, OWNER_ALLOCATED)
  lua.lua_settop(L, top)
  return loop
end

local function allocate_bytes(length: integer): Bytes
  if length < 0 then
    raise "buffer length must not be negative"
  end
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, length, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local bytes = Bytes.new(memory as *ffi.titan_ffi_char, storage, length)
  lua.lua_settop(L, top)
  return bytes
end

local function allocate_buffer(length: integer): Buffer
  local bytes = allocate_bytes(length)
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_buf_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local handle = memory as *libuv.uv_buf_t
  shim.titan_uvshim_buf_init(
      handle as ffi.titan_ffi_void_ptr, bytes.data, length)
  local buffer = Buffer.new(handle, storage, bytes)
  lua.lua_settop(L, top)
  return buffer
end

local function install_young_buffer(timer: uv_timer_t, request: uv_fs_t,
                                    weak_slot: integer): integer
  local buffer = allocate_buffer(32)
  -- Slot 6 models the later Task/root coroutine, while slot 8 is the distinct
  -- I/O buffer role.  Both writes are old-owner -> young-record barriers.
  timer.root = buffer
  request.root = buffer
  timer.buffer = buffer
  request.buffer = buffer
  if weak_slot > 0 then
    weak_store(weak_slot, buffer)
    weak_store(weak_slot + 1, buffer.storage)
    weak_store(weak_slot + 2, buffer.bytes)
    weak_store(weak_slot + 3, buffer.bytes.storage)
  end
  return buffer.bytes.length
end

local function new_runtime(): Runtime
  check_storage_alignment()
  generation = generation + 1
  local loop = allocate_loop(generation)
  local status = libuv.uv_loop_init(loop.handle)
  if (status as integer) < 0 then
    loop.storage = nil
    loop.handle = nil
    raise "could not initialize private libuv loop"
  end
  loop.state = OWNER_ACTIVE
  local runtime = Runtime.new(loop, generation, {}, {}, false, nil, "",
                              0, 0, 0, 0, 0, 0, false, false, false,
                              false, 0)
  active_runtime = runtime
  return runtime
end

local function new_state(runtime: Runtime): CallbackState
  return CallbackState.new(runtime, runtime.generation, OWNER_ALLOCATED, false,
                           false, false, false, false, nil, "", 0, 0, 0)
end

local function task_body(state: CallbackState, event_kind: integer,
                         result: integer, size: integer)
  if state.fail_task and event_kind == EVENT_TIMER then
    raise "phase-1 observed task failure"
  end
  if event_kind == EVENT_FS then
    -- Model an allocating/arbitrary continuation after request cleanup.  The
    -- pending-table root must still keep the raw callback owner and metadata
    -- alive until this drive returns.
    lua.lua_gc(L, lua.LUA_GCCOLLECT)
  end
  state.result = result
  state.size = size
end

local function task_error_handler(state: CallbackState, err: value,
                                  trace: string)
  if state.fail_task_handler then
    raise "phase-1 task error handler failure"
  end
  state.task_failed = true
  state.task_error = err
  state.task_traceback = trace
  state.runtime.task_failure_sequence = state.runtime.callback_count
end

local function drive_task_boundary(state: CallbackState, event_kind: integer,
                                   result: integer, size: integer)
  do
    task_body(state, event_kind, result, size)
  catch
    task_error_handler(state, error, traceback)
  end
end

-- Family-specific, capture-free top-level dispatchers erase to the one native
-- callback ABI in titan_uv.c.  They are invoked directly with _fn == NULL.
-- Every potentially raising operation is inside the function-level catch.
local function timer_dispatch(owner: uv_timer_t, event_kind: integer,
                              result: integer, size: libuv.size_t,
                              pointer: ffi.titan_ffi_void_ptr)
  if pointer ~= nil then
    raise "timer callback carried an unexpected pointer payload"
  end
  if owner.metadata.inject_dispatch_failure then
    owner.metadata.inject_dispatch_failure = false
    raise "phase-1 injected dispatcher failure"
  end

  owner.metadata.runtime.callback_count =
      owner.metadata.runtime.callback_count + 1
  if event_kind == EVENT_TIMER then
    owner.metadata.runtime.timer_count =
        owner.metadata.runtime.timer_count + 1
    if owner.metadata.probe_role == 2 then
      owner.metadata.runtime.followup_timer_sequence =
          owner.metadata.runtime.callback_count
    end
    owner.metadata.lifecycle = OWNER_CLOSING
    libuv.uv_timer_stop(owner.handle)
    shim.titan_uvshim_timer_close(owner.handle)
    drive_task_boundary(owner.metadata, event_kind, result, size as integer)
  elseif event_kind == EVENT_HANDLE_CLOSE then
    owner.metadata.runtime.close_count =
        owner.metadata.runtime.close_count + 1
    owner.metadata.lifecycle = OWNER_CLOSED
    owner.handle = nil
    owner.storage = nil
    owner.metadata.runtime.resources[owner] = nil
  else
    raise "timer owner received an invalid callback event"
  end
catch
  owner.metadata.runtime.fatal_error = error
  owner.metadata.runtime.fatal_traceback = traceback
  owner.metadata.runtime.fatal = true
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  return
end

local function fs_dispatch(owner: uv_fs_t, event_kind: integer,
                           result: integer, size: libuv.size_t,
                           pointer: ffi.titan_ffi_void_ptr)
  if pointer ~= nil then
    raise "filesystem callback carried an unexpected pointer payload"
  end
  if owner.metadata.inject_dispatch_failure then
    owner.metadata.inject_dispatch_failure = false
    raise "phase-1 injected filesystem dispatcher failure"
  end
  if event_kind ~= EVENT_FS then
    raise "filesystem owner received an invalid callback event"
  end

  owner.metadata.runtime.callback_count =
      owner.metadata.runtime.callback_count + 1
  owner.metadata.runtime.fs_count = owner.metadata.runtime.fs_count + 1
  if not owner.metadata.cleaned then
    libuv.uv_fs_req_cleanup(owner.handle)
    owner.metadata.cleaned = true
  end
  owner.metadata.lifecycle = OWNER_CLEANED
  owner.metadata.result = result
  owner.handle = nil
  owner.storage = nil
  drive_task_boundary(owner.metadata, event_kind, result, size as integer)
  -- The native callback holds only a raw Udata pointer.  Keep the Runtime map
  -- root through every continuation allocation, then release it immediately
  -- before returning to libuv.
  owner.metadata.runtime.pending[owner] = nil
catch
  owner.metadata.runtime.fatal_error = error
  owner.metadata.runtime.fatal_traceback = traceback
  owner.metadata.runtime.fatal = true
  -- The callback proves this request is terminal even when the first
  -- dispatcher operation fails.  Cleanup is a public void libuv operation;
  -- keep this arm inline and non-raising, then release the existing map key.
  if not owner.metadata.cleaned then
    libuv.uv_fs_req_cleanup(owner.handle)
    owner.metadata.cleaned = true
  end
  owner.metadata.lifecycle = OWNER_CLEANED
  owner.handle = nil
  owner.storage = nil
  libuv.uv_stop(owner.metadata.runtime.loop.handle)
  owner.metadata.runtime.pending[owner] = nil
  return
end

local function allocate_timer(runtime: Runtime): uv_timer_t
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_timer_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local handle = memory as *libuv.uv_timer_t
  local owner: uv_timer_t = {
    handle = handle,
    storage = storage,
    main_thread = main_thread_value(),
    module = M,
    dispatcher = timer_dispatch,
    root = nil,
    metadata = new_state(runtime),
    buffer = nil,
  }
  owner.root = owner
  lua.lua_settop(L, top)
  return owner
end

local function allocate_fs(runtime: Runtime): uv_fs_t
  local top = lua.lua_gettop(L)
  local memory = lua.lua_newuserdatauv(L, libuv.uv_fs_t.sizeof, 0)
  local storage = ffi.lua_totvalue(L, -1)
  local handle = memory as *libuv.uv_fs_t
  local owner: uv_fs_t = {
    handle = handle,
    storage = storage,
    main_thread = main_thread_value(),
    module = M,
    dispatcher = fs_dispatch,
    root = nil,
    metadata = new_state(runtime),
    buffer = nil,
  }
  owner.root = owner
  lua.lua_settop(L, top)
  return owner
end

local function start_timer(runtime: Runtime, fail_task: boolean,
                           fail_task_handler: boolean,
                           inject_dispatch_failure: boolean,
                           probe_role: integer,
                           delay: integer): uv_timer_t
  local owner = allocate_timer(runtime)
  owner.metadata.fail_task = fail_task
  owner.metadata.fail_task_handler = fail_task_handler
  owner.metadata.inject_dispatch_failure = inject_dispatch_failure
  owner.metadata.probe_role = probe_role
  local status = libuv.uv_timer_init(runtime.loop.handle, owner.handle)
  if (status as integer) < 0 then
    owner.storage = nil
    owner.handle = nil
    owner.metadata.lifecycle = OWNER_CLEANED
    return owner
  end
  owner.metadata.lifecycle = OWNER_ACTIVE
  runtime.resources[owner] = true
  shim.titan_uvshim_timer_set_data(owner.handle, timer_owner_pointer(owner))
  status = libuv.uv_timer_start(owner.handle, shim.titan_uvshim_timer_cb,
                               delay, 0)
  if (status as integer) < 0 then
    owner.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(owner.handle)
  end
  return owner
end

local function start_fs_stat(runtime: Runtime, path: string): uv_fs_t
  local owner = allocate_fs(runtime)
  owner.metadata.lifecycle = OWNER_ACTIVE
  runtime.pending[owner] = true
  shim.titan_uvshim_fs_set_data(owner.handle, fs_owner_pointer(owner))
  local status = libuv.uv_fs_stat(runtime.loop.handle, owner.handle, path,
                                 shim.titan_uvshim_fs_cb)
  if (status as integer) < 0 then
    libuv.uv_fs_req_cleanup(owner.handle)
    owner.metadata.cleaned = true
    owner.metadata.lifecycle = OWNER_CLEANED
    owner.metadata.result = status as integer
    owner.handle = nil
    owner.storage = nil
    runtime.pending[owner] = nil
  end
  return owner
end

local function close_runtime(runtime: Runtime)
  local status = libuv.uv_loop_close(runtime.loop.handle)
  if (status as integer) ~= 0 then
    raise "private libuv loop remained busy after drain"
  end
  runtime.loop.state = OWNER_CLOSED
  runtime.loop.handle = nil
  runtime.loop.storage = nil
  active_runtime = nil
end

-- Start three live owners, age their graph, and suspend an incremental cycle
-- only after both destination owners have become black. The caller completes
-- that same cycle after this frame (and all its owner/buffer locals) returns.
local function start_gc_proof(path: string,
                              access: (uv_timer_t) -> boolean): Runtime
  local runtime = new_runtime()
  local timer = start_timer(runtime, false, false, false, 1, 0)
  local followup = start_timer(runtime, false, false, false, 2, 5)
  local request = start_fs_stat(runtime, path)

  weak_store(1, timer)
  weak_store(2, timer.storage)
  weak_store(3, followup)
  weak_store(4, followup.storage)
  weak_store(5, request)
  weak_store(6, request.storage)

  lua.lua_gc(L, lua.LUA_GCINC)
  lua.lua_gc(L, lua.LUA_GCCOLLECT)
  runtime.proof_incremental_paused =
      (allocation.titan_uv_test_gc_pause_when_black(
          L, timer_owner_pointer(timer), fs_owner_pointer(request))
          as integer) ~= 0

  runtime.proof_incremental_buffer_length =
      install_young_buffer(timer, request, 7)
  runtime.proof_layout_valid = owner_layout_is_valid(timer) and
                               owner_layout_is_valid(request)

  -- Calibrate the internal allocator interception with a real Titan record
  -- construction, then measure only the exact typed access path.  The access
  -- callback used by uv_spec lives in another Titan module and calls back into
  -- this module's public middle-layer function.
  allocation.titan_uv_test_reset_userdata_allocations()
  local calibration = new_state(runtime)
  runtime.proof_allocation_counter_active =
      (allocation.titan_uv_test_get_internal_userdata_allocations()
          as integer) > 0 and
      calibration.generation == runtime.generation
  allocation.titan_uv_test_reset_userdata_allocations()
  runtime.proof_access_without_allocation = access(timer) and
      (allocation.titan_uv_test_get_userdata_allocations() as integer) == 0 and
      (allocation.titan_uv_test_get_internal_userdata_allocations()
          as integer) == 0
  return runtime
end

-- Reacquire owners through weak observations only after a full collection has
-- proved that Runtime's pending/resource tables kept them alive.  Entering
-- generational mode first makes that accepted owner graph old; the fresh
-- buffer is then reachable only through the two old owner records.
local function install_generational_buffer(runtime: Runtime): integer
  local timer = weak_item(1) as uv_timer_t
  local request = weak_item(5) as uv_fs_t
  if timer.metadata.runtime ~= runtime or request.metadata.runtime ~= runtime then
    raise "weak owner observation resolved outside its Runtime"
  end
  return install_young_buffer(timer, request, 11)
end

-- Executable GC proof used through native_owner_consumer.  It separates the
-- creation frame from both collection steps, so Titan locals cannot mask a
-- missing Runtime root or record-field barrier.
function _phase1_gc_proof(path: string,
                          access: (uv_timer_t) -> boolean): {value}
  if active_runtime then
    raise "a libuv Runtime is already active"
  end
  local runtime = start_gc_proof(path, access)

  local incremental_finished =
      (allocation.titan_uv_test_gc_finish_incremental(L) as integer) ~= 0
  local incremental_barrier = incremental_finished and
                              weak_range_present(1, 10)

  -- This fresh complete collection starts after start_gc_proof returned.
  -- Therefore the pending/resource maps are now the only strong owner roots,
  -- and owner fields are the only strong roots for the first buffer graph.
  lua.lua_gc(L, lua.LUA_GCCOLLECT)
  local accepted_graph_rooted = weak_range_present(1, 10)

  lua.lua_gc(L, lua.LUA_GCGEN)
  local generational_buffer_length = install_generational_buffer(runtime)
  lua.lua_gc(L, lua.LUA_GCSTEP, 0 as libuv.size_t)
  local generational_barrier = weak_range_present(1, 6) and
                               weak_range_present(11, 14)

  local stack_top = lua.lua_gettop(L)
  local run_status = libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)
  local stack_balanced = lua.lua_gettop(L) == stack_top
  local callback_count = runtime.callback_count
  local timer_count = runtime.timer_count
  local close_count = runtime.close_count
  local fs_count = runtime.fs_count
  local fatal = runtime.fatal
  close_runtime(runtime)

  lua.lua_gc(L, lua.LUA_GCINC)
  lua.lua_gc(L, lua.LUA_GCCOLLECT)
  local roots_released = weak_range_absent(1, 14)
  return { runtime.proof_incremental_paused, incremental_barrier,
           accepted_graph_rooted, generational_barrier,
           runtime.proof_layout_valid,
           runtime.proof_allocation_counter_active,
           runtime.proof_access_without_allocation,
           runtime.proof_incremental_buffer_length,
           generational_buffer_length, callback_count, timer_count,
           close_count, fs_count, fatal, stack_balanced,
           run_status as integer, roots_released }
end

-- A narrow executable Phase-1 probe covers the native foundation without
-- pretending that Task/run/cancellation already exist.  Phase 2 replaces this
-- diagnostic surface with the public continuation API.
function _phase1_probe(path: string, fail_task: boolean,
                       fail_task_handler: boolean,
                       inject_dispatch_failure: boolean,
                       inject_fs_dispatch_failure: boolean): {value}
  if active_runtime then
    raise "a libuv Runtime is already active"
  end
  local runtime = new_runtime()
  local timer = start_timer(runtime, fail_task, fail_task_handler,
                            inject_dispatch_failure, 1, 0)
  -- This independent callback is deliberately later than the failing owner.
  -- It proves an observed Task failure returned normally through libuv.
  local followup = start_timer(runtime, false, false, false, 2, 5)
  local request = start_fs_stat(runtime, path)
  request.metadata.inject_dispatch_failure = inject_fs_dispatch_failure

  -- These weak values let the Lua-side fixture prove that both the callback
  -- owner records and their separate native-storage userdata lose their last
  -- strong root after the terminal callbacks and loop close.
  weak_store(1, timer)
  weak_store(2, timer.storage)
  weak_store(3, followup)
  weak_store(4, followup.storage)
  weak_store(5, request)
  weak_store(6, request.storage)

  -- The dedicated cross-module proof above isolates collection from these
  -- strong diagnostic locals.  This path still checks the concrete layout and
  -- callback-visible buffer graph while exercising failure cleanup.
  local buffer_length = install_young_buffer(timer, request, 0)
  local owner_layout_ok = owner_layout_is_valid(timer) and
                          owner_layout_is_valid(request)
  local repeated_timer_access_ok = 0
  if not _timer_is_closing(timer) and not _timer_is_closing(timer) then
    repeated_timer_access_ok = 1
  end
  local stack_top = lua.lua_gettop(L)
  local run_status = libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)

  -- uv_stop only wakes the active invocation.  Physical cleanup/draining is
  -- deliberately performed after uv_run returns.
  if runtime.fatal and timer.metadata.lifecycle < OWNER_CLOSING then
    libuv.uv_timer_stop(timer.handle)
    timer.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(timer.handle)
  end
  if runtime.fatal and followup.metadata.lifecycle < OWNER_CLOSING then
    libuv.uv_timer_stop(followup.handle)
    followup.metadata.lifecycle = OWNER_CLOSING
    shim.titan_uvshim_timer_close(followup.handle)
  end
  if runtime.fatal then
    run_status = libuv.uv_run(runtime.loop.handle, libuv.UV_RUN_DEFAULT)
  end

  local task_failed = 0
  if timer.metadata.task_failed then task_failed = 1 end
  local fatal = 0
  if runtime.fatal then fatal = 1 end
  local fs_cleaned = 0
  if request.metadata.cleaned and request.storage == nil then fs_cleaned = 1 end
  local timer_closed = 0
  if timer.metadata.lifecycle == OWNER_CLOSED and timer.storage == nil then
    timer_closed = 1
  end
  local followup_closed = 0
  if followup.metadata.lifecycle == OWNER_CLOSED and followup.storage == nil then
    followup_closed = 1
  end
  local stack_balanced = 0
  if lua.lua_gettop(L) == stack_top then stack_balanced = 1 end
  local layout_valid = 0
  if owner_layout_ok then layout_valid = 1 end
  local followup_after_task_failure = 0
  if runtime.task_failure_sequence > 0 and
      runtime.followup_timer_sequence > runtime.task_failure_sequence then
    followup_after_task_failure = 1
  end
  close_runtime(runtime)
  lua.lua_gc(L, lua.LUA_GCINC)
  return { runtime.callback_count, runtime.timer_count, runtime.close_count,
           runtime.fs_count, task_failed, fatal, fs_cleaned, timer_closed,
           stack_balanced, request.metadata.result, buffer_length,
           layout_valid, run_status as integer, followup_after_task_failure,
           runtime.fatal_error, runtime.fatal_traceback,
           timer.metadata.task_error, timer.metadata.task_traceback,
           followup_closed, repeated_timer_access_ok }
end

function version(): string
  return libuv.uv_version_string() as string
end

function _phase1_owner_roots_released(): boolean
  for slot = 1, 6 do
    if weak_present(slot) then return false end
  end
  return true
end

-- Foundational exact-wrapper entry used by the higher timer layer.  Its Lua
-- entry also provides the nominal record check; Phase 2 grows the operation
-- surface around the same opaque type.
function _timer_is_closed(timer: uv_timer_t): boolean
  return timer.metadata.lifecycle == OWNER_CLOSED
end

function _timer_is_closing(timer: uv_timer_t): boolean
  if timer.metadata.generation ~= timer.metadata.runtime.generation then
    raise "timer belongs to a stale libuv Runtime"
  end
  if timer.metadata.lifecycle >= OWNER_CLOSED then
    return true
  end
  return (shim.titan_uvshim_timer_is_closing(timer.handle) as integer) ~= 0
end
