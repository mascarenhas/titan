-- A test-owned driver over titan.browser's drive interface, without async.
-- Jobs stand in for Tasks: a job runs its target once per turn until it
-- returns, waits on one host request, or is cancelled. The registered
-- `titan:driver` callables follow the async backend's spawn/settle protocol.
local browser = import "browser"
local coroutine = import "coroutine"
local _ = import "mini_child"
foreign import "stdio.h"
foreign import "mini_driver.h"

local type Value = browser.BrowserValue
local type Callable = function (...: Value): Value

local record Job
  target: Callable
  args: {Value}
  settle: browser.BrowserHandle?
  request: browser.BrowserRequest?
  waiting: boolean
  again: boolean
  done: boolean
  -- Cancellation keeps waiting for the job's own request (or forever).
  cleanup: boolean
  cancelling: string?
  turns: integer
end

local open: {Job} = {}
local ready: {Job} = {}
local current: Job?
local driving = false
local exit_code: integer?
local turn = 0
local child_owner: value
-- False under titan-browser-run, which supplies no fixture bindings.
local harness = false
-- The measurement harness turns the per-turn probe binding call off.
local probing = true

local function binding_call(name: string, ...: Value): Value
  local target = browser.binding(name)
  defer target:close()
  return target:call(...)
end

local function publish(name: string, callback: Callable)
  binding_call("publish", Value.is_string(name), Value.is_callable(callback))
end

local function error_text(failure: value): string
  if failure is string then return failure end
  return "non-string error"
end

local function expect_callable(item: Value?): Callable
  case item
  when is_callable(callback) then return callback
  end
  raise "expected a callable BrowserValue"
end

local function expect_handle(item: Value?): browser.BrowserHandle
  case item
  when is_handle(handle) then return handle
  end
  raise "expected a handle BrowserValue"
end

local function expect_number(item: Value?): float
  case item
  when is_integer(number) then return number
  when is_float(number) then return number
  end
  raise "expected a numeric BrowserValue"
end

local function expect_integer(item: Value?): integer
  case item
  when is_integer(number) then return number
  end
  raise "expected an integer BrowserValue"
end

local function expect_string(item: Value?): string
  case item
  when is_string(text) then return text
  end
  raise "expected a string BrowserValue"
end

local function ignore(...: Value): Value
  return Value.is_nil()
end

local function Job:finish(kind: string, first: Value, second: Value)
  if self.done then return end
  self.done = true
  self.waiting = false
  local request? = self.request
  self.request = nil
  if request ~= nil then
    request:cancel()
    request:close()
  end
  local remaining: {Job} = {}
  for index = 1, #open do
    local item = open[index]
    if item ~= self then remaining[#remaining + 1] = item end
  end
  open = remaining
  local handle? = self.settle
  self.settle = nil
  if handle ~= nil then
    defer handle:close()
    handle:call(Value.is_string(kind), first, second)
  end
end

-- A new job is open and runs at the drive's next turn.
local function Job.new(target: Callable, args: {Value}, handle: browser.BrowserHandle?): Job
  local job: Job = {
    target = target, args = args, settle = handle, request = nil,
    waiting = false, again = false, done = false, cleanup = false,
    cancelling = nil, turns = 0,
  }
  open[#open + 1] = job
  ready[#ready + 1] = job
  return job
end

local function Job:completion_handler(): Callable
  return function(...: Value): Value
    local request? = self.request
    self.request = nil
    if request ~= nil then request:close() end
    if self.cancelling ~= nil then
      binding_call("cleanup_note", Value.is_string("cleanup settled"))
      self:finish("cancelled", Value.is_string(self.cancelling), Value.is_nil())
    else
      self:finish("succeeded", Value.is_string("woke"), Value.is_nil())
    end
    return Value.is_nil()
  end
end

local function Job:failure_handler(): Callable
  return function(...: Value): Value
    local message = "host request failed"
    case ...[1]
    when is_string(text) then message = text
    end
    case ...[2]
    when is_handle(thrown) then thrown:close()
    end
    self:finish("failed", Value.is_bytes(message), Value.is_bytes(""))
    return Value.is_nil()
  end
end

-- Cleanup of a cancelled job cannot start new host work during disposal.
local function try_new_work(): string
  local timeout = browser.binding("titan:timeout")
  defer timeout:close()
  local late = timeout:start(ignore, ignore, Value.is_float(1.0))
  late:cancel()
  late:close()
  return "started"
catch
  if error is browser.BrowserError then
    local failure: browser.BrowserError = error
    failure:close()
    return failure.message
  end
  return error_text(error)
end

local function Job:cancel(reason: string)
  if self.done or self.cancelling ~= nil then return end
  if self.cleanup then
    self.cancelling = reason
    binding_call("cleanup_note", Value.is_string("new work: " .. try_new_work()))
    return
  end
  self:finish("cancelled", Value.is_string(reason), Value.is_nil())
end

local function cancel_all(reason: string)
  local snapshot = open
  for index = 1, #snapshot do snapshot[index]:cancel(reason) end
end

local function fail_waiting(message: string)
  local snapshot = open
  for index = 1, #snapshot do
    local job = snapshot[index]
    if job.waiting then job:finish("failed", Value.is_bytes(message), Value.is_bytes("")) end
  end
end

local function Job:step()
  if self.done or self.waiting then return end
  current = self
  self.again = false
  local result = Value.is_nil()
  local failed = false
  local message = ""
  local trace = ""
  do
    result = self.target(...self.args)
  catch
    failed = true
    message = error_text(error)
    trace = traceback
  end
  current = nil
  if failed then
    self:finish("failed", Value.is_bytes(message), Value.is_bytes(trace))
  elseif self.again then
    ready[#ready + 1] = self
  elseif not self.waiting then
    self:finish("succeeded", result, Value.is_nil())
  end
end

-- Resumes a coroutine `count` times. Each round trip is an internal handoff
-- that lets JavaScript microtasks run, as Task switches do.
local function hop(count: integer)
  if count == 0 then return end
  local hopper = coroutine.create(function(_: value): value
    for index = 2, count do coroutine.yield(index, "mini-hops") end
    return nil
  end, "mini-hops")
  for _ = 1, count do hopper:resume(nil) end
end

local function drive()
  browser.drive_begin()
  driving = true
  defer do
    driving = false
    browser.drive_end(exit_code)
  end
  while true do
    browser.deliver()
    local batch = ready
    ready = {}
    for index = 1, #batch do batch[index]:step() end
    if exit_code ~= nil then cancel_all("exit") end
    if #open == 0 then return end
    local status = browser.relinquish(#ready == 0)
    turn = turn + 1
    if harness and probing then binding_call("probe", Value.is_integer(turn), Value.is_integer(status)) end
    if status == browser.RELINQUISH_DISPOSING then
      cancel_all("instance disposed")
    elseif status == browser.RELINQUISH_IDLE then
      -- Switch coroutines first, as async's orphan unwinding does.
      hop(2)
      fail_waiting("mini driver became idle while jobs were waiting")
    end
  end
end

-- Waits on host work from inside the running job's target.
local function wait_on(binding: string, ...: Value)
  local job = current
  local source = browser.binding(binding)
  defer source:close()
  job.request = source:start(job:completion_handler(), job:failure_handler(), ...)
  job.waiting = true
end

local function echo(...: Value): Value
  return ...[1]
end

local function fail(...: Value): Value
  case ...[1]
  when is_string(message) then raise message
  end
  raise "fail expects a message"
end

local function nap(...: Value): Value
  wait_on("titan:timeout", Value.is_float(expect_number(...[1])))
  return Value.is_nil()
end

local function hang(...: Value): Value
  wait_on("never")
  return Value.is_nil()
end

-- A job whose cancellation waits for its own pre-existing request.
local function guarded(...: Value): Value
  wait_on("slow", Value.is_float(expect_number(...[1])))
  local job = current
  job.cleanup = true
  return Value.is_nil()
end

-- A job waiting with no wake source; cancellation keeps it waiting.
local function stubborn(...: Value): Value
  local job = current
  job.waiting = true
  job.cleanup = true
  return Value.is_nil()
end

local function orphan(...: Value): Value
  local job = current
  job.waiting = true
  return Value.is_nil()
end

-- Writes a line to each stream, then waits with no wake source: the drive's
-- wait relinquish returns IDLE without parking.
local function idle_output(...: Value): Value
  ffi.fputs("before idle\n", ffi.stdout)
  ffi.fputs("before idle\n", ffi.stderr)
  local job = current
  job.waiting = true
  return Value.is_nil()
end

-- Runs turn after turn until a JavaScript macrotask set the flag.
local function spin(...: Value): Value
  local job = current
  job.turns = job.turns + 1
  case binding_call("flag")
  when is_boolean(seen) then
    if seen then return Value.is_integer(job.turns) end
  end
  if job.turns >= expect_integer(...[1]) then return Value.is_integer(-1) end
  job.again = true
  return Value.is_nil()
end

-- Writes a line per turn until the stdout sink has received output.
local function chatter(...: Value): Value
  local job = current
  job.turns = job.turns + 1
  ffi.fputs("chatter\n", ffi.stdout)
  case binding_call("sink_count")
  when is_integer(count) then
    if count > 0 then return Value.is_integer(job.turns) end
  end
  if job.turns >= expect_integer(...[1]) then return Value.is_integer(-1) end
  job.again = true
  return Value.is_nil()
end

-- Internal coroutine hops inside one turn; `kick` queues JS work between them.
local function hops(...: Value): Value
  binding_call("kick")
  hop(9)
  return Value.is_nil()
end

-- Calls `kick`, makes the given number of coroutine round trips, then writes
-- the text to "stdout" or "stderr".
local function hop_write(...: Value): Value
  local text = expect_string(...[1])
  local to_stderr = expect_string(...[2]) == "stderr"
  binding_call("kick")
  hop(expect_integer(...[3]))
  if to_stderr then ffi.fputs(text, ffi.stderr) else ffi.fputs(text, ffi.stdout) end
  return Value.is_nil()
end

local function reenter(...: Value): Value
  binding_call("reenter")
  return Value.is_nil()
end

local function note(...: Value): Value
  binding_call("noted", ...[1])
  return Value.is_nil()
end

local function exit_with(...: Value): Value
  exit_code = expect_integer(...[1])
  return Value.is_nil()
end

local function overflow(...: Value): Value
  return Value.is_integer(ffi.mini_driver_overflow())
end

local function sdk_unknown(...: Value): Value
  local source = browser.binding("titan:unknown")
  source:close()
  return Value.is_string("resolved")
catch
  if error is browser.BrowserError then
    local failure: browser.BrowserError = error
    failure:close()
    return Value.is_string(failure.message)
  end
  return Value.is_string(error_text(error))
end

-- Cancels a fresh titan:timeout at once; the host timer must not survive.
local function timer_cancel(...: Value): Value
  local timeout = browser.binding("titan:timeout")
  defer timeout:close()
  local request = timeout:start(ignore, ignore, Value.is_float(expect_number(...[1])))
  request:cancel()
  request:close()
  return Value.is_nil()
end

-- Counts ticks of a titan:interval with the given period, then settles;
-- settling cancels the listener.
local function ticks(...: Value): Value
  local job = current
  local wanted = expect_integer(...[1])
  local interval = browser.binding("titan:interval")
  defer interval:close()
  job.request = interval:listen(function(...: Value): Value
    job.turns = job.turns + 1
    if job.turns >= wanted then job:finish("succeeded", Value.is_integer(job.turns), Value.is_nil()) end
    return Value.is_nil()
  end, job:failure_handler(), Value.is_float(expect_number(...[2])))
  job.waiting = true
  return Value.is_nil()
end

local function spawn(...: Value): Value
  local target = expect_callable(...[1])
  local handle = expect_handle(...[2])
  local args: {Value} = {}
  for index = 3, #... do args[#args + 1] = ...[index] end
  local job = Job(target, args, handle)
  handle:call(Value.is_string("started"), Value.is_callable(function(...: Value): Value
    case ...[1]
    when is_string(reason) then job:cancel(reason)
    end
    return Value.is_nil()
  end))
  if not driving then drive() end
  return Value.is_nil()
end

local function shutdown(...: Value): Value
  binding_call("shutdown_ran")
  cancel_all("instance disposed")
  if not driving and #open > 0 then drive() end
  return Value.is_nil()
end

local function register(...: Value): Value
  binding_call("titan:driver", Value.is_callable(spawn), Value.is_callable(shutdown))
  return Value.is_nil()
end

-- A plain call that drives one job, as an explicit async.loop() would.
local function drive_job(...: Value): Value
  local args: {Value} = {}
  for index = 2, #... do args[#args + 1] = ...[index] end
  Job(expect_callable(...[1]), args, nil)
  drive()
  return Value.is_string("drove")
end

-- Takes the given number of turns, one step each.
local function count_turns(...: Value): Value
  local job = current
  job.turns = job.turns + 1
  if job.turns >= expect_integer(...[1]) then return Value.is_integer(job.turns) end
  job.again = true
  return Value.is_nil()
end

-- A plain call that drives the given number of count_turns jobs, each for
-- the given number of turns, and returns the drive's relinquishes.
local function drive_counters(...: Value): Value
  local jobs = expect_integer(...[1])
  local turns = expect_integer(...[2])
  local first = turn
  for _ = 1, jobs do Job(count_turns, {Value.is_integer(turns)}, nil) end
  drive()
  return Value.is_integer(turn - first)
end

local function set_probes(...: Value): Value
  case ...[1]
  when is_boolean(enabled) then
    probing = enabled
    return Value.is_nil()
  end
  raise "set_probes expects a boolean"
end

local function owner_probe(...: Value): Value
  local refusal = "no refusal"
  do
    browser.relinquish(false)
  catch
    if error is string then refusal = error end
  end
  local role = "child"
  if browser.is_owner() then role = "owner" end
  return Value.is_string(role .. ": " .. refusal)
end

-- A distinct callable whose wrapper the harness releases during a drive.
local function spare(...: Value): Value
  return Value.is_string("spare")
end

local function has_harness(): boolean
  local target = browser.binding("publish")
  target:close()
  return true
catch
  if error is browser.BrowserError then
    local failure: browser.BrowserError = error
    failure:close()
  end
  return false
end

-- Starts a job already waiting on host work, without driving: only a later
-- drive (or disposal's shutdown drive) can deliver its settlement.
local function park_idle(...: Value): Value
  local job = Job(ignore, {}, nil)
  local source = browser.binding("slow")
  defer source:close()
  job.request = source:start(job:completion_handler(), job:failure_handler(),
                             Value.is_float(expect_number(...[1])))
  job.waiting = true
  job.cleanup = true
  return Value.is_nil()
end

function main(args: {string}): integer
  local mode = args[1] or "return"
  if mode == "exit" then
    Job(exit_with, {Value.is_integer(259)}, nil)
    drive()
    return 0
  elseif mode == "exit-fail" then
    Job(exit_with, {Value.is_integer(4)}, nil)
    drive()
    raise "main failed after its drive exited"
  elseif mode == "main-failed" then
    -- As the async bootstrap reports a failed main Task, then returns 1.
    browser.main_failed("main task failed", "main task trace")
    return 1
  elseif mode == "main-failed-exit" then
    browser.main_failed("main task failed", "main task trace")
    Job(exit_with, {Value.is_integer(7)}, nil)
    drive()
    return 1
  end
  return 7
end

do
  harness = has_harness()
  if harness then
    ffi.mini_driver_publish_controls()
    publish("echo", echo)
    publish("fail", fail)
    publish("nap", nap)
    publish("hang", hang)
    publish("guarded", guarded)
    publish("stubborn", stubborn)
    publish("orphan", orphan)
    publish("idle_output", idle_output)
    publish("spin", spin)
    publish("chatter", chatter)
    publish("hops", hops)
    publish("hop_write", hop_write)
    publish("reenter", reenter)
    publish("note", note)
    publish("exit_with", exit_with)
    publish("overflow", overflow)
    publish("sdk_unknown", sdk_unknown)
    publish("timer_cancel", timer_cancel)
    publish("ticks", ticks)
    publish("register", register)
    publish("drive_job", drive_job)
    publish("drive_counters", drive_counters)
    publish("set_probes", set_probes)
    publish("park_idle", park_idle)
    publish("owner_probe", owner_probe)
    publish("spare", spare)
    child_owner = ffi.mini_driver_new_child(L)
  end
end
