local coroutine = import "coroutine"
foreign import "stdio.h"
foreign import "loader.h"

local retained: coroutine.Coroutine? = nil

local function output(bytes: string)
  if (ffi.fwrite(bytes, 1, #bytes, ffi.stdout) as integer) ~= #bytes then
    raise "fidelity stdout failed"
  end
end

local function diagnostic(bytes: string)
  if (ffi.fwrite(bytes, 1, #bytes, ffi.stderr) as integer) ~= #bytes then
    raise "fidelity stderr failed"
  end
end

local function drain()
  if ffi.fflush(ffi.stdout) ~= 0 then raise "fidelity stdout flush failed" end
  if ffi.fflush(ffi.stderr) ~= 0 then raise "fidelity stderr flush failed" end
end

function main(args: {string}): integer
  local mode = args[1]
  if mode == "abort_wait" then ffi.browser_loader_abort_wait() end
  local owner = coroutine.create(function(_input: value): value
    defer output("close\0\255")
    defer diagnostic("close\0\255")
    coroutine.yield("parked", "close")
    raise "retained coroutine unexpectedly resumed"
  end, "close")
  retained = owner
  if owner:resume(nil) ~= "parked" then raise "cleanup owner did not park" end
  local status = 23
  if mode == "status0" then status = 0
  elseif mode == "status1" then status = 1
  elseif mode == "status2" then status = 2
  elseif mode == "negative" then status = -2147483648
  elseif mode == "wrapped" then status = 4294967297
  end
  if mode == "fidelity" or mode == "uncaught" then
    output("OUT\0\255\195(")
    diagnostic("ERR\0\255\195(")
    drain()
  end
  ffi.browser_loader_wait(0)
  ffi.browser_loader_wait(1)
  if mode == "fidelity" then
    output("\0tail\255")
    diagnostic("\0tail\255")
  end
  local finisher = coroutine.create(function(_input: value): value
    return status
  end, "last")
  local result: integer = finisher:resume(nil)
  if mode == "uncaught" then raise "failure\0\255\195(" end
  -- The parked owner is closed by the real lua_close after main returns.
  -- Its unterminated output still belongs to the entry's final libc drain.
  return result
end
