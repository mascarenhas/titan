local function fiber_capture(label: string, action: Action)
  local trace = caught(action)
  test.assert(count_frames(trace, ": in titan.coroutine.coro_entry_trampoline") == 1, trace)
  test.assert(not contains(trace, "in trace_cases.test_") and
              not contains(trace, "in titan.test."),
              "in-fiber trace included saved resumer/test-runner history\n" .. trace)
  if contains(label, "selected") then
    frame(trace, "locations.browser.titan", 2, "trace_cases.selected_leaf")
    frame(trace, "locations.browser.titan", 6, "trace_cases.selected_outer")
  else
    frame(trace, "trace_cases.titan", 80, "trace_cases.original_leaf")
    frame(trace, "trace_cases.titan", 84, "trace_cases.direct_middle")
    frame(trace, "trace_cases.titan", 88, "trace_cases.direct_outer")
  end
  emit(label, trace)
end

local function fiber_captures(): value
  fiber_capture("fiber_before", direct_outer)
  fiber_capture("selected_fiber_before", selected_outer)
  coroutine.yield("paused", "trace-fiber")
  fiber_capture("fiber_after", direct_outer)
  fiber_capture("selected_fiber_after", selected_outer)
  ffi.trace_fixture_sleep()
  fiber_capture("fiber_after_sleep", direct_outer)
  fiber_capture("selected_fiber_after_sleep", selected_outer)
  return "finished"
end

function test_locations_before_after_yield(_context: test.Context)
  local child = coroutine.create(function(_: value): value
    return fiber_captures()
  end, "trace-fiber")
  test.assert(child:resume(nil) == "paused")
  ffi.trace_fixture_sleep()
  test.assert(child:resume(nil) == "finished")
  test.assert(child:status() == "dead")
end

local function resumed_leaf(): value
  coroutine.yield("paused", "append-outer")
  original_leaf()
  return nil
end

local function append_middle(child: coroutine.Coroutine): value
  return child:resume(nil)
end

local function append_outer(parent: coroutine.Coroutine): value
  local invoke: Shape = loaded(4)
  invoke(function() parent:resume(nil) end)
  return nil
end

function test_coroutine_propagation_append(_context: test.Context)
  local child = coroutine.create(function(_: value): value
    return resumed_leaf()
  end, "append-inner")
  local parent = coroutine.create(function(_: value): value
    return append_middle(child)
  end, "append-outer")
  test.assert(parent:resume(nil) == "paused")
  ffi.trace_fixture_sleep()
  local seen = false
  do
    append_outer(parent)
  catch
    seen = true
    test.assert(error == "trace-original")
    ordered(traceback, "in trace_cases.original_leaf", "in trace_cases.resumed_leaf")
    ordered(traceback, "in trace_cases.resumed_leaf", "in trace_cases.append_middle")
    ordered(traceback, "in trace_cases.append_middle", "in trace_cases.append_outer")
    test.assert(count_frames(traceback, ": in trace_cases.original_leaf") == 1, traceback)
    test.assert(count_frames(traceback, ": in trace_cases.resumed_leaf") == 1, traceback)
    test.assert(count_frames(traceback, ": in trace_cases.append_middle") == 1, traceback)
    test.assert(count_frames(traceback, ": in trace_cases.append_outer") == 1, traceback)
    test.assert(count_frames(traceback, ": in trace_cases.test_coroutine_propagation_append") == 1, traceback)
    test.assert(count_frames(traceback, ": in titan.coroutine.coro_entry_trampoline") == 2, traceback)
    test.assert(contains(traceback, "trace-resume.lua:2: in"), traceback)
    emit("append", traceback)
  end
  test.assert(seen and child:status() == "dead" and parent:status() == "dead")
end
