local async = import "async"
local uv = import "uv"

local function child(index: integer, iterations: integer, sample: function (integer): ()): async.Task<|nil, nil|>
  return async.run<|nil, nil|>(function (): nil
    sample(index)
    for iteration = 1, iterations do
      async.yield()
      sample(index)
    end
    return nil
  end)
end

function launch(count: integer, iterations: integer, sample: function (integer): ()): async.Task<|nil, nil|>
  return async.run<|nil, nil|>(function (): nil
    local timer = uv.timer_t.new()
    local handle = timer:as_handle_t()
    if uv.timer_init(async.current_loop(), timer) < 0 then raise "latency timer init" end
    defer uv.close(handle)
    if uv.timer_start(timer, function (_: uv.timer_t) sample(0) end, 1, 1) < 0 then raise "latency timer start" end
    local tasks: {async.Task<|nil, nil|>} = {}
    for index = 1, count do tasks[index] = child(index, iterations, sample) end
    for index = 1, count do
      case async.join(tasks[index])
      when succeeded() then
      else raise "latency child did not succeed" end
    end
    uv.timer_stop(timer)
    return nil
  end)
end
