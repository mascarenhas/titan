            local rep = ReplyMsg(id, id * 2 + 1, "ok")
            ffi.rtt_probe_trace_worker_reply_start(id as foreign int64_t)
            traced_send(job.reply, rep, 0)
            ffi.rtt_probe_trace_worker_reply_done(id as foreign int64_t)
            processed = processed + 1
          end
        end
        return processed
      end, req_rx, ready_tx)

      ready_rx:receive()
      local w_start = ffi.rtt_probe_now_ns()
      for i = 1, warmup do
        local slot = (i - 1) % 4 + 1
        req_tx:send(LargeSenderJob(-i, payload_64k, pool_tx[slot]))
        local r = pool_rx[slot]:receive()
        if r.id ~= i or r.value ~= i * 2 + 1 then raise "warmup large64k endpoint mismatch" end
      end
      ffi.rtt_probe_mark_warmup_done(ffi.rtt_probe_now_ns() - w_start, warmup as foreign int64_t)
      gc.collect()

      ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
      local sum = 0
      for i = 1, count do
        local slot = (i - 1) % 4 + 1
        local t0 = ffi.rtt_probe_now_ns()
        ffi.rtt_probe_trace_client_send_start(i as foreign int64_t, t0)
        traced_send(req_tx, LargeSenderJob(i, payload_64k, pool_tx[slot]), 1)
        ffi.rtt_probe_trace_client_send_done(i as foreign int64_t, ffi.rtt_probe_now_ns())
        local rep = traced_receive(pool_rx[slot])
        local t5 = ffi.rtt_probe_now_ns()
        ffi.rtt_probe_trace_client_reply_done(i as foreign int64_t, t5)
        ffi.rtt_probe_record_sample(t5 - t0)
        if rep.id ~= i or rep.value ~= i * 2 + 1 or rep.tag ~= "ok" then
          raise "large64k endpoint reply mismatch"
        end
        sum = sum + rep.value
      end
      ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)

      req_tx:close()
      if join_worker(worker) ~= count then raise "worker count mismatch" end
      for s = 1, 4 do pool_tx[s]:close(); pool_rx[s]:close() end
      req_rx:close(); ready_tx:close(); ready_rx:close()
      return sum
    end

    raise "unknown SPSC case: " .. case_name
  end)
  ffi.rtt_probe_mark_workers_retired(gc.count() as foreign int64_t)
  return checksum, wire_bytes
end

-- ============================================================================
-- Group 4: Bounded MPMC & Explicit Full/Empty Wait Cases
-- ============================================================================

local function mpmc_produce<|T|>(
    config: MpmcProducer<|T|>,
    make_job: function (integer, integer): T): integer
  local tasks: {async.Task<|integer, value|>} = {}
  for lane = 1, config.in_flight do
    local lane_index = lane
    tasks[lane] = async.run<|integer, value|>(function (): integer
      local exchange = function (id: integer, measured: boolean): integer
        local slot = (abs_int(id) - 1) % config.in_flight + 1
        if measured then
          ffi.rtt_probe_trace_permit_start(
            id as foreign int64_t, config.index as foreign int,
            lane_index as foreign int, ffi.rtt_probe_now_ns())
        end
        local permit = config.permits[slot]:receive()
        local t0 = ffi.rtt_probe_now_ns()
        if measured then ffi.rtt_probe_trace_client_send_start(id as foreign int64_t, t0) end
        traced_send(config.request, make_job(id, slot), 0)
        if measured then
          ffi.rtt_probe_trace_client_send_done(id as foreign int64_t, ffi.rtt_probe_now_ns())
        end
        local reply = traced_receive(config.replies[slot])
        local t5 = ffi.rtt_probe_now_ns()
        config.release_permits[slot]:send(permit)
        local expected_id = abs_int(id)
        if reply.id ~= expected_id or reply.value ~= expected_id * 2 + 1 or reply.tag ~= "ok" then
          raise "MPMC reply validation failed"
        end
        if measured then
          ffi.rtt_probe_trace_client_reply_done(id as foreign int64_t, t5)
          ffi.rtt_probe_record_sample(t5 - t0)
        end
        return reply.value
      end
      -- Every producer state exercises the real protocol before the barrier.
      for i = 1, config.warmup do
        exchange(-(config.index + (lane_index - 1 + i * config.in_flight) * config.producers), false)
      end
      gc.collect(); gc.collect()
      config.ready:send(1)
      config.start:receive()
      local sum = 0
      local id = config.index + (lane_index - 1) * config.producers
      while id <= config.count do
        sum = sum + exchange(id, true)
        id = id + config.in_flight * config.producers
      end
      return sum
    end)
  end
  local sum = 0
  for lane = 1, config.in_flight do sum = sum + await_task(tasks[lane]) end
  config.done:send(sum)
  config.retire:receive()
  return sum
end

local function run_mpmc_pool_case(
    use_endpoint: boolean,
    in_flight: integer,
    producers: integer,
    consumers: integer,
    capacity: integer,
    count: integer,
    warmup: integer): (integer, integer)
  local checksum = run_in_runtime(function (): integer
    ffi.rtt_probe_mark_setup_start(gc.count() as foreign int64_t)
    if ffi.rtt_probe_mpmc_setup(
        count as foreign int64_t, producers as foreign int,
        in_flight as foreign int, consumers as foreign int) == 0 then
      raise "MPMC fairness trace allocation or topology failed"
    end
    local ready_tx, ready_rx = thread.channel<|integer|>(producers * in_flight + consumers)
    local start_tx, start_rx = thread.channel<|integer|>(producers * in_flight)
    local done_tx, done_rx = thread.channel<|integer|>(producers)
    local retire_tx, retire_rx = thread.channel<|integer|>(producers)
    local pool_size = in_flight
    if pool_size < 4 then pool_size = 4 end
    local pool_tx: {thread.Sender<|ReplyMsg|>} = {}
    local pool_rx: {thread.Receiver<|ReplyMsg|>} = {}
    local permits_tx: {thread.Sender<|integer|>} = {}
    local permits_rx: {thread.Receiver<|integer|>} = {}
    for slot = 1, pool_size do
      local tx, rx = thread.channel<|ReplyMsg|>(1)
      local ptx, prx = thread.channel<|integer|>(1)
      pool_tx[slot] = tx; pool_rx[slot] = rx
      permits_tx[slot] = ptx; permits_rx[slot] = prx
      ptx:send(slot)
    end
    local workers: {thread.Thread<|integer|>} = {}
    local senders: {thread.Thread<|integer|>} = {}
    local plain_tx, plain_rx = thread.channel<|PlainJob|>(capacity)
    local ep_tx, ep_rx = thread.channel<|RpcSenderJob|>(capacity)
    local reply_pool = ReplySenderPool(pool_tx)
    for c = 1, consumers do
      if use_endpoint then
        workers[c] = thread.spawn_three<|
            thread.Receiver<|RpcSenderJob|>, thread.Sender<|integer|>,
            thread.Sender<|ReplyMsg|>, integer|>(function (
              rx: thread.Receiver<|RpcSenderJob|>, ready: thread.Sender<|integer|>,
              sample_reply: thread.Sender<|ReplyMsg|>): integer
          local warmed = warm_channel(RpcSenderJob(-1, "request", sample_reply))
          if warmed.id ~= -1 then raise "MPMC endpoint warmup failed" end
          local warm_reply = warm_channel(ReplyMsg(1, 3, "ok"))
          if warm_reply.value ~= 3 then raise "MPMC reply warmup failed" end
          gc.collect(); gc.collect()
          ready:send(1)
          local processed = 0
          for _, job? in rx:incoming() do
            if job == nil then raise "nil MPMC request" end
            if job.body ~= "request" then raise "invalid MPMC body" end
            local id = abs_int(job.id)
            if job.id > 0 then
              ffi.rtt_probe_trace_worker_recv(id as foreign int64_t)
              ffi.rtt_probe_trace_worker_reply_start(id as foreign int64_t)
            end
            traced_send(job.reply, ReplyMsg(id, id * 2 + 1, "ok"), 0)
            if job.id > 0 then
              ffi.rtt_probe_trace_worker_reply_done(id as foreign int64_t)
              processed = processed + 1
            end
          end
          return processed
        end, ep_rx, ready_tx, pool_tx[1])
      else
        workers[c] = thread.spawn_four<|
            thread.Receiver<|PlainJob|>, thread.Sender<|integer|>,
            ReplySenderPool, integer, integer|>(function (
              rx: thread.Receiver<|PlainJob|>, ready: thread.Sender<|integer|>,
              pool: ReplySenderPool, lanes: integer): integer
          local warmed = warm_channel(PlainJob(-1, "request", token_bytes))
          if warmed.id ~= -1 then raise "MPMC plain warmup failed" end
          local warm_reply = warm_channel(ReplyMsg(1, 3, "ok"))
          if warm_reply.value ~= 3 then raise "MPMC reply warmup failed" end
          gc.collect(); gc.collect()
          ready:send(1)
          local processed = 0
          for _, job? in rx:incoming() do
            if job == nil then raise "nil MPMC request" end
            if job.body ~= "request" then raise "invalid MPMC body" end
            local id = abs_int(job.id)
            local slot = (id - 1) % lanes + 1
            if job.id > 0 then
              ffi.rtt_probe_trace_worker_recv(id as foreign int64_t)
              ffi.rtt_probe_trace_worker_reply_start(id as foreign int64_t)
            end
            traced_send(pool.senders[slot], ReplyMsg(id, id * 2 + 1, "ok"), 0)
            if job.id > 0 then
              ffi.rtt_probe_trace_worker_reply_done(id as foreign int64_t)
              processed = processed + 1
            end
          end
          return processed
        end, plain_rx, ready_tx, reply_pool, in_flight)
      end
    end
    local warm_start = ffi.rtt_probe_now_ns()
    for p = 1, producers do
      if use_endpoint then
        local config = MpmcProducer<|RpcSenderJob|>(
          ep_tx, pool_rx, pool_tx, permits_rx, permits_tx, ready_tx, start_rx,
          done_tx, retire_rx, p, producers, in_flight, count, warmup)
        senders[p] = thread.spawn_one<|MpmcProducer<|RpcSenderJob|>, integer|>(
          function (cfg: MpmcProducer<|RpcSenderJob|>): integer
            return mpmc_produce(cfg, function (id: integer, slot: integer): RpcSenderJob
              return RpcSenderJob(id, "request", cfg.reply_senders[slot])
            end)
          end, config)
      else
        local config = MpmcProducer<|PlainJob|>(
          plain_tx, pool_rx, pool_tx, permits_rx, permits_tx, ready_tx, start_rx,
          done_tx, retire_rx, p, producers, in_flight, count, warmup)
        senders[p] = thread.spawn_one<|MpmcProducer<|PlainJob|>, integer|>(
          function (cfg: MpmcProducer<|PlainJob|>): integer
            return mpmc_produce(cfg, function (id: integer, _slot: integer): PlainJob
              return PlainJob(id, "request", token_bytes)
            end)
          end, config)
      end
    end
    for _ = 1, producers * in_flight + consumers do ready_rx:receive() end
    ffi.rtt_probe_mark_warmup_done(
      ffi.rtt_probe_now_ns() - warm_start, (warmup * producers * in_flight) as foreign int64_t)
    gc.collect(); gc.collect()
    ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
    for _ = 1, producers * in_flight do start_tx:send(1) end
    local sum = 0
    for _ = 1, producers do sum = sum + done_rx:receive() end
    ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)
    for _ = 1, producers do retire_tx:send(1) end
    local producer_sum = 0
    for p = 1, producers do producer_sum = producer_sum + join_worker(senders[p]) end
    if producer_sum ~= sum then raise "MPMC producer checksum mismatch" end
    plain_tx:close(); ep_tx:close()
    local processed = 0
    for c = 1, consumers do
      local worker_count = join_worker(workers[c])
      if ffi.rtt_probe_mpmc_consumer_done(c as foreign int, worker_count as foreign int64_t) == 0 then
        raise "MPMC consumer accounting failed"
      end
      processed = processed + worker_count
    end
    if processed ~= count or sum ~= count * (count + 2) then raise "MPMC lifecycle mismatch" end
    for slot = 1, pool_size do
      pool_tx[slot]:close(); pool_rx[slot]:close()
      permits_tx[slot]:close(); permits_rx[slot]:close()
    end
    plain_rx:close(); ep_rx:close()
    ready_tx:close(); ready_rx:close(); start_tx:close(); start_rx:close()
    done_tx:close(); done_rx:close(); retire_tx:close(); retire_rx:close()
    return sum
  end)
  ffi.rtt_probe_mark_workers_retired(gc.count() as foreign int64_t)
  return checksum, 0
end

local function run_wait_directed_case(
    case_name: string,
    count: integer,
    warmup: integer): (integer, integer)
  local req_wire = #protobuf.serialize(PlainJob(1, "request", token_bytes))
  local rep_wire = #protobuf.serialize(ReplyMsg(1, 3, "ok"))
  local wire_bytes = req_wire + rep_wire

  local checksum = run_in_runtime(function (): integer
    ffi.rtt_probe_mark_setup_start(gc.count() as foreign int64_t)
    local ready_tx, ready_rx = thread.channel<|integer|>(1)
    local step_tx, step_rx = thread.channel<|integer|>(1)

    if case_name == "wait_full_sender_record" then
      local req_tx, req_rx = thread.channel<|PlainJob|>(1)
      local rep_tx, rep_rx = thread.channel<|ReplyMsg|>(2)
      local worker = thread.spawn_four<|
          thread.Receiver<|PlainJob|>,
          thread.Receiver<|integer|>,
          thread.Sender<|ReplyMsg|>,
          thread.Sender<|integer|>,
          integer|>(function (
            rx: thread.Receiver<|PlainJob|>,
            st_rx: thread.Receiver<|integer|>,
            tx: thread.Sender<|ReplyMsg|>,
            rdy: thread.Sender<|integer|>): integer
        rdy:send(1)
        local processed = 0
        local previous_id = 0
        for _, step_id? in st_rx:incoming() do
          local sid = step_id or 0
          local job = rx:receive()
          if job.id ~= previous_id then raise "full sender admission lost FIFO identity" end
          previous_id = sid
          if #job.body == 0 then raise "invalid job" end
          if sid > 0 then
            tx:send(ReplyMsg(sid, sid * 2 + 1, "ok"))
            processed = processed + 1
          elseif sid < 0 then
            local a = -sid
            gc.collect(); gc.collect()
            tx:send(ReplyMsg(a, a * 2 + 1, "ok"))
          end
        end
        return processed
      end, req_rx, step_rx, rep_tx, ready_tx)

      ready_rx:receive()
      -- Pre-fill the capacity-1 channel so every subsequent send finds count == 1 (full!)
      req_tx:send(PlainJob(0, "prefill", token_bytes))

      local run_one = function (id: integer, timed: boolean): integer
        local t0: foreign int64_t = 0
        if timed then
          t0 = ffi.rtt_probe_now_ns()
          ffi.rtt_probe_trace_client_send_start(id as foreign int64_t, t0)
        end
        local sender_task = async.run<|nil, value|>(function (): nil
          if timed then
            traced_send(req_tx, PlainJob(id, "request", token_bytes), 0)
          else
            req_tx:send(PlainJob(id, "request", token_bytes))
          end
          return nil
        end)
        wait_until_waiting(sender_task)
        step_tx:send(id)
        await_task(sender_task)
        if timed then
          ffi.rtt_probe_trace_client_send_done(id as foreign int64_t, ffi.rtt_probe_now_ns())
        end
        local rep = timed and traced_receive(rep_rx) or rep_rx:receive()
        if timed then
          local t5 = ffi.rtt_probe_now_ns()
          ffi.rtt_probe_trace_client_reply_done(id as foreign int64_t, t5)
          ffi.rtt_probe_record_sample(t5 - t0)
        end
        return rep.value
      end

      local w_start = ffi.rtt_probe_now_ns()
      for i = 1, warmup do
        if run_one(-i, false) ~= i * 2 + 1 then raise "warmup full sender mismatch" end
      end
      ffi.rtt_probe_mark_warmup_done(ffi.rtt_probe_now_ns() - w_start, warmup as foreign int64_t)
      gc.collect()

      ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
      local sum = 0
      for i = 1, count do
        local v = run_one(i, true)
        if v ~= i * 2 + 1 then raise "full sender reply mismatch" end
        sum = sum + v
      end
      ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)

      -- Drain the 1 remaining item in req_rx
      step_tx:send(0)
      step_tx:close()
      if join_worker(worker) ~= count then raise "full sender worker count mismatch" end
      req_tx:close(); req_rx:close(); rep_tx:close(); rep_rx:close()
      ready_tx:close(); ready_rx:close(); step_rx:close()
      return sum

    elseif case_name == "wait_full_sender_endpoint" then
      local req_tx, req_rx = thread.channel<|RpcSenderJob|>(1)
      local rep_tx, rep_rx = thread.channel<|ReplyMsg|>(2)
      local worker = thread.spawn_three<|
          thread.Receiver<|RpcSenderJob|>,
          thread.Receiver<|integer|>,
          thread.Sender<|integer|>,
          integer|>(function (
            rx: thread.Receiver<|RpcSenderJob|>,
            st_rx: thread.Receiver<|integer|>,
            rdy: thread.Sender<|integer|>): integer
        rdy:send(1)
        local processed = 0
        local previous_id = 0
        for _, step_id? in st_rx:incoming() do
          local sid = step_id or 0
          local job = rx:receive()
          if job.id ~= previous_id then raise "full sender admission lost FIFO identity" end
          previous_id = sid
          if #job.body == 0 then raise "invalid endpoint job" end
          if sid > 0 then
            job.reply:send(ReplyMsg(sid, sid * 2 + 1, "ok"))
            processed = processed + 1
          elseif sid < 0 then
            local a = -sid
            gc.collect(); gc.collect()
            job.reply:send(ReplyMsg(a, a * 2 + 1, "ok"))
          end
        end
        return processed
      end, req_rx, step_rx, ready_tx)

      ready_rx:receive()
      req_tx:send(RpcSenderJob(0, "prefill", rep_tx))

      local run_one = function (id: integer, timed: boolean): integer
        local t0: foreign int64_t = 0
        if timed then
          t0 = ffi.rtt_probe_now_ns()
          ffi.rtt_probe_trace_client_send_start(id as foreign int64_t, t0)
        end
        local sender_task = async.run<|nil, value|>(function (): nil
          if timed then
            traced_send(req_tx, RpcSenderJob(id, "request", rep_tx), 1)
          else
            req_tx:send(RpcSenderJob(id, "request", rep_tx))
          end
          return nil
        end)
        wait_until_waiting(sender_task)
        step_tx:send(id)
        await_task(sender_task)
        if timed then
          ffi.rtt_probe_trace_client_send_done(id as foreign int64_t, ffi.rtt_probe_now_ns())
        end
        local rep = timed and traced_receive(rep_rx) or rep_rx:receive()
        if timed then
          local t5 = ffi.rtt_probe_now_ns()
          ffi.rtt_probe_trace_client_reply_done(id as foreign int64_t, t5)
          ffi.rtt_probe_record_sample(t5 - t0)
        end
        return rep.value
      end

      local w_start = ffi.rtt_probe_now_ns()
      for i = 1, warmup do
        if run_one(-i, false) ~= i * 2 + 1 then raise "warmup full sender endpoint mismatch" end
      end
      ffi.rtt_probe_mark_warmup_done(ffi.rtt_probe_now_ns() - w_start, warmup as foreign int64_t)
      gc.collect()

      ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
      local sum = 0
      for i = 1, count do
        local v = run_one(i, true)
        if v ~= i * 2 + 1 then raise "full sender endpoint reply mismatch" end
        sum = sum + v
      end
      ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)

      step_tx:send(0)
      step_tx:close()
      if join_worker(worker) ~= count then raise "full sender endpoint worker count mismatch" end
      req_tx:close(); req_rx:close(); rep_tx:close(); rep_rx:close()
      ready_tx:close(); ready_rx:close(); step_rx:close()
      return sum

    elseif case_name == "wait_empty_receiver_record" then
      local msg_tx, msg_rx = thread.channel<|PlainJob|>(1)
      local worker = thread.spawn_three<|
          thread.Sender<|PlainJob|>,
          thread.Receiver<|integer|>,
          thread.Sender<|integer|>,
          integer|>(function (
            tx: thread.Sender<|PlainJob|>,
            st_rx: thread.Receiver<|integer|>,
            rdy: thread.Sender<|integer|>): integer
        rdy:send(1)
        local processed = 0
        for _, step_id? in st_rx:incoming() do
          local sid = step_id or 0
          local a = abs_int(sid)
          if sid < 0 then gc.collect(); gc.collect() end
          tx:send(PlainJob(a, "request", token_bytes))
          if sid > 0 then processed = processed + 1 end
        end
        return processed
      end, msg_tx, step_rx, ready_tx)

      ready_rx:receive()
      local run_one = function (id: integer, timed: boolean): integer
        local t0: foreign int64_t = 0
        if timed then t0 = ffi.rtt_probe_now_ns() end
        local recv_task = async.run<|PlainJob, value|>(function (): PlainJob
          if timed then
            return traced_receive(msg_rx)
          else
            return msg_rx:receive()
          end
        end)
        wait_until_waiting(recv_task)
        step_tx:send(id)
        local job = await_task(recv_task)
        if timed then
          local t1 = ffi.rtt_probe_now_ns()
          ffi.rtt_probe_record_sample(t1 - t0)
        end
        if #job.body ~= 7 then raise "empty receiver record mismatch" end
        return job.id
      end

      local w_start = ffi.rtt_probe_now_ns()
      for i = 1, warmup do
        if run_one(-i, false) ~= i then raise "warmup empty receiver mismatch" end
      end
      ffi.rtt_probe_mark_warmup_done(ffi.rtt_probe_now_ns() - w_start, warmup as foreign int64_t)
      gc.collect()

      ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
      local sum = 0
      for i = 1, count do
        local v = run_one(i, true)
        if v ~= i then raise "empty receiver id mismatch" end
        sum = sum + v
      end
      ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)

      step_tx:close()
      if join_worker(worker) ~= count then raise "empty receiver worker count mismatch" end
      msg_tx:close(); msg_rx:close(); ready_tx:close(); ready_rx:close(); step_rx:close()
      return sum

    elseif case_name == "wait_empty_receiver_endpoint" then
      local msg_tx, msg_rx = thread.channel<|RpcSenderJob|>(1)
      local rep_tx, rep_rx = thread.channel<|ReplyMsg|>(1)
      local worker = thread.spawn_four<|
          thread.Sender<|RpcSenderJob|>,
          thread.Sender<|ReplyMsg|>,
          thread.Receiver<|integer|>,
          thread.Sender<|integer|>,
          integer|>(function (
            tx: thread.Sender<|RpcSenderJob|>,
            carried: thread.Sender<|ReplyMsg|>,
            st_rx: thread.Receiver<|integer|>,
            rdy: thread.Sender<|integer|>): integer
        rdy:send(1)
        local processed = 0
        for _, step_id? in st_rx:incoming() do
          local sid = step_id or 0
          local a = abs_int(sid)
          if sid < 0 then gc.collect(); gc.collect() end
          tx:send(RpcSenderJob(a, "request", carried))
          if sid > 0 then processed = processed + 1 end
        end
        return processed
      end, msg_tx, rep_tx, step_rx, ready_tx)

      ready_rx:receive()
      local run_one = function (id: integer, timed: boolean): integer
        local t0: foreign int64_t = 0
        if timed then t0 = ffi.rtt_probe_now_ns() end
        local recv_task = async.run<|RpcSenderJob, value|>(function (): RpcSenderJob
          if timed then
            return traced_receive(msg_rx)
          else
            return msg_rx:receive()
          end
        end)
        wait_until_waiting(recv_task)
        step_tx:send(id)
        local job = await_task(recv_task)
        if timed then
          local t1 = ffi.rtt_probe_now_ns()
          ffi.rtt_probe_record_sample(t1 - t0)
        end
        if #job.body ~= 7 then raise "empty receiver endpoint mismatch" end
        return job.id
      end

      local w_start = ffi.rtt_probe_now_ns()
      for i = 1, warmup do
        if run_one(-i, false) ~= i then raise "warmup empty receiver endpoint mismatch" end
      end
      ffi.rtt_probe_mark_warmup_done(ffi.rtt_probe_now_ns() - w_start, warmup as foreign int64_t)
      gc.collect()

      ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
      local sum = 0
      for i = 1, count do
        local v = run_one(i, true)
        if v ~= i then raise "empty receiver endpoint id mismatch" end
        sum = sum + v
      end
      ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)

      step_tx:close()
      if join_worker(worker) ~= count then raise "empty receiver endpoint worker count mismatch" end
      msg_tx:close(); msg_rx:close(); rep_tx:close(); rep_rx:close()
      ready_tx:close(); ready_rx:close(); step_rx:close()
      return sum
    end

    raise "unknown directed wait case: " .. case_name
  end)
  ffi.rtt_probe_mark_workers_retired(gc.count() as foreign int64_t)
  return checksum, wire_bytes
end

-- ============================================================================
-- Group 5: Close/Cancel Churn & Join Paths (Ordinary vs Cleanup Join)
-- ============================================================================

local function run_churn_or_join_case(
    case_name: string,
    count: integer,
    warmup: integer): (integer, integer)
  local checksum = run_in_runtime(function (): integer
    local run_one = function (idx: integer, timed: boolean): integer
      local t0: foreign int64_t = 0
      if timed then t0 = ffi.rtt_probe_now_ns() end
      local result_val = 0

      if case_name == "churn_close_parked_senders" then
        local tx, rx = thread.channel<|integer|>(1)
        tx:send(0) -- fill capacity 1
        local s1 = async.run<|integer, value|>(function (): integer
          local caught = false
          do
            if timed then traced_send(tx, idx, 0) else tx:send(idx) end
          catch
            caught = true
          end
          if not caught then raise "expected closed error on parked sender 1" end
          return 1
        end)
        local s2 = async.run<|integer, value|>(function (): integer
          local caught = false
          do
            if timed then traced_send(tx, idx + 1, 0) else tx:send(idx + 1) end
          catch
            caught = true
          end
          if not caught then raise "expected closed error on parked sender 2" end
          return 1
        end)
        wait_until_waiting(s1)
        wait_until_waiting(s2)
        rx:close()
        result_val = await_task(s1) + await_task(s2)
        tx:close()

      elseif case_name == "churn_close_parked_receivers" then
        local tx, rx = thread.channel<|integer|>(1)
        local r1 = async.run<|integer, value|>(function (): integer
          local res = timed and traced_receive_result(rx) or rx:receive_result()
          case res
          when closed() then return 1
          else raise "expected closed result on parked receiver 1"
          end
        end)
        local r2 = async.run<|integer, value|>(function (): integer
          local res = timed and traced_receive_result(rx) or rx:receive_result()
          case res
          when closed() then return 1
          else raise "expected closed result on parked receiver 2"
          end
        end)
        wait_until_waiting(r1)
        wait_until_waiting(r2)
        tx:close()
        result_val = await_task(r1) + await_task(r2)
        rx:close()

      elseif case_name == "churn_cancel_parked_waiters" then
        local tx, rx = thread.channel<|integer|>(1)
        tx:send(0) -- fill tx so s_task parks on overflow
        local empty_tx, empty_rx = thread.channel<|integer|>(1)
        local s_task = async.run<|integer, value|>(function (): integer
          if timed then traced_send(tx, idx, 0) else tx:send(idx) end
          return 0
        end)
        local r_task = async.run<|integer, value|>(function (): integer
          if timed then return traced_receive(empty_rx) else return empty_rx:receive() end
        end)
        wait_until_waiting(s_task)
        wait_until_waiting(r_task)
        s_task:cancel()
        r_task:cancel()
        case async.join(s_task)
        when cancelled() then result_val = result_val + 1
        else raise "expected s_task cancelled"
        end
        case async.join(r_task)
        when cancelled() then result_val = result_val + 1
        else raise "expected r_task cancelled"
        end
        tx:close(); rx:close(); empty_tx:close(); empty_rx:close()

      elseif case_name == "join_ordinary" then
        local rdy_tx, rdy_rx = thread.channel<|integer|>(1)
        local rel_tx, rel_rx = thread.channel<|integer|>(1)
        local worker = thread.spawn_two<|
            thread.Sender<|integer|>,
            thread.Receiver<|integer|>,
            integer|>(function (
              rdy: thread.Sender<|integer|>,
              rel: thread.Receiver<|integer|>): integer
          rdy:send(1)
          local v = rel:receive()
          return v + 1
        end, rdy_tx, rel_rx)
        rdy_rx:receive()
        local joiner = async.run<|integer, value|>(function (): integer
          local slot = -1 as foreign int
          if timed then
            slot = ffi.rtt_probe_op_begin(ffi.RTT_OP_JOIN as foreign int, 0)
          end
          local st = worker:join()
          if timed then
            ffi.rtt_probe_op_end(slot, ffi.RTT_OUTCOME_OK as foreign int)
          end
          case st
          when succeeded(v) then return v
          else raise "ordinary join failed"
          end
        end)
        wait_until_waiting(joiner)
        rel_tx:send(idx)
        result_val = await_task(joiner)
        rdy_tx:close(); rdy_rx:close(); rel_tx:close(); rel_rx:close()

      elseif case_name == "join_cleanup_cancelled_task" then
        local rdy_tx, rdy_rx = thread.channel<|integer|>(1)
        local blk_tx, blk_rx = thread.channel<|integer|>(1)
        local release_tx, release_rx = thread.channel<|integer|>(1)
        local worker = thread.spawn_three<|
            thread.Sender<|integer|>, thread.Receiver<|integer|>,
            thread.Receiver<|integer|>, integer|>(function (
              rdy: thread.Sender<|integer|>, blk: thread.Receiver<|integer|>,
              release: thread.Receiver<|integer|>): integer
          local gate = async.run<|integer, value|>(function (): integer
            return release:receive()
          end)
          defer do
            rdy:send(2)
            async.await_cleanup<|nil, value|>(function (
                resolve: function (nil): (),
                _reject: function (value): (),
                _fatal: function (value, string): ())
              if gate:status():has_finished() then
                resolve(nil)
              else
                gate:add_terminal_listener(function (_: async.TaskStatus<|integer, value|>)
                  resolve(nil)
                end)
              end
            end)
            case gate:status()
            when succeeded(v) then
              if v ~= 1 then raise "cleanup release mismatch" end
            else raise "cleanup release task did not succeed"
            end
          end
          rdy:send(1)
          return blk:receive()
        end, rdy_tx, blk_rx, release_rx)
        if rdy_rx:receive() ~= 1 then raise "cleanup worker not ready" end
        local mon = worker:task()
        wait_until_waiting(mon)
        mon:cancel()
        if rdy_rx:receive() ~= 2 then raise "child cleanup barrier not entered" end
        local released = false
        -- Cancellation has queued the proxy before this releaser. The Runtime
        -- FIFO runs its cleanup registrar before the newly queued Task.
        local releaser = async.run<|nil, value|>(function (): nil
          if mon:status():has_finished() then raise "proxy retired before child cleanup" end
          released = true
          release_tx:send(1)
          return nil
        end)
        case async.join(mon)
        when cancelled() then result_val = 1
        else raise "expected monitor task cancelled"
        end
        await_task(releaser)
        if not released then raise "proxy cleanup release was skipped" end
        rdy_tx:close(); rdy_rx:close(); blk_tx:close(); blk_rx:close()
        release_tx:close(); release_rx:close()

      else
        raise "unknown churn/join case: " .. case_name
      end

      if timed then
        local t1 = ffi.rtt_probe_now_ns()
        ffi.rtt_probe_record_sample(t1 - t0)
      end
      return result_val
    end

    local w_start = ffi.rtt_probe_now_ns()
    for i = 1, warmup do
      run_one(i, false)
    end
    ffi.rtt_probe_mark_warmup_done(ffi.rtt_probe_now_ns() - w_start, warmup as foreign int64_t)
    gc.collect()

    ffi.rtt_probe_mark_setup_start(gc.count() as foreign int64_t)
    ffi.rtt_probe_start_body(gc.count() as foreign int64_t)
    local sum = 0
    for i = 1, count do
      sum = sum + run_one(i, true)
    end
    ffi.rtt_probe_stop_body(gc.count() as foreign int64_t)
    return sum
  end)
  ffi.rtt_probe_mark_workers_retired(gc.count() as foreign int64_t)
  return checksum, 0
end

-- ============================================================================
-- Case catalog and main driver
-- ============================================================================

local function all_cases(): {CaseMeta}
  return {
    -- Group 1: Same-state codec & overhead controls
    CaseMeta("call_control", "same_state_codec", "same_state", 10000, 200, 1, 1, 1, 1),
    CaseMeta("overhead_control", "same_state_codec", "same_state", 10000, 200, 1, 1, 1, 1),
    CaseMeta("inspect_record", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("inspect_function", "same_state_codec", "same_state", 1000, 100, 1, 1, 1, 1),
    CaseMeta("codec_scalar_roundtrip", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_small_encode", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_small_decode", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_small_transfer_roundtrip", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_wide16_encode", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_wide16_decode", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_wide16_transfer_roundtrip", "same_state_codec", "same_state", 5000, 200, 1, 1, 1, 1),
    CaseMeta("codec_large64k_encode", "same_state_codec", "same_state", 256, 32, 1, 1, 1, 1),
    CaseMeta("codec_large64k_decode", "same_state_codec", "same_state", 256, 32, 1, 1, 1, 1),
    CaseMeta("codec_large64k_transfer_roundtrip", "same_state_codec", "same_state", 256, 32, 1, 1, 1, 1),
    CaseMeta("closure_roundtrip_cap0", "same_state_codec", "same_state", 1000, 100, 1, 1, 1, 1),
    CaseMeta("closure_roundtrip_cap1", "same_state_codec", "same_state", 1000, 100, 1, 1, 1, 1),
    CaseMeta("closure_roundtrip_cap8", "same_state_codec", "same_state", 1000, 100, 1, 1, 1, 1),
    CaseMeta("closure_roundtrip_cap64", "same_state_codec", "same_state", 1000, 100, 1, 1, 1, 1),
    CaseMeta("closure_roundtrip_complex_sig", "same_state_codec", "same_state", 1000, 100, 1, 1, 1, 1),

    -- Group 2: Same-state immediate nonblocking queue controls
    CaseMeta("queue_plain_bytes8", "same_state_queue", "same_state_queue", 5000, 200, 1, 1, 1, 1),
    CaseMeta("queue_opaque_hook8", "same_state_queue", "same_state_queue", 5000, 200, 1, 1, 1, 1),
    CaseMeta("queue_packed_hook8", "same_state_queue", "same_state_queue", 5000, 200, 1, 1, 1, 1),
    CaseMeta("queue_real_sender", "same_state_queue", "same_state_queue", 5000, 200, 1, 1, 1, 1),
    CaseMeta("queue_real_receiver", "same_state_queue", "same_state_queue", 5000, 200, 1, 1, 1, 1),
    CaseMeta("sender_clone", "same_state_queue", "same_state_queue", 5000, 200, 1, 1, 1, 1),

    -- Group 3: Cross-thread SPSC request/reply
    CaseMeta("spsc_scalar_persistent", "spsc_rtt", "persistent_reply", 1000, 64, 1, 1, 1, 1),
    CaseMeta("spsc_record_persistent", "spsc_rtt", "persistent_reply", 1000, 64, 1, 1, 1, 1),
    CaseMeta("spsc_opaque_persistent", "spsc_rtt", "persistent_reply", 1000, 64, 1, 1, 1, 1),
    CaseMeta("spsc_endpoint_carried_persistent", "spsc_rtt", "persistent_reply", 1000, 64, 1, 1, 1, 1),
    CaseMeta("spsc_record_pool4_control", "spsc_rtt", "pool_four_reply", 1000, 64, 1, 1, 1, 1),
    CaseMeta("spsc_endpoint_pool4_reply", "spsc_rtt", "pool_four_reply", 1000, 64, 1, 1, 1, 1),
    CaseMeta("spsc_endpoint_fresh_reply", "spsc_rtt", "fresh_reply", 500, 32, 1, 1, 1, 1),
    CaseMeta("spsc_large64k_persistent", "spsc_rtt", "persistent_reply", 256, 16, 1, 1, 1, 1),
    CaseMeta("spsc_large64k_endpoint_pool4", "spsc_rtt", "pool_four_reply", 256, 16, 1, 1, 1, 1),

    -- Group 4: Cross-thread Bounded MPMC & Directed Full/Empty Waits
    CaseMeta("mpmc_record_inflight1_cap1_2p2c", "mpmc_rtt", "pool_four_reply", 1000, 64, 1, 2, 2, 1),
    CaseMeta("mpmc_endpoint_inflight1_cap1_2p2c", "mpmc_rtt", "pool_four_reply", 1000, 64, 1, 2, 2, 1),
    CaseMeta("mpmc_record_inflight4_cap1_2p2c", "mpmc_rtt", "pool_four_reply", 1000, 64, 4, 2, 2, 1),
    CaseMeta("mpmc_endpoint_inflight4_cap1_2p2c", "mpmc_rtt", "pool_four_reply", 1000, 64, 4, 2, 2, 1),
    CaseMeta("mpmc_record_inflight4_cap4_2p2c", "mpmc_rtt", "pool_four_reply", 1000, 64, 4, 2, 2, 4),
    CaseMeta("mpmc_endpoint_inflight4_cap4_2p2c", "mpmc_rtt", "pool_four_reply", 1000, 64, 4, 2, 2, 4),
    CaseMeta("mpmc_record_inflight16_cap2_4p4c", "mpmc_rtt", "pool_16_reply", 1000, 64, 16, 4, 4, 2),
    CaseMeta("mpmc_endpoint_inflight16_cap2_4p4c", "mpmc_rtt", "pool_16_reply", 1000, 64, 16, 4, 4, 2),
    CaseMeta("mpmc_record_inflight16_cap16_4p4c", "mpmc_rtt", "pool_16_reply", 1000, 64, 16, 4, 4, 16),
    CaseMeta("mpmc_endpoint_inflight16_cap16_4p4c", "mpmc_rtt", "pool_16_reply", 1000, 64, 16, 4, 4, 16),
    CaseMeta("wait_full_sender_record", "mpmc_rtt", "directed_full_wait", 500, 32, 1, 1, 1, 1),
    CaseMeta("wait_full_sender_endpoint", "mpmc_rtt", "directed_full_wait", 500, 32, 1, 1, 1, 1),
    CaseMeta("wait_empty_receiver_record", "mpmc_rtt", "directed_empty_wait", 500, 32, 1, 1, 1, 1),
    CaseMeta("wait_empty_receiver_endpoint", "mpmc_rtt", "directed_empty_wait", 500, 32, 1, 1, 1, 1),

    -- Group 5: Close/Cancel Churn & Join Paths
    CaseMeta("churn_close_parked_senders", "churn_and_join", "close_churn", 500, 32, 2, 2, 1, 1),
    CaseMeta("churn_close_parked_receivers", "churn_and_join", "close_churn", 500, 32, 2, 1, 2, 1),
    CaseMeta("churn_cancel_parked_waiters", "churn_and_join", "cancel_churn", 500, 32, 2, 1, 1, 1),
    CaseMeta("join_ordinary", "churn_and_join", "ordinary_join", 100, 8, 1, 1, 1, 1),
    CaseMeta("join_cleanup_cancelled_task", "churn_and_join", "cleanup_join", 100, 8, 1, 1, 1, 1)
  }
end

local function find_case(name: string): CaseMeta
  local catalog = all_cases()
  for i = 1, #catalog do
    if catalog[i].name == name then
      return catalog[i]
    end
  end
  raise "unknown benchmark case: " .. name
end

local function measure_cold_first_use(): integer
  local t0 = ffi.rtt_probe_now_ns()
  local v = run_in_runtime(function (): integer
    local tx, rx = thread.channel<|PlainJob|>(1)
    local rep_tx, rep_rx = thread.channel<|ReplyMsg|>(1)
    local w = thread.spawn_two<|
        thread.Receiver<|PlainJob|>,
        thread.Sender<|ReplyMsg|>,
        integer|>(function (
          r: thread.Receiver<|PlainJob|>,
          p: thread.Sender<|ReplyMsg|>): integer
      local j = r:receive()
      p:send(ReplyMsg(j.id, j.id + 1, "cold"))
      return 1
    end, rx, rep_tx)
    tx:send(PlainJob(1, "request", token_bytes))
    local rep = rep_rx:receive()
    tx:close(); rx:close(); rep_tx:close(); rep_rx:close()
    return join_worker(w) + rep.value
  end)
  local elapsed = ffi.rtt_probe_now_ns() - t0
  if v ~= 3 then raise "cold first-use checksum mismatch" end
  gc.collect()
  gc.collect()
  return elapsed as integer
end

function main(args: {string}): integer
  if #args < 1 then
    raise "usage: bench <case_name> [count] [warmup] [instrumented:0|1] [raw_samples_path]"
  end
  local meta = find_case(args[1])
  local count = (#args >= 2) and parse_int(args[2]) or meta.default_count
  local warmup = (#args >= 3) and parse_int(args[3]) or meta.default_warmup
  local instrumented = (#args >= 4) and parse_int(args[4]) or 0
  local raw_samples_path = (#args >= 5) and args[5] or ""
  local request_trace_path = ""
  if meta.category == "mpmc_rtt" and meta.producers > 1 and raw_samples_path ~= "" then
    request_trace_path = raw_samples_path .. ".requests.tsv"
  end
  if count < 1 or count > 1000000 or warmup < 1 or
     (instrumented ~= 0 and instrumented ~= 1) then
    raise "invalid benchmark counts or instrumentation mode"
  end

  local cold_ns = measure_cold_first_use()

  local sample_cap = count + 64
  if sample_cap < 1024 then sample_cap = 1024 end
  if ffi.rtt_probe_init(
      sample_cap as foreign int64_t,
      (count + 16) as foreign int64_t,
      instrumented as foreign int) == 0 then
    raise "rtt_probe_init failed (sample allocation or accounting calibration failure)"
  end
  defer ffi.rtt_probe_cleanup()

  ffi.rtt_probe_mark_cold_done(cold_ns as foreign int64_t)
  ffi.rtt_probe_mark_setup_start(gc.count() as foreign int64_t)

  local checksum = 0
  local wire_bytes = 0
  if meta.category == "same_state_codec" then
    checksum, wire_bytes = run_codec_case(meta.name, count, warmup)
  elseif meta.category == "same_state_queue" then
    checksum, wire_bytes = run_same_state_queue_case(meta.name, count, warmup)
  elseif meta.category == "spsc_rtt" then
    checksum, wire_bytes = run_spsc_case(meta.name, count, warmup)
  elseif meta.category == "mpmc_rtt" then
    if meta.protocol == "directed_full_wait" or meta.protocol == "directed_empty_wait" then
      checksum, wire_bytes = run_wait_directed_case(meta.name, count, warmup)
    else
      local use_ep = string.find(meta.name, "endpoint", 1) ~= nil
      checksum, wire_bytes = run_mpmc_pool_case(
        use_ep, meta.in_flight, meta.producers, meta.consumers,
        meta.capacity, count, warmup)
    end
  elseif meta.category == "churn_and_join" then
    checksum, wire_bytes = run_churn_or_join_case(meta.name, count, warmup)
  else
    raise "unsupported category: " .. meta.category
  end
  if ffi.rtt_probe_quiesce() == 0 then raise "native workers did not retire" end
  ffi.rtt_probe_set_wire_bytes(wire_bytes as foreign int64_t)

  -- Two explicit post-retirement GC passes to measure residual reclamation
  -- and two-phase finalizer completion outside the main timing window.
  local gc1_t0 = ffi.rtt_probe_now_ns()
  gc.collect()
  local gc1_ns = ffi.rtt_probe_now_ns() - gc1_t0
  ffi.rtt_probe_mark_post_gc1(gc1_ns, gc.count() as foreign int64_t)

  local gc2_t0 = ffi.rtt_probe_now_ns()
  gc.collect()
  local gc2_ns = ffi.rtt_probe_now_ns() - gc2_t0
  if ffi.rtt_probe_quiesce() == 0 then raise "native worker epilogue did not retire" end
  ffi.rtt_probe_mark_post_gc2(gc2_ns, gc.count() as foreign int64_t)

  if ffi.rtt_probe_finish_json(
      meta.name,
      meta.category,
      meta.protocol,
      count as foreign int64_t,
      meta.in_flight as foreign int64_t,
      meta.producers as foreign int64_t,
      meta.consumers as foreign int64_t,
      meta.capacity as foreign int64_t,
      checksum as foreign int64_t,
      raw_samples_path, request_trace_path) == 0 then
    raise "rtt_probe_finish_json failed"
  end
  return 0
end
