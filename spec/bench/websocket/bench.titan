-- Private consumer of the installed public provider. Never source-import stdlib.
local async = import "async"
local fs = import "fs"
local http = import "http"
local io = import "io"
local net = import "net"
local ssl = import "ssl"
local timer = import "timer"
local uv = import "uv"
local websocket = import "websocket"

local record RunState
  done: boolean
  closing: boolean
  failure: value
  connection: websocket.Connection?
  waiter: async.Task?
  token: async.ResumeToken
end

local function succeeded(task: async.Task)
  local status = async.join(task)
  if status:has_failed() then
    local _, failure? = status:has_failed()
    failure:raise()
  end
  if not status:has_succeeded() then raise "benchmark Task did not succeed" end
end

local function ignore_endpoint(_endpoint: value)
end
local function ignore_boundary()
end

local function raw_body(stream: io.ReaderWriterCloser, operation: string,
                        count: integer, payload: string)
  if operation ~= "write" then
    local received = 0
    local expected = count * #payload
    while received < expected do
      local chunk? = stream:read()
      if chunk == nil then raise "raw peer ended before byte budget" end
      received = received + #chunk
    end
    if received ~= expected then raise "raw peer exceeded byte budget" end
    return
  end
  for _ = 1, count do
    stream:write(payload)
  end
end

local function ws_body(connection: websocket.Connection, operation: string,
                       count: integer, payload: string, kind: string)
  for _ = 1, count do
    if operation == "write" then
      if kind == "text" then connection:write(websocket.TEXT, payload)
      else connection:write(websocket.BINARY, payload) end
    elseif operation == "ping" then
      connection:ping(5000)
    else
      local actual_kind?, actual? = connection:read()
      if actual == nil or actual ~= payload or actual_kind == nil then
        raise "WebSocket peer returned wrong bytes"
      end
      local actual_text = false
      case actual_kind when text() then actual_text = true when binary() then end
      if actual_text ~= (kind == "text") then raise "wrong message kind" end
    end
  end
end

-- A marker proves the peer finished submitting the declared finite flood.
-- It does not prove how bytes are partitioned between TCP/TLS/WS buffers.
local function preload(marker: string)
  while true do
    local ready = false
    do ready = fs.read_file(marker) == "preloaded\n"
    catch
      if not (error is async.OperationError and
              (error as async.OperationError).name == "ENOENT") then raise end
    end
    if ready then break end
    timer.sleep(1)
  end
end

local record FloodState
  done: boolean
  entered: integer
end

local function flood(connection: websocket.Connection, count: integer,
                     payload: string, marker: string, tasks_count: integer,
                     begin: function (integer, integer): (),
                     sample: function (integer): ())
  preload(marker)
  local state = FloodState(false, 0)
  local children: {async.Task<|nil, nil|>} = {}
  -- Preallocate native arrays before timer/children are admitted to sampling.
  local sample_budget = 4000000 // tasks_count
  if sample_budget > 1000000 then sample_budget = 1000000 end
  begin(tasks_count, sample_budget)
  local clock = uv.timer_t.new()
  local handle = clock:as_handle_t()
  if uv.timer_init(async.current_loop(), clock) < 0 then raise "timer init" end
  defer uv.close(handle)
  if uv.timer_start(clock, function (_: uv.timer_t) sample(0) end, 1, 1) < 0 then
    raise "timer start"
  end
  for index = 1, tasks_count do
    local owner = index
    children[index] = async.run<|nil, nil|>(function (): nil
      state.entered = state.entered + 1
      sample(owner)
      while not state.done do
        async.yield()
        sample(owner)
      end
      return nil
    end)
  end
  while state.entered < tasks_count do async.yield() end
  defer do
    state.done = true
    uv.timer_stop(clock)
  end
  -- No caller yield in this loop: scheduling progress is the provider's duty.
  ws_body(connection, "read", count, payload, "binary")
  state.done = true
  uv.timer_stop(clock)
  for index = 1, tasks_count do succeeded(children[index]) end
end

local function session(connection: websocket.Connection, state: RunState,
                       operation: string, count: integer, payload: string,
                       kind: string, cleanup: string, marker: string,
                       tasks_count: integer, ready: function (value): (),
                       body_done: function (): (), closed: function (): (),
                       begin: function (integer, integer): (),
                       sample: function (integer): ())
  state.connection = connection
  defer connection:close()
  local reader: async.Task<|nil, nil|>? = nil
  if operation == "ping" then
    reader = async.run<|nil, nil|>(function (): nil
      do
        while true do
          local _, bytes? = connection:read()
          if bytes == nil then break end
          raise "unexpected data in ping lane"
        end
      catch if not state.closing then raise end end
      return nil
    end)
    -- This scheduling point only admits the required concurrent reader.
    async.yield()
  end
  ready(connection)
  if operation == "fairness" then
    flood(connection, count, payload, marker, tasks_count, begin, sample)
  else ws_body(connection, operation, count, payload, kind) end
  body_done()
  state.closing = true
  if cleanup == "graceful" then connection:shutdown(1000, "", 5000)
  else connection:close() end
  if reader then succeeded(reader) end
  closed()
end

function launch(transport: string, role: string, operation: string,
                count: integer, port: integer, payload: string, kind: string,
                cleanup: string, ca: string, certificate: string, key: string,
                marker: string, tasks_count: integer,
                ready: function (value): (), body_done: function (): (),
                closed: function (): (),
                begin: function (integer, integer): (),
                sample: function (integer): ()): async.Task<|nil, nil|>
  return async.run<|nil, nil|>(function (): nil
    if operation == "sessions" then
      ready(nil)
      for _ = 1, count do
        succeeded(M.launch(transport, role, "read", 0, port, payload, kind,
          cleanup, ca, certificate, key, marker, tasks_count, ignore_endpoint,
          ignore_boundary, ignore_boundary, begin, sample))
      end
      body_done()
      closed()
      return nil
    end
    if transport == "control" then
      ready(nil)
      for _ = 1, count do end
      body_done()
      closed()
      return nil
    end
    local secure = transport == "wss" or transport == "tls"
    local ws = transport == "ws" or transport == "wss"
    if role == "client" then
      if ws then
        local scheme = "ws"
        if secure then scheme = "wss" end
        local options = websocket.DialOptions { ca_file = ca }
        local connection = websocket.connect(scheme .. "://localhost:" .. port .. "/bench", options)
        session(connection, RunState(false, false, nil, nil, nil,
                                    async.ResumeToken("benchmark handler")), operation, count,
                payload, kind, cleanup, marker, tasks_count, ready, body_done,
                closed, begin, sample)
      elseif secure then
        local connection = ssl.connect("localhost", port, ca)
        defer connection:abort()
        ready(connection)
        raw_body(connection, operation, count, payload)
        body_done()
        connection:abort()
        closed()
      else
        local connection = net.connect("127.0.0.1", port)
        defer connection:close()
        ready(connection)
        raw_body(connection, operation, count, payload)
        body_done()
        connection:close()
        closed()
      end
    elseif ws then
      local state = RunState(false, false, nil, nil, nil,
                             async.ResumeToken("benchmark handler"))
      local handler: http.Handler = function (request: http.Request, response: http.Response)
        do
          local connection = websocket.accept(request, response)
          session(connection, state, operation, count, payload, kind, cleanup,
                  marker, tasks_count, ready, body_done, closed, begin, sample)
        catch state.failure = error end
        state.done = true
        if state.waiter then state.waiter:resume(state.token) end
      end
      local listener: http.Server? = nil
      if secure then listener = http.listen_tls("127.0.0.1", certificate, handler, key, port)
      else listener = http.listen("127.0.0.1", handler, port) end
      defer listener:close()
      local serving = async.run<|nil, nil|>(function (): nil listener:serve(); return nil end)
      if not state.done then
        state.waiter = async.running()
        defer do state.waiter = nil end
        async.suspend(state.token)
      end
      listener:close()
      succeeded(serving)
      if state.failure ~= nil then raise state.failure end
    elseif secure then
      local listener = ssl.listen("127.0.0.1", port, certificate, key)
      defer listener:close()
      local connection = listener:accept()
      defer connection:abort()
      connection:handshake()
      ready(connection)
      raw_body(connection, operation, count, payload)
      body_done()
      connection:abort()
      listener:close()
      closed()
    else
      local listener = net.listen("127.0.0.1", port)
      defer listener:close()
      local connection = listener:accept()
      defer connection:close()
      ready(connection)
      raw_body(connection, operation, count, payload)
      body_done()
      connection:close()
      listener:close()
      closed()
    end
    return nil
  end)
end
