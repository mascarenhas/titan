# Additive native Windows standard-library workflow. Include after the runtime,
# native-dependency and compiler fragments, or pass as a second -f Makefile.
# The initial experimental build compiles all roots serially; no warm-build
# completion stamp is claimed until the complete Windows provider is validated.
.PHONY: stdlib stdlib-check install-stdlib publish-stdlib stdlib-publication-check windows-stdlib-help
stdlib: compiler runtime native
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  bash scripts/build_windows_stdlib.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

stdlib-check:
	bash scripts/publish_windows_stdlib.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) check

install-stdlib: stdlib
	bash scripts/publish_windows_stdlib.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) publish

# Publishing an already built stage must not rebuild or replace its inputs.
publish-stdlib:
	bash scripts/publish_windows_stdlib.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) publish

stdlib-publication-check: runtime
	bash scripts/check_windows_publication.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

# The source inventory is identical to the Unix aggregate. Windows keeps its
# native outputs and copied SDK in an explicitly owned local NTFS workspace.
include spec/support/stdlib_test_modules.mk
TITAN_TEST_BUILD_DIR ?= $(WINDOWS_BUILD_ROOT)/stdlib-tests
TITAN_TEST_TIMEOUT ?= 300
TITAN_FILTER ?=
.PHONY: titan-stdlib-test-build titan-stdlib-test-run titan-stdlib-test
titan-stdlib-test-build:
	CC=$(call quote,$(CC)) TITAN_TEST_TIMEOUT=$(call quote,$(TITAN_TEST_TIMEOUT)) \
	  bash scripts/windows_stdlib_tests.sh build $(call quote,$(TITAN_TEST_BUILD_DIR)) $(call quote,$(PREFIX))

titan-stdlib-test-run:
	TITAN_TEST_TIMEOUT=$(call quote,$(TITAN_TEST_TIMEOUT)) TITAN_FILTER=$(call quote,$(TITAN_FILTER)) \
	  bash scripts/windows_stdlib_tests.sh run $(call quote,$(TITAN_TEST_BUILD_DIR))

titan-stdlib-test: titan-stdlib-test-build
	$(MAKE) -f Makefile.windows titan-stdlib-test-run

windows-stdlib-help:
	@echo '  stdlib          compile the 22 Windows roots into titan.dll and exact shims'
	@echo '  stdlib-check    validate the staged DLL, metadata, shims and PE inventory'
	@echo '  install-stdlib  build, validate and publish the Windows DLL-only provider'
	@echo '  publish-stdlib  validate and publish an already built Windows provider'
	@echo '  stdlib-publication-check  exercise commit/rollback with a mapped native DLL'
	@echo '  titan-stdlib-test-build  build every shared native test in a private NTFS SDK copy'
	@echo '  titan-stdlib-test-run  run that aggregate, optionally with TITAN_FILTER'
	@echo '  titan-stdlib-test  build and run the shared native aggregate'
