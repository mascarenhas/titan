#!/usr/bin/env lua

local usage = "Usage: titan-uninstall [--luarocks PATH]\n" ..
    "       titan-uninstall ROCK [VERSION]"
if #arg == 1 and arg[1] == "--help" then
    print(usage .. "\nRemove Titan from this installation tree, or remove one published module rock.")
    return
end
local luarocks, rock, version
if #arg == 2 and arg[1] == "--luarocks" and arg[2] ~= "" then
    luarocks = arg[2]
elseif #arg > 0 and #arg <= 2 and arg[1]:match("^[A-Za-z0-9]") then
    rock, version = arg[1], arg[2]
elseif #arg > 0 then
    io.stderr:write(usage, "\n")
    os.exit(2)
end
local script = arg[0]
if package.config:sub(1, 1) == "\\" then script = script:gsub("\\", "/") end
local private = assert(script:match("^(.*)/bin/[^/]+$"),
    "cannot locate Titan's private installation directory")
local installer = assert(loadfile(private .. "/installer/titan_install.lua"))()
local called, removed, message
if rock then
    called, removed, message = pcall(installer.uninstall_module, private, rock, version)
else
    called, removed, message = pcall(installer.uninstall, private, luarocks)
end
if not called or not removed then
    io.stderr:write(tostring(called and message or removed), "\n")
    os.exit(1)
end
print(message or "Titan was removed. Lua and shared dependencies were preserved.")
