# Included only by Makefile.windows; ordinary POSIX recipes are unchanged.
.PHONY: compiler-source compiler-deps compiler compiler-check
compiler-source:
	perl scripts/prepare_windows_native.pl $(call quote,$(WINDOWS_BUILD_ROOT)/compiler-src) vendor/windows-compiler/dependencies.tsv

compiler-deps: compiler-source lua check-windows-toolchain
	CC=$(call quote,$(CC)) RC=$(call quote,$(RC)) bash scripts/build_windows_compiler.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) deps

compiler: compiler-deps
	CC=$(call quote,$(CC)) RC=$(call quote,$(RC)) bash scripts/build_windows_compiler.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) compiler

compiler-check: compiler
	bash scripts/check_windows_compiler.sh $(call quote,$(PREFIX)) $(call quote,$(WINDOWS_BUILD_ROOT))
