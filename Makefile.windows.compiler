# Included only by Makefile.windows; ordinary POSIX recipes are unchanged.
COMPILER_CFLAGS ?= $(TITAN_WINDOWS_NATIVE_CFLAGS) -Wall -Wextra
COMPILER_CPPFLAGS ?=
COMPILER_LDFLAGS ?= $(TITAN_WINDOWS_NATIVE_LDFLAGS)
.PHONY: compiler-source compiler-deps compiler compiler-check
compiler-source:
	perl scripts/prepare_windows_native.pl $(call quote,$(WINDOWS_BUILD_ROOT)/compiler-src) vendor/windows-compiler/dependencies.tsv

compiler-deps: compiler-source lua check-windows-toolchain
	CC=$(call quote,$(CC)) RC=$(call quote,$(RC)) \
	  COMPILER_CFLAGS=$(call quote,$(COMPILER_CFLAGS)) COMPILER_CPPFLAGS=$(call quote,$(COMPILER_CPPFLAGS)) \
	  COMPILER_LDFLAGS=$(call quote,$(COMPILER_LDFLAGS)) \
	  bash scripts/build_windows_compiler.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) deps

compiler: compiler-deps
	CC=$(call quote,$(CC)) RC=$(call quote,$(RC)) \
	  COMPILER_CFLAGS=$(call quote,$(COMPILER_CFLAGS)) COMPILER_CPPFLAGS=$(call quote,$(COMPILER_CPPFLAGS)) \
	  COMPILER_LDFLAGS=$(call quote,$(COMPILER_LDFLAGS)) \
	  bash scripts/build_windows_compiler.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) compiler

compiler-check: compiler
	bash scripts/check_windows_compiler.sh $(call quote,$(PREFIX)) $(call quote,$(WINDOWS_BUILD_ROOT))
