local uv = import "titan.uv"

local function check(status: integer)
  if status < 0 then raise uv.strerror(status) end
end

local function child(): integer
  local request = uv.fs_t()
  local text = uv.buf_t.from_string("child output\n")
  local written = uv.fs_write(nil, request, 1, {text}, -1, nil)
  defer uv.fs_req_cleanup(request)
  if written ~= text:length() then return 1 end
  return 0
end

local function close_owner(handle: uv.handle_t)
  if handle:is_initialized() and not uv.is_closing(handle) then uv.close(handle, nil) end
end

function main(args: {string}): integer
  if #args > 0 and args[1] == "--child" then return child() end
  uv.setup_process_args() -- Uses only the generated entrypoint's original argv.
  local executable_status, executable?, executable_length = uv.exepath(4096)
  check(executable_status)
  local loop = uv.loop_t()
  check(uv.loop_init(loop))
  local pipe, process, deadline = uv.pipe_t(), uv.process_t(), uv.timer_t()
  local exited, eof, closing = false, false, false
  local child_status, child_signal = 0, 0
  local output = ""
  local finish = function ()
    closing = true
    local process_handle = process:as_handle_t()
    -- A negative spawn result can still leave an active child watcher.
    -- Observe this caller-owned native lifetime, not the submission status.
    local awaiting_exit = process_handle:is_initialized() and
                          not exited and uv.is_active(process_handle)
    if awaiting_exit then
      local signalled = uv.process_kill(process, uv.SIGTERM)
      if signalled ~= uv.ESRCH then check(signalled) end
    end
    close_owner(pipe:as_handle_t())
    close_owner(deadline:as_handle_t())
    if not awaiting_exit then
      -- An initialized inactive failed owner still needs close. An active
      -- watcher must stay open until the actual exit callback below closes it.
      close_owner(process_handle)
    end
    uv.run(loop, nil)
    close_owner(process:as_handle_t())
    uv.run(loop, nil)
    check(uv.loop_close(loop))
  end
  defer finish()
  check(uv.pipe_init(loop, pipe, 0))
  check(uv.timer_init(loop, deadline))
  local complete = function ()
    if exited and eof then
      close_owner(deadline:as_handle_t())
    end
  end
  local options = uv.process_options_t(executable, {executable, "--child"})
  options.stdio = {
    uv.stdio_container_t(uv.IGNORE, uv.stdio_data_t.fd(-1)),
    uv.stdio_container_t(uv.CREATE_PIPE | uv.WRITABLE_PIPE,
                        uv.stdio_data_t.stream(pipe:as_stream_t())),
    uv.stdio_container_t(uv.INHERIT_FD, uv.stdio_data_t.fd(2)),
  }
  options.exit_cb = function (owner: uv.process_t, status: integer, signum: integer)
    child_status = status
    child_signal = signum
    exited = true
    uv.close(owner:as_handle_t(), nil)
    if not closing then complete() end
  end
  local spawn_status = uv.spawn(loop, process, options)
  check(spawn_status)
  check(uv.read_start(pipe:as_stream_t(),
    function (handle: uv.handle_t, suggested: integer): uv.buf_t
      return uv.buf_t.allocate(1024)
    end,
    function (stream: uv.stream_t, count: integer, bytes: uv.buf_t?)
      if closing then return end
      if count == uv.EOF then
        eof = true
        check(uv.read_stop(stream))
        uv.close(pipe:as_handle_t(), nil)
        complete()
      elseif count < 0 then
        check(count)
      elseif count > 0 then
        output = output .. bytes:to_string(count)
      end
    end))
  check(uv.timer_start(deadline, function (owner: uv.timer_t)
    if not closing then raise "child process example timed out" end
  end, 5000, 0))
  uv.run(loop, nil)
  if not exited or not eof or child_status ~= 0 or child_signal ~= 0 then return 1 end
  if output ~= "child output\n" then return 1 end
  return 0
end
