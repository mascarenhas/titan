local uv = import "titan.uv"

local function check(status: integer)
  if status < 0 then raise uv.strerror(status) end
end

local function close_handles(loop: uv.loop_t)
  uv.walk(loop, function (handle: uv.handle_t, argument: value)
    if not uv.is_closing(handle) then uv.close(handle, nil) end
  end, nil)
end

function main(args: {string}): integer
  local loop = uv.loop_t()
  check(uv.loop_init(loop))
  local closing = false
  local finish = function ()
    closing = true
    close_handles(loop)
    uv.run(loop, nil)
    check(uv.loop_close(loop))
  end
  defer finish()

  local receiver, sender = uv.udp_t(), uv.udp_t()
  check(uv.udp_init(loop, receiver))
  check(uv.udp_init(loop, sender))
  local deadline = uv.timer_t()
  check(uv.timer_init(loop, deadline))
  check(uv.timer_start(deadline, function (owner: uv.timer_t)
    if not closing then raise "UDP example timed out" end
  end, 5000, 0))
  local address_status, address? = uv.ip4_addr("127.0.0.1", 0)
  check(address_status)
  check(uv.udp_bind(receiver, address, 0))
  local name_status, destination?, address_length = uv.udp_getsockname(receiver)
  check(name_status)

  local sent, received = false, false
  local received_bytes: uv.buf_t?
  local source_address: uv.sockaddr_t?
  local complete = function ()
    if sent and received then
      closing = true
      close_handles(loop)
    end
  end
  check(uv.udp_recv_start(receiver,
    function (handle: uv.handle_t, suggested: integer): uv.buf_t
      return uv.buf_t.allocate(128)
    end,
    function (owner: uv.udp_t, count: integer, bytes: uv.buf_t?,
              source: uv.sockaddr_t?, flags: integer)
      if closing then return end
      check(count)
      if source == nil then return end -- A no-data notification is not a packet.
      if count ~= 4 or bytes:to_string(count) ~= "ping" then
        raise "unexpected UDP payload"
      end
      received_bytes = bytes
      source_address = source -- A copied address survives the callback/close.
      received = true
      check(uv.udp_recv_stop(owner))
      complete()
    end))
  local request = uv.udp_send_t()
  local payload = uv.buf_t.from_string("ping")
  check(uv.udp_send(request, sender, {payload}, destination,
    function (owner: uv.udp_send_t, status: integer)
      if closing then return end
      check(status)
      sent = true
      complete()
    end))
  -- Accepted request retains payload and vector descriptors through completion.
  uv.run(loop, nil)
  if not sent or not received then return 1 end
  if received_bytes:to_string(4) ~= "ping" or source_address:port() <= 0 then
    return 1
  end
  return 0
end
