local uv = import "titan.uv"

local function check(status: integer)
  if status < 0 then raise uv.strerror(status) end
end

local function close_handles(loop: uv.loop_t)
  uv.walk(loop, function (handle: uv.handle_t, argument: value)
    if not uv.is_closing(handle) then uv.close(handle, nil) end
  end, nil)
end

function main(args: {string}): integer
  local loop = uv.loop_t()
  check(uv.loop_init(loop))
  local closing = false
  local finish = function ()
    closing = true
    close_handles(loop)
    -- Closing streams still delivers accepted request terminal callbacks.
    uv.run(loop, nil)
    check(uv.loop_close(loop))
  end
  defer finish()

  local server, peer, client = uv.tcp_t(), uv.tcp_t(), uv.tcp_t()
  check(uv.tcp_init(loop, server))
  check(uv.tcp_init(loop, peer))
  check(uv.tcp_init(loop, client))
  local connect, outbound, echo = uv.connect_t(), uv.write_t(), uv.write_t()
  local deadline = uv.timer_t()
  check(uv.timer_init(loop, deadline))
  check(uv.timer_start(deadline, function (owner: uv.timer_t)
    if not closing then raise "TCP example timed out" end
  end, 5000, 0))
  local bind_status, address? = uv.ip4_addr("127.0.0.1", 0)
  check(bind_status)
  check(uv.tcp_bind(server, address, 0))
  local endpoint_status, endpoint?, endpoint_length = uv.tcp_getsockname(server)
  check(endpoint_status)

  local allocate = function (handle: uv.handle_t, suggested: integer): uv.buf_t
    return uv.buf_t.allocate(128)
  end
  local request_text, reply_text = "", ""
  local completed = false
  check(uv.listen(server:as_stream_t(), 8,
    function (listener: uv.stream_t, status: integer)
      if closing then return end
      check(status)
      check(uv.accept(listener, peer:as_handle_t()))
      uv.close(server:as_handle_t(), nil) -- This example accepts exactly once.
      check(uv.read_start(peer:as_stream_t(), allocate,
        function (stream: uv.stream_t, count: integer, bytes: uv.buf_t?)
          if closing then return end
          check(count)
          if count == 0 then return end
          request_text = request_text .. bytes:to_string(count)
          if #request_text < 4 then return end
          if request_text ~= "ping" then raise "unexpected TCP request" end
          check(uv.read_stop(stream))
          check(uv.write(echo, stream, {uv.buf_t.from_string(request_text)},
            function (owner: uv.write_t, result: integer)
              if closing then return end
              check(result)
              uv.close(peer:as_handle_t(), nil)
            end))
        end))
    end))

  local resolver = uv.getaddrinfo_t()
  check(uv.getaddrinfo(loop, resolver,
    function (owner: uv.getaddrinfo_t, status: integer,
              result: uv.addrinfo_result_t?)
      -- This separate native list is not released by request completion.
      defer uv.freeaddrinfo(result)
      if closing then return end
      check(status)
      local entries = result:entries() -- These copies survive freeaddrinfo.
      if #entries == 0 then raise "resolver returned no address" end
      check(uv.tcp_connect(connect, client, entries[1].ai_addr,
        function (request: uv.connect_t, connected: integer)
          if closing then return end
          check(connected)
          check(uv.read_start(client:as_stream_t(), allocate,
            function (stream: uv.stream_t, count: integer, bytes: uv.buf_t?)
              if closing then return end
              check(count)
              if count == 0 then return end
              reply_text = reply_text .. bytes:to_string(count)
              if #reply_text < 4 then return end
              if reply_text ~= "ping" then raise "unexpected TCP reply" end
              completed = true
              closing = true
              close_handles(loop)
            end))
          check(uv.write(outbound, client:as_stream_t(),
            {uv.buf_t.from_string("ping")},
            function (written: uv.write_t, result: integer)
              if not closing then check(result) end
            end))
        end))
    end, "127.0.0.1", "" .. endpoint:port(), nil))
  uv.run(loop, nil)
  if not completed then return 1 end
  return 0
end
