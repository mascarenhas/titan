local mco = foreign import "minicoro.h"
local rt = foreign import "titan/coro.h"

record Coro
  local handle: value
  local default_tag: value
end

local function missing_tag()
  raise "must provide tag argument if no default_tag was provided"
end

local function missing_yield_tag()
  raise "must provide non-nil tag argument to coro.yield"
end

local function effective_tag(default_tag: value, explicit_tag: value): value
  local tag = explicit_tag
  if tag == nil then
    tag = default_tag
  end
  if tag == nil then
    missing_tag()
  end
  return tag
end

local function check_mco_result(result: mco.mco_result)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    raise (mco.mco_result_description(result) as string)
  end
end

local function push_transfer(source: rt.titan_coro_ref,
                             ok: rt.titan_ffi_int, payload: value)
  local result = mco.mco_push(source, payload, rt.TValue.sizeof)
  check_mco_result(result)
  result = mco.mco_push(source, ok, rt.titan_ffi_int.sizeof)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    mco.mco_pop(source, nil, rt.TValue.sizeof)
    check_mco_result(result)
  end
end

local function discard_transfer(source: rt.titan_coro_ref)
  if source then
    mco.mco_pop(source, nil, rt.titan_ffi_int.sizeof)
    mco.mco_pop(source, nil, rt.TValue.sizeof)
  end
end

local function transfer_source(co: rt.titan_coro_ref): rt.titan_coro_ref
  if co and co.stacked_co then
    return co.stacked_co
  end
  return co
end

local function resume_checked(co: rt.titan_coro_ref,
                              source: rt.titan_coro_ref, tag: value)
  local ctag: rt.TValue = tag
  local result = mco.mco_resume(co, ctag)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    discard_transfer(source)
    check_mco_result(result)
  end
end

local function yield_checked(co: rt.titan_coro_ref, tag: value)
  local ctag: rt.TValue = tag
  local result = mco.mco_yield(co, ctag)
  if (result as integer) ~= (mco.MCO_SUCCESS as integer) then
    discard_transfer(co)
    check_mco_result(result)
  end
end

local function pop_transfer_or_raise(source: rt.titan_coro_ref): value
  local ok: rt.titan_ffi_int = 0 as rt.titan_ffi_int
  local payload: rt.TValue = nil
  check_mco_result(mco.mco_pop(source, ok, rt.titan_ffi_int.sizeof))
  check_mco_result(mco.mco_pop(source, payload, rt.TValue.sizeof))
  if (ok as integer) == 0 then
    rt.titan_coro_raise(L, source, payload)
  end
  rt.titan_coro_clear_dead(L, source)
  return payload
end

function create(func: (value) -> value, default_tag: value): Coro
  return Coro.new(rt.titan_coro_create(L, func), default_tag)
end

function Coro:resume(arg: value, tag: value): value
  local effective = effective_tag(self.default_tag, tag)
  local co = rt.titan_coro_handle(self.handle)
  local source = transfer_source(co)
  push_transfer(source, 1, arg)
  resume_checked(co, source, effective)
  return pop_transfer_or_raise(transfer_source(co))
end

function Coro:error(err: value, tag: value): value
  local effective = effective_tag(self.default_tag, tag)
  local co = rt.titan_coro_handle(self.handle)
  local source = transfer_source(co)
  push_transfer(source, 0, err)
  resume_checked(co, source, effective)
  return pop_transfer_or_raise(transfer_source(co))
end

function Coro:status(): string
  local status = mco.mco_status(rt.titan_coro_handle(self.handle))
  if (status as integer) == (mco.MCO_SUSPENDED as integer) then
    return "suspended"
  end
  if (status as integer) == (mco.MCO_RUNNING as integer) then
    return "running"
  end
  if (status as integer) == (mco.MCO_NORMAL as integer) then
    return "normal"
  end
  if (status as integer) == (mco.MCO_STACKED as integer) then
    return "stacked"
  end
  return "dead"
end

function yield(arg: value, tag: value): value
  if tag == nil then
    missing_yield_tag()
  end
  local co = mco.mco_running()
  push_transfer(co, 1, arg)
  yield_checked(co, tag)
  return pop_transfer_or_raise(co)
end

function is_yieldable(tag: value): boolean
  if tag == nil then
    missing_yield_tag()
  end
  local ctag: rt.TValue = tag
  return (mco.mco_is_yieldable(mco.mco_running(), ctag) as integer) ~= 0
end
