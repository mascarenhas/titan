#!/usr/bin/env lua

-- `titanc --print-root` is the runtime's SDK-root query. Answer it from the
-- native support module alone, before loading the compiler. Without usable
-- support, and for every other spelling, the fully validated path below
-- answers instead; it honors TITAN_ROOT without native support.
if select("#", ...) == 1 and ... == "--print-root" then
    local loaded, support = pcall(require, "titan")
    local compiler_root = loaded and type(support) == "table" and
        support._compiler_root
    if type(compiler_root) == "function" then
        local root, root_error = compiler_root()
        if type(root) ~= "string" or root == "" then
            io.stderr:write("cannot locate the Titan installation root: ",
                tostring(root_error), "\n")
            os.exit(1)
        end
        io.stdout:write(root, "\n")
        return
    end
end

local argparse = require 'argparse'

local checker = require 'titan-compiler.checker'
local coder = require 'titan-compiler.coder'
local parser = require 'titan-compiler.parser'
local driver = require 'titan-compiler.driver'
local test_runner = require 'titan-compiler.test_runner'
local util = require 'titan-compiler.util'
local platform = require 'titan-compiler.platform'
local coverage = require 'titan-compiler.coverage'
local build = require 'titan-compiler.build'
local path = require 'titan-compiler.path'
local incremental = require 'titan-compiler.incremental'
local nativeinputs = require 'titan-compiler.nativeinputs'
local linkcertificate = require 'titan-compiler.linkcertificate'
local progress = require 'titan-compiler.progress'

-- Native switches keep their exact command-line order across kinds.
local native_cli = {}
local function native_switch(kind)
    return function(result, target, value)
        result[target] = result[target] or {}
        table.insert(result[target], value)
        native_cli[#native_cli + 1] = { kind = kind, value = value }
    end
end

-- Implementation notes: doc/implementation/driver.md#the-titanc-command-line
local p = argparse('titan', 'Titan compiler')
p:argument('module', 'Names of the modules to compile.'):args("*")
p:flag('--print-root', 'Print the selected Titan installation root and exit.')
p:flag('--print-ast', 'Print the AST.')
p:flag('--pretty-print', 'Format generated C and headers with clang-format.')
p:flag('-v --verbose', 'Be verbose about compiler invocations.')
p:flag('-q --quiet', 'Print only diagnostics, native compiler output and --print-* results: the historical output, with no progress reporting.')
p:option('-j --jobs',
    'Maximum concurrent compiler jobs: module-frontend workers and native compiler jobs share these slots (default: TITAN_JOBS or 4).')
p:option('--c-parts',
    'Maximum generated-C translation units per module above the split threshold (default: TITAN_C_PARTS, 4 on Linux, or 1 on macOS/Windows).')
p:option('--exe', 'Exact executable destination, relative to the current directory (Windows appends .exe when absent; the DLL provider stays under --output).')
p:flag('--static', 'Prefer static Titan archive providers (unsupported on Windows).')
p:flag('--source-first', 'Prefer available source modules to compiled providers.')
p:flag('--incremental', 'Reuse each source module object, including requested roots, whose certificate still matches: own sources, compiler, native configuration, C headers, dependency interfaces and bindings (-v explains each miss).')
p:flag('-c --compile-only', 'Generate objects and headers only; without --incremental every module is rebuilt.')
p:flag('--test', 'Build native Titan tests (objects only with --compile-only).')
p:flag('--coverage', 'Instrument source modules without test_ functions and report when the test executable runs.')
p:option('--coverage-backend', 'Coverage backend: gcc-gcov (Unix default) or llvm-gcov (Windows default).')
p:option('--coverage-module', 'Override automatic selection with a logical module glob (* and ?); repeat for a union.'):count('*')
p:option('--coverage-root', 'Source repository root for reports (default: current directory).')
p:option('--coverage-gcov', 'Matching gcov reader command (default: GCOV, gcov, or llvm-cov gcov).')
p:option('--coverage-format', 'Optional richer report: html, lcov, or cobertura (requires gcovr); repeat for several.'):count('*')
p:option('--coverage-output', 'Report directory (default: .coverage/report).')
p:option('--coverage-gcovr', 'gcovr command for optional richer reports (default: gcovr).')
p:flag('--no-uv-bootstrap',
    'Call standalone main directly even if titan.uv installs its bootstrap hook.')
p:flag('--no-line-directives',
    'Omit source #line directives from generated C.')
p:option('-u --lua', 'Path to Lua source tree (source checkouts only; installed compilers use their matching Lua SDK).')
p:option('-t --tree', 'Root of the source tree, used for looking for source modules (defaults to ".").')
p:option('-T --target', 'Compilation target (default: TITAN_TARGET or the host OS).')
p:option('-o --output', 'Folder for generated files, preserving the source hierarchy (created if needed).')
p:option('-l --link', 'Library linked into the final executable or provider; repeatable, comma lists allowed, order kept.'):count('*'):action(native_switch('library'))
p:option('-L --library-dir', 'Native library search directory for final links; repeatable, order kept.'):count('*'):action(native_switch('libdir'))
p:option('-I --include-dir', 'Native include directory for C headers, probes and generated C; repeatable, order kept, searched before the SDK.'):count('*'):action(native_switch('include'))
p:option('-D --define', 'Native preprocessor definition NAME[=VALUE]; repeatable, order kept.'):count('*'):action(native_switch('define'))
p:option('--cflag', 'One native compile argument, written --cflag=-pthread; repeatable, order kept.'):count('*'):action(native_switch('cflag'))
p:option('--ldflag', 'One native link argument, written --ldflag=-Wl,--as-needed; repeatable, order kept.'):count('*'):action(native_switch('ldflag'))
p:option('--c-source', 'C file compiled and certified by this invocation, linked before -X payloads; repeatable.'):count('*')
p:flag('--print-c-objects', 'With -c and --c-source, print one absolute certified object path per C-source argument in order; stdout contains paths only.')
p:option('--test-dir', 'With --test, use every source module below this directory whose final name component follows the test convention (test, tests, spec, specs, *_test(s), *_spec(s)) as a root; repeatable.'):count('*')
p:option('--test-exclude', 'With --test-dir, exclude this discovered logical module; repeatable.'):count('*')
p:option('-X --extra-object',
    'Additional native object/archive payload carried into the linked provider outputs.'):args("*")
local args = p:parse()

local resolver_context
-- The CLI's progress reporter (issue #322); nil in quiet mode and for every
-- library or language-server caller, so their stderr stays exactly as before.
local reporter
-- Output-domain locks; process exit also releases them.
local output_locks, locked_io
local function release_locks()
    if locked_io then
        locked_io._process_inherit = nil
        locked_io = nil
    end
    if output_locks then
        local locks = output_locks
        output_locks = nil
        driver.OUTPUT_LOCKS = nil
        locks:release()
    end
end
local function close_coordinator_context()
    if not resolver_context then return true end
    -- Digest persistence is only a hint. Ordinary cache-write errors must not
    -- replace compilation diagnostics; cancellation still propagates.
    if output_locks then incremental.save_digest_cache(resolver_context) end
    local closed, close_error = driver.close_resolver_context(resolver_context)
    resolver_context = nil
    return closed, close_error
end

local resolver_cleanup <close> = setmetatable({}, {
    __close = function()
        if resolver_context then
            local close = close_coordinator_context
            -- Preserve the original exceptional-exit diagnostic. Ordinary
            -- exits use exit() or the explicit success close below and can
            -- report a cleanup failure directly.
            pcall(close)
        end
        pcall(release_locks)
    end,
})

-- Work like assert, but don't print the stack trace
local function exit(msg)
    if resolver_context then
        local closed, close_err = close_coordinator_context()
        if not closed then
            msg = tostring(msg) .. "\nfailed to clean C probe service: " ..
                tostring(close_err)
        end
    end
    release_locks()
    if reporter then
        -- Erase any live region, then the diagnostics exactly as written.
        reporter:fail()
        reporter:write(msg .. "\n")
    else
        io.stderr:write(msg, "\n")
    end
    os.exit(1)
end

local function finish()
    local closed, close_err = close_coordinator_context()
    if not closed then
        exit("failed to clean C probe service: " .. tostring(close_err))
    end
    release_locks()
    if reporter then reporter:finish() end
end

-- A live region owns terminal stderr, so verbose command echoes cannot share
-- it; the plain renderer serves verbose mode and both switches are refusals.
if args.quiet and args.verbose then
    exit("-q/--quiet and -v/--verbose cannot be combined")
end

if args.print_c_objects then
    if not args.compile_only or #args.c_source == 0 then
        exit("--print-c-objects requires --compile-only and at least one --c-source")
    end
    if args.print_root or args.print_ast then
        exit("--print-c-objects cannot be combined with --print-root or --print-ast")
    end
end

if args.print_root then
    if #args.module > 0 then
        exit("--print-root cannot be combined with module names")
    end
    local root, root_error = driver.compiler_root()
    if not root then
        exit("cannot locate the Titan installation root: " ..
            tostring(root_error))
    end
    io.stdout:write(root, "\n")
    return
end

-- Progress reporting (issue #322). The environment is read once; only a
-- build that could report progress probes the terminal, and only a terminal
-- gets the live renderer. Progress goes to stderr exclusively, so --print-*
-- stdout stays machine-readable.
local environment = {
    quiet = args.quiet == true,
    verbose = args.verbose == true,
    term = platform.getenv("TERM"),
    makeflags = platform.getenv("MAKEFLAGS"),
    no_color = platform.getenv("NO_COLOR"),
    -- A Unix live region has no TTY handle to ask; honour an exported hint.
    columns = platform.getenv("COLUMNS"),
    locale = progress.locale({
        LC_ALL = platform.getenv("LC_ALL"),
        LC_CTYPE = platform.getenv("LC_CTYPE"),
        LANG = platform.getenv("LANG"),
    }),
    windows = platform.windows == true,
}
if not environment.quiet then
    local loaded, process = pcall(require, "titan-compiler.process")
    local opened, uv = false, nil
    if loaded then opened, uv = pcall(process.library) end
    if opened then
        -- The same library supplies the wall clock and, when the renderer is
        -- live, the terminal handle and the animation timer.
        environment.uv = uv
        environment.now = function() return uv.hrtime() / 1e9 end
        if not environment.verbose then
            local guessed, handle = pcall(uv.guess_handle, 2)
            environment.tty = guessed and handle == "tty" or false
        end
    end
end
local report_kind = progress.select(environment)
if report_kind ~= progress.NULL then
    reporter = progress.new(report_kind, environment)
end
if reporter and report_kind == progress.LIVE then
    -- The live region owns terminal stderr: children are captured instead.
    driver.LIVE_PROGRESS = reporter
end

if args.incremental and args.print_ast then
    exit("--incremental cannot be combined with --print-ast")
end
if not args.coverage and (#args.coverage_module > 0 or #args.coverage_format > 0 or
        args.coverage_root or args.coverage_gcov or args.coverage_backend or
        args.coverage_output or args.coverage_gcovr) then
    exit("coverage options require --coverage")
end
if platform.windows and args.static then
    exit("--static is not supported on Windows; Titan modules use DLL providers")
end
if args.compile_only then
    if args.exe then
        exit("--exe cannot be combined with --compile-only")
    end
    if #args.link > 0 or #args.library_dir > 0 or #args.ldflag > 0 or
       args.extra_object ~= nil or args.no_uv_bootstrap then
        exit("--compile-only cannot be combined with -l, -L, --ldflag, -X, " ..
            "or --no-uv-bootstrap")
    end
end
if (#args.test_dir > 0 or #args.test_exclude > 0) and not args.test then
    exit("--test-dir and --test-exclude require --test")
end
if #args.test_exclude > 0 and #args.test_dir == 0 then
    exit("--test-exclude requires --test-dir")
end

local jobs_text = args.jobs or platform.getenv("TITAN_JOBS") or "4"
if type(jobs_text) ~= "string" or
   not jobs_text:match("^[1-9][0-9]*$") then
    exit("--jobs and TITAN_JOBS require a positive integer")
end
local jobs = tonumber(jobs_text)
if not jobs or jobs > math.maxinteger then
    exit("--jobs and TITAN_JOBS require a positive integer")
end

local explicit_c_parts = args.c_parts or platform.getenv("TITAN_C_PARTS")
local c_parts
if explicit_c_parts ~= nil then
    if type(explicit_c_parts) ~= "string" or
       not explicit_c_parts:match("^[1-9][0-9]*$") then
        exit("--c-parts and TITAN_C_PARTS require a positive integer")
    end
    c_parts = tonumber(explicit_c_parts)
    if not c_parts or c_parts > math.maxinteger then
        exit("--c-parts and TITAN_C_PARTS require a positive integer")
    end
end
local link_failed = driver.link_failure_message

driver.TITAN_SOURCE_PATH = args.tree or driver.TITAN_SOURCE_PATH
driver.LUA_SOURCE_PATH = args.lua or driver.LUA_SOURCE_PATH
if args.no_line_directives then driver.EMIT_LINE_DIRECTIVES = false end
if args.output then
    local output, output_error = driver.prepare_output_root(args.output)
    if not output then exit(output_error) end
    args.output = output
end
-- Synchronous native publication APIs share the CLI's temporary-file root.
driver.OUTPUT_ROOT = args.output

-- The CLI hashes C headers, probe sources and certified files natively,
-- streaming large files. Digest-only: the adapter has no storage, so no
-- cache entries are built or serialized. An older support library is a
-- stale installation, not a slow fallback.
local support_loaded, support = pcall(require, "titan")
if not support_loaded or type(support) ~= "table" or
   type(support._sha256_binary) ~= "function" or
   type(support._sha256_stream) ~= "function" then
    exit("the installed Titan native support library is missing or stale " ..
        "(it lacks _sha256_binary or _sha256_stream); reinstall Titan" ..
        (support_loaded and "" or ": " .. tostring(support):match("^[^\n]*")))
end

-- Browser descriptor probes write through this context's output-scoped I/O.
-- Own that root before initialization; native invocations retain their later
-- lock boundary, after option normalization and source discovery.
local lock_directories = {}
local digest_cache_loaded = false
local function acquire_output_locks()
    if output_locks then return end
    if args.output then
        lock_directories[1] = args.output
    else
        -- Source-adjacent objects may belong to any search root, while final
        -- providers and executables belong to the invocation's working tree.
        for directory in driver.TITAN_SOURCE_PATH:gmatch("[^;]+") do
            lock_directories[#lock_directories + 1] = directory
        end
        if #lock_directories == 0 then lock_directories[1] = "." end
        lock_directories[#lock_directories + 1] = "."
    end
    if args.exe then
        local exe_directory, directory_error =
            driver.prepare_output_root(path.dirname(args.exe))
        if not exe_directory then exit(directory_error) end
        lock_directories[#lock_directories + 1] = exe_directory
    end
    local lock_error
    output_locks, lock_error = build.lock_outputs(
        resolver_context.io, lock_directories, { verbose = args.verbose })
    if not output_locks then exit(lock_error) end
    driver.OUTPUT_LOCKS = output_locks
    if not platform.windows then
        locked_io = resolver_context.io
        locked_io._process_inherit = output_locks:descriptors()
    end
    for _, directory in ipairs(lock_directories) do
        local valid, target_error = driver.validate_output_target(
            resolver_context, directory, directory == args.output)
        if not valid then exit(target_error) end
    end
end

resolver_context = driver.new_resolver_context({
    prefer_static = args.static,
    source_first = args.test or args.source_first,
    verbose = args.verbose,
    pretty_print = args.pretty_print,
    output_root = args.output,
    cache_adapter = { sha256_binary = support._sha256_binary,
        sha256_stream = support._sha256_stream },
    jobs = jobs,
    -- The real script, not a LuaRocks wrapper: object certificates hash the
    -- frontend that actually runs.
    frontend = arg and arg[0] or nil,
})
local target_value, target_origin = args.target, "--target"
if target_value == nil then
    target_value, target_origin = platform.getenv("TITAN_TARGET"), "TITAN_TARGET"
end
local target, target_error =
    driver.validate_target(resolver_context, target_value, target_origin)
if not target then exit(target_error) end
resolver_context.target = target
if target == "browser" then
    if not args.output then exit("--target browser requires --output") end
    acquire_output_locks()
    incremental.load_digest_cache(resolver_context, args.output)
    digest_cache_loaded = true
end
if #args.module == 0 and #args.test_dir == 0 and
   not (args.compile_only and #args.c_source > 0) then
    exit("at least one module name is required (or use --print-root, " ..
        "--test-dir, or -c --c-source)")
end
if driver.TOOLCHAIN_ERROR then exit(driver.TOOLCHAIN_ERROR) end
if args.lua and driver.INSTALLED then
    exit("--lua is only available in a source checkout; the installed " ..
        "compiler must use its matching Lua SDK")
end
-- Defaults, then the supported TITAN_EXTRA_* ambient inputs, then CLI
-- switches, each in its own order; normalized once for every native phase.
local normalized_native, native_error = nativeinputs.normalize({
    env = {
        TITAN_EXTRA_CPPFLAGS = driver.EXTRA_CPPFLAGS,
        TITAN_EXTRA_CFLAGS = driver.EXTRA_CFLAGS,
        TITAN_EXTRA_LDFLAGS = driver.EXTRA_LDFLAGS,
    },
    cli = { ordered = native_cli, c_sources = args.c_source, exe = args.exe },
})
if not normalized_native then exit(native_error) end
driver.apply_native_inputs(normalized_native)
local c_source_only = args.compile_only and #args.module == 0 and
    #args.test_dir == 0 and #args.c_source > 0
local configured, configure_error
if c_source_only then
    -- Native C nodes need layout, platform and toolchain identity, but no
    -- Titan foreign-type profile or module graph.
    configured, configure_error = driver.initialize_platform(resolver_context)
else
    configured, configure_error = driver.configure_foreign_c(resolver_context)
end
if not configured and configure_error then exit(configure_error) end
if not c_parts then
    c_parts = driver.default_c_parts()
end
local coverage_build
if args.coverage then
    local coverage_error
    coverage_build, coverage_error = coverage.prepare(driver, args, resolver_context.io)
    if not coverage_build then exit(coverage_error) end
    table.insert(driver.NATIVE_LINK_FLAGS, "--coverage")
    table.insert(driver.NATIVE_LINK_FLAGS, "-fno-lto")
end

local errors = {}
local main_module = nil

local requested_roots = {}
local requested_modules = driver.deduplicate_module_names(args.module)
local source_overrides = {}
for _, modname in ipairs(requested_modules) do
    if args.test and modname == test_runner.MODULE_NAME then
        exit("logical module '" .. test_runner.MODULE_NAME ..
            "' is reserved by --test")
    end
    requested_roots[modname] = true
end
if #args.test_dir > 0 then
    -- Discovery returns every root (explicit ones included, in order) and
    -- the ordinary descriptors it selected; its own errors are final.
    local discovered, discovered_sources = require("titan-compiler.testroots")
        .discover(resolver_context, args.test_dir, args.test_exclude,
            requested_modules)
    if not discovered then exit(discovered_sources) end
    requested_modules, requested_roots = {}, {}
    for _, modname in ipairs(discovered) do
        if modname == test_runner.MODULE_NAME then
            exit("logical module '" .. test_runner.MODULE_NAME ..
                "' is reserved by --test")
        end
        if not requested_roots[modname] then
            requested_roots[modname] = true
            requested_modules[#requested_modules + 1] = modname
        end
    end
    for modname, source in pairs(discovered_sources or {}) do
        source_overrides[modname] = source
    end
end
local loader_options = {
    source_roots = requested_roots,
    incremental = args.incremental,
    test = args.test,
    source_overrides = source_overrides,
    context = resolver_context,
    coverage = coverage_build,
    output_root = args.output,
    c_parts = c_parts,
}

-- One exclusive lock per output domain, held from certification through
-- publication; browser already acquired it before descriptor probes.
acquire_output_locks()
if not digest_cache_loaded then
    incremental.load_digest_cache(resolver_context, args.output)
end
if resolver_context.target_descriptor then
    incremental.load_sdk_digests(resolver_context,
        resolver_context.target_descriptor.paths.sdk_digests)
elseif driver.INSTALLED and driver.INSTALL_PATHS then
    incremental.load_sdk_digests(resolver_context, driver.INSTALL_PATHS.sdk_digests)
end

-- Stale-staging retirement protects every input and reservation preflight
-- accepted for this invocation.
local preflight_plan
local function preflight_outputs(plan)
    preflight_plan = plan
    local native_inputs = { table.unpack(args.extra_object or {}) }
    for _, filename in ipairs(normalized_native.c_sources) do
        native_inputs[#native_inputs + 1] = filename
    end
    return driver.preflight_build_outputs(resolver_context, plan, {
        roots = requested_modules,
        compile_only = args.compile_only,
        test = args.test,
        c_parts = c_parts,
        output_root = args.output,
        exe = args.exe,
        no_uv_bootstrap = args.no_uv_bootstrap,
        coverage = coverage_build ~= nil,
        native_inputs = native_inputs,
        locks = output_locks,
        metadata_root = lock_directories[1],
    })
end

if args.test and not args.compile_only and
   driver.context_target(resolver_context) == "browser" then
    exit("browser program linking is not available yet")
end

local loader
if c_source_only then
    local ready, preflight_error = preflight_outputs({ order = {}, modules = {} })
    if not ready then exit(preflight_error) end
elseif args.print_ast then
    -- A debugging view of each root's checked AST: check in this process,
    -- where the ASTs live, and compile through the ordinary batch below.
    local plan, plan_errors = build.plan(resolver_context, {
        roots = requested_modules, loader_options = loader_options,
    })
    if not plan then exit(table.concat(plan_errors, "\n")) end
    local ready, preflight_error = preflight_outputs(plan)
    if not ready then exit(preflight_error) end
    -- Planning admits placeholders, not checked ASTs. Every source must still
    -- pass the ordinary in-process checker before its AST is printed.
    driver.imported = {}
    loader = driver.defaultloader({}, loader_options)
    for _, modname in ipairs(requested_modules) do
        local ok, errs = checker.checkimport(modname, loader)
        if not ok then
            table.insert(errors, errs)
        else
            if #errs > 0 then table.insert(errors, table.concat(errs, "\n")) end
            local ast = driver.imported[modname].ast
            if ast then print(parser.pretty_print_ast(ast)) end
        end
    end
    if #errors > 0 then exit(table.concat(errors, "\n")) end
else
    -- The coordinator certifies every module of the requested closure,
    -- restores hits, compiles misses in worker processes and publishes
    -- them; it returns with every source module restored and the resolver
    -- finalized.
    local built, diagnostics, signal = build.run(resolver_context, {
        roots = requested_modules,
        loader_options = loader_options,
        incremental = args.incremental,
        compile_only = args.compile_only,
        test = args.test,
        jobs = jobs,
        verbose = args.verbose,
        pretty_print = args.pretty_print,
        c_parts = c_parts,
        coverage = coverage_build ~= nil,
        output_root = args.output,
        locks = output_locks,
        preflight = preflight_outputs,
        progress = reporter,
    })
    if signal then
        close_coordinator_context()
        -- No stale region survives the re-raised signal.
        if reporter then reporter:fail() end
        require("titan-compiler.jobs").propagate(signal)
    end
    if not built then exit(table.concat(diagnostics, "\n")) end
    loader = resolver_context.loader
end

for _, modname in ipairs(requested_modules) do
    local mod = driver.imported[modname]
    if not args.test and not args.compile_only
       and (mod.has_main or mod.ast and checker.has_main(mod.ast)) then
        if main_module then
            table.insert(errors, modname .. ": multiple main functions found (already declared in " .. main_module .. ")")
        else
            main_module = modname
        end
    end
end

if coverage_build then
    local selected, selection_error = coverage.select(coverage_build, driver.imported)
    if not selected then table.insert(errors, selection_error) end
end
if #errors > 0 then exit(table.concat(errors, "\n")) end

local test_program_output
local test_entrypoint_output
local test_cases
if args.test then
    if driver.imported[test_runner.MODULE_NAME] then
        exit("logical module '" .. test_runner.MODULE_NAME ..
            "' is reserved by --test")
    end
    test_cases = test_runner.discover(
        requested_modules, driver.imported, driver.dependency_closure)
end
local builds_program = main_module ~= nil or
    (args.test and not args.compile_only)
if builds_program and driver.context_target(resolver_context) == "browser" then
    exit("browser program linking is not available yet")
end
if args.exe and not builds_program then
    exit("--exe is only valid when compiling a standalone or test executable")
end
if args.no_uv_bootstrap and not builds_program then
    exit("--no-uv-bootstrap is only valid when compiling a standalone executable")
end
if coverage_build and not args.compile_only and not builds_program then
    exit("--coverage requires a test or standalone executable; use -c for coverage objects")
end

-- --c-source nodes are preprocessed and certified on every invocation; a
-- hit runs no native compile. Their objects take the native-payload
-- position, before -X payloads.
local c_objects = {}
if #normalized_native.c_sources > 0 then
    local compile_argv, compile_error = driver.authored_c_compile_prefix()
    if not compile_argv then exit(compile_error) end
    local toolchain, toolchain_error = driver.toolchain_descriptor(resolver_context)
    if not toolchain then exit(toolchain_error) end
    local compiled, native_compile_error = nativeinputs.compile(resolver_context, {
        sources = normalized_native.c_sources,
        output_root = lock_directories[1],
        compile_argv = compile_argv,
        toolchain = toolchain,
        incremental = args.incremental == true,
        begin_step = reporter and function(source)
            reporter:source_begin(source)
        end or nil,
        finish_step = reporter and function(source)
            reporter:source_done(source)
        end or nil,
        fail_step = reporter and function(source)
            reporter:source_failed(source)
        end or nil,
    })
    if not compiled then exit(native_compile_error) end
    for _, object in ipairs(compiled) do
        if args.verbose then
            io.stderr:write("Titan native ", object.hit and "hit " or "miss ",
                tostring(object.source), "\n")
        end
        -- A certified miss ran as a visible step; a hit is only counted.
        if object.hit and reporter then reporter:source_up_to_date() end
        c_objects[#c_objects + 1] = object
    end
end
local function finish_compile_only()
    local listed_paths
    if args.print_c_objects then
        local cwd, cwd_error = resolver_context.io:cwd()
        if not cwd then exit(cwd_error) end
        local object_paths = {}
        for _, object in ipairs(c_objects) do
            local absolute, absolute_error =
                platform.absolute(object.path, cwd, resolver_context.io)
            if not absolute then exit(absolute_error) end
            object_paths[linkcertificate.canonical_path(
                resolver_context, object.source)] = absolute
        end
        listed_paths = {}
        for _, source in ipairs(args.c_source) do
            local canonical = linkcertificate.canonical_path(resolver_context, source)
            listed_paths[#listed_paths + 1] = assert(object_paths[canonical],
                "certified native object is missing for C source '" .. source .. "'")
        end
    end
    finish()
    if listed_paths then io.stdout:write(table.concat(listed_paths, "\n"), "\n") end
end
if c_source_only then
    finish_compile_only()
    return
end

local extra_objects = {}
for _, object in ipairs(c_objects) do extra_objects[#extra_objects + 1] = object.path end
for _, input in ipairs(args.extra_object or {}) do
    extra_objects[#extra_objects + 1] = input
end
if #extra_objects == 0 then extra_objects = nil end

-- The final-link certificate gates every runner/entrypoint generation,
-- archive probe, validation link and final link. A hit changes nothing.
local link_ticket, program_path, windows_paths, coverage_runtime, dsymutil
-- The final link's output basename, reported as the progress step.
local link_name
if not args.compile_only and not args.print_ast then
    local planned, plan_errors = driver.finalize_resolver_context(resolver_context)
    if not planned then exit(table.concat(plan_errors, "\n")) end
    local root = args.test and requested_modules[1] or main_module
    local outputs, kind = {}, "library"
    if builds_program then
        kind = args.test and "test" or "program"
        if platform.windows then
            local paths, path_error = driver.windows_program_paths(
                args.test and test_runner.MODULE_NAME or main_module, args.exe,
                args.test and requested_modules[1] or nil, args.output)
            if not paths then exit(path_error) end
            windows_paths = paths
            outputs = { { path = paths.executable }, { path = paths.provider } }
        else
            program_path = args.exe or driver.imported[root].program_output or
                root:gsub("[.]", "/")
            outputs = { { path = program_path, executable = true } }
            if driver.IS_DARWIN then
                outputs[2] = { path = program_path .. ".dSYM", kind = "directory" }
            end
        end
    else
        local library, _, left, right =
            driver.common_module_provider(requested_modules)
        if not library then
            exit("cannot link modules into one shared library: '" ..
                tostring(left) .. "' and '" .. tostring(right) ..
                "' have no common module prefix")
        end
        local library_output, library_err = driver.provider_output_path(
            library, args.output, resolver_context)
        if not library_output then exit(library_err) end
        outputs[1] = { path = library_output }
        if driver.context_target(resolver_context) ~= "browser" and not platform.windows then
            outputs[#outputs + 1] = { path = (library_output:gsub("[.]so$", ".a")) }
            if driver.IS_DARWIN then
                outputs[#outputs + 1] = { path = library_output .. ".dSYM", kind = "directory" }
            end
        end
    end

    local module_order = {}
    for name in pairs(resolver_context.source_names) do
        module_order[#module_order + 1] = name
    end
    table.sort(module_order, util.bytewise_less)
    local objects = {}
    for _, name in ipairs(module_order) do
        for _, object in ipairs(driver.module_compiled_objects(driver.imported[name])) do
            objects[#objects + 1] = object
        end
    end
    local dynamic_order, providers = {}, {}
    for name in pairs(resolver_context.dynamic_names) do
        dynamic_order[#dynamic_order + 1] = name
    end
    table.sort(dynamic_order, util.bytewise_less)
    for _, name in ipairs(dynamic_order) do
        local filename = resolver_context.dynamic_names[name].filename
        if filename then providers[#providers + 1] = filename end
    end
    local archives = {}
    for _, static_provider in ipairs(resolver_context.selected_static_providers) do
        archives[#archives + 1] = static_provider.archive
    end
    local runtime, runtime_flags = {}, {}
    if driver.context_target(resolver_context) ~= "browser" then
        for _, input in ipairs(driver.INSTALLED and
                driver.installed_link_inputs(driver.INSTALL_PATHS, driver.IS_DARWIN) or
                driver.source_link_inputs()) do
            if input:find("[/\\]") then runtime[#runtime + 1] = input
            else runtime_flags[#runtime_flags + 1] = input end
        end
    end
    if coverage_build and builds_program then
        local inventory_error
        coverage_runtime, inventory_error =
            coverage.inventory(coverage_build, driver.imported)
        if not coverage_runtime then exit(inventory_error) end
    end
    local configuration, configuration_error, configuration_status =
        driver.incremental_configuration(resolver_context)
    if not configuration and configuration_status ~= "uncertified" then
        exit(configuration_error)
    end
    local compiler_inventory = configuration and configuration.compiler
    if not compiler_inventory then
        local inventory_error
        compiler_inventory, inventory_error =
            incremental.compiler_component(resolver_context)
        if not compiler_inventory then exit(inventory_error) end
    end
    local compile_prefix, prefix_error = driver.generated_compile_prefix()
    if not compile_prefix then exit(prefix_error) end
    local backend, backend_error, backend_status =
        driver.native_link_backend(resolver_context)
    if not backend then exit(backend_error) end
    local output_request, output_request_error =
        driver.output_tool_descriptors(resolver_context, kind)
    if not output_request then exit(output_request_error) end
    if configuration_status == "uncertified" then
        output_request.uncacheable = configuration_error
    elseif backend_status == "uncertified" then
        output_request.uncacheable = backend_error
    end
    output_request.compile_argv = compile_prefix
    output_request.inputs = {}
    for _, inputs in ipairs({
            objects, extra_objects or {}, providers, archives, runtime }) do
        for _, filename in ipairs(inputs) do
            output_request.inputs[#output_request.inputs + 1] = filename
        end
    end
    local output_tools, output_tools_error =
        linkcertificate.output_tools(resolver_context, output_request)
    if not output_tools then exit(output_tools_error) end
    dsymutil = output_request.tools.dsymutil and output_request.tools.dsymutil[1]
    local spec = {
        output_root = lock_directories[1],
        outputs = outputs,
        roots = requested_modules,
        kind = kind,
        entry = {
            module = args.test and test_runner.MODULE_NAME or main_module,
            no_uv_bootstrap = args.no_uv_bootstrap == true,
        },
        no_uv_bootstrap = args.no_uv_bootstrap == true,
        argv = driver.link_extra_flags(),
        toolchain = {
            compiler = output_request.toolchain,
            output_tools = output_tools,
        },
        test_cases = test_cases,
        templates = compiler_inventory,
        coverage = coverage_runtime,
        companions = windows_paths and {
            manifest = driver.windows_launcher_manifest(),
            relative_provider = windows_paths.relative_provider,
        } or nil,
        policy = {
            uname = driver.UNAME or "", darwin = driver.IS_DARWIN == true,
            profile = driver.BUILD_PROFILE,
            target = resolver_context.target_descriptor and
                resolver_context.target_descriptor.identity or
                (driver.TARGET_PROFILE and driver.TARGET_PROFILE.identity or ""),
        },
        bindings = resolver_context.native_bindings,
        environment = {
            runtime_flags = runtime_flags,
            MACOSX_DEPLOYMENT_TARGET = platform.getenv("MACOSX_DEPLOYMENT_TARGET") or "",
            SDKROOT = platform.getenv("SDKROOT") or "",
        },
        objects = objects,
        c_objects = c_objects,
        payloads = args.extra_object or {},
        providers = providers,
        archives = archives,
        runtime = runtime,
        native_libraries = {
            backend = backend,
            compiler_argv = compile_prefix,
        },
    }
    local prepared, ticket = pcall(linkcertificate.prepare, resolver_context, spec)
    if not prepared then
        if type(ticket) ~= "string" then error(ticket, 0) end
        exit(ticket)
    end
    -- Stale stages are retired only after the prepared final link has resolved
    -- its inputs, native library policy and native tools, and before any
    -- header restoration or final-link hit. An unresolved policy or uncertified
    -- tool selection stays explicit: cleanup refuses, retaining every stage,
    -- only when stale stages exist.
    local staging_ready, staging_error = driver.cleanup_stale_staging(
        resolver_context, outputs, output_locks, {
            plan = preflight_plan, native_objects = c_objects,
            link_inputs = output_request.inputs, native_policy = ticket.native_policy,
            compiler_tools = output_request.compiler_tools, output_tools = output_tools,
        })
    if not staging_ready then exit(staging_error) end
    -- Generated public headers are restored under the lock even when the
    -- final link hits; existing owned headers are preserved untouched.
    local headers_ready, headers_error = driver.prepare_foreign_headers(
        module_order, driver.imported, args.verbose, args.pretty_print)
    if not headers_ready then exit(headers_error) end
    local target = outputs[1].path
    if reporter then link_name = progress.basename(target) end
    local hit, reason = linkcertificate.check(resolver_context, ticket)
    if hit then
        if args.verbose then io.stderr:write("Titan link hit ", target, "\n") end
        if reporter then reporter:link_up_to_date(link_name) end
        finish()
        return
    end
    if args.verbose then
        io.stderr:write("Titan link miss ", target, ": ", tostring(reason), "\n")
    end
    local invalidated, invalidate_error =
        linkcertificate.invalidate(resolver_context, ticket)
    if not invalidated then
        exit("cannot invalidate final link record: " .. tostring(invalidate_error))
    end
    link_ticket = ticket
    -- Misses own the target's record directory (synthetic sources, linker
    -- dependency report); a stale report must not survive into this link.
    local directory_ready, directory_error =
        driver.prepare_output_root(ticket.directory)
    if not directory_ready then exit(directory_error) end
    local policy = ticket.native_policy
    if policy and policy.dependency_file then os.remove(policy.dependency_file) end
end

-- Synthetic runner and entrypoint sources belong to their final target.
if builds_program and not args.compile_only then
    local root = args.test and requested_modules[1] or main_module
    local synthetic_base
    if link_ticket then
        synthetic_base = path.join(link_ticket.synthetic_directory,
            (root:gsub(".*[.]", "")))
    else
        synthetic_base = driver.imported[root].program_output or
            driver.generated_output_path(root:gsub("[.]", "/"), args.output)
    end
    test_entrypoint_output = synthetic_base ..
        (args.test and "__test_entrypoint.c" or "__entrypoint.c")
    if not program_path and not platform.windows then
        program_path = args.exe or driver.imported[root].program_output or
            root:gsub("[.]", "/")
    end
    if args.test then
        test_program_output = synthetic_base
        local runner_source, runner_source_err = test_runner.render(test_cases)
        if not runner_source then exit(runner_source_err) end
        source_overrides[test_runner.MODULE_NAME] =
            test_runner.source_descriptor(test_program_output, runner_source)
        requested_roots[test_runner.MODULE_NAME] = true
        local ok, errs = checker.checkimport(test_runner.MODULE_NAME, loader)
        if not ok then
            table.insert(errors, errs)
        elseif #errs > 0 then
            table.insert(errors, table.concat(errs, "\n"))
        end
        if #errors > 0 then exit(table.concat(errors, "\n")) end
        main_module = test_runner.MODULE_NAME
    end
end
local finalized, finalize_errors =
    driver.finalize_resolver_context(resolver_context)
if not finalized then
    exit(table.concat(finalize_errors, "\n"))
end
local selected_static_archives = {}
if platform.windows and #resolver_context.selected_static_providers > 0 then
    exit("Windows Titan dependencies require DLL providers; static Titan archives are not supported")
end
for _, static_provider in ipairs(
        resolver_context.selected_static_providers) do
    table.insert(selected_static_archives, static_provider.archive)
end

local provider
local provider_output
local windows_program_outputs
local linked_names = {}
local output_names = {}
local output_name_set = {}
local physical_entries = {}
local native_inputs

for name in pairs(resolver_context.source_names) do
    table.insert(linked_names, name)
    output_name_set[name] = true
end
for _, static_provider in ipairs(
        resolver_context.selected_static_providers) do
    for name in pairs(static_provider.entries) do
        output_name_set[name] = true
        physical_entries[name] = static_provider.entries[name]
    end
end
table.sort(linked_names, util.bytewise_less)
for name in pairs(output_name_set) do table.insert(output_names, name) end
table.sort(output_names, util.bytewise_less)

for _, name in ipairs(linked_names) do
    local mod = driver.imported[name]
    if mod.ast then coder.prepare_coverage(mod.ast, coverage_build ~= nil) end
end

local header_plans = {}
local header_plan_by_name = {}
if #errors == 0 then
    local planned, header_err = driver.plan_foreign_headers(
        linked_names, driver.imported)
    if not planned then
        table.insert(errors, header_err)
    else
        header_plans = planned
        for _, plan in ipairs(planned) do
            header_plan_by_name[plan.modname] = plan
        end
    end
end


local mangled_owners = {}
local symbol_owners = {}
local preflight_name_set = {}
for _, name in ipairs(output_names) do preflight_name_set[name] = true end
for name in pairs(resolver_context.dynamic_names) do
    preflight_name_set[name] = true
end
for name in pairs(resolver_context.native_bindings) do
    preflight_name_set[name] = true
end
local preflight_names = {}
for name in pairs(preflight_name_set) do
    preflight_names[#preflight_names + 1] = name
end
table.sort(preflight_names, util.bytewise_less)
for _, name in ipairs(preflight_names) do
    if name == "titan" then
        table.insert(errors, "logical module 'titan' is reserved by " ..
            "Titan's native Lua support module")
    end
    local mangled = driver.mangle_module_name(name)
    local previous = mangled_owners[mangled]
    if previous and previous ~= name then
        table.insert(errors, "cannot link logical modules '" .. previous ..
            "' and '" .. name .. "': both use C symbol prefix '" ..
            mangled .. "'")
    else
        mangled_owners[mangled] = name
        local imported = driver.imported[name]
        local interface = physical_entries[name]
        local symbols
        if imported and imported.external_symbols then
            symbols = imported.external_symbols
        elseif imported and imported.ast then
            symbols = coder.external_symbols(name, imported.ast)
        elseif imported and imported.type then
            symbols = coder.interface_external_symbols(name, imported.type)
        elseif interface and interface.type then
            symbols = coder.interface_external_symbols(name, interface.type)
        elseif resolver_context.native_interface_types[name] then
            symbols = coder.interface_external_symbols(
                name, resolver_context.native_interface_types[name])
        end
        driver.record_module_symbols(symbol_owners, name, symbols, errors)
        if imported and imported.private_symbols then
            driver.record_module_symbols(
                symbol_owners, name, imported.private_symbols, errors)
        end
    end
end
native_inputs = {}
for name in pairs(resolver_context.source_names) do
    local mod = driver.imported[name]
    for _, filename in ipairs(mod.source_files or { mod.filename }) do
        native_inputs[#native_inputs + 1] = filename
    end
end
for _, mod in pairs(resolver_context.dynamic_names) do
    if mod.filename then native_inputs[#native_inputs + 1] = mod.filename end
end
for _, static_provider in ipairs(resolver_context.selected_static_providers) do
    native_inputs[#native_inputs + 1] = static_provider.archive
end
for _, archive in ipairs(selected_static_archives) do
    native_inputs[#native_inputs + 1] = archive
end
for _, input in ipairs(args.extra_object or {}) do
    native_inputs[#native_inputs + 1] = input
end
local compile_requests = {}
for _, name in ipairs(linked_names) do
    local mod = driver.imported[name]
    local extra_flags = {}
    if coverage_build then
        for _, flag in ipairs(coverage.compile_flags(coverage_build, name) or {}) do
            extra_flags[#extra_flags + 1] = flag
        end
    end
    compile_requests[#compile_requests + 1] = {
        modname = name,
        mod = mod,
        static_deps = resolver_context.native_static_names,
        options = {
            context = resolver_context,
            test = args.test,
            pretty_print = args.pretty_print,
            nominal_layouts = resolver_context.nominal_layouts,
            extra_compile_flags = extra_flags,
            coverage = coverage_build and coverage_build.selected[name] == true,
            coverage_backend = coverage_build and coverage_build.backend,
            c_parts = c_parts,
        },
    }
end
local compile_plans
if #errors == 0 then
    local plan_error
    compile_plans, plan_error = driver.plan_compile_requests(
        compile_requests, args.verbose, native_inputs, symbol_owners, header_plans)
    if not compile_plans then table.insert(errors, plan_error) end
end
if #errors > 0 then exit(table.concat(errors, "\n")) end
native_inputs = compile_plans.inputs
if main_module then
    local source_outputs = {}
    for index, name in ipairs(linked_names) do
        local mod = driver.imported[name]
        local header = header_plan_by_name[name]
        source_outputs[#source_outputs + 1] = {
            modname = name,
            output = mod.native_output or mod.filename,
            c_parts = compile_plans[index] and compile_plans[index].part_count
                or #driver.module_compiled_objects(mod),
            foreign_header = header and header.managed
                and header.filename or nil,
            ffi_header = header and header.ffi_header and header.ffi_header.filename or nil,
        }
    end
    local program_output = program_path or main_module:gsub("[.]", "/")
    local entrypoint_output = test_entrypoint_output or
        driver.generated_output_path(main_module:gsub("[.]", "/") .. "__entrypoint.c", args.output)
    local extra_outputs
    if platform.windows then
        local paths, path_error = windows_paths, nil
        if not paths then
            paths, path_error = driver.windows_program_paths(main_module,
                args.exe, args.test and requested_modules[1] or nil,
                args.output)
        end
        if not paths then exit(path_error) end
        windows_program_outputs = paths
        program_output = paths.executable
        extra_outputs = driver.windows_program_auxiliary_paths(
            entrypoint_output, paths.provider)
    end
    local outputs_ok, outputs_err = driver.validate_program_output_paths(
        source_outputs, program_output, entrypoint_output, native_inputs,
        extra_outputs, compile_plans.outputs)
    if not outputs_ok then table.insert(errors, outputs_err) end
end

if not main_module and not args.compile_only then
    local _unique_roots, left, right
    provider, _unique_roots, left, right =
        driver.common_module_provider(requested_modules)
    if not provider then
        exit("cannot link modules into one shared library: '" ..
            tostring(left) .. "' and '" .. tostring(right) ..
            "' have no common module prefix")
    end

    if #errors == 0 then
        local provider_err
        provider_output, provider_err = driver.provider_output_path(
            provider, args.output, resolver_context)
        if not provider_output then table.insert(errors, provider_err) end
    end
    if #errors == 0 then
        local generated_outputs = { table.unpack(compile_plans.outputs) }
        local outputs_ok, outputs_err =
            driver.validate_provider_output_paths(
                provider_output, native_inputs, generated_outputs, resolver_context)
        if not outputs_ok then table.insert(errors, outputs_err) end
    end
end

if #errors > 0 then exit(table.concat(errors, "\n")) end

local libnames = {}
local used_native_names = {}

local headers_ok, headers_err = driver.write_foreign_header_plans(
    header_plans, args.verbose, args.pretty_print)
if not headers_ok then exit(headers_err) end

local compile_results =
    driver.compile_modules(compile_requests, jobs, args.verbose, compile_plans)
for index, name in ipairs(linked_names) do
    local result = compile_results[index]
    local mod = driver.imported[name]
    if not result.ok then
        table.insert(errors, result.err)
    else
        libnames[name] = result.libname
        for used_name in pairs(mod.native_references or {}) do
            used_native_names[used_name] = true
        end
    end
end

if #errors > 0 then exit(table.concat(errors, "\n")) end

if args.compile_only then
    finish_compile_only()
    return
end

if coverage_build and main_module and not coverage_runtime then
    local inventory_error
    coverage_runtime, inventory_error = coverage.inventory(coverage_build, driver.imported)
    if not coverage_runtime then exit(inventory_error) end
end

local generated_objects = {}
for _, name in ipairs(linked_names) do
    local mod = driver.imported[name]
    generated_objects[#generated_objects + 1] = {
        modname = name,
        filename = libnames[name],
        objects = driver.module_compiled_objects(mod),
    }
end
local native_target, target_or_err =
    driver.derive_target_fingerprint(
        generated_objects[1].filename, generated_objects[1].modname, resolver_context)
if not native_target then
    exit("failed to derive generated native target: " .. tostring(target_or_err))
end
local generated_entries =
    (platform.windows or driver.context_target(resolver_context) == "browser") and {} or nil
local objects_valid, objects_err =
    driver.validate_generated_objects(
        generated_objects, native_target, generated_entries, resolver_context)
if not objects_valid then exit(objects_err) end
local providers_valid, providers_err =
    driver.prepare_static_providers_for_target(
        resolver_context.selected_static_providers, native_target)
if not providers_valid then exit(providers_err) end

if main_module then
    local ofiles = {}
    for _, name in ipairs(linked_names) do
        local mod = driver.imported[name]
        local objects = driver.module_compiled_objects(mod)
        for _, object in ipairs(objects) do
            table.insert(ofiles, object)
        end
    end
    local archive_entries = {}
    local archive_names =
        driver.required_static_protocol_names(
            resolver_context, used_native_names)
    for _, name in ipairs(archive_names) do
        archive_entries[name] = assert(physical_entries[name])
    end
    -- The standalone archive probe belongs to the link step that follows it.
    if reporter and link_name then reporter:link_begin(link_name) end
    local probe_ok, probe_err = true
    if not platform.windows then
        probe_ok, probe_err = driver.run_standalone_archive_probe(
            archive_entries, archive_names, ofiles, selected_static_archives,
            nil, args.verbose, extra_objects,
            { pretty_print = args.pretty_print, context = resolver_context })
    end
    if not probe_ok then
        table.insert(errors, probe_err)
        if reporter and link_name then reporter:link_failed(link_name) end
    else
        local ok, term, code = driver.compile_program(main_module, ofiles,
            nil, args.verbose, extra_objects,
            program_path, selected_static_archives,
            test_entrypoint_output,
            args.test and requested_modules[1]:gsub(".*[.]", "") or nil,
            {
                context = resolver_context,
                no_uv_bootstrap = args.no_uv_bootstrap,
                pretty_print = args.pretty_print,
                exe = args.exe,
                final_link_flags = link_ticket and link_ticket.dependency_argv,
                dsymutil = dsymutil,
                before_commit = link_ticket and function()
                    return linkcertificate.invalidate(resolver_context, link_ticket)
                end or nil,
                output_module = args.test and requested_modules[1] or nil,
                output_root = args.output,
                coverage_runtime = coverage_runtime,
                module_names = output_names,
                archive_entries = archive_entries,
                archive_names = archive_names,
            })
        if not ok then
            table.insert(errors, link_failed("program", main_module, term, code))
            if reporter and link_name then reporter:link_failed(link_name) end
        elseif reporter and link_name then
            reporter:link_done(link_name)
        end
    end
else
    local ofiles = {}
    for _, name in ipairs(linked_names) do
        local mod = driver.imported[name]
        local objects = driver.module_compiled_objects(mod)
        for _, object in ipairs(objects) do
            table.insert(ofiles, object)
        end
    end
    local native_payload, payload_err =
        driver.classify_native_payloads(extra_objects, native_target)
    if not native_payload then exit(payload_err) end
    if reporter and link_name then reporter:link_begin(link_name) end
    if platform.windows then
        local temporary, temporary_directory =
            driver.staged_library_output(provider_output)
        if not temporary then
            exit("failed to stage library '" .. provider .. "': " ..
                tostring(temporary_directory))
        end
        local ok, term, code = driver.compile_library_output(
            temporary, ofiles, nil, args.verbose, nil,
            selected_static_archives, native_payload.inputs, provider_output,
            output_names)
        if not ok then
            table.insert(errors, link_failed("library", provider, term, code))
            if reporter and link_name then reporter:link_failed(link_name) end
            local cleaned, cleanup_error =
                driver.cleanup_staging_directories({ temporary_directory })
            if not cleaned then
                table.insert(errors, "Windows library staging cleanup failed: " .. cleanup_error)
            end
        else
            local valid, validation_err = driver.validate_library_image_fresh(
                temporary, generated_entries, output_names, args.verbose)
            if valid then
                valid, validation_err = driver.publish_windows_provider(
                    temporary, provider_output,
                    link_ticket and function()
                        return linkcertificate.invalidate(resolver_context, link_ticket)
                    end or nil)
            end
            local cleaned, cleanup_error =
                driver.cleanup_staging_directories({ temporary_directory })
            if not cleaned then
                table.insert(errors, (valid and
                    "Windows library publication committed but staging cleanup failed: " or
                    "Windows library staging cleanup failed: ") .. cleanup_error)
            end
            if not valid then
                table.insert(errors, validation_err)
                if reporter and link_name then reporter:link_failed(link_name) end
            elseif reporter and link_name then
                reporter:link_done(link_name)
            end
        end
    else
        local ordered_archive_inputs = {}
        for _, name in ipairs(linked_names) do
            for _, object in ipairs(driver.module_compiled_objects(driver.imported[name])) do
                ordered_archive_inputs[#ordered_archive_inputs + 1] = {
                    kind = "object", input = object,
                }
            end
        end
        for _, static_provider in ipairs(
                resolver_context.selected_static_providers) do
            ordered_archive_inputs[#ordered_archive_inputs + 1] = {
                kind = "archive",
                input = static_provider,
            }
        end
        for _, input in ipairs(native_payload.inputs) do
            ordered_archive_inputs[#ordered_archive_inputs + 1] = {
                kind = input.object and "object" or "archive",
                input = input,
            }
        end

        local expected_entries
        if driver.context_target(resolver_context) == "browser" then
            expected_entries = {}
            for name, entry in pairs(physical_entries) do expected_entries[name] = entry end
            for _, name in ipairs(linked_names) do
                local mod = driver.imported[name]
                local native = assert(mod.object_metadata,
                    "browser source module has no coordinator object record")
                expected_entries[name] = {
                    abi = driver.TITAN_ABI_VERSION,
                    types = require("titan-compiler.types").serialize(mod.type),
                    layouts = native.layouts,
                }
            end
        end
        local pair, pair_err, pair_signal = driver.link_provider_pair({
            context = resolver_context,
            expected_entries = expected_entries,
            generated_objects = generated_objects,
            provider = provider,
            public_dso = provider_output,
            final_link_flags = link_ticket and link_ticket.dependency_argv,
            dsymutil = dsymutil,
            libnames = ofiles,
            verbose = args.verbose,
            static_archives = selected_static_archives,
            ordered_payload = native_payload.inputs,
            archive_inputs = ordered_archive_inputs,
            target = native_target,
            module_names = output_names,
            parallelism = jobs,
        })
        if pair_signal then
            -- Remove the resolver's temporaries before re-raising.
            close_coordinator_context()
            -- No stale region survives the re-raised signal.
            if reporter then reporter:fail() end
            require("titan-compiler.jobs").propagate(pair_signal)
            exit(pair_err)
        elseif not pair then
            table.insert(errors, pair_err)
            if reporter and link_name then reporter:link_failed(link_name) end
        else
            local published, publish_err =
                driver.publish_provider_bundle(
                    pair.dso, pair.archive, provider_output,
                    {
                        archive_only = driver.context_target(resolver_context) == "browser",
                        context = resolver_context,
                        native_inputs = native_inputs,
                    })
            driver.remove_path(pair.directory)
            if not published then
                table.insert(errors, "failed to publish provider pair '" ..
                    provider .. "': " .. tostring(publish_err))
                if reporter and link_name then reporter:link_failed(link_name) end
            elseif reporter and link_name then
                reporter:link_done(link_name)
            end
        end
    end
end

if #errors > 0 then exit(table.concat(errors, "\n")) end

-- The success record is written last, after the complete output set.
if link_ticket then
    local called, committed, commit_error =
        pcall(linkcertificate.commit, resolver_context, link_ticket)
    if not called then
        if type(committed) ~= "string" then error(committed, 0) end
        exit(committed)
    elseif not committed then
        exit("cannot record final link: " .. tostring(commit_error))
    end
end

finish()
