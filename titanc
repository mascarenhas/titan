#!/usr/bin/env lua

local argparse = require 'argparse'

local checker = require 'titan-compiler.checker'
local coder = require 'titan-compiler.coder'
local parser = require 'titan-compiler.parser'
local driver = require 'titan-compiler.driver'
local test_runner = require 'titan-compiler.test_runner'
local util = require 'titan-compiler.util'
local platform = require 'titan-compiler.platform'
local coverage = require 'titan-compiler.coverage'

-- Implementation notes: doc/implementation/driver.md#the-titanc-command-line
local p = argparse('titan', 'Titan compiler')
p:argument('module', 'Names of the modules to compile.'):args("*")
p:flag('--print-root', 'Print the selected Titan installation root and exit.')
p:flag('--print-ast', 'Print the AST.')
p:flag('--pretty-print', 'Format generated C and headers with clang-format.')
p:flag('-v --verbose', 'Be verbose about compiler invocations.')
p:option('-j --jobs',
    'Maximum concurrent generated-C compilations (default: TITAN_JOBS or 4).')
p:option('--c-parts',
    'Maximum generated-C translation units per module above the split threshold (default: TITAN_C_PARTS, 4 on Linux, or 1 on macOS/Windows).')
p:option('--launcher-name', 'Windows standalone/test launcher filename in bin (default: logical module name).')
p:flag('--static', 'Prefer static Titan archive providers (unsupported on Windows).')
p:flag('--source-first', 'Prefer available source modules to compiled providers.')
p:flag('--incremental', 'Reuse source module objects that are no older than their sources; the build system owns other invalidation.')
p:flag('-c --compile-only', 'Generate objects and headers only; always rebuild explicitly requested modules.')
p:flag('--test', 'Build native Titan tests (objects only with --compile-only).')
p:flag('--coverage', 'Instrument source modules without test_ functions and report when the test executable runs.')
p:option('--coverage-backend', 'Coverage backend: gcc-gcov (Unix default) or llvm-gcov (Windows default).')
p:option('--coverage-module', 'Override automatic selection with a logical module glob (* and ?); repeat for a union.'):count('*')
p:option('--coverage-root', 'Source repository root for reports (default: current directory).')
p:option('--coverage-gcov', 'Matching gcov reader command (default: GCOV, gcov, or llvm-cov gcov).')
p:option('--coverage-format', 'Optional richer report: html, lcov, or cobertura (requires gcovr); repeat for several.'):count('*')
p:option('--coverage-output', 'Report directory (default: .coverage/report).')
p:option('--coverage-gcovr', 'gcovr command for optional richer reports (default: gcovr).')
p:flag('--no-uv-bootstrap',
    'Call standalone main directly even if titan.uv installs its bootstrap hook.')
p:flag('--no-line-directives',
    'Omit source #line directives from generated C.')
p:option('-u --lua', 'Path to Lua source tree (source checkouts only; installed compilers use their matching Lua SDK).')
p:option('-t --tree', 'Root of the source tree, used for looking for source modules (defaults to ".").')
p:option('-o --output', 'Folder for generated files, preserving the source hierarchy (created if needed).')
p:option('-l --link', 'Comma-separated list of additional libraries to link into module.')
p:option('-X --extra-object',
    'Additional native object/archive payload carried into the linked provider outputs.'):args("*")
local args = p:parse()

local resolver_context
local resolver_cleanup <close> = setmetatable({}, {
    __close = function()
        if not resolver_context then return end
        local context = resolver_context
        resolver_context = nil
        -- Preserve the original exceptional-exit diagnostic. Ordinary exits
        -- use exit() or the explicit success close below and can report a
        -- cleanup failure directly.
        pcall(driver.close_resolver_context, context)
    end,
})

-- Work like assert, but don't print the stack trace
local function exit(msg)
    if resolver_context then
        local closed, close_err =
            driver.close_resolver_context(resolver_context)
        resolver_context = nil
        if not closed then
            msg = tostring(msg) .. "\nfailed to clean C probe service: " ..
                tostring(close_err)
        end
    end
    io.stderr:write(msg, "\n")
    os.exit(1)
end

local function finish()
    local closed, close_err = driver.close_resolver_context(resolver_context)
    resolver_context = nil
    if not closed then
        exit("failed to clean C probe service: " .. tostring(close_err))
    end
end

if args.print_root then
    if #args.module > 0 then
        exit("--print-root cannot be combined with module names")
    end
    local root, root_error = driver.resolve_installation_root(
        package.cpath, platform.getenv("TITAN_ROCKS_ROOT"))
    if not root then
        exit(root_error or "cannot locate the Titan installation root: " ..
            "package.cpath has no matching Titan or Lua installation entry")
    end
    io.stdout:write(root, "\n")
    return
end
if #args.module == 0 then
    exit("at least one module name is required (or use --print-root)")
end

if args.incremental and args.print_ast then
    exit("--incremental cannot be combined with --print-ast")
end
if not args.coverage and (#args.coverage_module > 0 or #args.coverage_format > 0 or
        args.coverage_root or args.coverage_gcov or args.coverage_backend or
        args.coverage_output or args.coverage_gcovr) then
    exit("coverage options require --coverage")
end
if platform.windows and args.static then
    exit("--static is not supported on Windows; Titan modules use DLL providers")
end
if args.compile_only then
    if args.launcher_name then
        exit("--launcher-name cannot be combined with --compile-only")
    end
    if args.link ~= nil or args.extra_object ~= nil or args.no_uv_bootstrap then
        exit("--compile-only cannot be combined with -l, -X, or --no-uv-bootstrap")
    end
end

local jobs_text = args.jobs or platform.getenv("TITAN_JOBS") or "4"
if type(jobs_text) ~= "string" or
   not jobs_text:match("^[1-9][0-9]*$") then
    exit("--jobs and TITAN_JOBS require a positive integer")
end
local jobs = tonumber(jobs_text)
if not jobs or jobs > math.maxinteger then
    exit("--jobs and TITAN_JOBS require a positive integer")
end

local explicit_c_parts = args.c_parts or platform.getenv("TITAN_C_PARTS")
local c_parts
if explicit_c_parts ~= nil then
    if type(explicit_c_parts) ~= "string" or
       not explicit_c_parts:match("^[1-9][0-9]*$") then
        exit("--c-parts and TITAN_C_PARTS require a positive integer")
    end
    c_parts = tonumber(explicit_c_parts)
    if not c_parts or c_parts > math.maxinteger then
        exit("--c-parts and TITAN_C_PARTS require a positive integer")
    end
end
local function link_failed(kind, modname, term, code)
    return string.format("failed to link %s '%s' (%s%s)",
        kind, modname, tostring(term), code and (", " .. tostring(code)) or "")
end

driver.TITAN_SOURCE_PATH = args.tree or driver.TITAN_SOURCE_PATH
driver.LUA_SOURCE_PATH = args.lua or driver.LUA_SOURCE_PATH
if args.no_line_directives then driver.EMIT_LINE_DIRECTIVES = false end
if args.output then
    local output, output_error = driver.prepare_output_root(args.output)
    if not output then exit(output_error) end
    args.output = output
end
-- Synchronous native publication APIs share the CLI's temporary-file root.
driver.OUTPUT_ROOT = args.output

resolver_context = driver.new_resolver_context({
    prefer_static = args.static,
    source_first = args.test or args.source_first,
    verbose = args.verbose,
    pretty_print = args.pretty_print,
    output_root = args.output,
})
if driver.TOOLCHAIN_ERROR then exit(driver.TOOLCHAIN_ERROR) end
if args.lua and driver.INSTALLED then
    exit("--lua is only available in a source checkout; the installed " ..
        "compiler must use its matching Lua SDK")
end
local configured, configure_error =
    driver.configure_foreign_c(resolver_context)
if not configured and configure_error then exit(configure_error) end
if not c_parts then
    c_parts = driver.default_c_parts and driver.default_c_parts()
        or ((not platform.windows and not driver.IS_DARWIN) and 4 or 1)
end
local coverage_build
if args.coverage then
    local coverage_error
    coverage_build, coverage_error = coverage.prepare(driver, args, resolver_context.io)
    if not coverage_build then exit(coverage_error) end
    driver.EXTRA_LDFLAGS = { table.unpack(driver.EXTRA_LDFLAGS or {}) }
    table.insert(driver.EXTRA_LDFLAGS, "--coverage")
    table.insert(driver.EXTRA_LDFLAGS, "-fno-lto")
end

local errors = {}
local main_module = nil

local requested_roots = {}
local requested_modules = driver.deduplicate_module_names(args.module)
local source_overrides = {}
for _, modname in ipairs(requested_modules) do
    if args.test and modname == test_runner.MODULE_NAME then
        exit("logical module '" .. test_runner.MODULE_NAME ..
            "' is reserved by --test")
    end
    requested_roots[modname] = true
end
local loader = driver.defaultloader({}, {
    source_roots = requested_roots,
    incremental = args.incremental,
    forced_source_roots = args.compile_only and requested_roots or {},
    source_overrides = source_overrides,
    context = resolver_context,
    coverage = coverage_build,
    output_root = args.output,
    c_parts = c_parts,
})

for _, modname in ipairs(requested_modules) do
    local ok, errs = checker.checkimport(modname, loader)
    if not ok then
        table.insert(errors, errs)
    else
        if #errs > 0 then table.insert(errors, table.concat(errs, "\n")) end
        local mod = driver.imported[modname]
        local ast = mod.ast
        if not args.test and not args.compile_only
           and (mod.has_main or ast and checker.has_main(ast)) then
            if main_module then
                table.insert(errors, modname .. ": multiple main functions found (already declared in " .. main_module .. ")")
            else
                main_module = modname
            end
        end
        if args.print_ast and ast then
            print(parser.pretty_print_ast(ast))
        end
    end
end

if coverage_build then
    local selected, selection_error = coverage.select(coverage_build, driver.imported)
    if not selected then table.insert(errors, selection_error) end
end
if #errors > 0 then exit(table.concat(errors, "\n")) end

local test_modules = {}
local test_program_output
local test_entrypoint_output
if args.test then
    if driver.imported[test_runner.MODULE_NAME] then
        exit("logical module '" .. test_runner.MODULE_NAME ..
            "' is reserved by --test")
    end
    local cases
    cases, test_modules = test_runner.discover(
        requested_modules, driver.imported, driver.dependency_closure)
    if not args.compile_only then
        test_program_output = assert(
            driver.imported[requested_modules[1]].program_output)
        test_entrypoint_output = test_program_output .. "__test_entrypoint.c"
        local runner_source, runner_source_err = test_runner.render(cases)
        if not runner_source then exit(runner_source_err) end
        source_overrides[test_runner.MODULE_NAME] =
            test_runner.source_descriptor(test_program_output, runner_source)
        requested_roots[test_runner.MODULE_NAME] = true
        local ok, errs = checker.checkimport(test_runner.MODULE_NAME, loader)
        if not ok then
            table.insert(errors, errs)
        elseif #errs > 0 then
            table.insert(errors, table.concat(errs, "\n"))
        end
        if #errors > 0 then exit(table.concat(errors, "\n")) end
        main_module = test_runner.MODULE_NAME
    end
end

if args.launcher_name then
    if not main_module then
        exit("--launcher-name is only valid when compiling a standalone executable")
    end
    local launcher, launcher_error =
        driver.windows_launcher_name(main_module, args.launcher_name)
    if not launcher then exit(launcher_error) end
    if not platform.windows then
        exit("--launcher-name is only supported for Windows launchers")
    end
end

if args.no_uv_bootstrap and not main_module then
    exit("--no-uv-bootstrap is only valid when compiling a standalone executable")
end
if coverage_build and not args.compile_only and not main_module then
    exit("--coverage requires a test or standalone executable; use -c for coverage objects")
end
if coverage_build and main_module and not args.compile_only and not test_entrypoint_output then
    test_entrypoint_output = driver.imported[main_module].program_output .. "__entrypoint.c"
end

local finalized, finalize_errors =
    driver.finalize_resolver_context(resolver_context)
if not finalized then
    exit(table.concat(finalize_errors, "\n"))
end
local selected_static_archives = {}
if platform.windows and #resolver_context.selected_static_providers > 0 then
    exit("Windows Titan dependencies require DLL providers; static Titan archives are not supported")
end
for _, static_provider in ipairs(
        resolver_context.selected_static_providers) do
    table.insert(selected_static_archives, static_provider.archive)
end

local provider
local provider_output
local windows_program_outputs
local shim_plans
local linked_names = {}
local output_names = {}
local output_name_set = {}
local physical_entries = {}
local native_inputs

for name in pairs(resolver_context.source_names) do
    table.insert(linked_names, name)
    output_name_set[name] = true
end
for _, static_provider in ipairs(
        resolver_context.selected_static_providers) do
    for name in pairs(static_provider.entries) do
        output_name_set[name] = true
        physical_entries[name] = static_provider.entries[name]
    end
end
table.sort(linked_names, util.bytewise_less)
for name in pairs(output_name_set) do table.insert(output_names, name) end
table.sort(output_names, util.bytewise_less)

for _, name in ipairs(linked_names) do
    local mod = driver.imported[name]
    if mod.ast then coder.prepare_coverage(mod.ast, coverage_build ~= nil) end
end

local header_plans = {}
local header_plan_by_name = {}
if #errors == 0 then
    local planned, header_err = driver.plan_foreign_headers(
        linked_names, driver.imported)
    if not planned then
        table.insert(errors, header_err)
    else
        header_plans = planned
        for _, plan in ipairs(planned) do
            header_plan_by_name[plan.modname] = plan
        end
    end
end

if main_module then
    local source_outputs = {}
    for _, name in ipairs(linked_names) do
        local mod = driver.imported[name]
        local header = header_plan_by_name[name]
        source_outputs[#source_outputs + 1] = {
            modname = name,
            output = mod.native_output or mod.filename,
            c_parts = c_parts,
            foreign_header = header and header.managed
                and header.filename or nil,
            ffi_header = header and header.ffi_header and header.ffi_header.filename or nil,
        }
    end
    local program_output = test_program_output or
        driver.imported[main_module].program_output or
        main_module:gsub("[.]", "/")
    local entrypoint_output = test_entrypoint_output or
        driver.generated_output_path(main_module:gsub("[.]", "/") .. "__entrypoint.c", args.output)
    local program_inputs = {}
    for name in pairs(resolver_context.source_names) do
        local mod = driver.imported[name]
        for _, filename in ipairs(mod.source_files or { mod.filename }) do
            program_inputs[#program_inputs + 1] = filename
        end
    end
    for _, mod in pairs(resolver_context.dynamic_names) do
        if mod.filename then
            program_inputs[#program_inputs + 1] = mod.filename
        end
    end
    for _, archive in ipairs(selected_static_archives) do
        program_inputs[#program_inputs + 1] = archive
    end
    for _, input in ipairs(args.extra_object or {}) do
        program_inputs[#program_inputs + 1] = input
    end
    local extra_outputs
    if platform.windows then
        local paths, path_error = driver.windows_program_paths(main_module,
            args.launcher_name, args.test and requested_modules[1] or nil,
            args.output)
        if not paths then exit(path_error) end
        windows_program_outputs = paths
        program_output = paths.executable
        extra_outputs = driver.windows_program_auxiliary_paths(
            entrypoint_output, paths.provider)
    end
    local outputs_ok, outputs_err = driver.validate_program_output_paths(
        source_outputs, program_output, entrypoint_output, program_inputs,
        extra_outputs)
    if not outputs_ok then table.insert(errors, outputs_err) end
end

local mangled_owners = {}
local symbol_owners = {}
local preflight_name_set = {}
for _, name in ipairs(output_names) do preflight_name_set[name] = true end
for name in pairs(resolver_context.dynamic_names) do
    preflight_name_set[name] = true
end
for name in pairs(resolver_context.native_bindings) do
    preflight_name_set[name] = true
end
local preflight_names = {}
for name in pairs(preflight_name_set) do
    preflight_names[#preflight_names + 1] = name
end
table.sort(preflight_names, util.bytewise_less)
for _, name in ipairs(preflight_names) do
    if name == "titan" then
        table.insert(errors, "logical module 'titan' is reserved by " ..
            "Titan's native Lua support module")
    end
    local mangled = driver.mangle_module_name(name)
    local previous = mangled_owners[mangled]
    if previous and previous ~= name then
        table.insert(errors, "cannot link logical modules '" .. previous ..
            "' and '" .. name .. "': both use C symbol prefix '" ..
            mangled .. "'")
    else
        mangled_owners[mangled] = name
        local imported = driver.imported[name]
        local interface = physical_entries[name]
        local symbols
        if imported and imported.external_symbols then
            symbols = imported.external_symbols
        elseif imported and imported.ast then
            symbols = coder.external_symbols(name, imported.ast)
        elseif imported and imported.type then
            symbols = coder.interface_external_symbols(name, imported.type)
        elseif interface and interface.type then
            symbols = coder.interface_external_symbols(name, interface.type)
        elseif resolver_context.native_interface_types[name] then
            symbols = coder.interface_external_symbols(
                name, resolver_context.native_interface_types[name])
        end
        if driver.record_module_symbols then
            driver.record_module_symbols(symbol_owners, name, symbols, errors)
            if imported and imported.private_symbols then
                driver.record_module_symbols(
                    symbol_owners, name, imported.private_symbols, errors)
            end
        else
            for _, entry in ipairs(symbols or {}) do
                local symbol_previous = symbol_owners[entry.symbol]
                if symbol_previous then
                    table.insert(errors, "cannot link C symbol '" ..
                        entry.symbol .. "': " .. symbol_previous.owner ..
                        " in logical module '" .. symbol_previous.module ..
                        "' conflicts with " .. entry.owner ..
                        " in logical module '" .. name .. "'")
                else
                    symbol_owners[entry.symbol] = {
                        module = name,
                        owner = entry.owner,
                    }
                end
            end
        end
    end
end

if not main_module and not args.compile_only then
    local _unique_roots, left, right
    provider, _unique_roots, left, right =
        driver.common_module_provider(requested_modules)
    if not provider then
        exit("cannot link modules into one shared library: '" ..
            tostring(left) .. "' and '" .. tostring(right) ..
            "' have no common module prefix")
    end

    if #errors == 0 then
        shim_plans, provider_output =
            driver.plan_module_shims(provider, output_names, args.output)
        if not shim_plans then table.insert(errors, provider_output) end
    end
    if #errors == 0 then
        native_inputs = {}
        for name in pairs(resolver_context.source_names) do
            local mod = driver.imported[name]
            for _, filename in ipairs(
                    mod.source_files or { mod.filename }) do
                native_inputs[#native_inputs + 1] = filename
            end
        end
        for name, mod in pairs(resolver_context.dynamic_names) do
            if mod.filename then
                native_inputs[#native_inputs + 1] = mod.filename
            end
        end
        for _, static_provider in ipairs(
                resolver_context.selected_static_providers) do
            native_inputs[#native_inputs + 1] = static_provider.archive
        end
        for _, input in ipairs(args.extra_object or {}) do
            native_inputs[#native_inputs + 1] = input
        end
        local generated_outputs = {}
        for _, name in ipairs(linked_names) do
            local mod = driver.imported[name]
            local stem = (mod.native_output or mod.filename):gsub(
                "[.]titan$", "")
            generated_outputs[#generated_outputs + 1] = {
                path = stem .. ".c",
                owner = "generated C for logical module '" .. name .. "'",
            }
            generated_outputs[#generated_outputs + 1] = {
                path = stem .. ".o",
                owner = "generated object for logical module '" .. name .. "'",
            }
            generated_outputs[#generated_outputs + 1] = {
                path = stem .. ".parts",
                owner = "generated parts companion for logical module '" .. name .. "'",
                marker = driver.PARTS_COMPANION_HEADER_PREFIX,
                marker_kind = "companion",
            }
            if c_parts > 1 then
                generated_outputs[#generated_outputs + 1] = {
                    path = stem .. ".priv.h",
                    owner = "generated private header for logical module '" .. name .. "'",
                    marker = driver.PRIVATE_HEADER_MARKER,
                    marker_kind = "generated-header",
                }
                for k = 1, c_parts - 1 do
                    generated_outputs[#generated_outputs + 1] = {
                        path = stem .. ".part" .. tostring(k) .. ".c",
                        owner = "generated C for logical module '" .. name .. "'",
                    }
                    generated_outputs[#generated_outputs + 1] = {
                        path = stem .. ".part" .. tostring(k) .. ".o",
                        owner = "generated object for logical module '" .. name .. "'",
                    }
                end
            end
            local header = header_plan_by_name[name]
            if header and header.managed then
                generated_outputs[#generated_outputs + 1] = {
                    path = header.filename,
                    owner = "generated foreign header for logical module '"
                        .. name .. "'",
                }
            end
        end
        for _, shim in ipairs(shim_plans or {}) do
            generated_outputs[#generated_outputs + 1] = {
                path = shim.filename,
                owner = "generated Lua shim for logical module '"
                    .. shim.modname .. "'",
            }
        end
        local outputs_ok, outputs_err =
            driver.validate_provider_output_paths(
                provider_output, native_inputs, generated_outputs)
        if not outputs_ok then table.insert(errors, outputs_err) end
    end
end

if #errors > 0 then exit(table.concat(errors, "\n")) end

local libnames = {}
local used_native_names = {}

local headers_ok, headers_err = driver.write_foreign_header_plans(
    header_plans, args.verbose, args.pretty_print)
if not headers_ok then exit(headers_err) end

local compile_requests = {}
for _, name in ipairs(linked_names) do
    local mod = driver.imported[name]
    local extra_flags = test_modules[name] and { table.unpack(test_runner.TEST_COMPILE_FLAGS) } or {}
    if coverage_build then
        for _, flag in ipairs(coverage.compile_flags(coverage_build, name) or {}) do
            extra_flags[#extra_flags + 1] = flag
        end
    end
    compile_requests[#compile_requests + 1] = {
        modname = name,
        mod = mod,
        static_deps = resolver_context.native_static_names,
        options = {
            pretty_print = args.pretty_print,
            nominal_layouts = resolver_context.nominal_layouts,
            extra_compile_flags = extra_flags,
            coverage = coverage_build and coverage_build.selected[name] == true,
            coverage_backend = coverage_build and coverage_build.backend,
            c_parts = c_parts,
        },
    }
end
local compile_results =
    driver.compile_modules(compile_requests, jobs, args.verbose)
for index, name in ipairs(linked_names) do
    local result = compile_results[index]
    local mod = driver.imported[name]
    if not result.ok then
        table.insert(errors, result.err)
    else
        libnames[name] = result.libname
        if driver.record_module_symbols and mod.private_symbols then
            driver.record_module_symbols(
                symbol_owners, name, mod.private_symbols, errors)
        end
        for used_name in pairs(mod.native_references or {}) do
            used_native_names[used_name] = true
        end
    end
end

if #errors > 0 then exit(table.concat(errors, "\n")) end

if args.compile_only then
    finish()
    return
end

local coverage_runtime
if coverage_build and main_module then
    local inventory_error
    coverage_runtime, inventory_error = coverage.inventory(coverage_build, driver.imported)
    if not coverage_runtime then exit(inventory_error) end
end

local generated_objects = {}
for _, name in ipairs(linked_names) do
    local mod = driver.imported[name]
    generated_objects[#generated_objects + 1] = {
        modname = name,
        filename = libnames[name],
        objects = driver.module_compiled_objects
            and driver.module_compiled_objects(mod, libnames[name])
            or { libnames[name] },
    }
end
local native_target, target_or_err =
    driver.derive_target_fingerprint(
        generated_objects[1].filename, generated_objects[1].modname)
if not native_target then
    exit("failed to derive generated native target: " .. tostring(target_or_err))
end
local generated_entries = platform.windows and {} or nil
local objects_valid, objects_err =
    driver.validate_generated_objects(generated_objects, native_target, generated_entries)
if not objects_valid then exit(objects_err) end
local providers_valid, providers_err =
    driver.prepare_static_providers_for_target(
        resolver_context.selected_static_providers, native_target)
if not providers_valid then exit(providers_err) end

if main_module then
    local ofiles = {}
    for _, name in ipairs(linked_names) do
        local mod = driver.imported[name]
        local objects = driver.module_compiled_objects
            and driver.module_compiled_objects(mod, libnames[name])
            or { libnames[name] }
        for _, object in ipairs(objects) do
            table.insert(ofiles, object)
        end
    end
    local archive_entries = {}
    local archive_names =
        driver.required_static_protocol_names(
            resolver_context, used_native_names)
    for _, name in ipairs(archive_names) do
        archive_entries[name] = assert(physical_entries[name])
    end
    local validate_titan_support = false
    for _, static_provider in ipairs(
            resolver_context.selected_static_providers) do
        if static_provider.relative_archive == "titan.a" then
            validate_titan_support = true
            break
        end
    end
    local probe_ok, probe_err = true
    if not platform.windows then
        probe_ok, probe_err = driver.run_standalone_archive_probe(
            archive_entries, archive_names, ofiles, selected_static_archives,
            args.link, args.verbose, args.extra_object,
            validate_titan_support, { pretty_print = args.pretty_print })
    end
    if not probe_ok then
        table.insert(errors, probe_err)
    else
        local program_output = test_program_output or
            driver.imported[main_module].program_output
        local ok, term, code = driver.compile_program(main_module, ofiles,
            args.link, args.verbose, args.extra_object,
            program_output, selected_static_archives,
            test_entrypoint_output,
            args.test and requested_modules[1]:gsub(".*[.]", "") or nil,
            {
                no_uv_bootstrap = args.no_uv_bootstrap,
                pretty_print = args.pretty_print,
                launcher_name = args.launcher_name,
                output_module = args.test and requested_modules[1] or nil,
                output_root = args.output,
                coverage_runtime = coverage_runtime,
                module_names = output_names,
                archive_entries = archive_entries,
                archive_names = archive_names,
                validate_titan_support = validate_titan_support,
            })
        if not ok then
            table.insert(errors, link_failed("program", main_module, term, code))
        end
    end
else
    local ofiles = {}
    for _, name in ipairs(linked_names) do
        local mod = driver.imported[name]
        local objects = driver.module_compiled_objects
            and driver.module_compiled_objects(mod, libnames[name])
            or { libnames[name] }
        for _, object in ipairs(objects) do
            table.insert(ofiles, object)
        end
    end
    local native_payload, payload_err =
        driver.classify_native_payloads(args.extra_object, native_target)
    if not native_payload then exit(payload_err) end
    local temporary, temporary_directory =
        driver.staged_library_output(provider_output)
    if not temporary then
        table.insert(errors, "failed to stage library '" .. provider ..
            "': " .. tostring(temporary_directory))
    end
    if #errors > 0 then exit(table.concat(errors, "\n")) end
    local ok, term, code = driver.compile_library_output(
        temporary, ofiles, args.link, args.verbose, nil,
        selected_static_archives, native_payload.inputs, provider_output,
        platform.windows and output_names or nil)
    if not ok then
        driver.remove_path(temporary)
        driver.remove_path(temporary .. ".dSYM")
        driver.remove_path(temporary_directory)
        table.insert(errors, link_failed("library", provider, term, code))
    elseif platform.windows then
        local valid, validation_err = driver.validate_library_image_fresh(
            temporary, generated_entries, output_names, args.verbose)
        if valid and provider == "titan" then
            valid, validation_err = driver.validate_titan_support(temporary, args.verbose)
        end
        if valid then
            valid, validation_err = driver.publish_windows_provider(
                temporary, provider_output, shim_plans, provider)
        end
        driver.remove_path(temporary)
        driver.remove_path(temporary_directory)
        if not valid then table.insert(errors, validation_err) end
    else
        local ordered_archive_inputs = {}
        for _, name in ipairs(linked_names) do
            ordered_archive_inputs[#ordered_archive_inputs + 1] = {
                kind = "object",
                input = libnames[name],
            }
        end
        for _, static_provider in ipairs(
                resolver_context.selected_static_providers) do
            ordered_archive_inputs[#ordered_archive_inputs + 1] = {
                kind = "archive",
                input = static_provider,
            }
        end
        for _, input in ipairs(native_payload.inputs) do
            ordered_archive_inputs[#ordered_archive_inputs + 1] = {
                kind = input.object and "object" or "archive",
                input = input,
            }
        end

        local temporary_archive = temporary:gsub("[.]so$", ".a")
        local archive_result, archive_err = driver.build_static_archive(
            temporary_archive, nil, nil, native_target, args.verbose,
            ordered_archive_inputs)
        if not archive_result then
            driver.remove_path(temporary)
            driver.remove_path(temporary .. ".dSYM")
            driver.remove_path(temporary_archive)
            driver.remove_path(temporary_directory)
            table.insert(errors, "failed to build static provider '" ..
                provider .. "': " .. tostring(archive_err))
        else
        local valid, validation_err =
            driver.validate_library_image(temporary, output_names)
        if valid and provider == "titan" then
            valid, validation_err =
                driver.validate_titan_support(temporary, args.verbose)
        end
        if valid then
            valid, validation_err =
                driver.validate_archive_library_equality(
                    archive_result.archive, temporary, output_names,
                    "staged provider pair for '" .. provider .. "'")
        end
        if valid then
            valid, validation_err =
                driver.validate_library_image_fresh(
                    temporary, archive_result.entries, output_names,
                    args.verbose)
        end
        local validation_image = temporary_directory ..
            "/archive-validation.so"
        if valid then
            local image_ok, image_term, image_code =
                driver.compile_archive_validation_image(
                    validation_image, temporary_archive, args.link,
                    args.verbose, nil, platform.windows and output_names or nil)
            if not image_ok then
                valid = nil
                validation_err = link_failed(
                    "archive validation image", provider,
                    image_term, image_code)
            end
        end
        if valid then
            valid, validation_err =
                driver.validate_library_image(
                    validation_image, output_names)
        end
        if valid and provider == "titan" then
            valid, validation_err =
                driver.validate_titan_support(
                    validation_image, args.verbose)
        end
        if valid then
            valid, validation_err =
                driver.validate_archive_library_equality(
                    archive_result.archive, validation_image, output_names,
                    "archive-backed provider for '" .. provider .. "'")
        end
        if valid then
            valid, validation_err =
                driver.validate_library_image_fresh(
                    validation_image, archive_result.entries, output_names,
                    args.verbose)
        end
        driver.remove_path(validation_image)
        driver.remove_path(validation_image .. ".dSYM")
        if not valid then
            driver.remove_path(temporary)
            driver.remove_path(temporary .. ".dSYM")
            driver.remove_path(temporary_archive)
            driver.remove_path(temporary_directory)
            table.insert(errors, validation_err)
        else
            local published, publish_err =
                driver.publish_provider_bundle(
                    temporary, temporary_archive, provider_output,
                    shim_plans, archive_result.entries, {
                        provider = provider,
                        native_inputs = native_inputs,
                        output_root = args.output,
                    })
            if not published then
                driver.remove_path(temporary)
                driver.remove_path(temporary .. ".dSYM")
                driver.remove_path(temporary_archive)
                driver.remove_path(temporary_directory)
                table.insert(errors, "failed to publish provider pair '" ..
                    provider .. "': " .. tostring(publish_err))
            else
                driver.remove_path(temporary_directory)
            end
        end
        end
    end
end

if #errors > 0 then exit(table.concat(errors, "\n")) end


finish()
