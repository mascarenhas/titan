{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime.version": "Lua 5.5",
    "workspace.library": [
        "${3rd}/busted/library",
        "${3rd}/luassert/library"
    ],
    "workspace.ignoreDir": [
        "lua-5.5.0"
    ],
    "diagnostics.globals": [
        "jit",
        "bit"
    ],
    "diagnostics.disable": [
        "redefined-local",
        "redundant-parameter"
    ]
}
