# Native Windows x64 / MSYS2 CLANG64 build. Invoke from that environment with
# make -f Makefile.win lua PREFIX=/c/path/to/titan-sdk
# Experimental controlled Lua and native dependency DLLs with matching SDKs.
SHELL := $(if $(filter Windows_NT,$(OS)),bash.exe,/bin/bash)
.SHELLFLAGS := -eu -o pipefail -c
.DELETE_ON_ERROR:
.NOTPARALLEL:
.DEFAULT_GOAL := all

# Choose the policy before configuring any source or native object graph.
TITAN_WINDOWS_COVERAGE_GOALS := titan-native-coverage-build titan-native-coverage-run titan-native-coverage
TITAN_WINDOWS_TEST_GOALS := toolchain-check lua-source-check lua-check native-source-check native-check compiler-check runtime-check stdlib-check compiler-publication-check titan-stdlib-test-build titan-stdlib-test-run titan-stdlib-test rock-test test $(TITAN_WINDOWS_COVERAGE_GOALS)
TITAN_BUILD_PROFILE ?= $(if $(filter $(TITAN_WINDOWS_TEST_GOALS),$(MAKECMDGOALS)),validation,production)
ifneq ($(TITAN_BUILD_PROFILE),production)
ifneq ($(TITAN_BUILD_PROFILE),validation)
$(error TITAN_BUILD_PROFILE must be production or validation)
endif
endif
export TITAN_BUILD_PROFILE
TITAN_WINDOWS_VALIDATION_FLAGS := -O0 -fno-lto
TITAN_WINDOWS_NATIVE_CFLAGS = $(if $(filter validation,$(TITAN_BUILD_PROFILE)),$(TITAN_WINDOWS_VALIDATION_FLAGS),-O2)
TITAN_WINDOWS_NATIVE_LDFLAGS = $(if $(filter validation,$(TITAN_BUILD_PROFILE)),$(TITAN_WINDOWS_VALIDATION_FLAGS))
# Compiler host components stay optimized while Titan validation stays at O0.
TITAN_PROFILE_HOST_FLAGS = $(if $(filter validation,$(TITAN_BUILD_PROFILE)),-O2 -fno-lto)

quote = '$(subst ','"'"',$(1))'
empty :=
space := $(empty) $(empty)
make_path = $(subst $(space),\$(space),$(1))
# Recursive compiler wrappers must not execute under Make dry-run/query/touch.
RECURSIVE_WRAPPER_GUARD = titan_mode=; set -f; set -- $$MAKEFLAGS; set +f; \
	for titan_word do case "$$titan_word" in --) break ;; --*) ;; \
	  *[!-BLRSdeijknpqrstvw]*) ;; *) titan_mode=$$titan_mode$$titan_word ;; esac; done; \
	case "$$titan_mode" in *q*) exit 1 ;; *n*|*t*) exit 0 ;; esac;
TITAN_JOBS ?= 4
export TITAN_JOBS
ifeq ($(origin CC),default)
CC := clang.exe
endif
CC ?= clang.exe
ifeq ($(origin RC),default)
RC := llvm-rc
endif
RC ?= llvm-rc
LUA_CFLAGS ?= $(if $(filter validation,$(TITAN_BUILD_PROFILE)),$(TITAN_PROFILE_HOST_FLAGS),-O2) -Wall -Wextra
LUA_CPPFLAGS ?=
LUA_LDFLAGS ?= $(TITAN_PROFILE_HOST_FLAGS)
PREFIX ?= $(CURDIR)/$(if $(filter validation,$(TITAN_BUILD_PROFILE)),.windows-sdk-validation,.windows-sdk)
ROCKS_TREE ?= $(PREFIX)
WINDOWS_BUILD_ROOT ?= $(CURDIR)/$(if $(filter validation,$(TITAN_BUILD_PROFILE)),out/windows-validation,out/windows)

# Native GNU Make requires C:/ paths; MSYS Make accepts /c paths. Apply this
# after direct-entry defaults, and only to values that are actually present.
ifeq ($(OS),Windows_NT)
WINDOWS_PATH_FORMAT := $(if $(filter %mingw32,$(MAKE_HOST)),-m,-u)
override PREFIX := $(shell cygpath $(WINDOWS_PATH_FORMAT) "$(PREFIX)")
override WINDOWS_BUILD_ROOT := $(shell cygpath $(WINDOWS_PATH_FORMAT) "$(WINDOWS_BUILD_ROOT)")
ifneq ($(strip $(ROCKS_TREE)),)
override ROCKS_TREE := $(shell cygpath $(WINDOWS_PATH_FORMAT) "$(ROCKS_TREE)")
endif
endif

LUA_VERSION := 5.5.1
LUA_DIR := lua-$(LUA_VERSION)
LUA_SOURCE_READY := $(LUA_DIR)/src/lua.h
LUA_SOURCE := $(WINDOWS_BUILD_ROOT)/lua-$(LUA_VERSION)/src
# Retain Lua's standard DLL identity for independently built binary modules.
LUA_RESOURCE := $(LUA_SOURCE)/lua-windows.res
LUA_MANIFEST := vendor/lua/lua-$(LUA_VERSION)-windows.manifest
LUA_RC_SOURCE := vendor/lua/lua-$(LUA_VERSION)-windows.rc
LUA_BIN := $(PREFIX)/bin/lua.exe
TITAN_VERSION := 0.6.0
TITAN_LIBRARY_VERSION := $(word 1,$(subst ., ,$(TITAN_VERSION))).$(word 2,$(subst ., ,$(TITAN_VERSION)))
TITAN_INSTALL_TREE := $(PREFIX)
# The runtime build's support-only Lua module and native compiler frontend.
# The shared compiler install deploys them as the ordinary native module
# lib/lua/5.5/titan.dll and as bin/titanc.exe, which replaces a script
# launcher. The shared recipe derives the module's destination name without
# splitting our spaced build path.
TITAN_SUPPORT_MODULE = $(WINDOWS_BUILD_ROOT)/runtime/titan.dll
TITANC_NATIVE = $(WINDOWS_BUILD_ROOT)/runtime/titanc.exe
# This is still the only loaded Makefile. GNU Make's word-based path functions
# split checkout paths containing spaces, so let the recipe shell find its dir.
TITAN_MAKEFILE_DIR := $(shell dirname $(call quote,$(MAKEFILE_LIST)))/
include $(call make_path,$(TITAN_MAKEFILE_DIR)scripts/install_compiler.mk)


.PHONY: help lua-source lua-source-check lua-build lua lua-check toolchain-check FORCE
help:
	@echo 'Windows CLANG64/UCRT x64 targets:'
	@echo '  all         build the runtime, native dependencies and standard library (default)'
	@echo '  lua-source  copy the Lua submodule sources unchanged into the Windows source stage'
	@echo '  lua-source-check  test configured headers with Clang COFF objects (also on Linux)'
	@echo '  lua-build   build lua55.dll, its import library, and lua.exe'
	@echo '  lua         install those files and the complete matching Lua SDK'
	@echo '  lua-check   check native exports/imports and exercise SDK consumers'
	@echo '  native-source-check  check configured native headers with Clang COFF objects'
	@echo '  native      build/install native SDK (system OpenSSL by default)'
	@echo '  libbacktrace  build/install the pinned static Windows traceback library'
	@echo '  native-check  inspect private PE imports and run native SDK consumers'
	@echo '  luarocks    install standalone LuaRocks into the Lua SDK prefix'
	@echo '  compiler    build and install the Titan source rock with LuaRocks'
	@echo '  compiler-check  validate the installed compiler and dependencies'
	@echo '  runtime     build/install the runtime SDK (compiler install deploys the support module and titanc.exe)'
	@echo '  runtime-check  validate runtime consumers, rebuilds and the support DLL'
	@echo '  stdlib      use the installed compiler/SDK to build the standard provider'
	@echo '  stdlib-check  validate the staged provider, metadata and PE inventory'
	@echo '  install-stdlib  build and copy the Windows DLL-only provider'
	@echo '  publish-stdlib  copy an already built Windows provider'
	@echo '  compiler-publication-check  validate compiler provider publication'
	@echo '  titan-stdlib-test-build  build all shared native tests in a private NTFS SDK copy'
	@echo '  titan-stdlib-test-run  run the built aggregate, optionally with TITAN_FILTER'
	@echo '  titan-stdlib-test  build and run the shared native aggregate'
	@echo '  titan-native-coverage-build  build source-linked coverage tests in a private SDK copy'
	@echo '  titan-native-coverage-run  run the native suite and produce fresh coverage reports'
	@echo '  titan-native-coverage  build and run coverage tests; prepared SDK required'

FORCE:

$(call make_path,$(LUA_SOURCE_READY)):
	@echo 'ERROR: Lua source is missing; initialize the Lua submodule.'
	@echo 'Run: git submodule update --init --recursive'
	@exit 1

# Keep Windows objects out of the Unix source tree. Lua owns installation.
lua-source: $(call make_path,$(LUA_SOURCE_READY))
	mkdir -p $(call quote,$(LUA_SOURCE)) $(call quote,$(WINDOWS_BUILD_ROOT)/lua-$(LUA_VERSION)/doc)
	cp -p $(call quote,$(LUA_DIR)/Makefile) $(call quote,$(WINDOWS_BUILD_ROOT)/lua-$(LUA_VERSION)/)
	cp -p $(call quote,$(LUA_DIR)/src/)*.c $(call quote,$(LUA_DIR)/src/)*.h \
	  $(call quote,$(LUA_DIR)/src/lua.hpp) $(call quote,$(LUA_DIR)/src/Makefile) $(call quote,$(LUA_SOURCE)/)
	cp -p $(call quote,$(LUA_DIR)/doc/)lua.1 $(call quote,$(LUA_DIR)/doc/)luac.1 \
	  $(call quote,$(WINDOWS_BUILD_ROOT)/lua-$(LUA_VERSION)/doc/)

lua-source-check: lua-source
	perl spec/support/check_windows_lua_source.pl $(call quote,$(LUA_SOURCE)) clang llvm-readobj

toolchain-check:
	@test "$${MSYSTEM:-}" = CLANG64 || { echo 'Use the native MSYS2 CLANG64 environment (x64 UCRT)' >&2; exit 1; }
	@test "$$($(CC) -dumpmachine)" = x86_64-w64-windows-gnu || { echo 'Expected the CLANG64 x86_64 Windows GNU target' >&2; exit 1; }
	@printf '%s\n' '#include <_mingw.h>' \
	  '#if !defined(__clang__) || !defined(_WIN64) || !defined(_UCRT)' \
	  '#error Expected native Clang x64 with UCRT headers' '#endif' | $(CC) -x c -E - >/dev/null
	@$(CC) --version | head -n 1

# Lua owns its DLL and interpreter link graph, including luac.exe. The stock
# sources export their public surface through LUA_BUILD_AS_DLL and every
# remaining symbol through the fork mingw link's --export-all-symbols.
lua-build: lua-source
	$(RC) -FO $(call quote,$(LUA_RESOURCE)) $(call quote,$(LUA_RC_SOURCE))
	+$(MAKE) -j1 -C $(call quote,$(LUA_SOURCE)) mingw \
	  PREFIX=$(call quote,$(PREFIX)) \
	  CC=$(call quote,$(CC) -std=c99) \
	  CFLAGS=$(call quote,$(LUA_CPPFLAGS) $(LUA_CFLAGS) -DLUA_BUILD_AS_DLL) \
	  MYLDFLAGS=$(call quote,$(LUA_LDFLAGS) -Xlinker --no-insert-timestamp) \
	  MYDLLFLAGS=$(call quote,$(LUA_LDFLAGS) -Xlinker --no-insert-timestamp) \
	  LUA_IMPLIB=liblua55.a MYLUAOBJS=lua-windows.res MINGW_STRIP=

# An existing interpreter is sufficient. To change Lua sources or flags, clean
# the private Lua outputs and remove the installed interpreter before rebuilding.
lua: $(call make_path,$(LUA_BIN))

$(call make_path,$(LUA_BIN)):
	+$(MAKE) -f Makefile.win lua-build
	+$(MAKE) -C $(call quote,$(WINDOWS_BUILD_ROOT)/lua-$(LUA_VERSION)) install \
	  PREFIX=$(call quote,$(PREFIX))

lua-check: lua
	CC=$(call quote,$(CC)) bash spec/support/check_windows_lua.sh $(call quote,$(PREFIX)) $(call quote,$(WINDOWS_BUILD_ROOT))

# Native dependencies are built in the same CLANG64/UCRT identity as Lua.
ifeq ($(origin CXX),default)
CXX := clang++
endif
CXX ?= clang++
ifeq ($(origin AR),default)
AR := llvm-ar
endif
AR ?= llvm-ar
RANLIB ?= llvm-ranlib
NATIVE_CFLAGS ?= $(if $(ROCK_CFLAGS),$(ROCK_CFLAGS) )$(TITAN_WINDOWS_NATIVE_CFLAGS)
NATIVE_CPPFLAGS ?=
NATIVE_LDFLAGS ?= $(TITAN_WINDOWS_NATIVE_LDFLAGS)
OPENSSL_MODE ?= system
OPENSSL_PREFIX ?= $(if $(MINGW_PREFIX),$(MINGW_PREFIX),/clang64)
ifneq ($(OPENSSL_MODE),system)
ifneq ($(OPENSSL_MODE),bundled)
$(error OPENSSL_MODE must be system or bundled)
endif
endif
export OPENSSL_MODE OPENSSL_PREFIX

# Keep this acquisition independent: the runtime does not need to download the
# other native providers just to build its traceback dependency.
LIBBT_SOURCE := $(WINDOWS_BUILD_ROOT)/native-src/libbacktrace-0b9b49cf4a2c9229fc052d6716e1528b2f23e91a
LIBBT_BUILD_DIR := $(WINDOWS_BUILD_ROOT)/native/libbacktrace
LIBBT_MAKE := $(MAKE)
LIBBT_CFLAGS ?= $(NATIVE_CFLAGS) -g
LIBBT_CPPFLAGS ?= $(NATIVE_CPPFLAGS)
LIBBT_LDFLAGS ?= $(NATIVE_LDFLAGS)
.PHONY: libbacktrace
libbacktrace:
	perl scripts/prepare_windows_native.pl $(call quote,$(WINDOWS_BUILD_ROOT)/native-src) vendor/libbacktrace/dependencies.tsv $(call quote,$(OPENSSL_MODE))
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) MAKE=$(call quote,$(LIBBT_MAKE)) \
	  LIBBT_CFLAGS=$(call quote,$(LIBBT_CFLAGS)) LIBBT_CPPFLAGS=$(call quote,$(LIBBT_CPPFLAGS)) \
	  LIBBT_LDFLAGS=$(call quote,$(LIBBT_LDFLAGS)) \
	  bash scripts/build_windows_libbacktrace.sh $(call quote,$(LIBBT_SOURCE)) $(call quote,$(LIBBT_BUILD_DIR)) $(call quote,$(PREFIX))

.PHONY: native-source native native-source-check
native-source:
	perl scripts/prepare_windows_native.pl $(call quote,$(WINDOWS_BUILD_ROOT)/native-src) vendor/windows-native/dependencies.tsv $(call quote,$(OPENSSL_MODE))

native: native-source
	CC=$(call quote,$(CC)) CXX=$(call quote,$(CXX)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  NATIVE_CFLAGS=$(call quote,$(NATIVE_CFLAGS)) NATIVE_CPPFLAGS=$(call quote,$(NATIVE_CPPFLAGS)) \
	  NATIVE_LDFLAGS=$(call quote,$(NATIVE_LDFLAGS)) \
	  bash scripts/build_windows_native.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

native-source-check: native-source
	perl spec/support/check_windows_native_source.pl $(call quote,$(WINDOWS_BUILD_ROOT)/native-src) clang llvm-readobj

.PHONY: native-check
native-check: native
	CC=$(call quote,$(CC)) bash spec/support/check_windows_native.sh $(call quote,$(PREFIX)) $(call quote,$(WINDOWS_BUILD_ROOT))

# Native LuaRocks installs the compiler and its declared dependencies.
LUAROCKS ?= $(PREFIX)/bin/luarocks.exe
LUAROCKS_CONFIG ?= $(PREFIX)/etc/luarocks/config-5.5.lua
TITAN_BINARY_ROCK_CONFIG := $(LUAROCKS_CONFIG)
binary-rock: export LUAROCKS_CONFIG = $(shell cygpath -m "$(TITAN_BINARY_ROCK_CONFIG)")
COMPILER_DEPS_CFLAGS ?= $(if $(filter validation,$(TITAN_BUILD_PROFILE)),$(TITAN_PROFILE_HOST_FLAGS),-O2)
COMPILER_DEPS_LDFLAGS ?= $(TITAN_PROFILE_HOST_FLAGS)
export WINDOWS_BUILD_ROOT

.PHONY: luarocks compiler-deps compiler compiler-check
luarocks: $(call make_path,$(PREFIX)/bin/luarocks.exe)

$(call make_path,$(PREFIX)/bin/luarocks.exe): | lua
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  ROCK_MAKE=$(call quote,$(MAKE)) \
	  COMPILER_DEPS_CFLAGS=$(call quote,$(COMPILER_DEPS_CFLAGS)) \
	  COMPILER_DEPS_LDFLAGS=$(call quote,$(COMPILER_DEPS_LDFLAGS)) \
	  bash scripts/install_windows_luarocks.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

compiler-deps: luarocks
	LUAROCKS_CONFIG=$(call quote,$(shell cygpath -m "$(LUAROCKS_CONFIG)")) \
	  $(call quote,$(LUAROCKS)) --lua-version=5.5 \
	  --tree=$(call quote,$(shell cygpath -m "$(PREFIX)")) make --only-deps titan-0.6.0-1.rockspec \
	  CC=$(call quote,$(CC)) LD=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB))

compiler: luarocks
	LUAROCKS_CONFIG=$(call quote,$(shell cygpath -m "$(LUAROCKS_CONFIG)")) \
	  $(call quote,$(LUAROCKS)) --lua-version=5.5 \
	  --tree=$(call quote,$(shell cygpath -m "$(PREFIX)")) make titan-0.6.0-1.rockspec \
	  CC=$(call quote,$(CC)) LD=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB))

compiler-check: compiler
	bash spec/support/check_windows_compiler.sh $(call quote,$(PREFIX)) $(call quote,$(WINDOWS_BUILD_ROOT))

# The shared install-compiler recipe only deploys built files. It copies the
# support module and titanc.exe, which a rock build has already produced.
.PHONY: check-support-module
check-support-module:
	@test -f $(call quote,$(TITAN_SUPPORT_MODULE)) && test -f $(call quote,$(TITANC_NATIVE)) || { \
	  echo 'The support module or titanc.exe is missing; run make -f Makefile.win runtime-build first.' >&2; \
	  exit 1; }

# Runtime archive, private parser payload, the support module and titanc.exe.
# The shared compiler install deploys $(TITAN_SUPPORT_MODULE) as
# lib/lua/5.5/titan.dll and $(TITANC_NATIVE) as bin/titanc.exe.
RUNTIME_CFLAGS ?= $(if $(ROCK_CFLAGS),$(ROCK_CFLAGS) )$(TITAN_WINDOWS_NATIVE_CFLAGS) -Wall -Wextra
RUNTIME_CPPFLAGS ?=
RUNTIME_LDFLAGS ?= $(TITAN_WINDOWS_NATIVE_LDFLAGS)
LPEGLABEL_BUILD_CFLAGS ?= $(if $(ROCK_CFLAGS),$(ROCK_CFLAGS) )$(TITAN_PROFILE_HOST_FLAGS)
TITAN_LICENSE_FILES := libuv-LICENSE libuv-LICENSE-extra libuv-tree-LICENSE libuv-inet-LICENSE \
	lpeglabel-LICENSE lpeg-LICENSE lpeg-patterns-LICENSE ta-regex-LICENSE lua-LICENSE \
	llhttp-LICENSE sqlite3-LICENSE openssl-LICENSE go-LICENSE libbacktrace-LICENSE llvm-LICENSE

.PHONY: runtime-build runtime install-titan-sdk runtime-check
runtime-build: lua libbacktrace
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) RC=$(call quote,$(RC)) \
	  RUNTIME_CFLAGS=$(call quote,$(RUNTIME_CFLAGS)) \
	  RUNTIME_CPPFLAGS=$(call quote,$(RUNTIME_CPPFLAGS)) \
	  RUNTIME_LDFLAGS=$(call quote,$(RUNTIME_LDFLAGS)) \
	  LPEGLABEL_BUILD_CFLAGS=$(call quote,$(LPEGLABEL_BUILD_CFLAGS)) \
	  bash scripts/build_windows_runtime.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

runtime: install-titan-sdk

install-titan-sdk: runtime-build
publish-titan-sdk:
install-titan-sdk publish-titan-sdk:
	mkdir -p $(call quote,$(TITAN_INSTALL_TREE)/lib/titan/$(TITAN_LIBRARY_VERSION)) \
	  $(call quote,$(TITAN_INSTALL_TREE)/include/titan) $(call quote,$(TITAN_INSTALL_TREE)/etc/titan) \
	  $(call quote,$(TITAN_INSTALL_TREE)/share/titan/LICENSES)
	cp -p $(call quote,$(WINDOWS_BUILD_ROOT)/runtime/libtitan.a) $(call quote,$(TITAN_INSTALL_TREE)/lib/titan/$(TITAN_LIBRARY_VERSION)/libtitan.a)
	cp -p titan-runtime/titan.h titan-runtime/minicoro.h titan-runtime/transfer.h $(call quote,$(TITAN_INSTALL_TREE)/include/)
	cp -p titan-runtime/titan/ffi.h titan-runtime/titan/browser.h $(call quote,$(TITAN_INSTALL_TREE)/include/titan/)
	cp -p LICENSE $(call quote,$(TITAN_INSTALL_TREE)/share/titan/LICENSE)
	cp -p THIRD_PARTY_NOTICES.md $(call quote,$(TITAN_INSTALL_TREE)/share/titan/THIRD_PARTY_NOTICES.md)
	for filename in $(TITAN_LICENSE_FILES); do cp -p "LICENSES/$$filename" $(call quote,$(TITAN_INSTALL_TREE)/share/titan/LICENSES/); done
	printf '%s\n' $(call quote,$(TITAN_BUILD_PROFILE)) > $(call quote,$(TITAN_INSTALL_TREE)/etc/titan/build-profile)

runtime-check: runtime
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  RUNTIME_CFLAGS=$(call quote,$(RUNTIME_CFLAGS)) \
	  RUNTIME_CPPFLAGS=$(call quote,$(RUNTIME_CPPFLAGS)) \
	  RUNTIME_LDFLAGS=$(call quote,$(RUNTIME_LDFLAGS)) \
	  LPEGLABEL_BUILD_CFLAGS=$(call quote,$(LPEGLABEL_BUILD_CFLAGS)) \
	  bash spec/support/check_windows_runtime_sdk.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

STDLIB_MODULES := coroutine uv async timer io fs net ssl url http websocket os path peg string math lua iteration gc test reflect sqlite3 json protobuf transfer thread
STDLIB_ROOTS := $(addprefix titan.,$(STDLIB_MODULES))

.PHONY: stdlib stdlib-check install-stdlib publish-stdlib compiler-publication-check
# Implementation notes: doc/implementation/windows-build.md#standard-provider-build-and-publication
# Use the installed compiler and an already prepared native/runtime SDK.
stdlib: titan/transfer_native.h titan/async_receiver_native.h titan/uv/external-wake-native.h
	+$(RECURSIVE_WRAPPER_GUARD) CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  TITAN_EXTRA_CFLAGS=$(call quote,$(if $(ROCK_CFLAGS),$(ROCK_CFLAGS) )$(TITAN_WINDOWS_NATIVE_CFLAGS) $(TITAN_EXTRA_CFLAGS)) \
	  ROCK_TITANC=$(call quote,$(ROCK_TITANC)) ROCK_LUA=$(call quote,$(ROCK_LUA)) \
	  STDLIB_USE_INSTALLED_RUNTIME=$(call quote,$(STDLIB_USE_INSTALLED_RUNTIME)) \
	  bash scripts/build_windows_stdlib.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX)) $(STDLIB_ROOTS)

# The staged provider and the installed support module are both inputs; this
# gate validates them and never rebuilds either.
stdlib-check:
	bash spec/support/check_windows_stdlib.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

install-stdlib: stdlib
	+$(MAKE) -f Makefile.win publish-stdlib

# Publishing an already built stage must not rebuild or replace its inputs.
publish-stdlib:
	mkdir -p $(call quote,$(TITAN_INSTALL_TREE)/lib/titan/$(TITAN_LIBRARY_VERSION))
	cp -p $(call quote,$(WINDOWS_BUILD_ROOT)/out/titan.dll) $(call quote,$(TITAN_INSTALL_TREE)/lib/titan/$(TITAN_LIBRARY_VERSION)/titan.dll)
	rm -f $(call quote,$(TITAN_INSTALL_TREE)/share/titan/$(TITAN_LIBRARY_VERSION)/src/titan/test.titan)

compiler-publication-check: runtime
	bash spec/support/check_windows_publication.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

# The source inventory is identical to the Unix aggregate. Windows keeps its
# native outputs and copied SDK in an explicitly owned local NTFS workspace.
include spec/support/stdlib_test_modules.mk
TITAN_TEST_BUILD_DIR ?= $(WINDOWS_BUILD_ROOT)/stdlib-tests
TITAN_TEST_MAKE := $(MAKE)
TITAN_TEST_TIMEOUT ?= $(if $(filter $(TITAN_WINDOWS_COVERAGE_GOALS),$(MAKECMDGOALS)),600,1800)
TITAN_FILTER ?=
.PHONY: titan-stdlib-test-build titan-stdlib-test-run titan-stdlib-test
titan-stdlib-test-build:
	+$(RECURSIVE_WRAPPER_GUARD) MAKE=$(call quote,$(TITAN_TEST_MAKE)) CC=$(call quote,$(CC)) TITAN_TEST_TIMEOUT=$(call quote,$(TITAN_TEST_TIMEOUT)) \
	  bash spec/support/windows_stdlib_tests.sh build $(call quote,$(TITAN_TEST_BUILD_DIR)) $(call quote,$(PREFIX))

titan-stdlib-test-run:
	TITAN_TEST_TIMEOUT=$(call quote,$(TITAN_TEST_TIMEOUT)) TITAN_FILTER=$(call quote,$(TITAN_FILTER)) \
	  bash spec/support/windows_stdlib_tests.sh run $(call quote,$(TITAN_TEST_BUILD_DIR))

titan-stdlib-test: titan-stdlib-test-build
	+$(RECURSIVE_WRAPPER_GUARD) $(MAKE) -f Makefile.win titan-stdlib-test-run

# Native Make schedules these authored inputs, but MSYS Bash owns UTF-8 output
# names and freshness checks: native Make's ANSI recipe/stat boundary must not
# receive the Unicode host-child basename.
TITAN_TEST_NATIVE_INPUT_DIR = $(TITAN_TEST_BUILD_DIR)/cwd/spec/fixtures/stdlib/native
.PHONY: windows-stdlib-test-native
windows-stdlib-test-native: spec/support/build_windows_stdlib_native.sh \
		$(call make_path,$(TITAN_TEST_NATIVE_INPUT_DIR)/os_process_host_child.c) \
		$(call make_path,$(TITAN_TEST_NATIVE_INPUT_DIR)/os_process_host_child_windows.h) \
		$(call make_path,$(TITAN_TEST_NATIVE_INPUT_DIR)/windows_test_supervisor.c) \
		$(call make_path,$(TITAN_TEST_BUILD_DIR)/native-flags.config)
	bash spec/support/build_windows_stdlib_native.sh $(call quote,$(TITAN_TEST_BUILD_DIR))

# Coverage uses the ordinary source graph and native test harness. Running
# the aggregate writes its report; gcovr is needed only for requested formats.
TITAN_COVERAGE_BUILD_DIR ?= $(WINDOWS_BUILD_ROOT)/native-coverage
TITAN_COVERAGE_REPORT_DIR ?= $(TITAN_COVERAGE_BUILD_DIR)/report
TITAN_COVERAGE_GCOV ?= llvm-cov.exe gcov
TITAN_COVERAGE_GCOVR ?= gcovr
TITAN_COVERAGE_FORMATS ?=
.PHONY: $(TITAN_WINDOWS_COVERAGE_GOALS)
titan-native-coverage-build:
	+$(RECURSIVE_WRAPPER_GUARD) MAKE=$(call quote,$(TITAN_TEST_MAKE)) CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  TITAN_COVERAGE_GCOV=$(call quote,$(TITAN_COVERAGE_GCOV)) \
	  TITAN_COVERAGE_REPORT_DIR=$(call quote,$(TITAN_COVERAGE_REPORT_DIR)) \
	  TITAN_COVERAGE_FORMATS=$(call quote,$(TITAN_COVERAGE_FORMATS)) \
	  TITAN_COVERAGE_GCOVR=$(call quote,$(TITAN_COVERAGE_GCOVR)) \
	  bash scripts/windows_native_coverage.sh build $(call quote,$(TITAN_COVERAGE_BUILD_DIR)) $(call quote,$(PREFIX))

titan-native-coverage-run:
	TITAN_TEST_TIMEOUT=$(call quote,$(TITAN_TEST_TIMEOUT)) TITAN_FILTER=$(call quote,$(TITAN_FILTER)) \
	  bash scripts/windows_native_coverage.sh run $(call quote,$(TITAN_COVERAGE_BUILD_DIR))

titan-native-coverage: titan-native-coverage-build
	+$(MAKE) -f Makefile.win titan-native-coverage-run

.PHONY: rock-test test
# Implementation notes: doc/implementation/windows-build.md#test-ownership-and-keep-going
# Windows keeps its native-build-first ownership: build and run the native
# aggregate, then the per-file Busted shards under the native supervisor. A
# failed native phase does not suppress the Busted phase; both statuses decide.
rock-test: export TITAN_ROCK_TEST_STDLIB_SPECS = spec/asan_generated_c_context_spec.lua spec/dense_array_runtime_spec.lua spec/libuv_build_spec.lua spec/lpeglabel_build_spec.lua spec/minicoro_spec.lua spec/rockspec_spec.lua spec/titan_install_spec.lua
rock-test: export TITAN_ROCK_TEST_SUPERVISOR = $(TITAN_TEST_BUILD_DIR)/sdk/bin/windows-test-supervisor.exe
rock-test:
	+$(RECURSIVE_WRAPPER_GUARD) native_status=0; \
	$(MAKE) -f Makefile.win titan-stdlib-test || native_status=$$?; \
	busted_status=0; \
	PREFIX=$(call quote,$(PREFIX)) TITAN_ROCK_TEST_INTERNAL=1 \
	  BUSTED_FILTER=$(call quote,$(BUSTED_FILTER)) \
	  bash spec/support/run_rock_tests.sh $(EXTRA_TEST_FLAGS) || busted_status=$$?; \
	test "$$native_status" = 0 || echo "native stdlib phase failed (status $$native_status)" >&2; \
	test "$$busted_status" = 0 || echo "Busted phase failed (status $$busted_status)" >&2; \
	test "$$native_status" = 0 && test "$$busted_status" = 0

test: compiler
	LUAROCKS_CONFIG=$(call quote,$(shell cygpath -m "$(LUAROCKS_CONFIG)")) \
	  $(call quote,$(LUAROCKS)) --lua-version=5.5 \
	  --tree=$(call quote,$(shell cygpath -m "$(PREFIX)")) test titan-0.6.0-1.rockspec \
	  CC=$(call quote,$(CC)) LD=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB))

# The native Windows build prepares DLL SDK dependencies in PREFIX. Build the
# stdlib with this source rock's Lua compiler before LuaRocks deploys any files.
.PHONY: all install publish-titan-sdk check-rocks-tree
check-rocks-tree:
	@test $(call quote,$(PREFIX)) = $(call quote,$(ROCKS_TREE)) || \
	  test $(call quote,$(PREFIX)) -ef $(call quote,$(ROCKS_TREE)) || { \
	  echo 'The Windows source rock requires --tree to select the Lua SDK prefix.' >&2; exit 1; }

all: check-rocks-tree runtime native
	+$(MAKE) -f Makefile.win stdlib STDLIB_USE_INSTALLED_RUNTIME=0

ifneq ($(strip $(INST_PREFIX)),)
install: check-rocks-tree check-support-module install-compiler install-rock-tools stage-rock-payload
.PHONY: stage-rock-payload
stage-rock-payload:
	+$(MAKE) -f Makefile.win publish-titan-sdk publish-stdlib \
	  TITAN_INSTALL_TREE=$(call quote,$(INST_PREFIX)/titan-sdk)
	# Retain only this controlled native SDK, never unrelated prefix contents.
	mkdir -p $(call quote,$(INST_PREFIX)/titan-sdk/bin) \
	  $(call quote,$(INST_PREFIX)/titan-sdk/lib) $(call quote,$(INST_PREFIX)/titan-sdk/include)
	for filename in libuv-1.dll libllhttp-9.4.dll libsqlite3-0.dll libcrypto-3-x64.dll libssl-3-x64.dll; do \
	  cp -p "$(PREFIX)/bin/$$filename" $(call quote,$(INST_PREFIX)/titan-sdk/bin/); done
	for filename in libuv.dll.a libllhttp.dll.a libsqlite3.dll.a libcrypto.dll.a libssl.dll.a libbacktrace.a; do \
	  cp -p "$(PREFIX)/lib/$$filename" $(call quote,$(INST_PREFIX)/titan-sdk/lib/); done
	for filename in uv.h llhttp.h sqlite3.h backtrace.h backtrace-supported.h; do \
	  cp -p "$(PREFIX)/include/$$filename" $(call quote,$(INST_PREFIX)/titan-sdk/include/); done
	cp -pR $(call quote,$(PREFIX)/include/uv) $(call quote,$(PREFIX)/include/openssl) \
	  $(call quote,$(INST_PREFIX)/titan-sdk/include/)
else
install: check-rocks-tree runtime-build check-support-module install-compiler publish-titan-sdk publish-stdlib
endif
