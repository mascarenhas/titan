WINDOWS_RUNNER_SOURCE = r'''
/* Build-owned Titan coverage process supervisor. Atomic JobObject assignment,
 * explicit handle inheritance and bounded retirement precede counter collection.
 * This source is embedded in the installed host; no checkout fixture is used. */
/* Private argv and standard-handle helpers. */
#ifndef TITAN_WINDOWS_SUPERVISOR_PROBE_HELPERS_H
#define TITAN_WINDOWS_SUPERVISOR_PROBE_HELPERS_H
