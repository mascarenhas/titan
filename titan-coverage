class CoverageError(Exception):
    pass


class WindowsRunFailure(CoverageError):
    def __init__(self, message, interrupted=False, timed_out=False):
        super().__init__(message)
        self.interrupted = interrupted
        self.timed_out = timed_out
        self.exit_status = 124 if timed_out else 130 if interrupted else 125


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")


def digest(path):
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError as error:
        raise CoverageError("cannot read {}: {}".format(path, error)) from error


def physical_source_lines(path):
    """Read LF/CRLF sources without broad Unicode line splitting.

    Titan source locations count LF bytes. gcovr's source reader also treats a
    bare CR as a line break, so that source form cannot be reported faithfully.
    Unicode separators, NEL, vertical tab and formfeed remain within their line.
    """
    source = Path(path).read_bytes().decode("utf-8").replace("\r\n", "\n")
    if "\r" in source:
        raise CoverageError("coverage sources require LF or CRLF; bare carriage return in " + str(path))
    lines = source.split("\n")
    if lines[-1] == "":
        lines.pop()
    return lines


def save_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp-" + uuid.uuid4().hex)
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def read_json(path):
    try:
        value = json.loads(Path(path).read_text(encoding="utf-8"))
        if not isinstance(value, dict):
            raise CoverageError("JSON must be an object: " + str(path))
        return value
    except (OSError, ValueError) as error:
        raise CoverageError("cannot read JSON {}: {}".format(path, error)) from error


def command_argv(command):
    if isinstance(command, list):
        argv = command
    else:
        argv = shlex.split(command)
    if not argv or not all(isinstance(item, str) and item for item in argv):
        raise CoverageError("empty or malformed tool command")
    return argv


def invoke(argv, cwd=None, env=None, allowed=(0,), timeout=None):
    try:
        result = subprocess.run(argv, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired as error:
        raise CoverageError("tool timed out: " + shlex.join(argv)) from error
    except OSError as error:
        raise CoverageError("cannot execute {}: {}".format(argv[0], error)) from error
    if allowed is not None and result.returncode not in allowed:
        raise CoverageError("{} exited {}:\n{}{}".format(shlex.join(argv), result.returncode,
                                                        result.stdout, result.stderr))
    return result


def tool_identity(command):
    argv = command_argv(command)
    executable = shutil.which(argv[0])
    if executable is None:
        raise CoverageError("tool not found: " + argv[0])
    version = invoke(argv + ["--version"]).stdout.strip()
    if not version:
        raise CoverageError("tool returned an empty version: " + argv[0])
    return {"argv": argv, "executable": str(Path(executable).resolve()),
            "sha256": digest(executable), "version_output": version}



# Explicit LLVM gcov reader: exact binary structure precedes native decoding.
"""Strict adapter for pinned LLVM 22.1.8's little-endian B11 gcov files.

Scratch integration module: tool/platform identity and tracked source physical
line bounds belong to the caller. This module does not search for tools, sources,
or counters. Only explicit notes/data are copied into a new reader directory.
"""


class llvm_reader_ReaderError(CoverageError):
    pass


llvm_reader_VERSION = b"*11B"
llvm_reader_FUNCTION, llvm_reader_BLOCKS, llvm_reader_ARCS, llvm_reader_LINES = 0x01000000, 0x01410000, 0x01430000, 0x01450000
llvm_reader_COUNTERS, llvm_reader_SUMMARY = 0x01A10000, 0xA1000000
llvm_reader_MAX_LINE, llvm_reader_MAX_COUNT = (1 << 32) - 1, (1 << 64) - 1


def llvm_reader_require(condition, message):
    if not condition:
        raise llvm_reader_ReaderError(message)


def llvm_reader_digest(data):
    return hashlib.sha256(data).hexdigest()


def llvm_reader_text_value(raw, description, empty=False):
    try:
        value = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise llvm_reader_ReaderError(description + " is not UTF-8") from error
    llvm_reader_require((empty or value) and not any(ord(c) < 32 or ord(c) == 127 for c in value),
            description + " is empty or contains a control character")
    return value


def llvm_reader_path_key(value):
    # LLVM removes dot components from the recorded path; no basename fallback,
    # physical source lookup, case folding, or relocation inference is performed.
    return posixpath.normpath(value.replace("\\", "/"))


class llvm_reader_Words:
    def __init__(self, data, description):
        self.data, self.pos, self.description = data, 0, description

    def word(self):
        llvm_reader_require(self.pos + 4 <= len(self.data), self.description + ": truncated word")
        result = struct.unpack_from("<I", self.data, self.pos)[0]
        self.pos += 4
        return result

    def string(self, description, empty=False):
        length = self.word() * 4
        llvm_reader_require(length > 0 and self.pos + length <= len(self.data),
                self.description + ": truncated/zero-length string")
        raw = self.data[self.pos:self.pos + length]
        self.pos += length
        end = raw.find(b"\0")
        llvm_reader_require(end >= 0 and raw[end:] == b"\0" * (len(raw) - end),
                self.description + ": missing NUL or nonzero string padding")
        return llvm_reader_text_value(raw[:end], description, empty=empty)

    def done(self):
        llvm_reader_require(self.pos == len(self.data), self.description + ": unexpected trailing record fields")


def llvm_reader_header(raw, magic, description):
    llvm_reader_require(len(raw) >= 12 and len(raw) % 4 == 0, description + ": truncated/misaligned header")
    llvm_reader_require(raw[:4] == magic, description + ": unsupported exact little-endian magic")
    llvm_reader_require(raw[4:8] == llvm_reader_VERSION, description + ": raw version must be exact '*11B'")
    return raw[8:12]


def llvm_reader_records(words):
    while True:
        start = words.pos
        tag = words.word()
        if tag == 0:
            llvm_reader_require(words.data[start:] == b"\0" * 8, words.description + ": invalid/trailing EOF marker")
            words.pos = len(words.data)
            return
        length = words.word() * 4
        llvm_reader_require(words.pos + length <= len(words.data), words.description + ": truncated record")
        body = llvm_reader_Words(words.data[words.pos:words.pos + length], words.description + " tag " + hex(tag))
        words.pos += length
        yield tag, body


def llvm_reader_parse_notes(raw):
    stamp = llvm_reader_header(raw, b"oncg", "notes")
    words = llvm_reader_Words(raw, "notes"); words.pos = 12
    cwd = words.string("recorded compiler directory")
    llvm_reader_require(words.word() in (0, 1), "notes: invalid unexecuted-block flag")
    functions, sources = {}, {}
    fn = None
    for tag, body in llvm_reader_records(words):
        if tag == llvm_reader_FUNCTION:
            ident, line_checksum, cfg_checksum = body.word(), body.word(), body.word()
            llvm_reader_require(ident not in functions, "notes: duplicate function ID")
            name = body.string("function name")
            artificial = body.word()
            llvm_reader_require(artificial in (0, 1), "notes: invalid artificial flag")
            filename = body.string("function source path")
            source = llvm_reader_path_key(filename)
            first, first_column, last, last_column = (body.word() for _ in range(4))
            # LLVM writes the DISubprogram start and an instruction debug line
            # independently. Titan #line remaps can move the latter into another
            # virtual file and back to a smaller number. Neither endpoint is a
            # bound on the per-file executable LINES records below.
            llvm_reader_require(0 < first <= llvm_reader_MAX_LINE and 0 < last <= llvm_reader_MAX_LINE,
                    "notes: invalid function source endpoints")
            fn = dict(ident=ident, line_checksum=line_checksum, cfg_checksum=cfg_checksum,
                      name=name, file=source, first=first, last=last, blocks=None,
                      arc_sources=set(), line_blocks=set(), counters=0)
            functions[ident] = fn
            sources.setdefault(source, set())
        elif tag == llvm_reader_BLOCKS:
            llvm_reader_require(fn is not None and fn["blocks"] is None, "notes: misplaced/duplicate blocks")
            fn["blocks"] = body.word()
            llvm_reader_require(fn["blocks"] >= 2, "notes: function has no entry/exit blocks")
        elif tag == llvm_reader_ARCS:
            llvm_reader_require(fn is not None and fn["blocks"] is not None, "notes: arcs before blocks")
            source = body.word()
            llvm_reader_require(source < fn["blocks"] and source not in fn["arc_sources"],
                    "notes: invalid/duplicate arc source")
            fn["arc_sources"].add(source)
            llvm_reader_require((len(body.data) - body.pos) % 8 == 0, "notes: malformed arc record length")
            while body.pos < len(body.data):
                destination, flags = body.word(), body.word()
                llvm_reader_require(destination < fn["blocks"] and not flags & ~7, "notes: invalid arc destination/flags")
                fn["counters"] += not (flags & 1)
        elif tag == llvm_reader_LINES:
            llvm_reader_require(fn is not None and fn["blocks"] is not None, "notes: lines before blocks")
            block = body.word()
            llvm_reader_require(block < fn["blocks"] and block not in fn["line_blocks"],
                    "notes: invalid/duplicate line block")
            fn["line_blocks"].add(block)
            current = None
            while True:
                number = body.word()
                if number:
                    llvm_reader_require(current is not None, "notes: source line before source path")
                    sources[current].add(number)
                else:
                    # Empty line-list terminator is encoded as a zero word,
                    # unlike ordinary gcov strings which have padded NUL bytes.
                    if body.pos + 4 <= len(body.data) and struct.unpack_from("<I", body.data, body.pos)[0] == 0:
                        body.word(); break
                    filename = body.string("line source path")
                    current = llvm_reader_path_key(filename)
                    sources.setdefault(current, set())
        else:
            raise llvm_reader_ReaderError("notes: unknown record tag " + hex(tag))
        body.done()
    llvm_reader_require(functions and all(f["blocks"] is not None and f["counters"] > 0 for f in functions.values()),
            "notes: no functions or incomplete function inventory")
    function_keys = [(f["file"], f["first"], f["name"]) for f in functions.values()]
    llvm_reader_require(len(set(function_keys)) == len(function_keys), "notes: ambiguous duplicate function identity")
    return dict(stamp=stamp, cwd=cwd, functions=functions, sources=sources)


def llvm_reader_validate_data(raw, notes):
    llvm_reader_require(llvm_reader_header(raw, b"adcg", "data") == notes["stamp"], "data: file checksum/stamp differs from notes")
    words = llvm_reader_Words(raw, "data"); words.pos = 12
    seen, fn, summary = set(), None, False
    for tag, body in llvm_reader_records(words):
        if tag == llvm_reader_FUNCTION:
            llvm_reader_require(fn is None and not summary, "data: missing counters or function after summary")
            ident, line_checksum, cfg_checksum = body.word(), body.word(), body.word()
            llvm_reader_require(ident in notes["functions"] and ident not in seen, "data: unknown/duplicate function ID")
            fn = notes["functions"][ident]
            llvm_reader_require((line_checksum, cfg_checksum) == (fn["line_checksum"], fn["cfg_checksum"]),
                    "data: function line/CFG checksums differ from notes")
            seen.add(ident)
        elif tag == llvm_reader_COUNTERS:
            llvm_reader_require(fn is not None and len(body.data) == fn["counters"] * 8,
                    "data: missing function or wrong counter arity")
            # Values are uint64_t; structural validation does not invent/rebuild
            # counts. LLVM alone solves its measured flow graph.
            body.pos = len(body.data); fn = None
        elif tag == llvm_reader_SUMMARY:
            llvm_reader_require(fn is None and not summary and seen == notes["functions"].keys(),
                    "data: missing/duplicate function inventory or summary")
            body.word(); body.word(); summary = True
        else:
            raise llvm_reader_ReaderError("data: unknown record tag " + hex(tag))
        body.done()
    llvm_reader_require(fn is None and summary and seen == notes["functions"].keys(),
            "data: missing counters/function/summary")


def llvm_reader_decimal(value, maximum, description, positive=False):
    llvm_reader_require(re.fullmatch(r"0|[1-9][0-9]*", value) is not None, description + ": malformed decimal")
    number = int(value)
    llvm_reader_require((number > 0 if positive else number >= 0) and number <= maximum,
            description + ": out of range")
    return number


def llvm_reader_parse_intermediate(raw, notes, notes_only=False):
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise llvm_reader_ReaderError("LLVM intermediate output is not UTF-8") from error
    llvm_reader_require(text and not any((ord(c) < 32 and c not in "\r\n") or ord(c) == 127 for c in text),
            "intermediate: empty output or control character")
    # Only physical CRLF/LF record separators; Unicode LS/VT/formfeed must
    # never create a source-line/record boundary through str.splitlines().
    llvm_reader_require(text.endswith("\n") and "\r" not in text.replace("\r\n", ""),
            "intermediate: incomplete/bare-CR records")
    rows = text.replace("\r\n", "\n").split("\n")[:-1]
    files, functions = {}, Counter()
    current = None
    expected_functions = Counter((f["file"], f["first"], f["name"]) for f in notes["functions"].values())
    for row in rows:
        kind, separator, value = row.partition(":")
        llvm_reader_require(separator and value, "intermediate: empty/malformed record")
        if kind == "file":
            source = llvm_reader_text_value(value.encode("utf-8"), "intermediate source")
            current = llvm_reader_path_key(source)
            llvm_reader_require(current in notes["sources"] and current not in files,
                    "intermediate: unknown/duplicate source path")
            files[current] = dict(file=source, lines={})
        elif kind == "function":
            fields = value.split(",", 2)
            llvm_reader_require(current is not None and len(fields) == 3, "intermediate: misplaced/malformed function")
            first = llvm_reader_decimal(fields[0], llvm_reader_MAX_LINE, "function line", positive=True)
            count = llvm_reader_decimal(fields[1], llvm_reader_MAX_COUNT, "function count")
            name = llvm_reader_text_value(fields[2].encode("utf-8"), "intermediate function name")
            key = (current, first, name)
            functions[key] += 1
            llvm_reader_require(functions[key] <= expected_functions[key], "intermediate: unknown/duplicate function identity")
            llvm_reader_require(not notes_only or count == 0, "intermediate: nonzero function without counters")
        elif kind == "lcount":
            fields = value.split(",")
            llvm_reader_require(current is not None and len(fields) == 2, "intermediate: misplaced/malformed line count")
            number = llvm_reader_decimal(fields[0], llvm_reader_MAX_LINE, "source line", positive=True)
            count = llvm_reader_decimal(fields[1], llvm_reader_MAX_COUNT, "source count")
            llvm_reader_require(number in notes["sources"][current] and number not in files[current]["lines"],
                    "intermediate: unknown/duplicate source line")
            llvm_reader_require(not notes_only or count == 0, "intermediate: nonzero line without counters")
            files[current]["lines"][number] = count
        else:
            raise llvm_reader_ReaderError("intermediate: unexpected record kind " + kind)
    llvm_reader_require(files.keys() == notes["sources"].keys() and functions == expected_functions,
            "intermediate: missing source/function inventory")
    for source, file in files.items():
        llvm_reader_require(file["lines"].keys() == notes["sources"][source], "intermediate: missing executable source lines")
        file["lines"] = [dict(line_number=n, count=c) for n, c in sorted(file["lines"].items())]
    return dict(files=list(files.values()), current_working_directory=notes["cwd"])


def llvm_gcov_raw(gcov_argv, notes, work, data=None):
    llvm_reader_require(isinstance(gcov_argv, (list, tuple)) and len(gcov_argv) >= 2
            and all(isinstance(a, str) and a and "\0" not in a for a in gcov_argv), "explicit LLVM gcov argv required")
    llvm_reader_require(gcov_argv[-1] == "gcov", "explicit LLVM gcov subcommand required")
    work = Path(work).absolute()
    work.mkdir(parents=True, exist_ok=False)
    notes_raw = Path(notes).read_bytes()
    local_notes = work / "object.gcno"; local_notes.write_bytes(notes_raw)
    data_raw = None
    if data is not None:
        data_raw = Path(data).read_bytes()
        (work / "object.gcda").write_bytes(data_raw)
    parsed = llvm_reader_parse_notes(notes_raw)
    if data_raw is not None:
        llvm_reader_validate_data(data_raw, parsed)
    argv = list(gcov_argv) + ["--intermediate-format", str(local_notes)]
    command = dict(argv=argv, input_notes_sha256=llvm_reader_digest(notes_raw),
                   input_data_sha256=llvm_reader_digest(data_raw) if data_raw is not None else None)
    try:
        result = subprocess.run(argv, cwd=work, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
        stdout, stderr = result.stdout, result.stderr
        command.update(exit_status=result.returncode, timed_out=False)
    except subprocess.TimeoutExpired as error:
        stdout, stderr = error.stdout or b"", error.stderr or b""
        command.update(exit_status=None, timed_out=True)
    except OSError as error:
        command.update(exit_status=None, timed_out=False, execution_error=str(error))
        stdout, stderr = b"", b""
    (work / "llvm-gcov.stdout").write_bytes(stdout)
    (work / "llvm-gcov.stderr").write_bytes(stderr)
    command.update(stdout_sha256=llvm_reader_digest(stdout), stderr_sha256=llvm_reader_digest(stderr))
    (work / "gcov-command.json").write_text(json.dumps(command, indent=2) + "\n", encoding="utf-8")
    llvm_reader_require(command.get("exit_status") == 0 and not command.get("timed_out"),
            "LLVM reader failed: " + json.dumps(command))
    llvm_reader_require(not stderr, "LLVM reader diagnostics despite zero exit: " + repr(stderr))
    try:
        stdout.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise llvm_reader_ReaderError("LLVM reader stdout is not UTF-8") from error
    outputs = sorted(work.glob("*.gcov"))
    llvm_reader_require(outputs == [work / "object.gcno.gcov"], "LLVM reader output inventory is not exactly object.gcno.gcov")
    llvm_reader_require(local_notes.read_bytes() == notes_raw and (data_raw is None or (work / "object.gcda").read_bytes() == data_raw),
            "LLVM reader modified its explicit notes/data")
    return llvm_reader_parse_intermediate(outputs[0].read_bytes(), parsed, notes_only=data_raw is None)


def pe_image_identity(path, require_runtime=True):
    """Inspect AMD64 PE imports directly; no toolchain DLL search or fallback."""
    raw = Path(path).read_bytes()
    def u16(offset): return struct.unpack_from('<H', raw, offset)[0]
    def u32(offset): return struct.unpack_from('<I', raw, offset)[0]
    try:
        pe = u32(0x3c)
        if raw[:2] != b'MZ' or raw[pe:pe + 4] != b'PE\0\0' or u16(pe + 4) != 0x8664:
            raise CoverageError('coverage runner/image requires an AMD64 PE image')
        optional = pe + 24
        if u16(optional) != 0x20b or u16(pe + 20) < 128:
            raise CoverageError('coverage runner/image requires PE32+')
        sections = []
        for index in range(u16(pe + 6)):
            offset = optional + u16(pe + 20) + index * 40
            sections.append((u32(offset + 12), u32(offset + 8), u32(offset + 20), u32(offset + 16)))
        def rva(value, size):
            for start, virtual, physical, length in sections:
                if start <= value and value + size <= start + min(virtual, length):
                    offset = physical + value - start
                    if offset + size <= len(raw): return offset
            raise CoverageError('PE import RVA is outside a declared file-backed section')
        address, size = u32(optional + 120), u32(optional + 124)
        imports = []
        if address:
            if size < 20 or size > 1024 * 1024:
                raise CoverageError('malformed PE import directory')
            terminated = False
            for index in range(size // 20):
                offset = rva(address + index * 20, 20)
                descriptor = struct.unpack_from('<5I', raw, offset)
                if not any(descriptor):
                    terminated = True; break
                name = rva(descriptor[3], 1)
                end = raw.find(b'\0', name, min(len(raw), name + 256))
                if end < 0: raise CoverageError('unterminated PE import name')
                dll = raw[name:end].decode('ascii').lower()
                if dll in imports: raise CoverageError('duplicate PE import descriptor')
                imports.append(dll)
            if not terminated: raise CoverageError('unterminated PE import directory')
        if not imports or any(not re.fullmatch(r'[a-z0-9_.+-]+\.dll', name) for name in imports):
            raise CoverageError('PE import inventory has absent or malformed DLL names')
        if require_runtime and any(name not in ('kernel32.dll', 'ucrtbase.dll') and
                              not re.fullmatch(r'api-ms-win-crt-[a-z0-9-]+\.dll', name) for name in imports):
            raise CoverageError('coverage image imports an unsupported extra runtime: ' + ', '.join(imports))
        # A delayed dependency would evade the ordinary import inventory.
        if u16(pe + 20) >= 224 and (u32(optional + 216) or u32(optional + 220)):
            raise CoverageError('coverage image has unverified delayed imports')
        return {'machine': 'AMD64', 'optional_magic': 'PE32+', 'subsystem': u16(optional + 68),
                'imports': sorted(imports)}
    except (IndexError, struct.error, UnicodeDecodeError) as error:
        raise CoverageError('malformed PE image: ' + str(path)) from error


def owned_tool_dlls(executable):
    """Bind explicitly imported implementation DLLs beside the selected tool.

    Windows system imports remain the operating-system boundary. Package DLLs
    are resolved only beside the declared executable, never through PATH or a
    recursive directory scan. Clang's small driver delegates to these bytes.
    """
    directory = Path(executable).resolve().parent
    system = {'kernel32.dll', 'kernelbase.dll', 'ntdll.dll', 'ucrtbase.dll', 'msvcrt.dll',
        'advapi32.dll', 'shell32.dll', 'user32.dll', 'ole32.dll', 'oleaut32.dll', 'version.dll',
        'ws2_32.dll', 'bcrypt.dll', 'crypt32.dll', 'psapi.dll', 'dbghelp.dll', 'shlwapi.dll',
        'rpcrt4.dll', 'gdi32.dll', 'comdlg32.dll', 'combase.dll', 'secur32.dll', 'iphlpapi.dll',
        'winmm.dll', 'setupapi.dll', 'normaliz.dll'}
    pending, seen, result = [Path(executable).resolve()], set(), []
    while pending:
        path = pending.pop()
        image = pe_image_identity(path, require_runtime=False)
        for name in image['imports']:
            if name in system or name.startswith(('api-ms-win-', 'ext-ms-win-')): continue
            dependency = directory / name
            if not dependency.is_file():
                raise CoverageError('declared tool implementation DLL is absent beside its executable: ' + str(dependency))
            if name in seen: continue
            seen.add(name)
            result.append({'path': str(dependency), 'sha256': digest(dependency)})
            pending.append(dependency)
    return sorted(result, key=lambda item: item['path'])


def native_python_identity():
    executable = str(Path(sys.executable).resolve())
    return {'executable': executable, 'sha256': digest(executable),
            'implementation': sys.implementation.name, 'version': sys.version,
            'version_info': list(sys.version_info[:3]), 'bitness': struct.calcsize('P') * 8,
            'implementation_dlls': owned_tool_dlls(executable)}


def interpreter_semantic_identity(identity):
    value = copy.deepcopy(identity)
    value.pop('executable', None)
    value['implementation_dlls'] = sorted((PureWindowsPath(item['path']).name.lower(), item['sha256'])
                                          for item in value.get('implementation_dlls', []))
    return value


def validate_interpreter(identity, current=None):
    if (not isinstance(identity.get('executable'), str) or not Path(identity['executable']).is_absolute() or
            digest(identity['executable']) != identity.get('sha256')):
        raise CoverageError('sealed native Python executable identity changed')
    for item in identity.get('implementation_dlls', []):
        if not Path(item['path']).is_absolute() or digest(item['path']) != item['sha256']:
            raise CoverageError('sealed native Python implementation DLL changed')
    if interpreter_semantic_identity(identity) != interpreter_semantic_identity(current or native_python_identity()):
        raise CoverageError('native Python implementation/version/bitness identity differs from the coverage build')
    return identity


def identify_llvm_backend(cc, gcov, gcovr=None, compile_args=None):
    if os.name != 'nt' or platform.machine().lower() not in ('amd64', 'x86_64'):
        raise CoverageError('llvm-gcov requires native Windows x64 Python and the CLANG64/UCRT SDK')
    compiler, profiler = tool_identity(cc), tool_identity(gcov)
    cc_version = re.search(r'clang version (\d+\.\d+\.\d+)\b', compiler['version_output'])
    gcov_version = re.search(r'LLVM version (\d+\.\d+\.\d+)\b', profiler['version_output'])
    if not cc_version or not gcov_version or cc_version[1] != LLVM_VERSION or gcov_version[1] != LLVM_VERSION:
        raise CoverageError('llvm-gcov requires exact Clang/LLVM ' + LLVM_VERSION)
    if profiler['argv'][-1] != 'gcov':
        raise CoverageError('llvm-gcov requires an explicit llvm-cov gcov command')
    flags = list(compile_args or [])
    if any(not isinstance(flag, str) or not flag or '\0' in flag for flag in flags):
        raise CoverageError('malformed effective LLVM compile argument')
    if any(flag == '--coverage' or flag == '-ftest-coverage' or flag.startswith(('-fprofile', '-fno-profile', '-fcoverage', '-dumpdir', '-dumpbase')) for flag in flags):
        raise CoverageError('LLVM coverage/profile paths must be owned by the explicit coverage backend')
    prefix = compiler['argv'] + flags
    compiler['version'] = profiler['version'] = LLVM_VERSION
    compiler['implementation_dlls'] = owned_tool_dlls(compiler['executable'])
    profiler['implementation_dlls'] = owned_tool_dlls(profiler['executable'])
    compiler['target'] = invoke(prefix + ['-dumpmachine'], timeout=30).stdout.strip()
    if compiler['target'] != 'x86_64-w64-windows-gnu':
        raise CoverageError('llvm-gcov requires effective x86_64-w64-windows-gnu target')
    resource = Path(invoke(prefix + ['-print-resource-dir'], timeout=30).stdout.strip()).resolve()
    default_resource = Path(invoke(compiler['argv'] + ['-print-resource-dir'], timeout=30).stdout.strip()).resolve()
    if resource != default_resource:
        raise CoverageError('effective compile-only LLVM resource override differs from the final-link runtime resource')
    runtime = resource / 'lib' / 'windows' / 'libclang_rt.profile-x86_64.a'
    if not resource.is_dir() or not runtime.is_file():
        raise CoverageError('LLVM does not provide the matching static x64 profile runtime')
    compiler['resource_directory'] = str(resource)
    compiler['profile_runtime'] = {'path': str(runtime), 'sha256': digest(runtime)}
    compiler['effective_compile_args'] = flags
    result = {'cc': compiler, 'gcov': profiler, 'python': native_python_identity()}
    if gcovr is not None: result['gcovr'] = identify_reporter(gcovr)
    return result


def runner_source_hash():
    return hashlib.sha256(WINDOWS_RUNNER_SOURCE.encode('utf-8')).hexdigest()


def runner_semantic_identity(runner):
    # Build-owned source/output paths differ legitimately between compatible
    # builds. All compiler flags, executable/runtime bytes and helper bytes bind.
    value = copy.deepcopy(runner)
    for key in ('path', 'source_path', 'identity_path'): value.pop(key, None)
    value['interpreter_identity'] = interpreter_semantic_identity(value['interpreter_identity'])
    argv = value['compile_argv']
    value['compile_argv'] = ['<runner-source>' if item == runner['source_path'] else
                             '<runner-image>' if item == runner['path'] else item for item in argv]
    return value


def validate_runner(runner, tools):
    if (runner.get('schema') != WINDOWS_RUNNER_SCHEMA or
            runner.get('source_sha256') != runner_source_hash() or
            runner.get('compiler_identity') != tools['cc']):
        raise CoverageError('sealed Windows coverage runner source/compiler identity changed')
    validate_interpreter(runner['interpreter_identity'], tools['python'])
    for key in ('path', 'source_path', 'identity_path'):
        if not isinstance(runner.get(key), str) or not Path(runner[key]).is_absolute():
            raise CoverageError('coverage runner paths must be absolute')
    if digest(runner['path']) != runner.get('sha256') or digest(runner['source_path']) != runner['source_sha256']:
        raise CoverageError('sealed Windows coverage runner image/source bytes changed')
    if runner.get('pe_image') != pe_image_identity(runner['path']):
        raise CoverageError('sealed Windows coverage runner PE identity changed')
    expected = tools['cc']['argv'] + tools['cc']['effective_compile_args'] + [
        '-std=c99', '-O0', '-fno-lto', '-g0', '-Wall', '-Wextra', '-Werror', '-municode', '-static', '-Wl,--no-insert-timestamp',
        runner['source_path'], '-o', runner['path']]
    if runner.get('compile_argv') != expected or read_json(runner['identity_path']) != runner:
        raise CoverageError('sealed Windows coverage runner compile/identity provenance changed')
    return runner


def materialize_runner(directory, tools):
    if directory is None: raise CoverageError('llvm-gcov probe requires --runner-directory')
    directory = Path(directory).resolve()
    image, source, identity = directory / 'titan-coverage-runner.exe', directory / 'titan-coverage-runner.c', directory / 'runner.json'
    if directory.exists():
        # Compiler incremental invocations validate a durable image, never repair
        # it, overwrite it, or select a PATH helper with another identity.
        if not identity.is_file(): raise CoverageError('runner directory exists without a sealed helper identity; use a fresh build')
        runner = read_json(identity)
        if runner.get('path') != str(image) or runner.get('source_path') != str(source) or runner.get('identity_path') != str(identity):
            raise CoverageError('runner identity does not own its declared build directory')
        return validate_runner(runner, tools)
    directory.mkdir(parents=True, exist_ok=False)
    source.write_text(WINDOWS_RUNNER_SOURCE, encoding='utf-8', newline='\n')
    # The helper has an ordinary build policy independent of measured-code
    # debug flags. Its sealed source remains available, while -g0 prevents
    # build-owned source paths from changing otherwise identical helper bytes.
    argv = tools['cc']['argv'] + tools['cc']['effective_compile_args'] + [
        '-std=c99', '-O0', '-fno-lto', '-g0', '-Wall', '-Wextra', '-Werror', '-municode', '-static', '-Wl,--no-insert-timestamp', str(source), '-o', str(image)]
    result = invoke(argv, timeout=30)
    runner = {'schema': WINDOWS_RUNNER_SCHEMA, 'path': str(image), 'sha256': digest(image),
              'source_path': str(source), 'source_sha256': runner_source_hash(), 'identity_path': str(identity),
              'compile_argv': argv, 'compiler_identity': tools['cc'], 'interpreter_identity': tools['python'],
              'pe_image': pe_image_identity(image)}
    if runner['pe_image']['subsystem'] != 3: raise CoverageError('runner must be a native console-subsystem executable')
    save_json(directory / 'compile.json', {'argv': argv, 'stdout': result.stdout, 'stderr': result.stderr})
    save_json(identity, runner)
    return validate_runner(runner, tools)


def validate_windows_receipt(value, helper_status):
    def require(ok, message):
        if not ok: raise CoverageError('Windows runner receipt: ' + message)
    require(value.get('schema') == WINDOWS_RUNNER_SCHEMA and value.get('runner_kind') == 'titan-coverage-job-v1', 'unsupported schema/kind')
    for key in ('leader_created', 'leader_exited_naturally', 'retirement_requested', 'retirement_succeeded',
                'forced_leader_retirement', 'forced_descendant_retirement', 'timeout', 'interrupted',
                'empty_job_confirmed', 'complete', 'tests_passed', 'control_present', 'control_inherit_cleared',
                'control_excluded_leader', 'control_initial_open', 'control_eof_observed', 'control_boundary_ready',
                'control_read_closed', 'private_console_confirmed', 'console_free_attempted',
                'leader_console_inherit_requested'):
        require(type(value.get(key)) is bool, 'malformed ' + key)
    for key in ('leader_status_dword', 'supervisor_exit_code', 'active_processes_final'):
        require(type(value.get(key)) is int and 0 <= value[key] <= 0xffffffff, 'missing/malformed ' + key)
    require(value['supervisor_exit_code'] == helper_status, 'helper exit disagrees with receipt')
    require(value['leader_status_hex'] == '0x{:08x}'.format(value['leader_status_dword']), 'native DWORD/hex disagreement')
    require(value['leader_created'] and value['empty_job_confirmed'] and value['active_processes_final'] == 0,
            'owned job emptiness/native leader status not confirmed')
    require(value['supervisor_error_operation'] is None and value['win32_error'] == 0, 'native supervisor error')
    handles = value.get('leader_handle_list')
    control_handle = value.get('control_read_handle')
    require(type(control_handle) is int and 0 < control_handle < (1 << 64) - 1 and
            isinstance(handles, list) and len(handles) == 3 and
            all(type(handle) is int and 0 < handle < (1 << 64) - 1 for handle in handles) and
            len(set(handles)) == 3 and control_handle not in handles,
            'control handle must be excluded from the exact native standard handle list')
    require(value['control_present'] and value['control_initial_open'] and value['control_inherit_cleared'] and
            value['control_excluded_leader'] and value['control_boundary_ready'] and value['control_read_closed'], 'control ownership not confirmed')
    for key in ('helper_pid', 'console_pid_before', 'console_pid_after', 'console_count_before',
                'console_process_count', 'console_error_before', 'console_error',
                'console_query_capacity', 'console_dword_size', 'leader_creation_flags'):
        require(type(value.get(key)) is int and 0 <= value[key] <= 0xffffffff, 'malformed ' + key)
    for key in ('console_window_before', 'console_window_after'):
        require(type(value.get(key)) is int and 0 <= value[key] < (1 << 64), 'malformed ' + key)
    require(value.get('console_policy') == 'private-headless-inherited' and
            value['private_console_confirmed'] and value['helper_pid'] > 0 and
            value['console_pid_before'] == value['helper_pid'] == value['console_pid_after'] and
            value['console_count_before'] == 1 and value['console_process_count'] == 1 and
            value['console_window_before'] == 0 and value['console_window_after'] == 0 and
            not value['console_free_attempted'] and value['leader_console_inherit_requested'] and
            value['leader_creation_flags'] == 0x80204 and
            value['console_query_capacity'] == 16 and value['console_dword_size'] == 4,
            'private helper headless-console inheritance not confirmed')
    require(value['control_final_observation'] in ('open', 'eof') and
            value['control_eof_observed'] == (value['control_final_observation'] == 'eof'), 'invalid finite EOF boundary')
    require(value['interruption_source'] in ('none', 'control_pipe_eof') and value['interrupt_code'] is None and
            value['interrupted'] == value['control_eof_observed'] and
            (value['interruption_source'] == 'control_pipe_eof') == value['interrupted'],
            'control-pipe interruption must not invent a console event')
    expected_complete = (value['leader_exited_naturally'] and not value['retirement_requested'] and
        not value['timeout'] and not value['interrupted'] and value['leader_status_dword'] < 0x80000000)
    require(value['complete'] == expected_complete and value['tests_passed'] == (expected_complete and value['leader_status_dword'] == 0),
            'complete/tests status contradicts process lifecycle')
    if value['timeout']: require(helper_status == 124, 'timeout lost its primary result')
    elif value['interrupted']:
        require(helper_status == 130 and value['interruption_source'] == 'control_pipe_eof' and value['control_eof_observed'], 'invalid interruption')
    elif expected_complete: require(helper_status == value['leader_status_dword'], 'natural native status changed')
    else: require(helper_status == 125 or helper_status >= 0x80000000, 'invalid incomplete status')
    return value


def windows_supervised_run(runner, command, receipt_path, env, timeout=None, stdin_policy="inherit", stream_capture=None):
    """Only the helper owns the JobObject; Python owns the sole EOF writer.

    Internal no-input capability calls use stdin_policy="null"; terminal
    forwarding is limited to the one-shot CLI action whose interpreter exits
    after collection. Reusable callers cannot leave competing terminal readers.
    Stream directly through explicit standard handles. A KeyboardInterrupt
    caught before collection stays incomplete even if helper admission closed
    after its owned tree became empty. Parent death leaves run.json uncollected.
    """
    import msvcrt
    if timeout is not None and (not math.isfinite(timeout) or timeout <= 0 or timeout > (1 << 53) / 1000):
        raise CoverageError('run timeout must be positive finite seconds')
    read_fd, writer = os.pipe()
    read_handle = msvcrt.get_osfhandle(read_fd)
    if os.get_handle_inheritable(msvcrt.get_osfhandle(writer)):
        os.close(read_fd); os.close(writer)
        raise CoverageError('control writer must not be inheritable')
    start = subprocess.STARTUPINFO()
    start.lpAttributeList = {'handle_list': [read_handle]}
    argv = [runner['path'], '--timeout-ms', str(math.ceil(timeout * 1000)) if timeout else '0',
            '--receipt', str(receipt_path), '--control-read-handle', str(read_handle), '--'] + list(command)
    child = None; interrupted = False; backstop = False
    parent_deadline = time.monotonic() + timeout + 12 if timeout is not None else None
    # Pipe/file/NUL stdin retains the caller's ordinary descriptor directly.
    # A terminal is forwarded through a pipe into the private headless console.
    if stdin_policy not in ("inherit", "null", "terminal-one-shot"):
        raise CoverageError("unsupported private runner stdin policy")
    terminal_input = stdin_policy != "null" and sys.stdin is not None and sys.stdin.isatty()
    if terminal_input and stdin_policy != "terminal-one-shot":
        os.close(read_fd); os.close(writer)
        raise CoverageError("terminal forwarding requires the one-shot CLI run action")
    stdin_source = (subprocess.DEVNULL if stdin_policy == "null" else subprocess.PIPE if terminal_input
                    else sys.stdin if sys.stdin is not None else subprocess.DEVNULL)
    pumps, stream_errors = [], []
    def pump_output(source, target, stream):
        try:
            while True:
                data = source.read1(65536)
                if not data: break
                if stream_capture is not None: stream_capture(stream, data)
                if target is not None:
                    binary = getattr(target, "buffer", None)
                    if binary is not None: binary.write(data); binary.flush()
                    else: target.write(data.decode("utf-8", errors="replace")); target.flush()
        except (OSError, ValueError) as error: stream_errors.append(str(error))
        finally: source.close()
    def pump_input(target):
        try:
            if sys.stdin is not None:
                while True:
                    data = os.read(sys.stdin.fileno(), 65536)
                    if not data: break
                    target.write(data); target.flush()
        except (OSError, ValueError): pass  # Native EOF/closed stdin is ordinary.
        finally:
            try: target.close()
            except (OSError, ValueError): pass
    try:
        with WINDOWS_CREATE_LOCK:
            os.set_handle_inheritable(read_handle, True)
            try:
                child = subprocess.Popen(argv, env=env, close_fds=True, startupinfo=start,
                    stdin=stdin_source, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    creationflags=subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP)
            finally: os.set_handle_inheritable(read_handle, False)
        os.close(read_fd); read_fd = None
        # Explicit pipes preserve native stdio in the private headless console.
        # Stream bytes to the caller, including a terminal caller whose own
        # console is never detached or joined by the helper.
        pumps = [threading.Thread(target=pump_output, args=(source, target, stream), daemon=True)
                 for source, target, stream in ((child.stdout, sys.stdout, 'stdout'), (child.stderr, sys.stderr, 'stderr'))]
        for thread in pumps: thread.start()
        if terminal_input: threading.Thread(target=pump_input, args=(child.stdin,), daemon=True).start()
        while child.poll() is None:
            if parent_deadline is not None and time.monotonic() >= parent_deadline:
                raise WindowsRunFailure("Windows helper exceeded timeout plus its bounded cleanup budget", timed_out=True)
            try: child.wait(timeout=0.05)
            except subprocess.TimeoutExpired: pass
    except KeyboardInterrupt:
        interrupted = True
    finally:
        # EOF cancels only this private helper/tree. Never signal a console
        # group or detach the user's Python host/caller from its own console.
        if child is not None and child.poll() is None:
            os.close(writer); writer = None
            deadline = time.monotonic() + 12
            while child.poll() is None and time.monotonic() < deadline:
                try: child.wait(timeout=0.05)
                except subprocess.TimeoutExpired: pass
                except KeyboardInterrupt: interrupted = True
            if child.poll() is None:
                backstop = True; child.kill(); child.wait(timeout=3)
        if read_fd is not None: os.close(read_fd)
        if writer is not None: os.close(writer)
    if child is None or backstop:
        raise WindowsRunFailure('Windows coverage helper was uncollected or forced by parent backstop; counters unavailable', interrupted=interrupted)
    for thread in pumps:
        while thread.is_alive():
            try: thread.join(timeout=2)
            except KeyboardInterrupt: interrupted = True; continue
            if thread.is_alive(): raise CoverageError("Windows helper output pipes did not drain after empty-job exit")
    if stream_errors: raise CoverageError("Windows helper stream forwarding failed: " + "; ".join(stream_errors))
    raw = read_json(receipt_path)
    try:
        native = validate_windows_receipt(raw, child.returncode)
        if native['control_read_handle'] != read_handle:
            raise CoverageError("Windows runner control handle differs from the parent enrollment")
    except CoverageError as error:
        raise WindowsRunFailure(str(error), interrupted=interrupted or raw.get('interrupted') is True,
                                timed_out=raw.get('timeout') is True) from error
    return {'native': native, 'parent_interrupted': interrupted, 'helper_argv': argv,
            'exit_status': 130 if interrupted and not native['timeout'] else child.returncode,
            'complete': native['complete'] and not interrupted}


def identify_backend(cc, gcov, gcovr=None, backend="gcc-gcov", compile_args=None):
    if backend == "llvm-gcov":
        return identify_llvm_backend(cc, gcov, gcovr, compile_args)
    if backend != "gcc-gcov":
        raise CoverageError("unsupported explicit coverage backend: " + backend)
    compiler = tool_identity(cc)
    profiler = tool_identity(gcov)
    if not re.search(r"\bGCC\b|\bgcc\b", compiler["version_output"]):
        raise CoverageError("native Titan coverage requires GCC 14+; this compiler is unsupported")
    compiler["version"] = invoke(compiler["argv"] + ["-dumpfullversion", "-dumpversion"]).stdout.strip()
    match = re.search(r"\b(\d+\.\d+(?:\.\d+)?)\b", profiler["version_output"])
    if not match or match.group(1) != compiler["version"]:
        raise CoverageError("GCC and gcov versions must match exactly")
    if int(compiler["version"].split(".")[0]) < 14:
        raise CoverageError("native Titan coverage requires GCC 14+ and gcov JSON v2")
    profiler["version"] = match.group(1)
    compiler["target"] = invoke(compiler["argv"] + ["-dumpmachine"]).stdout.strip()
    for name in ("cc1", "libgcov.a"):
        flag = "-print-prog-name=" if name == "cc1" else "-print-file-name="
        path = invoke(compiler["argv"] + [flag + name]).stdout.strip()
        if not Path(path).is_file():
            raise CoverageError("GCC does not provide its expected {} tool/runtime".format(name))
        compiler[name] = {"path": str(Path(path).resolve()), "sha256": digest(path)}
    result = {"cc": compiler, "gcov": profiler}
    if gcovr is not None:
        result["gcovr"] = identify_reporter(gcovr)
    return result


def identify_reporter(command):
    reporter = tool_identity(command)
    match = re.search(r"\bgcovr\s+(\S+)", reporter["version_output"])
    if not match or match.group(1) != GCOVR_VERSION:
        raise CoverageError("native Titan reports require pinned gcovr " + GCOVR_VERSION)
    reporter["version"] = match.group(1)
    return reporter


def c_filename(path):
    # JSON's escapes are the corresponding C string escapes for filesystem paths.
    return json.dumps(str(path), ensure_ascii=True)


def gcov_json(gcov, notes, work, data=None):
    """Read one explicit notes/counters pair without searching a mutable tree."""
    work = Path(work)
    work.mkdir(parents=True, exist_ok=False)
    local_notes = work / "object.gcno"
    shutil.copyfile(notes, local_notes)
    if data is not None:
        shutil.copyfile(data, work / "object.gcda")
    result = invoke(command_argv(gcov) + ["--json-format", "--branch-counts", str(local_notes)], cwd=work, allowed=None)
    save_json(work / "gcov-command.json", {"argv": command_argv(gcov) + ["--json-format", "--branch-counts", str(local_notes)],
                                           "stdout": result.stdout, "stderr": result.stderr})
    if result.returncode:
        raise CoverageError("gcov exited {} for {}:\n{}{}".format(result.returncode, notes, result.stdout, result.stderr))
    # GCC reports missing counters for notes-only objects. Every other diagnostic
    # is an error; in particular a mismatched stamp must not become zero coverage.
    diagnostics = [line for line in result.stderr.splitlines()
                   if not (data is None and "cannot open data file, assuming not executed" in line)]
    if diagnostics:
        raise CoverageError("gcov diagnostics for {}:\n{}".format(notes, "\n".join(diagnostics)))
    files = list(work.glob("*.gcov.json.gz"))
    if len(files) != 1:
        raise CoverageError("gcov did not produce exactly one JSON file for " + str(notes))
    try:
        value = json.loads(gzip.decompress(files[0].read_bytes()))
    except (OSError, ValueError) as error:
        raise CoverageError("malformed gcov JSON for " + str(notes)) from error
    if str(value.get("format_version")) != "2" or not isinstance(value.get("files"), list):
        raise CoverageError("gcov JSON v2 is required")
    return value


def gcov_path(value, filename, sealed_root=None):
    path = Path(filename)
    if sealed_root is not None:
        # LLVM's authored #line names are relative to the sealed source root,
        # even when its notes record cwd='.'. Validate before resolve can erase
        # traversal or turn a Windows drive-relative name into an alias.
        windows = PureWindowsPath(filename)
        absolute = path.is_absolute()
        if (not filename or any(ord(c) < 32 or ord(c) == 127 for c in filename) or
                windows.drive and (not windows.is_absolute() or
                                   not re.fullmatch(r"[A-Za-z]:", windows.drive)) or
                windows.root and not windows.drive and
                (os.name == "nt" or filename.startswith("\\") or not absolute)):
            raise CoverageError("unsafe LLVM authored source path: " + filename)
        tail = filename[len(windows.drive):].replace("\\", "/")
        parts = tail.split("/")
        if windows.root:
            parts = parts[1:]
        if not parts or any(part in ("", ".", "..") for part in parts):
            raise CoverageError("unsafe LLVM authored source path: " + filename)
        if not absolute and not windows.is_absolute():
            path = Path(sealed_root).joinpath(*parts)
    elif not path.is_absolute():
        path = Path(value["current_working_directory"]) / path
    return os.path.normcase(str(path.resolve()))


def raw_lines(value, source):
    key = os.path.normcase(str(Path(source).resolve()))
    found = {}
    for file in value["files"]:
        if gcov_path(value, file["file"]) == key:
            for line in file["lines"]:
                number, count = line["line_number"], line["count"]
                if not isinstance(number, int) or number < 1 or not isinstance(count, int) or count < 0:
                    raise CoverageError("invalid executable line/count in gcov JSON")
                found[number] = found.get(number, 0) + count
    return found


def counter_path(prefix, embedded, backend="gcc-gcov"):
    # GCC's GCOV_PREFIX_STRIP=0 relocation drops an absolute path's root/drive.
    path = PureWindowsPath(embedded) if backend == "llvm-gcov" else Path(embedded)
    if backend == "llvm-gcov" and (not path.is_absolute() or not re.fullmatch(r"[A-Za-z]:", path.drive)):
        raise CoverageError("LLVM counters require an absolute local Windows drive path")
    parts = path.parts[1:] if path.anchor else path.parts
    return Path(prefix).joinpath(*parts)


def probe_backend(cc, gcov, gcovr=None, output=None, backend="gcc-gcov", runner_directory=None, compile_args=None):
    if backend == "llvm-gcov":
        return probe_llvm_backend(cc, gcov, gcovr, output, runner_directory, compile_args)
    if backend != "gcc-gcov":
        raise CoverageError("unsupported explicit coverage backend: " + backend)
    tools = identify_backend(cc, gcov, gcovr)
    output = Path(output).resolve() if output else None
    if output is not None:
        output.mkdir(parents=True, exist_ok=False)
    with tempfile.TemporaryDirectory(prefix="titan-coverage-probe-") as temporary:
        work = Path(temporary)
        # Spaces, quotes, two filenames, a multiline expansion and a separate
        # notes-only translation unit are all part of the capability contract.
        source = work / ('first "quoted" file.titan' if os.name != "nt" else "first space file.titan")
        second = work / "second file.titan"
        untouched = work / "notes only.titan"
        for path in (source, second, untouched):
            path.write_text("\n".join("probe line {}".format(i) for i in range(1, 11)) + "\n", encoding="utf-8")
        c = work / "probe.c"
        c.write_text("int choose(int x) {{\n"
                     "#line 3 {}\nint y=x;\n#line 3 {}\ny+=1;\n#line 3 {}\ny+=1;\n"
                     "#line 4 {}\nif(x) {{\n#line 6 {}\nreturn 99;\n"
                     "#line 4 {}\n}}\n#line 7 {}\nreturn y;\n#line 1 {}\n}}\n"
                     "#line 8 {}\nint never(void) {{return 9;}}\n"
                     "#line 1 {}\nint main(void) {{return choose(0)==2?0:1;}}\n".format(
                         *([c_filename(source)] * 7), c_filename(c), c_filename(second), c_filename(c)), encoding="utf-8")
        never_c = work / "never.c"
        never_c.write_text("#line 5 {}\nint notes_only(void) {{return 4;}}\n".format(c_filename(untouched)), encoding="utf-8")
        flags = ["-O0", "-fno-lto", "-fPIC", "--coverage", "-fprofile-update=atomic"]
        for stem in ("probe", "never"):
            invoke(tools["cc"]["argv"] + flags + ["-dumpbase", stem + ".c", "-dumpbase-ext", ".c",
                                                     "-c", str(work / (stem + ".c")), "-o", str(work / (stem + ".tmp.o"))])
            (work / (stem + ".tmp.o")).replace(work / (stem + ".o"))
        executable = work / ("probe.exe" if os.name == "nt" else "probe")
        invoke(tools["cc"]["argv"] + ["--coverage", str(work / "probe.o"), "-o", str(executable)])
        prefix = work / "fresh-counters"
        env = os.environ.copy()
        env.update({"GCOV_PREFIX": str(prefix), "GCOV_PREFIX_STRIP": "0"})
        invoke([str(executable)], env=env)
        data = counter_path(prefix, work / "probe.gcda")
        if not data.is_file() or (work / "probe.gcda").exists():
            raise CoverageError("GCC runtime did not honor isolated GCOV_PREFIX counters")
        value = gcov_json(tools["gcov"]["argv"], work / "probe.gcno", work / "read-probe", data)
        actual = raw_lines(value, source)
        if not all(actual.get(line, 0) > 0 for line in (3, 4, 7)) or actual.get(6) != 0:
            raise CoverageError("backend failed exact Titan line attribution/untaken-line probe")
        if raw_lines(value, second).get(8) != 0:
            raise CoverageError("backend failed multi-file uncalled-function probe")
        zero = gcov_json(tools["gcov"]["argv"], work / "never.gcno", work / "read-never")
        if raw_lines(zero, untouched) != {5: 0}:
            raise CoverageError("backend failed notes-only module probe")
        shared = work / ("provider.dll" if os.name == "nt" else "provider.so")
        shared_flag = "-dynamiclib" if platform.system() == "Darwin" else "-shared"
        invoke(tools["cc"]["argv"] + ["--coverage", shared_flag, str(work / "probe.o"), "-o", str(shared)])
        provider_prefix = work / "provider-counters"
        provider_env = env.copy()
        provider_env["GCOV_PREFIX"] = str(provider_prefix)
        threaded = ("import ctypes,sys,threading; p=ctypes.CDLL(sys.argv[1]); "
                    "threads=[threading.Thread(target=lambda:[p.choose(0) for _ in range(16)]) for _ in range(4)]; "
                    "[t.start() for t in threads]; [t.join() for t in threads]")
        invoke([sys.executable, "-c", threaded, str(shared)], env=provider_env)
        provider_data = counter_path(provider_prefix, work / "probe.gcda")
        if not provider_data.is_file():
            raise CoverageError("shared provider did not flush isolated counters at process exit")
        provider_value = gcov_json(tools["gcov"]["argv"], work / "probe.gcno", work / "read-provider", provider_data)
        provider_lines = raw_lines(provider_value, source)
        if provider_lines.get(3) != 64 or provider_lines.get(6) != 0 or provider_lines.get(7) != 64:
            raise CoverageError("shared provider/thread-safe atomic counters failed exact-result probe")
        children_prefix = work / "joined-child-counters"
        children_env = env.copy()
        children_env["GCOV_PREFIX"] = str(children_prefix)
        joined = ("import subprocess,sys; children=[subprocess.Popen([sys.argv[1]]) for _ in range(8)]; "
                  "sys.exit(max(child.wait() for child in children))")
        invoke([sys.executable, "-c", joined, str(executable)], env=children_env)
        children_value = gcov_json(tools["gcov"]["argv"], work / "probe.gcno", work / "read-children",
                                   counter_path(children_prefix, work / "probe.gcda"))
        children_lines = raw_lines(children_value, source)
        if children_lines.get(3) != 8 or children_lines.get(6) != 0 or children_lines.get(7) != 8:
            raise CoverageError("joined child processes did not preserve locked counter updates")
        evidence = {"version": SCHEMA, "backend": "gcc-gcov", "tools": tools,
                    "platform": {"system": platform.system(), "machine": platform.machine()},
                    "checks": {"exact_lines": True, "multiple_files": True, "unexecuted_function": True,
                               "notes_only": True, "atomic_temp_object": True, "counter_relocation": True,
                               "shared_provider_exit": True, "thread_safe_counters": True, "joined_processes": True},
                    "raw_probe": value, "raw_notes_only": zero, "raw_provider": provider_value, "raw_children": children_value}
        if output is not None:
            save_json(output / "probe.json", evidence)
        return evidence


@contextmanager
def llvm_probe_workspace(runner_directory, diagnostics):
    # Only this small, generated capability fixture is retained on failure.
    # Keep it beside its build-owned helper so the printed path survives TMP
    # cleanup; never copy the caller's environment or arbitrary source trees.
    work = Path(tempfile.mkdtemp(prefix='probe-', dir=runner_directory)).resolve()
    try:
        yield work
    except BaseException as error:
        diagnostics.update(state='failed', error_type=type(error).__name__, error=str(error),
                           diagnostic_directory=str(work))
        try:
            save_json(work / 'failure.json', diagnostics)
        except OSError as diagnostic_error:
            print('titan-coverage: cannot write failure receipt: ' + str(diagnostic_error), file=sys.stderr)
        message = 'LLVM capability diagnostics retained at ' + str(work)
        if isinstance(error, CoverageError):
            raise CoverageError(str(error) + '\n' + message) from error
        print('titan-coverage: ' + message, file=sys.stderr)
        raise
    else:
        shutil.rmtree(work)


def llvm_probe_command(work, name, argv):
    command = {'argv': argv, 'exit_status': None, 'timed_out': False}
    try:
        result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
        stdout, stderr = result.stdout, result.stderr
        command['exit_status'] = result.returncode
    except subprocess.TimeoutExpired as error:
        stdout, stderr = error.stdout or b'', error.stderr or b''
        command['timed_out'] = True
    except OSError as error:
        stdout, stderr = b'', b''
        command['execution_error'] = str(error)
    # Compiler output is diagnostic data, never interpolated into a CLI error.
    # Bound retained streams and record their original sizes/hashes explicitly.
    failed = command['exit_status'] != 0 or command['timed_out']
    failure = ('LLVM capability ' + name + ' failed (exit ' + str(command['exit_status'])
               + ', timeout ' + str(command['timed_out']) + ')')
    try:
        for stream, data in (('stdout', stdout), ('stderr', stderr)):
            retained = data[:65536]
            (work / (name + '.' + stream)).write_bytes(retained)
            command[stream] = {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest(),
                               'retained_bytes': len(retained), 'truncated': len(retained) != len(data)}
        save_json(work / (name + '-command.json'), command)
    except OSError as error:
        if failed:
            raise CoverageError(failure + '; command diagnostics could not be written: ' + str(error)) from error
        raise
    if failed:
        raise CoverageError(failure + '; see ' + str(work / (name + '-command.json')))


@contextmanager
def llvm_probe_streams(work, name):
    streams = {key: {'bytes': 0, 'retained_bytes': 0, 'hash': hashlib.sha256(), 'disabled': False}
               for key in ('stdout', 'stderr')}
    files, errors, primary = {}, [], None
    def capture(stream, data):
        item = streams[stream]
        item['bytes'] += len(data)
        item['hash'].update(data)
        retained = data[:max(0, 65536 - item['retained_bytes'])]
        if retained and not item['disabled']:
            try:
                files[stream].write(retained)
                item['retained_bytes'] += len(retained)
            except OSError as error:
                # Keep draining/forwarding both native pipes and retiring the
                # owned job even when diagnostic storage fails.
                item['disabled'] = True
                errors.append(stream + ': ' + str(error))
    try:
        for stream in streams:
            files[stream] = (work / (name + '.native.' + stream)).open('wb')
        yield capture
    except BaseException as error:
        primary = error
        raise
    finally:
        for stream, file in files.items():
            try: file.close()
            except OSError as error: errors.append(stream + ' close: ' + str(error))
        for stream, item in streams.items():
            try:
                actual = (work / (name + '.native.' + stream)).stat().st_size
                if actual != item['retained_bytes']:
                    errors.append(stream + ': retained file size differs from accepted writes')
                item['retained_bytes'] = actual
            except OSError as error:
                item['retained_bytes'] = None
                errors.append(stream + ' retained size: ' + str(error))
        receipt = {stream: {'bytes': item['bytes'], 'sha256': item['hash'].hexdigest(),
                            'retained_bytes': item['retained_bytes'],
                            'truncated': item['bytes'] != item['retained_bytes']}
                   for stream, item in streams.items()}
        receipt['capture_errors'] = errors
        try:
            save_json(work / (name + '-native-streams.json'), receipt)
        except OSError as error:
            errors.append('stream receipt: ' + str(error))
        if errors:
            message = 'LLVM native probe stream capture failed: ' + '; '.join(errors)
            if primary is None: raise CoverageError(message)
            print('titan-coverage: ' + message, file=sys.stderr)


def llvm_probe_run(runner, command, work, name, env):
    with llvm_probe_streams(work, name) as capture:
        outcome = windows_supervised_run(runner, command, work / (name + '-runner.json'), env, 30,
                                         stdin_policy='null', stream_capture=capture)
        failed = not outcome['complete'] or outcome['exit_status'] != 0
        try:
            save_json(work / (name + '-outcome.json'), outcome)
        except OSError as error:
            if not failed: raise
            print('titan-coverage: cannot retain native outcome: ' + str(error), file=sys.stderr)
        if failed:
            raise CoverageError('LLVM capability child did not complete successfully under its owned runner: '
                                + name + ' (exit ' + str(outcome['exit_status'])
                                + ', complete ' + str(outcome['complete']) + ')')
    return outcome


def probe_llvm_backend(cc, gcov, gcovr=None, output=None, runner_directory=None, compile_args=None):
    tools = identify_llvm_backend(cc, gcov, gcovr, compile_args)
    runner = materialize_runner(runner_directory, tools)
    if output is not None:
        output = Path(output).resolve(); output.mkdir(parents=True, exist_ok=False)
    diagnostics = {'schema': 1, 'backend': 'llvm-gcov', 'stage': 'prepare-fixture', 'tools': tools}
    with llvm_probe_workspace(Path(runner['path']).parent, diagnostics) as work:
        first, second, untouched = [work / name for name in ('first space.titan', 'second.titan', 'notes only.titan')]
        for path in (first, second, untouched): path.write_text('probe line\n' * 10, encoding='utf-8')
        c = work / 'probe.c'
        c.write_text('#include <windows.h>\n__declspec(dllexport) int choose(int x) {\n'
            '#line 3 ' + c_filename(first) + '\nint y=x;\ny+=1;\n'
            '#line 3 ' + c_filename(first) + '\ny+=1;\n'
            '#line 4 ' + c_filename(first) + '\nif(x) {\n'
            '#line 6 ' + c_filename(first) + '\nreturn 99;\n}\n'
            '#line 7 ' + c_filename(first) + '\nreturn y;\n}\n'
            '#line 8 ' + c_filename(second) + '\nint never(void) {return 9;}\n'
            '#line 1 ' + c_filename(c) + '\nint main(void) {return choose(0)==2?0:1;}\n', encoding='utf-8')
        (work / 'never.c').write_text('#line 5 ' + c_filename(untouched) + '\nint notes_only(void) {return 4;}\n', encoding='utf-8')
        prefix = tools['cc']['argv'] + tools['cc']['effective_compile_args']
        flags = ['-O0', '-fno-lto', '--coverage', '-fprofile-update=atomic']
        def compile_probe(name, argv):
            diagnostics['stage'] = name
            llvm_probe_command(work, name, argv)
        for stem in ('probe', 'never'):
            # Exercise the compiler's exact -dumpdir publication contract:
            # final notes/data derive from the C basename, while -o is a unique
            # temporary object which is atomically renamed after compilation.
            compile_probe('compile-' + stem, prefix + flags + ['-dumpdir', str(work) + os.sep,
                '-c', str(work / (stem + '.c')), '-o', str(work / (stem + '.tmp.o'))])
            (work / (stem + '.tmp.o')).replace(work / (stem + '.o'))
        executable, shared = work / 'probe.exe', work / 'provider.dll'
        for image, kind in ((executable, []), (shared, ['-shared'])):
            compile_probe('link-' + image.suffix[1:], tools['cc']['argv'] + ['--coverage', '-static'] + kind
                          + [str(work / 'probe.o'), '-o', str(image)])
            pe_image_identity(image)
        raws = {}
        def collect(name, command):
            diagnostics['stage'] = 'collect-' + name
            counter_root = work / (name + '-counters')
            env = os.environ.copy(); env.update(GCOV_PREFIX=str(counter_root), GCOV_PREFIX_STRIP='1')
            llvm_probe_run(runner, command, work, name, env)
            data = counter_path(counter_root, work / 'probe.gcda', 'llvm-gcov')
            if not data.is_file() or (work / 'probe.gcda').exists():
                raise CoverageError('LLVM runtime did not honor drive-aware fresh counter relocation')
            value = llvm_gcov_raw(tools['gcov']['argv'], work / 'probe.gcno', work / ('read-' + name), data)
            raws[name] = value
            save_json(work / (name + '-counts.json'), value)
            return value
        value = collect('program', [str(executable)])
        actual = raw_lines(value, first)
        diagnostics.update(stage='program-attribution', source=str(first),
            expected_counts={'positive': [3, 4, 7], 'zero': [6], 'uncalled_second': {8: 0}},
            observed_counts={'first': actual, 'second': raw_lines(value, second)})
        if not all(actual.get(line, 0) > 0 for line in (3, 4, 7)) or actual.get(6) != 0 or raw_lines(value, second).get(8) != 0:
            raise CoverageError('LLVM backend failed exact multi-file/uncalled Titan line attribution')
        diagnostics['stage'] = 'notes-only'
        zero = llvm_gcov_raw(tools['gcov']['argv'], work / 'never.gcno', work / 'read-notes-only')
        save_json(work / 'notes-only-counts.json', zero)
        diagnostics.update(stage='notes-only-counts', source=str(untouched),
                           expected_counts={5: 0}, observed_counts=raw_lines(zero, untouched))
        if raw_lines(zero, untouched) != {5: 0}:
            raise CoverageError('LLVM backend failed complete notes-only zero inventory')
        threaded = ('import ctypes,sys,threading; p=ctypes.CDLL(sys.argv[1]); '
            'ts=[threading.Thread(target=lambda:[p.choose(0) for _ in range(16)]) for _ in range(4)]; '
            '[t.start() for t in ts]; [t.join() for t in ts]')
        provider = collect('provider', [sys.executable, '-I', '-S', '-B', '-c', threaded, str(shared)])
        joined = ('import subprocess,sys; cs=[subprocess.Popen([sys.argv[1]]) for _ in range(8)]; '
            'sys.exit(max(c.wait() for c in cs))')
        children = collect('children', [sys.executable, '-I', '-S', '-B', '-c', joined, str(executable)])
        for name, raw, count in (('provider', provider, 64), ('children', children, 8)):
            lines = raw_lines(raw, first)
            # The deliberate 3 -> 4 -> 3 remap records line 3 twice in one
            # executed LLVM block. Its exact count is twice the call count;
            # line 7 independently records each invocation once.
            expected = {3: 2 * count, 6: 0, 7: count}
            diagnostics.update(stage='exact-counts-' + name, source=str(first), expected_counts=expected,
                               observed_counts=lines)
            if any(lines.get(line) != expected_count for line, expected_count in expected.items()):
                raise CoverageError('LLVM ' + name + ' exact counts failed: expected ' + str(expected)
                                    + ', observed ' + str(lines))
        checks = {key: True for key in ('exact_lines', 'multiple_files', 'unexecuted_function', 'notes_only',
            'atomic_temp_object', 'counter_relocation', 'shared_provider_exit', 'thread_safe_counters', 'joined_processes', 'owned_runner')}
        evidence = {'version': SCHEMA, 'backend': 'llvm-gcov', 'tools': tools,
            'platform': {'system': platform.system(), 'machine': platform.machine()}, 'checks': checks,
            'runner': runner, 'counter_policy': copy.deepcopy(LLVM_COUNTER_POLICY), 'raw_probe': raws, 'raw_notes_only': zero}
        if output is not None: save_json(output / 'probe.json', evidence)
        return evidence


def manifest_identity(manifest):
    unsigned = copy.deepcopy(manifest)
    unsigned.pop("manifest_id", None)
    return hashlib.sha256(canonical(unsigned)).hexdigest()


def inventory_path_identity(path, backend):
    if backend == "llvm-gcov":
        # Windows local-drive paths are case insensitive. Resolve physical
        # directory aliases before folding drive/directory/filename spelling.
        return str(Path(path).resolve()).replace("\\", "/").casefold()
    return str(Path(path))


def validate_inventory(manifest, check_hashes=False):
    if manifest.get("version") != SCHEMA or manifest.get("backend") not in ("gcc-gcov", "llvm-gcov"):
        raise CoverageError("unsupported coverage manifest schema/backend")
    root = Path(manifest["root"])
    if not root.is_absolute() or not root.is_dir():
        raise CoverageError("manifest root must be an existing absolute directory")
    sources = manifest.get("sources", [])
    objects = manifest.get("objects", [])
    providers = manifest.get("providers", [])
    if not sources or not objects or not providers:
        raise CoverageError("coverage inventory requires sources, objects and linked providers")
    source_ids = set()
    path_ids = set()
    for source in sources:
        report = source["report_path"]
        report_path = Path(report)
        if report_path.is_absolute() or ".." in report_path.parts or report_path.suffix != ".titan":
            raise CoverageError("report_path must be a root-relative Titan source path")
        if report in source_ids:
            raise CoverageError("duplicate source report path: " + report)
        source_ids.add(report)
        compiled = Path(source["path"])
        tracked = Path(source.get("tracked_path", root / report))
        if not compiled.is_absolute() or not tracked.is_absolute():
            raise CoverageError("source paths must be absolute")
        source_key = (inventory_path_identity(compiled, manifest["backend"]) if manifest["backend"] == "llvm-gcov"
                      else os.path.normcase(str(compiled.resolve())))
        if source_key in path_ids:
            raise CoverageError("compiled source has multiple report identities: " + str(compiled))
        path_ids.add(source_key)
        if tracked.resolve() != (root / report).resolve():
            raise CoverageError("tracked source does not match repository report path: " + report)
        current = digest(compiled)
        if current != digest(tracked):
            raise CoverageError("staged and tracked source bytes differ: " + report)
        if (check_hashes or "sha256" in source) and current != source.get("sha256"):
            raise CoverageError("source changed since coverage build: " + report)
        physical_source_lines(tracked)
    object_ids = set()
    notes_ids = set()
    data_ids = set()
    measured_sources = set()
    for obj in objects:
        if not obj.get("sources") or not set(obj["sources"]) <= source_ids:
            raise CoverageError("object has absent or undeclared source inventory")
        measured_sources.update(obj["sources"])
        for key, identities in (("path", object_ids), ("notes", notes_ids), ("data", data_ids)):
            path = Path(obj[key])
            identity = inventory_path_identity(path, manifest["backend"])
            if not path.is_absolute() or identity in identities:
                raise CoverageError("object paths must be absolute and physically unique: " + str(path))
            identities.add(identity)
            if key != "data":
                current = digest(path)
                hash_key = "sha256" if key == "path" else "notes_sha256"
                if (check_hashes or hash_key in obj) and current != obj.get(hash_key):
                    raise CoverageError("coverage {} changed since build: {}".format(key, path))
        if Path(obj["notes"]).with_suffix(".gcda") != Path(obj["data"]):
            raise CoverageError("notes/counters filenames must have the same stable stem")
    if measured_sources != source_ids:
        raise CoverageError("declared sources have no instrumented object: " + ", ".join(sorted(source_ids - measured_sources)))
    provider_ids = set()
    for provider in providers:
        path = Path(provider["path"])
        identity = inventory_path_identity(path, manifest["backend"])
        if not path.is_absolute() or identity in provider_ids:
            raise CoverageError("provider paths must be absolute and physically unique")
        provider_ids.add(identity)
        launcher = provider.get("role") == "launcher"
        if launcher:
            if manifest["backend"] != "llvm-gcov" or provider.get("objects") != [] or path.suffix.lower() != ".exe":
                raise CoverageError("unmeasured launcher requires an explicit LLVM Windows EXE with no measured objects")
        elif not provider.get("objects") or not {inventory_path_identity(item, manifest["backend"])
                                                 for item in provider["objects"]} <= object_ids:
            raise CoverageError("provider links absent or undeclared objects")
        current = digest(path)
        if (check_hashes or "sha256" in provider) and current != provider.get("sha256"):
            raise CoverageError("provider changed since coverage build: " + str(path))
    if not any(provider.get("objects") for provider in providers):
        raise CoverageError("coverage build requires a measured linked provider")
    linked_paths = set()
    for item in manifest.get("link_inventory", []):
        path = Path(item["path"])
        identity = inventory_path_identity(path, manifest["backend"])
        if not path.is_absolute() or identity in linked_paths:
            raise CoverageError("link inventory paths must be absolute and physically unique")
        linked_paths.add(identity)
        current = digest(path)
        if (check_hashes or "sha256" in item) and current != item.get("sha256"):
            raise CoverageError("linked input changed since coverage build: " + str(path))
    if manifest.get("settings", {}).get("metric") != "titan-executable-lines":
        raise CoverageError("manifest must declare Titan executable-line coverage")


def unmeasured_input_list(filename):
    if filename is None: return []
    path = Path(filename).resolve()
    try:
        contents = path.read_bytes().decode("utf-8", errors="strict")
        value = json.loads(contents)
    except (OSError, UnicodeError, ValueError) as error:
        raise CoverageError("cannot read UTF-8 unmeasured-input JSON list: " + str(path)) from error
    if not isinstance(value, list) or any(not isinstance(item, str) or not item or "\0" in item for item in value):
        raise CoverageError("unmeasured-input file must be a JSON array of nonempty path strings without NUL")
    known, result = set(), []
    for item in value:
        resolved = str(Path(item).resolve())
        identity = os.path.normcase(resolved)
        if identity in known: raise CoverageError("duplicate physical path in unmeasured-input file: " + item)
        if not Path(resolved).is_file(): raise CoverageError("unmeasured-input path is not a file: " + item)
        known.add(identity); result.append(resolved)
    return result


def seal_manifest(path, cc=None, gcov=None, gcovr=None, unmeasured_inputs=None, unmeasured_input_file=None):
    manifest = read_json(path)
    manifest.pop("manifest_id", None)
    validate_inventory(manifest)
    inventory = manifest.setdefault("link_inventory", [])
    known = {os.path.normcase(str(Path(item["path"]).resolve())) for item in inventory}
    list_inputs = unmeasured_input_list(unmeasured_input_file)
    for filename in list(unmeasured_inputs or []) + list_inputs:
        resolved = str(Path(filename).resolve())
        identity = os.path.normcase(resolved)
        if identity not in known:
            inventory.append({"path": resolved, "role": "unmeasured-consumer-input",
                              "sha256": digest(resolved)})
            known.add(identity)
    if unmeasured_input_file is not None:
        list_path = str(Path(unmeasured_input_file).resolve())
        if os.path.normcase(list_path) not in known:
            inventory.append({"path": list_path, "role": "unmeasured-input-list", "sha256": digest(list_path)})
    settings = manifest.get("settings", {})
    cc = cc or settings.get("cc") or os.environ.get("CC", "gcc")
    gcov = gcov or settings.get("gcov") or os.environ.get("GCOV", "gcov")
    if manifest["backend"] == "llvm-gcov":
        try: probe = json.loads(settings["backend_probe"])
        except (KeyError, TypeError, ValueError) as error:
            raise CoverageError("LLVM sealing requires the exact compilation probe JSON") from error
        if (probe.get("backend") != "llvm-gcov" or settings.get("backend") != "llvm-gcov" or
                probe.get("counter_policy") != LLVM_COUNTER_POLICY or
                settings.get("counter_policy") != {"format": "llvm-gcov", "gcov_prefix_strip": 1}):
            raise CoverageError("LLVM compilation/probe counter policy disagrees")
        compiler_argv = command_argv(cc)
        compile_prefix = settings.get("compile_prefix", [])
        if not isinstance(compile_prefix, list) or compile_prefix[:len(compiler_argv)] != compiler_argv:
            raise CoverageError("LLVM effective compiler prefix differs from selected compiler")
        tools = identify_backend(cc, gcov, gcovr, backend="llvm-gcov", compile_args=compile_prefix[len(compiler_argv):])
        if any(probe.get("tools", {}).get(key) != tools[key] for key in ("cc", "gcov")):
            raise CoverageError("LLVM tool identity differs from compilation capability probe")
        required = ("exact_lines", "multiple_files", "unexecuted_function", "notes_only", "atomic_temp_object",
                    "counter_relocation", "shared_provider_exit", "thread_safe_counters", "joined_processes", "owned_runner")
        if not all(probe.get("checks", {}).get(key) is True for key in required):
            raise CoverageError("LLVM capability evidence is incomplete")
        if probe.get("platform") != {"system": platform.system(), "machine": platform.machine()}:
            raise CoverageError("LLVM capability evidence belongs to another host platform")
        validate_interpreter(probe["tools"]["python"], tools["python"])
        tools["python"] = probe["tools"]["python"]
        manifest["runner"] = validate_runner(probe["runner"], tools)
        manifest["counter_policy"] = copy.deepcopy(LLVM_COUNTER_POLICY)
        probe["tools"] = tools
        for obj in manifest["objects"]:
            llvm_reader_parse_notes(Path(obj["notes"]).read_bytes())
    else:
        probe = probe_backend(cc, gcov, gcovr)
    if "cc_version" in settings and settings["cc_version"] != probe["tools"]["cc"]["version"]:
        raise CoverageError("seal compiler version differs from the coverage build")
    if "backend_probe" in settings:
        built_probe = json.loads(settings["backend_probe"])
        if any(built_probe.get("tools", {}).get(key) != probe["tools"][key] for key in ("cc", "gcov")):
            raise CoverageError("seal compiler/profiler identity differs from the compilation capability probe")
    manifest["tools"] = probe["tools"]
    manifest["platform"] = probe["platform"]
    manifest["capability"] = probe["checks"]
    for source in manifest["sources"]:
        source["sha256"] = digest(source["path"])
        source["tracked_path"] = str(Path(source.get("tracked_path", Path(manifest["root"]) / source["report_path"])))
    for obj in manifest["objects"]:
        obj["sha256"] = digest(obj["path"])
        obj["notes_sha256"] = digest(obj["notes"])
    for provider in manifest["providers"]:
        provider["sha256"] = digest(provider["path"])
    for item in manifest.get("link_inventory", []):
        item["sha256"] = digest(item["path"])
    manifest["manifest_id"] = manifest_identity(manifest)
    save_json(path, manifest)
    return manifest


def load_manifest(path):
    manifest = read_json(path)
    if manifest.get("manifest_id") != manifest_identity(manifest):
        raise CoverageError("coverage manifest is unsealed or its provenance changed; run titan-coverage seal")
    validate_inventory(manifest, check_hashes=True)
    tools = identify_backend(manifest["tools"]["cc"]["argv"], manifest["tools"]["gcov"]["argv"],
                             backend=manifest["backend"],
                             compile_args=manifest["tools"]["cc"].get("effective_compile_args"))
    if any(tools[key] != manifest["tools"][key] for key in ("cc", "gcov")):
        raise CoverageError("compiler/profiler identity changed since coverage build")
    if manifest["backend"] == "llvm-gcov":
        if manifest.get("counter_policy") != LLVM_COUNTER_POLICY:
            raise CoverageError("sealed LLVM counter policy changed")
        validate_interpreter(manifest["tools"]["python"], tools["python"])
        validate_runner(manifest["runner"], tools)
    if manifest["platform"] != {"system": platform.system(), "machine": platform.machine()}:
        raise CoverageError("coverage evidence belongs to another operating system/architecture")
    return manifest


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def stop_run_processes(child, interrupted=False):
    """Bound leader cleanup and retire its whole private POSIX process group."""
    if os.name != "nt":
        try:
            os.killpg(child.pid, signal.SIGINT if interrupted else signal.SIGTERM)
        except ProcessLookupError:
            pass
    elif child.poll() is None:
        child.terminate()
    try:
        child.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass
    # Reaping the leader says nothing about descendants which ignored the
    # first signal and may still own output descriptors or coverage counters.
    if os.name != "nt":
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    elif child.poll() is None:
        child.kill()
    try:
        child.wait(timeout=2)
        return True
    except subprocess.TimeoutExpired:
        return False


def run_process_group_exists(group):
    try:
        os.killpg(group, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        # Lack of permission cannot establish that an observed group is empty.
        return True
    return True


def wait_run_process_group_empty(group, timeout=2):
    deadline = time.monotonic() + timeout
    while run_process_group_exists(group):
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.01)
    return True


def execute_windows_run(manifest, manifest_path, run_path, command, expected, timeout):
    if manifest['backend'] != 'llvm-gcov':
        raise CoverageError('native Windows runs require the explicit llvm-gcov owned-runner backend')
    prefix = run_path / 'counters'
    env = os.environ.copy()
    env.update(GCOV_PREFIX=str(prefix), GCOV_PREFIX_STRIP='1', TITAN_COVERAGE_RUN=str(run_path),
               TITAN_COVERAGE_MANIFEST=str(Path(manifest_path).resolve()))
    receipt = {'version': RUN_SCHEMA, 'run_id': uuid.uuid4().hex, 'manifest_id': manifest['manifest_id'],
        'command': command, 'cwd': str(Path.cwd()), 'started': utc_now(), 'expected_objects': expected,
        'state': 'running', 'counter_prefix': str(prefix), 'process_ownership': 'windows-job-object-v1',
        'job_empty_confirmed': False, 'parent_interrupted': False, 'runner_sha256': manifest['runner']['sha256']}
    save_json(run_path / 'run.json', receipt)
    try:
        result = windows_supervised_run(manifest['runner'], command, run_path / 'native-runner.json', env, timeout, stdin_policy='terminal-one-shot')
        native = result['native']
        receipt.update(native_runner=native, native_receipt_sha256=digest(run_path / 'native-runner.json'),
            job_empty_confirmed=True, leader_exit_status=native['leader_status_dword'],
            parent_interrupted=result['parent_interrupted'], state='complete' if result['complete'] else 'incomplete',
            reason='Python KeyboardInterrupt' if result['parent_interrupted'] else native['reason'],
            exit_status=result['exit_status'], helper_argv=result['helper_argv'])
    except (CoverageError, OSError) as error:
        receipt.update(state='incomplete', exit_status=getattr(error, 'exit_status', 125), reason=str(error),
                       parent_interrupted=getattr(error, 'interrupted', False),
                       counter_collection_skipped='owned Windows job/native status was not confirmed')
    receipt['ended'] = utc_now()
    receipt['counters'] = ([{'path': str(path), 'sha256': digest(path)} for path in sorted(prefix.rglob('*.gcda'))]
                            if receipt['job_empty_confirmed'] else [])
    expected_paths = {str(counter_path(prefix, obj['data'], 'llvm-gcov')) for obj in manifest['objects'] if obj['path'] in expected}
    missing = expected_paths - {item['path'] for item in receipt['counters']}
    if missing: receipt.update(state='incomplete', missing_counters=sorted(missing))
    save_json(run_path / 'run.json', receipt)
    return receipt['exit_status']


def execute_run(manifest_path, run_path, command, expected=None, timeout=None):
    manifest = load_manifest(manifest_path)
    if not command:
        raise CoverageError("run requires a command after --")
    run_path = Path(run_path).resolve()
    try:
        run_path.mkdir(parents=True, exist_ok=False)
    except FileExistsError as error:
        raise CoverageError("run directory already exists; choose a fresh run-owned directory") from error
    prefix = run_path / "counters"
    prefix.mkdir()
    expected = list(expected or [obj["path"] for obj in manifest["objects"] if obj.get("expect_data", False)])
    if not set(expected) <= {obj["path"] for obj in manifest["objects"]}:
        raise CoverageError("expected counters refer to an undeclared object")
    if os.name == "nt":
        return execute_windows_run(manifest, manifest_path, run_path, command, expected, timeout)
    env = os.environ.copy()
    env.update({"GCOV_PREFIX": str(prefix), "GCOV_PREFIX_STRIP": "0",
                "TITAN_COVERAGE_RUN": str(run_path), "TITAN_COVERAGE_MANIFEST": str(Path(manifest_path).resolve())})
    receipt = {"version": RUN_SCHEMA, "run_id": uuid.uuid4().hex, "manifest_id": manifest["manifest_id"],
               "command": command, "cwd": str(Path.cwd()), "started": utc_now(),
               "expected_objects": expected, "state": "running", "counter_prefix": str(prefix)}
    if os.name != "nt":
        receipt.update({"process_ownership": "posix-process-group-v1", "process_group_id": None,
                        "process_group_empty_confirmed": False, "group_retirement_requested": False})
    save_json(run_path / "run.json", receipt)
    child = None
    try:
        child = subprocess.Popen(command, env=env, start_new_session=(os.name != "nt"))
        if os.name != "nt":
            receipt["process_group_id"] = child.pid
        try:
            status = child.wait(timeout=timeout)
            receipt["state"] = "complete" if status >= 0 else "incomplete"
        except subprocess.TimeoutExpired:
            receipt["group_retirement_requested"] = os.name != "nt"
            receipt["leader_reaped"] = stop_run_processes(child)
            status = 124
            receipt["state"] = "incomplete"
            receipt["reason"] = "forced termination at timeout"
    except OSError as error:
        status = 127
        receipt["state"] = "incomplete"
        receipt["reason"] = str(error)
    except KeyboardInterrupt:
        receipt["group_retirement_requested"] = os.name != "nt"
        receipt["leader_reaped"] = child is not None and stop_run_processes(child, interrupted=True)
        status = 130
        receipt["state"] = "incomplete"
        receipt["reason"] = "interrupted"
    if child is not None:
        if os.name != "nt":
            # A reaped leader may leave writers in its private group. Observe
            # that group before collecting any counters; even a zombie-only
            # observation is conservatively incomplete, without process scans.
            if run_process_group_exists(child.pid) and not receipt["group_retirement_requested"]:
                receipt["group_retirement_requested"] = True
                receipt["leader_reaped"] = stop_run_processes(child)
                receipt["state"] = "incomplete"
                receipt["reason"] = "owned process group remained after leader exit"
                status = 125
            receipt["process_group_empty_confirmed"] = wait_run_process_group_empty(child.pid)
            if not receipt["process_group_empty_confirmed"]:
                receipt["state"] = "incomplete"
                receipt["counter_collection_skipped"] = "owned process group emptiness was not confirmed"
        receipt["leader_exit_status"] = child.returncode
    receipt["exit_status"] = status
    receipt["ended"] = utc_now()
    inventory = []
    if os.name == "nt" or receipt["process_group_empty_confirmed"]:
        for path in sorted(prefix.rglob("*.gcda")):
            inventory.append({"path": str(path), "sha256": digest(path)})
    receipt["counters"] = inventory
    expected_paths = {str(counter_path(prefix, obj["data"], manifest["backend"])) for obj in manifest["objects"] if obj["path"] in expected}
    missing = expected_paths - {item["path"] for item in inventory}
    if missing:
        receipt["state"] = "incomplete"
        receipt["missing_counters"] = sorted(missing)
    save_json(run_path / "run.json", receipt)
    return status if status >= 0 else 128 - status


def load_run(path, manifest):
    path = Path(path).resolve()
    receipt = read_json(path / "run.json")
    if receipt.get("version") != RUN_SCHEMA or receipt.get("manifest_id") != manifest["manifest_id"]:
        raise CoverageError("run provenance is legacy or does not match the declared coverage build; collect a fresh run")
    if receipt.get("state") not in ("complete", "incomplete") or "exit_status" not in receipt:
        raise CoverageError("run has not exited/collected; cannot report its counters")
    if manifest["backend"] == "llvm-gcov":
        if (receipt.get("process_ownership") != "windows-job-object-v1" or
                receipt.get("job_empty_confirmed") is not True or
                type(receipt.get("parent_interrupted")) is not bool or
                receipt.get("runner_sha256") != manifest["runner"]["sha256"]):
            raise CoverageError("run owned Windows job was not confirmed empty; cannot report its counters")
        native = read_json(path / "native-runner.json")
        if native != receipt.get("native_runner") or digest(path / "native-runner.json") != receipt.get("native_receipt_sha256"):
            raise CoverageError("native Windows runner receipt changed after collection")
        validate_windows_receipt(native, native.get("supervisor_exit_code"))
        expected_status = (130 if receipt["parent_interrupted"] and not native["timeout"] else native["supervisor_exit_code"])
        if (receipt.get("leader_exit_status") != native["leader_status_dword"] or receipt["exit_status"] != expected_status or
                receipt["state"] == "complete" and (not native["complete"] or receipt["parent_interrupted"])):
            raise CoverageError("complete run disagrees with its owned Windows job lifecycle")
    else:
        group = receipt.get("process_group_id")
        if (receipt.get("process_ownership") != "posix-process-group-v1" or
                type(group) is not int or group <= 0 or
                type(receipt.get("leader_exit_status")) is not int or
                type(receipt.get("group_retirement_requested")) is not bool or
                receipt.get("process_group_empty_confirmed") is not True):
            raise CoverageError("run owned process group was not confirmed empty; cannot report its counters")
        if receipt["state"] == "complete" and (receipt["group_retirement_requested"] or
                receipt["leader_exit_status"] < 0 or receipt["exit_status"] != receipt["leader_exit_status"]):
            raise CoverageError("complete run disagrees with its owned process group lifecycle")
    prefix = path / "counters"
    if receipt.get("counter_prefix") != str(prefix):
        raise CoverageError("run counter ownership changed")
    expected_paths = {str(counter_path(prefix, obj["data"], manifest["backend"])) for obj in manifest["objects"]}
    counters = {item["path"]: item["sha256"] for item in receipt.get("counters", [])}
    actual = {str(item): digest(item) for item in prefix.rglob("*.gcda")}
    if actual != counters:
        raise CoverageError("run counters changed after collection (live child or stale accumulation)")
    if not set(counters) <= expected_paths:
        raise CoverageError("run contains counters outside the instrumented object inventory")
    return receipt, counters


def normalized_trace(manifest, raw_values):
    """Filter explicit sources; keep genuine gcov lines and counts, no heuristics."""
    lookup = {os.path.normcase(str(Path(source["path"]).resolve())): source for source in manifest["sources"]}
    counts = {source["report_path"]: {} for source in manifest["sources"]}
    text_lines = {source["report_path"]: physical_source_lines(source["tracked_path"])
                  for source in manifest["sources"]}
    seen = set()
    for obj, value in raw_values:
        allowed = set(obj["sources"])
        for file in value["files"]:
            authored = (manifest["backend"] == "llvm-gcov" and file["file"].casefold().endswith(".titan"))
            source = lookup.get(gcov_path(value, file["file"], manifest["root"] if authored else None))
            if source is None:
                if authored or Path(file["file"]).suffix == ".titan":
                    raise CoverageError("gcov contains a Titan source outside the declared inventory: " + file["file"])
                continue
            report = source["report_path"]
            if report not in allowed:
                raise CoverageError("object gcov source disagrees with its contributor inventory: " + report)
            seen.add(report)
            line_count = len(text_lines[report])
            for line in file["lines"]:
                number, count = line.get("line_number"), line.get("count")
                if not isinstance(number, int) or number < 1 or number > line_count:
                    raise CoverageError("gcov line is outside its tracked Titan source: {}:{}".format(report, number))
                if not isinstance(count, int) or count < 0:
                    raise CoverageError("gcov count is malformed: " + report)
                counts[report][number] = counts[report].get(number, 0) + count
    missing = {source["report_path"] for source in manifest["sources"]
               if source["report_path"] not in seen and not source.get("allow_empty", False)}
    if missing:
        raise CoverageError("declared sources have no gcov notes attribution: " + ", ".join(sorted(missing)))
    return {"gcovr/format_version": GCOVR_FORMAT,
            "files": [{"file": report, "functions": [],
                       "lines": [{"line_number": number, "count": count, "branches": [],
                                  "gcovr/md5": hashlib.md5(text_lines[report][number - 1].encode("utf-8"), usedforsecurity=False).hexdigest()}
                                 for number, count in sorted(lines.items())]}
                      for report, lines in sorted(counts.items())]}


def compatible_manifest_identity(manifest):
    """Merge source-equivalent builds, while retaining each image's provenance.

    Test/app mode, staging roots, formatter choice and provider layout may differ.
    The actual source identities and compiler/coverage semantics must agree.
    """
    settings = manifest["settings"]
    relevant_settings = {key: settings.get(key) for key in
                         ("metric", "line_mapping", "compile_prefix", "compiler_identity")}
    sources = sorted((source["report_path"], source["module"], source["sha256"],
                      os.path.normcase(str(Path(source["tracked_path"]).resolve())))
                     for source in manifest["sources"])
    identity = {"version": manifest["version"], "backend": manifest["backend"],
            "root": os.path.normcase(str(Path(manifest["root"]).resolve())),
            "platform": manifest["platform"], "tools": {key: manifest["tools"][key] for key in ("cc", "gcov")},
            "sources": sources, "settings": relevant_settings}
    if manifest["backend"] == "llvm-gcov":
        identity["runner"] = runner_semantic_identity(manifest["runner"])
        identity["counter_policy"] = manifest["counter_policy"]
    return identity


def merge_line_traces(traces):
    files = {}
    for trace in traces:
        for source in trace["files"]:
            lines = files.setdefault(source["file"], {})
            for line in source["lines"]:
                number = line["line_number"]
                if number in lines:
                    if lines[number]["gcovr/md5"] != line["gcovr/md5"]:
                        raise CoverageError("coverage source line identity changed while merging")
                    lines[number]["count"] += line["count"]
                else:
                    lines[number] = copy.deepcopy(line)
    return {"gcovr/format_version": GCOVR_FORMAT,
            "files": [{"file": path, "functions": [], "lines": [line for _, line in sorted(lines.items())]}
                      for path, lines in sorted(files.items())]}


def write_html_templates(directory):
    directory = Path(directory)
    directory.mkdir()
    identities = {}
    for name, contents in HTML_TEMPLATES.items():
        raw = contents.encode("utf-8")
        (directory / name).write_bytes(raw)
        identities[name] = hashlib.sha256(raw).hexdigest()
    return identities


def report_runs(manifest_paths, runs, output, gcovr, allow_incomplete=False):
    if isinstance(manifest_paths, (str, Path)):
        manifest_paths = [manifest_paths]
    manifests = [load_manifest(path) for path in manifest_paths]
    if not manifests:
        raise CoverageError("report requires at least one coverage manifest")
    manifest = manifests[0]
    compatibility = compatible_manifest_identity(manifest)
    if any(compatible_manifest_identity(item) != compatibility for item in manifests[1:]):
        raise CoverageError("coverage manifests have incompatible source/tool/platform/compilation provenance")
    by_manifest = {item["manifest_id"]: item for item in manifests}
    if len(by_manifest) != len(manifests):
        raise CoverageError("the same coverage manifest was supplied twice")
    reporter = identify_reporter(gcovr)
    receipts = []
    inventories = []
    run_manifests = []
    run_ids = set()
    for path in runs:
        manifest_id = read_json(Path(path).resolve() / "run.json").get("manifest_id")
        if manifest_id not in by_manifest:
            raise CoverageError("run provenance does not match any supplied coverage manifest")
        run_manifest = by_manifest[manifest_id]
        receipt, inventory = load_run(path, run_manifest)
        if receipt["run_id"] in run_ids:
            raise CoverageError("the same coverage run was supplied twice")
        run_ids.add(receipt["run_id"])
        receipts.append(receipt)
        inventories.append(inventory)
        run_manifests.append(run_manifest)
    if not receipts:
        raise CoverageError("report requires at least one completed or explicitly incomplete run")
    output = Path(output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    traces = []
    for index, (receipt, inventory, run_manifest) in enumerate(zip(receipts, inventories, run_manifests)):
        raw_values = []
        for object_index, obj in enumerate(run_manifest["objects"]):
            data_path = str(counter_path(receipt["counter_prefix"], obj["data"], run_manifest["backend"]))
            reader = llvm_gcov_raw if run_manifest["backend"] == "llvm-gcov" else gcov_json
            value = reader(run_manifest["tools"]["gcov"]["argv"], obj["notes"],
                              output / "raw" / ("run-{}-object-{}".format(index, object_index)),
                              data_path if data_path in inventory else None)
            if data_path in inventory and digest(output / "raw" / ("run-{}-object-{}".format(index, object_index)) / "object.gcda") != inventory[data_path]:
                raise CoverageError("run counters changed during collection")
            raw_values.append((obj, value))
        traces.append(normalized_trace(run_manifest, raw_values))
    trace = merge_line_traces(traces)
    save_json(output / "lines.json", trace)
    incomplete = [item["run_id"] for item in receipts if item["state"] != "complete"]
    failed = [item["run_id"] for item in receipts if item["exit_status"] != 0]
    totals = sum(len(file["lines"]) for file in trace["files"])
    hits = sum(line["count"] > 0 for file in trace["files"] for line in file["lines"])
    summary = {"version": SCHEMA, "metric": "titan-executable-lines", "manifest_id": manifest["manifest_id"] if len(manifests) == 1 else None,
               "manifest_ids": [item["manifest_id"] for item in manifests],
               "platform": manifest["platform"], "reporter": reporter, "runs": receipts,
               "complete": not incomplete, "tests_passed": not failed,
               "incomplete_runs": incomplete, "failed_runs": failed,
               "lines_total": totals, "lines_covered": hits,
               "line_percent": 100.0 * hits / totals if totals else None}
    templates = output / "html-templates"
    summary["html_templates"] = write_html_templates(templates)
    save_json(output / "summary.json", summary)
    if len(manifests) == 1:
        save_json(output / "build.json", manifest)
    else:
        for index, item in enumerate(manifests):
            save_json(output / ("build-{}.json".format(index)), item)
    # A minimal empty config disables any ambient gcovr.cfg from a user's tree.
    config = output / "gcovr.cfg"
    config.write_text("", encoding="utf-8")
    args = reporter["argv"] + ["--config", str(config), "--root", manifest["root"],
                              "--add-tracefile", str(output / "lines.json"),
                              "--no-markers", "--no-exclude-noncode-lines", "--lcov", str(output / "coverage.gcovr.info"),
                              "--cobertura", str(output / "coverage.xml"),
                              "--html-details", str(output / "coverage.html"), "--html-single-page", "static",
                              "--html-template-dir", str(templates),
                              "--html-title", "Titan executable-line coverage" + (" (INCOMPLETE)" if incomplete else "")]
    rendered = invoke(args, cwd=manifest["root"])
    save_json(output / "report-command.json", {"argv": args, "stdout": rendered.stdout, "stderr": rendered.stderr})
    source_paths = {os.path.normcase(str(Path(source["tracked_path"]).resolve())): source["report_path"]
                    for source in manifest["sources"]}
    lcov_lines = []
    for line in (output / "coverage.gcovr.info").read_text(encoding="utf-8").splitlines():
        if line.startswith("SF:"):
            key = os.path.normcase(str(Path(line[3:]).resolve()))
            if key not in source_paths:
                raise CoverageError("reporter emitted an undeclared source: " + line[3:])
            line = "SF:" + source_paths[key].replace("\\", "/")
        # The public interchange report declares only the supported line metric.
        if line.startswith(("FNF:", "FNH:", "BRF:", "BRH:")):
            continue
        lcov_lines.append(line)
    (output / "coverage.info").write_text("\n".join(lcov_lines) + "\n", encoding="utf-8")
    for item in manifests:
        validate_inventory(item, check_hashes=True)
    for path, item in zip(runs, run_manifests):
        load_run(path, item)
    print("Titan executable lines: {}/{}{}".format(hits, totals, " (incomplete)" if incomplete else ""))
    # Partial reports remain available but are never returned as complete success.
    if incomplete and not allow_incomplete:
        return 2
    if failed:
        return 1
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    probe = commands.add_parser("probe", help="verify actual GCC/gcov attribution and counter isolation")
    seal = commands.add_parser("seal", help="verify and hash a compiler-written build inventory")
    for item in (probe, seal):
        item.add_argument("--cc", default=os.environ.get("CC", "gcc") if item is probe else None)
        item.add_argument("--gcov", default=os.environ.get("GCOV", "gcov") if item is probe else None)
        item.add_argument("--gcovr", default=None, help="also verify pinned report tool (optional while compiling)")
    probe.add_argument("--backend", choices=("gcc-gcov", "llvm-gcov"), default="gcc-gcov")
    probe.add_argument("--runner-directory", help="durable build-owned Windows runner directory")
    probe.add_argument("--compile-arg", action="append", default=[], help="effective compiler-prefix token after CC; repeat")
    probe.add_argument("--output", help="new directory for probe JSON evidence")
    seal.add_argument("--manifest", required=True)
    seal.add_argument("--unmeasured-input", action="append", default=[],
                      help="hash a separate uninstrumented consumer or test input; repeat as needed")
    seal.add_argument("--unmeasured-input-file", help="strict UTF-8 JSON array of explicit paths; list itself is sealed")
    run = commands.add_parser("run", help="execute with fresh counters and an exit-status receipt")
    run.add_argument("--manifest", required=True)
    run.add_argument("--run", required=True, help="new run-owned directory")
    run.add_argument("--expect-object", action="append", default=[])
    run.add_argument("--timeout", type=float)
    run.add_argument("command", nargs=argparse.REMAINDER)
    report = commands.add_parser("report", help="merge matching runs and render LCOV, HTML and Cobertura")
    report.add_argument("--manifest", action="append", required=True,
                        help="sealed build inventory; repeat for compatible test/app images")
    report.add_argument("--run", action="append", required=True)
    report.add_argument("--output", required=True, help="new report directory")
    report.add_argument("--gcovr", default=os.environ.get("GCOVR", "gcovr"))
    report.add_argument("--allow-incomplete", action="store_true",
                        help="accept incomplete collection explicitly; failed test statuses still fail")
    args = parser.parse_args(argv)
    try:
        if args.action == "probe":
            value = probe_backend(args.cc, args.gcov, args.gcovr, args.output, args.backend,
                                  args.runner_directory, args.compile_arg)
            print(json.dumps({key: value[key] for key in ("backend", "tools", "checks", "platform", "runner", "counter_policy")
                              if key in value}, sort_keys=True))
            return 0
        if args.action == "seal":
            manifest = seal_manifest(args.manifest, args.cc, args.gcov, args.gcovr,
                                     args.unmeasured_input, args.unmeasured_input_file)
            print(manifest["manifest_id"])
            return 0
        if args.action == "run":
            command = args.command[1:] if args.command[:1] == ["--"] else args.command
            return execute_run(args.manifest, args.run, command, args.expect_object, args.timeout)
        return report_runs(args.manifest, args.run, args.output, args.gcovr, args.allow_incomplete)
    except (CoverageError, KeyError, TypeError, ValueError, OSError) as error:
        print("titan-coverage: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
