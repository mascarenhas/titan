/* Cancellation precedence is independent of the native leader DWORD. */
static unsigned long probe_secondary_error_status(int timed_out, int interrupted) {
    return timed_out ? 124UL : interrupted ? 130UL : 125UL;
}
static unsigned long probe_observed_control_status(int timed_out) {
    return timed_out ? 124UL : 130UL;
}
