#define MAX_TIMEOUT_MS 0xfffffffffffffffeULL
#define CLEANUP_TIMEOUT_MS 10000

typedef struct {
    const char *reason, *error_operation;
    DWORD win32_error, leader_pid, leader_status, interrupt_code;
    DWORD active_at_exit, active_before_retirement, active_final;
    int child_created, status_known, natural_exit, active_at_exit_known;
    int active_before_known, active_final_known, retirement_requested;
    int retirement_succeeded, forced_leader, forced_descendants;
    int timed_out, interrupted, empty_confirmed, complete, tests_passed;
    DWORD result;
    HANDLE control_read;
    HANDLE leader_handles[3];
    int control_present, control_inherit_cleared, control_excluded_leader;
    int control_initial_open, control_eof, control_boundary_ready, control_closed;
    int private_console_confirmed, console_interrupted;
    DWORD helper_pid, console_pid_before, console_pid_after, leader_creation_flags;
    int leader_console_inherit_requested;
    DWORD console_process_count, console_error;
    DWORD console_count_before, console_error_before;
    HANDLE console_window_before, console_window_after;
    const char *control_final_observation, *interruption_source;
} Receipt;

static HANDLE interrupt_event;
static SRWLOCK interrupt_lock = SRWLOCK_INIT;
static volatile LONG received_control = -1;

static BOOL WINAPI control_handler(DWORD control) {
    if (control != CTRL_C_EVENT && control != CTRL_BREAK_EVENT) return FALSE;
    AcquireSRWLockShared(&interrupt_lock);
    InterlockedCompareExchange(&received_control, (LONG)control, -1);
    if (interrupt_event) SetEvent(interrupt_event);
    ReleaseSRWLockShared(&interrupt_lock);
    return TRUE;
}

static void error(Receipt *receipt, const char *operation) {
    DWORD code = GetLastError();
    if (!receipt->error_operation) {
        receipt->error_operation = operation;
        receipt->win32_error = code;
    }
    fprintf(stderr, "Titan coverage supervisor: %s failed (error %lu).\n",
            operation, (unsigned long)code);
    receipt->result = (DWORD)probe_secondary_error_status(receipt->timed_out, receipt->interrupted);
}

/* The explicit control-only mode has no console handler or application threads.
 * This handle is used exclusively here: no blocking ReadFile, no payload, and
 * no second thread doing synchronous I/O on it. Peek does not consume data. */
static int observe_control(Receipt *receipt, int final) {
    DWORD available = 0;
    if (!receipt->control_present) return 1;
    if (PeekNamedPipe(receipt->control_read, NULL, 0, NULL, &available, NULL)) {
        if (available) {
            if (final) receipt->control_final_observation = "unexpected_data";
            SetLastError(ERROR_INVALID_DATA);
            error(receipt, "unexpected control pipe payload");
            return -1;
        }
        if (final) receipt->control_final_observation = "open";
        return 1;
    }
    DWORD code = GetLastError();
    if (code == ERROR_BROKEN_PIPE) {
        receipt->control_eof = 1;
        receipt->interrupted = 1;
        receipt->interruption_source = "control_pipe_eof";
        if (!receipt->timed_out) receipt->reason = "control_pipe_eof";
        receipt->result = (DWORD)probe_secondary_error_status(receipt->timed_out, 1);
        if (final) receipt->control_final_observation = "eof";
        return 0;
    }
    if (final) receipt->control_final_observation = "error";
    SetLastError(code);
    error(receipt, "PeekNamedPipe control");
    return -1;
}

static int active_processes(HANDLE job, DWORD *count, Receipt *receipt) {
    JOBOBJECT_BASIC_ACCOUNTING_INFORMATION accounting;
    if (!QueryInformationJobObject(job, JobObjectBasicAccountingInformation,
                                   &accounting, sizeof(accounting), NULL)) {
        error(receipt, "QueryInformationJobObject");
        return 0;
    }
    *count = accounting.ActiveProcesses;
    return 1;
}

static void retire_and_confirm(HANDLE job, Receipt *receipt, int force, ULONGLONG deadline) {
    DWORD active;
    if (active_processes(job, &active, receipt)) {
        receipt->active_before_known = 1;
        receipt->active_before_retirement = active;
        /* The leader is already signalled on a natural exit. Any remaining
         * active process is an unjoined descendant. On a forced leader stop,
         * counts above one demonstrate descendants before retirement. */
        if (force && (receipt->natural_exit ? active > 0 : active > 1))
            receipt->forced_descendants = 1;
    } else force = 1;
    if (force) {
        receipt->retirement_requested = 1;
        receipt->forced_leader = receipt->child_created && !receipt->natural_exit;
        if (TerminateJobObject(job, PROBE_FAILURE)) receipt->retirement_succeeded = 1;
        else error(receipt, "TerminateJobObject");
    }
    for (;;) {
        if (!active_processes(job, &active, receipt)) return;
        receipt->active_final_known = 1;
        receipt->active_final = active;
        if (active == 0) { receipt->empty_confirmed = 1; return; }
        if (GetTickCount64() >= deadline) {
            SetLastError(ERROR_TIMEOUT);
            error(receipt, "bounded empty-job confirmation");
            return;
        }
        Sleep(10);
    }
}

static const char *boolean(int value) { return value ? "true" : "false"; }
static void optional_dword(char *output, size_t size, int known, DWORD value) {
    if (known) snprintf(output, size, "%lu", (unsigned long)value);
    else snprintf(output, size, "null");
}

/* Publish only a complete JSON document, and never overwrite an older receipt.
 * Missing/partial .pending output is a failed probe, never successful evidence. */
static int publish_receipt(const wchar_t *path, const Receipt *receipt) {
    char status[24], hexadecimal[24], at_exit[24], before[24], final[24], control[24];
    char operation[160], contents[8192];
    optional_dword(status, sizeof(status), receipt->status_known, receipt->leader_status);
    optional_dword(at_exit, sizeof(at_exit), receipt->active_at_exit_known, receipt->active_at_exit);
    optional_dword(before, sizeof(before), receipt->active_before_known, receipt->active_before_retirement);
    optional_dword(final, sizeof(final), receipt->active_final_known, receipt->active_final);
    optional_dword(control, sizeof(control), receipt->console_interrupted, receipt->interrupt_code);
    if (receipt->status_known)
        snprintf(hexadecimal, sizeof(hexadecimal), "\"0x%08lx\"", (unsigned long)receipt->leader_status);
    else snprintf(hexadecimal, sizeof(hexadecimal), "null");
    if (receipt->error_operation)
        snprintf(operation, sizeof(operation), "\"%s\"", receipt->error_operation);
    else snprintf(operation, sizeof(operation), "null");
    int length = snprintf(contents, sizeof(contents),
        "{\n  \"schema\": 4,\n  \"runner_kind\": \"titan-coverage-job-v1\",\n"
        "  \"leader_created\": %s,\n  \"leader_pid\": %lu,\n"
        "  \"leader_status_dword\": %s,\n  \"leader_status_hex\": %s,\n"
        "  \"leader_exited_naturally\": %s,\n"
        "  \"active_processes_at_leader_exit\": %s,\n"
        "  \"active_processes_before_retirement\": %s,\n"
        "  \"active_processes_final\": %s,\n"
        "  \"retirement_requested\": %s,\n  \"retirement_succeeded\": %s,\n"
        "  \"forced_leader_retirement\": %s,\n  \"forced_descendant_retirement\": %s,\n"
        "  \"timeout\": %s,\n  \"interrupted\": %s,\n  \"interrupt_code\": %s,\n"
        "  \"empty_job_confirmed\": %s,\n  \"reason\": \"%s\",\n"
        "  \"complete\": %s,\n  \"tests_passed\": %s,\n"
        "  \"supervisor_exit_code\": %lu,\n"
        "  \"supervisor_error_operation\": %s,\n  \"win32_error\": %lu,\n"
        "  \"interruption_source\": \"%s\",\n"
        "  \"control_read_handle\": %llu,\n  \"control_present\": %s,\n"
        "  \"control_inherit_cleared\": %s,\n  \"control_excluded_leader\": %s,\n"
        "  \"leader_handle_list\": [%llu, %llu, %llu],\n"
        "  \"control_initial_open\": %s,\n  \"control_eof_observed\": %s,\n"
        "  \"control_boundary_ready\": %s,\n"
        "  \"control_final_observation\": \"%s\",\n  \"control_read_closed\": %s,\n"
        "  \"private_console_confirmed\": %s,\n  \"console_process_count\": %lu,\n"
        "  \"console_error\": %lu,\n"
        "  \"console_count_before\": %lu,\n  \"console_error_before\": %lu,\n"
        "  \"console_window_before\": %llu,\n  \"console_window_after\": %llu,\n"
        "  \"console_policy\": \"%s\",\n  \"console_free_attempted\": false,\n"
        "  \"helper_pid\": %lu,\n  \"console_pid_before\": %lu,\n  \"console_pid_after\": %lu,\n"
        "  \"leader_console_inherit_requested\": %s,\n  \"leader_creation_flags\": %lu,\n"
        "  \"console_query_capacity\": %u,\n  \"console_dword_size\": %u\n}\n",
        boolean(receipt->child_created), (unsigned long)receipt->leader_pid,
        status, hexadecimal, boolean(receipt->natural_exit), at_exit, before, final,
        boolean(receipt->retirement_requested), boolean(receipt->retirement_succeeded),
        boolean(receipt->forced_leader), boolean(receipt->forced_descendants),
        boolean(receipt->timed_out), boolean(receipt->interrupted), control,
        boolean(receipt->empty_confirmed), receipt->reason,
        boolean(receipt->complete), boolean(receipt->tests_passed),
        (unsigned long)receipt->result, operation, (unsigned long)receipt->win32_error,
        receipt->interruption_source, (unsigned long long)(uintptr_t)receipt->control_read,
        boolean(receipt->control_present), boolean(receipt->control_inherit_cleared),
        boolean(receipt->control_excluded_leader),
        (unsigned long long)(uintptr_t)receipt->leader_handles[0],
        (unsigned long long)(uintptr_t)receipt->leader_handles[1],
        (unsigned long long)(uintptr_t)receipt->leader_handles[2],
        boolean(receipt->control_initial_open), boolean(receipt->control_eof),
        boolean(receipt->control_boundary_ready), receipt->control_final_observation,
        boolean(receipt->control_closed), boolean(receipt->private_console_confirmed),
        (unsigned long)receipt->console_process_count, (unsigned long)receipt->console_error,
        (unsigned long)receipt->console_count_before, (unsigned long)receipt->console_error_before,
        (unsigned long long)(uintptr_t)receipt->console_window_before,
        (unsigned long long)(uintptr_t)receipt->console_window_after,
        receipt->control_present ? "private-headless-inherited" : "legacy-console-events",
        (unsigned long)receipt->helper_pid, (unsigned long)receipt->console_pid_before,
        (unsigned long)receipt->console_pid_after,
        boolean(receipt->leader_console_inherit_requested),
        (unsigned long)receipt->leader_creation_flags,
        receipt->control_present ? 16U : 0U, (unsigned int)sizeof(DWORD));
    if (length <= 0 || (size_t)length >= sizeof(contents)) return 0;
    size_t path_length = wcslen(path);
    wchar_t *pending = calloc(path_length + 9, sizeof(*pending));
    if (!pending) return 0;
    memcpy(pending, path, path_length * sizeof(*pending));
    wcscpy(pending + path_length, L".pending");
    HANDLE file = CreateFileW(pending, GENERIC_WRITE, 0, NULL, CREATE_NEW,
                              FILE_ATTRIBUTE_NORMAL, NULL);
    int ok = 0;
    if (file != INVALID_HANDLE_VALUE) {
        DWORD written = 0;
        ok = WriteFile(file, contents, (DWORD)length, &written, NULL)
            && written == (DWORD)length && FlushFileBuffers(file);
        if (!CloseHandle(file)) ok = 0;
        if (ok) ok = MoveFileExW(pending, path, MOVEFILE_WRITE_THROUGH);
    }
    free(pending);
    return ok;
}

int wmain(int argc, wchar_t **argv) {
    wchar_t *end = NULL;
    errno = 0;
    unsigned long long timeout = argc >= 3 ? wcstoull(argv[2], &end, 10) : 0;
    int control_mode = argc >= 9 && !wcscmp(argv[5], L"--control-read-handle");
    int program = control_mode ? 8 : 6;
    if (argc < 7 || wcscmp(argv[1], L"--timeout-ms") || wcscmp(argv[3], L"--receipt")
        || wcscmp(argv[program - 1], L"--") || !argv[2][0] || !end || *end || errno
        || argv[2][0] == L'-' || timeout > MAX_TIMEOUT_MS
        || !(((argv[4][0] >= L'A' && argv[4][0] <= L'Z')
               || (argv[4][0] >= L'a' && argv[4][0] <= L'z'))
              && argv[4][1] == L':' && (argv[4][2] == L'/' || argv[4][2] == L'\\'))) {
        fputs("usage: supervisor.exe --timeout-ms 0=unbounded or positive milliseconds --receipt DRIVE:/fresh.json -- EXE [ARG...]\n", stderr);
        return PROBE_FAILURE;
    }
    Receipt receipt = {0};
    receipt.helper_pid = GetCurrentProcessId();
    receipt.reason = "supervisor_error";
    receipt.interruption_source = "none";
    receipt.control_final_observation = "not_used";
    receipt.result = PROBE_FAILURE;
    if (control_mode) {
        wchar_t *control_end = NULL;
        errno = 0;
        unsigned long long value = wcstoull(argv[6], &control_end, 10);
        if (!argv[6][0] || argv[6][0] == L'-' || !control_end || *control_end
            || errno || !value || value > UINTPTR_MAX || value == UINTPTR_MAX) {
            fputs("Invalid inherited control read handle.\n", stderr);
            return PROBE_FAILURE;
        }
        receipt.control_present = 1;
        receipt.control_read = (HANDLE)(uintptr_t)value;
        receipt.control_final_observation = "not_observed";
    }
    HANDLE job = NULL, handles[3] = {NULL, NULL, NULL};
    PROCESS_INFORMATION child = {0};
    STARTUPINFOEXW start = {0};
    int attributes_ready = 0, handler_ready = 0, force_retirement = 0;
    SIZE_T attribute_bytes = 0;
    ULONGLONG cleanup_deadline = 0;
    wchar_t *command = calloc(PROBE_COMMAND_CAPACITY, sizeof(*command));
    if (!command) { SetLastError(ERROR_OUTOFMEMORY); error(&receipt, "command allocation"); goto done; }
    size_t length = 0;
    for (int i = program; i < argc; ++i) {
        if ((i > program && !probe_append(command, &length, L' '))
            || !probe_quote(command, &length, argv[i])) {
            SetLastError(ERROR_BUFFER_OVERFLOW); error(&receipt, "command quoting"); goto done;
        }
    }
    command[length] = 0;
    if (control_mode) {
        DWORD pids[16], flags;
        SetLastError(ERROR_SUCCESS);
        receipt.console_count_before = GetConsoleProcessList(pids, 16);
        receipt.console_error_before = GetLastError();
        receipt.console_window_before = GetConsoleWindow();
        receipt.console_pid_before = receipt.console_count_before == 1 ? pids[0] : 0;
        /* The caller creates this helper with CREATE_NO_WINDOW. Admit only a
         * private headless console containing exactly this helper. Preserve
         * that console so ordinary measured descendants can inherit it; never
         * attach to a caller console or exempt an owned process from the job. */
        if (receipt.console_count_before != 1
            || receipt.console_pid_before != receipt.helper_pid
            || receipt.console_window_before) {
            SetLastError(ERROR_INVALID_DATA);
            error(&receipt, "helper console is not private and headless"); goto done;
        }
        SetLastError(ERROR_SUCCESS);
        receipt.console_process_count = GetConsoleProcessList(pids, 16);
        receipt.console_error = GetLastError();
        receipt.console_window_after = GetConsoleWindow();
        receipt.console_pid_after = receipt.console_process_count == 1 ? pids[0] : 0;
        if (receipt.console_process_count != 1
            || receipt.console_pid_after != receipt.helper_pid
            || receipt.console_window_after) {
            SetLastError(ERROR_INVALID_DATA);
            error(&receipt, "helper private console changed before leader creation"); goto done;
        }
        receipt.private_console_confirmed = 1;
        if (GetFileType(receipt.control_read) != FILE_TYPE_PIPE) {
            SetLastError(ERROR_INVALID_DATA);
            error(&receipt, "control read handle type"); goto done;
        }
        if (!SetHandleInformation(receipt.control_read, HANDLE_FLAG_INHERIT, 0)
            || !GetHandleInformation(receipt.control_read, &flags)) {
            error(&receipt, "control read handle validation"); goto done;
        }
        if (flags & HANDLE_FLAG_INHERIT) {
            SetLastError(ERROR_INVALID_DATA); error(&receipt, "control read remained inheritable"); goto done;
        }
        receipt.control_inherit_cleared = 1;
        if (observe_control(&receipt, 0) != 1) goto done;
        receipt.control_initial_open = 1;
    } else {
        interrupt_event = CreateEventW(NULL, TRUE, FALSE, NULL);
        if (!interrupt_event) { error(&receipt, "interrupt event"); goto done; }
        if (!SetConsoleCtrlHandler(control_handler, TRUE)) { error(&receipt, "SetConsoleCtrlHandler"); goto done; }
        handler_ready = 1;
    }
    job = CreateJobObjectW(NULL, NULL); /* Unnamed and noninheritable. */
    if (!job) { error(&receipt, "CreateJobObjectW"); goto done; }
    JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {0};
    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
    if (!SetInformationJobObject(job, JobObjectExtendedLimitInformation, &limits, sizeof(limits))) {
        error(&receipt, "SetInformationJobObject"); goto done;
    }
    handles[0] = probe_standard_handle(STD_INPUT_HANDLE, GENERIC_READ);
    handles[1] = probe_standard_handle(STD_OUTPUT_HANDLE, GENERIC_WRITE);
    handles[2] = probe_standard_handle(STD_ERROR_HANDLE, GENERIC_WRITE);
    if (!handles[0] || !handles[1] || !handles[2]) { error(&receipt, "standard handles"); goto done; }
    for (int i = 0; i < 3; ++i) {
        receipt.leader_handles[i] = handles[i];
        if (control_mode && handles[i] == receipt.control_read) {
            SetLastError(ERROR_INVALID_DATA); error(&receipt, "control handle in native stdio list"); goto done;
        }
    }
    receipt.control_excluded_leader = control_mode;
    InitializeProcThreadAttributeList(NULL, 2, 0, &attribute_bytes);
    if (!attribute_bytes) { error(&receipt, "attribute size"); goto done; }
    start.lpAttributeList = malloc(attribute_bytes);
    if (!start.lpAttributeList) { SetLastError(ERROR_OUTOFMEMORY); error(&receipt, "attribute allocation"); goto done; }
    if (!InitializeProcThreadAttributeList(start.lpAttributeList, 2, 0, &attribute_bytes)) {
        error(&receipt, "InitializeProcThreadAttributeList"); goto done;
    }
    attributes_ready = 1;
    if (!UpdateProcThreadAttribute(start.lpAttributeList, 0, PROC_THREAD_ATTRIBUTE_JOB_LIST,
                                   &job, sizeof(job), NULL, NULL)
        || !UpdateProcThreadAttribute(start.lpAttributeList, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
                                      handles, sizeof(handles), NULL, NULL)) {
        error(&receipt, "UpdateProcThreadAttribute"); goto done;
    }
    start.StartupInfo.cb = sizeof(start);
    start.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
    start.StartupInfo.hStdInput = handles[0];
    start.StartupInfo.hStdOutput = handles[1];
    start.StartupInfo.hStdError = handles[2];
    if (control_mode ? observe_control(&receipt, 0) != 1
                     : WaitForSingleObject(interrupt_event, 0) == WAIT_OBJECT_0) goto done;
    receipt.leader_console_inherit_requested = control_mode;
    receipt.leader_creation_flags = EXTENDED_STARTUPINFO_PRESENT | CREATE_SUSPENDED | CREATE_NEW_PROCESS_GROUP;
    if (!CreateProcessW(argv[program], command, NULL, NULL, TRUE,
                        receipt.leader_creation_flags,
                        NULL, NULL, &start.StartupInfo, &child)) {
        error(&receipt, "CreateProcessW atomic job assignment"); goto done;
    }
    receipt.child_created = 1;
    receipt.leader_pid = child.dwProcessId;
    force_retirement = 1; /* Remains set if setup/resume/wait fails. */
    if (ResumeThread(child.hThread) == (DWORD)-1) { error(&receipt, "ResumeThread"); goto done; }
    HANDLE waited_handles[2] = {interrupt_event, child.hProcess};
    DWORD waited;
    if (control_mode) {
        ULONGLONG now_start = GetTickCount64();
        ULONGLONG deadline = timeout && timeout < ~0ULL - now_start ? now_start + timeout : ~0ULL;
        for (;;) {
            if (observe_control(&receipt, 0) != 1) goto done;
            ULONGLONG now = GetTickCount64();
            DWORD slice = now < deadline ? (deadline - now > 20 ? 20 : (DWORD)(deadline - now)) : 0;
            waited = WaitForSingleObject(child.hProcess, slice);
            if (waited == WAIT_OBJECT_0) { waited = WAIT_OBJECT_0 + 1; break; }
            if (waited == WAIT_FAILED) { error(&receipt, "control-mode leader wait"); goto done; }
            if (waited != WAIT_TIMEOUT) {
                SetLastError(ERROR_INVALID_DATA); error(&receipt, "unexpected control-mode wait"); goto done;
            }
            if (GetTickCount64() >= deadline) break;
        }
    } else {
        /* The installed host always uses the control pipe. Retain the console
         * path with bounded wait slices for independent runner diagnostics. */
        ULONGLONG now_start = GetTickCount64();
        ULONGLONG deadline = timeout && timeout < ~0ULL - now_start ? now_start + timeout : ~0ULL;
        do {
            ULONGLONG now = GetTickCount64();
            DWORD slice = now < deadline ? (deadline - now > 1000 ? 1000 : (DWORD)(deadline - now)) : 0;
            waited = WaitForMultipleObjects(2, waited_handles, FALSE, slice);
        } while (waited == WAIT_TIMEOUT && GetTickCount64() < deadline);
    }
    if (waited == WAIT_OBJECT_0) {
        receipt.interrupted = 1; /* Actual control code is sampled after handler quiescence. */
        receipt.reason = "interrupt";
        receipt.result = 130;
    } else if (waited == WAIT_TIMEOUT) {
        receipt.reason = "timeout";
        receipt.timed_out = 1;
        receipt.result = 124;
    } else if (waited == WAIT_OBJECT_0 + 1) {
        receipt.natural_exit = 1;
        if (!GetExitCodeProcess(child.hProcess, &receipt.leader_status)) {
            error(&receipt, "GetExitCodeProcess"); goto done;
        }
        receipt.status_known = 1;
        if (!active_processes(job, &receipt.active_at_exit, &receipt)) goto done;
        receipt.active_at_exit_known = 1;
        force_retirement = receipt.active_at_exit > 0;
        if (force_retirement) {
            receipt.forced_descendants = 1;
            receipt.reason = "leader_exit_with_live_descendants";
            receipt.result = PROBE_FAILURE;
        } else {
            receipt.result = receipt.leader_status;
            receipt.reason = receipt.leader_status >= 0x80000000UL ? "abnormal_exit"
                : receipt.leader_status ? "nonzero_exit" : "normal_exit";
        }
    } else error(&receipt, "WaitForMultipleObjects");

done:
    /* Job accounting and the leader handle share one cleanup budget. Empty
     * accounting alone does not supply the leader's actual native exit DWORD. */
    cleanup_deadline = GetTickCount64() + CLEANUP_TIMEOUT_MS;
    if (job) retire_and_confirm(job, &receipt, receipt.child_created && force_retirement,
                               cleanup_deadline);
    /* Preserve natural/timeout/interruption provenance independently of the
     * eventual DWORD. Never invent the requested termination code as a result. */
    if (receipt.child_created && !receipt.status_known) {
        ULONGLONG now = GetTickCount64();
        DWORD remaining = now < cleanup_deadline ? (DWORD)(cleanup_deadline - now) : 0;
        DWORD leader_wait = WaitForSingleObject(child.hProcess, remaining);
        if (leader_wait == WAIT_OBJECT_0) {
            if (GetExitCodeProcess(child.hProcess, &receipt.leader_status)) receipt.status_known = 1;
            else error(&receipt, "GetExitCodeProcess after retirement");
        } else if (leader_wait == WAIT_TIMEOUT) {
            SetLastError(ERROR_TIMEOUT);
            error(&receipt, "bounded leader-status wait timeout");
        } else if (leader_wait == WAIT_FAILED) {
            error(&receipt, "bounded leader-status wait");
        } else {
            SetLastError(ERROR_INVALID_DATA);
            error(&receipt, "unexpected leader-status wait result");
        }
    }
    /* Finite cancellation admission boundary: ownership is already empty and
     * actual leader status known. This final Peek is the last observation.
     * A writer close after it is not atomically synchronized with us; Python
     * retains its own KeyboardInterrupt outcome independently. */
    if (control_mode) {
        receipt.control_boundary_ready = receipt.empty_confirmed && receipt.status_known;
        if (receipt.control_boundary_ready) observe_control(&receipt, 1);
        if (CloseHandle(receipt.control_read)) receipt.control_closed = 1;
        else error(&receipt, "close control read handle");
    }
    if (child.hThread) CloseHandle(child.hThread);
    if (child.hProcess) CloseHandle(child.hProcess);
    if (attributes_ready) DeleteProcThreadAttributeList(start.lpAttributeList);
    free(start.lpAttributeList);
    for (int i = 0; i < 3; ++i) if (handles[i]) CloseHandle(handles[i]);
    if (job) CloseHandle(job); /* Kill-on-close remains the final cleanup backstop. */
    /* Observe control events throughout retirement. Remove the callback before
     * taking the final state snapshot; the exclusive lock waits for callbacks
     * currently updating that state and serializes event closure with them.
     * Failure to unregister makes this receipt incomplete. */
    if (handler_ready && !SetConsoleCtrlHandler(control_handler, FALSE))
        error(&receipt, "unregister console handler");
    AcquireSRWLockExclusive(&interrupt_lock);
    LONG control = InterlockedCompareExchange(&received_control, -1, -1);
    if (control >= 0) {
        receipt.interrupted = 1;
        receipt.console_interrupted = 1;
        receipt.interruption_source = "console";
        receipt.interrupt_code = (DWORD)control;
        if (!receipt.timed_out) receipt.reason = "interrupt";
        receipt.result = (DWORD)probe_observed_control_status(receipt.timed_out);
    }
    if (interrupt_event) CloseHandle(interrupt_event);
    interrupt_event = NULL;
    receipt.complete = receipt.child_created && receipt.natural_exit && receipt.status_known
        && receipt.empty_confirmed && !receipt.retirement_requested && !receipt.timed_out
        && !receipt.interrupted && !receipt.error_operation && receipt.leader_status < 0x80000000UL
        && (!control_mode || (receipt.control_boundary_ready && receipt.control_closed));
    receipt.tests_passed = receipt.complete && receipt.leader_status == 0;
    ReleaseSRWLockExclusive(&interrupt_lock);
    free(command);
    if (!publish_receipt(argv[4], &receipt)) {
        fputs("Titan coverage supervisor: failed to publish fresh receipt.\n", stderr);
        return PROBE_FAILURE;
    }
    return (int)receipt.result;
}
'''
