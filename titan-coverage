#define PROBE_COMMAND_CAPACITY 32767
#define PROBE_FAILURE 125

static int probe_append(wchar_t *command, size_t *length, wchar_t c) {
    if (*length >= PROBE_COMMAND_CAPACITY - 1) return 0;
    command[(*length)++] = c;
    return 1;
}

/* Microsoft CRT argv quoting, including empty arguments and terminal slashes. */
static int probe_quote(wchar_t *command, size_t *length, const wchar_t *arg) {
    if (!probe_append(command, length, L'"')) return 0;
    for (;;) {
        size_t slashes = 0;
        while (*arg == L'\\') { ++slashes; ++arg; }
        size_t count = slashes;
        if (*arg == L'"' || !*arg) count *= 2;
        while (count--) if (!probe_append(command, length, L'\\')) return 0;
        if (!*arg) return probe_append(command, length, L'"');
        if (*arg == L'"' && !probe_append(command, length, L'\\')) return 0;
        if (!probe_append(command, length, *arg++)) return 0;
    }
}

static HANDLE probe_standard_handle(DWORD kind, DWORD access) {
    HANDLE source = GetStdHandle(kind), result = NULL;
    if (source && source != INVALID_HANDLE_VALUE) {
        if (!DuplicateHandle(GetCurrentProcess(), source, GetCurrentProcess(),
                             &result, 0, TRUE, DUPLICATE_SAME_ACCESS)) return NULL;
    } else {
        SECURITY_ATTRIBUTES security = {sizeof(security), NULL, TRUE};
        result = CreateFileW(L"NUL", access, FILE_SHARE_READ | FILE_SHARE_WRITE,
                             &security, OPEN_EXISTING, 0, NULL);
        if (result == INVALID_HANDLE_VALUE) return NULL;
    }
    return result;
}
#endif

