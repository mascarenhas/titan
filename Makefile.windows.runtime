# Included by Makefile.windows. Windows runtime and private PEG payload only.
RUNTIME_CFLAGS ?= $(TITAN_WINDOWS_NATIVE_CFLAGS) -Wall -Wextra
RUNTIME_CPPFLAGS ?=
RUNTIME_LDFLAGS ?= $(TITAN_WINDOWS_NATIVE_LDFLAGS)
ifeq ($(origin AR),default)
AR := llvm-ar
endif
AR ?= llvm-ar
RANLIB ?= llvm-ranlib

.PHONY: runtime-build runtime runtime-check
runtime-build: lua
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  RUNTIME_CFLAGS=$(call quote,$(RUNTIME_CFLAGS)) \
	  RUNTIME_CPPFLAGS=$(call quote,$(RUNTIME_CPPFLAGS)) \
	  RUNTIME_LDFLAGS=$(call quote,$(RUNTIME_LDFLAGS)) \
	  bash scripts/build_windows_runtime.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

runtime: runtime-build
	bash scripts/install_windows_runtime.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))

runtime-check: runtime
	CC=$(call quote,$(CC)) AR=$(call quote,$(AR)) RANLIB=$(call quote,$(RANLIB)) \
	  RUNTIME_CFLAGS=$(call quote,$(RUNTIME_CFLAGS)) \
	  RUNTIME_CPPFLAGS=$(call quote,$(RUNTIME_CPPFLAGS)) \
	  RUNTIME_LDFLAGS=$(call quote,$(RUNTIME_LDFLAGS)) \
	  bash scripts/check_windows_runtime_sdk.sh $(call quote,$(WINDOWS_BUILD_ROOT)) $(call quote,$(PREFIX))
